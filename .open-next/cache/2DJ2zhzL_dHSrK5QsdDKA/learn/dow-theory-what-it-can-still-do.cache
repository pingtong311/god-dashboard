"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"第一，看大盤時不要只看一個指數。台股至少有加權與櫃買，常不同步。第二，先承認自己做的是哪一層趨勢，才不會用五分線的離開去否定週線的結構。第三，量能確認只是其中一票，不能單獨當判決。\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"用法\"}],[\"$\",\"th\",\"1\",{\"children\":\"它幫你少做的誤讀\"}],[\"$\",\"th\",\"2\",{\"children\":\"它不幫你做的\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"兩個指數對照\"}],[\"$\",\"td\",\"1\",{\"children\":\"把單一指數當全體\"}],[\"$\",\"td\",\"2\",{\"children\":\"告訴你明天誰強\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"先標時間尺度\"}],[\"$\",\"td\",\"1\",{\"children\":\"用錯週期的離開\"}],[\"$\",\"td\",\"2\",{\"children\":\"保證大週期對\"}]]}],[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"量能當一票\"}],[\"$\",\"td\",\"1\",{\"children\":\"無量空想當然\"}],[\"$\",\"td\",\"2\",{\"children\":\"量能單獨判決\"}]]}],[\"$\",\"tr\",\"3\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"當鬧鐘\"}],[\"$\",\"td\",\"1\",{\"children\":\"—\"}],[\"$\",\"td\",\"2\",{\"children\":\"這就是誤用\"}]]}]]}]]}]}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、為什麼鬧鐘讀法會贏傳播\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"人要日期。理論若能報日期，比較好傳。道氏活得久，正因為它報不了日期，只報層級。你若需要日期，該找的是自己的離開條件，不是一百年前的評論。\"}],[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"需要日期就寫自己的條件\"}],[\"$\",\"li\",\"1\",{\"children\":\"不要向舊理論要日期\"}],[\"$\",\"li\",\"2\",{\"children\":\"層級對齊比日期重要\"}]]}],[\"$\",\"figure\",\"2\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"!當轉折日!單一指數當全體!用錯週期\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"加料\"}]]}]]]}],[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、和艾爾德多週期的關係\"}],[\"$L18\",\"$L19\"]]}],\"$L1a\",\"$L1b\",\"$L1c\",\"$L1d\"],\"$L1e\"]}]]}]}]\n18:[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"都在處理尺度打架。道氏較像大盤天氣；艾爾德較像個股操作流程。都可以用，都不是聖盃。\"}]\n19:[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"一個看大盤層級\"}],[\"$\",\"li\",\"1\",{\"children\":\"一個看個股週期\"}],[\"$\",\"li\",\"2\",{\"children\":\"都要自己的作廢\"}]]}]\n1a:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、最小動作\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"寫下你現在看的是哪一個指數、哪一層趨勢。兩格填不滿，就還在被單一畫面拖著走。\"}]]]}]\n1b:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"加權與櫃買不同步怎麼辦？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"先承認資金習慣不同。不同步是資訊，不是其中一個壞掉。見上市上櫃那篇。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"道氏有沒有失效？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"當鬧鐘用早就失效。當層級與確認的提醒，仍有用。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"一定要等確認才動嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"等確認會慢，不等會假。這是權衡，理論不替你選。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"和均線系統差在哪？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"均線是一種視覺化。道氏較強調互相確認與尺度。都可以變成定錨。\"}]]}]]}]]]}]\n1c:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"道氏理論能用的是層級與互相確認，不是進出鬧鐘。先標你看哪一個指數、哪一層趨勢。日期請寫自己的條件。\"}]]]}]\n1d:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L17\",\"0-上市與上櫃\",{\"href\":\"/learn/listed-vs-otc-taiwan\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"上市與上櫃\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L17\",\"0-艾爾德三螢幕\",{\"href\":\"/learn/elder-triple-screen-limits\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"艾爾德三螢幕\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L17\",\"0-技術分析盲點\",{\"href\":\"/learn/technical-analysis-pros-and-cons\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"技術分析盲點\"}]]}]]}]]]}]\n1e:[\"$\",\"div\",null,{\"className\":\"LearnArticle_related__9qV55\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_relatedTitle__RXfrl\",\"children\":\"相關文章\"}],[[\"$\",\"$L17\",\"listed-vs-otc-taiwan\",{\"href\":\"/learn/listed-vs-otc-taiwan\",\"className\":\"LearnArticle_relatedLink__mibXe\",\"children\":\"上市與上櫃\"}],[\"$\",\"$L17\",\"elder-triple-screen-limits\",{\"href\":\"/l