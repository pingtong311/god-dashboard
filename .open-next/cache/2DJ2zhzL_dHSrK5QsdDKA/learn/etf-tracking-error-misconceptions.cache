n\":[\"learn\",[\"$\",\"$1\",\"c\",{\"children\":[null,[\"$\",\"$L4\",null,{\"parallelRouterKey\":\"children\",\"error\":\"$undefined\",\"errorStyles\":\"$undefined\",\"errorScripts\":\"$undefined\",\"template\":[\"$\",\"$L5\",null,{}],\"templateStyles\":\"$undefined\",\"templateScripts\":\"$undefined\",\"notFound\":\"$undefined\",\"forbidden\":\"$undefined\",\"unauthorized\":\"$undefined\"}]]}],{\"children\":[[\"slug\",\"etf-tracking-error-misconceptions\",\"d\"],\"$L9\",{\"children\":[\"__PAGE__\",\"$La\",{},null,false]},null,false]},null,false]},null,false],\"$Lb\",false]],\"m\":\"$undefined\",\"G\":[\"$c\",[]],\"s\":false,\"S\":true}\ne:I[24431,[],\"OutletBoundary\"]\n10:I[15278,[],\"AsyncMetadataOutlet\"]\n12:I[24431,[],\"ViewportBoundary\"]\n14:I[24431,[],\"MetadataBoundary\"]\n15:\"$Sreact.suspense\"\n9:[\"$\",\"$1\",\"c\",{\"children\":[null,[\"$\",\"$L4\",null,{\"parallelRouterKey\":\"children\",\"error\":\"$undefined\",\"errorStyles\":\"$undefined\",\"errorScripts\":\"$undefined\",\"template\":[\"$\",\"$L5\",null,{}],\"templateStyles\":\"$undefined\",\"templateScripts\":\"$undefined\",\"notFound\":\"$undefined\",\"forbidden\":\"$undefined\",\"unauthorized\":\"$undefined\"}]]}]\na:[\"$\",\"$1\",\"c\",{\"children\":[\"$Ld\",[[\"$\",\"link\",\"0\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/css/3eaf36e367672966.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"$undefined\"}]],[\"$\",\"$Le\",null,{\"children\":[\"$Lf\",[\"$\",\"$L10\",null,{\"promise\":\"$@11\"}]]}]]}]\nb:[\"$\",\"$1\",\"h\",{\"children\":[null,[[\"$\",\"$L12\",null,{\"children\":\"$L13\"}],[\"$\",\"meta\",null,{\"name\":\"next-size-adjust\",\"content\":\"\"}]],[\"$\",\"$L14\",null,{\"children\":[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$15\",null,{\"fallback\":null,\"children\":\"$L16\"}]}]}]]}]\n17:I[52619,[\"2619\",\"static/chunks/2619-04bc32f026a0d946.js\",\"6309\",\"static/chunks/app/learn/%5Bslug%5D/page-f7b99344f7e2ee16.js\"],\"\"]\nd:[\"$\",\"div\",null,{\"className\":\"LearnArticle_wrap__LIQ8G\",\"children\":[\"$\",\"article\",null,{\"className\":\"LearnArticle_article__2nBbk\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_meta__etj_G\",\"children\":[[\"$\",\"$L17\",null,{\"className\":\"LearnArticle_cat__GQMlg\",\"href\":\"/learn?c=rules\",\"children\":\"制度與工具\"}],[\"$\",\"span\",null,{\"className\":\"LearnArticle_read__QEj6a\",\"children\":\"閱讀約 8 分鐘\"}]]}],[\"$\",\"h1\",null,{\"className\":\"LearnArticle_title__0_la8\",\"children\":\"ETF 追蹤誤差是什麼？3 個常見誤解，別把誤差當虧損！\"}],[\"$\",\"details\",null,{\"className\":\"LearnArticle_toc__LcSAa\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"LearnArticle_tocSummary__YBddG\",\"children\":\"本文目錄\"}],[\"$\",\"ol\",null,{\"className\":\"LearnArticle_tocList__Rq_Lz\",\"children\":[[\"$\",\"li\",\"sec-1\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-1\",\"children\":\"一、ETF 追蹤誤差是什麼？它不是你的投資虧損\"}]}],[\"$\",\"li\",\"sec-2\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-2\",\"children\":\"二、追蹤誤差怎麼算？用「標準差」評估偏離程度\"}]}],[\"$\",\"li\",\"sec-3\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-3\",\"children\":\"三、追蹤誤差 V.S. 追蹤偏離：兩個概念，別搞混！\"}]}],[\"$\",\"li\",\"sec-4\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-4\",\"children\":\"四、為什麼 ETF 會有追蹤誤差？3 個主要原因\"}]}],[\"$\",\"li\",\"sec-5\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-5\",\"children\":\"五、追蹤誤差越小越好？投資前該注意什麼？\"}]}],[\"$\",\"li\",\"sec-6\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-6\",\"children\":\"常見問題 FAQ\"}]}],[\"$\",\"li\",\"sec-7\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-7\",\"children\":\"總結\"}]}],[\"$\",\"li\",\"sec-8\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-8\",\"children\":\"延伸閱讀\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"LearnArticle_body__6B7Mb\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_intro__ATV5c\",\"children\":\"許多投資人打開 ETF 績效表，發現報酬率跟它追蹤的指數好像不太一樣，心裡就開始擔心是不是買到不好的 ETF，或者自己算錯了。其實，這種「落差」在 ETF 投資中很常見，它有個專有名詞叫做「追蹤誤差」。這篇文章將帶你了解追蹤誤差是什麼、為什麼會發生，以及如何正確解讀它，讓你下次看盤不再一頭霧水。\"}],[[\"$\",\"figure\",\"figure-0\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"沒扣成本的勝率，看起來都會比較漂亮0.029%手續費 1 折來回0.15%當沖證交稅0.06%滑價估計三項合計約 0.24%；留倉稅率更高，約 0.39%\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"示意圖｜當沖來回成本：1 折手續費 + 證交稅 + 滑價（教學結構，不是某檔實盤）\"}]]}]],[\"$\",\"div\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"追蹤誤差是衡量 ETF 報酬與其追蹤指數報酬差異的波動程度。\"}],[\"$\",\"li\",\"1\",{\"children\":\"追蹤誤差與追蹤偏離不同，一個看波動，一個看累積差距。\"}],[\"$\",\"li\",\"2\",{\"children\":\"管理費、現金部位、複製策略等是造成追蹤誤差的主要原因。\"}],[\"$\",\"li\",\"3\",{\"children\":\"理解追蹤誤差能幫助你更客觀評估 ETF 的管理效率。\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、ETF 追蹤誤差是什麼？它不是你的投資虧損\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"當你買進一檔 ETF，期待它的表現能跟上所追蹤的指數，但實際情況往往會有些微的差異。這個差異的「波動程度」，就是我們常說的追蹤誤差。簡單來說，它衡量的是 ETF 的每日報酬率，與其目標指數的每日報酬率之間，偏離的穩定性或不穩定性。追蹤誤差高，代表 ETF 的報酬波動與指數的報酬波動差異較大；追蹤誤差低，則代表兩者走勢更為貼近。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"追蹤誤差衡量的是 ETF 報酬率與指數報酬率之間的「波動差異」。\"}],[\"$\",\"li\",\"1\",{\"children\":\"這是一種衡量 ETF 管理效率的指標，而非直接的損益數字。\"}],[\"$\",\"li\",\"2\",{\"children\":\"數值越小，代表 ETF 越能精準複製指數的走勢。\"}]]}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、追蹤誤差怎麼算？用「標準差」評估偏離程度\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"追蹤誤差的計算，通常是透過統計學上的「標準差」來完成。它會計算一段時間內，ETF 的每日報酬率與其追蹤指數的每日報酬率之間的差異，然後再計算這些差異值的標準差。這個數值通常會年化，以便於比較。舉例來說，如果一檔 ETF 的年化追蹤誤差是 0.5%，代表在過去一年中，這檔 ETF 的每日報酬率與指數的每日報酬率之間，平均波動差異約為 0.5%。\"}],[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"計算每日報酬率差異：先算出 ETF 每日報酬率減去指數每日報酬率。\"}],[\"$\",\"li\",\"1\",{\"children\":\"計算差異的標準差：將這些每日差異值，計算其標準差。\"}],[\"$\",\"li\",\"2\",{\"children\":\"年化處理：通常會將每日標準差轉換成年化數值，方便投資人參考。\"}]]}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、追蹤誤差 V.S. 追蹤偏離：兩個概念，別搞混！\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"很多投資人會把「追蹤誤差」和「追蹤偏離」搞混，但這兩者其實是不同的概念。追蹤偏離（Tracking Difference）指的是 ETF 在一段時間內，累積報酬率與其追蹤指數累積報酬率之間的「總體差距」。例如，指數漲 10%，ETF 只漲 9%，那麼追蹤偏離就是 -1%。而追蹤誤差（Tracking Error）則更側重於「波動性」，它衡量的是 ETF 報酬與指數報酬差異的穩定程度，而不是單純的累積總和。\"}],\"$L18\",\"$L19\"]]}],\"$L1a\",\"$L1b\",\"$L1c\",\"$L1d\",\"$L1e\"],null]}]]}]}]\n18:[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"項目\"}],[\"$\",\"th\",\"1\",{\"children\":\"追蹤誤差 (Tracking Error)\"}],[\"$\",\"th\",\"2\",{\"children\":\"追蹤偏離 (Tracking Difference)\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"衡量重點\"}],[\"$\",\"td\",\"1\",{\"children\":\"報酬率差異的波動性\"}],[\"$\",\"td\",\"2\",{\"children\":\"累積報酬率的總體差距\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"數值意義\"}],[\"$\",\"td\",\"1\",{\"children\":\"越小代表走勢越貼近指數\"}],[\"$\",\"td\",\"2\",{\"children\":\"正值或負值代表超越或落後指數\"}]]}],[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"常見單位\"}],[\"$\",\"td\",\"1\",{\"children\":\"百分點 (年化標準差)\"}],[\"$\",\"td\",\"2\",{\"children\":\"百分比\"}]]}],[\"$\",\"tr\",\"3\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"主要用途\"}],[\"$\",\"td\",\"1\",{\"children\":\"評估複製指數的穩定性\"}],[\"$\",\"td\",\"2\",{\"children\":\"評估長期績效是否達標\"}]]}]]}]]}]}]\n19:[\"$\",\"figure\",\"2\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"✓管理費✓現金部位✓複製策略✓成分股調整\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"影響追蹤誤差因素\"}]]}]\n1a:[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、為什麼 ETF 會有追蹤誤差？3 個主要原因\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"ETF 基金經理人會盡力讓 ETF 的表現貼近指數，但由於現實世界的限制，完全沒有追蹤誤差是不可能的。以下是幾個常見的原因：首先是「管理費用與交易成本」，ETF 為了營運和交易成分股，會產生費用，這些費用會直接從基金淨值中扣除，導致報酬略低於指數。其次是「現金部位與股息再投資」，ETF 需要保留部分現金來應對贖回或日常運作，這些現金無法完全投入追蹤指數的成分股，加上股息發放與再投資的時間差，都可能產生小幅偏離。最後是「複製策略與指數調整」，有些 ETF 為了降低成本，不會完全複製指數的所有成分股（稱為「採樣複製法」），只持有部分代表性股票；而當指數調整成分股時，ETF 也需要時間跟進調整，這些都會造成暫時性的誤差。\"}],[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"管理費用與交易成本：ETF 營運成本會從淨值扣除。\"}],[\"$\",\"li\",\"1\",{\"children\":\"現金部位與股息再投資：部分資金未投資，股息再投資有時間差。\"}],[\"$\",\"li\",\"2\",{\"children\":\"複製策略與指數調整：採樣複製法或指數調整時的延遲。\"}]]}]]]}]\n1b:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、追蹤誤差越小越好？投資前該注意什麼？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"理論上，追蹤誤差越小，代表 ETF 越能精準複製指數，這對追求指數報酬的投資人來說是好事。但實際選擇 ETF 時，除了追蹤誤差，還需要綜合考量其他因素。例如，管理費率高低、流動性是否充足、以及 ETF 規模大小等。一個管理費率極低但追蹤誤差卻相對較高的 ETF，可能就值得進一步探究其原因。投資人可以在 ETF 的公開說明書或基金月報中找到相關的追蹤誤差數據，並與同類型 ETF 進行比較，作為評估 ETF 管理品質的參考依據。記住，追蹤誤差是一個歷史數據，它能反映過去的管理效率，但不能保證未來的表現。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"追蹤誤差越小，通常代表 ETF 複製指數的效率越高。\"}],[\"$\",\"li\",\"1\",{\"children\":\"除了追蹤誤差，也要考量管理費、流動性與基金規模。\"}],[\"$\",\"li\",\"2\",{\"children\":\"查閱 ETF 公開說明書，比較同類型產品的追蹤誤差數據。\"}]]}]]]}]\n1c:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"追蹤誤差大是不是代表 ETF 不好？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"不一定。追蹤誤差大可能代表 ETF 複製指數的穩定性較差，但仍需綜合考量管理費、複製策略等因素。有時特殊市場環境或指數成分股調整，也可能短期拉高誤差。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"追蹤誤差會影響我的報酬嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"會的，追蹤誤差會導致你的 ETF 實際報酬與指數報酬產生差異。如果誤差持續為正，可能略微超越指數；若為負，則可能略為落後，但通常誤差會呈現波動性。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"為什麼有些 ETF 追蹤誤差特別大？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"可能原因包括：管理費過高、流動性不足導致交易成本高、追蹤非流動性高的指數、或採用採樣複製法且採樣效果不佳等。新成立的 ETF 也可能因規模較小而有較大誤差。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"新手看 ETF 要先看追蹤誤差嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"追蹤誤差是評估 ETF 品質的重要指標之一，但對於新手來說，更重要的是先理解 ETF 的投資目標、追蹤的指數性質、管理費率以及流動性。了解這些基本面後，再深入研究追蹤誤差會更有幫助。\"}]]}]]}]]]}]\n1d:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"追蹤誤差是衡量 ETF 報酬與其追蹤指數報酬差異波動程度的指標。理解它能幫助你更客觀地評估 ETF 的管理效率，但務必將其與追蹤偏離區分開來，並綜合考量其他因素，才能做出更全面的投資判斷。\"}]]]}]\n1e:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L17\",\"0-更多台股知識都在\",{\"href\":\"/school\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"更多台股知識都在這裡\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L17\",\"0-學習更多台股教學\",{\"href\":\"/learn\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"學習更多台股教學文章\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L17\",\"0-股市大佬新手導覽\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"股市大佬新手導覽\"}]]}]]}]]]}]\n13:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\nf:null\n1f:I[80622,[],\"IconMark\"]\n11:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"ETF 追蹤誤差是什麼？3 個常見誤解，別把誤差當虧損！｜股市大佬 TradeBoss\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"許多投資人打開 ETF 績效表，發現報酬率跟它追蹤的指數好像不太一樣，心裡就開始擔心是不是買到不好的 ETF，或者自己算錯了。其實，這種「落差」在 ETF 投資中很常見，它有個專有名詞叫做「追蹤誤差」。這篇文章將帶你了解追蹤誤差是什麼、為什麼會發生，以及如何正確解讀它，讓你下次看\"}],[\"$\",\"link\",\"2\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}],[\"$\",\"$L1f\",\"3\",{}]],\"error\":null,\"digest\":\"$undefined\"}\n16:\"$11:metadata\"\n"}