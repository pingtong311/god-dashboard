:\"LearnArticle_intro__ATV5c\",\"children\":\"2026年9月15日，台股大盤呈現下跌走勢。加權指數最終收在45511.49點，下跌0.76%；櫃買指數也同步走弱，下跌1.50%。整體盤面氣氛偏向觀望，多數類股收黑。\"}],[],[\"$\",\"div\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"加權與櫃買指數雙雙下跌。\"}],[\"$\",\"li\",\"1\",{\"children\":\"半導體與金融族群表現疲弱。\"}],[\"$\",\"li\",\"2\",{\"children\":\"資訊服務類股逆勢上漲。\"}],[\"$\",\"li\",\"3\",{\"children\":\"外資現貨與台指期皆為淨賣超。\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、大盤表現與市場概況\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"今天台股主要指數均呈現下跌。加權指數下跌0.76%，收在45511.49點；代表中小型股的櫃買指數跌幅較大，下跌1.50%，收在388.73點。在上市股票中，有191家上漲，但有高達749家下跌，顯示市場普遍偏弱，整體平均漲跌幅為-0.88%。今日上市總成交金額約5676.0億元。\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"指數名稱\"}],[\"$\",\"th\",\"1\",{\"children\":\"收盤價\"}],[\"$\",\"th\",\"2\",{\"children\":\"漲跌幅\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"加權指數\"}],[\"$\",\"td\",\"1\",{\"children\":\"45511.49\"}],[\"$\",\"td\",\"2\",{\"children\":\"-0.76%\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"櫃買指數\"}],[\"$\",\"td\",\"1\",{\"children\":\"388.73\"}],[\"$\",\"td\",\"2\",{\"children\":\"-1.50%\"}]]}],[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"台指期\"}],[\"$\",\"td\",\"1\",{\"children\":\"45607.0\"}],[\"$\",\"td\",\"2\",{\"children\":\"-0.38%\"}]]}]]}]]}]}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、族群強弱分析\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"在今天的盤面中，少數族群逆勢上漲，其中表現較強的有資訊服務業、數位雲端類、居家生活類以及存託憑證。資訊服務業上漲1.46%，其中6148 驊宏資是領漲個股。相對地，多數族群表現疲弱，特別是創新版股票、金融業、塑膠工業和半導體業，這些族群今天均呈現較大的跌幅，顯示市場資金流向有所分化。\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"表現\"}],[\"$\",\"th\",\"1\",{\"children\":\"族群名稱\"}],[\"$\",\"th\",\"2\",{\"children\":\"漲跌幅\"}],[\"$\",\"th\",\"3\",{\"children\":\"領漲個股\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"偏強\"}],[\"$\",\"td\",\"1\",{\"children\":\"資訊服務業\"}],[\"$\",\"td\",\"2\",{\"children\":\"+1.46%\"}],[\"$\",\"td\",\"3\",{\"children\":\"6148 驊宏資\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"偏強\"}],[\"$\",\"td\",\"1\",{\"children\":\"數位雲端類\"}],[\"$\",\"td\",\"2\",{\"children\":\"+1.24%\"}],[\"$\",\"td\",\"3\",{\"children\":\"6870 騰雲\"}]]}],[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"偏強\"}],[\"$\",\"td\",\"1\",{\"children\":\"居家生活類\"}],[\"$\",\"td\",\"2\",{\"children\":\"+1.11%\"}],[\"$\",\"td\",\"3\",{\"children\":\"6616 特昇-KY\"}]]}],[\"$\",\"tr\",\"3\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"偏強\"}],[\"$\",\"td\",\"1\",{\"children\":\"存託憑證\"}],[\"$\",\"td\",\"2\",{\"children\":\"+0.87%\"}],[\"$\",\"td\",\"3\",{\"children\":\"9105 泰金寶-DR\"}]]}],[\"$\",\"tr\",\"4\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"偏弱\"}],[\"$\",\"td\",\"1\",{\"children\":\"創新版股票\"}],[\"$\",\"td\",\"2\",{\"children\":\"-2.15%\"}],[\"$\",\"td\",\"3\",{\"children\":\"無\"}]]}],[\"$\",\"tr\",\"5\",{\"children\":[\"