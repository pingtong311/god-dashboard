d\",\"0\",{\"children\":\"漲幅榜\"}],[\"$\",\"td\",\"1\",{\"children\":\"6226\"}],[\"$\",\"td\",\"2\",{\"children\":\"光鼎\"}],[\"$\",\"td\",\"3\",{\"children\":\"+10.00%\"}],[\"$\",\"td\",\"4\",{\"children\":\"81114 張\"}]]}],[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"跌幅榜\"}],[\"$\",\"td\",\"1\",{\"children\":\"6924\"}],[\"$\",\"td\",\"2\",{\"children\":\"榮惠-KY創\"}],[\"$\",\"td\",\"3\",{\"children\":\"-10.18%\"}],[\"$\",\"td\",\"4\",{\"children\":\"76 張\"}]]}],[\"$\",\"tr\",\"3\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"跌幅榜\"}],[\"$\",\"td\",\"1\",{\"children\":\"3229\"}],[\"$\",\"td\",\"2\",{\"children\":\"晟鈦\"}],[\"$\",\"td\",\"3\",{\"children\":\"-9.87%\"}],[\"$\",\"td\",\"4\",{\"children\":\"7363 張\"}]]}],[\"$\",\"tr\",\"4\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"當沖熱門\"}],[\"$\",\"td\",\"1\",{\"children\":\"無\"}],[\"$\",\"td\",\"2\",{\"children\":\"伊雲谷\"}],[\"$\",\"td\",\"3\",{\"children\":\"-1.70%\"}],[\"$\",\"td\",\"4\",{\"children\":\"量比 30.1x\"}]]}],[\"$\",\"tr\",\"5\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"當沖熱門\"}],[\"$\",\"td\",\"1\",{\"children\":\"無\"}],[\"$\",\"td\",\"2\",{\"children\":\"安碁資訊\"}],[\"$\",\"td\",\"3\",{\"children\":\"-2.39%\"}],[\"$\",\"td\",\"4\",{\"children\":\"量比 29.8x\"}]]}]]}]]}]}],[\"$\",\"figure\",\"2\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"📊國際股市表現📈法人買賣動向🧭融資維持率📘熱門當沖股\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"投資人關注\"}]]}]]]}]\n1f:[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、法人動向與籌碼面\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"今天法人在台股的動向顯示偏空操作。外資在現貨市場賣超約367,848張，同時台指期淨空單達到83,223口，顯示外資在期貨與現貨市場均呈現賣超。自營商在現貨市場也大幅賣超約886,963張。整體市場的融資維持率為183.2%。這些數據反映出主要法人對台股的態度。\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"法人類別\"}],[\"$\",\"th\",\"1\",{\"children\":\"現貨買賣超 (張)\"}],[\"$\",\"th\",\"2\",{\"children\":\"台指期淨部位 (口)\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"外資\"}],[\"$\",\"td\",\"1\",{\"children\":\"-367,848\"}],[\"$\",\"td\",\"2\",{\"children\":\"淨空單 83,223\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"自營商\"}],[\"$\",\"td\",\"1\",{\"children\":\"-886,963\"}],[\"$\",\"td\",\"2\",{\"children\":\"無數據\"}]]}]]}]]}]}]]]}]\n20:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、國際盤勢與相關消息\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"國際股市方面，昨日美國主要指數多數下跌，S&P 500下跌0.48%，那斯達克下跌0.56%，費城半導體指數則大幅下跌5.86%。亞洲市場方面，韓國綜合指數（KOSPI）下跌0.85%，日經225指數微幅下跌0.01%。這些國際市場的表現，與台股今天的走勢同時發生。在國內相關新聞中，有提到3029 零壹的8月營收創高，前8月年增20.13%的報導，以及三大法人賣超前十大個股曝光等消息。\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"國際指數\"}],[\"$\",\"th\",\"1\",{\"children\":\"漲跌幅\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"S&P 500\"}],[\"$\",\"td\",\"1\",{\"children\":\"-0.48%\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"那斯達克\"}],[\"$\",\"td\",\"1\",{\"children\":\"-0.56%\"}]]}],[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"費城半導體\"}],[\"$\",\"td\",\"1\",{\"children\":\"-5.86%\"}]]}],[\"$\",\"tr\",\"3\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"韓國綜合 (KOSPI)\"}],[\"$\",\"td\",\"1\",{\"children\":\"-0.85%\"}]]}],[\"$\",\"tr\",\"4\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"日經 225\"}],[\"$\",\"td\",\"1\",{\"children\":\"-0.01%\"}]]}]]}]]}]}]]]}]\n21:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"今天台股整體表現如何？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"今天台股大盤呈現下跌走勢。加權指數下跌0.76%，櫃買指數下跌1.50%。上市股票中，下跌家數遠多於上漲家數。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"哪些產業類股今天表現比較好？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"今天表現相對較強的族群包括資訊服務業（上漲1.46%）、數位雲端類（上漲1.24%）、居家生活類（上漲1.11%）和存託憑證（上漲0.87%）。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"哪些產業類股今天表現比較弱？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"今天表現較弱的族群有創新版股票（下跌2.15%）、金融業（下跌1.67%）、塑膠工業（下跌1.67%）和半導體業（下跌1.65%）。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"外資今天在台股的動向是什麼？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"外資今天在現貨市場賣超約367,848張，同時在台指期貨市場持有83,223口的淨空單，顯示其在現貨與期貨市場均呈現賣超。\"}]]}]]}]]]}]\n22:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"2026年9月15日台股大盤呈現下跌格局，主要指數收黑，多數類股表現疲弱，僅少數族群如資訊服務業逆勢上漲。法人籌碼面也顯示偏空操作。\"}]]]}]\n23:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L17\",\"0-大盤總覽\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"大盤總覽\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L17\",\"0-族群透視\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"族群透視\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L17\",\"0-台股學堂\",{\"href\":\"/school\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"台股學堂\"}]]}],[\"$\",\"li\",\"3\",{\"children\":[[\"$\",\"$L17\",\"0-新手導覽\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"新手導覽\"}]]}]]}]]]}]\n13:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\nf:null\n24:I[80622,[],\"IconMark\"]\n11:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"2026年9月15日台股盤勢：加權指數下跌，半導體與金融承壓｜股市大佬 TradeBoss\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"2026年9月15日，台股大盤呈現下跌走勢。加權指數最終收在45511.49點，下跌0.76%；櫃買指數也同步走弱，下跌1.50%。整體盤面氣氛偏向觀望，多數類股收黑。\"}],[\"$\",\"link\",\"2\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}],[\"$\",\"$L24\",\"3\",{}]],\"error\":null,\"digest\":\"$undefined\"}\n16:\"$11:metadata\"\n"}