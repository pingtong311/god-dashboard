",\"$1\",\"h\",{\"children\":[null,[[\"$\",\"$L12\",null,{\"children\":\"$L13\"}],[\"$\",\"meta\",null,{\"name\":\"next-size-adjust\",\"content\":\"\"}]],[\"$\",\"$L14\",null,{\"children\":[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$15\",null,{\"fallback\":null,\"children\":\"$L16\"}]}]}]]}]\n17:I[52619,[\"2619\",\"static/chunks/2619-04bc32f026a0d946.js\",\"6309\",\"static/chunks/app/learn/%5Bslug%5D/page-f7b99344f7e2ee16.js\"],\"\"]\nd:[\"$\",\"div\",null,{\"className\":\"LearnArticle_wrap__LIQ8G\",\"children\":[\"$\",\"article\",null,{\"className\":\"LearnArticle_article__2nBbk\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_meta__etj_G\",\"children\":[[\"$\",\"$L17\",null,{\"className\":\"LearnArticle_cat__GQMlg\",\"href\":\"/learn?c=trends\",\"children\":\"產業與趨勢\"}],[\"$\",\"span\",null,{\"className\":\"LearnArticle_read__QEj6a\",\"children\":\"閱讀約 7 分鐘\"}]]}],[\"$\",\"h1\",null,{\"className\":\"LearnArticle_title__0_la8\",\"children\":\"什麼是防禦型類股？熊市也能安心抱？3 個條件找出你的資金避風港\"}],[\"$\",\"details\",null,{\"className\":\"LearnArticle_toc__LcSAa\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"LearnArticle_tocSummary__YBddG\",\"children\":\"本文目錄\"}],[\"$\",\"ol\",null,{\"className\":\"LearnArticle_tocList__Rq_Lz\",\"children\":[[\"$\",\"li\",\"sec-1\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-1\",\"children\":\"一、為什麼市場不好時，大家都在談防禦型類股？\"}]}],[\"$\",\"li\",\"sec-2\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-2\",\"children\":\"二、防禦型類股 vs. 景氣循環股，差在哪裡？\"}]}],[\"$\",\"li\",\"sec-3\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-3\",\"children\":\"三、如何找出真正的防禦型股票？看懂 3 個關鍵數字\"}]}],[\"$\",\"li\",\"sec-4\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-4\",\"children\":\"四、我買了防禦股，為什麼還是賠錢？一個常見誤解\"}]}],[\"$\",\"li\",\"sec-5\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-5\",\"children\":\"五、如何在投資組合中配置防禦型類股？\"}]}],[\"$\",\"li\",\"sec-6\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-6\",\"children\":\"常見問題 FAQ\"}]}],[\"$\",\"li\",\"sec-7\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-7\",\"children\":\"總結\"}]}],[\"$\",\"li\",\"sec-8\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-8\",\"children\":\"延伸閱讀\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"LearnArticle_body__6B7Mb\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_intro__ATV5c\",\"children\":\"大盤一直跌，手上的股票每天都在挑戰你的心臟強度嗎？打開新聞，一下升息、一下通膨，好像全世界都對股市不友善。這時候，你可能常聽到「防禦型類股」這個詞，但它到底是什麼？這篇文章會帶你搞懂它的定義，並教你用 3 個具體條件，找出在市場動盪時，相對穩健的投資選擇。\"}],[],[\"$\",\"div\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"防禦型類股指需求穩定、不受景氣影響的公司，如食品、電信。\"}],[\"$\",\"li\",\"1\",{\"children\":\"挑選關鍵看三點：穩定的現金流、高股息殖利率、低 Beta 值。\"}],[\"$\",\"li\",\"2\",{\"children\":\"防禦股不是不會跌，而是「相對抗跌」，牛市漲幅也可能落後。\"}],[\"$\",\"li\",\"3\",{\"children\":\"配置防禦股是為了降低整體投資組合的波動，而非追求短期價差。\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、為什麼市場不好時，大家都在談防禦型類股？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"當經濟前景不明、大盤指數持續下探時，資金會尋找相對安全的去處。防禦型類股就是這樣的避風港。簡單來說，這類公司提供的產品或服務是「民生必需品」，無論景氣好壞，大家每天都得吃飯、用電、打電話，需求非常穩定。因此，它們的營收和獲利比較不會受到經濟衰退的衝擊，股價表現也相對抗跌。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"需求穩定：不管景氣好壞，民生必需品消費不會停。\"}],[\"$\",\"li\",\"1\",{\"children\":\"現金流可預測：每月收電費、電話費，營收相對穩定。\"}],[\"$\",\"li\",\"2\",{\"children\":\"受政策保護：部分產業如公用事業，有特許經營權，競爭者少。\"}]]}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、防禦型類股 vs. 景氣循環股，差在哪裡？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"許多人會把這兩種類股搞混。景氣循環股正好是防禦型類股的相反，它們的業績和經濟景氣高度連動。景氣好，大家有閒錢，就去買車、旅遊、換新家，相關公司賺飽飽；景氣一差，這些非必要消費就會被最先砍掉，公司營收立刻下滑。用下表可以看得更清楚：\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"特性\"}],[\"$\",\"th\",\"1\",{\"children\":\"防禦型類股\"}],[\"$\",\"th\",\"2\",{\"children\":\"景氣循環股\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"產業舉例\"}],[\"$\",\"td\",\"1\",{\"children\":\"食品、電信、公用事業（水電燃氣）\"}],[\"$\",\"td\",\"2\",{\"children\":\"汽車、航空、營建、奢侈品\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"營收表現\"}],[\"$\",\"td\",\"1\",{\"children\":\"景氣好壞，影響不大\"}],[\"$\",\"td\",\"2\",{\"children\":\"景氣好，營收大增；景氣差，營收大減\"}]]}],[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"股價波動\"}],[\"$\",\"td\",\"1\",{\"children\":\"相對平穩，波動較小 (低 Beta)\"}],[\"$\",\"td\",\"2\",{\"children\":\"波動劇烈，跟著景氣大起大落 (高 Beta)\"}]]}],[\"$\",\"tr\",\"3\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"適合時機\"}],[\"$\",\"td\",\"1\",{\"children\":\"經濟衰退期、市場不確定性高時\"}],[\"$\",\"td\",\"2\",{\"children\":\"經濟復甦期、市場多頭時\"}]]}]]}]]}]}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、如何找出真正的防禦型股票？看懂 3 個關鍵數字\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"不是所有食品或電信公司都適合當作防禦標的。想挑出體質好的防禦型股票，你必須學會看懂財報上的幾個關鍵數字。這能幫助你避開那些只是掛著防禦題材，實際上體質不佳的公司。你可以從以下三個指標著手：\"}],\"$L18\",\"$L19\"]]}],\"$L1a\",\"$L1b\",\"$L1c\",\"$L1d\",\"$L1e\"],null]}]]}]}]\n18:[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"穩定的現金股利：觀察公司是否連續 5 年以上都能穩定配發現金股利，且殖利率能優於大盤平均（例如 4% 以上）。這代表公司有持續賺錢，也願意把利潤分享給股東。\"}],[\"$\",\"li\",\"1\",{\"children\":\"低 Beta 值：Beta 值衡量個股相對於大盤的波動程度。Beta 小於 1，代表它的波動比大盤小。例如大盤跌 2%，Beta 值 0.6 的股票理論上可能只跌 1.2%。你可以在股市大佬的個股透視頁找到這個數據。\"}],[\"$\",\"li\",\"2\",{\"children\":\"合理的本益比 (P/E Ratio)：防禦型股票的成長性通常不高，市場給的本益比也相對較低。如果一檔所謂的防禦股，本益比卻高達 30、40 倍，可能代表股價已被高估，防禦效果會大打折扣。\"}]]}]\n19:[\"$\",\"figure\",\"2\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"1找出穩定配息公司2檢查 Beta 值是否小於 13評估本益比是否過高\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"三步驟篩選防禦股\"}]]}]\n1a:[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、我買了防禦股，為什麼還是賠錢？一個常見誤解\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"很多投資人最大的誤解，就是把「防禦型股票」當成「絕對不會跌的股票」。這是完全錯誤的觀念！「防禦」指的是「相對抗跌」，而不是保證不跌。在市場發生系統性風險，所有人都恐慌拋售時，沒有任何股票能完全倖免。它的價值在於「跌得比別人少」，保護你的資產不會縮水得那麼快。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"舉個例子：假設大盤指數從 18000 點跌到 15000 點，跌幅約 16.7%。一檔體質好的防禦型股票，可能只跌了 8% 到 10%。雖然帳面上還是虧損，但相較之下，你的資產已經保住了更多價值。\"}]]}]]]}]\n1b:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、如何在投資組合中配置防禦型類股？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"防禦型類股不該是你投資組合的全部，它更像是扮演「穩定器」的角色。在多頭市場，它的漲幅可能跟不上市場關注度高的科技股，但能在空頭來臨時，為你的整體資產提供緩衝，降低波動性。正確的配置觀念，比挑對單一股票更重要。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"作為資產配置的一環：依據你的風險承受度，可以考慮配置 10% 至 30% 的資金在防禦型股票上。\"}],[\"$\",\"li\",\"1\",{\"children\":\"不要期待短期價差：買入防禦股的核心目的是領取穩定股息和降低風險，而不是期待它在三個月內價格出現巨大漲幅。\"}],[\"$\",\"li\",\"2\",{\"children\":\"定期檢視基本面：產業特性也可能改變，原本的防禦股可能因新技術或法規而失去優勢，記得要定期檢查公司的營運狀況。\"}]]}]]]}]\n1c:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"電信股算是防禦型類股嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"是的，電信業通常被視為典型的防禦型類股。因為無論經濟好壞，人們對手機通訊和網路的需求都非常穩定，使其擁有可預測的現金流與營收。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"防禦型股票適合用來長期投資嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"非常適合。因為它們通常具備營運穩定、持續獲利、穩定配息的特性，符合長期持有、領取股息的投資策略。但仍要注意買入的價格是否合理，避免買在相對高點。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"金融股算是防禦型類股嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"這比較有爭議。金融股雖然也穩定配息，但它們的獲利與景氣、利率政策高度相關，因此更偏向景氣循環股。在經濟衰退時，它們的壞帳風險會增加，表現不一定有防禦性。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"在牛市（多頭市場）可以買防禦型股票嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"可以，但要接受它的漲幅可能會落後大盤。在牛市中配置防禦股，主要是為了分散風險，當市場突然反轉時，能提供緩衝，讓你的投資組合不會跌得那麼慘。\"}]]}]]}]]]}]\n1d:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"總結來說，防禦型類股就像投資組合中的「安全氣囊」，平時感覺不到它的存在，但在市場顛簸時能發揮保護作用。挑選時，記得緊盯「穩定配息、低 Beta 值、合理本益比」三大指標，並理解它「相對抗跌，而非絕不下跌」的本質，才能讓它成為你資產的穩定力量。\"}]]]}]\n1e:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L17\",\"0-用「個股透視」查\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"用「個股透視」查詢 Beta 值與本益比\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L17\",\"0-查詢個股的「除權\",{\"href\":\"/s/2330\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"查詢個股的「除權息行事曆」\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L17\",\"0-學習更多投資觀念\",{\"href\":\"/school\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"學習更多投資觀念，請看「台股學堂」\"}]]}]]}]]]}]\n13:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\nf:null\n1f:I[80622,[],\"IconMark\"]\n11:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"什麼是防禦型類股？熊市也能安心抱？3 個條件找出你的資金避風港｜股市大佬 TradeBoss\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"大盤一直跌，手上的股票每天都在挑戰你的心臟強度嗎？打開新聞，一下升息、一下通膨，好像全世界都對股市不友善。這時候，你可能常聽到「防禦型類股」這個詞，但它到底是什麼？這篇文章會帶你搞懂它的定義，並教你用 3 個具體條件，找出在市場動盪時，相對穩健的投資選擇。\"}],[\"$\",\"link\",\"2\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}],[\"$\",\"$L1f\",\"3\",{}]],\"error\":null,\"digest\":\"$undefined\"}\n16:\"$11:metadata\"\n"}