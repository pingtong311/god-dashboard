rbidden\":\"$undefined\",\"unauthorized\":\"$undefined\"}]]}]\na:[\"$\",\"$1\",\"c\",{\"children\":[\"$Ld\",[[\"$\",\"link\",\"0\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/css/3eaf36e367672966.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"$undefined\"}]],[\"$\",\"$Le\",null,{\"children\":[\"$Lf\",[\"$\",\"$L10\",null,{\"promise\":\"$@11\"}]]}]]}]\nb:[\"$\",\"$1\",\"h\",{\"children\":[null,[[\"$\",\"$L12\",null,{\"children\":\"$L13\"}],[\"$\",\"meta\",null,{\"name\":\"next-size-adjust\",\"content\":\"\"}]],[\"$\",\"$L14\",null,{\"children\":[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$15\",null,{\"fallback\":null,\"children\":\"$L16\"}]}]}]]}]\n17:I[52619,[\"2619\",\"static/chunks/2619-04bc32f026a0d946.js\",\"6309\",\"static/chunks/app/learn/%5Bslug%5D/page-f7b99344f7e2ee16.js\"],\"\"]\nd:[\"$\",\"div\",null,{\"className\":\"LearnArticle_wrap__LIQ8G\",\"children\":[\"$\",\"article\",null,{\"className\":\"LearnArticle_article__2nBbk\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_meta__etj_G\",\"children\":[[\"$\",\"$L17\",null,{\"className\":\"LearnArticle_cat__GQMlg\",\"href\":\"/learn?c=platform\",\"children\":\"平台教學\"}],[\"$\",\"span\",null,{\"className\":\"LearnArticle_read__QEj6a\",\"children\":\"閱讀約 5 分鐘\"}]]}],[\"$\",\"h1\",null,{\"className\":\"LearnArticle_title__0_la8\",\"children\":\"股市大佬電腦通知怎麼設？3個檢查\"}],[\"$\",\"details\",null,{\"className\":\"LearnArticle_toc__LcSAa\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"LearnArticle_tocSummary__YBddG\",\"children\":\"本文目錄\"}],[\"$\",\"ol\",null,{\"className\":\"LearnArticle_tocList__Rq_Lz\",\"children\":[[\"$\",\"li\",\"sec-1\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-1\",\"children\":\"一、電腦通知是哪一顆按鈕\"}]}],[\"$\",\"li\",\"sec-2\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-2\",\"children\":\"二、三個檢查：瀏覽器、權限、後端\"}]}],[\"$\",\"li\",\"sec-3\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-3\",\"children\":\"三、允許之後還要勾主題\"}]}],[\"$\",\"li\",\"sec-4\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-4\",\"children\":\"四、測試通知會打到哪\"}]}],[\"$\",\"li\",\"sec-5\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-5\",\"children\":\"五、換電腦、清資料時怎麼辦\"}]}],[\"$\",\"li\",\"sec-6\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-6\",\"children\":\"常見問題 FAQ\"}]}],[\"$\",\"li\",\"sec-7\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-7\",\"children\":\"總結\"}]}],[\"$\",\"li\",\"sec-8\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-8\",\"children\":\"延伸閱讀\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"LearnArticle_body__6B7Mb\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_intro__ATV5c\",\"children\":\"以前很多人以為股市大佬只能在手機收通知。現在通知中心多了瀏覽器 Web Push：用電腦版 Chrome 或 Edge，按「允許電腦通知」，系統跳出視窗時選允許，之後主題就會彈到右下角。這不是另外一套喊單，只是同一組主題多一條送到電腦的路。\"}],[],[\"$\",\"div\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"用電腦版 Chrome 或 Edge，不要用內嵌瀏覽器硬開\"}],[\"$\",\"li\",\"1\",{\"children\":\"按允許電腦通知，並在系統視窗選允許\"}],[\"$\",\"li\",\"2\",{\"children\":\"權限被封鎖時，要回網址列改，不是再狂按\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、電腦通知是哪一顆按鈕\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"打開通知中心，第一張卡片寫「電腦也可以收盤中通知」。支援的瀏覽器會出現「允許電腦通知」；這台已經登記過，按鈕會改成「重新允許這台電腦」。頁面會顯示已登記幾台電腦或瀏覽器。盤中主題彈的是系統通知，不必一直開著這個分頁。不支援的瀏覽器會直接告訴你改用電腦版 Chrome 或 Edge。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"按鈕名稱就是允許電腦通知\"}],[\"$\",\"li\",\"1\",{\"children\":\"已登記後可重新允許這台電腦\"}],[\"$\",\"li\",\"2\",{\"children\":\"不必開著網頁才能收到\"}]]}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、三個檢查：瀏覽器、權限、後端\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"第一，確認你在電腦版 Chrome 或 Edge，而且不是 LINE、Telegram 內建瀏覽器。第二，按按鈕後，瀏覽器會問你要不要允許；選封鎖之後，再按同一顆鈕不會自己解開，要點網址列左側圖示，把通知改成允許。第三，若提示電腦通知後端尚未就緒，是伺服器端還沒準備好，稍後再試，不是你帳號壞了。三個檢查都過，卡片才會變成「這台電腦已可收通知」。\"}],[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"檢查是不是電腦版 Chrome 或 Edge\"}],[\"$\",\"li\",\"1\",{\"children\":\"檢查系統權限是允許不是封鎖\"}],[\"$\",\"li\",\"2\",{\"children\":\"檢查有沒有後端尚未就緒的提示\"}]]}],[\"$\",\"div\",\"2\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"你看到的提示\"}],[\"$\",\"th\",\"1\",{\"children\":\"通常代表\"}],[\"$\",\"th\",\"2\",{\"children\":\"下一步\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"請改用電腦版 Chrome 或 Edge\"}],[\"$\",\"td\",\"1\",{\"children\":\"這台瀏覽器沒有系統通知能力\"}],[\"$\",\"td\",\"2\",{\"children\":\"換瀏覽器再開同一頁\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"瀏覽器已封鎖通知\"}],[\"$\",\"td\",\"1\",{\"children\":\"權限被拒絕\"}],[\"$\",\"td\",\"2\",{\"children\":\"網址列改成允許再按一次\"}]]}],[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"電腦通知後端尚未就緒\"}],[\"$\",\"td\",\"1\",{\"children\":\"伺服器暫時沒有公鑰\"}],[\"$\",\"td\",\"2\",{\"children\":\"稍後再試，不要重裝系統\"}]]}],[\"$\",\"tr\",\"3\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"這台電腦已可收通知\"}],[\"$\",\"td\",\"1\",{\"children\":\"這台瀏覽器已登記\"}],[\"$\",\"td\",\"2\",{\"children\":\"回去勾主題並可測一則\"}]]}]]}]]}]}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、允許之後還要勾主題\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"電腦登記成功，只代表這台機器收得到系統通知。若總開關沒開、主題沒勾，盤中仍然不會來。頁面提示寫得很直：總開關已開，請再勾主題；電腦請按允許電腦通知。主題與過濾和 App、Telegram 是同一套偏好，不會因為你在電腦開過就自動全開。嫌吵先關個股急動，或打開只推自選股。\"}],\"$L18\",\"$L19\"]]}],\"$L1a\",\"$L1b\",\"$L1c\",\"$L1d\",\"$L1e\"],null]}]]}]}]\n18:[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"登記成功 ≠ 主題已開\"}],[\"$\",\"li\",\"1\",{\"children\":\"同一套主題，多條管道\"}],[\"$\",\"li\",\"2\",{\"children\":\"先測一則，再決定要不要加主題\"}]]}]\n19:[\"$\",\"figure\",\"2\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"✓再開總開關✓勾主題✓可傳一則測試\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"登記之後\"}]]}]\n1a:[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、測試通知會打到哪\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"「傳一則測試通知」會同時打已允許的電腦與手機，用來確認權限，不是盤中急拉。沒有任何已登記裝置時，這顆鈕是停用的。測試成功只代表通道通了；之後仍只會推你勾過的主題，而且個股類預設在十三點二十分後安靜。把測試成功當成「可以開始跟單」是讀錯頁面。\"}]]]}]\n1b:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、換電腦、清資料時怎麼辦\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"換一台電腦或換一個瀏覽器，等於新的裝置，要再按一次允許電腦通知。清過網站資料、重裝瀏覽器，訂閱也可能消失，同樣再允許一次即可。頁面提供「重新允許這台電腦」，就是為了這種情況。換裝置不會自動把主題重設；主題存在帳號偏好裡，跟哪一台電腦無關。\"}]]]}]\n1c:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"用 Safari 或 Firefox 可以嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"頁面以是否支援系統通知為準。不支援時會請你改用電腦版 Chrome 或 Edge，不要在不支援的瀏覽器重複點。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"允許了但右下角都不彈？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"先看主題有沒有勾、總開關有沒有開、是不是盤中時段、個股過濾是不是把範圍收成空的。再按測試通知排除權限。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"電腦開了，手機會不會重複？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"會同時收。這是兩條管道，不是兩套主題。嫌重複就只留你當下看得到的那一台裝置。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"這算不算盤中喊單？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"不算。它只是把你勾過的事件彈到電腦。方向、進出點與精選訊號仍不是一般會員通知的內容。\"}]]}]]}]]]}]\n1d:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"電腦通知就是通知中心那顆「允許電腦通知」。用 Chrome 或 Edge 允許權限，再勾主題。它多一條管道，不改通知的性質。\"}]]]}]\n1e:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L17\",\"0-通知中心\",{\"href\":\"/review\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"通知中心\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L17\",\"0-使用手冊\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"使用手冊\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L17\",\"0-新手導覽\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"新手導覽\"}]]}],[\"$\",\"li\",\"3\",{\"children\":[[\"$\",\"$L17\",\"0-關於股市大佬\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"關於股市大佬\"}]]}]]}]]]}]\n13:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\nf:null\n1f:I[80622,[],\"IconMark\"]\n11:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"股市大佬電腦通知怎麼設？3個檢查｜股市大佬 TradeBoss\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"以前很多人以為股市大佬只能在手機收通知。現在通知中心多了瀏覽器 Web Push：用電腦版 Chrome 或 Edge，按「允許電腦通知」，系統跳出視窗時選允許，之後主題就會彈到右下角。這不是另外一套喊單，只是同一組主題多一條送到電腦的路。\"}],[\"$\",\"link\",\"2\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}],[\"$\",\"$L1f\",\"3\",{}]],\"error\":null,\"digest\":\"$undefined\"}\n16:\"$11:metadata\"\n"}