l,[[\"$\",\"$L12\",null,{\"children\":\"$L13\"}],[\"$\",\"meta\",null,{\"name\":\"next-size-adjust\",\"content\":\"\"}]],[\"$\",\"$L14\",null,{\"children\":[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$15\",null,{\"fallback\":null,\"children\":\"$L16\"}]}]}]]}]\n17:I[52619,[\"2619\",\"static/chunks/2619-04bc32f026a0d946.js\",\"6309\",\"static/chunks/app/learn/%5Bslug%5D/page-f7b99344f7e2ee16.js\"],\"\"]\nd:[\"$\",\"div\",null,{\"className\":\"LearnArticle_wrap__LIQ8G\",\"children\":[\"$\",\"article\",null,{\"className\":\"LearnArticle_article__2nBbk\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_meta__etj_G\",\"children\":[[\"$\",\"$L17\",null,{\"className\":\"LearnArticle_cat__GQMlg\",\"href\":\"/learn?c=events\",\"children\":\"金融大事件\"}],[\"$\",\"span\",null,{\"className\":\"LearnArticle_read__QEj6a\",\"children\":\"閱讀約 5 分鐘\"}]]}],[\"$\",\"h1\",null,{\"className\":\"LearnArticle_title__0_la8\",\"children\":\"黑色星期一怎麼看？流動性比方向先消失\"}],[\"$\",\"details\",null,{\"className\":\"LearnArticle_toc__LcSAa\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"LearnArticle_tocSummary__YBddG\",\"children\":\"本文目錄\"}],[\"$\",\"ol\",null,{\"className\":\"LearnArticle_tocList__Rq_Lz\",\"children\":[[\"$\",\"li\",\"sec-1\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-1\",\"children\":\"一、那天最反直覺的不是跌多少，是沒人接\"}]}],[\"$\",\"li\",\"sec-2\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-2\",\"children\":\"二、相似規則同時觸發，會把跌幅做成結構\"}]}],[\"$\",\"li\",\"sec-3\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-3\",\"children\":\"三、熔斷被發明，是為了讓掛單有時間回來\"}]}],[\"$\",\"li\",\"sec-4\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-4\",\"children\":\"四、極端案例能帶走的心法：先管離場成本\"}]}],[\"$\",\"li\",\"sec-5\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-5\",\"children\":\"五、不要用一九八七年預測下一次\"}]}],[\"$\",\"li\",\"sec-6\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-6\",\"children\":\"常見問題 FAQ\"}]}],[\"$\",\"li\",\"sec-7\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-7\",\"children\":\"總結\"}]}],[\"$\",\"li\",\"sec-8\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-8\",\"children\":\"延伸閱讀\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"LearnArticle_body__6B7Mb\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_intro__ATV5c\",\"children\":\"一九八七年十月十九日，美國股市在單日內出現極端跌幅，後來被稱作黑色星期一。事後解釋很多：估值、程式交易、避險策略互相追趕。對今天還在看盤的人，比較有用的不是復盤當天點位，而是那一天把一件平常被忽略的事先攤開——要賣的人同時出現時，買方可能暫時不在。方向還沒被討論完，流動性先出事。\"}],[],[\"$\",\"div\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"極端日先壞的是成交對手，不是你的看法有沒有道理\"}],[\"$\",\"li\",\"1\",{\"children\":\"很多人同時用相似規則出場，會把跌幅放大成結構事件\"}],[\"$\",\"li\",\"2\",{\"children\":\"熔斷是為了讓人有時間重新掛單，不是為了告訴你該買還是該賣\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、那天最反直覺的不是跌多少，是沒人接\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"平常下跌，總還有人願意在更低的價格掛買單。極端日的特徵是：價格往下走的速度，快過新買單出現的速度。報價變寬、成交變少、你想離開卻找不到對手。這時候帳戶上的數字看起來像方向問題，實際先碰到的是流動性問題。看法對錯要等市場恢復雙邊報價之後才有意義；在那之前，先問自己的部位能不能在沒人接的時候活著。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"極端日先問有沒有對手，再問方向\"}],[\"$\",\"li\",\"1\",{\"children\":\"報價變寬、成交變少，是流動性警訊\"}],[\"$\",\"li\",\"2\",{\"children\":\"看法再正確，也要先付得出離場成本\"}]]}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、相似規則同時觸發，會把跌幅做成結構\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"當年被廣泛討論的一條線，是投資組合保險與程式停損：價格往下，規則要求再賣，賣又讓價格更往下。不必把責任全推給某一套程式，結構已經夠清楚——當很多參與者用相似條件出場，市場會在短時間內出現單邊供給。台股也看得到縮小版：停損堆在同一條線、融資維持率接近臨界、族群一起被砍。單看自己的規則很合理，加總起來卻可能變成同一方向的擠壓。\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"表面看起來\"}],[\"$\",\"th\",\"1\",{\"children\":\"結構上可能是\"}],[\"$\",\"th\",\"2\",{\"children\":\"對個人的含意\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"今天特別弱\"}],[\"$\",\"td\",\"1\",{\"children\":\"很多人的規則同時要賣\"}],[\"$\",\"td\",\"2\",{\"children\":\"先減自己的擁擠風險\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"沒人要買\"}],[\"$\",\"td\",\"1\",{\"children\":\"買單暫時撤或不敢掛\"}],[\"$\",\"td\",\"2\",{\"children\":\"離場成本會突然變貴\"}]]}],[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"消息面很空\"}],[\"$\",\"td\",\"1\",{\"children\":\"消息只是點火，燃料是相同規則\"}],[\"$\",\"td\",\"2\",{\"children\":\"不要只在新聞裡找原因\"}]]}],[\"$\",\"tr\",\"3\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"我的停損很合理\"}],[\"$\",\"td\",\"1\",{\"children\":\"別人的停損可能跟你重疊\"}],[\"$\",\"td\",\"2\",{\"children\":\"位置要避開明顯擁擠處\"}]]}]]}]]}]}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、熔斷被發明，是為了讓掛單有時間回來\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"黑色星期一之後，主要市場陸續設計暫停交易的機制，台股後來也有相關討論與制度演進。熔斷常被誤解成「保護你的獲利」或「暗示官方看多」。它真正想做的事比較樸素：當價格移動太快，先停一下，讓報價雙方有時間重新掛單，減少在沒有對手時一路滑下去。停的那段時間不告訴你下一步該怎麼做，它只給流動性一個喘息。把熔斷讀成買賣訊號，是把制度工具誤當成預測工具。\"}],\"$L18\",\"$L19\"]]}],\"$L1a\",\"$L1b\",\"$L1c\",\"$L1d\",\"$L1e\"],\"$L1f\"]}]]}]}]\n18:[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"熔斷先服務流動性，不服務方向判斷\"}],[\"$\",\"li\",\"1\",{\"children\":\"暫停期間不要用想像補齊故事\"}],[\"$\",\"li\",\"2\",{\"children\":\"恢復交易後，先看買賣掛單有沒有回來\"}]]}]\n19:[\"$\",\"figure\",\"2\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"✓部位不必一次逃完✓停損避開擁擠處✓相關曝險有上限\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"事先能做的三件事\"}]]}]\n1a:[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、極端案例能帶走的心法：先管離場成本\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"能從這類事件活下來的做法，通常不是事先猜到那天，而是事先假設「有些日子你沒辦法用平常的價格離開」。於是部位不會大到必須在同一分鐘全部逃出，相關標的也不會加總成同一個賭注。這跟看不看得懂國際新聞無關，跟你有沒有把流動性當成風險有關。傳奇故事喜歡講誰當天反向做對；比較能複製的是誰當天不必在沒人接的時候離場。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"假設有些日子離場會變貴\"}],[\"$\",\"li\",\"1\",{\"children\":\"部位小到不必同一分鐘逃完\"}],[\"$\",\"li\",\"2\",{\"children\":\"相關標的加總後，仍要有上限\"}]]}]]]}]\n1b:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、不要用一九八七年預測下一次\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"觸發點、商品、交易時段與參與者結構都變了。歷史能給的是行為韻腳：擁擠的規則、突然消失的對手、以及事後人人都說自己早知道。不能給的是下一次的日期與點位。把黑色星期一當成流動性教材，比當成行情月曆實際得多。想成功，先把「我一定出得去」這句假設拿掉，再談策略漂不漂亮。\"}]]]}]\n1c:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"黑色星期一是不是程式交易造成的？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"程式是被討論的因素之一，不是唯一答案。更穩定的結構是：相似規則同時賣、對手暫時消失。把責任縮成單一兇手，會漏掉自己也可能參與的擁擠。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"台股也會遇到流動性突然消失嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"會，尤其在個股與較薄的商品。漲跌停鎖死、處置、開盤跳空，都是「想走卻走不快」的日常版。大事件只是把同一件事放到最大。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"熔斷出現該不該進場？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"熔斷不構成進場理由。它只是暫停。恢復後要重新看掛單與自己的規則，不能把暫停本身讀成底部訊號。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"我能為這種日子做什麼準備？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"降低必須同一分鐘逃完的部位、避開過度擁擠的停損位置、承認有些日子離場會變貴。準備的是結構，不是預測日期。\"}]]}]]}]]]}]\n1d:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"黑色星期一最值得帶走的不是點位，是流動性可以先於方向消失。相似規則同時出場會放大跌幅，熔斷是為了讓掛單回來。先管離場成本，不要用一九八七年預測下一次。\"}]]]}]\n1e:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L17\",\"0-台股大行情的行為\",{\"href\":\"/learn/taiwan-stock-market-history-lessons\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"台股大行情的行為教訓\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L17\",\"0-流動性與胃納量\",{\"href\":\"/learn/why-liquidity-decides-your-exit\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"流動性與胃納量\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L17\",\"0-熔斷與制度：台股\",{\"href\":\"/school\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"熔斷與制度：台股學堂\"}]]}]]}]]]}]\n1f:[\"$\",\"div\",null,{\"className\":\"LearnArticle_related__9qV55\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_relatedTitle__RXfrl\",\"children\":\"相關文章\"}],[[\"$\",\"$L17\",\"taiwan-stock-market-history-lessons\",{\"href\":\"/learn/taiwan-stock-market-history-lessons\",\"className\":\"LearnArticle_relatedLink__mibXe\",\"children\":\"台股大行情的行為教訓\"}],[\"$\",\"$L17\",\"why-liquidity-decides-your-exit\",{\"href\":\"/learn/why-liquidity-decides-your-exit\",\"className\":\"LearnArticle_relatedLink__mibXe\",\"children\":\"流動性與胃納量\"}]]]}]\n13:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\nf:null\n20:I[80622,[],\"IconMark\"]\n11:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"黑色星期一怎麼看？流動性比方向先消失｜股市大佬 TradeBoss\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"一九八七年十月十九日，美國股市在單日內出現極端跌幅，後來被稱作黑色星期一。事後解釋很多：估值、程式交易、避險策略互相追趕。對今天還在看盤的人，比較有用的不是復盤當天點位，而是那一天把一件平常被忽略的事先攤開——要賣的人同時出現時，買方可能暫時不在。方向還沒被討論完，流動性先出事。\"}],[\"$\",\"link\",\"2\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}],[\"$\",\"$L20\",\"3\",{}]],\"error\":null,\"digest\":\"$undefined\"}\n16:\"$11:metadata\"\n"}