\",\"sec-2\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-2\",\"children\":\"二、三句話就夠用\"}]}],[\"$\",\"li\",\"sec-3\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-3\",\"children\":\"三、為什麼不能拿來排時間表\"}]}],[\"$\",\"li\",\"sec-4\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-4\",\"children\":\"四、和從眾、題材輪動的關係\"}]}],[\"$\",\"li\",\"sec-5\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-5\",\"children\":\"五、最小動作\"}]}],[\"$\",\"li\",\"sec-6\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-6\",\"children\":\"常見問題 FAQ\"}]}],[\"$\",\"li\",\"sec-7\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-7\",\"children\":\"總結\"}]}],[\"$\",\"li\",\"sec-8\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-8\",\"children\":\"延伸閱讀\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"LearnArticle_body__6B7Mb\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_intro__ATV5c\",\"children\":\"反射理論常被講成「索羅斯能預測泡沫」。他自己的公開寫作比較像在說：參與者的偏誤會進入價格，價格又會改變被觀察的現實，於是市場可以在一段時間裡自己加強自己。它解釋的是不穩定為什麼會出現，不是下一次從哪一天開始。當預測機器用，理論就被讀壞了。\"}],[],[\"$\",\"div\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"價格不只反映現實，有時也在改寫現實\"}],[\"$\",\"li\",\"1\",{\"children\":\"自我加強會結束，結束點事先很難標\"}],[\"$\",\"li\",\"2\",{\"children\":\"理論幫你承認不穩定，不幫你排進出場時間表\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、先講清楚反射兩個字\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"公開表述大致是：觀察者不是站在市場外面。你的看法會透過買賣進入價格，價格會影響融資、投資與信心，這些再回頭變成「基本面」。於是有些行情看起來像基本面在走，其實是價格與敘述在互相餵養。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"看法會進價格\"}],[\"$\",\"li\",\"1\",{\"children\":\"價格會改行為\"}],[\"$\",\"li\",\"2\",{\"children\":\"行為再被叫做基本面\"}]]}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、三句話就夠用\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"第一，熱門敘述可以自己造出一段真實的訂單。第二，這段可以走得比你以為的久。第三，它結束時，離開會比進場擠。三句都承認不穩定；沒有一句給你日期。\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"誤當成\"}],[\"$\",\"th\",\"1\",{\"children\":\"理論比較像\"}],[\"$\",\"th\",\"2\",{\"children\":\"你能做的\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"預測泡沫頂\"}],[\"$\",\"td\",\"1\",{\"children\":\"解釋為何會走偏\"}],[\"$\",\"td\",\"2\",{\"children\":\"把擁擠寫進風險\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"一定會崩\"}],[\"$\",\"td\",\"1\",{\"children\":\"自我加強會結束\"}],[\"$\",\"td\",\"2\",{\"children\":\"先寫離開條件\"}]]}],[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"跟他做同一筆\"}],[\"$\",\"td\",\"1\",{\"children\":\"條件已不同\"}],[\"$\",\"td\",\"2\",{\"children\":\"只留結構\"}]]}],[\"$\",\"tr\",\"3\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"基本面沒用\"}],[\"$\",\"td\",\"1\",{\"children\":\"基本面會被價格改寫\"}],[\"$\",\"td\",\"2\",{\"children\":\"兩邊都要看\"}]]}]]}]]}]}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、為什麼不能拿來排時間表\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"自我加強的過程沒有固定長度。你若用理論去等「該崩的那天」，會把教材讀成月曆。一九九〇年與科技泡沫那兩篇寫過類似的事後聰明。反射幫你理解為什麼故事可以走很遠，不幫你按鈴。\"}],[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"承認它可能比你能等的更久\"}],[\"$\",\"li\",\"1\",{\"children\":\"也承認結束會很快\"}],[\"$\",\"li\",\"2\",{\"children\":\"所以部位要先假設兩種都可能\"}]]}],[\"$\",\"figure\",\"2\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"!當月曆!當必崩!當模仿密技\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"讀壞\"}]]}]]]}],[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[\"$L18\",[\"$L19\",\"$L1a\"]]}],\"$L1b\",\"$L1c\",\"$L1d\",\"$L1e\"],\"$L1f\"]}]]}]}]\n18:[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、和從眾、題材輪動的關係\"}]\n19:[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"從眾講的是人擠在同一句話。反射多講一層：這句話改變了現實，再讓更多人覺得自己是對的。題材熱的時候兩層會疊在一起。檢查擁擠仍然比預測反轉有用。\"}]\n1a:[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"從眾是人\"}],[\"$\",\"li\",\"1\",{\"children\":\"反射是人加回饋\"}],[\"$\",\"li\",\"2\",{\"children\":\"先標擁擠再談理論\"}]]}]\n1b:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、最小動作\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"對你手上最熱的那句敘述，寫：它已經改了哪些真實訂單？若敘述明天停，誰還接你的部位？第二題寫不出來，理論只是讓你更敢留。\"}]]]}]\n1c:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"是不是講泡沫一定會破？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"自我加強會結束，結束方式與時間不是理論能給的。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"那還有基本面嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"有。只是基本面有時已被價格改過，不能當成外在常數。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"散戶用得到嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"用在承認不穩定與擁擠，不用在預測日期。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"和索羅斯某一筆傳奇有什麼關係？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"傳奇是事後故事。結構在別的年份也會以別的名字出現。\"}]]}]]}]]]}]\n1d:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"反射是價格與現實互相餵養，不是預測機器。三句話：敘述能造訂單、能走很久、結束會擠。部位先假設兩種都可能。\"}]]]}]\n1e:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L17\",\"0-從眾行為\",{\"href\":\"/learn/herding-in-markets\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"從眾行為\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L17\",\"0-2000 科技泡\",{\"href\":\"/learn/dotcom-bubble-2000-story-vs-price\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"2000 科技泡沫\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L17\",\"0-題材輪動\",{\"href\":\"/learn/what-theme-rotation-is-actually-doing\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"題材輪動\"}]]}]]}]]]}]\n1f:[\"$\",\"div\",null,{\"className\":\"LearnArticle_related__9qV55\",\"children\":[[\"$