n\":[[\"$\",\"summary\",null,{\"className\":\"LearnArticle_tocSummary__YBddG\",\"children\":\"本文目錄\"}],[\"$\",\"ol\",null,{\"className\":\"LearnArticle_tocList__Rq_Lz\",\"children\":[[\"$\",\"li\",\"sec-1\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-1\",\"children\":\"一、進場時從眾很舒服，離開時才收費\"}]}],[\"$\",\"li\",\"sec-2\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-2\",\"children\":\"二、三層訊號，比「我覺得大家都在買」清楚\"}]}],[\"$\",\"li\",\"sec-3\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-3\",\"children\":\"三、故意反向不是解藥\"}]}],[\"$\",\"li\",\"sec-4\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-4\",\"children\":\"四、法人也會從眾，只是句子比較正式\"}]}],[\"$\",\"li\",\"sec-5\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-5\",\"children\":\"五、你可以帶走的最小動作\"}]}],[\"$\",\"li\",\"sec-6\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-6\",\"children\":\"常見問題 FAQ\"}]}],[\"$\",\"li\",\"sec-7\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-7\",\"children\":\"總結\"}]}],[\"$\",\"li\",\"sec-8\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-8\",\"children\":\"延伸閱讀\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"LearnArticle_body__6B7Mb\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_intro__ATV5c\",\"children\":\"一個人做錯，叫判斷；一群人同一時間用同一句話進場，叫擁擠。從眾不是說群眾永遠錯，是說當同意太整齊，離開的門會變窄。聊天室愈安靜地一致，你愈要把「安心」翻譯成「萬一要走，對手在哪」。這篇不叫你故意做反向，只叫你認得擁擠。\"}],[],[\"$\",\"div\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"從眾的代價通常付在離場，不付在進場當下\"}],[\"$\",\"li\",\"1\",{\"children\":\"討論、成交、槓桿三層一起熱，比單一熱度更值得警覺\"}],[\"$\",\"li\",\"2\",{\"children\":\"安心感本身可以是風險被低估的症狀\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、進場時從眾很舒服，離開時才收費\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"大家都在買的時候，你不缺對手，價格還常順著你。問題發生在看法要改的那一天：同一句話同時要出門，流動性不夠用。一九九〇年與後來多次題材退潮，縮小版都是這件事。你不必預測頂，只要承認舒服可能來自擁擠，不是來自你比較懂。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"進場對手多，不代表離開也多\"}],[\"$\",\"li\",\"1\",{\"children\":\"同一句話要出門時最擠\"}],[\"$\",\"li\",\"2\",{\"children\":\"舒服要先翻譯成擁擠檢查\"}]]}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、三層訊號，比「我覺得大家都在買」清楚\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"討論層：同一組關鍵字短時間佔滿時間軸。成交層：量突然放大而且持續用同一種敘述解釋。槓桿層：融資、選擇權或相關商品的使用明顯變積極。一層熱可以是真的有事；三層一起熱，離開計畫要寫得更醜。\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"層\"}],[\"$\",\"th\",\"1\",{\"children\":\"你看得到的\"}],[\"$\",\"th\",\"2\",{\"children\":\"比較穩的翻譯\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"討論\"}],[\"$\",\"td\",\"1\",{\"children\":\"同一句話到處都是\"}],[\"$\",\"td\",\"2\",{\"children\":\"敘述成本變低，差異變少\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"成交\"}],[\"$\",\"td\",\"1\",{\"children\":\"量價配合同一故事\"}],[\"$\",\"td\",\"2\",{\"children\":\"故事正在被交易，不是即將開始\"}]]}],[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"槓桿\"}],[\"$\",\"td\",\"1\",{\"children\":\"借來的風險變多\"}],[\"$\",\"td\",\"2\",{\"children\":\"回落時被迫出場的人變多\"}]]}],[\"$\",\"tr\",\"3\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"只有一層熱\"}],[\"$\",\"td\",\"1\",{\"children\":\"可能有事\"}],[\"$\",\"td\",\"2\",{\"children\":\"先當背景，不當擁擠結論\"}]]}]]}]]}]}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、故意反向不是解藥\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"看到擁擠就做相反，只是另一種從眾：從眾於「要當那個清醒的人」。反向一樣要有理由、失效與上限。擁擠檢查的用途是把部位與離開條件收緊，不是自動翻方向。翻方向沒有自己的系統，只是換一群人一起站。\"}],[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"先標現在擁擠在哪一句話\"}],[\"$\",\"li\",\"1\",{\"children\":\"再收部位或收緊離開\"}],[\"$\",\"li\",\"2\",{\"children\":\"沒有自己的理由就不要只為了反向而反向\"}]]}],[\"$\",\"figure\",\"2\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"!安心當分析!為反向而反向!以為法人不會擠\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"兩種假動作\"}]]}]]]}],\"$L18\",\"$L19\",\"$L1a\",\"$L1b\",\"$L1c\"],\"$L1d\"]}]]}]}]\n18:[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、法人也會從眾，只是句子比較正式\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"報告語言比較乾淨，不代表持倉過程不擁擠。指標、因子、同一組財報數字，也可以讓專業資金在同一時間做類似的事。散戶從眾比較吵，法人從眾比較安靜。安靜不比較安全。你要看的是持倉與流動性，不是誰的語氣比較像研究。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"正式語言≠不擁擠\"}],[\"$\",\"li\",\"1\",{\"children\":\"同一因子也能造成擁擠\"}],[\"$\",\"li\",\"2\",{\"children\":\"看持倉與流動性，不看語氣\"}]]}]]]}]\n19:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、你可以帶走的最小動作\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"熱的時候多寫一行：如果明天這句話要撤退，誰接我的部位？寫得出對手，擁擠仍可能存在，但你至少沒把安心當成分析。寫不出來，就把這筆當成示範，不要當成信念。\"}]]]}]\n1a:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"大家都買就一定會跌嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"不一定。擁擠提高的是離開難度，不是保證反轉。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"沒人討論的股票是不是比較安全？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"可能只是流動性更差。安靜不是安全標籤。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"社群熱度能不能當指標？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"可以當一層背景。單獨一層不夠，還要看量與槓桿。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"法人買超算不算從眾？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"可能是各自研究剛好同向，也可能是因子擁擠。不要用單一買賣超當答案。\"}]]}]]}]]]}]\n1b:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"從眾的帳單多半開在離場。討論、成交、槓桿三層一起熱，就把離開條件寫醜一點。故意反向不是解藥。\"}]]]}]\n1c:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L17\",\"0-1990 台股萬\",{\"href\":\"/learn/taiwan-1990-crash-what-it-still-teaches\",\"className\":\"LearnArticle_link__gMwHV\",\"child