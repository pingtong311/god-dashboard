66.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"$undefined\"}]],[\"$\",\"$Le\",null,{\"children\":[\"$Lf\",[\"$\",\"$L10\",null,{\"promise\":\"$@11\"}]]}]]}]\nb:[\"$\",\"$1\",\"h\",{\"children\":[null,[[\"$\",\"$L12\",null,{\"children\":\"$L13\"}],[\"$\",\"meta\",null,{\"name\":\"next-size-adjust\",\"content\":\"\"}]],[\"$\",\"$L14\",null,{\"children\":[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$15\",null,{\"fallback\":null,\"children\":\"$L16\"}]}]}]]}]\n17:I[52619,[\"2619\",\"static/chunks/2619-04bc32f026a0d946.js\",\"6309\",\"static/chunks/app/learn/%5Bslug%5D/page-f7b99344f7e2ee16.js\"],\"\"]\nd:[\"$\",\"div\",null,{\"className\":\"LearnArticle_wrap__LIQ8G\",\"children\":[\"$\",\"article\",null,{\"className\":\"LearnArticle_article__2nBbk\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_meta__etj_G\",\"children\":[[\"$\",\"$L17\",null,{\"className\":\"LearnArticle_cat__GQMlg\",\"href\":\"/learn?c=rules\",\"children\":\"制度與工具\"}],[\"$\",\"span\",null,{\"className\":\"LearnArticle_read__QEj6a\",\"children\":\"閱讀約 7 分鐘\"}]]}],[\"$\",\"h1\",null,{\"className\":\"LearnArticle_title__0_la8\",\"children\":\"本益比河流圖怎麼看？股價掉到「便宜區」就能買？3 步驟看懂估值陷阱\"}],[\"$\",\"details\",null,{\"className\":\"LearnArticle_toc__LcSAa\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"LearnArticle_tocSummary__YBddG\",\"children\":\"本文目錄\"}],[\"$\",\"ol\",null,{\"className\":\"LearnArticle_tocList__Rq_Lz\",\"children\":[[\"$\",\"li\",\"sec-1\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-1\",\"children\":\"一、本益比河流圖是什麼？那些顏色代表什麼意思？\"}]}],[\"$\",\"li\",\"sec-2\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-2\",\"children\":\"二、河流圖的「河流」是怎麼算出來的？為什麼會變寬或變窄？\"}]}],[\"$\",\"li\",\"sec-3\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-3\",\"children\":\"三、最常見的錯誤：看到股價掉到「便宜區」就馬上進場？\"}]}],[\"$\",\"li\",\"sec-4\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-4\",\"children\":\"四、如何正確使用河流圖？觀察「河流方向」比「股價位置」更重要\"}]}],[\"$\",\"li\",\"sec-5\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-5\",\"children\":\"五、哪些股票不適合用本益比河流圖評估？\"}]}],[\"$\",\"li\",\"sec-6\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-6\",\"children\":\"常見問題 FAQ\"}]}],[\"$\",\"li\",\"sec-7\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-7\",\"children\":\"總結\"}]}],[\"$\",\"li\",\"sec-8\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-8\",\"children\":\"延伸閱讀\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"LearnArticle_body__6B7Mb\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_intro__ATV5c\",\"children\":\"打開分析工具，看到一張五顏六色的「本益比河流圖」，聽說可以一眼看出股價是貴還是便宜，但上面的線條到底是什麼意思？為什麼股價掉到最下面的「便宜區」，之後卻跌得更慘？這篇文章會帶你拆解河流圖的組成，讓你學會如何判斷現在的股價位階，以及避開最常見的估值陷阱。\"}],[[\"$\",\"figure\",\"figure-0\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"沒扣成本的勝率，看起來都會比較漂亮0.029%手續費 1 折來回0.15%當沖證交稅0.06%滑價估計三項合計約 0.24%；留倉稅率更高，約 0.39%\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"示意圖｜當沖來回成本：1 折手續費 + 證交稅 + 滑價（教學結構，不是某檔實盤）\"}]]}]],[\"$\",\"div\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"河流圖的「河流」是歷史本益比區間，不是未來股價走勢。\"}],[\"$\",\"li\",\"1\",{\"children\":\"股價掉進「便宜區」不代表必漲，要小心獲利衰退的價值陷阱。\"}],[\"$\",\"li\",\"2\",{\"children\":\"河流圖只適用獲利穩定的公司，景氣循環或虧損股會失準。\"}],[\"$\",\"li\",\"3\",{\"children\":\"判斷關鍵是「河流往上走」，代表公司有成長，估值才有參考性。\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、本益比河流圖是什麼？那些顏色代表什麼意思？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"本益比河流圖其實是把「股價」和「本益比」兩種資訊畫在同一張圖上。它的核心是「本益比（P/E Ratio）」，也就是用「現在股價」除以「每股盈餘（EPS）」。河流圖把過去一段時間的本益比高低點分成了幾個顏色區間，讓你快速比對現在的股價落在哪個估值水平。\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"顏色區間\"}],[\"$\",\"th\",\"1\",{\"children\":\"代表意義\"}],[\"$\",\"th\",\"2\",{\"children\":\"投資人情緒\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"紅色／紫色 (昂貴區)\"}],[\"$\",\"td\",\"1\",{\"children\":\"歷史本益比高點\"}],[\"$\",\"td\",\"2\",{\"children\":\"市場過度樂觀\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"灰色／黃色 (合理區)\"}],[\"$\",\"td\",\"1\",{\"children\":\"歷史本益比平均\"}],[\"$\",\"td\",\"2\",{\"children\":\"市場情緒平穩\"}]]}],[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"綠色／藍色 (便宜區)\"}],[\"$\",\"td\",\"1\",{\"children\":\"歷史本益比低點\"}],[\"$\",\"td\",\"2\",{\"children\":\"市場過度悲觀\"}]]}]]}]]}]}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、河流圖的「河流」是怎麼算出來的？為什麼會變寬或變窄？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"河流圖的上下緣，其實是用公司過去的「每股盈餘（EPS）」乘上不同的「本益比倍數」算出來的。例如，上緣可能是用 EPS 乘以 30 倍本益比，下緣是用 EPS 乘以 10 倍本益比。當公司 EPS 成長時，整個河流就會跟著往上走、變寬；反之，如果 EPS 衰退，河流就會往下沉、變窄。\"}],[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"找出歷史本益比區間：統計公司過去 3-5 年的本益比，找出最高、最低和平均值。\"}],[\"$\",\"li\",\"1\",{\"children\":\"設定倍數：將最高值設為「昂貴」倍數（如 30 倍），最低值設為「便宜」倍數（如 10 倍）。\"}],[\"$\",\"li\",\"2\",{\"children\":\"計算價格上下緣：將每季的 EPS 分別乘以這些倍數，就能畫出河流的邊界。例如 EPS 為 5 元，昂貴價就是 150 元 (5*30)，便宜價就是 50 元 (5*10)。\"}]]}]]]}],\"$L18\",\"$L19\",\"$L1a\",\"$L1b\",\"$L1c\",\"$L1d\"],null]}]]}]}]\n18:[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、最常見的錯誤：看到股價掉到「便宜區」就馬上進場？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"這是新手最容易犯的錯。股價掉到藍色的「便宜區」，只代表「用過去的標準來看，現在的本益比很低」，但不保證未來會漲回去。你必須多問一個問題：為什麼市場願意用這麼低的本益比賣它？很可能是公司的獲利能力（EPS）正在衰退，導致整個河流都在「下沉」。如果你只看到股價便宜就買，結果公司下一季財報出來 EPS 大幅下滑，河流的下緣會跟著下修，你以為的「便宜價」可能瞬間變成「合理價」，甚至「昂貴價」。這就是所謂的「價值陷阱」。\"}],[\"$\",\"figure\",\"1\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"!景氣循環股!公司由盈轉虧!獲利暴起暴落\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"河流圖 3 大失靈時機\"}]]}]]]}]\n19:[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、如何正確使用河流圖？觀察「河流方向」比「股價位置」更重要\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"一個健康的本益比河流圖，應該是穩定「向上」流動的。這代表公司的基石——每股盈餘（EPS）——正在持續成長。在這種情況下，當股價因為市場短期恐慌而暫時回檔到「合理區」或「便宜區」時，才比較有參考價值，這才是比較穩健的觀察方式。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"確認河流方向：優先找河流趨勢穩定向上的公司。\"}],[\"$\",\"li\",\"1\",{\"children\":\"檢查 EPS 趨勢：到財報區確認近幾季的 EPS 是否真的在成長。\"}],[\"$\",\"li\",\"2\",{\"children\":\"對照股價位置：在前兩者都成立的前提下，股價落入合理或便宜區，才是一個值得留意的訊號。\"}]]}]]]}]\n1a:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、哪些股票不適合用本益比河流圖評估？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"本益比河流圖不是萬靈丹，它有很強的適用前提，就是「公司獲利穩定且可預測」。如果用在不適合的股票上，很容易做出錯誤判斷。特別是景氣循環股，它們的獲利高峰與低谷非常巨大，用歷史本益比去推斷未來，往往會買在高點、賣在低點。\"}],[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"景氣循環股：如航運、鋼鐵、塑化，獲利起伏大，本益比在獲利高峰時最低，反而是危險訊號。\"}],[\"$\",\"li\",\"1\",{\"children\":\"虧錢或獲利不穩的公司：EPS 是負的或時好時壞，本益比沒有意義，河流圖會嚴重扭曲。\"}],[\"$\",\"li\",\"2\",{\"children\":\"新創或成長初期的公司：還在燒錢擴張，市場常用未來夢想來估值，不適用本益比。\"}]]}]]]}]\n1b:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"本益比河流圖的本益比是用預估的還是過去的 EPS 計算的？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"市面上多數的河流圖，都是用「過去 12 個月（Trailing Twelve Months, TTM）」的歷史 EPS 來計算，優點是數字客觀，缺點是可能落後反映公司最新狀況。有些研究報告會用「預估 EPS」來畫，但預估值本身就有不確定性。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"河流圖中的股價，是用日線、週線還是月線？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"通常是用每日的收盤價畫成的線圖，疊加在用每季公布的 EPS 所計算出來的河流色塊上。這樣可以很清楚地對照每日股價在不同估值區間的位置。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"如果一家公司長期都在「昂貴區」交易，代表它永遠都很貴嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"不一定。對於高速成長、擁有強大護城河的公司，市場願意給予較高的本益比（稱為「成長溢價」）。如果它的 EPS 成長速度能跟上，河流就會不斷墊高，讓現在的昂貴價變成未來的合理價。重點還是 EPS 有沒有持續成長。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"我可以在哪裡看到本益比河流圖？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"許多券商軟體和財經網站都有提供這個功能。在股市大佬的「個股透視」頁面中，我們也整合了河流圖與關鍵財務數據，幫助你做更全面的評估。\"}]]}]]}]]]}]\n1c:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"總結來說，使用本益比河流圖的關鍵，是先看「河流方向」是否穩定向上，確認公司獲利有成長，再看「股價位置」是否落入相對合理的區間。千萬不要只看股價掉到便宜區就衝動買進，才能避開賺了價差、賠了價值的陷阱。\"}]]]}]\n1d:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L17\",\"0-前往「個股透視」\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"前往「個股透視」頁面，查看最新河流圖\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L17\",\"0-想學習更多估值方\",{\"href\":\"/school\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"想學習更多估值方法？來台股學堂看看\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L17\",\"0-用「本益比與估值\",{\"href\":\"/s/2330\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"用「本益比與估值」工具，篩選合理價股票\"}]]}]]}]]]}]\n13:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\nf:null\n1e:I[80622,[],\"IconMark\"]\n11:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"本益比河流圖怎麼看？股價掉到「便宜區」就能買？3 步驟看懂估值陷阱｜股市大佬 TradeBoss\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"打開分析工具，看到一張五顏六色的「本益比河流圖」，聽說可以一眼看出股價是貴還是便宜，但上面的線條到底是什麼意思？為什麼股價掉到最下面的「便宜區」，之後卻跌得更慘？這篇文章會帶你拆解河流圖的組成，讓你學會如何判斷現在的股價位階，以及避開最常見的估值陷阱。\"}],[\"$\",\"link\",\"2\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}],[\"$\",\"$L1e\",\"3\",{}]],\"error\":null,\"digest\":\"$undefined\"}\n16:\"$11:metadata\"\n"}