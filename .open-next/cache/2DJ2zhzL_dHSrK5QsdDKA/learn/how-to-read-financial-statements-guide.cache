lex\",\"flexDirection\":\"column\",\"alignItems\":\"center\",\"justifyContent\":\"center\"},\"children\":[\"$\",\"div\",null,{\"children\":[[\"$\",\"style\",null,{\"dangerouslySetInnerHTML\":{\"__html\":\"body{color:#000;background:#fff;margin:0}.next-error-h1{border-right:1px solid rgba(0,0,0,.3)}@media (prefers-color-scheme:dark){body{color:#fff;background:#000}.next-error-h1{border-right:1px solid rgba(255,255,255,.3)}}\"}}],[\"$\",\"h1\",null,{\"className\":\"next-error-h1\",\"style\":{\"display\":\"inline-block\",\"margin\":\"0 20px 0 0\",\"padding\":\"0 23px 0 0\",\"fontSize\":24,\"fontWeight\":500,\"verticalAlign\":\"top\",\"lineHeight\":\"49px\"},\"children\":404}],[\"$\",\"div\",null,{\"style\":{\"display\":\"inline-block\"},\"children\":[\"$\",\"h2\",null,{\"style\":{\"fontSize\":14,\"fontWeight\":400,\"lineHeight\":\"49px\",\"margin\":0},\"children\":\"This page could not be found.\"}]}]]}]}]],[]],\"forbidden\":\"$undefined\",\"unauthorized\":\"$undefined\"}]}],[\"$\",\"$L6\",null,{}],[\"$\",\"$L7\",null,{}],[\"$\",\"$L8\",null,{}]]}]]}]]}],{\"children\":[\"learn\",[\"$\",\"$1\",\"c\",{\"children\":[null,[\"$\",\"$L4\",null,{\"parallelRouterKey\":\"children\",\"error\":\"$undefined\",\"errorStyles\":\"$undefined\",\"errorScripts\":\"$undefined\",\"template\":[\"$\",\"$L5\",null,{}],\"templateStyles\":\"$undefined\",\"templateScripts\":\"$undefined\",\"notFound\":\"$undefined\",\"forbidden\":\"$undefined\",\"unauthorized\":\"$undefined\"}]]}],{\"children\":[[\"slug\",\"how-to-read-financial-statements-guide\",\"d\"],\"$L9\",{\"children\":[\"__PAGE__\",\"$La\",{},null,false]},null,false]},null,false]},null,false],\"$Lb\",false]],\"m\":\"$undefined\",\"G\":[\"$c\",[]],\"s\":false,\"S\":true}\ne:I[24431,[],\"OutletBoundary\"]\n10:I[15278,[],\"AsyncMetadataOutlet\"]\n12:I[24431,[],\"ViewportBoundary\"]\n14:I[24431,[],\"MetadataBoundary\"]\n15:\"$Sreact.suspense\"\n9:[\"$\",\"$1\",\"c\",{\"children\":[null,[\"$\",\"$L4\",null,{\"parallelRouterKey\":\"children\",\"error\":\"$undefined\",\"errorStyles\":\"$undefined\",\"errorScripts\":\"$undefined\",\"template\":[\"$\",\"$L5\",null,{}],\"templateStyles\":\"$undefined\",\"templateScripts\":\"$undefined\",\"notFound\":\"$undefined\",\"forbidden\":\"$undefined\",\"unauthorized\":\"$undefined\"}]]}]\na:[\"$\",\"$1\",\"c\",{\"children\":[\"$Ld\",[[\"$\",\"link\",\"0\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/css/3eaf36e367672966.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"$undefined\"}]],[\"$\",\"$Le\",null,{\"children\":[\"$Lf\",[\"$\",\"$L10\",null,{\"promise\":\"$@11\"}]]}]]}]\nb:[\"$\",\"$1\",\"h\",{\"children\":[null,[[\"$\",\"$L12\",null,{\"children\":\"$L13\"}],[\"$\",\"meta\",null,{\"name\":\"next-size-adjust\",\"content\":\"\"}]],[\"$\",\"$L14\",null,{\"children\":[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$15\",null,{\"fallback\":null,\"children\":\"$L16\"}]}]}]]}]\n17:I[52619,[\"2619\",\"static/chunks/2619-04bc32f026a0d946.js\",\"6309\",\"static/chunks/app/learn/%5Bslug%5D/page-f7b99344f7e2ee16.js\"],\"\"]\nd:[\"$\",\"div\",null,{\"className\":\"LearnArticle_wrap__LIQ8G\",\"children\":[\"$\",\"article\",null,{\"className\":\"LearnArticle_article__2nBbk\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_meta__etj_G\",\"children\":[[\"$\",\"$L17\",null,{\"className\":\"LearnArticle_cat__GQMlg\",\"href\":\"/learn?c=rules\",\"children\":\"制度與工具\"}],[\"$\",\"span\",null,{\"className\":\"LearnArticle_read__QEj6a\",\"children\":\"閱讀約 7 分鐘\"}]]}],[\"$\",\"h1\",null,{\"className\":\"LearnArticle_title__0_la8\",\"children\":\"財報怎麼看？四大報表入門教學，散戶也能看懂公司體質\"}],[\"$\",\"details\",null,{\"className\":\"LearnArticle_toc__LcSAa\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"LearnArticle_tocSummary__YBddG\",\"children\":\"本文目錄\"}],[\"$\",\"ol\",null,{\"className\":\"LearnArticle_tocList__Rq_Lz\",\"children\":[[\"$\",\"li\",\"sec-1\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-1\",\"children\":\"一、財報四大表是什麼？公司的體檢報告\"}]}],[\"$\",\"li\",\"sec-2\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-2\",\"children\":\"二、資產負債表：檢查公司的財務體質\"}]}],[\"$\",\"li\",\"sec-3\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-3\",\"children\":\"三、綜合損益表：判斷公司有沒有賺錢\"}]}],[\"$\",\"li\",\"sec-4\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-4\",\"children\":\"四、現金流量表：公司活下去的關鍵命脈\"}]}],[\"$\",\"li\",\"sec-5\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-5\",\"children\":\"五、如何整合運用？三張表一起看才完整\"}]}],[\"$\",\"li\",\"sec-6\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-6\",\"children\":\"常見問題 FAQ\"}]}],[\"$\",\"li\",\"sec-7\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-7\",\"children\":\"總結\"}]}],[\"$\",\"li\",\"sec-8\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-8\",\"children\":\"延伸閱讀\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"LearnArticle_body__6B7Mb\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_intro__ATV5c\",\"children\":\"打開財報，看到密密麻麻的資產、負債、現金流，是不是覺得頭昏眼花，想直接關掉？其實你不用成為會計師，這篇文章會教你抓住四大報表的幾個關鍵數字，三分鐘就能判斷公司體質是強壯還是虛胖。\"}],[[\"$\",\"figure\",\"figure-0\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"沒扣成本的勝率，看起來都會比較漂亮0.029%手續費 1 折來回0.15%當沖證交稅0.06%滑價估計三項合計約 0.24%；留倉稅率更高，約 0.39%\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"示意圖｜當沖來回成本：1 折手續費 + 證交稅 + 滑價（教學結構，不是某檔實盤）\"}]]}]],[\"$\",\"div\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"資產負債表看體質：負債比例最好低於 60%，代表公司財務結構穩健。\"}],[\"$\",\"li\",\"1\",{\"children\":\"損益表看獲利能力：毛利率與營業利益率要穩定或成長，代表本業有賺錢。\"}],[\"$\",\"li\",\"2\",{\"children\":\"現金流量表看生存關鍵：營業現金流必須是正數，才能證明公司賺到的是真金白銀。\"}],[\"$\",\"li\",\"3\",{\"children\":\"財報是歷史成績單，要搭配產業趨勢與公司前景一起看，才能做出更全面的判斷。\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、財報四大表是什麼？公司的體檢報告\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"想像一下，財報就像一家公司的健康檢查報告。它主要由四張表組成，分別從不同角度告訴你公司的狀況。看不懂財報，就像閉著眼睛買股票，風險很高。但只要搞懂這四張表各自的功能，你就能掌握公司最重要的資訊，知道它是不是一門好生意。\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"報表名稱\"}],[\"$\",\"th\",\"1\",{\"children\":\"回答的問題\"}],[\"$\",\"th\",\"2\",{\"children\":\"一個關鍵指標\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"資產負債表\"}],[\"$\",\"td\",\"1\",{\"children\":\"公司體質穩不穩？\"}],[\"$\",\"td\",\"2\",{\"children\":\"負債佔資產比率\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"綜合損益表\"}],[\"$\",\"td\",\"1\",{\"children\":\"公司生意賺不賺錢？\"}],[\"$\",\"td\",\"2\",{\"children\":\"營業利益率\"}]]}],[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"現金流量表\"}],[\"$\",\"td\",\"1\",{\"children\":\"公司手上的現金夠不夠？\"}],[\"$\",\"td\",\"2\",{\"children\":\"來自營業活動的現金流量\"}]]}],[\"$\",\"tr\",\"3\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"權益變動表\"}],[\"$\",\"td\",\"1\",{\"children\":\"賺的錢分給股東多少？\"}],[\"$\",\"td\",\"2\",{\"children\":\"保留盈餘\"}]]}]]}]]}]}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、資產負債表：檢查公司的財務體質\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"資產負債表就像在某個時間點幫公司拍的 X 光片，顯示它「當下」有多少資產、欠了多少債（負債）、以及股東真正擁有的部分（權益）。最重要的公式是「資產 = 負債 + 股東權益」。你可以把它想像成買房子，房子總價是資產，房貸是負債，你付的頭期款就是股東權益。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"快速判斷法：看「負債佔資產比率」。這個數字如果長期低於 60%，通常代表公司財務狀況比較穩健，不容易因為還不出錢而倒閉。但金融、營建等特定產業的負債比會比較高，需要跟同業比較才有意義。\"}],[\"$\",\"li\",\"1\",{\"children\":\"常見錯誤：只看資產很多就覺得是好公司。如果資產大多是靠借錢買來的，那風險其實很高。重點是資產的品質，以及負債是否在可控範圍內。\"}]]}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[\"$L18\",[\"$L19\",\"$L1a\",\"$L1b\"]]}],\"$L1c\",\"$L1d\",\"$L1e\",\"$L1f\",\"$L20\"],null]}]]}]}]\n18:[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、綜合損益表：判斷公司有沒有賺錢\"}]\n19:[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"損益表是看公司在「一段時間內」（通常是一季或一年）的經營成果，簡單說就是賺了多少錢、花了多少錢、最後剩下多少錢。它從營業收入開始，一層層減去成本和費用，最後算出淨利。這是最多人看的報表，因為它直接關係到每股盈餘（EPS）。\"}]\n1a:[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"快速判斷法：看「營業利益率」。公式是「營業利益 / 營業收入」。這個數字代表公司靠「本業」賺錢的能力。如果一家公司的營業利益率能長期維持穩定或持續上升，代表它的產品或服務很有競爭力。\"}],[\"$\",\"li\",\"1\",{\"children\":\"舉個例子：一家公司營收 1000 萬，但各種成本費用花了 950 萬，營業利益只有 50 萬，那營業利益率就是 5%。如果另一家同業公司營收一樣，營業利益卻有 150 萬，那它的獲利能力就更強。\"}]]}]\n1b:[\"$\",\"figure\",\"2\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"!只看EPS，忽略現金流!不看附註，魔鬼藏在細節裡!不跟同業比較，標準因產業而異!把單季好壞當作長期趨勢\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"新手讀財報常見誤區\"}]]}]\n1c:[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、現金流量表：公司活下去的關鍵命脈\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"損益表上的獲利，有時候只是「應收帳款」，錢還沒真的進來。現金流量表則記錄了「真金白銀」的流動狀況，是判斷公司會不會突然倒閉的關鍵。它分成三部分：營業、投資、融資活動的現金流。對股東來說，最重要的是營業現金流。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"快速判斷法：確認「來自營業活動的現金流量」是不是正數。一家長期經營的公司，營業現金流必須是正的，代表靠本業就能賺到現金。如果這個數字長期是負的，就算損益表上看起來在賺錢，也要非常小心，可能代表公司有很多帳款收不回來。\"}],[\"$\",\"li\",\"1\",{\"children\":\"一個門檻：健康的狀況是，營業現金流長期下來要大於或接近損益表上的「稅後淨利」。這代表公司賺到的利潤，都有變成實際的現金放入口袋。\"}]]}]]]}]\n1d:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、如何整合運用？三張表一起看才完整\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"單獨看一張報表容易有盲點。例如，一家公司可能損益表很漂亮，獲利年年成長，但現金流量表卻顯示營業現金流持續流出，同時資產負債表上的負債比例越來越高。這就是一個危險信號，可能代表公司為了創造營收而放寬收款條件，或是靠不斷借錢來維持營運。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"檢查順序建議：先看損益表，確定公司有獲利能力。再看現金流量表，確認獲利有轉換成現金。最後看資產負債表，確保公司財務結構穩健，沒有過度舉債。這樣三步驟下來，就能對一家公司有基本的了解。\"}],[\"$\",\"li\",\"1\",{\"children\":\"站內工具應用：在「股市大佬」的個股透視頁面，我們已經將重要的財報數據圖表化，你可以輕易看到長期的趨勢變化，不用自己辛苦翻閱原始財報。\"}]]}]]]}]\n1e:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"財報多久會公布一次？要去哪裡看？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"台灣上市櫃公司每季都需要公布財報（季報），每年還會有一份最完整的年報。最官方的查詢管道是「公開資訊觀測站」，券商軟體和財經網站也會整理好這些資料。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"我是新手，應該先從哪張報表開始看？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"建議從「綜合損益表」開始，先確定這家公司是不是一門賺錢的生意。如果連年虧損，除非你有很強的理由看好它轉虧為盈，否則就可以先跳過。接著再看資產負債表與現金流量表，確認體質。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"負債比高就一定是壞公司嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"不一定。像是銀行、保險、租賃等金融業，或是需要大量舉債蓋房子的營建業，它們的負債比天生就比較高。重點是跟「同產業」的公司比較，只要不偏離同業平均太多，且現金流穩定，就不用過度擔心。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"為什麼有些公司明明虧錢（EPS是負的），股價還會漲？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"股價反映的是市場對「未來」的預期。有時候公司雖然現在虧錢，但市場可能看好它的新技術、新產品或產業前景，預期它未來能賺大錢，所以願意提前給予較高的評價。這時財報只能當作基本體質的參考，還需要評估其他面向。\"}]]}]]}]]]}]\n1f:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"看財報不是要你變成會計專家，而是要學會當個偵探。從損益表看賺錢實力、資產負債表看體質穩不穩、現金流量表看口袋深不深，三張表交叉比對，就能幫你避開大部分有問題的公司。\"}]]]}]\n20:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L17\",\"0-個股財報數據圖表\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"個股財報數據圖表化查詢\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L17\",\"0-更多財報名詞解釋\",{\"href\":\"/school\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"更多財報名詞解釋\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L17\",\"0-如何評估公司價值\",{\"href\":\"/s/2330\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"如何評估公司價值？本益比教學\"}]]}]]}]]]}]\n13:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\nf:null\n21:I[80622,[],\"IconMark\"]\n11:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"財報怎麼看？四大報表入門教學，散戶也能看懂公司體質｜股市大佬 TradeBoss\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"打開財報，看到密密麻麻的資產、負債、現金流，是不是覺得頭昏眼花，想直接關掉？其實你不用成為會計師，這篇文章會教你抓住四大報表的幾個關鍵數字，三分鐘就能判斷公司體質是強壯還是虛胖。\"}],[\"$\",\"link\",\"2\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}],[\"$\",\"$L21\",\"3\",{}]],\"error\":null,\"digest\":\"$undefined\"}\n16:\"$11:metadata\"\n"}