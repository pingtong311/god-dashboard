:\"\"}]],[\"$\",\"$L14\",null,{\"children\":[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$15\",null,{\"fallback\":null,\"children\":\"$L16\"}]}]}]]}]\n17:I[52619,[\"2619\",\"static/chunks/2619-04bc32f026a0d946.js\",\"6309\",\"static/chunks/app/learn/%5Bslug%5D/page-f7b99344f7e2ee16.js\"],\"\"]\nd:[\"$\",\"div\",null,{\"className\":\"LearnArticle_wrap__LIQ8G\",\"children\":[\"$\",\"article\",null,{\"className\":\"LearnArticle_article__2nBbk\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_meta__etj_G\",\"children\":[[\"$\",\"$L17\",null,{\"className\":\"LearnArticle_cat__GQMlg\",\"href\":\"/learn?c=strategy\",\"children\":\"策略解析\"}],[\"$\",\"span\",null,{\"className\":\"LearnArticle_read__QEj6a\",\"children\":\"閱讀約 8 分鐘\"}]]}],[\"$\",\"h1\",null,{\"className\":\"LearnArticle_title__0_la8\",\"children\":\"夏普比率怎麼看？定義、限制與常見誤解\"}],[\"$\",\"details\",null,{\"className\":\"LearnArticle_toc__LcSAa\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"LearnArticle_tocSummary__YBddG\",\"children\":\"本文目錄\"}],[\"$\",\"ol\",null,{\"className\":\"LearnArticle_tocList__Rq_Lz\",\"children\":[[\"$\",\"li\",\"sec-1\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-1\",\"children\":\"一、什麼是夏普比率？不只看報酬，更看承擔了多少風險\"}]}],[\"$\",\"li\",\"sec-2\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-2\",\"children\":\"二、夏普比率的計算公式：報酬、無風險利率與標準差\"}]}],[\"$\",\"li\",\"sec-3\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-3\",\"children\":\"夏普比率公式：(投資組合報酬率 - 無風險利率) / 投資組合標準差\"}]}],[\"$\",\"li\",\"sec-4\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-4\",\"children\":\"三、夏普比率怎麼解讀？數字高低代表什麼意義？\"}]}],[\"$\",\"li\",\"sec-5\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-5\",\"children\":\"四、常見誤解一：夏普比率越高，就代表一定會賺錢？\"}]}],[\"$\",\"li\",\"sec-6\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-6\",\"children\":\"五、常見誤解二：只看單一數字，忽略時間區間與比較基準\"}]}],[\"$\",\"li\",\"sec-7\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-7\",\"children\":\"六、常見誤解三：夏普比率適用所有投資工具嗎？\"}]}],[\"$\",\"li\",\"sec-8\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-8\",\"children\":\"常見問題 FAQ\"}]}],[\"$\",\"li\",\"sec-9\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-9\",\"children\":\"總結\"}]}],[\"$\",\"li\",\"sec-10\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-10\",\"children\":\"延伸閱讀\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"LearnArticle_body__6B7Mb\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_intro__ATV5c\",\"children\":\"你在研究投資標的時，是不是也常看到「夏普比率」這個數字，卻不確定它對你的決策有什麼實質幫助？單純看到數字高就覺得好，但又說不出好在哪裡？這篇文章將帶你從散戶的角度，一步步拆解夏普比率的意義，讓你不再只看報酬率，更能看懂背後的風險承擔效率。\"}],[[\"$\",\"figure\",\"figure-0\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"虧 3 次每次 −1%賺 2 次每次 +1%勝率 40% 也可能是正期望，前提是賺的比虧的大、且扣得起成本短線先扣約 0.24% 當沖成本，再看還剩多少\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"示意圖｜期望值：勝率要配上平均賺賠，再扣成本（教學結構，不是某檔實盤）\"}]]}]],[\"$\",\"div\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"夏普比率衡量每承擔一單位風險能獲得多少超額報酬。\"}],[\"$\",\"li\",\"1\",{\"children\":\"高夏普比率不等於保證獲利，它僅反映歷史績效。\"}],[\"$\",\"li\",\"2\",{\"children\":\"比較夏普比率需在相同時間區間與基準下才有意義。\"}],[\"$\",\"li\",\"3\",{\"children\":\"理解夏普比率能幫助你評估投資組合的效率。\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、什麼是夏普比率？不只看報酬，更看承擔了多少風險\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"許多散戶投資人看盤時，最直覺的反應就是關注報酬率，例如「這檔股票漲了多少」或「我的基金賺了多少」。然而，單純的報酬率數字，往往忽略了一個關鍵因素：你為了這些報酬，究竟承擔了多大的風險？夏普比率（Sharpe Ratio）就是為了解決這個問題而生，它提供了一個衡量「風險調整後報酬」的指標，幫助你更全面地評估一項投資的效率。\"}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、夏普比率的計算公式：報酬、無風險利率與標準差\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"理解夏普比率的計算方式，能幫助你更深入地掌握它的意義。夏普比率的公式考慮了投資的「總報酬」、市場上「無風險」的報酬，以及投資本身的「風險波動程度」。簡單來說，它想知道你的投資，每承擔一單位的風險，能比無風險投資多賺多少錢。無風險利率通常會參考短期國庫券利率，而風險波動則以標準差來衡量，標準差越大代表波動越大、風險越高。\"}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"夏普比率公式：(投資組合報酬率 - 無風險利率) / 投資組合標準差\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"舉例來說，假設你的投資組合年報酬率是 15%，而當時的無風險利率是 2%。你的投資組合年化標準差（衡量波動風險）是 10%。那麼，夏普比率的計算就會是：(15% - 2%) / 10% = 1.3。這個 1.3 就代表，你的投資組合每承擔一單位的風險，就能獲得 1.3 單位的超額報酬。這是一個很重要的概念，因為它告訴你，高報酬不一定代表高效率，如果報酬是靠承擔極高風險換來的，夏普比率可能反而不高。\"}]]]}],[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、夏普比率怎麼解讀？數字高低代表什麼意義？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"當你看到一個夏普比率的數字時，該如何判斷它代表的意義呢？一般來說，夏普比率越高，代表該投資組合在承擔相同風險的情況下，能產生更高的超額報酬；或者在產生相同超額報酬的情況下，承擔了較低的風險。換句話說，高夏普比率的投資，被認為是「效率」更好的投資。但請注意，這個數字本身並非絕對，而是相對比較才有意義。\"}],\"$L18\",\"$L19\"]]}],\"$L1a\",\"$L1b\",\"$L1c\",\"$L1d\",\"$L1e\",\"$L1f\"],null]}]]}]}]\n18:[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"夏普比率 > 1：表示風險調整後報酬良好。\"}],[\"$\",\"li\",\"1\",{\"children\":\"夏普比率 > 2：表示風險調整後報酬非常優異。\"}],[\"$\",\"li\",\"2\",{\"children\":\"夏普比率 < 1：表示風險調整後報酬可能不佳，或者承擔了過多的風險。\"}],[\"$\",\"li\",\"3\",{\"children\":\"夏普比率為負值：表示投資組合的報酬甚至低於無風險利率，效率極差。\"}]]}]\n19:[\"$\",\"figure\",\"2\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"✓數字越高越好✓需考慮時間區間✓與同類標的比較✓僅為歷史參考\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"解讀夏普比率的關鍵\"}]]}]\n1a:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、常見誤解一：夏普比率越高，就代表一定會賺錢？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"這是許多散戶最容易犯的錯誤之一。夏普比率是一個「歷史」指標，它反映的是過去一段時間的績效表現，並不能保證未來的報酬。一個過去夏普比率很高的投資，在未來仍然可能表現不佳，甚至出現虧損。市場環境、經濟情勢、公司基本面等因素不斷變化，歷史數據只能作為參考，不能視為未來的預測。因此，別把高夏普比率當作「穩賺」的保證，它只是告訴你過去的「效率」如何。\"}]]]}]\n1b:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、常見誤解二：只看單一數字，忽略時間區間與比較基準\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"夏普比率的解讀必須放在特定的「時間區間」和「比較基準」下才有意義。例如，比較一檔股票過去三個月的夏普比率和另一檔股票過去三年的夏普比率，兩者是沒有可比性的。此外，你應該將投資組合的夏普比率與同類型、同市場的投資標的或大盤指數進行比較，才能判斷其相對優劣。例如，比較台股科技基金與台股傳產基金的夏普比率，應各自與其所屬的產業指數或大盤指數進行比較，而不是直接比較兩者數值。如以下比較表所示，即使報酬率相同，風險不同也會導致夏普比率差異。\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"項目\"}],[\"$\",\"th\",\"1\",{\"children\":\"投資組合 A\"}],[\"$\",\"th\",\"2\",{\"children\":\"投資組合 B\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"年化報酬率\"}],[\"$\",\"td\",\"1\",{\"children\":\"10%\"}],[\"$\",\"td\",\"2\",{\"children\":\"10%\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"無風險利率\"}],[\"$\",\"td\",\"1\",{\"children\":\"2%\"}],[\"$\",\"td\",\"2\",{\"children\":\"2%\"}]]}],[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"年化標準差 (風險)\"}],[\"$\",\"td\",\"1\",{\"children\":\"5%\"}],[\"$\",\"td\",\"2\",{\"children\":\"15%\"}]]}],[\"$\",\"tr\",\"3\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"夏普比率\"}],[\"$\",\"td\",\"1\",{\"children\":\"(10%-2%)/5% = 1.6\"}],[\"$\",\"td\",\"2\",{\"children\":\"(10%-2%)/15% = 0.53\"}]]}]]}]]}]}]]]}]\n1c:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"六、常見誤解三：夏普比率適用所有投資工具嗎？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"夏普比率雖然廣泛應用，但它並非萬能。它的計算假設報酬率符合常態分佈，且標準差能有效衡量風險。然而，對於一些報酬分佈呈現「肥尾」（極端事件頻繁）或「偏斜」（報酬不對稱）的投資工具，例如選擇權、期貨等衍生性商品，或者流動性較差的非公開市場投資，標準差可能無法完全捕捉其真實風險。在這些情況下，夏普比率的參考價值會降低，需要搭配其他風險指標來綜合評估。請務必留意，所有指標都有其適用範圍與限制，以交易所或主管機關最新公告為準（查證月份：2026-08）。\"}]]]}]\n1d:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"夏普比率多少才算好？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"夏普比率沒有絕對的好壞標準，通常需要與同類型的投資標的或大盤指數進行比較。一般而言，夏普比率大於 1 被認為表現不錯，大於 2 則非常優秀，但這仍需考量市場環境與時間區間。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"為什麼夏普比率要減去無風險利率？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"減去無風險利率是為了衡量投資組合所獲得的「超額報酬」。這表示你的投資比放在銀行定存或購買短期國庫券等幾乎無風險的資產，多賺了多少錢，才能真正評估承擔風險的價值。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"夏普比率是負值代表什麼？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"夏普比率為負值，表示你的投資組合報酬率甚至低於無風險利率，或者報酬為負。這代表你承擔了風險，卻沒有獲得應有的報酬，甚至還虧損，效率非常差。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"夏普比率可以比較不同資產類別嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"雖然夏普比率可以應用於不同資產，但直接比較不同資產類別（例如股票和債券）的夏普比率時應謹慎。因為不同資產的風險特性、報酬分佈和流動性差異很大，可能導致比較結果失真，建議在同類資產中進行比較。\"}]]}]]}]]]}]\n1e:[\"$\",\"section\",\"sec-9\",{\"id\":\"sec-9\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"夏普比率是一個衡量風險調整後報酬的重要指標，它能幫助你評估投資組合的效率。理解它的計算公式與解讀方式，並避開常見的誤解，你就能更客觀地判斷一項投資是否值得你承擔風險，而不是只看單純的報酬數字。\"}]]]}]\n1f:[\"$\",\"section\",\"sec-10\",{\"id\":\"sec-10\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L17\",\"0-更多台股籌碼教學\",{\"href\":\"/school\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"更多台股籌碼教學，請看台股學堂\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L17\",\"0-了解更多常見技術\",{\"href\":\"/learn\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"了解更多常見技術指標，前往教學專欄\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L17\",\"0-探索股市大佬更多\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"探索股市大佬更多功能，幫助你解讀數據\"}]]}]]}]]]}]\n13:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\nf:null\n20:I[80622,[],\"IconMark\"]\n11:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"夏普比率怎麼看？定義、限制與常見誤解｜股市大佬 TradeBoss\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"你在研究投資標的時，是不是也常看到「夏普比率」這個數字，卻不確定它對你的決策有什麼實質幫助？單純看到數字高就覺得好，但又說不出好在哪裡？這篇文章將帶你從散戶的角度，一步步拆解夏普比率的意義，讓你不再只看報酬率，更能看懂背後的風險承擔效率。\"}],[\"$\",\"link\",\"2\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}],[\"$\",\"$L20\",\"3\",{}]],\"error\":null,\"digest\":\"$undefined\"}\n16:\"$11:metadata\"\n"}