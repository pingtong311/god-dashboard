":[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$16\",null,{\"fallback\":null,\"children\":\"$L17\"}]}]}]]}]\n18:I[52619,[\"2619\",\"static/chunks/2619-04bc32f026a0d946.js\",\"6309\",\"static/chunks/app/learn/%5Bslug%5D/page-f7b99344f7e2ee16.js\"],\"\"]\ne:[\"$\",\"div\",null,{\"className\":\"LearnArticle_wrap__LIQ8G\",\"children\":[\"$\",\"article\",null,{\"className\":\"LearnArticle_article__2nBbk\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_meta__etj_G\",\"children\":[[\"$\",\"$L18\",null,{\"className\":\"LearnArticle_cat__GQMlg\",\"href\":\"/learn?c=chips\",\"children\":\"籌碼面\"}],[\"$\",\"span\",null,{\"className\":\"LearnArticle_read__QEj6a\",\"children\":\"閱讀約 6 分鐘\"}]]}],[\"$\",\"h1\",null,{\"className\":\"LearnArticle_title__0_la8\",\"children\":\"三大法人買賣超怎麼看？3個看盤重點，搞懂外資投信在想什麼\"}],[\"$\",\"details\",null,{\"className\":\"LearnArticle_toc__LcSAa\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"LearnArticle_tocSummary__YBddG\",\"children\":\"本文目錄\"}],[\"$\",\"ol\",null,{\"className\":\"LearnArticle_tocList__Rq_Lz\",\"children\":[[\"$\",\"li\",\"sec-1\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-1\",\"children\":\"誰是「三大法人」？為什麼大家都在看他們？\"}]}],[\"$\",\"li\",\"sec-2\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-2\",\"children\":\"「買超」和「賣超」數字，到底代表什麼？\"}]}],[\"$\",\"li\",\"sec-3\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-3\",\"children\":\"外資、投信、自營商，我該優先看誰的臉色？\"}]}],[\"$\",\"li\",\"sec-4\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-4\",\"children\":\"怎麼判斷法人的買賣超是「玩真的」還是「煙霧彈」？\"}]}],[\"$\",\"li\",\"sec-5\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-5\",\"children\":\"除了總金額，還有哪些法人數據能幫我判斷？\"}]}],[\"$\",\"li\",\"sec-6\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-6\",\"children\":\"常見問題 FAQ\"}]}],[\"$\",\"li\",\"sec-7\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-7\",\"children\":\"總結\"}]}],[\"$\",\"li\",\"sec-8\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-8\",\"children\":\"延伸閱讀\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"LearnArticle_body__6B7Mb\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_intro__ATV5c\",\"children\":\"每天看新聞都在報「外資大買XXX億」，但打開看盤軟體，看到三大法人買賣超的數字，還是不知道這對我的股票有什麼影響？這篇文章會教你，如何從這些數字中，找出真正有參考價值的訊號，而不是跟著新聞亂追高殺低。\"}],[[\"$\",\"figure\",\"figure-0\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"高集中度只說明買超很集中，不說明是誰、要幹嘛前 15 大其餘成交例：集中度 40%＝這批分點淨買超約當天成交的四成不能從集中度推出明天方向\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"示意圖｜分點集中度：前幾大買超合計，佔當天成交的比例（教學結構，不是某檔實盤）\"}]]}]],[\"$\",\"div\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"觀察三大法人動向，重點在於「連續性」與「一致性」\"}],[\"$\",\"li\",\"1\",{\"children\":\"當外資和投信連續多日站在同一方向，對股價的影響力最大\"}],[\"$\",\"li\",\"2\",{\"children\":\"別只看一天的數字，要看一段時間的趨勢，才能提高判斷的準確度\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"誰是「三大法人」？為什麼大家都在看他們？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"「三大法人」指的是外資、投信、自營商這三種機構投資人。他們因為資金雄厚、有專業研究團隊，對市場的影響力遠大於一般散戶，所以他們的買賣動向，就成了市場上重要的風向球。搞懂他們，就像開車時多了一組儀表板，能讓你更清楚前方的路況。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"外資：海外來的資金，錢最多、最能影響台積電這類大型權值股，動向通常看比較長遠。\"}],[\"$\",\"li\",\"1\",{\"children\":\"投信：就是我們買的國內基金，由基金經理人操盤，他們有季底、年底的績效壓力，操作比較看中期。\"}],[\"$\",\"li\",\"2\",{\"children\":\"自營商：券商自己的投資部門，操作週期最短，常常今天買、過幾天就賣，主要做短線價差。\"}]]}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"「買超」和「賣超」數字，到底代表什麼？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"「買超」或「賣超」是一個淨額的概念，很簡單。買超，就是今天買進的總金額，大於賣出的總金額；反之，就是賣超。例如，假設外資今天對某檔股票買了 5 億元，同時也賣了 3 億元，那今天的數字就是「買超 2 億元」。這代表今天有 2 億的「淨流入」資金停在這檔股票裡，是一股推升股價的力量。\"}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"外資、投信、自營商，我該優先看誰的臉色？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"這三種法人，因為資金性質和目標不同，操作風格也差很多。對一般散戶來說，最具參考價值的是「外資」和「投信」，特別是當他們兩個聯手、站在同一邊的時候。自營商因為操作太短，容易多空變換，比較難以跟隨。下面的表格，讓你一眼看懂他們的差別。\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"法人別\"}],[\"$\",\"th\",\"1\",{\"children\":\"資金規模\"}],[\"$\",\"th\",\"2\",{\"children\":\"操作週期\"}],[\"$\",\"th\",\"3\",{\"children\":\"參考重點\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"外資\"}],[\"$\",\"td\",\"1\",{\"children\":\"最大\"}],[\"$\",\"td\",\"2\",{\"children\":\"長期 (數月至數年)\"}],[\"$\",\"td\",\"3\",{\"children\":\"觀察買賣是否連續，對大型權值股影響力最大。\"}]]}],\"$L19\",\"$L1a\"]}]]}]}],\"$L1b\"]]}],\"$L1c\",\"$L1d\",\"$L1e\",\"$L1f\",\"$L20\"],null]}]]}]}]\n19:[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"投信\"}],[\"$\",\"td\",\"1\",{\"children\":\"次之\"}],[\"$\",\"td\",\"2\",{\"children\":\"中期 (數週至數季)\"}],[\"$\",\"td\",\"3\",{\"children\":\"關注季底、年底作帳行情，對中小型股影響力大。\"}]]}]\n1a:[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"自營商\"}],[\"$\",\"td\",\"1\",{\"children\":\"最小\"}],[\"$\",\"td\",\"2\",{\"children\":\"短期 (數日至數週)\"}],[\"$\",\"td\",\"3\",{\"children\":\"多為避險或短線交易，對散戶的參考價值相對較低。\"}]]}]\n1b:[\"$\",\"figure\",\"2\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"!看到大買就無腦追!只看外資忽略投信!沒搭配基本面判斷\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"散戶常見的 3 個誤區\"}]]}]\n1c:[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"怎麼判斷法人的買賣超是「玩真的」還是「煙霧彈」？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"看到法人單日大買就衝進去，是散戶最常犯的錯誤之一。高手的看法是，單日的數字可能只是偶然，真正有意義的是「連續性」。連續好幾天持續買超，哪怕每天金額不大，都比一天買超、隔天就倒貨的法人訊號來得可靠。這代表他們是鐵了心要佈局這檔股票。\"}],[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"判斷方法一：看連續性。連續買超或賣超 3-5 天以上，代表趨勢可能正在形成。\"}],[\"$\",\"li\",\"1\",{\"children\":\"判斷方法二：看累計量。把時間拉長到一週（5日）或一個月（20日），看累計買賣超更有參考價值。\"}],[\"$\",\"li\",\"2\",{\"children\":\"判斷方法三：看成交佔比。如果法人當天的買超張數，佔了總成交量的 15% 以上，代表他們是當天的主導者。\"}]]}]]]}]\n1d:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"除了總金額，還有哪些法人數據能幫我判斷？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"只看三大法人買賣超的總額，其實有點籠統。如果你想更深入，可以利用工具去追蹤「是誰在買」。例如，股市大佬的個股透視頁面，就能讓你看到更細的數據。同樣是外資買超，是從穩定長期佈局的「美林」買的，還是從隔日沖聞名的「凱基-台北」買的，背後的意義完全不同。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"個股買賣超排行：快速找出法人今天集中火力攻擊哪些股票。\"}],[\"$\",\"li\",\"1\",{\"children\":\"分點進出明細：可以追蹤是哪家券商分公司在買賣，幫助你分辨是真外資還是短線主力。\"}],[\"$\",\"li\",\"2\",{\"children\":\"歷史回測數據：觀察特定法人或分點過去的操作績效，了解他們的操作習慣。\"}]]}]]]}]\n1e:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"外資買超，股價就一定會漲嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"不一定。外資買超代表看好，但股價還受大盤、公司消息、其他賣壓等因素影響。連續買超比單日買超更值得參考，但仍非上漲保證。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"什麼是「假外資」？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"指的是一些本國資金，繞到海外註冊再匯回台灣，透過外資券商下單，企圖影響籌碼面。可以從券商分點來觀察，如果買盤集中在特定幾家不活躍的外資券商，就要多加留意。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"投信季底或年底的「作帳行情」是什麼？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"為了讓基金淨值（績效）好看，基金經理人會在季末或年末拉抬自己重倉持有的股票。這可能帶來短期漲幅，但也要小心他們「結帳」後的賣壓。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"三大法人合計買超，但股價卻下跌，是為什麼？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"這表示雖然法人在買，但有更大的賣壓來自散戶或其他主力，賣方的力量蓋過了法人的買盤。這時需要觀察賣壓是否持續，或者法人是否繼續承接。\"}]]}]]}]]]}]\n1f:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"觀察三大法人動向，重點在於「連續性」與「一致性」。當外資和投信連續多日站在同一方向，對股價的影響力最大。別只看一天的數字，要看一段時間的趨勢，才能提高判斷的準確度。\"}]]]}]\n20:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L18\",\"0-想知道今天誰是法\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"想知道今天誰是法人最愛？來看今日戰情\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L18\",\"0-更進階的籌碼教學\",{\"href\":\"/school\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"更進階的籌碼教學，都在台股學堂\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L18\",\"0-查詢個股詳細的三\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"查詢個股詳細的三大法人數據\"}]]}]]}]]]}]\n14:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\n10:null\n21:I[80622,[],\"IconMark\"]\n12:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"三大法人買賣超怎麼看？3個看盤重點，搞懂外資投信在想什麼｜股市大佬 TradeBoss\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"每天看新聞都在報「外資大買XXX億」，但打開看盤軟體，看到三大法人買賣超的數字，還是不知道這對我的股票有什麼影響？這篇文章會教你，如何從這些數字中，找出真正有參考價值的訊號，而不是跟著新聞亂追高殺低。\"}],[\"$\",\"link\",\"2\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}],[\"$\",\"$L21\",\"3\",{}]],\"error\":null,\"digest\":\"$undefined\"}\n17:\"$12:metadata\"\n"}