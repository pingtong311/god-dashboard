,null,{\"children\":[\"$Lf\",[\"$\",\"$L10\",null,{\"promise\":\"$@11\"}]]}]]}]\nb:[\"$\",\"$1\",\"h\",{\"children\":[null,[[\"$\",\"$L12\",null,{\"children\":\"$L13\"}],[\"$\",\"meta\",null,{\"name\":\"next-size-adjust\",\"content\":\"\"}]],[\"$\",\"$L14\",null,{\"children\":[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$15\",null,{\"fallback\":null,\"children\":\"$L16\"}]}]}]]}]\n17:I[52619,[\"2619\",\"static/chunks/2619-04bc32f026a0d946.js\",\"6309\",\"static/chunks/app/learn/%5Bslug%5D/page-f7b99344f7e2ee16.js\"],\"\"]\nd:[\"$\",\"div\",null,{\"className\":\"LearnArticle_wrap__LIQ8G\",\"children\":[\"$\",\"article\",null,{\"className\":\"LearnArticle_article__2nBbk\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_meta__etj_G\",\"children\":[[\"$\",\"$L17\",null,{\"className\":\"LearnArticle_cat__GQMlg\",\"href\":\"/learn?c=trends\",\"children\":\"產業與趨勢\"}],[\"$\",\"span\",null,{\"className\":\"LearnArticle_read__QEj6a\",\"children\":\"閱讀約 5 分鐘\"}]]}],[\"$\",\"h1\",null,{\"className\":\"LearnArticle_title__0_la8\",\"children\":\"AI伺服器供應鏈怎麼看？先拆4個環節，再聽題材\"}],[\"$\",\"details\",null,{\"className\":\"LearnArticle_toc__LcSAa\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"LearnArticle_tocSummary__YBddG\",\"children\":\"本文目錄\"}],[\"$\",\"ol\",null,{\"className\":\"LearnArticle_tocList__Rq_Lz\",\"children\":[[\"$\",\"li\",\"sec-1\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-1\",\"children\":\"一、四個環節，不要焊成一個名詞\"}]}],[\"$\",\"li\",\"sec-2\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-2\",\"children\":\"二、題材熱的時候，邊緣會被講成核心\"}]}],[\"$\",\"li\",\"sec-3\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-3\",\"children\":\"三、資料中心需求怎麼傳到台股\"}]}],[\"$\",\"li\",\"sec-4\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-4\",\"children\":\"四、和一般伺服器差在哪\"}]}],[\"$\",\"li\",\"sec-5\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-5\",\"children\":\"五、讀這類新聞時的最小流程\"}]}],[\"$\",\"li\",\"sec-6\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-6\",\"children\":\"常見問題 FAQ\"}]}],[\"$\",\"li\",\"sec-7\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-7\",\"children\":\"總結\"}]}],[\"$\",\"li\",\"sec-8\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-8\",\"children\":\"延伸閱讀\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"LearnArticle_body__6B7Mb\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_intro__ATV5c\",\"children\":\"AI 變成標題之後，很多公司都被放進同一句「AI 概念」。對想做功課的人，比較有用的是先問：這家碰的是運算本身、把機器組起來、讓它供得了電與散得了熱，還是資料中心蓋好之後的營運。四段的訂單節奏與競爭方式不同。題材可以把它們焊成同一個未來，財報不會。\"}],[[\"$\",\"figure\",\"figure-0\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"越後面越熱鬧，通常也越貴、越好離開佈局沒新聞命名故事出現擁擠人人都知退燒利多變鈍新聞出現時，常常已經不是第一段\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"示意圖｜題材四階段：佈局 → 命名 → 擁擠 → 退燒（教學結構，不是某檔實盤）\"}]]}]],[\"$\",\"div\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"先拆晶片、組裝、電源散熱、資料中心，再聽 AI 兩個字\"}],[\"$\",\"li\",\"1\",{\"children\":\"題材熱時，邊緣環節也會被講成核心，要先問它賺的是哪一段\"}],[\"$\",\"li\",\"2\",{\"children\":\"長期需求敘述可以對，中間仍可能有庫存與產能錯位\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、四個環節，不要焊成一個名詞\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"運算核心通常是高階加速晶片與相關設計。往外是基板、組裝與代工把機器做成可以出貨的伺服器。再往外是電源、散熱、機殼與連接，機器愈密集，這段愈被提到。最外面是資料中心的土地、電力與營運。台股討論常從中間兩段開始，因為組裝與零組件公司比較多。這不是誰比較重要，是你要先承認自己看的是哪一段。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"運算：晶片與設計\"}],[\"$\",\"li\",\"1\",{\"children\":\"整機：基板、組裝、代工\"}],[\"$\",\"li\",\"2\",{\"children\":\"配套：電源、散熱、連接\"}],[\"$\",\"li\",\"3\",{\"children\":\"場域：電力、機櫃、營運\"}]]}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、題材熱的時候，邊緣會被講成核心\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"一句「都在做 AI」傳播成本最低，所以連只做其中一顆螺絲概念的公司，敘述也會被拉到最核心。檢查方法很土：它的營收有沒有真的跟這段需求連動，還是只是同一群人在同一個時間講同一句話。連動要看訂單與客戶，不看聊天室熱度。熱度可以當背景，不能當財報。\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"你聽到的\"}],[\"$\",\"th\",\"1\",{\"children\":\"先問\"}],[\"$\",\"th\",\"2\",{\"children\":\"比較穩的態度\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"都是 AI 概念\"}],[\"$\",\"td\",\"1\",{\"children\":\"營收跟哪一段連動\"}],[\"$\",\"td\",\"2\",{\"children\":\"先標環節再聽故事\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"缺料所以會一直好\"}],[\"$\",\"td\",\"1\",{\"children\":\"缺的是哪一種料、會不會變成過剩\"}],[\"$\",\"td\",\"2\",{\"children\":\"缺料敘述有時間限制\"}]]}],[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"資料中心一定蓋\"}],[\"$\",\"td\",\"1\",{\"children\":\"電力與資本支出有沒有跟上\"}],[\"$\",\"td\",\"2\",{\"children\":\"長期需求≠今年出貨\"}]]}],[\"$\",\"tr\",\"3\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"相關就該一起動\"}],[\"$\",\"td\",\"1\",{\"children\":\"它是核心還是邊緣\"}],[\"$\",\"td\",\"2\",{\"children\":\"邊緣被焊上來時最擠\"}]]}]]}]]}]}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、資料中心需求怎麼傳到台股\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"資料中心要擴，先碰到電力、土地與資本支出，再碰到伺服器與零組件。傳導不是當天完成。你在台股看到的，常常是中間那段被提前交易的故事。故事可以對，時點仍可能錯。把「資料中心會變多」直接翻譯成「相關公司現在都該比較貴」，中間少了產能、交期與庫存三步。這三步寫不出來，就還只是題材，不是產業功課。\"}],\"$L18\",\"$L19\"]]}],\"$L1a\",\"$L1b\",\"$L1c\",\"$L1d\",\"$L1e\"],\"$L1f\"]}]]}]}]\n18:[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"先問資本支出有沒有真的編列\"}],[\"$\",\"li\",\"1\",{\"children\":\"再問交期與產能卡在哪一段\"}],[\"$\",\"li\",\"2\",{\"children\":\"最後才問台股這家碰得到哪一截\"}]]}]\n19:[\"$\",\"figure\",\"2\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"!邊緣被講成核心!缺料被講成永遠!需求被講成今年出貨\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"題材焊在一起時\"}]]}]\n1a:[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、和一般伺服器差在哪\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"AI 伺服器通常更吃電力與散熱，也更吃高階連接與基板。這讓過去被當配角的環節，敘述權變重。但不表示舊的伺服器鏈消失，也不表示每一家做電源或散熱的公司都等比例受惠。差異要用產品規格與客戶結構看，不能用標題的兩個英文字母看。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"更吃電、更吃熱、更吃高階連接\"}],[\"$\",\"li\",\"1\",{\"children\":\"配角敘述變重，不等於家家受惠\"}],[\"$\",\"li\",\"2\",{\"children\":\"舊的伺服器需求仍是另一條線\"}]]}]]]}]\n1b:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、讀這類新聞時的最小流程\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"看到 AI 伺服器，先寫：這則消息打的是四段裡的哪一段、有沒有具體客戶或資本支出、台股被點到的公司是核心還是被焊上來的邊緣。三題答得完，你才比較不容易在擁擠句裡第一次進場。答不完，就當它是標題，不當它是功課。\"}]]]}]\n1c:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"沒有做晶片，算不算 AI 供應鏈？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"可以算某一環，但不算運算核心。先講清楚環節，再講算不算，才不會被概念焊在一起。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"資料中心蓋得多，台股一定有單嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"不一定。資本支出、交期與誰拿到訂單是三件事。需求在，不代表你看的那家在名單上。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"為什麼相關股票常常一起動？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"題材階段資金用同一個名詞交易。一起動是交易語言，不是產業證明。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"要不要等題材退了再做功課？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"功課隨時可做。下單仍要有自己的失效條件。功課熱的時候更需要，因為敘述最擁擠。\"}]]}]]}]]]}]\n1d:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"AI 伺服器至少拆四段：晶片、整機、電源散熱、資料中心。題材會把邊緣焊成核心。先問環節、資本支出與這家是不是真的連動，再聽兩個英文字母。\"}]]]}]\n1e:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L17\",\"0-半導體產業鏈\",{\"href\":\"/learn/semiconductor-supply-chain-how-it-splits\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"半導體產業鏈\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L17\",\"0-題材輪動\",{\"href\":\"/learn/what-theme-rotation-is-actually-doing\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"題材輪動\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L17\",\"0-川普與國際雷達（\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"川普與國際雷達（會員）\"}]]}]]}]]]}]\n1f:[\"$\",\"div\",null,{\"className\":\"LearnArticle_related__9qV55\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_relatedTitle__RXfrl\",\"children\":\"相關文章\"}],[[\"$\",\"$L17\",\"semiconductor-supply-chain-how-it-splits\",{\"href\":\"/learn/semiconductor-supply-chain-how-it-splits\",\"className\":\"LearnArticle_relatedLink__mibXe\",\"children\":\"半導體產業鏈\"}],[\"$\",\"$L17\",\"what-theme-rotation-is-actually-doing\",{\"href\":\"/learn/what-theme-rotation-is-actually-doing\",\"className\":\"LearnArticle_relatedLink__mibXe\",\"children\":\"題材輪動\"}]]]}]\n13:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\nf:null\n20:I[80622,[],\"IconMark\"]\n11:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"AI伺服器供應鏈怎麼看？先拆4個環節，再聽題材｜股市大佬 TradeBoss\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"AI 變成標題之後，很多公司都被放進同一句「AI 概念」。對想做功課的人，比較有用的是先問：這家碰的是運算本身、把機器組起來、讓它供得了電與散得了熱，還是資料中心蓋好之後的營運。四段的訂單節奏與競爭方式不同。題材可以把它們焊成同一個未來，財報不會。\"}],[\"$\",\"link\",\"2\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}],[\"$\",\"$L20\",\"3\",{}]],\"error\":null,\"digest\":\"$undefined\"}\n16:\"$11:metadata\"\n"}