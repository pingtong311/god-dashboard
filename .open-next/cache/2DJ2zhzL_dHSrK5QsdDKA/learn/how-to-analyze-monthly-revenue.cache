,\"li\",\"sec-5\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-5\",\"children\":\"五、除了單月營收，我還能看什麼數字來確認趨勢？\"}]}],[\"$\",\"li\",\"sec-6\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-6\",\"children\":\"常見問題 FAQ\"}]}],[\"$\",\"li\",\"sec-7\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-7\",\"children\":\"總結\"}]}],[\"$\",\"li\",\"sec-8\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-8\",\"children\":\"延伸閱讀\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"LearnArticle_body__6B7Mb\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_intro__ATV5c\",\"children\":\"每個月 10 號左右，公司公布上個月營收，數字有好有壞，看得眼花撩亂。到底營收增加是旺季效應，還是真的在成長？這篇教你用 3 個關鍵數字，看懂營收背後的真相。\"}],[[\"$\",\"figure\",\"figure-0\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"沒扣成本的勝率，看起來都會比較漂亮0.029%手續費 1 折來回0.15%當沖證交稅0.06%滑價估計三項合計約 0.24%；留倉稅率更高，約 0.39%\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"示意圖｜當沖來回成本：1 折手續費 + 證交稅 + 滑價（教學結構，不是某檔實盤）\"}]]}]],[\"$\",\"div\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"只看單月營收數字容易誤判，要跟去年同期、上個月比較。\"}],[\"$\",\"li\",\"1\",{\"children\":\"「年增率 (YoY)」比「月增率 (MoM)」更能排除季節性因素的干擾。\"}],[\"$\",\"li\",\"2\",{\"children\":\"連續三個月年增率都成長，是觀察公司營運轉強的訊號之一。\"}],[\"$\",\"li\",\"3\",{\"children\":\"觀察「累計營收年增率」能看出公司長期的成長趨勢。\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、我只看營收有沒有「創歷史新高」，這樣不對嗎？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"看到「營收創高」的新聞標題很振奮人心，但這常常是個甜蜜的陷阱。單一月份的數字很容易受短期因素影響，例如急單、提前出貨，或是產業的傳統旺季。如果只看這個數字就決定買進，很容易買在消息發布後的高點。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"常見錯誤：只看絕對金額，忽略比較的基期高低。\"}],[\"$\",\"li\",\"1\",{\"children\":\"判斷方法：一定要搭配「年增率」和「月增率」一起看。\"}],[\"$\",\"li\",\"2\",{\"children\":\"數字門檻：連續 3 個月營收創高，且年增率也同步成長，訊號才比較可靠。\"}]]}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、年增率 (YoY) 和月增率 (MoM)，哪個比較重要？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"這兩個數字都是比較出來的，但比較的對象不同，意義也差很多。「月增率 (MoM)」是跟上個月比，容易受季節、工作天數影響。「年增率 (YoY)」是跟去年同一個月比，更能看出公司是否真的比去年更好了，因此是判斷趨勢的關鍵。\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"比較項目\"}],[\"$\",\"th\",\"1\",{\"children\":\"年增率 (YoY)\"}],[\"$\",\"th\",\"2\",{\"children\":\"月增率 (MoM)\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"比較對象\"}],[\"$\",\"td\",\"1\",{\"children\":\"去年同月份\"}],[\"$\",\"td\",\"2\",{\"children\":\"上一個月份\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"優點\"}],[\"$\",\"td\",\"1\",{\"children\":\"排除季節性、節慶因素\"}],[\"$\",\"td\",\"2\",{\"children\":\"反映極短期營運變化\"}]]}],[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"缺點\"}],[\"$\",\"td\",\"1\",{\"children\":\"無法反映最新動能\"}],[\"$\",\"td\",\"2\",{\"children\":\"易受淡旺季、工作天數干擾\"}]]}],[\"$\",\"tr\",\"3\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"判讀重點\"}],[\"$\",\"td\",\"1\",{\"children\":\"判斷長期趨勢、公司成長性\"}],[\"$\",\"td\",\"2\",{\"children\":\"觀察營運是否突然轉強或轉弱\"}]]}]]}]]}]}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、年增率要看多少才算「好」？有沒有一個標準？\"}],[\"$L18\",\"$L19\",\"$L1a\"]]}],\"$L1b\",\"$L1c\",\"$L1d\",\"$L1e\",\"$L1f\"],null]}]]}]}]\n18:[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"很多人想找一個「黃金數字」，例如年增率超過 20% 就是好。但不同產業的標準天差地遠，成熟的傳產有個位數成長就不錯了，而高速成長的電子業可能需要 30% 以上才算及格。與其用單一標準，不如用比較的方式來判斷。\"}]\n19:[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"跟公司自己過去的表現比：例如一家公司過去 YoY 都在 5%，這個月突然到 15%，就是個顯著的變化。\"}],[\"$\",\"li\",\"1\",{\"children\":\"跟同產業的其他公司比：如果同業 YoY 都是負的，只有它逆勢成長，那就值得關注。\"}],[\"$\",\"li\",\"2\",{\"children\":\"一個參考門檻：連續三個月 YoY > 15%，且優於同業平均，通常代表營運動能相當強勁。\"}]]}]\n1a:[\"$\",\"figure\",\"2\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"!只看創高，不看基期!把旺季效應當成長!營收好就認為一定會漲\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"解讀營收常見三大誤區\"}]]}]\n1b:[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、為什麼有時候營收很好，股價卻反而下跌？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"這就是所謂的「利多出盡」。市場是看未來的，如果公司公布的營收數字雖然很好，但「不如市場預期的好」，或是市場早就預料到這個好消息，那麼股價可能在消息公布前就已經漲完了，反而變成一些人獲利了結的時機。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"原因一：數字低於法人預期。例如市場預估 YoY 50%，結果只開出 40%。\"}],[\"$\",\"li\",\"1\",{\"children\":\"原因二：股價已提前反應。消息公布前股價已經大漲一段，主力藉機出貨。\"}],[\"$\",\"li\",\"2\",{\"children\":\"原因三：公司展望保守。公司可能在法說會上表示，雖然本月營收好，但未來訂單能見度不高。\"}]]}]]]}]\n1c:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、除了單月營收，我還能看什麼數字來確認趨勢？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"單一個月的數字容易有雜訊，聰明的投資人會看更長期的數據來確認趨勢。「累計營收年增率」就是一個好用的指標，它把今年以來每個月的營收加總，再跟去年同期的總和相比，可以撫平單月波動，看出整體的成長軌跡。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"指標名稱：累計營收年增率 (Cumulative YoY Growth)。\"}],[\"$\",\"li\",\"1\",{\"children\":\"計算方式：(今年1月到當月總營收 - 去年1月到當月總營收) / 去年1月到當月總營收。\"}],[\"$\",\"li\",\"2\",{\"children\":\"判斷方法：如果累計營收年增率的趨勢線持續向上，代表公司整體的成長趨勢是健康的。在「股市大佬」的個股透視頁面，我們直接幫你算好並畫成圖表。\"}]]}]]]}]\n1d:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"公司最晚什麼時候要公布月營收？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"根據規定，所有上市櫃公司必須在每個月 10 號（含）以前，公布上一個月的營收數字。如果遇到假日則順延。（查證月份：2026-08）\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"為什麼有些公司的營收會突然暴增或暴跌？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"除了產業旺季或訂單變化，有時也跟一次性收入入帳（如建案完工）或子公司合併報表有關。可以去查公司的重大訊息，了解營收劇烈變動的原因。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"營收「年月雙增」就代表一定好嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"「年月雙增」（YoY 和 MoM 都正成長）是個不錯的訊號，但還是要看增長的幅度。如果 MoM 只是微幅成長，但 YoY 卻是大幅衰退，那整體趨勢可能還是向下的。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"我要去哪裡查最即時的月營收資料？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"除了證交所的公開資訊觀測站，許多看盤軟體或財經網站都有整理好的圖表。「股市大佬」的台股日報會在第一時間彙整重要公司的營收表現。\"}]]}]]}]]]}]\n1e:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"別再只看營收數字創不創新高。養成習慣，同時檢查「年增率 YoY」、「月增率 MoM」與「累計營收年增率」這三個指標，建立你的觀察標準，才能真正從營收數據中找到機會、避開風險。\"}]]]}]\n1f:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L17\",\"0-在「個股透視」頁\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"在「個股透視」頁面查看完整營收圖表\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L17\",\"0-想學習更多財報名\",{\"href\":\"/school\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"想學習更多財報名詞？來台股學堂\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L17\",\"0-每日盤後彙整，訂\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"每日盤後彙整，訂閱我們的台股日報\"}]]}]]}]]]}]\n13:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\nf:null\n20:I[80622,[],\"IconMark\"]\n11:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"月營收公布怎麼看？3個關鍵數字，避開成長假象與財報地雷｜股市大佬 TradeBoss\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"每個月 10 號左右，公司公布上個月營收，數字有好有壞，看得眼花撩亂。到底營收增加是旺季效應，還是真的在成長？這篇教你用 3 個關鍵數字，看懂營收背後的真相。\"}],[\"$\",\"link\",\"2\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}],[\"$\",\"$L20\",\"3\",{}]],\"error\":null,\"digest\":\"$undefined\"}\n16:\"$11:metadata\"\n"}