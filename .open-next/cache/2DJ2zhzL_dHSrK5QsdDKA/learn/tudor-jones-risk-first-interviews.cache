":\"LearnArticle_tocList__Rq_Lz\",\"children\":[[\"$\",\"li\",\"sec-1\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-1\",\"children\":\"一、先把剪輯放下\"}]}],[\"$\",\"li\",\"sec-2\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-2\",\"children\":\"二、三件被反覆轉述的事\"}]}],[\"$\",\"li\",\"sec-3\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-3\",\"children\":\"三、為什麼「快」比「準」常被他強調\"}]}],[\"$\",\"li\",\"sec-4\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-4\",\"children\":\"四、不要把人物讀成風格標籤\"}]}],[\"$\",\"li\",\"sec-5\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-5\",\"children\":\"五、最小動作\"}]}],[\"$\",\"li\",\"sec-6\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-6\",\"children\":\"常見問題 FAQ\"}]}],[\"$\",\"li\",\"sec-7\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-7\",\"children\":\"總結\"}]}],[\"$\",\"li\",\"sec-8\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-8\",\"children\":\"延伸閱讀\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"LearnArticle_body__6B7Mb\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_intro__ATV5c\",\"children\":\"保羅·都鐸·瓊斯在公開訪談裡給人的印象，常被剪成「抓大行情的人」。同一批訪談更穩定的句子，其實圍繞防守：先想會輸多少、錯了要快、以及不要讓單一看法決定你還能不能交易。這三件和李佛摩、海龜留下的結構很像，只是語氣不同。神準不能學，防守可以檢查。\"}],[],[\"$\",\"div\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"公開訪談裡，他先講防守再講機會\"}],[\"$\",\"li\",\"1\",{\"children\":\"錯了要快，不是因為膽小，是因為本金是門票\"}],[\"$\",\"li\",\"2\",{\"children\":\"單一看法太大，等於把職業生涯押在一次心情\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、先把剪輯放下\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"後來的傳播喜歡留「看對大波段」的畫面。訪談原文比較常停在：若這筆錯了，我還在不在。對讀者，剪輯會害你去學方向；原文比較像在教你先設天花板。天花板不是目標，是你輸得起的上限。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"傳播愛方向\"}],[\"$\",\"li\",\"1\",{\"children\":\"訪談愛防守\"}],[\"$\",\"li\",\"2\",{\"children\":\"你要學的是上限\"}]]}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、三件被反覆轉述的事\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"第一，進場前先算最壞。第二，最壞碰到就走，不在虧損裡找新理由。第三，部位小到連續錯幾次仍能按同一套規則做。這三件在海龜與風險優先那兩篇也出現過，說明不是某一個人的個性，是能留下來的人共同的順序。\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"訪談裡的順序\"}],[\"$\",\"th\",\"1\",{\"children\":\"業餘常見順序\"}],[\"$\",\"th\",\"2\",{\"children\":\"差在哪\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"先問會輸多少\"}],[\"$\",\"td\",\"1\",{\"children\":\"先問會賺多少\"}],[\"$\",\"td\",\"2\",{\"children\":\"門票還在不在\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"錯了先走\"}],[\"$\",\"td\",\"1\",{\"children\":\"錯了再研究\"}],[\"$\",\"td\",\"2\",{\"children\":\"研究應在場外\"}]]}],[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"連續錯仍做得下去\"}],[\"$\",\"td\",\"1\",{\"children\":\"錯兩次就改方法\"}],[\"$\",\"td\",\"2\",{\"children\":\"樣本被心情打斷\"}]]}],[\"$\",\"tr\",\"3\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"大行情是結果\"}],[\"$\",\"td\",\"1\",{\"children\":\"大行情是目標\"}],[\"$\",\"td\",\"2\",{\"children\":\"目標會逼你加碼\"}]]}]]}]]}]}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、為什麼「快」比「準」常被他強調\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"公開表述裡，認錯的速度被當成技術。慢的代價不是面子，是下一筆沒有足夠本金。準當然好，但準無法事先保證；快可以寫成規則。規則寫得動的，才是你能練的。\"}],[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"把最壞寫成數字\"}],[\"$\",\"li\",\"1\",{\"children\":\"碰到就走\"}],[\"$\",\"li\",\"2\",{\"children\":\"走了再檢討準不準\"}]]}],[\"$\",\"figure\",\"2\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"!去學抓轉折!把大行情當目標!忽略上限\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"剪輯會害你\"}]]}]]]}],[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[\"$L18\",[\"$L19\",\"$L1a\"]]}],\"$L1b\",\"$L1c\",\"$L1d\",\"$L1e\"],\"$L1f\"]}]]}]}]\n18:[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、不要把人物讀成風格標籤\"}]\n19:[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"有人把他標成短線、有人標成宏觀。標籤會讓你去模仿外表。訪談能用的是決策順序。順序可以放進當沖，也可以放進波段，重點是上限與認錯，不是週期名稱。\"}]\n1a:[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"週期是容器\"}],[\"$\",\"li\",\"1\",{\"children\":\"上限是內容\"}],[\"$\",\"li\",\"2\",{\"children\":\"先學內容\"}]]}]\n1b:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、最小動作\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"下一筆下單前多一行：最壞是多少、碰到誰有權叫我走。寫不出來，就還在看剪輯，不在用訪談。\"}]]]}]\n1c:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"他是不是特別能抓轉折？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"傳播這樣講。訪談裡更穩定的是防守。轉折不能當教材的主詞。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"快認錯會不會常常被洗？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"會。所以部位要小到被洗了還能繼續。大部位配快認錯，人會做不到。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"和李佛摩差在哪？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"公開材料都強調認賠。李佛摩的故事還有歸零；這篇只取訪談裡的防守順序。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"宏觀交易散戶能學嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"學順序，不學他的商品與規模。\"}]]}]]}]]]}]\n1d:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"都鐸瓊斯公開訪談裡反覆出現的是防守：先算最壞、錯了快走、部位小到能連錯。剪輯愛方向，教材愛上限。\"}]]]}]\n1e:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L17\",\"0-為什麼風險優先\",{\"href\":\"/learn/why-professional-traders-put-risk-first\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"為什麼風險優先\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L17\",\"0-金融怪傑訪談留下\",{\"href\":\"/learn/market-wizards-what-interviews-really-left\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"金融怪傑訪談留下什麼\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L17\",\"0-李佛摩的教訓\",{\"href\