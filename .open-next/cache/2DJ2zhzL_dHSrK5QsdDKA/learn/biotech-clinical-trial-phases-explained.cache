\n\"])</script><script>self.__next_f.push([1,\"17:I[52619,[\\\"2619\\\",\\\"static/chunks/2619-04bc32f026a0d946.js\\\",\\\"6309\\\",\\\"static/chunks/app/learn/%5Bslug%5D/page-f7b99344f7e2ee16.js\\\"],\\\"\\\"]\\n\"])</script><script>self.__next_f.push([1,\"d:[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"LearnArticle_wrap__LIQ8G\\\",\\\"children\\\":[\\\"$\\\",\\\"article\\\",null,{\\\"className\\\":\\\"LearnArticle_article__2nBbk\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"LearnArticle_meta__etj_G\\\",\\\"children\\\":[[\\\"$\\\",\\\"$L17\\\",null,{\\\"className\\\":\\\"LearnArticle_cat__GQMlg\\\",\\\"href\\\":\\\"/learn?c=trends\\\",\\\"children\\\":\\\"產業與趨勢\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"LearnArticle_read__QEj6a\\\",\\\"children\\\":\\\"閱讀約 7 分鐘\\\"}]]}],[\\\"$\\\",\\\"h1\\\",null,{\\\"className\\\":\\\"LearnArticle_title__0_la8\\\",\\\"children\\\":\\\"生技臨床試驗階段差在哪？解盲成功就會漲？3 個數字看懂新藥股風險\\\"}],[\\\"$\\\",\\\"details\\\",null,{\\\"className\\\":\\\"LearnArticle_toc__LcSAa\\\",\\\"children\\\":[[\\\"$\\\",\\\"summary\\\",null,{\\\"className\\\":\\\"LearnArticle_tocSummary__YBddG\\\",\\\"children\\\":\\\"本文目錄\\\"}],[\\\"$\\\",\\\"ol\\\",null,{\\\"className\\\":\\\"LearnArticle_tocList__Rq_Lz\\\",\\\"children\\\":[[\\\"$\\\",\\\"li\\\",\\\"sec-1\\\",{\\\"children\\\":[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"#sec-1\\\",\\\"children\\\":\\\"一、「臨床試驗」到底是什麼？為什麼生技股成敗都看它？\\\"}]}],[\\\"$\\\",\\\"li\\\",\\\"sec-2\\\",{\\\"children\\\":[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"#sec-2\\\",\\\"children\\\":\\\"二、一期、二期、三期，數字越大越好嗎？先從「臨床前」與「一期」看起\\\"}]}],[\\\"$\\\",\\\"li\\\",\\\"sec-3\\\",{\\\"children\\\":[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"#sec-3\\\",\\\"children\\\":\\\"三、真正決定藥物價值的「二期」與「三期」，差別在哪？\\\"}]}],[\\\"$\\\",\\\"li\\\",\\\"sec-4\\\",{\\\"children\\\":[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"#sec-4\\\",\\\"children\\\":\\\"四、新聞常說的「解盲」是什麼？為什麼成功了股價還可能跌？\\\"}]}],[\\\"$\\\",\\\"li\\\",\\\"sec-5\\\",{\\\"children\\\":[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"#sec-5\\\",\\\"children\\\":\\\"五、拿到藥證就結束了？別忘了還有「第四期」與市場挑戰\\\"}]}],[\\\"$\\\",\\\"li\\\",\\\"sec-6\\\",{\\\"children\\\":[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"#sec-6\\\",\\\"children\\\":\\\"常見問題 FAQ\\\"}]}],[\\\"$\\\",\\\"li\\\",\\\"sec-7\\\",{\\\"children\\\":[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"#sec-7\\\",\\\"children\\\":\\\"總結\\\"}]}],[\\\"$\\\",\\\"li\\\",\\\"sec-8\\\",{\\\"children\\\":[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"#sec-8\\\",\\\"children\\\":\\\"延伸閱讀\\\"}]}]]}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"LearnArticle_body__6B7Mb\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"LearnArticle_intro__ATV5c\\\",\\\"children\\\":\\\"看到生技股新聞稿寫「臨床試驗結果正向」，股價卻沒反應，甚至還下跌？這就是因為沒搞懂新藥開發不同階段的意義。這篇文章會帶你拆解臨床一、二、三期到底差在哪，讓你下次看到「解盲」新聞時，能判斷出這顆藥的真實進度與潛在風險。\\\"}],[],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"LearnArticle_tldr__Br5BY\\\",\\\"children\\\":[[\\\"$\\\",\\\"b\\\",null,{\\\"className\\\":\\\"LearnArticle_tldrTitle__K5PBN\\\",\\\"children\\\":\\\"本文重點\\\"}],[\\\"$\\\",\\\"ul\\\",null,{\\\"className\\\":\\\"LearnArticle_tldrList__VSc2_\\\",\\\"children\\\":[[\\\"$\\\",\\\"li\\\",\\\"0\\\",{\\\"children\\\":\\\"臨床一期看安全性，二期看有效性，三期看大規模驗證，風險逐期下降。\\\"}],[\\\"$\\\",\\\"li\\\",\\\"1\\\",{\\\"children\\\":\\\"「解盲」是公布試驗結果，不論成敗，都是股價劇烈波動的關鍵時刻。\\\"}],[\\\"$\\\",\\\"li\\\",\\\"2\\\",{\\\"children\\\":\\\"新藥開發期程長、燒錢多，從臨床到上市平均要 10 年以上，失敗率極高。\\\"}],[\\\"$\\\",\\\"li\\\",\\\"3\\\",{\\\"children\\\":\\\"拿到藥證不代表馬上賺錢，還要看上市後的市場銷售與健保給付狀況。\\\"}]]}]]}],[[\\\"$\\\",\\\"section\\\",\\\"sec-1\\\",{\\\"id\\\":\\\"sec-1\\\",\\\"className\\\":\\\"LearnArticle_section__hLVjU\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"LearnArticle_h2__NmJ08\\\",\\\"children\\\":\\\"一、「臨床試驗」到底是什麼？為什麼生技股成敗都看它？\\\"}],[[\\\"$\\\",\\\"p\\\",\\\"0\\\",{\\\"className\\\":\\\"LearnArticle_p__aZlQ1\\\",\\\"children\\\":\\\"當你聽到生技公司要開發一顆新藥，不能直接就拿來賣，必須先證明它「安全」又「有效」，這個證明的過程，就叫做「臨床試驗」。對於很多還沒有穩定產品營收的新藥公司來說，臨床試驗的結果幾乎就決定了公司的生死。這不像電子股看訂單、傳產股看報價，新藥股的價值完全建立在對未來的想像上，而臨床試驗就是把這個想像變成現實的唯一路徑，所以成敗的影響才會這麼巨大。\\\"}]]]}],[\\\"$\\\",\\\"section\\\",\\\"sec-2\\\",{\\\"id\\\":\\\"sec-2\\\",\\\"className\\\":\\\"LearnArticle_section__hLVjU\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"LearnArticle_h2__NmJ08\\\",\\\"children\\\":\\\"二、一期、二期、三期，數字越大越好嗎？先從「臨床前」與「一期」看起\\\"}],[[\\\"$\\\",\\\"p\\\",\\\"0\\\",{\\\"className\\\":\\\"LearnArticle_p__aZlQ1\\\",\\\"children\\\":\\\"在進入人體試驗前，藥物要先在動物身上做「臨床前試驗」，確認基本毒性。通過後才進入「第一期臨床試驗」（Phase I），這個階段的重點只有一個：安全性。受試者通常是少數健康的自願者，目的是觀察藥物在人體內有沒有無法接受的毒性或副作用，還不太關心有沒有效。所以，當你看到一期試驗通過，只要把它當成「拿到入場券」，離終點還非常遙遠。\\\"}],[\\\"$\\\",\\\"ul\\\",\\\"1\\\",{\\\"className\\\":\\\"LearnArticle_listCheck__xx1CF\\\",\\\"children\\\":[[\\\"$\\\",\\\"li\\\",\\\"0\\\",{\\\"children\\\":\\\"臨床前試驗：在動物身上測試，看初步的毒理反應。\\\"}],[\\\"$\\\",\\\"li\\\",\\\"1\\\",{\\\"children\\\":\\\"第一期（Phase I）：找少量健康成人，主要看「安全性」與劑量。\\\"}],[\\\"$\\\",\\\"li\\\",\\\"2\\\",{\\\"children\\\":\\\"常見錯誤：把第一期試驗通過當成利多，但此階段的成功率仍低。\\\"}]]}]]]}],[\\\"$\\\",\\\"section\\\",\\\"sec-3\\\",{\\\"id\\\":\\\"sec-3\\\",\\\"className\\\":\\\"LearnArticle_section__hLVjU\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"LearnArticle_h2__NmJ08\\\",\\\"children\\\":\\\"三、真正決定藥物價值的「二期」與「三期」，差別在哪？\\\"}],[[\\\"$\\\",\\\"p\\\",\\\"0\\\",{\\\"className\\\":\\\"LearnArticle_p__aZlQ1\\\",\\\"children\\\":\\\"藥物通過安全性考驗後，才進入真正價值評估的階段。「第二期臨床試驗」（Phase II）會找小規模的病患來測試，目的是初步確認「有效性」，並找出最佳治療劑量。如果二期結果不錯，就會進入規模最龐大、最燒錢的「第三期臨床試驗」（Phase III），找數百到數千名病患，進行大規模的驗證，並與現有療法或安慰劑做比較，這是藥物能否上市前的最後一關，也是最關鍵的一關。\\\"}],[\\\"$\\\",\\\"div\\\",\\\"1\\\",{\\\"className\\\":\\\"LearnArticle_tblScroll__z9kbb\\\",\\\"children\\\":[\\\"$\\\",\\\"table\\\",null,{\\\"className\\\":\\\"LearnArticle_tbl__0yNgv\\\",\\\"children\\\":[[\\\"$\\\",\\\"thead\\\",null,{\\\"children\\\":[\\\"$\\\",\\\"tr\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"th\\\",\\\"0\\\",{\\\"children\\\":\\\"試驗階段\\\"}],[\\\"$\\\",\\\"th\\\",\\\"1\\\",{\\\"children\\\":\\\"主要目標\\\"}],[\\\"$\\\",\\\"th\\\",\\\"2\\\",{\\\"children\\\":\\\"受試者規模\\\"}],[\\\"$\\\",\\\"th\\\",\\\"3\\\",{\\\"children\\\":\\\"關鍵字\\\"}]]}]}],[\\\"$\\\",\\\"tbody\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"tr\\\",\\\"0\\\",{\\\"children\\\":[[\\\"$\\\",\\\"td\\\",\\\"0\\\",{\\\"children\\\":\\\"第一期 (Phase I)\\\"}],[\\\"$\\\",\\\"td\\\",\\\"1\\\",{\\\"children\\\":\\\"安全性、劑量\\\"}],[\\\"$\\\",\\\"td\\\",\\\"2\\\",{\\\"children\\\":\\\"數十人 (健康者)\\\"}],[\\\"$\\\",\\\"td\\\",\\\"3\\\",{\\\"children\\\":\\\"安全嗎？\\\"}]]}],[\\\"$\\\",\\\"tr\\\",\\\"1\\\",{\\\"children\\\":[\\\"$L18\\\",\\\"$L19\\\",\\\"$L1a\\\",\\\"$L1b\\\"]}],\\\"$L1c\\\",\\\"$L1d\\\"]}]]}]}],\\\"$L1e\\\"]]}],\\\"$L1f\\\",\\\"$L20\\\",\\\"$L21\\\",\\\"$L22\\\",\\\"$L23\\\"],null]}]]}]}]\\n\"])</script><script>self.__next_f.push([1,\"18:[\\\"$\\\",\\\"td\\\",\\\"0\\\",{\\\"children\\\":\\\"第二期 (Phase II)\\\"}]\\n19:[\\\"$\\\",\\\"td\\\",\\\"1\\\",{\\\"children\\\":\\\"有效性、副作用\\\"}]\\n1a:[\\\"$\\\",\\\"td\\\",\\\"2\\\",{\\\"children\\\":\\\"數十至數百人 (病患)\\\"}]\\n1b:[\\\"$\\\",\\\"td\\\",\\\"3\\\",{\\\"children\\\":\\\"有效嗎？\\\"}]\\n1c:[\\\"$\\\",\\\"tr\\\",\\\"2\\\",{\\\"children\\\":[[\\\"$\\\",\\\"td\\\",\\\"0\\\",{\\\"children\\\":\\\"第三期 (Phase III)\\\"}],[\\\"$\\\",\\\"td\\\",\\\"1\\\",{\\\"children\\\":\\\"大規模驗證有效性\\\"}],[\\\"$\\\",\\\"td\\\",\\\"2\\\",{\\\"children\\\":\\\"數百至數千人 (病患)\\\"}],[\\\"$\\\",\\\"td\\\",\\\"3\\\",{\\\"children\\\":\\\"比現在的好嗎？\\\"}]]}]\\n1d:[\\\"$\\\",\\\"tr\\\",\\\"3\\\",{\\\"children\\\":[[\\\"$\\\",\\\"td\\\",\\\"0\\\",{\\\"children\\\":\\\"第四期 (Phase IV)\\\"}],[\\\"$\\\",\\\"td\\\",\\\"1\\\",{\\\"children\\\":\\\"上市後長期監測\\\"}],[\\\"$\\\",\\\"td\\\",\\\"2\\\",{\\\"children\\\":\\\"廣大使用者\\\"}],[\\\"$\\\",\\\"td\\\",\\\"3\\\",{\\\"children\\\":\\\"長期用安全嗎？\\\"}]]}]\\n1e:[\\\"$\\\",\\\"figure\\\",\\\"2\\\",{\\\"className\\\":\\\"LearnArticle_fig__uoT7r\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"LearnArticle_figFrame__jJ7E4\\\",\\\"children\\\":\\\"✓這次解的是哪一期？✓數據結果超乎預期嗎？✓市場先前反應過了嗎？\\\"}],[\\\"$\\\",\\\"figcaption\\\",null,{\\\"className\\\":\\\"LearnArticle_figCap__LnUbb\\\",\\\"children\\\":\\\"看到解盲新聞，先問自己三件事\\\"}]]}]\\n\"])</script><script>self.__next_f.push([1,\"1f:[\\\"$\\\",\\\"section\\\",\\\"sec-4\\\",{\\\"id\\\":\\\"sec-4\\\",\\\"className\\\":\\\"LearnArticle_section__hLVjU\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"LearnArticle_h2__NmJ08\\\",\\\"children\\\":\\\"四、新聞常說的「解盲」是什麼？為什麼成功了股價還可能跌？\\\"}],[[\\\"$\\\",\\\"p\\\",\\\"0\\\",{\\\"className\\\":\\\"LearnArticle_p__aZlQ1\\\",\\\"children\\\":\\\"「解盲」這個詞聽起來很神秘，其實就是「公布試驗結果」。為了避免人為偏誤，重要的臨床試驗會採「雙盲設計」，也就是醫生和病人都不知道誰拿到的是真藥、誰拿到的是安慰劑。直到試驗結束，數據都收集完畢後，才一起「打開謎底」，這就是解盲。但解盲成功不等於股價保證上漲，因為市場可能有更高的預期。例如，市場期待治癒率 80%，結果數據是 60%，雖然統計上算成功，但因「不如預期」，股價反而可能下跌。\\\"}],[\\\"$\\\",\\\"ol\\\",\\\"1\\\",{\\\"className\\\":\\\"LearnArticle_listNum__86N5S\\\",\\\"children\\\":[[\\\"$\\\",\\\"li\\\",\\\"0\\\",{\\\"children\\\":\\\"判斷點 1：解的是哪一期的盲？第三期的解盲，重要性遠大於第二期。\\\"}],[\\\"$\\\",\\\"li\\\",\\\"1\\\",{\\\"children\\\":\\\"判斷點 2：數據好壞的程度？是「勉強過關」還是「數據驚人」？\\\"}],[\\\"$\\\",\\\"li\\\",\\\"2\\\",{\\\"children\\\":\\\"判斷點 3：市場反應過了沒？有時股價在解盲前就已大漲，利多出盡反而下跌。\\\"}]]}]]]}]\\n\"])</script><script>self.__next_f.push([1,\"20:[\\\"$\\\",\\\"section\\\",\\\"sec-5\\\",{\\\"id\\\":\\\"sec-5\\\",\\\"className\\\":\\\"LearnArticle_section__hLVjU\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"LearnArticle_h2__NmJ08\\\",\\\"children\\\":\\\"五、拿到藥證就結束了？別忘了還有「第四期」與市場挑戰\\\"}],[[\\\"$\\\",\\\"p\\\",\\\"0\\\",{\\\"className\\\":\\\"LearnArticle_p__aZlQ1\\\",\\\"children\\\":\\\"三期試驗成功、送件主管機關審查，順利的話就能拿到藥證，也就是上市許可。但這還不是終點。藥物上市後，藥廠仍需進行「第四期臨床試驗」（Phase IV），在真實世界中長期追蹤藥物的效果與罕見副作用。更現實的是，拿到藥證不等於賺大錢，後續的挑戰還包括如何進入各國的健保給付、如何跟市場上的對手競爭、以及銷售團隊的推廣能力。這些都會影響公司最終的營收表現。\\\"}]]]}]\\n\"])</script><script>self.__next_f.push([1,\"21:[\\\"$\\\",\\\"section\\\",\\\"sec-6\\\",{\\\"id\\\":\\\"sec-6\\\",\\\"className\\\":\\\"LearnArticle_section__hLVjU\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"LearnArticle_h2__NmJ08\\\",\\\"children\\\":\\\"常見問題 FAQ\\\"}],[[\\\"$\\\",\\\"div\\\",\\\"0\\\",{\\\"className\\\":\\\"LearnArticle_faq__cemBp\\\",\\\"children\\\":[[\\\"$\\\",\\\"details\\\",\\\"0\\\",{\\\"className\\\":\\\"LearnArticle_faqItem__I9h0U\\\",\\\"children\\\":[[\\\"$\\\",\\\"summary\\\",null,{\\\"children\\\":\\\"為什麼有些藥只需要做二期臨床試驗就能上市？\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"LearnArticle_faqA__IPuvc\\\",\\\"children\\\":\\\"這種情況通常發生在治療罕見疾病或嚴重絕症的藥物上，因為缺乏有效療法，主管機關可能會給予「加速核准」。但通常藥廠在藥物上市後，仍需要完成確證性的三期試驗來補足數據。\\\"}]]}],[\\\"$\\\",\\\"details\\\",\\\"1\\\",{\\\"className\\\":\\\"LearnArticle_faqItem__I9h0U\\\",\\\"children\\\":[[\\\"$\\\",\\\"summary\\\",null,{\\\"children\\\":\\\"「數據達標」跟「解盲成功」是一樣的意思嗎？\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"LearnArticle_faqA__IPuvc\\\",\\\"children\\\":\\\"基本上是。解盲成功是比較通俗的說法，專業上是指試驗數據達到了預先設定的「主要評估指標」（Primary Endpoint），在統計學上具有顯著差異。但除了達標，數據「好多少」才是市場更關心的重點。\\\"}]]}],[\\\"$\\\",\\\"details\\\",\\\"2\\\",{\\\"className\\\":\\\"LearnArticle_faqItem__I9h0U\\\",\\\"children\\\":[[\\\"$\\\",\\\"summary\\\",null,{\\\"children\\\":\\\"一家公司同時有很多藥在臨床試驗，要怎麼評估？\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"LearnArticle_faqA__IPuvc\\\",\\\"children\\\":\\\"可以觀察公司的「產品線（Pipeline）」組合。一個擁有多個不同階段候選藥物的產品線，風險會比只押寶單一藥物的公司來得分散。同時，也要看公司是否有已上市的產品能提供穩定現金流，來支持這些燒錢的研究。\\\"}]]}],[\\\"$\\\",\\\"details\\\",\\\"3\\\",{\\\"className\\\":\\\"LearnArticle_faqItem__I9h0U\\\",\\\"children\\\":[[\\\"$\\\",\\\"summary\\\",null,{\\\"children\\\":\\\"查詢臨床試驗進度的官方管道是什麼？\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"LearnArticle_faqA__IPuvc\\\",\\\"children\\\":\\\"最權威的全球性資料庫是美國國家醫學圖書館的 ClinicalTrials.gov，大部分國際性的臨床試驗都會在此註冊。針對台股公司，也可以到「公開資訊觀測站」查詢公司的重大訊息公告。\\\"}]]}]]}]]]}]\\n\"])</script><script>self.__next_f.push([1,\"22:[\\\"$\\\",\\\"section\\\",\\\"sec-7\\\",{\\\"id\\\":\\\"sec-7\\\",\\\"className\\\":\\\"LearnArticle_section__hLVjU\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"LearnArticle_h2__NmJ08\\\",\\\"children\\\":\\\"總結\\\"}],[[\\\"$\\\",\\\"p\\\",\\\"0\\\",{\\\"className\\\":\\\"LearnArticle_p__aZlQ1\\\",\\\"children\\\":\\\"看懂生技股，關鍵在於辨識臨床試驗的階段與風險。一期看安全、二期看藥效、三期拚上市，越後期的階段雖然成本越高，但確定性也越高。面對「解盲」消息時，先別急著動作，應回頭檢視數據的意義與市場的預期，才能做出更理性的判斷。\\\"}]]]}]\\n23:[\\\"$\\\",\\\"section\\\",\\\"sec-8\\\",{\\\"id\\\":\\\"sec-8\\\",\\\"className\\\":\\\"LearnArticle_section__hLVjU\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"LearnArticle_h2__NmJ08\\\",\\\"children\\\":\\\"延伸閱讀\\\"}],[[\\\"$\\\",\\\"ul\\\",\\\"0\\\",{\\\"className\\\":\\\"LearnArticle_list__WjxqC\\\",\\\"children\\\":[[\\\"$\\\",\\\"li\\\",\\\"0\\\",{\\\"children\\\":[[\\\"$\\\",\\\"$L17\\\",\\\"0-想學更多基礎知識\\\",{\\\"href\\\":\\\"/school\\\",\\\"className\\\":\\\"LearnArticle_link__gMwHV\\\",\\\"children\\\":\\\"想學更多基礎知識？來台股學堂\\\"}]]}],[\\\"$\\\",\\\"li\\\",\\\"1\\\",{\\\"children\\\":[[\\\"$\\\",\\\"$L17\\\",\\\"0-查詢個股基本面與\\\",{\\\"href\\\":\\\"/diary\\\",\\\"className\\\":\\\"LearnArticle_link__gMwHV\\\",\\\"children\\\":\\\"查詢個股基本面與籌碼狀況\\\"}]]}],[\\\"$\\\",\\\"li\\\",\\\"2\\\",{\\\"children\\\":[[\\\"$\\\",\\\"$L17\\\",\\\"0-訂閱每日市場重點\\\",{\\\"href\\\":\\\"/diary\\\",\\\"className\\\":\\\"LearnArticle_link__gMwHV\\\",\\\"children\\\":\\\"訂閱每日市場重點整理：台股日報\\\"}]]}]]}]]]}]\\n\"])</script><script>self.__next_f.push([1,\"13:[[\\\"$\\\",\\\"meta\\\",\\\"0\\\",{\\\"charSet\\\":\\\"utf-8\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"1\\\",{\\\"name\\\":\\\"viewport\\\",\\\"content\\\":\\\"width=device-width, initial-scale=1\\\"}]]\\nf:null\\n\"])</script><script>self.__next_f.push([1,\"24:I[80622,[],\\\"IconMark\\\"]\\n11:{\\\"metadata\\\":[[\\\"$\\\",\\\"title\\\",\\\"0\\\",{\\\"children\\\":\\\"生技臨床試驗階段差在哪？解盲成功就會漲？3 個數字看懂新藥股風險｜股市大佬 TradeBoss\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"1\\\",{\\\"name\\\":\\\"description\\\",\\\"content\\\":\\\"看到生技股新聞稿寫「臨床試驗結果正向」，股價卻沒反應，甚至還下跌？這就是因為沒搞懂新藥開發不同階段的意義。這篇文章會帶你拆解臨床一、二、三期到底差在哪，讓你下次看到「解盲」新聞時，能判斷出這顆藥的真實進度與潛在風險。\\\"}],[\\\"$\\\",\\\"link\\\",\\\"2\\\",{\\\"rel\\\":\\\"icon\\\",\\\"href\\\":\\\"/favicon.ico\\\",\\\"type\\\":\\\"image/x-icon\\\",\\\"sizes\\\":\\\"16x16\\\"}],[\\\"$\\\",\\\"$L24\\\",\\\"3\\\",{}]],\\\"error\\\":null,\\\"digest\\\":\\\"$undefined\\\"}\\n\"])</script><script>self.__next_f.push([1,\"16:\\\"$11:metadata\\\"\\n\"])</script></body></html>","rsc":"1:\"$Sreact.fragment\"\n2:I[81259,[\"2619\",\"static/chunks/2619-04bc32f026a0d946.js\",\"7177\",\"static/chunks/app/layout-4382c12d510386d3.js\"],\"default\"]\n3:I[89379,[\"2619\",\"static/chunks/2619-04bc32f026a0d946.js\",\"7177\",\"static/chunks/app/layout-4382c12d510386d3.js\"],\"default\"]\n4:I[9766,[],\"\"]\n5:I[98924,[],\"\"]\n6:I[10021,[\"2619\",\"static/chunks/2619-04bc32f026a0d946.js\",\"7177\",\"static/chunks/app/layout-4382c12d510386d3.js\"],\"default\"]\n7:I[10528,[\"2619\",\"static/chunks/2619-04bc32f026a0d946.js\",\"7177\",\"static/chunks/app/layout-4382c12d510386d3.js\"],\"default\"]\n8:I[50861,[\"2619\",\"static/chunks/2619-04bc32f026a0d946.js\",\"7177\",\"static/chunks/app/layout-4382c12d510386d3.js\"],\"default\"]\nc:I[57150,[],\"\"]\n:HL[\"/_next/static/media/3d26d2f3aa81a833-s.p.woff2\",\"font\",{\"crossOrigin\":\"\",\"type\":\"font/woff2\"}]\n:HL[\"/_next/static/media/604a121a6fa1a135-s.p.woff2\",\"font\",{\"crossOrigin\":\"\",\"type\":\"font/woff2\"}]\n:HL[\"/_next/static/media/6e1768769e6f59a2-s.p.woff2\",\"font\",{\"crossOrigin\":\"\",\"type\":\"font/woff2\"}]\n:HL[\"/_next/static/media/ab2e3a11646b0499-s.p.woff2\",\"font\",{\"crossOrigin\":\"\",\"type\":\"font/woff2\"}]\n:HL[\"/_next/static/css/75c047ba52e43fcc.css\",\"style\"]\n:HL[\"/_next/static/css/aa90c9a426448e43.css\",\"style\"]\n:HL[\"/_next/static/css/e55779c04dd245e2.css\",\"style\"]\n:HL[\"/_next/static/css/8c57d5c3b938342e.css\",\"style\"]\n:HL[\"/_next/static/css/3eaf36e367672966.css\",\"style\"]\n0:{\"P\":null,\"b\":\"2DJ2zhzL_dHSrK5QsdDKA\",\"p\":\"\",\"c\":[\"\",\"learn\",\"biotech-clinical-trial-pha