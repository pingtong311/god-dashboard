,{\"children\":[null,[[\"$\",\"$L13\",null,{\"children\":\"$L14\"}],[\"$\",\"meta\",null,{\"name\":\"next-size-adjust\",\"content\":\"\"}]],[\"$\",\"$L15\",null,{\"children\":[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$16\",null,{\"fallback\":null,\"children\":\"$L17\"}]}]}]]}]\n18:I[52619,[\"2619\",\"static/chunks/2619-04bc32f026a0d946.js\",\"6309\",\"static/chunks/app/learn/%5Bslug%5D/page-f7b99344f7e2ee16.js\"],\"\"]\ne:[\"$\",\"div\",null,{\"className\":\"LearnArticle_wrap__LIQ8G\",\"children\":[\"$\",\"article\",null,{\"className\":\"LearnArticle_article__2nBbk\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_meta__etj_G\",\"children\":[[\"$\",\"$L18\",null,{\"className\":\"LearnArticle_cat__GQMlg\",\"href\":\"/learn?c=events\",\"children\":\"金融大事件\"}],[\"$\",\"span\",null,{\"className\":\"LearnArticle_read__QEj6a\",\"children\":\"閱讀約 5 分鐘\"}]]}],[\"$\",\"h1\",null,{\"className\":\"LearnArticle_title__0_la8\",\"children\":\"金融海嘯為什麼分散會同時失效？系統性風險3個特徵\"}],[\"$\",\"details\",null,{\"className\":\"LearnArticle_toc__LcSAa\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"LearnArticle_tocSummary__YBddG\",\"children\":\"本文目錄\"}],[\"$\",\"ol\",null,{\"className\":\"LearnArticle_tocList__Rq_Lz\",\"children\":[[\"$\",\"li\",\"sec-1\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-1\",\"children\":\"一、先把故事縮成一個結構句\"}]}],[\"$\",\"li\",\"sec-2\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-2\",\"children\":\"二、特徵一：關聯性在最糟的時候上升\"}]}],[\"$\",\"li\",\"sec-3\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-3\",\"children\":\"三、特徵二：槓桿讓小損失變成生存問題\"}]}],[\"$\",\"li\",\"sec-4\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-4\",\"children\":\"四、特徵三：敘述會從複雜變成一句話\"}]}],[\"$\",\"li\",\"sec-5\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-5\",\"children\":\"五、個人帳戶能做的，不是預測下一次海嘯\"}]}],[\"$\",\"li\",\"sec-6\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-6\",\"children\":\"常見問題 FAQ\"}]}],[\"$\",\"li\",\"sec-7\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-7\",\"children\":\"總結\"}]}],[\"$\",\"li\",\"sec-8\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-8\",\"children\":\"延伸閱讀\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"LearnArticle_body__6B7Mb\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_intro__ATV5c\",\"children\":\"二〇〇八年全球金融海嘯的導火線被寫進很多教科書：房貸、槓桿、機構連環。對自己管帳戶的人，有一個比較落地的問題：為什麼看起來分散的配置，會在同一段時間一起受傷？答案不是「分散沒用」，而是分散主要降低個別意外，擋不住所有人同時需要現金。系統性風險的樣子，比任何單一機構的名字更值得記住。\"}],[],[\"$\",\"div\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"分散降低個別風險，不自動免除大家同時要錢的風險\"}],[\"$\",\"li\",\"1\",{\"children\":\"槓桿與關聯性會在壓力期一起升高，這是結構不是巧合\"}],[\"$\",\"li\",\"2\",{\"children\":\"能檢查的是自己有沒有「同一天都要有人接」的部位堆疊\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、先把故事縮成一個結構句\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"海嘯的細節很多，結構句很短：資產被層層包裝、槓桿把小損失放大、當信任下降時所有人同時要現金。現金是有限的，能賣的東西會被一起賣掉。於是平常看起來不像同一類的標的，價格路徑突然變像。你不需要成為信用衍生商品專家，也能用這句檢查自己的帳戶：我有沒有好幾筆部位，其實都在賭「市場還有人要接手」？\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"包裝與槓桿把小裂縫放大\"}],[\"$\",\"li\",\"1\",{\"children\":\"信任下降時，賣壓不分類別\"}],[\"$\",\"li\",\"2\",{\"children\":\"先檢查自己有沒有同一種接手假設\"}]]}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、特徵一：關聯性在最糟的時候上升\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"分散之所以有效，是因為不同東西通常不會同一天出事。系統壓力會破壞這個前提。需要現金的人不管你分類叫電子、金融還是原物料，能變現的就賣。結果是相關係數上升，分散度表面還在，保護力下降。這不是叫你不要分散，是叫你不要把「我買了好幾種」直接等同「我很安全」。安全要看壓力期它們會不會一起被拿去換現金。\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"平常有效\"}],[\"$\",\"th\",\"1\",{\"children\":\"壓力期可能變成\"}],[\"$\",\"th\",\"2\",{\"children\":\"檢查問題\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"不同產業互沖\"}],[\"$\",\"td\",\"1\",{\"children\":\"一起被賣換現金\"}],[\"$\",\"td\",\"2\",{\"children\":\"它們會不會同一天需要買家\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"股票加債券\"}],[\"$\",\"td\",\"1\",{\"children\":\"兩邊都可能被提款\"}],[\"$\",\"td\",\"2\",{\"children\":\"有沒有真正的現金緩衝\"}]]}],[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"不同國家\"}],[\"$\",\"td\",\"1\",{\"children\":\"風險偏好一起下降\"}],[\"$\",\"td\",\"2\",{\"children\":\"資金流向會不會同步\"}]]}],[\"$\",\"tr\",\"3\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"很多檔個股\"}],[\"$\",\"td\",\"1\",{\"children\":\"同一種題材或同一種槓桿\"}],[\"$\",\"td\",\"2\",{\"children\":\"是真分散還是假分散\"}]]}]]}]]}]}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、特徵二：槓桿讓小損失變成生存問題\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"沒有槓桿，價格跌一段是帳面痛；有槓桿，同一段跌幅會變成追繳、被迫平倉、再把價格往更不利的方向推。二〇〇八年把這條鏈放大到機構層級。散戶版比較小，但邏輯相同：融資、當沖當沖再加碼、相關商品疊在一起，都會在波動變大時把「我還撐得住」變成假的。系統性風險喜歡找槓桿高的地方下手，因為那裡的賣出不是選擇，是被迫。\"}],[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[\"$L19\",\"$L1a\",\"$L1b\"]}],\"$L1c\"]]}],\"$L1d\",\"$L1e\",\"$L1f\",\"$L20\",\"$L21\"],\"$L22\"]}]]}]}]\n19:[\"$\",\"li\",\"0\",{\"children\":\"先數自己有哪些部位其實是借來的風險\"}]\n1a:[\"$\",\"li\",\"1\",{\"children\":\"波動變大時，維持率與追繳誰先到\"}]\n1b:[\"$\",\"li\",\"2\",{\"children\":\"被迫賣出會不會讓你加入同一側的擠壓\"}]\n1c:[\"$\",\"figure\",\"2\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"1檢查假分散2槓桿設上限3留真正現金緩衝\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"帳戶能先做的\"}]]}]\n1d:[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、特徵三：敘述會從複雜變成一句話\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"危機初期的解釋通常很技術、很分裂；到了中後期，會被縮成一句人人會講的話。簡化有助傳播，也代表這個解釋已經不再是少數人的研究，而成了擁擠的共識。對交易者，這是行為訊號，不是進出指令：當你發現自己的依據跟聊天室同一句，就要回頭看部位有沒有太大。海嘯教的不是「那句話錯了」，是「一句話傳到最廣時，接手可能變少」。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"初期解釋分裂，後期變成口號\"}],[\"$\",\"li\",\"1\",{\"children\":\"口號傳播愈廣，愈要檢查擁擠\"}],[\"$\",\"li\",\"2\",{\"children\":\"不要把大家都在講當成已經安全或已經到底\"}]]}]]]}]\n1e:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、個人帳戶能做的，不是預測下一次海嘯\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"你無法靠一篇教學文預知下一次系統事件。能做的是讓自己的結構比較不像當年那些被迫賣出的人：真實現金緩衝、槓桿有上限、相關部位加總後仍睡得著、以及承認分散有邊界。成功在這裡的意思很樸素——事件來的時候你還有選擇，不是只剩被平倉。選擇比預測便宜，也比較能重複。\"}]]]}]\n1f:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"那分散還要不要做？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"要，但要承認它的邊界。分散降低個別意外，不自動擋住所有人同時要現金。兩件事都要管。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"散戶槓桿很小，這篇跟我有關嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"有。融資、重疊題材、同一天都必須有人接手的部位，都是縮小版的同一結構。不必等到機構級才適用。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"現金緩衝要留多少？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"沒有通用數字。原則是：壓力期你不必因為生活需求去賣被一起殺的部位。這個「不必」比百分比重要。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"二〇〇八年以後是不是比較安全？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"規則與資本要求有變，人性與擁擠沒有消失。把「已經比較安全」當前提，本身就是一種擁擠敘述。\"}]]}]]}]]]}]\n20:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"金融海嘯對個人最有用的不是機構名單，是系統性風險三特徵：關聯性在壓力期上升、槓桿把小損失變成被迫賣出、敘述會縮成一句擁擠的話。分散要做，邊界也要承認。\"}]]]}]\n21:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L18\",\"0-黑色星期一與流動\",{\"href\":\"/learn/black-monday-1987-liquidity-vanishes-first\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"黑色星期一與流動性\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L18\",\"0-台股歷史行情教訓\",{\"href\":\"/learn/taiwan-stock-market-history-lessons\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"台股歷史行情教訓\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L18\",\"0-為什麼系統性風險\",{\"href\":\"/school\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"為什麼系統性風險難分散，見學堂\"}]]}]]}]]]}]\n22:[\"$\",\"div\",null,{\"className\":\"LearnArticle_related__9qV55\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_relatedTitle__RXfrl\",\"children\":\"相關文章\"}],[[\"$\",\"$L18\",\"black-monday-1987-liquidity-vanishes-first\",{\"href\":\"/learn/black-monday-1987-liquidity-vanishes-first\",\"className\":\"LearnArticle_relatedLink__mibXe\",\"children\":\"黑色星期一與流動性\"}],[\"$\",\"$L18\",\"taiwan-stock-market-history-lessons\",{\"href\":\"/learn/taiwan-stock-market-history-lessons\",\"className\":\"LearnArticle_relatedLink__mibXe\",\"children\":\"台股歷史行情教訓\"}]]]}]\n14:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\n10:null\n23:I[80622,[],\"IconMark\"]\n12:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"金融海嘯為什麼分散會同時失效？系統性風險3個特徵｜股市大佬 TradeBoss\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"二〇〇八年全球金融海嘯的導火線被寫進很多教科書：房貸、槓桿、機構連環。對自己管帳戶的人，有一個比較落地的問題：為什麼看起來分散的配置，會在同一段時間一起受傷？答案不是「分散沒用」，而是分散主要降低個別意外，擋不住所有人同時需要現金。系統性風險的樣子，比任何單一機構的名字更值得記住\"}],[\"$\",\"link\",\"2\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}],[\"$\",\"$L23\",\"3\",{}]],\"error\":null,\"digest\":\"$undefined\"}\n17:\"$12:metadata\"\n"}