null,{\"className\":\"LearnArticle_tocSummary__YBddG\",\"children\":\"本文目錄\"}],[\"$\",\"ol\",null,{\"className\":\"LearnArticle_tocList__Rq_Lz\",\"children\":[[\"$\",\"li\",\"sec-1\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-1\",\"children\":\"一、先把雞湯還原成工作\"}]}],[\"$\",\"li\",\"sec-2\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-2\",\"children\":\"二、三句真話\"}]}],[\"$\",\"li\",\"sec-3\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-3\",\"children\":\"三、為什麼第三句最有用\"}]}],[\"$\",\"li\",\"sec-4\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-4\",\"children\":\"四、趨勢不是唯一正確宗教\"}]}],[\"$\",\"li\",\"sec-5\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-5\",\"children\":\"五、最小動作\"}]}],[\"$\",\"li\",\"sec-6\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-6\",\"children\":\"常見問題 FAQ\"}]}],[\"$\",\"li\",\"sec-7\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-7\",\"children\":\"總結\"}]}],[\"$\",\"li\",\"sec-8\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-8\",\"children\":\"延伸閱讀\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"LearnArticle_body__6B7Mb\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_intro__ATV5c\",\"children\":\"艾德·塞柯塔是公開被歸在趨勢交易傳統裡的人。訪談句子短，所以很好傳，也很容易變成雞湯。三句特別常出現：順著明顯的方向、用規則管部位、以及每個人從市場得到自己真正要的東西。最後一句最容易被讀成命運，其實比較像檢討：你的行為在邀請哪一種結果。\"}],[],[\"$\",\"div\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"趨勢心法的日常是小虧與等待，不是天天正確\"}],[\"$\",\"li\",\"1\",{\"children\":\"部位規則比進場口訣更能決定你能不能留到大段\"}],[\"$\",\"li\",\"2\",{\"children\":\"「得到你要的」是在問行為，不是在算命\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、先把雞湯還原成工作\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"順著趨勢聽起來瀟灑。實務上它表示：多數日子你在付小的離開成本，等少數日子出現大段。海龜那篇寫過同一種資金曲線。塞柯塔的公開表述把它講得更像性格：你能不能忍受無聊。不能忍受，就會在小虧之後改規則，於是大段來時你已經不在場。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"日常是小虧\"}],[\"$\",\"li\",\"1\",{\"children\":\"大段是少數\"}],[\"$\",\"li\",\"2\",{\"children\":\"改規則常發生在最不該改的時候\"}]]}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、三句真話\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"第一，方向明顯時才做，不明顯就少做。第二，部位跟波動走，有把握也不能無限放大。第三，反覆做某件事的人，通常不是「運氣如此」，是那件事滿足了他的某種需求——證明自己、尋求刺激、或害怕錯過。第三句是檢討句。\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"雞湯讀法\"}],[\"$\",\"th\",\"1\",{\"children\":\"工作讀法\"}],[\"$\",\"th\",\"2\",{\"children\":\"檢查\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"順勢就會贏\"}],[\"$\",\"td\",\"1\",{\"children\":\"順勢仍有一長串小虧\"}],[\"$\",\"td\",\"2\",{\"children\":\"你能不能付\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"大師很有把握\"}],[\"$\",\"td\",\"1\",{\"children\":\"把握仍要被部位限制\"}],[\"$\",\"td\",\"2\",{\"children\":\"上限在哪\"}]]}],[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"市場對我不好\"}],[\"$\",\"td\",\"1\",{\"children\":\"我的行為在邀請什麼\"}],[\"$\",\"td\",\"2\",{\"children\":\"日誌怎麼寫\"}]]}],[\"$\",\"tr\",\"3\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"我要的是賺錢\"}],[\"$\",\"td\",\"1\",{\"children\":\"行為像在要刺激\"}],[\"$\",\"td\",\"2\",{\"children\":\"頻率是不是太高\"}]]}]]}]]}]}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、為什麼第三句最有用\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"過度交易、抱不住賺、死守虧，都可能是「得到自己要的」：要的是行動感、要的是不認輸、要的是被證明。把結果只讀成技術失敗，會漏掉動機。動機不改，換指標也會回到同一種結果。\"}],[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"先描述你反覆做的行為\"}],[\"$\",\"li\",\"1\",{\"children\":\"再問它滿足你什麼\"}],[\"$\",\"li\",\"2\",{\"children\":\"最後才改技術\"}]]}],[\"$\",\"figure\",\"2\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"!順勢就會贏!怪市場!忽略無聊\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"雞湯讀壞\"}]]}]]]}],[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[\"$L18\",[\"$L19\",\"$L1a\"]]}],\"$L1b\",\"$L1c\",\"$L1d\",\"$L1e\"],\"$L1f\"]}]]}]}]\n18:[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、趨勢不是唯一正確宗教\"}]\n19:[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"公開傳統把他放在趨勢這一側。均值回歸、波段、長期持有是另一組失敗方式。塞柯塔不負責證明趨勢比較高貴。他負責提醒：選了哪一側，就要付那一側的無聊與回撤。\"}]\n1a:[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"風格沒有比較高貴\"}],[\"$\",\"li\",\"1\",{\"children\":\"費用要先承認\"}],[\"$\",\"li\",\"2\",{\"children\":\"混用兩側常兩頭不到\"}]]}]\n1b:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、最小動作\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"在日誌加一欄：我今天真正要的是什麼。連續寫兩週，比再讀十句金句有用。\"}]]]}]\n1c:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"不明顯就少做，會不會錯過？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"會錯過。趨勢方法付的就是錯過震盪的機會成本。兩頭都要，通常兩頭都付。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"第三句是不是怪自己？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"不是道德譴責。是把動機放進檢討，才改得動行為。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"和海龜有什麼關係？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"同一家族：小虧換大段、部位跟波動。海龜較像規則書，這篇較像性格檢查。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"短線能不能用？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"短線更要問你要的是不是刺激。頻率高時，第三句特別重要。\"}]]}]]}]]]}]\n1d:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"塞柯塔三句：明顯才做、部位有上限、結果常是你的行為請來的。雞湯讀成命運，工作讀成檢討欄。\"}]]]}]\n1e:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L17\",\"0-海龜實驗\",{\"href\":\"/learn/turtle-traders-experiment-what-it-really-taught\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"海龜實驗\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L17\",\"0-過度交易的代價\",{\"href\":\"/learn/the-real-cost-of-overtrading\",\"className\