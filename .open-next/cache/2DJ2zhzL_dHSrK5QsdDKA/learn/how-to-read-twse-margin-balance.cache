":[null,[[\"$\",\"$L12\",null,{\"children\":\"$L13\"}],[\"$\",\"meta\",null,{\"name\":\"next-size-adjust\",\"content\":\"\"}]],[\"$\",\"$L14\",null,{\"children\":[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$15\",null,{\"fallback\":null,\"children\":\"$L16\"}]}]}]]}]\n17:I[52619,[\"2619\",\"static/chunks/2619-04bc32f026a0d946.js\",\"6309\",\"static/chunks/app/learn/%5Bslug%5D/page-f7b99344f7e2ee16.js\"],\"\"]\nd:[\"$\",\"div\",null,{\"className\":\"LearnArticle_wrap__LIQ8G\",\"children\":[\"$\",\"article\",null,{\"className\":\"LearnArticle_article__2nBbk\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_meta__etj_G\",\"children\":[[\"$\",\"$L17\",null,{\"className\":\"LearnArticle_cat__GQMlg\",\"href\":\"/learn?c=chips\",\"children\":\"籌碼面\"}],[\"$\",\"span\",null,{\"className\":\"LearnArticle_read__QEj6a\",\"children\":\"閱讀約 6 分鐘\"}]]}],[\"$\",\"h1\",null,{\"className\":\"LearnArticle_title__0_la8\",\"children\":\"台股融資餘額怎麼看大盤？超過2000億就危險？3個步驟看懂散戶信心與市場風險\"}],[\"$\",\"details\",null,{\"className\":\"LearnArticle_toc__LcSAa\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"LearnArticle_tocSummary__YBddG\",\"children\":\"本文目錄\"}],[\"$\",\"ol\",null,{\"className\":\"LearnArticle_tocList__Rq_Lz\",\"children\":[[\"$\",\"li\",\"sec-1\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-1\",\"children\":\"一、什麼是融資餘額？為什麼它代表散戶動向？\"}]}],[\"$\",\"li\",\"sec-2\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-2\",\"children\":\"二、融資餘額越高，大盤就越危險嗎？破解數字迷思\"}]}],[\"$\",\"li\",\"sec-3\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-3\",\"children\":\"三、價資關係怎麼看？用一張表讀懂四種大盤劇本\"}]}],[\"$\",\"li\",\"sec-4\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-4\",\"children\":\"四、除了融資餘額，還能看什麼進階指標？\"}]}],[\"$\",\"li\",\"sec-5\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-5\",\"children\":\"五、如何查詢融資餘額？在股市大佬快速掌握\"}]}],[\"$\",\"li\",\"sec-6\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-6\",\"children\":\"常見問題 FAQ\"}]}],[\"$\",\"li\",\"sec-7\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-7\",\"children\":\"總結\"}]}],[\"$\",\"li\",\"sec-8\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-8\",\"children\":\"延伸閱讀\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"LearnArticle_body__6B7Mb\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_intro__ATV5c\",\"children\":\"打開看盤軟體，看到「融資餘額」每天幾千億上下跳動，新聞一下說這是散戶抬轎，一下又說是資金動能，讓你一頭霧水嗎？其實這個數字是觀察散戶信心的溫度計，這篇文章會教你如何把它跟大盤走勢對照看，找出市場過熱或止跌的訊號。\"}],[[\"$\",\"figure\",\"figure-0\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"高集中度只說明買超很集中，不說明是誰、要幹嘛前 15 大其餘成交例：集中度 40%＝這批分點淨買超約當天成交的四成不能從集中度推出明天方向\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"示意圖｜分點集中度：前幾大買超合計，佔當天成交的比例（教學結構，不是某檔實盤）\"}]]}]],[\"$\",\"div\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"融資餘額是散戶借錢買股的總金額，常被視為散戶信心的指標。\"}],[\"$\",\"li\",\"1\",{\"children\":\"最危險的訊號是「價跌資增」，代表大盤在跌，散戶卻持續借錢攤平。\"}],[\"$\",\"li\",\"2\",{\"children\":\"不要只看絕對數字，融資餘額搭配大盤指數的「價量關係」看趨勢才準確。\"}],[\"$\",\"li\",\"3\",{\"children\":\"高融資不代表市場會立刻崩盤，但表示籌碼較亂，未來下跌時賣壓可能更重。\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、什麼是融資餘額？為什麼它代表散戶動向？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"「融資」就是向券商借錢買股票，而「融資餘額」就是市場上所有投資人借錢買股後，還沒還錢的總金額。因為法人機構（例如外資、投信）有自己的資金管道，很少會透過這種方式借錢，所以融資餘額通常被當成是散戶資金動能與信心的指標。金額越高，代表散戶看好後市、願意借錢投入的意願越強。\"}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、融資餘額越高，大盤就越危險嗎？破解數字迷思\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"很多人會設定一個「危險水位」，例如「融資餘額超過 2,000 億大盤就要崩了」。這個說法不完全正確。隨著台股總市值不斷長大，融資餘額的絕對數字自然會水漲船高。20年前的 2,000 億跟現在的 2,000 億，代表的市場槓桿程度完全不同。所以，單看一個絕對數字沒有意義，關鍵在於觀察它的「趨勢變化」以及與「大盤走勢」的對照關係。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"判斷方法：觀察融資是「連續增加」還是「連續減少」的趨勢。\"}],[\"$\",\"li\",\"1\",{\"children\":\"常見錯誤：只看某一天的數字就斷定市場多空，忽略了整體的趨勢。\"}],[\"$\",\"li\",\"2\",{\"children\":\"核心觀念：數字本身沒有好壞，與大盤走勢的「相對關係」才是重點。\"}]]}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、價資關係怎麼看？用一張表讀懂四種大盤劇本\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"判斷融資餘額對大盤影響的核心，就是「價」與「資」的關係。價，指的是大盤指數的漲跌；資，指的是融資餘額的增減。把兩者放在一起看，可以組合出四種常見的市場情境，幫助你判斷目前市場籌碼的穩定度。\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"情境\"}],[\"$\",\"th\",\"1\",{\"children\":\"大盤指數（價）\"}],[\"$\",\"th\",\"2\",{\"children\":\"融資餘額（資）\"}],[\"$\",\"th\",\"3\",{\"children\":\"代表意義\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[\"$L18\",\"$L19\",\"$L1a\",\"$L1b\"]}],\"$L1c\",\"$L1d\",\"$L1e\"]}]]}]}],\"$L1f\"]]}],\"$L20\",\"$L21\",\"$L22\",\"$L23\",\"$L24\"],null]}]]}]}]\n18:[\"$\",\"td\",\"0\",{\"children\":\"價漲資增\"}]\n19:[\"$\",\"td\",\"1\",{\"children\":\"上漲\"}]\n1a:[\"$\",\"td\",\"2\",{\"children\":\"增加\"}]\n1b:[\"$\",\"td\",\"3\",{\"children\":\"散戶與市場看法一致，行情熱絡，但需留意過熱風險。\"}]\n1c:[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"價漲資減\"}],[\"$\",\"td\",\"1\",{\"children\":\"上漲\"}],[\"$\",\"td\",\"2\",{\"children\":\"減少\"}],[\"$\",\"td\",\"3\",{\"children\":\"散戶逢高獲利了結，籌碼流向法人，有利行情穩定續漲。\"}]]}]\n1d:[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"價跌資增\"}],[\"$\",\"td\",\"1\",{\"children\":\"下跌\"}],[\"$\",\"td\",\"2\",{\"children\":\"增加\"}],[\"$\",\"td\",\"3\",{\"children\":\"最危險的訊號！散戶在下跌時攤平，籌碼凌亂，後市壓力大。\"}]]}]\n1e:[\"$\",\"tr\",\"3\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"價跌資減\"}],[\"$\",\"td\",\"1\",{\"children\":\"下跌\"}],[\"$\",\"td\",\"2\",{\"children\":\"減少\"}],[\"$\",\"td\",\"3\",{\"children\":\"散戶停損賣出，籌碼獲得清洗，有利於市場尋找底部。\"}]]}]\n1f:[\"$\",\"figure\",\"2\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"!把融資當絕對賣點!忽略大盤位階高低!用大盤指標硬套個股!只看一天數字下結論\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"融資觀察的常見誤區\"}]]}]\n20:[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、除了融資餘額，還能看什麼進階指標？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"當你熟悉了基本的價資關係後，可以搭配「融資維持率」一起看。融資維持率的算法是「股票現值 ÷ 融資金額」，可以理解成你的擔保品價值還剩多少。當維持率越低，代表股票跌越多，越接近券商的「追繳令」門檻。全市場的融資維持率如果降到 140% 以下，就可能引發一波「斷頭」賣壓，也就是散戶被迫賣股還錢，造成多殺多的情況。\"}],[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"融資維持率公式：整戶維持率 = (融資股票市值 + 融券保證金 + 融券擔保品) ÷ (融資金額 + 融券股票市值) × 100%\"}],[\"$\",\"li\",\"1\",{\"children\":\"法定追繳門檻：當維持率低於 130%，券商會發出追繳通知。\"}],[\"$\",\"li\",\"2\",{\"children\":\"市場警戒線：全市場的平均維持率若跌破 140%-150%，代表許多散戶的部位處於虧損狀態，市場潛在賣壓加重。\"}]]}]]]}]\n21:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、如何查詢融資餘額？在股市大佬快速掌握\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"想查詢最新的融資餘額數據，除了在證交所網站查詢，也可以在股市大佬的「大盤總覽」頁面中找到。我們將融資餘額、融券餘額與大盤指數直接整合在同一張圖表上，讓你一眼就能看出價資關係的變化趨勢，不用自己手動拼湊資料，能更直覺地判斷市場籌碼動向。\"}]]]}]\n22:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"融資餘額要去哪裡查？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"你可以在臺灣證券交易所的網站上查詢每日的融資融券餘額統計，或是在各大券商的看盤軟體、財經資訊網站（如股市大佬）的大盤分析頁面找到整理好的圖表。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"融資增加就一定不好嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"不一定。在多頭市場初期，融資增加代表市場人氣回籠，是健康的現象。但在漲了一大段的高檔區域，融資才快速增加，就可能是行情過熱、散戶追高的警訊，需要提高警覺。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"法人也會使用融資嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"極少數情況下可能會有，但不是常態。法人機構資金雄厚，主要使用自有資金或其他融資管道，因此市場普遍將融資餘額視為觀察散戶動向的指標。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"融資跟融券有什麼不同？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"融資是「借錢買股」，看多後市；融券是「借股票來賣」，看空後市。兩者是相反的操作。融資餘額代表市場上做多的散戶力量，融券餘額則代表做空的散戶力量。\"}]]}]]}]]]}]\n23:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"總結來說，融資餘額本身沒有絕對的好壞，它是一個衡量市場情緒的工具。你應該把它當成大盤的「體溫計」，觀察它與指數走勢的互動，特別是避開「價跌資增」這種籌碼凌亂的危險訊號，就能有效提升你的市場敏感度。\"}]]]}]\n24:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L17\",\"0-大盤總覽｜即時追\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"大盤總覽｜即時追蹤融資變化\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L17\",\"0-台股學堂｜學習更\",{\"href\":\"/school\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"台股學堂｜學習更多籌碼知識\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L17\",\"0-今日戰情｜掌握今\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"今日戰情｜掌握今日市場關鍵數據\"}]]}]]}]]]}]\n13:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\nf:null\n25:I[80622,[],\"IconMark\"]\n11:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"台股融資餘額怎麼看大盤？超過2000億就危險？3個步驟看懂散戶信心與市場風險｜股市大佬 TradeBoss\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"打開看盤軟體，看到「融資餘額」每天幾千億上下跳動，新聞一下說這是散戶抬轎，一下又說是資金動能，讓你一頭霧水嗎？其實這個數字是觀察散戶信心的溫度計，這篇文章會教你如何把它跟大盤走勢對照看，找出市場過熱或止跌的訊號。\"}],[\"$\",\"link\",\"2\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}],[\"$\",\"$L25\",\"3\",{}]],\"error\":null,\"digest\":\"$undefined\"}\n16:\"$11:metadata\"\n"}