ll,[[\"$\",\"$L12\",null,{\"children\":\"$L13\"}],[\"$\",\"meta\",null,{\"name\":\"next-size-adjust\",\"content\":\"\"}]],[\"$\",\"$L14\",null,{\"children\":[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$15\",null,{\"fallback\":null,\"children\":\"$L16\"}]}]}]]}]\n17:I[52619,[\"2619\",\"static/chunks/2619-04bc32f026a0d946.js\",\"6309\",\"static/chunks/app/learn/%5Bslug%5D/page-f7b99344f7e2ee16.js\"],\"\"]\nd:[\"$\",\"div\",null,{\"className\":\"LearnArticle_wrap__LIQ8G\",\"children\":[\"$\",\"article\",null,{\"className\":\"LearnArticle_article__2nBbk\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_meta__etj_G\",\"children\":[[\"$\",\"$L17\",null,{\"className\":\"LearnArticle_cat__GQMlg\",\"href\":\"/learn?c=rules\",\"children\":\"制度與工具\"}],[\"$\",\"span\",null,{\"className\":\"LearnArticle_read__QEj6a\",\"children\":\"閱讀約 6 分鐘\"}]]}],[\"$\",\"h1\",null,{\"className\":\"LearnArticle_title__0_la8\",\"children\":\"選擇權時間價值怎麼衰減？3 大關鍵因素，別讓權利金白白蒸發\"}],[\"$\",\"details\",null,{\"className\":\"LearnArticle_toc__LcSAa\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"LearnArticle_tocSummary__YBddG\",\"children\":\"本文目錄\"}],[\"$\",\"ol\",null,{\"className\":\"LearnArticle_tocList__Rq_Lz\",\"children\":[[\"$\",\"li\",\"sec-1\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-1\",\"children\":\"一、為什麼權利金會縮水？先搞懂選擇權的「內含價值」與「時間價值」\"}]}],[\"$\",\"li\",\"sec-2\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-2\",\"children\":\"二、時間價值衰減的元兇：Theta 值是什麼？\"}]}],[\"$\",\"li\",\"sec-3\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-3\",\"children\":\"三、時間價值衰減的 3 大關鍵因素：距離到期日、價內外與波動率\"}]}],[\"$\",\"li\",\"sec-4\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-4\",\"children\":\"四、時間價值怎麼算？情境範例帶你看懂變化\"}]}],[\"$\",\"li\",\"sec-5\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-5\",\"children\":\"五、常見誤讀：時間價值衰減只影響買方嗎？\"}]}],[\"$\",\"li\",\"sec-6\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-6\",\"children\":\"常見問題 FAQ\"}]}],[\"$\",\"li\",\"sec-7\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-7\",\"children\":\"總結\"}]}],[\"$\",\"li\",\"sec-8\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-8\",\"children\":\"延伸閱讀\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"LearnArticle_body__6B7Mb\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_intro__ATV5c\",\"children\":\"買了選擇權，權利金卻一直縮水？這篇文章將拆解時間價值衰減的秘密，帶你搞懂三大關鍵因素，不再困惑於數字變化。\"}],[[\"$\",\"figure\",\"figure-0\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"沒扣成本的勝率，看起來都會比較漂亮0.029%手續費 1 折來回0.15%當沖證交稅0.06%滑價估計三項合計約 0.24%；留倉稅率更高，約 0.39%\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"示意圖｜當沖來回成本：1 折手續費 + 證交稅 + 滑價（教學結構，不是某檔實盤）\"}]]}]],[\"$\",\"div\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"時間價值是選擇權權利金的一部分，會隨時間流逝而減少。\"}],[\"$\",\"li\",\"1\",{\"children\":\"Theta 值代表時間價值每天衰減多少，是看懂衰減速度的關鍵。\"}],[\"$\",\"li\",\"2\",{\"children\":\"距離到期日越近，時間價值衰減速度越快。\"}],[\"$\",\"li\",\"3\",{\"children\":\"價平選擇權的時間價值通常最高，衰減也最劇烈。\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、為什麼權利金會縮水？先搞懂選擇權的「內含價值」與「時間價值」\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"許多新手投資人看到選擇權權利金不斷變化，卻搞不清楚背後原因。其實，選擇權的權利金是由兩部分組成：一是「內含價值」，另一就是「時間價值」。內含價值是選擇權立即履約能賺到的錢，例如買進一張履約價 100 元的買權，若標的物市價 105 元，內含價值就是 5 元。\"}],[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"內含價值：當選擇權履約價有利可圖時的價值，例如買權的履約價低於標的市價，或賣權的履約價高於標的市價。\"}],[\"$\",\"li\",\"1\",{\"children\":\"時間價值：權利金扣除內含價值後的剩餘部分，代表了選擇權在未來有利可圖的「潛力」。\"}]]}],[\"$\",\"div\",\"2\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"選擇權類型\"}],[\"$\",\"th\",\"1\",{\"children\":\"內含價值計算方式\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"買權 (Call)\"}],[\"$\",\"td\",\"1\",{\"children\":\"標的市價 – 履約價 (若為負則為 0)\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"賣權 (Put)\"}],[\"$\",\"td\",\"1\",{\"children\":\"履約價 – 標的市價 (若為負則為 0)\"}]]}]]}]]}]}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、時間價值衰減的元兇：Theta 值是什麼？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"理解了時間價值，下一步就是要認識它的衰減速度。在選擇權的希臘字母中，有一個專門衡量時間價值衰減速度的指標，叫做「Theta 值」。Theta 值代表著，在其他條件不變的情況下，每過一天，選擇權的權利金會因為時間流逝而減少多少。\"}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、時間價值衰減的 3 大關鍵因素：距離到期日、價內外與波動率\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"時間價值並非每天以固定速度衰減，它受到多重因素影響。其中，距離到期日、選擇權的價內外狀態，以及市場的預期波動率，是影響時間價值衰減速度最主要的三個關鍵。了解這些因素如何作用，能幫助你更好地判斷權利金的變化趨勢。\"}],\"$L18\",\"$L19\"]]}],\"$L1a\",\"$L1b\",\"$L1c\",\"$L1d\",\"$L1e\"],null]}]]}]}]\n18:[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"距離到期日：距離到期日越近，時間價值衰減的速度會越快，尤其在最後一個月會呈加速狀態。\"}],[\"$\",\"li\",\"1\",{\"children\":\"價內外程度：價平（ATM）選擇權的時間價值通常最高，也衰減得最快；價外（OTM）選擇權雖然權利金較低，但其時間價值佔比高，衰減速度也不容小覷。\"}],[\"$\",\"li\",\"2\",{\"children\":\"預期波動率：市場預期波動率越高，選擇權未來出現大漲大跌的機率越大，時間價值也會隨之上升；反之，波動率下降則會加速時間價值衰減。\"}]]}]\n19:[\"$\",\"figure\",\"2\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"!距離到期日!價內外程度!預期波動率\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"時間價值衰減速度\"}]]}]\n1a:[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、時間價值怎麼算？情境範例帶你看懂變化\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"假設現在有一檔標的股票價格為 100 元，你買進一張履約價 100 元、距離到期日還有 30 天的買權。這張買權目前的權利金是 5 元。由於履約價與標的價格相同，它的內含價值為 0 元，所以 5 元全部都是時間價值。如果這張買權的 Theta 值是 -0.1，這表示在其他條件不變下，每過一天，權利金會減少 0.1 元。\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"距離到期日\"}],[\"$\",\"th\",\"1\",{\"children\":\"時間價值 (假設Theta -0.1)\"}],[\"$\",\"th\",\"2\",{\"children\":\"權利金 (假設內含價值不變)\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"30 天\"}],[\"$\",\"td\",\"1\",{\"children\":\"5.0 元\"}],[\"$\",\"td\",\"2\",{\"children\":\"5.0 元\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"29 天\"}],[\"$\",\"td\",\"1\",{\"children\":\"4.9 元\"}],[\"$\",\"td\",\"2\",{\"children\":\"4.9 元\"}]]}],[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"28 天\"}],[\"$\",\"td\",\"1\",{\"children\":\"4.8 元\"}],[\"$\",\"td\",\"2\",{\"children\":\"4.8 元\"}]]}]]}]]}]}]]]}]\n1b:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、常見誤讀：時間價值衰減只影響買方嗎？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"許多人誤以為時間價值的衰減只對選擇權買方不利，因為買方支付權利金，時間流逝會讓權利金價值縮水。然而，時間價值衰減對選擇權賣方來說卻是獲利來源之一。賣方收取權利金，只要標的價格沒有觸及履約價，時間價值衰減就意味著賣方持有的部位價值減少，最終可能使賣方獲利。\"}]]]}]\n1c:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"時間價值衰減是好是壞？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"對選擇權買方來說，時間價值衰減是成本；對選擇權賣方來說，時間價值衰減則是潛在的獲利來源。它本身沒有好壞，端看你在交易中扮演買方還是賣方。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"怎麼查詢選擇權的時間價值？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"你可以透過選擇權報價軟體或券商提供的交易平台，查看權利金、履約價與標的價格。將權利金扣除內含價值後，剩餘的部分就是時間價值。某些平台也會直接顯示 Theta 值供參考。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"價外選擇權的時間價值為何特別高？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"價外選擇權的內含價值為零，因此其權利金的每一分錢都是時間價值。這代表它完全仰賴未來標的價格變動的潛力，一旦到期仍是價外，權利金就會歸零。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"時間價值衰減會加速嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"是的，時間價值衰減的速度會隨著距離到期日越近而加速，尤其在最後一個月，衰減速度會變得非常劇烈。這是因為選擇權在短時間內變成價內的機率快速降低。\"}]]}]]}]]]}]\n1d:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"選擇權的時間價值是權利金的重要組成，它會隨著時間流逝而衰減，尤其在到期前加速。理解 Theta 值、距離到期日、價內外程度及預期波動率這三大因素，能幫助你更清晰地判斷權利金的變化邏輯。\"}]]]}]\n1e:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L17\",\"0-更多台股籌碼分析\",{\"href\":\"/school\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"更多台股籌碼分析教學\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L17\",\"0-查詢今日台股戰情\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"查詢今日台股戰情\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L17\",\"0-認識選擇權希臘字\",{\"href\":\"/learn\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"認識選擇權希臘字母\"}]]}]]}]]]}]\n13:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\nf:null\n1f:I[80622,[],\"IconMark\"]\n11:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"選擇權時間價值怎麼衰減？3 大關鍵因素，別讓權利金白白蒸發｜股市大佬 TradeBoss\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"買了選擇權，權利金卻一直縮水？這篇文章將拆解時間價值衰減的秘密，帶你搞懂三大關鍵因素，不再困惑於數字變化。\"}],[\"$\",\"link\",\"2\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}],[\"$\",\"$L1f\",\"3\",{}]],\"error\":null,\"digest\":\"$undefined\"}\n16:\"$11:metadata\"\n"}