l\\\",null,{\\\"className\\\":\\\"LearnArticle_tldrList__VSc2_\\\",\\\"children\\\":[[\\\"$\\\",\\\"li\\\",\\\"0\\\",{\\\"children\\\":\\\"大盤指數上漲，氣氛偏多。\\\"}],[\\\"$\\\",\\\"li\\\",\\\"1\\\",{\\\"children\\\":\\\"數位雲端與創新版類股表現強勢。\\\"}],[\\\"$\\\",\\\"li\\\",\\\"2\\\",{\\\"children\\\":\\\"聯電漲停，大立光跌停。\\\"}],[\\\"$\\\",\\\"li\\\",\\\"3\\\",{\\\"children\\\":\\\"外資現貨買超，台指期淨空單仍高。\\\"}]]}]]}],[[\\\"$\\\",\\\"section\\\",\\\"sec-1\\\",{\\\"id\\\":\\\"sec-1\\\",\\\"className\\\":\\\"LearnArticle_section__hLVjU\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"LearnArticle_h2__NmJ08\\\",\\\"children\\\":\\\"一、台股大盤今日表現：加權、櫃買指數同步上揚\\\"}],[[\\\"$\\\",\\\"p\\\",\\\"0\\\",{\\\"className\\\":\\\"LearnArticle_p__aZlQ1\\\",\\\"children\\\":\\\"2026年9月7日台股開盤後走勢強勁，加權指數終場上漲 774.20 點，漲幅達 1.66%，收在 47326.27 點。櫃買指數也呈現上漲格局，漲幅為 1.70%，收在 409.33 點。然而，上市股票漲跌家數顯示，上漲家數 381 家，下跌家數 547 家，平均漲跌幅為 -0.16%，整體個股表現分歧。\\\"}],[\\\"$\\\",\\\"div\\\",\\\"1\\\",{\\\"className\\\":\\\"LearnArticle_tblScroll__z9kbb\\\",\\\"children\\\":[\\\"$\\\",\\\"table\\\",null,{\\\"className\\\":\\\"LearnArticle_tbl__0yNgv\\\",\\\"children\\\":[[\\\"$\\\",\\\"thead\\\",null,{\\\"children\\\":[\\\"$\\\",\\\"tr\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"th\\\",\\\"0\\\",{\\\"children\\\":\\\"指數名稱\\\"}],[\\\"$\\\",\\\"th\\\",\\\"1\\\",{\\\"children\\\":\\\"今日收盤\\\"}],[\\\"$\\\",\\\"th\\\",\\\"2\\\",{\\\"children\\\":\\\"今日漲跌幅\\\"}]]}]}],[\\\"$\\\",\\\"tbody\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"tr\\\",\\\"0\\\",{\\\"children\\\":[[\\\"$\\\",\\\"td\\\",\\\"0\\\",{\\\"children\\\":\\\"加權指數\\\"}],[\\\"$\\\",\\\"td\\\",\\\"1\\\",{\\\"children\\\":\\\"47326.27\\\"}],[\\\"$\\\",\\\"td\\\",\\\"2\\\",{\\\"children\\\":\\\"+1.66%\\\"}]]}],[\\\"$\\\",\\\"tr\\\",\\\"1\\\",{\\\"children\\\":[[\\\"$\\\",\\\"td\\\",\\\"0\\\",{\\\"children\\\":\\\"櫃買指數\\\"}],[\\\"$\\\",\\\"td\\\",\\\"1\\\",{\\\"children\\\":\\\"409.33\\\"}],[\\\"$\\\",\\\"td\\\",\\\"2\\\",{\\\"children\\\":\\\"+1.70%\\\"}]]}],[\\\"$\\\",\\\"tr\\\",\\\"2\\\",{\\\"children\\\":[[\\\"$\\\",\\\"td\\\",\\\"0\\\",{\\\"children\\\":\\\"台指期\\\"}],[\\\"$\\\",\\\"td\\\",\\\"1\\\",{\\\"children\\\":\\\"47470.0\\\"}],[\\\"$\\\",\\\"td\\\",\\\"2\\\",{\\\"children\\\":\\\"+1.64%\\\"}]]}]]}]]}]}]]]}],[\\\"$\\\",\\\"section\\\",\\\"sec-2\\\",{\\\"id\\\":\\\"sec-2\\\",\\\"className\\\":\\\"LearnArticle_section__hLVjU\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"LearnArticle_h2__NmJ08\\\",\\\"children\\\":\\\"二、盤面族群表現：數位雲端與創新版領漲\\\"}],[[\\\"$\\\",\\\"p\\\",\\\"0\\\",{\\\"className\\\":\\\"LearnArticle_p__aZlQ1\\\",\\\"children\\\":\\\"今日盤面上，部分族群表現相對強勢，其中數位雲端類股漲幅達 1.92%，該族群有 3 檔股票，由 6870 騰雲領漲。創新版股票也表現不俗，漲幅為 1.29%，該族群有 12 檔股票，由 2254 巨鎧精密-創領漲。此外，ETF 與電子商務業也呈現上漲格局。\\\"}],[\\\"$\\\",\\\"ol\\\",\\\"1\\\",{\\\"className\\\":\\\"LearnArticle_listNum__86N5S\\\",\\\"children\\\":[[\\\"$\\\",\\\"li\\\",\\\"0\\\",{\\\"children\\\":\\\"數位雲端類：上漲 1.92%，其中 6870 騰雲為領漲股。\\\"}],[\\\"$\\\",\\\"li\\\",\\\"1\\\",{\\\"children\\\":\\\"創新版股票：上漲 1.29%，其中 2254 巨鎧精密-創為領漲股。\\\"}],[\\\"$\\\",\\\"li\\\",\\\"2\\\",{\\\"children\\\":\\\"ETF：上漲 0.97%，其中 0050 元大台灣50為領漲股。\\\"}],[\\\"$\\\",\\\"li\\\",\\\"3\\\",{\\\"children\\\":\\\"電子商務業：上漲 0.97%，其中 8472 夠麻吉為領漲股。\\\"}],[\\\"$\\\",\\\"li\\\",\\\"4\\\",{\\\"children\\\":\\\"居家生活類：下跌 2.29%。\\\"}],[\\\"$\\\",\\\"li\\\",\\\"5\\\",{\\\"children\\\":\\\"橡膠工業：下跌 1.13%。\\\"}],[\\\"$\\\",\\\"li\\\",\\\"6\\\",{\\\"children\\\":\\\"造紙工業：下跌 1.10%。\\\"}],[\\\"$\\\",\\\"li\\\",\\\"7\\\",{\\\"children\\\":\\\"電器電纜：下跌 0.95%。\\\"}]]}]]]}],[\\\"$\\\",\\\"section\\\",\\\"sec-3\\\",{\\\"id\\\":\\\"sec-3\\\",\\\"className\\\":\\\"LearnArticle_section__hLVjU\\\",\\\"children\\\":[\\\"$L18\\\",[\\\"$L19\\\",\\\"$L1a\\\",\\\"$L1b\\\"]]}],\\\"$L1c\\\",\\\"$L1d\\\",\\\"$L1e\\\",\\\"$L1f\\\",\\\"$L20\\\"],null]}]]}]}]\\n\"])</script><script>self.__next_f.push([1,\"18:[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"LearnArticle_h2__NmJ08\\\",\\\"children\\\":\\\"三、個股表現回顧：聯電漲停、大立光跌停\\\"}]\\n19:[\\\"$\\\",\\\"p\\\"