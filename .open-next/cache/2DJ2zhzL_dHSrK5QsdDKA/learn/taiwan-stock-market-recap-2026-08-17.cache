],[\"$\",\"li\",\"3\",{\"children\":\"外資現貨買超，台指期淨空單仍維持高位。\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、大盤概況與指數表現\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"今日台股加權指數收盤小幅上漲，而代表中小型股的櫃買指數則呈現下跌。上市股票上漲家數多於下跌家數，顯示市場內部分歧。整體成交金額約8990.0億元，顯示市場仍有一定交易熱度。\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"指數名稱\"}],[\"$\",\"th\",\"1\",{\"children\":\"今日收盤\"}],[\"$\",\"th\",\"2\",{\"children\":\"漲跌幅\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"加權指數\"}],[\"$\",\"td\",\"1\",{\"children\":\"45857.27\"}],[\"$\",\"td\",\"2\",{\"children\":\"+0.10%\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"櫃買指數\"}],[\"$\",\"td\",\"1\",{\"children\":\"398.32\"}],[\"$\",\"td\",\"2\",{\"children\":\"-0.65%\"}]]}],[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"台指期\"}],[\"$\",\"td\",\"1\",{\"children\":\"45924.0\"}],[\"$\",\"td\",\"2\",{\"children\":\"+0.12%\"}]]}]]}]]}]}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、族群類股強弱分析\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"今日盤面類股表現呈現多空分歧，部分傳產與電子族群領漲。造紙工業、數位雲端、航運業及光電業表現相對強勢，其中不乏個股有明顯漲幅。然而，創新板股票、金融業、運動休閒及玻璃陶瓷等族群則呈現下跌。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"偏強族群：造紙工業 (+1.85%)，領漲股為1909榮成。\"}],[\"$\",\"li\",\"1\",{\"children\":\"偏強族群：數位雲端類 (+1.61%)，領漲股為8932智通*。\"}],[\"$\",\"li\",\"2\",{\"children\":\"偏強族群：航運業 (+1.33%)，領漲股為2615萬海。\"}],[\"$\",\"li\",\"3\",{\"children\":\"偏強族群：光電業 (+1.29%)，領漲股為3455由田。\"}],[\"$\",\"li\",\"4\",{\"children\":\"偏弱族群：創新板股票 (-2.29%)。\"}],[\"$\",\"li\",\"5\",{\"children\":\"偏弱族群：金融業 (-1.40%)。\"}],[\"$\",\"li\",\"6\",{\"children\":\"偏弱族群：運動休閒 (-1.16%)。\"}],[\"$\",\"li\",\"7\",{\"children\":\"偏弱族群：玻璃陶瓷 (-1.04%)。\"}]]}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、個股表現與當沖熱門\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"今日上市個股漲跌幅分化，多檔股票出現漲停或接近漲停的表現，同時也有多檔股票跌幅較大。在當沖交易方面，部分個股成交量相對平日有顯著放大，顯示市場資金的關注度。\"}],[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"今日漲幅較大的股票包括：2059川湖 (+10.00%)、6141柏承 (+10.00%)、1727中華化 (+9.99%)、3653健策 (+9.99%)、3008大立光 (+9.98%)、2615萬海 (+9.93%)。\"}],\"$L18\",\"$L19\"]}],\"$L1a\"]]}],\"$L1b\",\"$L1c\",\"$L1d\",\"$L1e\",\"$L1f\"],null]}]]}]}]\n18:[\"$\",\"li\",\"1\",{\"children\":\"今日跌幅較大的股票包括：2376技嘉 (-9.94%)、8105凌巨 (-9.85%)、2493揚博 (-9.65%)、2645長榮航太 (-9.00%)、2425承啟 (-7.42%)、6753龍德造船 (-6.96%)。\"}]\n19:[\"$\",\"li\",\"2\",{\"children\":\"當沖交易熱門且量比（成交量相對平日放大倍數）較高的股票有：崇越電 (量比 13.9x, +9.89%)、精誠 (量比 10.2x, +2.03%)、TLC-KY (量比 7.9x, +15.00%)、正崴 (量比 7.9x, +0.58%)、中環 (量比 6.6x, +3.54%)、倫飛 (量比 6.4x, +8.77%)。\"}]\n1a:[\"$\",\"figure\",\"2\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"!外資買超!期貨空單!國際盤震盪!個股分歧\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"留意市場動態\"}]]}]\n1b:[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、法人動向與市場籌碼\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"今日外資在現貨市場呈現買超，自營商也同步買超。然而，外資在台指期貨市場的淨空單部位仍維持在較高水平。全市場的融資維持率顯示整體市場的信用交易狀況。\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"項目\"}],[\"$\",\"th\",\"1\",{\"children\":\"今日數據\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"外資現貨買賣超\"}],[\"$\",\"td\",\"1\",{\"children\":\"約 569,871 張 (買超)\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"自營商現貨買賣超\"}],[\"$\",\"td\",\"1\",{\"children\":\"約 413,731 張 (買超)\"}]]}],[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"外資台指期淨空單\"}],[\"$\",\"td\",\"1\",{\"children\":\"83,474 口\"}]]}],[\"$\",\"tr\",\"3\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"全市場融資維持率\"}],[\"$\",\"td\",\"1\",{\"children\":\"194.1%\"}]]}]]}]]}]}]]]}]\n1c:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、國際盤勢與外部消息\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"今日主要國際股市表現呈現漲跌互見，美股三大指數微幅下跌，而亞洲市場的韓國綜合指數與日經225指數則呈現上漲。此外，近期國際上關於美國前總統川普的政策與中國議題仍有相關討論，這些外部消息可能影響市場情緒。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"國際主要指數：S&P 500 -0.17%、那斯達克 -0.28%、費城半導體 -0.31%。\"}],[\"$\",\"li\",\"1\",{\"children\":\"亞洲主要指數：韓國綜合（KOSPI）+2.42%、日經 225 +0.74%。\"}],[\"$\",\"li\",\"2\",{\"children\":\"近三日川普／美國政策相關標題：「川普關稅退還逾百億美元 振興經濟」、「參議員低調團結推動川普特赦與中國議題」、「中國希望川普鋪紅毯並屈服」。\"}]]}]]]}]\n1d:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"今天台股整體表現如何？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"2026年8月17日，台股加權指數小漲0.10%，收在45857.27點，而櫃買指數則下跌0.65%，收盤為398.32點。上市股票上漲家數多於下跌家數，顯示市場內部有分歧。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"哪些產業族群今天表現比較好？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"今日表現相對強勢的族群包括造紙工業、數位雲端類、航運業和光電業。其中，造紙工業上漲1.85%，航運業上漲1.33%，都有個股領漲。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"外資今天在台股做了什麼？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"外資在現貨市場買超約569,871張。在台指期貨方面，外資的淨空單部位為83,474口，維持在較高水平。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"國際股市對台股有影響嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"今日美國主要指數如S&P 500、那斯達克和費城半導體均呈現微幅下跌。亞洲市場則有韓國綜合指數上漲2.42%和日經225指數上漲0.74%，國際盤勢呈現漲跌互見的格局。\"}]]}]]}]]]}]\n1e:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"今日台股加權指數微幅上漲，櫃買指數則小幅回檔。盤面呈現類股輪動，部分傳產與電子族群表現活絡，而金融與創新板則相對承壓。\"}]]]}]\n1f:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L17\",\"0-台股學堂\",{\"href\":\"/school\",\"className\":\"LearnArticle_link__gMwHV\",\"children