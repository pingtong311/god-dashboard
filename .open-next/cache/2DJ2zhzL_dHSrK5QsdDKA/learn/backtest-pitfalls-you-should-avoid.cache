\"$L13\"}],[\"$\",\"meta\",null,{\"name\":\"next-size-adjust\",\"content\":\"\"}]],[\"$\",\"$L14\",null,{\"children\":[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$15\",null,{\"fallback\":null,\"children\":\"$L16\"}]}]}]]}]\n17:I[52619,[\"2619\",\"static/chunks/2619-04bc32f026a0d946.js\",\"6309\",\"static/chunks/app/learn/%5Bslug%5D/page-f7b99344f7e2ee16.js\"],\"\"]\nd:[\"$\",\"div\",null,{\"className\":\"LearnArticle_wrap__LIQ8G\",\"children\":[\"$\",\"article\",null,{\"className\":\"LearnArticle_article__2nBbk\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_meta__etj_G\",\"children\":[[\"$\",\"$L17\",null,{\"className\":\"LearnArticle_cat__GQMlg\",\"href\":\"/learn?c=strategy\",\"children\":\"策略解析\"}],[\"$\",\"span\",null,{\"className\":\"LearnArticle_read__QEj6a\",\"children\":\"閱讀約 4 分鐘\"}]]}],[\"$\",\"h1\",null,{\"className\":\"LearnArticle_title__0_la8\",\"children\":\"策略回測要避開哪3個坑？曲線漂亮通常代表什麼\"}],[\"$\",\"details\",null,{\"className\":\"LearnArticle_toc__LcSAa\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"LearnArticle_tocSummary__YBddG\",\"children\":\"本文目錄\"}],[\"$\",\"ol\",null,{\"className\":\"LearnArticle_tocList__Rq_Lz\",\"children\":[[\"$\",\"li\",\"sec-1\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-1\",\"children\":\"一、回測回答的是「過去這樣做會怎樣」\"}]}],[\"$\",\"li\",\"sec-2\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-2\",\"children\":\"二、坑一：成本與滑價被當成零\"}]}],[\"$\",\"li\",\"sec-3\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-3\",\"children\":\"三、坑二：樣本內調到完美，樣本外立刻歪\"}]}],[\"$\",\"li\",\"sec-4\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-4\",\"children\":\"四、坑三：忽略失效與相關性\"}]}],[\"$\",\"li\",\"sec-5\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-5\",\"children\":\"五、回測能做的最小用途\"}]}],[\"$\",\"li\",\"sec-6\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-6\",\"children\":\"常見問題 FAQ\"}]}],[\"$\",\"li\",\"sec-7\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-7\",\"children\":\"總結\"}]}],[\"$\",\"li\",\"sec-8\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-8\",\"children\":\"延伸閱讀\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"LearnArticle_body__6B7Mb\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_intro__ATV5c\",\"children\":\"第一次做出一條往右上的權益曲線，很多人會以為自己找到方法了。比較常發生的是：你找到一套很會解釋過去的參數。回測有用，但它預設了很多現實裡不成立的事：成交價夠好、成本夠低、未來長得像過去。這篇只講坑，不給你一條可以照抄的曲線。\"}],[[\"$\",\"figure\",\"figure-0\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"虧 3 次每次 −1%賺 2 次每次 +1%勝率 40% 也可能是正期望，前提是賺的比虧的大、且扣得起成本短線先扣約 0.24% 當沖成本，再看還剩多少\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"示意圖｜期望值：勝率要配上平均賺賠，再扣成本（教學結構，不是某檔實盤）\"}]]}]],[\"$\",\"div\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"漂亮曲線優先當可疑，不當證明\"}],[\"$\",\"li\",\"1\",{\"children\":\"沒扣成本、沒留樣本外，結果通常偏樂觀\"}],[\"$\",\"li\",\"2\",{\"children\":\"參數調到只適合某一段歷史，叫過度配適，不叫優化\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、回測回答的是「過去這樣做會怎樣」\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"它不回答「明天這樣做會怎樣」。這句話聽起來像廢話，實務上最常被跳過。你看到的是一條已經知道答案的線。線愈漂亮，愈要問：這條線用了多少事後才知道的資訊？有沒有用到當時看不到的價、當時走不到的量、當時還沒公布的財報？\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"回測是過去的成績單\"}],[\"$\",\"li\",\"1\",{\"children\":\"成績單不能當入場券\"}],[\"$\",\"li\",\"2\",{\"children\":\"先問用了哪些當時看不到的資訊\"}]]}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、坑一：成本與滑價被當成零\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"手續費、交易稅、買賣價差、大單自己推價，都會吃掉紙上獲利。短週期策略尤其敏感：看起來一天賺一點，扣完成本可能是零或負。回測若用收盤價當成交、又不扣費用，你測到的是一個不存在的市場。先把成本設得比較醜，再看曲線還在不在。\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"回測常假設\"}],[\"$\",\"th\",\"1\",{\"children\":\"現實比較常是\"}],[\"$\",\"th\",\"2\",{\"children\":\"先怎麼處理\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"收盤價成交\"}],[\"$\",\"td\",\"1\",{\"children\":\"流動性差時走不到\"}],[\"$\",\"td\",\"2\",{\"children\":\"用較差的成交假設\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"零成本\"}],[\"$\",\"td\",\"1\",{\"children\":\"稅費與價差都在\"}],[\"$\",\"td\",\"2\",{\"children\":\"先扣醜一點的成本\"}]]}],[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"隨時進出\"}],[\"$\",\"td\",\"1\",{\"children\":\"漲跌停與處置會卡住\"}],[\"$\",\"td\",\"2\",{\"children\":\"把不能交易的日子標出來\"}]]}],[\"$\",\"tr\",\"3\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"部位無限可加\"}],[\"$\",\"td\",\"1\",{\"children\":\"胃納量有上限\"}],[\"$\",\"td\",\"2\",{\"children\":\"用你真的做得到的張數\"}]]}]]}]]}]}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、坑二：樣本內調到完美，樣本外立刻歪\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"同一段資料又拿來調參數、又拿來報成績，等於考試先看答案。比較老實的做法是：前面一段只准調，後面一段不准再碰，只准看一次。若後面一段垮掉，前面的漂亮就只是配適。參數愈多、條件愈細，愈容易只記住一段行情的口音。\"}],\"$L18\",\"$L19\"]]}],\"$L1a\",\"$L1b\",\"$L1c\",\"$L1d\",\"$L1e\"],\"$L1f\"]}]]}]}]\n18:[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"先切一段不准再調的資料\"}],[\"$\",\"li\",\"1\",{\"children\":\"只看一次樣本外\"}],[\"$\",\"li\",\"2\",{\"children\":\"垮了就承認是配適，不要再微調到它變漂亮\"}]]}]\n19:[\"$\",\"figure\",\"2\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"✓先扣醜成本✓留一段不調✓寫何時停用\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"最小誠實\"}]]}]\n1a:[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、坑三：忽略失效與相關性\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"策略會過期。市場結構、參與者、規則都會變。回測沒告訴你它什麼時候該停。另外，你若同時看很多條曲線，再挑最漂亮的那條，等於做了很多次考試只公布最高分。多策略看起來分散，若賺的是同一種行情，回撤仍會疊在一起。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"先寫失效條件，再看曲線\"}],[\"$\",\"li\",\"1\",{\"children\":\"多條策略要問是不是同一種行情\"}],[\"$\",\"li\",\"2\",{\"children\":\"最高分通常含選擇偏差\"}]]}]]]}]\n1b:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、回測能做的最小用途\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"它比較適合拿來否定：這套規則在過去就活不下去，現在更不必認真。它比較不適合拿來肯定：過去活得很好，所以現在可以放大。否定用回測，肯定用小部位與時間。紙上交易是另一層，因為它至少碰到你的手，不只碰到程式。\"}]]]}]\n1c:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"曲線穩不代表可以用嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"穩只代表那段歷史被解釋得很好。沒有成本、樣本外與失效條件，穩仍可能是假的。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"要多少筆交易才夠？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"沒有魔法數字。筆數太少，勝率會跳。重點是樣本能不能代表你真正會遇到的市況，不是湊滿某個整數。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"用日線是不是比較沒坑？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"日線成本敏感度較低，仍有未來函數與過度配適。週期不自動等於誠實。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"和紙上交易差在哪？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"回測是機器走完已知歷史；紙上是你用當下資訊做決定。兩者都偏樂觀，但坑不一樣。\"}]]}]]}]]]}]\n1d:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"回測先拿來否定，不拿來證明。成本、樣本外、失效條件三個坑沒補，漂亮曲線多半只是很會解釋過去。\"}]]]}]\n1e:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L17\",\"0-策略失效怎麼判斷\",{\"href\":\"/learn/how-to-tell-if-a-strategy-is-broken\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"策略失效怎麼判斷\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L17\",\"0-最大回撤是什麼\",{\"href\":\"/learn/what-max-drawdown-really-means\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"最大回撤是什麼\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L17\",\"0-期望值怎麼算\",{\"href\":\"/learn/what-is-expectancy-in-trading\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"期望值怎麼算\"}]]}]]}]]]}]\n1f:[\"$\",\"div\",null,{\"className\":\"LearnArticle_related__9qV55\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_relatedTitle__RXfrl\",\"children\":\"相關文章\"}],[[\"$\",\"$L17\",\"how-to-tell-if-a-strategy-is-broken\",{\"href\":\"/learn/how-to-tell-if-a-strategy-is-broken\",\"className\":\"LearnArticle_relatedLink__mibXe\",\"children\":\"策略失效怎麼判斷\"}],[\"$\",\"$L17\",\"what-max-drawdown-really-means\",{\"href\":\"/learn/what-max-drawdown-really-means\",\"className\":\"LearnArticle_relatedLink__mibXe\",\"children\":\"最大回撤是什麼\"}],[\"$\",\"$L17\",\"what-is-expectancy-in-trading\",{\"href\":\"/learn/what-is-expectancy-in-trading\",\"className\":\"LearnArticle_relatedLink__mibXe\",\"children\":\"期望值怎麼算\"}]]]}]\n13:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\nf:null\n20:I[80622,[],\"IconMark\"]\n11:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"策略回測要避開哪3個坑？曲線漂亮通常代表什麼｜股市大佬 TradeBoss\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"第一次做出一條往右上的權益曲線，很多人會以為自己找到方法了。比較常發生的是：你找到一套很會解釋過去的參數。回測有用，但它預設了很多現實裡不成立的事：成交價夠好、成本夠低、未來長得像過去。這篇只講坑，不給你一條可以照抄的曲線。\"}],[\"$\",\"link\",\"2\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}],[\"$\",\"$L20\",\"3\",{}]],\"error\":null,\"digest\":\"$undefined\"}\n16:\"$11:metadata\"\n"}