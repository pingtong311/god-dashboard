\"}]],[\"$\",\"$L14\",null,{\"children\":[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$15\",null,{\"fallback\":null,\"children\":\"$L16\"}]}]}]]}]\n17:I[52619,[\"2619\",\"static/chunks/2619-04bc32f026a0d946.js\",\"6309\",\"static/chunks/app/learn/%5Bslug%5D/page-f7b99344f7e2ee16.js\"],\"\"]\nd:[\"$\",\"div\",null,{\"className\":\"LearnArticle_wrap__LIQ8G\",\"children\":[\"$\",\"article\",null,{\"className\":\"LearnArticle_article__2nBbk\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_meta__etj_G\",\"children\":[[\"$\",\"$L17\",null,{\"className\":\"LearnArticle_cat__GQMlg\",\"href\":\"/learn?c=rules\",\"children\":\"制度與工具\"}],[\"$\",\"span\",null,{\"className\":\"LearnArticle_read__QEj6a\",\"children\":\"閱讀約 4 分鐘\"}]]}],[\"$\",\"h1\",null,{\"className\":\"LearnArticle_title__0_la8\",\"children\":\"台股期貨和現股差在哪？3個機制決定風險長相\"}],[\"$\",\"details\",null,{\"className\":\"LearnArticle_toc__LcSAa\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"LearnArticle_tocSummary__YBddG\",\"children\":\"本文目錄\"}],[\"$\",\"ol\",null,{\"className\":\"LearnArticle_tocList__Rq_Lz\",\"children\":[[\"$\",\"li\",\"sec-1\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-1\",\"children\":\"一、你買到的東西不一樣\"}]}],[\"$\",\"li\",\"sec-2\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-2\",\"children\":\"二、保證金改變的是誰能叫你走\"}]}],[\"$\",\"li\",\"sec-3\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-3\",\"children\":\"三、到期與轉倉是第三層成本\"}]}],[\"$\",\"li\",\"sec-4\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-4\",\"children\":\"四、小型契約只是把名目切小，不是把風險切掉\"}]}],[\"$\",\"li\",\"sec-5\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-5\",\"children\":\"五、什麼時候不該用期貨去表達現股想法\"}]}],[\"$\",\"li\",\"sec-6\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-6\",\"children\":\"常見問題 FAQ\"}]}],[\"$\",\"li\",\"sec-7\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-7\",\"children\":\"總結\"}]}],[\"$\",\"li\",\"sec-8\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-8\",\"children\":\"延伸閱讀\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"LearnArticle_body__6B7Mb\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_intro__ATV5c\",\"children\":\"有人把期貨當成「比較快的股票」，有人把股票當成「比較慢的期貨」。兩邊都用錯比喻。現股買的是公司股份；指數期貨買的是對指數的契約。錢怎麼放、誰能叫你走、契約會不會到期，三件事就不一樣。機制先對，方向再談都還來得及；機制錯了，方向對也可能先被抬出場。\"}],[[\"$\",\"figure\",\"figure-0\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"沒扣成本的勝率，看起來都會比較漂亮0.029%手續費 1 折來回0.15%當沖證交稅0.06%滑價估計三項合計約 0.24%；留倉稅率更高，約 0.39%\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"示意圖｜當沖來回成本：1 折手續費 + 證交稅 + 滑價（教學結構，不是某檔實盤）\"}]]}]],[\"$\",\"div\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"期貨是契約，現股是股份，標的感覺像，法律與現金流不像\"}],[\"$\",\"li\",\"1\",{\"children\":\"保證金讓你用較少現金控制較大名目，回撤會先變成追繳\"}],[\"$\",\"li\",\"2\",{\"children\":\"到期與每日結算，會逼你處理現股可以拖的問題\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、你買到的東西不一樣\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"現股是股東權利的一部分，有股利、有股東會、有公司本身的故事。指數期貨是對指數的約定，到期用結算價對價，沒有配息那種股東體驗。股票期貨則是對單一股票的契約，仍不是股份。把契約當股份抱，會漏掉到期、轉倉與沒有股東權這三件事。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"現股：股份與公司權利\"}],[\"$\",\"li\",\"1\",{\"children\":\"指數期貨：對指數的契約\"}],[\"$\",\"li\",\"2\",{\"children\":\"股票期貨：對個股的契約，仍不是股票\"}]]}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、保證金改變的是誰能叫你走\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"期貨用保證金，名目可以比帳戶大很多。價格反向時，不是「再等一等」這麼簡單，可能先收到追繳。現股用自己的錢買，帳面可以熬；用信用買，又比較接近被叫走的世界。所以「我看得比較長」所以做期貨，句子本身就打架：工具的時間尺度跟你的故事尺度不合。\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"項目\"}],[\"$\",\"th\",\"1\",{\"children\":\"現股常見\"}],[\"$\",\"th\",\"2\",{\"children\":\"期貨常見\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"你持有的\"}],[\"$\",\"td\",\"1\",{\"children\":\"股份\"}],[\"$\",\"td\",\"2\",{\"children\":\"契約\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"資金型態\"}],[\"$\",\"td\",\"1\",{\"children\":\"全額或信用\"}],[\"$\",\"td\",\"2\",{\"children\":\"保證金\"}]]}],[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"時間\"}],[\"$\",\"td\",\"1\",{\"children\":\"股票不到期\"}],[\"$\",\"td\",\"2\",{\"children\":\"契約會到期、要轉倉\"}]]}],[\"$\",\"tr\",\"3\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"反向時\"}],[\"$\",\"td\",\"1\",{\"children\":\"帳面或信用追繳\"}],[\"$\",\"td\",\"2\",{\"children\":\"每日結算與追繳較敏感\"}]]}]]}]]}]}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、到期與轉倉是第三層成本\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"想把看法拉長，期貨就要換下一個到期月份，中間有價差與手續費。現股沒有這層。很多人只算點數對不對，不算轉倉累積。看起來只是換月，實際上是持續付維持看法的租金。租金不算進檢討，會以為是自己看錯方向。\"}],\"$L18\",\"$L19\"]]}],\"$L1a\",\"$L1b\",\"$L1c\",\"$L1d\",\"$L1e\"],\"$L1f\"]}]]}]}]\n18:[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"先問看法要放多久\"}],[\"$\",\"li\",\"1\",{\"children\":\"再問要轉幾次倉\"}],[\"$\",\"li\",\"2\",{\"children\":\"最後才問點數方不划算\"}]]}]\n19:[\"$\",\"figure\",\"2\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"!長期故事用短契約!小契約就多做幾口!只算點數不算租金\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"容器選錯時\"}]]}]\n1a:[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、小型契約只是把名目切小，不是把風險切掉\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"小型台指讓名目變小，門檻看起來友善。風險比例若一樣，只是用比較小的數字犯錯。它適合用來把部位放到你真的算得清楚的尺度，不適合用來「反正比較小就多做幾口」。工具變小，紀律要跟著變清楚，不是變鬆。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"小契約降低的是門檻，不是比例風險\"}],[\"$\",\"li\",\"1\",{\"children\":\"口數加總仍是名目\"}],[\"$\",\"li\",\"2\",{\"children\":\"先算總名目，再看口數\"}]]}]]]}]\n1b:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、什麼時候不該用期貨去表達現股想法\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"你的想法若是「這家公司幾年後會不一樣」，期貨通常是錯容器。你的想法若是「這段指數波動我要有規則地表達」，現股一籃子可能太慢、太貴。容器選錯，檢討會找錯犯人。這篇只幫你選容器，不幫你選方向。\"}]]]}]\n1c:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"期貨是不是比較適合當沖？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"成本與速度特性常被這樣用，但不自動比較適合你。適合與否看規則與你算不算得出追繳。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"做空是不是只能用期貨？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"現股有融券等工具，規則與成本不同。重點仍是你懂不懂誰能叫你走。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"小台是不是比較安全？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"名目較小，比例風險可以一樣大。安全要看總曝險，不看契約暱稱。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"現股配息、期貨沒有，怎麼比？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"不要用同一條報酬去比。一個含股東權利，一個是契約點數。先比機制，再比數字。\"}]]}]]}]]]}]\n1d:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"期貨是契約，現股是股份。保證金、到期與每日結算會改變誰能叫你走。先選對容器，再談看法。\"}]]]}]\n1e:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L17\",\"0-槓桿反向ETF不\",{\"href\":\"/learn/why-leveraged-inverse-etf-not-for-long-hold\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"槓桿反向ETF不適合長抱\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L17\",\"0-當沖是賭博嗎\",{\"href\":\"/learn/is-day-trading-gambling\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"當沖是賭博嗎\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L17\",\"0-部位大小怎麼回推\",{\"href\":\"/learn/how-to-size-your-position\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"部位大小怎麼回推\"}]]}]]}]]]}]\n1f:[\"$\",\"div\",null,{\"className\":\"LearnArticle_related__9qV55\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_relatedTitle__RXfrl\",\"children\":\"相關文章\"}],[[\"$\",\"$L17\",\"why-leveraged-inverse-etf-not-for-long-hold\",{\"href\":\"/learn/why-leveraged-inverse-etf-not-for-long-hold\",\"className\":\"LearnArticle_relatedLink__mibXe\",\"children\":\"槓桿反向ETF不適合長抱\"}],[\"$\",\"$L17\",\"is-day-trading-gambling\",{\"href\":\"/learn/is-day-trading-gambling\",\"className\":\"LearnArticle_relatedLink__mibXe\",\"children\":\"當沖是賭博嗎\"}],[\"$\",\"$L17\",\"how-to-size-your-position\",{\"href\":\"/learn/how-to-size-your-position\",\"className\":\"LearnArticle_relatedLink__mibXe\",\"children\":\"部位大小怎麼回推\"}]]]}]\n13:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\nf:null\n20:I[80622,[],\"IconMark\"]\n11:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"台股期貨和現股差在哪？3個機制決定風險長相｜股市大佬 TradeBoss\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"有人把期貨當成「比較快的股票」，有人把股票當成「比較慢的期貨」。兩邊都用錯比喻。現股買的是公司股份；指數期貨買的是對指數的契約。錢怎麼放、誰能叫你走、契約會不會到期，三件事就不一樣。機制先對，方向再談都還來得及；機制錯了，方向對也可能先被抬出場。\"}],[\"$\",\"link\",\"2\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}],[\"$\",\"$L20\",\"3\",{}]],\"error\":null,\"digest\":\"$undefined\"}\n16:\"$11:metadata\"\n"}