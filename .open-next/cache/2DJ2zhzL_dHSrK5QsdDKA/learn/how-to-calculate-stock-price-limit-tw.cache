cSAa\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"LearnArticle_tocSummary__YBddG\",\"children\":\"本文目錄\"}],[\"$\",\"ol\",null,{\"className\":\"LearnArticle_tocList__Rq_Lz\",\"children\":[[\"$\",\"li\",\"sec-1\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-1\",\"children\":\"一、為什麼要有漲跌停？這個 10% 的限制是在保護誰？\"}]}],[\"$\",\"li\",\"sec-2\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-2\",\"children\":\"二、漲停價和跌停價，到底怎麼算出來的？\"}]}],[\"$\",\"li\",\"sec-3\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-3\",\"children\":\"三、為什麼我算的數字，跟券商 App 上的不一樣？\"}]}],[\"$\",\"li\",\"sec-4\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-4\",\"children\":\"四、注意！這幾種情況，不是用昨收價來算漲跌停\"}]}],[\"$\",\"li\",\"sec-5\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-5\",\"children\":\"五、看到漲停或跌停，除了價格我還能看什麼？\"}]}],[\"$\",\"li\",\"sec-6\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-6\",\"children\":\"常見問題 FAQ\"}]}],[\"$\",\"li\",\"sec-7\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-7\",\"children\":\"總結\"}]}],[\"$\",\"li\",\"sec-8\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-8\",\"children\":\"延伸閱讀\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"LearnArticle_body__6B7Mb\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_intro__ATV5c\",\"children\":\"看到股票攻上漲停好興奮，或是跌停好緊張，但這個價格是怎麼算出來的？為什麼有時候不是剛好 10%？這篇文章會用簡單的算法，讓你以後自己就能快速心算漲停價和跌停價。\"}],[[\"$\",\"figure\",\"figure-0\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"沒扣成本的勝率，看起來都會比較漂亮0.029%手續費 1 折來回0.15%當沖證交稅0.06%滑價估計三項合計約 0.24%；留倉稅率更高，約 0.39%\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"示意圖｜當沖來回成本：1 折手續費 + 證交稅 + 滑價（教學結構，不是某檔實盤）\"}]]}]],[\"$\",\"div\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"台股漲跌幅以「前一天收盤價」為基準，上下各 10%。\"}],[\"$\",\"li\",\"1\",{\"children\":\"計算公式：漲停價 = 昨收 × 1.1；跌停價 = 昨收 × 0.9。\"}],[\"$\",\"li\",\"2\",{\"children\":\"價格計算後需「四捨五入」到交易所規定的最小單位，這就是尾數不同的原因。\"}],[\"$\",\"li\",\"3\",{\"children\":\"新上市、除權息等特殊情況，漲跌停的計算基準會改變，不是用前一天收盤價。\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、為什麼要有漲跌停？這個 10% 的限制是在保護誰？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"有時候會覺得 10% 的限制很礙事，但其實這個機制是為了保護市場上的所有人。它的主要目的是為市場「降溫」，避免股價在一天之內因為突發消息或恐慌情緒而出現極端的暴漲暴跌。這個緩衝機制給了投資人時間去消化資訊、冷靜思考，而不是在資訊不對稱的情況下做出衝動的決定，有助於維持市場的穩定。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"避免市場因消息面而過熱或恐慌\"}],[\"$\",\"li\",\"1\",{\"children\":\"讓投資人有時間冷靜消化資訊\"}],[\"$\",\"li\",\"2\",{\"children\":\"穩定金融市場的整體機制\"}]]}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、漲停價和跌停價，到底怎麼算出來的？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"計算漲跌停價的基礎，是「前一個交易日的收盤價」。規則很簡單，就是把昨天的收盤價乘以 1.1 就是今天的漲停價，乘以 0.9 就是跌停價。我們直接來看一個例子，你會發現非常簡單。\"}],[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"假設 A 公司昨天收盤價是 100 元。\"}],[\"$\",\"li\",\"1\",{\"children\":\"今天的漲停價就是：100 元 × 1.1 = 110 元。\"}],[\"$\",\"li\",\"2\",{\"children\":\"今天的跌停價就是：100 元 × 0.9 = 90 元。\"}],[\"$\",\"li\",\"3\",{\"children\":\"所以今天 A 公司的股價只會在 90 元到 110 元之間交易。\"}]]}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、為什麼我算的數字，跟券商 App 上的不一樣？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"你可能已經發現，有時候自己算的數字尾數會跟券商軟體上的不一樣。例如一支 55.3 元的股票，漲停價算出來是 60.83 元，但 App 卻顯示 60.8 元。這不是你算錯，而是因為台股有「最小升降單位」的規定，俗稱「檔位」。算出來的價格必須四捨五入到最接近的檔位價。\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":\"$L18\"}],\"$L19\"]}]}],\"$L1a\"]]}],\"$L1b\",\"$L1c\",\"$L1d\",\"$L1e\",\"$L1f\"],null]}]]}]}]\n18:[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"股價範圍\"}],[\"$\",\"th\",\"1\",{\"children\":\"最小升降單位（檔位）\"}]]}]\n19:[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"10 元以下\"}],[\"$\",\"td\",\"1\",{\"children\":\"0.01 元\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"10 元至 50 元以下\"}],[\"$\",\"td\",\"1\",{\"children\":\"0.05 元\"}]]}],[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"50 元至 100 元以下\"}],[\"$\",\"td\",\"1\",{\"children\":\"0.1 元\"}]]}],[\"$\",\"tr\",\"3\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"100 元至 500 元以下\"}],[\"$\",\"td\",\"1\",{\"children\":\"0.5 元\"}]]}],[\"$\",\"tr\",\"4\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"500 元至 1000 元以下\"}],[\"$\",\"td\",\"1\",{\"children\":\"1 元\"}]]}],[\"$\",\"tr\",\"5\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"1000 元以上\"}],[\"$\",\"td\",\"1\",{\"children\":\"5 元\"}]]}]]}]\n1a:[\"$\",\"figure\",\"2\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"!漲停不代表明天還會漲!跌停不代表公司出問題!別因漲跌停就情緒下單\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"漲跌停的常見迷思\"}]]}]\n1b:[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、注意！這幾種情況，不是用昨收價來算漲跌停\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"學會了基本算法後，還要知道有幾種特殊情況，計算的基準價並不是昨天的收盤價。如果沒注意到，你可能會對開盤後的價格走勢感到困惑。這些情況下，交易所會公布一個「開盤競價基準價」，並以此為基礎來計算當天的漲跌停。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"**除權息日**：計算基準是「除權息參考價」。例如昨收 100 元、配息 5 元，那今天的基準價就是 95 元，漲停是 95 x 1.1 = 104.5 元。\"}],[\"$\",\"li\",\"1\",{\"children\":\"**新股上市**：為了讓市場自由定價，新上市的普通股前五個交易日沒有漲跌幅限制。\"}],[\"$\",\"li\",\"2\",{\"children\":\"**減資後恢復交易**：會以減資後的「恢復買賣參考價」為基準計算，這個價格不等於減資前的收盤價。\"}],[\"$\",\"li\",\"3\",{\"children\":\"**TDR、部分 ETF**：有些特殊商品的漲跌幅規定不同，例如槓桿或反向型 ETF，交易前需要另外查詢公開說明書。\"}]]}]]]}]\n1c:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、看到漲停或跌停，除了價格我還能看什麼？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"學會計算價格只是第一步，更重要的是理解數字背後的意義。當你看到一檔股票漲停或跌停時，不要只被價格吸引，可以多觀察幾個指標，幫助你做出更全面的判斷，而不是因為市場氣氛就急著下決定。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"**觀察掛單量**：漲停時，看還有多少買單掛著買不到；跌停時，看還有多少賣單掛著賣不掉。這代表市場追價或拋售的力道有多強勁。\"}],[\"$\",\"li\",\"1\",{\"children\":\"**別只看單日表現**：一天的漲停或跌停不代表趨勢的全部。你可以到「股市大佬」的個股透視頁面，觀察這支股票過去的籌碼分佈和法人動向，判斷這股力道是否能持續。\"}],[\"$\",\"li\",\"2\",{\"children\":\"**避免情緒化交易**：看到漲停就想追進去，是人之常情，但也是常見的錯誤。複製別人的進出不一定適合你，應先建立自己的判斷標準。\"}]]}]]]}]\n1d:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"為什麼有些股票沒有漲跌幅限制？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"新上市的股票（IPO）掛牌後的前五個交易日沒有漲跌幅限制，主要是為了讓市場有足夠的價格發現期，讓買賣雙方自由尋找合理的價位。五天之後就會恢復為每日 10% 的限制。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"ETF 也有 10% 漲跌幅限制嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"大部分在台股交易的 ETF 都有 10% 漲跌幅限制。但如果是連結海外成分股的 ETF，例如期貨、槓桿或反向型，漲跌幅規定可能不同，需要看該檔 ETF 的公開說明書。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"股價漲停了，就一定買不到嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"不一定。如果漲停後有新的賣單掛出，按照掛單的先後順序還是有機會成交。但如果賣單很少、買單隊伍排得非常長（俗稱漲停鎖死），那確實很難買到。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"興櫃股票的漲跌幅怎麼算？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"興櫃股票沒有漲跌幅限制。它的交易方式是跟券商議價，而非集中撮合，因此波動性比上市櫃股票大很多，投資前需要特別留意風險。（資訊更新至 2026 年 8 月，以主管機關公告為準）\"}]]}]]}]]]}]\n1e:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"搞懂漲跌停計算，核心是記住「以前一天收盤價為基準，乘以 1.1 或 0.9，再依股價範圍做四捨五入」。這個簡單的規則能幫助你在盤中快速反應，不再對價格跳動感到困惑。\"}]]]}]\n1f:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L17\",\"0-查詢個股每日行情\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"查詢個股每日行情與籌碼\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L17\",\"0-學習更多台股基礎\",{\"href\":\"/school\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"學習更多台股基礎知識\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L17\",\"0-搞懂除權息參考價\",{\"href\":\"/s/2330\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"搞懂除權息參考價計算\"}]]}]]}]]]}]\n13:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\nf:null\n20:I[80622,[],\"IconMark\"]\n11:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"股價漲跌停怎麼算？台股漲跌幅10%計算教學，3分鐘學會｜股市大佬 TradeBoss\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"看到股票攻上漲停好興奮，或是跌停好緊張，但這個價格是怎麼算出來的？為什麼有時候不是剛好 10%？這篇文章會用簡單的算法，讓你以後自己就能快速心算漲停價和跌停價。\"}],[\"$\",\"link\",\"2\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}],[\"$\",\"$L20\",\"3\",{}]],\"error\":null,\"digest\":\"$undefined\"}\n16:\"$11:metadata\"\n"}