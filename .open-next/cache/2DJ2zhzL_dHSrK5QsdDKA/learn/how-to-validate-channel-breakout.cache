d\",\"unauthorized\":\"$undefined\"}]]}]\na:[\"$\",\"$1\",\"c\",{\"children\":[\"$Ld\",[[\"$\",\"link\",\"0\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/css/3eaf36e367672966.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"$undefined\"}]],[\"$\",\"$Le\",null,{\"children\":[\"$Lf\",[\"$\",\"$L10\",null,{\"promise\":\"$@11\"}]]}]]}]\nb:[\"$\",\"$1\",\"h\",{\"children\":[null,[[\"$\",\"$L12\",null,{\"children\":\"$L13\"}],[\"$\",\"meta\",null,{\"name\":\"next-size-adjust\",\"content\":\"\"}]],[\"$\",\"$L14\",null,{\"children\":[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$15\",null,{\"fallback\":null,\"children\":\"$L16\"}]}]}]]}]\n17:I[52619,[\"2619\",\"static/chunks/2619-04bc32f026a0d946.js\",\"6309\",\"static/chunks/app/learn/%5Bslug%5D/page-f7b99344f7e2ee16.js\"],\"\"]\nd:[\"$\",\"div\",null,{\"className\":\"LearnArticle_wrap__LIQ8G\",\"children\":[\"$\",\"article\",null,{\"className\":\"LearnArticle_article__2nBbk\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_meta__etj_G\",\"children\":[[\"$\",\"$L17\",null,{\"className\":\"LearnArticle_cat__GQMlg\",\"href\":\"/learn?c=strategy\",\"children\":\"策略解析\"}],[\"$\",\"span\",null,{\"className\":\"LearnArticle_read__QEj6a\",\"children\":\"閱讀約 7 分鐘\"}]]}],[\"$\",\"h1\",null,{\"className\":\"LearnArticle_title__0_la8\",\"children\":\"通道突破怎麼判斷有效？別只看收盤價，3 個訊號判斷真假突破\"}],[\"$\",\"details\",null,{\"className\":\"LearnArticle_toc__LcSAa\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"LearnArticle_tocSummary__YBddG\",\"children\":\"本文目錄\"}],[\"$\",\"ol\",null,{\"className\":\"LearnArticle_tocList__Rq_Lz\",\"children\":[[\"$\",\"li\",\"sec-1\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-1\",\"children\":\"一、什麼是通道？為什麼股價「突破」這麼重要？\"}]}],[\"$\",\"li\",\"sec-2\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-2\",\"children\":\"二、關鍵第一步：成交量有沒有跟上？\"}]}],[\"$\",\"li\",\"sec-3\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-3\",\"children\":\"三、K 棒型態怎麼看？長相決定了突破的誠意\"}]}],[\"$\",\"li\",\"sec-4\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-4\",\"children\":\"四、「回測不破」是什麼意思？為什麼要耐心等待？\"}]}],[\"$\",\"li\",\"sec-5\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-5\",\"children\":\"五、除了量價，還有什麼籌碼指標能輔助判斷？\"}]}],[\"$\",\"li\",\"sec-6\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-6\",\"children\":\"常見問題 FAQ\"}]}],[\"$\",\"li\",\"sec-7\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-7\",\"children\":\"總結\"}]}],[\"$\",\"li\",\"sec-8\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-8\",\"children\":\"延伸閱讀\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"LearnArticle_body__6B7Mb\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_intro__ATV5c\",\"children\":\"打開 K 線圖，看到股價沿著一個漂亮的上升通道前進，好不容易等到它衝破通道上緣，以為要一飛沖天了，結果才追進去沒多久，股價又跌回通道內，讓你套在最高點？這種「假突破」是很多散戶的痛。這篇文章就是要教你，如何從成交量、K 棒型態和後續走勢，判斷一次通道突破是「玩真的」還是「騙人的」。\"}],[[\"$\",\"figure\",\"figure-0\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"虧 3 次每次 −1%賺 2 次每次 +1%勝率 40% 也可能是正期望，前提是賺的比虧的大、且扣得起成本短線先扣約 0.24% 當沖成本，再看還剩多少\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"示意圖｜期望值：勝率要配上平均賺賠，再扣成本（教學結構，不是某檔實盤）\"}]]}]],[\"$\",\"div\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"帶量突破是基本：突破當天的成交量，至少要是過去 5 日均量的 1.5 倍。\"}],[\"$\",\"li\",\"1\",{\"children\":\"觀察 K 棒實體：突破 K 棒的實體部分要夠長，收盤價要明顯站上通道上緣。\"}],[\"$\",\"li\",\"2\",{\"children\":\"回測不破是確認：突破後 3 天內，股價拉回測試通道上緣，沒跌破才是強勢訊號。\"}],[\"$\",\"li\",\"3\",{\"children\":\"搭配籌碼更準確：如果突破伴隨三大法人同步買超，可信度會大幅提高。\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、什麼是通道？為什麼股價「突破」這麼重要？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"簡單說，「通道」就是股價在一段時間內，被兩條平行的趨勢線框住的活動範圍。上面的線叫「壓力線」，下面的叫「支撐線」。當股價能成功衝破壓力線，代表市場買氣強勁到願意用更高的價格追買，可能開啟一段新的上漲趨勢，所以大家才會這麼關注「突破」這個訊號。\"}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、關鍵第一步：成交量有沒有跟上？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"股價上漲需要錢來推動，所以「突破」絕對不能沒有「成交量」的配合。如果股價漲上去了，但買賣的張數卻跟平常差不多，那很可能只是曇花一現的假象，或是主力刻意製造的陷阱。一個健康的突破，成交量是必要條件，代表市場上有一群人真心看好、願意花錢追價。\"}],[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"基本門檻：突破當天的成交量，最好是過去 5 日平均成交量的 1.5 倍以上，2 倍更佳。\"}],[\"$\",\"li\",\"1\",{\"children\":\"觀察連續性：突破後的 1-2 天，成交量雖然可能稍微減少，但不應該急速萎縮到突破前的水準。\"}],[\"$\",\"li\",\"2\",{\"children\":\"常見錯誤：看到價格衝高就興奮，完全沒看成交量。無量上漲就像蓋在沙灘上的城堡，非常不穩固。\"}]]}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、K 棒型態怎麼看？長相決定了突破的誠意\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"突破當天那根 K 棒的長相，也透露出很多訊息。它能告訴我們當天多空交戰的結果，是買方大獲全勝，還是其實拉得很勉強。我們要找的是那種乾淨俐落的勝利訊號，而不是那種看起來贏了、實際上卻充滿猶豫的 K 棒。\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"訊號強度\"}],[\"$\",\"th\",\"1\",{\"children\":\"K 棒型態\"}],[\"$\",\"th\",\"2\",{\"children\":\"判讀說明\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[\"$L18\",\"$L19\",\"$L1a\"]}],\"$L1b\",\"$L1c\",\"$L1d\"]}]]}]}],\"$L1e\"]]}],\"$L1f\",\"$L20\",\"$L21\",\"$L22\",\"$L23\"],null]}]]}]}]\n18:[\"$\",\"td\",\"0\",{\"children\":\"強\"}]\n19:[\"$\",\"td\",\"1\",{\"children\":\"長紅實體 K 棒\"}]\n1a:[\"$\",\"td\",\"2\",{\"children\":\"收盤價遠高於開盤價，且收在當日最高點附近，代表買方從頭到尾掌握主導權。\"}]\n1b:[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"中\"}],[\"$\",\"td\",\"1\",{\"children\":\"帶下影線的紅 K\"}],[\"$\",\"td\",\"2\",{\"children\":\"盤中一度被賣方打壓，但收盤前又被買方拉上來，顯示多方仍有抵抗力道。\"}]]}]\n1c:[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"弱\"}],[\"$\",\"td\",\"1\",{\"children\":\"長上影線（避雷針）\"}],[\"$\",\"td\",\"2\",{\"children\":\"股價盤中雖衝高，但收盤時被大量賣壓打回，是假突破的常見跡象。\"}]]}]\n1d:[\"$\",\"tr\",\"3\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"弱\"}],[\"$\",\"td\",\"1\",{\"children\":\"十字線或小紅小黑\"}],[\"$\",\"td\",\"2\",{\"children\":\"多空力量僵持，方向不明，突破的有效性存疑，最好再多觀察幾天。\"}]]}]\n1e:[\"$\",\"figure\",\"2\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"!無量上漲!爆量長上影線!快速跌回通道內\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"小心！假突破的 3 個警訊\"}]]}]\n1f:[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、「回測不破」是什麼意思？為什麼要耐心等待？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"一個真正的強勢突破，市場會回來測試原本的「壓力線」是否變成了新的「支撐線」。這個動作就叫做「回測」。如果股價拉回到通道上緣附近就止跌反彈，代表這個突破已經被市場確認，此時進場的風險相對較低。急著在突破第一時間衝進去，很容易被短線的假動作騙到。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"時間：通常發生在突破後的 3-5 個交易日內。\"}],[\"$\",\"li\",\"1\",{\"children\":\"價位：股價拉回至原通道上緣附近，沒有跌破收盤。\"}],[\"$\",\"li\",\"2\",{\"children\":\"成交量：回測時的成交量應該是萎縮的，代表賣壓不重，只是短線獲利了結。\"}],[\"$\",\"li\",\"3\",{\"children\":\"結果：股價在通道上緣獲得支撐，並重新上漲，確認支撐有效。\"}]]}]]]}]\n20:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、除了量價，還有什麼籌碼指標能輔助判斷？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"技術分析不是萬能的，如果能搭配籌碼面的資料一起看，判斷的準確度會更高。畢竟，真正能推動股價的還是背後的大戶和法人。你可以從「股市大佬」的個股透視頁面，快速檢查這些籌碼動向，看看大錢是不是也跟你流向同一個方向。\"}],[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"三大法人買賣超：突破當天，外資、投信、自營商是否聯手買超？如果是，代表大資金也認同這個突破。\"}],[\"$\",\"li\",\"1\",{\"children\":\"分點集中度：買超的券商分點是集中在少數幾家，還是分散的？如果買盤來自特定主力分點，那力道會更強勁。\"}],[\"$\",\"li\",\"2\",{\"children\":\"融券變化：突破時，如果融券也異常增加，代表很多人不信邪去放空，後續若股價續強，就可能引發軋空行情。\"}]]}]]]}]\n21:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"突破後站穩幾天才算安全？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"市場普遍認為「站穩三天」是一個參考標準。意思是連續三個交易日的收盤價，都能維持在通道上緣之上。這代表市場初步接受了這個新價位，降低了假突破的機率。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"如果成交量很大，但收了一根長上影線，該怎麼辦？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"這是個危險訊號，俗稱「爆量不漲」。代表雖然買盤踴躍，但上方的賣壓更重，多頭攻勢受阻。最好先觀望，不要急著進場，因為這很可能是主力在拉高出貨的跡象。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"下降通道的「向下跌破」也適用這些判斷方法嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"原理是相通的，但方向相反。向下跌破時，要看的是「帶量的長黑 K 棒」，且後續反彈到通道下緣（原支撐線）時過不去，形成「反彈遇壓」，就是確認的跌破訊號。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"通道線要怎麼畫才準確？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"畫趨勢線沒有百分之百的標準答案，但有原則可循。上升通道的支撐線，應連接至少兩個明顯的低點；壓力線則通過至少一個高點，並與支撐線平行。接觸的點越多，這條通道線就越有效。\"}]]}]]}]]]}]\n22:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"一個有效的通道突破，需要「價、量、型態」三者兼備。記得「帶量長紅是攻擊，回測不破是確認」，不要看到股價一衝出去就急著上車，多等一兩天，讓市場告訴你答案，能大幅降低被假突破套牢的風險。\"}]]]}]\n23:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L17\",\"0-學習更多 K 線\",{\"href\":\"/school\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"學習更多 K 線型態\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L17\",\"0-查詢個股的籌碼動\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"查詢個股的籌碼動向\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L17\",\"0-掃描符合技術型態\",{\"href\":\"/chart\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"掃描符合技術型態的股票\"}]]}]]}]]]}]\n13:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\nf:null\n24:I[80622,[],\"IconMark\"]\n11:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"通道突破怎麼判斷有效？別只看收盤價，3 個訊號判斷真假突破｜股市大佬 TradeBoss\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"打開 K 線圖，看到股價沿著一個漂亮的上升通道前進，好不容易等到它衝破通道上緣，以為要一飛沖天了，結果才追進去沒多久，股價又跌回通道內，讓你套在最高點？這種「假突破」是很多散戶的痛。這篇文章就是要教你，如何從成交量、K 棒型態和後續走勢，判斷一次通道突破是「玩真的」還是「騙人的」\"}],[\"$\",\"link\",\"2\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}],[\"$\",\"$L24\",\"3\",{}]],\"error\":null,\"digest\":\"$undefined\"}\n16:\"$11:metadata\"\n"}