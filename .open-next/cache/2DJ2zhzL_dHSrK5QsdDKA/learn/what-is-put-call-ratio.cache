ren\":[\"$\",\"a\",null,{\"href\":\"#sec-8\",\"children\":\"延伸閱讀\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"LearnArticle_body__6B7Mb\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_intro__ATV5c\",\"children\":\"打開財經新聞，常看到「Put Call 比攀升，市場避險情緒濃厚」這樣的標題，但這個數字到底代表什麼？看到一堆數字霧煞煞，不知道該怎麼應用在自己的看盤上？這篇文章會用最簡單的方式，教你如何解讀這個衡量市場多空力道的溫度計。\"}],[[\"$\",\"figure\",\"figure-0\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"沒扣成本的勝率，看起來都會比較漂亮0.029%手續費 1 折來回0.15%當沖證交稅0.06%滑價估計三項合計約 0.24%；留倉稅率更高，約 0.39%\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"示意圖｜當沖來回成本：1 折手續費 + 證交稅 + 滑價（教學結構，不是某檔實盤）\"}]]}]],[\"$\",\"div\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"Put Call 比率是衡量市場整體情緒的指標，看買權（Call）與賣權（Put）的成交量比例。\"}],[\"$\",\"li\",\"1\",{\"children\":\"比率大於 1.2 暗示市場極度悲觀，常被當作反向觀察的訊號；小於 0.7 則代表過度樂觀。\"}],[\"$\",\"li\",\"2\",{\"children\":\"這個指標是「反指標」，當市場情緒一面倒時，往往是行情可能反轉的參考點。\"}],[\"$\",\"li\",\"3\",{\"children\":\"觀察長期趨勢比單日數字更重要，需搭配大盤價量關係一起看，避免誤判。\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、到底什麼是 Put 和 Call？跟股票有什麼不同？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"在搞懂比例之前，要先認識這兩個主角。選擇權是一種「權利」的契約，而不是股票本身。簡單來說，買進買權（Call）是賭未來會漲，有權利用約定好的價格「買進」；買進賣權（Put）則是賭未來會跌，有權利用約定好的價格「賣出」。它們像是用比較小的資金，去參與大盤或個股的漲跌。\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"項目\"}],[\"$\",\"th\",\"1\",{\"children\":\"買進買權 (Buy Call)\"}],[\"$\",\"th\",\"2\",{\"children\":\"買進賣權 (Buy Put)\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"代表心態\"}],[\"$\",\"td\",\"1\",{\"children\":\"看漲，認為未來價格會上漲\"}],[\"$\",\"td\",\"2\",{\"children\":\"看跌，認為未來價格會下跌\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"核心權利\"}],[\"$\",\"td\",\"1\",{\"children\":\"用約定價「買進」的權利\"}],[\"$\",\"td\",\"2\",{\"children\":\"用約定價「賣出」的權利\"}]]}],[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"好比\"}],[\"$\",\"td\",\"1\",{\"children\":\"付訂金預購熱門商品，賭它未來會更貴\"}],[\"$\",\"td\",\"2\",{\"children\":\"買一份保險，預防資產價值下跌的風險\"}]]}]]}]]}]}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、Put Call 比率是怎麼算出來的？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"它的算法非常單純，就是把所有賣權（Put）的成交量，除以所有買權（Call）的成交量。公式是：Put/Call Ratio = 賣權總成交量 / 買權總成交量。這個數字代表了市場上，看跌的力量相對於看漲的力量有多大。如果今天有 10 萬口的賣權成交，8 萬口的買權成交，那 Put Call 比就是 10 萬 / 8 萬 = 1.25。\"}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、數字高低代表什麼？關鍵門檻怎麼抓？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"這個指標最有趣的地方在於，它通常被當作「反向指標」來觀察。意思是，當市場情緒太過一面倒的時候，行情往往會朝相反方向走。大家可以記住幾個關鍵的數字門檻，來快速判斷當下的市場氣氛。\"}],\"$L18\",\"$L19\"]]}],\"$L1a\",\"$L1b\",\"$L1c\",\"$L1d\",\"$L1e\"],null]}]]}]}]\n18:[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"比率 > 1.2：市場極度悲觀。賣權的成交量遠大於買權，代表多數人都在避險或看空。此時，空方力量可能已經耗盡，反而可能是指數落底反彈的訊號。\"}],[\"$\",\"li\",\"1\",{\"children\":\"比率在 1.0 ~ 1.2 之間：市場氣氛偏向悲觀。\"}],[\"$\",\"li\",\"2\",{\"children\":\"比率在 0.8 ~ 1.0 之間：市場情緒較為中性或平衡。\"}],[\"$\",\"li\",\"3\",{\"children\":\"比率 < 0.7：市場極度樂觀。買權的成交量遠大於賣權，代表多數人都在追漲。此時要留意市場是否過熱，追高風險增加，可能是指數見高點的警訊。\"}]]}]\n19:[\"$\",\"figure\",\"2\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"!只看一天就下判斷!當成絕對的買賣訊號!忽略法人的避險行為\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"新手常見三大判讀誤區\"}]]}]\n1a:[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、新手最容易犯的三個判讀錯誤\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"Put Call 比是個好用的輔助工具，但如果使用方式錯誤，很容易造成反效果。許多投資人，特別是剛接觸籌碼面的新手，常常會因為過度解讀而做出錯誤決策。請務必避開以下這三個常見的錯誤，才能發揮指標的真正價值。\"}],[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"只看一天的數字就下結論：市場情緒需要時間累積。單一天的比率飆高或降低，可能只是受到特定事件影響。你該看的是「連續幾天」的趨勢，例如比率是否持續攀升或下降，這才代表情緒的真實走向。\"}],[\"$\",\"li\",\"1\",{\"children\":\"把指標當成唯一的進出場訊號：沒有任何一個指標是萬能的。Put Call 比只反映「情緒」，不代表「絕對」的漲跌。務必搭配大盤的 K 線型態、成交量、均線等其他資訊一起綜合判斷。\"}],[\"$\",\"li\",\"2\",{\"children\":\"忽略法人避險的需求：有時候 Put 的成交量大增，不見得是散戶全面看空，也可能是持有大量股票的法人機構，為了規避下跌風險而買進賣權做「保險」。這種避險需求會讓指標失真，不能單純解讀為市場要崩盤了。\"}]]}]]]}]\n1b:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、哪裡可以查詢最新的 Put Call 比？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"想知道最新的數據其實很簡單，台灣期貨交易所每天都會公布前一天的選擇權相關資料。不過，自己去期交所網站找資料、手動整理成圖表比較花時間。在「股市大佬」的「大盤總覽」頁面，我們已經將每日的 Put Call 比視覺化，並與加權指數走勢圖疊加，讓你可以一眼看出情緒與價格的對應關係，更容易掌握市場脈動。\"}]]]}]\n1c:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"Put Call 比率每天都會更新嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"是的，這個比率是根據每一天的選擇權總成交量計算出來的，所以每天收盤後都會有新的數值。你可以觀察它的每日變化來追蹤市場情緒的流動。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"這個指標可以用在分析個股嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"Put Call 比率通常指的是「台指選擇權」的數據，主要用來判斷「整體大盤」的多空情緒。雖然個股也有選擇權，但交易量較分散，參考性不如大盤集中。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"比率超過 1.2，是不是代表隔天大盤就一定會漲？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"不保證。它只是一個訊號，告訴我們市場「過度悲觀」，空方力量可能釋放得差不多了。行情有可能落底，但也可能整理幾天才反彈，甚至繼續緩跌。它是一個機率的參考，不是絕對的預測。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"除了成交量，還有「未平倉量」的 Put Call 比，兩者有何不同？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"「成交量」代表的是當天的市場熱度與多空交易力道，比較偏向短線情緒。而「未平倉量」代表市場上還留著多少看多或看空的合約，反映的是長線趨勢與多空雙方累積的部位，兩者看的角度不同，可以互相參考。\"}]]}]]}]]]}]\n1d:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"總結來說，把 Put Call 比當成市場的「恐懼與貪婪指數」。當數字極高（>1.2），代表市場充滿恐懼，你應該保持冷靜，尋找機會；當數字極低（<0.7），代表市場充滿貪婪，你就該提高警覺，控管風險。\"}]]]}]\n1e:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L17\",\"0-查看最新的大盤 \",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"查看最新的大盤 Put Call 比走勢圖\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L17\",\"0-學習更多籌碼分析\",{\"href\":\"/school\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"學習更多籌碼分析的基礎知識\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L17\",\"0-免費註冊，開始使\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"免費註冊，開始使用籌碼工具\"}]]}]]}]]]}]\n13:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\nf:null\n1f:I[80622,[],\"IconMark\"]\n11:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"選擇權 Put Call 比是什麼？看懂市場情緒的關鍵指標｜股市大佬 TradeBoss\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"打開財經新聞，常看到「Put Call 比攀升，市場避險情緒濃厚」這樣的標題，但這個數字到底代表什麼？看到一堆數字霧煞煞，不知道該怎麼應用在自己的看盤上？這篇文章會用最簡單的方式，教你如何解讀這個衡量市場多空力道的溫度計。\"}],[\"$\",\"link\",\"2\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}],[\"$\",\"$L1f\",\"3\",{}]],\"error\":null,\"digest\":\"$undefined\"}\n16:\"$11:metadata\"\n"}