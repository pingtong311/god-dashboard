",\"article\",null,{\"className\":\"LearnArticle_article__2nBbk\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_meta__etj_G\",\"children\":[[\"$\",\"$L17\",null,{\"className\":\"LearnArticle_cat__GQMlg\",\"href\":\"/learn?c=events\",\"children\":\"金融大事件\"}],[\"$\",\"span\",null,{\"className\":\"LearnArticle_read__QEj6a\",\"children\":\"閱讀約 7 分鐘\"}]]}],[\"$\",\"h1\",null,{\"className\":\"LearnArticle_title__0_la8\",\"children\":\"日圓套利交易反轉是什麼？為何日圓一升值，全球股市就緊張？3 個觀察指標\"}],[\"$\",\"details\",null,{\"className\":\"LearnArticle_toc__LcSAa\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"LearnArticle_tocSummary__YBddG\",\"children\":\"本文目錄\"}],[\"$\",\"ol\",null,{\"className\":\"LearnArticle_tocList__Rq_Lz\",\"children\":[[\"$\",\"li\",\"sec-1\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-1\",\"children\":\"一、什麼是「日圓套利交易」？為什麼國際大戶愛借日圓？\"}]}],[\"$\",\"li\",\"sec-2\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-2\",\"children\":\"二、那「反轉」又是什麼意思？為什麼錢要突然跑掉？\"}]}],[\"$\",\"li\",\"sec-3\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-3\",\"children\":\"三、日圓反轉，到底跟我的台股有什麼關係？\"}]}],[\"$\",\"li\",\"sec-4\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-4\",\"children\":\"四、我該如何觀察「反轉」的跡象？看懂 3 個關鍵數字\"}]}],[\"$\",\"li\",\"sec-5\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-5\",\"children\":\"五、如何利用股市大佬，追蹤市場資金流向？\"}]}],[\"$\",\"li\",\"sec-6\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-6\",\"children\":\"常見問題 FAQ\"}]}],[\"$\",\"li\",\"sec-7\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-7\",\"children\":\"總結\"}]}],[\"$\",\"li\",\"sec-8\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-8\",\"children\":\"延伸閱讀\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"LearnArticle_body__6B7Mb\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_intro__ATV5c\",\"children\":\"新聞常說，日圓一升值，外資就可能從台股撤退，害得大盤跟著跌。但日圓跟台股到底有什麼關係？這其實跟一種叫「日圓套利交易」的全球資金活動有關。這篇文章會用白話文解釋給你聽，讓你下次看到新聞不再一頭霧水。\"}],[],[\"$\",\"div\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"套利交易是「借低利率日圓，換成高利率貨幣」來賺取利差，是國際熱錢的玩法。\"}],[\"$\",\"li\",\"1\",{\"children\":\"當市場避險情緒升高或日本升息，交易者會「賣資產、換回日圓」還錢，稱為反轉。\"}],[\"$\",\"li\",\"2\",{\"children\":\"反轉會引發全球股市賣壓，因為套利資金需要賣股變現，台股也可能受外資賣超影響。\"}],[\"$\",\"li\",\"3\",{\"children\":\"觀察反轉的三個訊號：美元兌日圓匯率走低、VIX 恐慌指數飆高、外資在台股連續賣超。\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、什麼是「日圓套利交易」？為什麼國際大戶愛借日圓？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"想像一下，你用 1% 的利率借到一筆錢，然後把它存進一個 5% 利率的定存，中間的 4% 就是你賺的。日圓套利交易（Yen Carry Trade）就是這個概念的放大版。因為日本長期維持超低利率，接近零，所以國際上的大型投資機構（像避險基金）就會大量借出日圓，把它換成美元、澳幣等利息較高的貨幣，再拿去投資這些國家的股市或債券，賺取中間巨大的利息差。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"核心玩法：借低利率的日圓，投高利率的資產，賺取中間的利差。\"}],[\"$\",\"li\",\"1\",{\"children\":\"主要玩家：大型機構法人、避險基金等專業投資者，資金規模極大。\"}],[\"$\",\"li\",\"2\",{\"children\":\"成立前提：日本央行長期維持接近零利率的貨幣政策，讓借錢成本非常低。\"}]]}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、那「反轉」又是什麼意思？為什麼錢要突然跑掉？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"有借有還，當派對結束時，就得還錢了。「反轉」或稱「平倉」，指的就是這些借日圓的投資機構，開始結束他們的套利部位。他們必須賣掉之前買進的海外資產（例如台股、美股），換回日圓，然後償還當初在日本的貸款。這個「賣資產、買日圓」的過程，就是反轉的核心動作，會對全球金融市場造成連鎖反應。\"}],[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"觸發點一：日本央行升息。借錢的成本變高了，利差縮小甚至消失，套利交易不再划算。\"}],[\"$\",\"li\",\"1\",{\"children\":\"觸發點二：全球市場風險升高。例如發生金融危機或戰爭，投資人嚇到了，寧願趕快還錢出場，也不想再承擔風險。\"}],[\"$\",\"li\",\"2\",{\"children\":\"反轉的過程：賣掉海外資產（股票、債券）→ 用賣掉資產得到的錢去買日圓 → 償還當初的日圓貸款。\"}]]}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、日圓反轉，到底跟我的台股有什麼關係？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"關係可大了。當這些全球大戶需要錢來還日圓貸款時，他們會從哪裡籌錢？答案是：從他們投資的全世界市場提款，而台灣就是其中一個重要的提款地點。這就是為什麼當套利交易反轉時，你常會看到外資在台股出現連續性、大金額的賣超，即使台灣的基本面沒有變壞，股價也可能因為全球資金的撤離而下跌。\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"交易階段\"}],[\"$\",\"th\",\"1\",{\"children\":\"日圓匯率走向\"}],[\"$\",\"th\",\"2\",{\"children\":\"全球資金流向\"}],\"$L18\"]}]}],\"$L19\"]}]}],\"$L1a\"]]}],\"$L1b\",\"$L1c\",\"$L1d\",\"$L1e\",\"$L1f\"],null]}]]}]}]\n18:[\"$\",\"th\",\"3\",{\"children\":\"對台股的可能影響\"}]\n19:[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"套利交易盛行時\"}],[\"$\",\"td\",\"1\",{\"children\":\"趨貶（數字變大，如 1 美元換 150 日圓）\"}],[\"$\",\"td\",\"2\",{\"children\":\"資金從日本流向全球股市\"}],[\"$\",\"td\",\"3\",{\"children\":\"外資傾向流入，助漲大盤\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"套利交易反轉時\"}],[\"$\",\"td\",\"1\",{\"children\":\"趨升（數字變小，如 1 美元換 130 日圓）\"}],[\"$\",\"td\",\"2\",{\"children\":\"資金從全球股市撤回日本\"}],[\"$\",\"td\",\"3\",{\"children\":\"外資傾向賣超，大盤承受壓力\"}]]}]]}]\n1a:[\"$\",\"figure\",\"2\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"!日圓急速升值!VIX 指數飆高!外資連續賣超\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"套利交易反轉 3 警訊\"}]]}]\n1b:[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、我該如何觀察「反轉」的跡象？看懂 3 個關鍵數字\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"了解原理後，更重要的是知道如何觀察。你不需要是經濟學家，只要盯著幾個關鍵數字，就能對市場氣氛有個底。當你發現以下幾個訊號同時出現時，就代表市場的避險情緒可能正在升高，資金流向正在改變，需要提高警覺。\"}],[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"美元兌日圓 (USD/JPY) 匯率：這是最直接的指標。當這個數字持續走低（例如從 150 跌破 145、再往 140 靠近），就代表日圓正在快速升值，是反轉的強烈訊號。\"}],[\"$\",\"li\",\"1\",{\"children\":\"VIX 恐慌指數：這個指數反映市場對未來 30 天波動的預期。當 VIX 指數從低檔（如 15 以下）快速飆高到 20 甚至 25 以上，代表市場恐慌情緒蔓延，套利交易者會加速撤退。\"}],[\"$\",\"li\",\"2\",{\"children\":\"台股外資買賣超：每天收盤後留意法人動向。如果外資從原本的買超或小賣，轉為連續性、單日超過百億的大額賣超，這很可能就是全球資金正在撤離的一環。\"}]]}]]]}]\n1c:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、如何利用股市大佬，追蹤市場資金流向？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"了解原理後，重點是如何在盤勢中快速驗證。你不需要自己到處找資料拼湊，在股市大佬的「大盤總覽」頁面，我們已經將外資買賣超、台幣匯率、大盤成交量等關鍵數據都整理成視覺化圖表。你可以輕鬆對照每日的外資動向與大盤走勢的關聯，一眼掌握資金進出的趨勢，幫助你判斷市場氣氛的變化。\"}]]]}]\n1d:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"借日圓的都是些什麼人？散戶也可以操作嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"主要是大型投資機構，如避險基金、投資銀行、保險公司。因為他們需要的資金規模極大，並且有專業管道能以極低利率借到日圓。一般散戶的資金規模和管道都難以參與這種跨國的套利操作。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"所以日圓貶值就一定對股市好嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"不一定。在套利交易盛行時，日圓貶值通常伴隨資金外流，對全球股市是正面訊號。但如果貶值是因為日本自身經濟極度疲弱，那反而會引發市場對全球景氣的擔憂，對股市就不見得是好事。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"為什麼日本要長期維持這麼低的利率？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"最主要的原因是為了對抗國內長期的通貨緊縮（物價持續下跌），並刺激經濟成長。低利率可以降低企業和個人的借貸成本，理論上能鼓勵大家把錢拿出來消費或投資，藉此活絡經濟。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"套利交易反轉通常會持續多久？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"沒有標準答案。持續時間取決於觸發原因的嚴重程度。如果是恐慌性事件（如金融海嘯）引發，資金撤退可能又快又急；如果是央行緩步升息引導，資金撤退的過程就可能比較緩慢而持久。\"}]]}]]}]]]}]\n1e:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"總結來說，「日圓套利交易反轉」就是全球資金從風險市場撤退、還錢給日本的過程。當你看到日圓突然走強，並伴隨 VIX 指數上升時，就要留意這可能是外資從台股提款的訊號，對自己的持股要多一份警覺。\"}]]]}]\n1f:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L17\",\"0-查看每日外資動向\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"查看每日外資動向與大盤數據\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L17\",\"0-了解更多股市專有\",{\"href\":\"/school\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"了解更多股市專有名詞\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L17\",\"0-訂閱每日台股重點\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"訂閱每日台股重點整理\"}]]}]]}]]]}]\n13:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\nf:null\n20:I[80622,[],\"IconMark\"]\n11:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"日圓套利交易反轉是什麼？為何日圓一升值，全球股市就緊張？3 個觀察指標｜股市大佬 TradeBoss\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"新聞常說，日圓一升值，外資就可能從台股撤退，害得大盤跟著跌。但日圓跟台股到底有什麼關係？這其實跟一種叫「日圓套利交易」的全球資金活動有關。這篇文章會用白話文解釋給你聽，讓你下次看到新聞不再一頭霧水。\"}],[\"$\",\"link\",\"2\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}],[\"$\",\"$L20\",\"3\",{}]],\"error\":null,\"digest\":\"$undefined\"}\n16:\"$11:metadata\"\n"}