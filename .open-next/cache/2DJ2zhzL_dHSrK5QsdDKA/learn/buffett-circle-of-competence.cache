,{\"className\":\"LearnArticle_tocList__Rq_Lz\",\"children\":[[\"$\",\"li\",\"sec-1\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-1\",\"children\":\"一、圈是用來拒絕的，不是用來炫耀的\"}]}],[\"$\",\"li\",\"sec-2\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-2\",\"children\":\"二、三題，答不出來就還在圈外\"}]}],[\"$\",\"li\",\"sec-3\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-3\",\"children\":\"三、圈會變，但不是盤中變\"}]}],[\"$\",\"li\",\"sec-4\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-4\",\"children\":\"四、和「買你懂的」差在哪\"}]}],[\"$\",\"li\",\"sec-5\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-5\",\"children\":\"五、最小動作\"}]}],[\"$\",\"li\",\"sec-6\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-6\",\"children\":\"常見問題 FAQ\"}]}],[\"$\",\"li\",\"sec-7\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-7\",\"children\":\"總結\"}]}],[\"$\",\"li\",\"sec-8\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-8\",\"children\":\"延伸閱讀\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"LearnArticle_body__6B7Mb\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_intro__ATV5c\",\"children\":\"華倫·巴菲特在公開信裡反覆寫過：不一定要懂很多行業，但要很清楚自己懂哪一塊。後來這句被縮成「能力圈」。聊天室常把它用成「我知道這家公司名字」。真正的圈，比較像一張地圖上你畫得動的邊界：圈外不是邪惡，是你沒有資格下重注。這篇只幫你畫邊界。\"}],[],[\"$\",\"div\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"能力圈是邊界，不是榮譽徽章\"}],[\"$\",\"li\",\"1\",{\"children\":\"聽過題材、會背名詞，都不算在圈內\"}],[\"$\",\"li\",\"2\",{\"children\":\"圈外可以看、可以學，不適合當成這次的主部位\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、圈是用來拒絕的，不是用來炫耀的\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"公開文本的語氣很平：把投資限制在自己真正了解的範圍。了解不是喜歡，也不是最近很熱。它比較接近：這門生意的錢從哪來、什麼會讓它停、你大概知道自己會在哪裡估錯。畫得愈小，拒絕愈多，這才是圈的功能。畫得很大，只是把衝動改名。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"圈的功能是拒絕\"}],[\"$\",\"li\",\"1\",{\"children\":\"喜歡≠了解\"}],[\"$\",\"li\",\"2\",{\"children\":\"熱門≠在圈內\"}]]}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、三題，答不出來就還在圈外\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"這家靠什麼收錢？錢停下來的常見原因是什麼？若你的假設錯了，最先壞掉的是哪一行數字？三題都能用自己的話講完，才比較像圈內。需要靠別人的一句標題才能講，就還在圈外。圈外不是禁止學習，是禁止把這次當成你很有把握的部位。\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"看起來像在圈內\"}],[\"$\",\"th\",\"1\",{\"children\":\"其實可能是\"}],[\"$\",\"th\",\"2\",{\"children\":\"先補的一問\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"常看這檔新聞\"}],[\"$\",\"td\",\"1\",{\"children\":\"熟悉名字\"}],[\"$\",\"td\",\"2\",{\"children\":\"錢怎麼進來\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"會背產業名詞\"}],[\"$\",\"td\",\"1\",{\"children\":\"會複誦\"}],[\"$\",\"td\",\"2\",{\"children\":\"什麼會讓錢停\"}]]}],[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"朋友也買\"}],[\"$\",\"td\",\"1\",{\"children\":\"從眾\"}],[\"$\",\"td\",\"2\",{\"children\":\"我自己的失效條件\"}]]}],[\"$\",\"tr\",\"3\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"以前賺過\"}],[\"$\",\"td\",\"1\",{\"children\":\"樣本太小\"}],[\"$\",\"td\",\"2\",{\"children\":\"假設錯了先壞哪裡\"}]]}]]}]]}]}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、圈會變，但不是盤中變\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"公開信也承認人可以擴大能力圈，靠的是時間與功課，不是靠一則法說會。盤中把圈突然畫大，通常是價格在幫你畫。比較穩的是：圈的修改寫在檢討日，不寫在五檔跳動的時候。\"}],[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"平時用功課擴圈\"}],[\"$\",\"li\",\"1\",{\"children\":\"盤中只用已經畫好的圈\"}],[\"$\",\"li\",\"2\",{\"children\":\"檢討時才准改邊界\"}]]}],[\"$\",\"figure\",\"2\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"!會背名詞!朋友也買!盤中突然懂了\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"假圈\"}]]}]]]}],[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[\"$L18\",[\"$L19\",\"$L1a\"]]}],\"$L1b\",\"$L1c\",\"$L1d\",\"$L1e\"],\"$L1f\"]}]]}]}]\n18:[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、和「買你懂的」差在哪\"}]\n19:[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"彼得林區後來常被縮成買你熟悉的產品。能力圈更硬：熟悉使用，不等於懂這門生意的財務與競爭。兩句話都在擋外包判斷，但林區那句更容易被讀成「我有用所以該買」。巴菲特這句比較像「我講不清楚所以不該重倉」。\"}]\n1a:[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"會用≠會分析\"}],[\"$\",\"li\",\"1\",{\"children\":\"圈比品牌熟悉更嚴\"}],[\"$\",\"li\",\"2\",{\"children\":\"重倉需要講得清楚\"}]]}]\n1b:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、最小動作\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"把你現在最大的三個部位寫下來，各用五十字回答三題。寫不滿的，部位就不該是最大的那筆。這不保證結果，它只讓名字與曝險對齊。\"}]]]}]\n1c:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"能力圈是不是愈小愈好？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"小到你講得清楚比較有用。小到什麼都不做，只是另一種逃避。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"指數型工具算不算圈外？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"寬基比較不依賴你懂單一生意。仍要懂費用、追蹤與你的持有期間。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"題材熱能不能暫時擴大圈？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"熱的時候最不該改圈。改圈留給功課日。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"和風險優先有什麼關係？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"圈外的重倉，是還不懂就先把生存賭進去。風險優先那篇講的是同一層。\"}]]}]]}]]]}]\n1d:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"能力圈是拒絕用的邊界。三題講不清——怎麼賺錢、什麼會停、錯了先壞哪裡——就還在圈外。圈外可以學，不適合當主部位。\"}]]]}]\n1e:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L17\",\"0-彼得林區為什麼常\",{\"href\":\"/learn/lynch-know-what-you-own\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"彼得林區為什麼常被誤讀\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L17\",\"0-為什麼風險優先\",{\"href\":\"/learn/why-professional-traders-put-risk-first\",\"className\":\"LearnArticle_link__gMwHV\",\"childr