a0d946.js\",\"6309\",\"static/chunks/app/learn/%5Bslug%5D/page-f7b99344f7e2ee16.js\"],\"\"]\nd:[\"$\",\"div\",null,{\"className\":\"LearnArticle_wrap__LIQ8G\",\"children\":[\"$\",\"article\",null,{\"className\":\"LearnArticle_article__2nBbk\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_meta__etj_G\",\"children\":[[\"$\",\"$L17\",null,{\"className\":\"LearnArticle_cat__GQMlg\",\"href\":\"/learn?c=tech\",\"children\":\"技術面\"}],[\"$\",\"span\",null,{\"className\":\"LearnArticle_read__QEj6a\",\"children\":\"閱讀約 6 分鐘\"}]]}],[\"$\",\"h1\",null,{\"className\":\"LearnArticle_title__0_la8\",\"children\":\"紅K棒、黑K棒代表什麼？一篇看懂K線圖漲跌訊號與背後意義\"}],[\"$\",\"details\",null,{\"className\":\"LearnArticle_toc__LcSAa\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"LearnArticle_tocSummary__YBddG\",\"children\":\"本文目錄\"}],[\"$\",\"ol\",null,{\"className\":\"LearnArticle_tocList__Rq_Lz\",\"children\":[[\"$\",\"li\",\"sec-1\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-1\",\"children\":\"一、為什麼股價跌，K棒卻是紅的？關鍵在這裡\"}]}],[\"$\",\"li\",\"sec-2\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-2\",\"children\":\"二、紅K棒（陽線）的標準定義：收盤價 > 開盤價\"}]}],[\"$\",\"li\",\"sec-3\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-3\",\"children\":\"三、黑K棒（陰線）的標準定義：收盤價 < 開盤價\"}]}],[\"$\",\"li\",\"sec-4\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-4\",\"children\":\"四、紅K、黑K、漲、跌，四種情境一次看懂\"}]}],[\"$\",\"li\",\"sec-5\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-5\",\"children\":\"五、只看紅黑還不夠！下一步該看什麼？\"}]}],[\"$\",\"li\",\"sec-6\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-6\",\"children\":\"常見問題 FAQ\"}]}],[\"$\",\"li\",\"sec-7\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-7\",\"children\":\"總結\"}]}],[\"$\",\"li\",\"sec-8\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-8\",\"children\":\"延伸閱讀\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"LearnArticle_body__6B7Mb\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_intro__ATV5c\",\"children\":\"打開看盤軟體，K線圖上一根根紅紅黑黑的柱子，到底代表什麼意思？很多人以為紅K就是漲、黑K就是跌，但有時候股價明明跌了，K棒卻是紅的。這篇文章就是要帶你一次看懂，紅K、黑K真正的判讀關鍵。\"}],[[\"$\",\"figure\",\"figure-0\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"開／高／低／收實體＝開收之間；影線＝最高與最低紅 K 收漲綠 K 收跌十字線長紅長綠\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"示意圖｜日 K：紅漲綠跌，影線是當天曾走過的路（教學結構，不是某檔實盤）\"}]]}]],[\"$\",\"div\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"紅K棒代表「收盤價 > 開盤價」，顯示當天買方力道較強，不一定等於股價上漲。\"}],[\"$\",\"li\",\"1\",{\"children\":\"黑K棒代表「收盤價 < 開盤價」，顯示當天賣方壓力較大，不一定等於股價下跌。\"}],[\"$\",\"li\",\"2\",{\"children\":\"K棒顏色只看「當天開盤與收盤」的比較，與前一天收盤價無關。\"}],[\"$\",\"li\",\"3\",{\"children\":\"結合上下影線與K棒實體長度，才能更完整判斷當天的多空角力。\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、為什麼股價跌，K棒卻是紅的？關鍵在這裡\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"這是新手最常見的誤會：把K棒顏色跟股價漲跌劃上等號。其實，K棒的顏色只決定於「今天的收盤價」跟「今天的開盤價」相比的結果。而我們平常說的股價漲跌，是指「今天的收盤價」跟「昨天的收盤價」相比。兩者基準點不同，結果自然可能不一樣。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"判斷K棒顏色：看「今天收盤價」vs.「今天開盤價」\"}],[\"$\",\"li\",\"1\",{\"children\":\"判斷股價漲跌：看「今天收盤價」vs.「昨天收盤價」\"}]]}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、紅K棒（陽線）的標準定義：收盤價 > 開盤價\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"一根紅K棒，代表今天收盤時的價格，比開盤時還要高。這表示在交易時間內，買方的力量佔了上風，成功把價格往上推。K棒中間的實體柱子越長，就代表買方的力道越強勁。例如，開盤 100 元，收盤 105 元，這就是一根實體長度 5 元的紅K棒，代表買方把價格從開盤價推高了 5 元。\"}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、黑K棒（陰線）的標準定義：收盤價 < 開盤價\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"相反地，黑K棒代表今天收盤時的價格，比開盤時還要低。這表示交易時間內，賣方的壓力比較大，把價格往下壓。同樣地，黑K棒的實體柱子越長，代表賣壓越沉重。例如，開盤 100 元，收盤 95 元，這就是一根實體長度 5 元的黑K棒，代表賣方力量佔上風，把價格從開盤價往下壓了 5 元。\"}],[\"$\",\"figure\",\"1\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"!收盤價 < 開盤價!當日賣方壓力大!又稱陰線!不保證股價下跌\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"黑K棒（陰線）快速判斷法\"}]]}]]]}],[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、紅K、黑K、漲、跌，四種情境一次看懂\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"搞懂了基本定義後，我們就能組合出四種常見的狀況。你會發現，紅K不一定漲，黑K也不一定跌。下表讓你一眼看懂其中差異，以後看盤就不會再搞混了。\"}],\"$L18\"]]}],\"$L19\",\"$L1a\",\"$L1b\",\"$L1c\"],null]}]]}]}]\n18:[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"情境\"}],[\"$\",\"th\",\"1\",{\"children\":\"K棒顏色\"}],[\"$\",\"th\",\"2\",{\"children\":\"股價漲跌\"}],[\"$\",\"th\",\"3\",{\"children\":\"白話解讀\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"收盤 > 開盤，且收盤 > 昨收\"}],[\"$\",\"td\",\"1\",{\"children\":\"紅K棒\"}],[\"$\",\"td\",\"2\",{\"children\":\"上漲\"}],[\"$\",\"td\",\"3\",{\"children\":\"開盤後買氣強勁，且成功超越昨日收盤價。\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"收盤 > 開盤，但收盤 < 昨收\"}],[\"$\",\"td\",\"1\",{\"children\":\"紅K棒\"}],[\"$\",\"td\",\"2\",{\"children\":\"下跌\"}],[\"$\",\"td\",\"3\",{\"children\":\"雖跳空開低，但盤中買方進場承接，收斂部分跌幅。\"}]]}],[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"收盤 < 開盤，但收盤 > 昨收\"}],[\"$\",\"td\",\"1\",{\"children\":\"黑K棒\"}],[\"$\",\"td\",\"2\",{\"children\":\"上漲\"}],[\"$\",\"td\",\"3\",{\"children\":\"雖跳空開高，但盤中賣壓出現使漲幅收斂。\"}]]}],[\"$\",\"tr\",\"3\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"收盤 < 開盤，且收盤 < 昨收\"}],[\"$\",\"td\",\"1\",{\"children\":\"黑K棒\"}],[\"$\",\"td\",\"2\",{\"children\":\"下跌\"}],[\"$\",\"td\",\"3\",{\"children\":\"開盤後賣壓沉重，股價一路走低，收在昨收之下。\"}]]}]]}]]}]}]\n19:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、只看紅黑還不夠！下一步該看什麼？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"看懂紅黑只是第一步。一根完整的K棒還包含上下影線，它們提供了更多多空交戰的細節。實體K棒代表開盤到收盤的戰果，而影線則記錄了盤中一度觸及的最高價與最低價。想更深入判讀，就要把這三樣東西合在一起看。\"}],[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"實體長度：實體越長，代表當天單邊（買方或賣方）的力道越明確。\"}],[\"$\",\"li\",\"1\",{\"children\":\"上影線長度：代表盤中攻高後遇到的賣壓。上影線越長，上方壓力越大。\"}],[\"$\",\"li\",\"2\",{\"children\":\"下影線長度：代表盤中殺低後遇到的買盤支撐。下影線越長，下方支撐越強。\"}]]}]]]}]\n1a:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"K棒如果是綠色的，是什麼意思？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"在台灣，券商軟體習慣設定「紅漲綠跌」，所以上漲的K棒會顯示為紅色，下跌的顯示為綠色。但國際上常用「綠漲紅跌」。本文討論的紅K/黑K（或稱陽線/陰線）是看開盤與收盤價的關係，是更傳統且精確的定義。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"十字線（開盤價等於收盤價）是紅色還是黑色？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"當開盤價等於或非常接近收盤價時，會形成沒有實體的「十字線」。它的顏色通常跟隨當天股價的漲跌，如果收盤價高於昨天收盤價，就可能是紅色；反之則為黑色或綠色。十字線代表多空力量陷入僵持，是觀察趨勢是否反轉的訊號之一。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"K棒的顏色可以自己設定嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"大部分的看盤軟體都可以在設定中調整K線的顏色。你可以設定成傳統的「紅K/黑K」（收盤>開盤為紅），或是常見的「紅漲綠跌」（收盤>昨收為紅）。建議新手先用自己最習慣的一種，避免混淆。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"K棒適用於所有商品嗎？股票、期貨、ETF都可以看嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"是的，K線是一種通用的價格圖表，只要有開盤價、收盤價、最高價、最低價這四個數據，就可以繪製。所以不論是股票、ETF、期貨、甚至加密貨幣，都可以用K線圖來分析價格走勢。\"}]]}]]}]]]}]\n1b:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"總結來說，紅K代表當天「收盤價 > 開盤價」，黑K代表「收盤價 < 開盤價」。別再只用顏色判斷漲跌，理解K棒背後「開盤與收盤的角力」，才是你看懂市場情緒的第一步。\"}]]]}]\n1c:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L17\",\"0-到「個股透視」頁\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"到「個股透視」頁面，查看完整K線圖\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L17\",\"0-學習更多K線組合\",{\"href\":\"/chart\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"學習更多K線組合型態\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L17\",\"0-前往「台股學堂」\",{\"href\":\"/school\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"前往「台股學堂」看更多新手教學\"}]]}]]}]]]}]\n13:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\nf:null\n1d:I[80622,[],\"IconMark\"]\n11:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"紅K棒、黑K棒代表什麼？一篇看懂K線圖漲跌訊號與背後意義｜股市大佬 TradeBoss\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"打開看盤軟體，K線圖上一根根紅紅黑黑的柱子，到底代表什麼意思？很多人以為紅K就是漲、黑K就是跌，但有時候股價明明跌了，K棒卻是紅的。這篇文章就是要帶你一次看懂，紅K、黑K真正的判讀關鍵。\"}],[\"$\",\"link\",\"2\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}],[\"$\",\"$L1d\",\"3\",{}]],\"error\":null,\"digest\":\"$undefined\"}\n16:\"$11:metadata\"\n"}