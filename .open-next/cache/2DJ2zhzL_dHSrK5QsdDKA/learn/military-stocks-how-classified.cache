wrap__LIQ8G\",\"children\":[\"$\",\"article\",null,{\"className\":\"LearnArticle_article__2nBbk\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_meta__etj_G\",\"children\":[[\"$\",\"$L17\",null,{\"className\":\"LearnArticle_cat__GQMlg\",\"href\":\"/learn?c=trends\",\"children\":\"產業與趨勢\"}],[\"$\",\"span\",null,{\"className\":\"LearnArticle_read__QEj6a\",\"children\":\"閱讀約 4 分鐘\"}]]}],[\"$\",\"h1\",null,{\"className\":\"LearnArticle_title__0_la8\",\"children\":\"軍工產業台股怎麼分類？3個問題先分，再聽題材\"}],[\"$\",\"details\",null,{\"className\":\"LearnArticle_toc__LcSAa\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"LearnArticle_tocSummary__YBddG\",\"children\":\"本文目錄\"}],[\"$\",\"ol\",null,{\"className\":\"LearnArticle_tocList__Rq_Lz\",\"children\":[[\"$\",\"li\",\"sec-1\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-1\",\"children\":\"一、產品層：不要把螺絲與整機放同一格\"}]}],[\"$\",\"li\",\"sec-2\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-2\",\"children\":\"二、客戶層：標案與商用不要共用同一張月曆\"}]}],[\"$\",\"li\",\"sec-3\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-3\",\"children\":\"三、能見度層：公告、財報、想像\"}]}],[\"$\",\"li\",\"sec-4\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-4\",\"children\":\"四、為什麼這題特別容易道德化\"}]}],[\"$\",\"li\",\"sec-5\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-5\",\"children\":\"五、最小流程\"}]}],[\"$\",\"li\",\"sec-6\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-6\",\"children\":\"常見問題 FAQ\"}]}],[\"$\",\"li\",\"sec-7\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-7\",\"children\":\"總結\"}]}],[\"$\",\"li\",\"sec-8\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-8\",\"children\":\"延伸閱讀\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"LearnArticle_body__6B7Mb\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_intro__ATV5c\",\"children\":\"國際新聞一緊，軍工兩個字就會變熱。對想做功課的人，熱度本身資訊量很低。比較有用的是：這家賣的是整機、零組件，還是通材？客戶是政府標案、國外商用，還是兩者都有？訂單能見度是一年內，還是只是概念？三題答完，題材才不會把所有公司焊成同一筆賭注。\"}],[[\"$\",\"figure\",\"figure-0\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"越後面越熱鬧，通常也越貴、越好離開佈局沒新聞命名故事出現擁擠人人都知退燒利多變鈍新聞出現時，常常已經不是第一段\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"示意圖｜題材四階段：佈局 → 命名 → 擁擠 → 退燒（教學結構，不是某檔實盤）\"}]]}]],[\"$\",\"div\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"先分整機、次系統、零組件與通材，不要只用國防兩個字\"}],[\"$\",\"li\",\"1\",{\"children\":\"政府標案與商用出口的節奏、揭露方式不同\"}],[\"$\",\"li\",\"2\",{\"children\":\"新聞熱度不自動等於訂單能見度\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、產品層：不要把螺絲與整機放同一格\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"有人做平台或整機，有人做雷達通訊這類次系統，有人做材料、加工或通用零件。後者可能同時出貨給民用。題材熱時，通材最容易被焊上來，因為敘述成本最低。你要先問：沒有國防新聞時，這家平常靠什麼活。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"整機或平台\"}],[\"$\",\"li\",\"1\",{\"children\":\"次系統\"}],[\"$\",\"li\",\"2\",{\"children\":\"零組件與通材\"}]]}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、客戶層：標案與商用不要共用同一張月曆\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"政府標案常有預算、決標與驗收節奏，消息一檔一檔來，中間可以很久沒有新的。商用或出口則比較像一般產業的訂單。把所有軍工都當成「國際一緊就出貨」，會把預算流程誤讀成現貨行情。先問營收認列跟哪一種客戶走。\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"客戶型態\"}],[\"$\",\"th\",\"1\",{\"children\":\"節奏比較像\"}],[\"$\",\"th\",\"2\",{\"children\":\"熱新聞時容易誤讀成\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"政府標案\"}],[\"$\",\"td\",\"1\",{\"children\":\"預算與驗收\"}],[\"$\",\"td\",\"2\",{\"children\":\"明天就出貨\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"商用或出口\"}],[\"$\",\"td\",\"1\",{\"children\":\"一般訂單\"}],[\"$\",\"td\",\"2\",{\"children\":\"一定跟地緣同一個開關\"}]]}],[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"通材兩棲\"}],[\"$\",\"td\",\"1\",{\"children\":\"民用也有單\"}],[\"$\",\"td\",\"2\",{\"children\":\"全部都是國防\"}]]}],[\"$\",\"tr\",\"3\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"還沒有單\"}],[\"$\",\"td\",\"1\",{\"children\":\"題材\"}],[\"$\",\"td\",\"2\",{\"children\":\"已經在鏈上\"}]]}]]}]]}]}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、能見度層：公告、財報、想像\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"有的公司會公告重大合約，有的只在法說會用比較含糊的句子。想像層最大聲。讀的時候把資訊分成三堆：已公告可核對、管理層描述、聊天室延伸。只有第一堆能當事實。第二堆當假設。第三堆當擁擠訊號。\"}],[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[\"$L18\",\"$L19\",\"$L1a\"]}],\"$L1b\"]]}],\"$L1c\",\"$L1d\",\"$L1e\",\"$L1f\",\"$L20\"],\"$L21\"]}]]}]}]\n18:[\"$\",\"li\",\"0\",{\"children\":\"先找可核對的合約或營收\"}]\n19:[\"$\",\"li\",\"1\",{\"children\":\"再聽管理層怎麼描述能見度\"}]\n1a:[\"$\",\"li\",\"2\",{\"children\":\"聊天室延伸只當擁擠，不當訂單\"}]\n1b:[\"$\",\"figure\",\"2\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"!通材＝整機!新聞＝出貨!標案沒中＝整家沒了\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"三種焊法\"}]]}]\n1c:[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、為什麼這題特別容易道德化\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"軍工討論常夾著價值判斷。做功課的人可以把價值判斷留給自己，把分類留給財報。混在一起，會變成「支持或反對」代替「這家到底賣什麼」。本站這篇只做後者。前者不在教學範圍。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"價值判斷與財報分類分開\"}],[\"$\",\"li\",\"1\",{\"children\":\"本篇只做分類\"}],[\"$\",\"li\",\"2\",{\"children\":\"熱度不是分類依據\"}]]}]]]}]\n1d:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、最小流程\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"看到軍工標題，寫：產品層、客戶層、能見度層。三層填得完，你才比較不像在收藏國際新聞。填不完，就承認自己還在聽題材。題材可以聽，部位不能只靠標題。\"}]]]}]\n1e:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"國際一緊，相關股票是不是就會動？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"交易上常常會動，那是題材。動不代表訂單能見度變了。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"通材算不算軍工？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"可以算邊緣。先講清楚民用佔比，再講算不算，才不會被焊住。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"標案沒中是不是就沒戲？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"單一標案不是整家公司。但若故事只靠那一標，沒中就要重寫敘述。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"和重電、航太怎麼分？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"可能重疊。仍用產品、客戶、能見度三題，不要用板塊名稱代替分類。\"}]]}]]}]]]}]\n1f:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"軍工先分產品、客戶、能見度。新聞熱度是擁擠訊號，不是訂單。通材最容易被焊上來。分類管功課，不管價值判斷。\"}]]]}]\n20:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L17\",\"0-題材輪動\",{\"href\":\"/learn/what-theme-rotation-is-actually-doing\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"題材輪動\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L17\",\"0-從眾行為\",{\"href\":\"/learn/herding-in-markets\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"從眾行為\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L17\",\"0-電動車供應鏈\",{\"href\":\"/learn/ev-supply-chain-taiwan\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"電動車供應鏈\"}]]}]]}]]]}]\n21:[\"$\",\"div\",null,{\"className\":\"LearnArticle_related__9qV55\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_relatedTitle__RXfrl\",\"children\":\"相關文章\"}],[[\"$\",\"$L17\",\"what-theme-rotation-is-actually-doing\",{\"href\":\"/learn/what-theme-rotation-is-actually-doing\",\"className\":\"LearnArticle_relatedLink__mibXe\",\"children\":\"題材輪動\"}],[\"$\",\"$L17\",\"herding-in-markets\",{\"href\":\"/learn/herding-in-markets\",\"className\":\"LearnArticle_relatedLink__mibXe\",\"children\":\"從眾行為\"}],[\"$\",\"$L17\",\"ev-supply-chain-taiwan\",{\"href\":\"/learn/ev-supply-chain-taiwan\",\"className\":\"LearnArticle_relatedLink__mibXe\",\"children\":\"電動車供應鏈\"}]]]}]\n13:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\nf:null\n22:I[80622,[],\"IconMark\"]\n11:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"軍工產業台股怎麼分類？3個問題先分，再聽題材｜股市大佬 TradeBoss\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"國際新聞一緊，軍工兩個字就會變熱。對想做功課的人，熱度本身資訊量很低。比較有用的是：這家賣的是整機、零組件，還是通材？客戶是政府標案、國外商用，還是兩者都有？訂單能見度是一年內，還是只是概念？三題答完，題材才不會把所有公司焊成同一筆賭注。\"}],[\"$\",\"link\",\"2\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}],[\"$\",\"$L22\",\"3\",{}]],\"error\":null,\"digest\":\"$undefined\"}\n16:\"$11:metadata\"\n"}