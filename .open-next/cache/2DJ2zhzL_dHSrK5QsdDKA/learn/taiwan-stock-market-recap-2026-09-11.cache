ren\":\"—\"}],[\"$\",\"td\",\"3\",{\"children\":\"領跌：3661 世芯-KY\"}]]}]\n1a:[\"$\",\"tr\",\"6\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"存託憑證\"}],[\"$\",\"td\",\"1\",{\"children\":\"-2.28%\"}],[\"$\",\"td\",\"2\",{\"children\":\"—\"}],[\"$\",\"td\",\"3\",{\"children\":\"—\"}]]}]\n1b:[\"$\",\"tr\",\"7\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"其他電子類\"}],[\"$\",\"td\",\"1\",{\"children\":\"-2.06%\"}],[\"$\",\"td\",\"2\",{\"children\":\"—\"}],[\"$\",\"td\",\"3\",{\"children\":\"領跌：6226 光鼎\"}]]}]\n1c:[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、個股表現：漲幅榜集中在小檔，跌幅榜出現運動與半導體\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"今日漲幅較大的股票包括惠特（6706）+10.00%、華經（2468）+9.98%、勝德（3296）+9.94%、晟鈦（3229）+9.93%、閎暉（3311）+9.89%、恩德（1528）+9.84%，成交量多在 400～10000 張區間。跌幅榜方面，世芯-KY（3661）-9.99%、巨大（9921）-9.97%、美利達（9914）-9.95%、沛爾生醫-創（6949）-9.86%、永道-KY（6863）-8.06%、光鼎（6226）-7.98%（成交 41,710 張）。這是今天已發生的結果，公開資料看不出單一原因。\"}],[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"6706 惠特 +10.00%（量 6,196 張）\"}],[\"$\",\"li\",\"1\",{\"children\":\"2468 華經 +9.98%（量 4,234 張）\"}],[\"$\",\"li\",\"2\",{\"children\":\"3661 世芯-KY -9.99%（量 5,595 張）\"}],[\"$\",\"li\",\"3\",{\"children\":\"9921 巨大 -9.97%（量 5,413 張）\"}],[\"$\",\"li\",\"4\",{\"children\":\"6226 光鼎 -7.98%（量 41,710 張）\"}]]}],[\"$\",\"figure\",\"2\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"✓看族群漲跌幅✓查個股量比變化✓比對國際盤方向✓記下融資維持率\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"收盤後可以做的事\"}]]}]]]}]\n1d:[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、法人與籌碼：外資、自營商同日賣超，臺指期淨空 8.5 萬口\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"外資現貨買賣超約 -331,008 張（賣超），自營商現貨買賣超約 -247,401 張（賣超），兩方方向一致。臺指期外資淨空單 85,067 口。全市場融資維持率 189.2%。以上是今天已發生的數字，外資賣超與指數下跌是同日同時發生的現象，公開資料不足以判定單一因果。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"外資現貨：賣超約 331,008 張\"}],[\"$\",\"li\",\"1\",{\"children\":\"自營商現貨：賣超約 247,401 張\"}],[\"$\",\"li\",\"2\",{\"children\":\"臺指期外資：淨空單 85,067 口\"}],[\"$\",\"li\",\"3\",{\"children\":\"融資維持率：189.2%\"}]]}]]]}]\n1e:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、國際盤與消息面：費半跌 2.66%，亞洲股市同步偏弱\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"國際盤方面，S&P 500 跌 0.58%、那斯達克跌 0.65%、費城半導體指數跌 2.66%；亞洲方面，韓國 KOSPI 跌 1.76%、日經 225 跌 1.93%。費半跌幅明顯大於一般美股，與今天台股半導體族群 -2.29% 的表現方向一致。消息面方面，今日臺股相關新聞包括凌陽（2401）8 月營收 6.88 億元（月增 -7.73%、年增 40.95%）、漢唐 8 月營收 93.92 億元（年增 59.05%）、輔信（2405）前 8 月營收年增逾 8%。近三日川普／美國政策相關標題涉及 AI 與中國競爭、對加拿大貿易戰等議題，與臺股直接關聯有限。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"S&P 500 -0.58%、那斯達克 -0.65%、費城半導體 -2.66%\"}],[\"$\",\"li\",\"1\",{\"children\":\"KOSPI -1.76%、日經 225 -1.93%\"}],[\"$\",\"li\",\"2\",{\"children\":\"凌陽 8 月營收 6.88 億（月增 -7.73%）\"}],[\"$\",\"li\",\"3\",{\"children\":\"漢唐 8 月營收 93.92 億（年增 59.05%）\"}],[\"$\",\"li\",\"4\",{\"children\":\"輔信前 8 月營收年增逾 8%\"}]]}]]]}]\n1f:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"今天台股為什麼跌？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"今天加權跌 1.60%，722 檔下跌、218 檔上漲，屬於普跌格局。外資現貨賣超 33.1 萬張、臺指期淨空 8.5 萬口，與指數下跌同日發生。國際盤費城半導體跌 2.66%、日經跌 1.93%，方向一致。公開資料看不出單一原因，是多方因素同時出現的結果。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"外資今天買賣超多少？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"外資現貨買賣超約 -331,008 張（賣超），自營商現貨賣超約 -247,401 張。臺指期外資淨空單 85,067 口。以上是今天收盤後公開的數字。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"哪些族群今天逆勢上漲？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"數位雲端類 +1.39%（3 檔，領漲 6870 騰雲）、金融保險 +1.29%（31 檔，領漲 2801 彰銀）、資訊服務業 +0.98%（42 檔，領漲 2468 華經）、航運業 +0.27%（30 檔，領漲 2609 陽明）。這是今天已發生的結果。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"臺指期外資淨空多少口？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"今天台指期外資淨空單 85,067 口，臺指期收 46218.0 點（-1.39%），未平倉合約 88,464 口。這是今天收盤後的公開數據。\"}]]}],[\"$\",\"details\",\"4\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"今天成交金額多少？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"上市成交金額約 6810.0 億元。融資維持率 189.2%。以上是今天已發生的數字。\"}]]}]]}]]]}]\n20:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"2026/9/11 臺股是一檔普跌日：加權跌 1.60%、722 檔收黑，外資與自營商同日賣超，半導體與運動休閒族群跌幅居前；數位雲端與金融保險逆勢收紅，是今天少見的亮點。\"}]]]}]\n21:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[