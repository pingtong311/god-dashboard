],[\"$\",\"li\",\"sec-2\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-2\",\"children\":\"二、三個不可知要寫進規則\"}]}],[\"$\",\"li\",\"sec-3\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-3\",\"children\":\"三、後見之明是黑天鵝的配套\"}]}],[\"$\",\"li\",\"sec-4\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-4\",\"children\":\"四、不要把這本書讀成做空指南\"}]}],[\"$\",\"li\",\"sec-5\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-5\",\"children\":\"五、最小動作\"}]}],[\"$\",\"li\",\"sec-6\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-6\",\"children\":\"常見問題 FAQ\"}]}],[\"$\",\"li\",\"sec-7\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-7\",\"children\":\"總結\"}]}],[\"$\",\"li\",\"sec-8\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-8\",\"children\":\"延伸閱讀\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"LearnArticle_body__6B7Mb\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_intro__ATV5c\",\"children\":\"納西姆·塔雷伯的《黑天鵝》讓這個詞進入日常。原意比較刺：真正改變路徑的事件，事前難以列入模型，事後人人都說早知道。對交易的提醒不是去猜下一隻長什麼樣子，是承認你的規則必須在「沒列入的事情發生」時還能讓你留在桌子上。猜中黑天鵝是傳奇；活過黑天鵝是結構。\"}],[],[\"$\",\"div\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"模型外的事件會發生，事後看起來會很合理\"}],[\"$\",\"li\",\"1\",{\"children\":\"不要用「從來沒發生過」當成安全證明\"}],[\"$\",\"li\",\"2\",{\"children\":\"規則要先假設離開變慢、相關性變高\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、詞被用爛之後還剩什麼\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"後來什麼大跌都被叫黑天鵝。公開定義較嚴：事前難以想像、衝擊大、事後可被編故事。把日常回撤都叫黑天鵝，只是在為自己的沒準備找名字。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"不是所有大跌都算\"}],[\"$\",\"li\",\"1\",{\"children\":\"事後故事很會編\"}],[\"$\",\"li\",\"2\",{\"children\":\"名字不能當準備\"}]]}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、三個不可知要寫進規則\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"第一，你可能沒有對手。第二，你以為分開的東西可能一起跌。第三，你的歷史樣本可能剛好沒包含這種日子。三句都在黑色星期一、海嘯、熔斷那幾篇出現過。塔雷伯給的是哲學名字，檢查清單仍然很土。\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"你常講的\"}],[\"$\",\"th\",\"1\",{\"children\":\"不可知翻譯\"}],[\"$\",\"th\",\"2\",{\"children\":\"規則怎麼寫\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"從來沒這樣過\"}],[\"$\",\"td\",\"1\",{\"children\":\"樣本剛好沒遇到\"}],[\"$\",\"td\",\"2\",{\"children\":\"假設會遇到\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"最壞就是回測那次\"}],[\"$\",\"td\",\"1\",{\"children\":\"回測沒有未發生的\"}],[\"$\",\"td\",\"2\",{\"children\":\"把最壞再加一檔\"}]]}],[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"分散過了\"}],[\"$\",\"td\",\"1\",{\"children\":\"壞日子相關性上升\"}],[\"$\",\"td\",\"2\",{\"children\":\"加總上限\"}]]}],[\"$\",\"tr\",\"3\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"到時再說\"}],[\"$\",\"td\",\"1\",{\"children\":\"到時可能走不掉\"}],[\"$\",\"td\",\"2\",{\"children\":\"事先減尺寸\"}]]}]]}]]}]}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、後見之明是黑天鵝的配套\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"事件結束後，解釋會變得很順。順的解釋會讓你以為下次看得到。後見之明那篇就是配套教材。能做的是事前寫下「我現在不知道什麼」，不是事後加入先知名單。\"}],[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"事前寫不知道什麼\"}],[\"$\",\"li\",\"1\",{\"children\":\"事後對照有沒有新編故事\"}],[\"$\",\"li\",\"2\",{\"children\":\"不把新故事當下次的預警系統\"}]]}],[\"$\",\"figure\",\"2\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"✓尺寸先小✓加總上限✓不當英雄\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"規則末行\"}]]}]]]}],[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[\"$L18\",[\"$L19\",\"$L1a\"]]}],\"$L1b\",\"$L1c\",\"$L1d\",\"$L1e\"],\"$L1f\"]}]]}]}]\n18:[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、不要把這本書讀成做空指南\"}]\n19:[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"傳播有時把它讀成「要去賭極端」。公開論點更靠近：不要讓極端輕易要你的命。方向與工具是另一題。本站不建議任何人去賭極端事件。\"}]\n1a:[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"生存先於預測\"}],[\"$\",\"li\",\"1\",{\"children\":\"賭極端是另一種集中\"}],[\"$\",\"li\",\"2\",{\"children\":\"本篇只談生存\"}]]}]\n1b:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、最小動作\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"在規則末尾加一行：若連續無法成交或相關資產一起動，我的尺寸事先就已經小到不必在當天做英雄。寫得出來，黑天鵝才不是形容詞。\"}]]]}]\n1c:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"下次黑天鵝會是什麼？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"若能具體講出來，就比較不像原意。能做的是讓未知發生時你還在。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"保險或選擇權是不是答案？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"那是工具題，各有成本。本篇不建議任何商品。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"和熔斷、流動性文重複嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"事件文講機制；這篇講為什麼你的模型會漏。可互為目錄。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"歷史回測能抓黑天鵝嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"回測只能看到已發生的。沒發生的，要靠假設與尺寸。\"}]]}]]}]]]}]\n1d:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"黑天鵝提醒的是不可知與事後故事。三句寫進規則：可能沒對手、可能一起跌、樣本可能沒包含那天。猜中是傳奇，活過是結構。\"}]]]}]\n1e:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L17\",\"0-黑色星期一\",{\"href\":\"/learn/black-monday-1987-liquidity-vanishes-first\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"黑色星期一\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L17\",\"0-後見之明\",{\"href\":\"/learn/hindsight-bias-in-trading\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"後見之明\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L17\",\"0-熔斷機制\",{\"href\":\"/learn/what-circuit-breaker-really-does\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"熔斷機制\"}]]}]]}]]]}]\n1f:[\"$\",\"div\",null,{\"className\":\"LearnArticle_r