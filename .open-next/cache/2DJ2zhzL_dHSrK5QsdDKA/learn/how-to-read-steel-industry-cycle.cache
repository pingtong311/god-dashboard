hildren\":[\"$\",\"a\",null,{\"href\":\"#sec-2\",\"children\":\"二、判斷循環第一招：看懂原物料「鐵礦砂價格」\"}]}],[\"$\",\"li\",\"sec-3\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-3\",\"children\":\"三、第二招：用「BDI 指數」看全球貿易熱度\"}]}],[\"$\",\"li\",\"sec-4\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-4\",\"children\":\"四、第三招：盯緊「中國鋼材庫存」的增減\"}]}],[\"$\",\"li\",\"sec-5\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-5\",\"children\":\"五、如何整合三個指標，看懂鋼鐵循環四階段？\"}]}],[\"$\",\"li\",\"sec-6\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-6\",\"children\":\"常見問題 FAQ\"}]}],[\"$\",\"li\",\"sec-7\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-7\",\"children\":\"總結\"}]}],[\"$\",\"li\",\"sec-8\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-8\",\"children\":\"延伸閱讀\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"LearnArticle_body__6B7Mb\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_intro__ATV5c\",\"children\":\"看到新聞說鋼鐵報價大漲，相關股票也跟著紅通通，好像不追不行？但為什麼常常一買進就風雲變色，讓你套在山頂上？這就是因為你沒看懂「景氣循環」，本文將教你用 3 個指標判斷鋼鐵業現在走到哪個階段，讓你不再只憑感覺進出。\"}],[],[\"$\",\"div\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"鋼鐵股是典型的景氣循環股，股價波動大，不能用存股思維操作。\"}],[\"$\",\"li\",\"1\",{\"children\":\"觀察三大領先指標：鐵礦砂價格、波羅的海乾散貨指數 (BDI)、中國鋼材社會庫存。\"}],[\"$\",\"li\",\"2\",{\"children\":\"當鐵礦砂與 BDI 指數從低檔反轉向上，且庫存開始下降，通常是景氣復甦的初期訊號。\"}],[\"$\",\"li\",\"3\",{\"children\":\"股價往往領先基本面反應，當利多消息滿天飛時，可能已是循環高點，需留意風險。\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、為什麼鋼鐵股不能「存」，而是要看「循環」？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"很多人買股票喜歡找龍頭廠長期持有，但這套用在鋼鐵股上很容易受傷。鋼鐵業的需求與全球經濟活動緊密相連，有明顯的繁榮與衰退週期。在景氣好時，鋼廠賺飽飽，股價大漲；景氣差時，需求萎縮，可能連續好幾季虧損，股價也會大幅修正。因此，操作鋼鐵股的關鍵不是「公司好不好」，而是「現在景氣在哪個位置」。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"景氣好：基礎建設、房地產、汽車業需求旺盛。\"}],[\"$\",\"li\",\"1\",{\"children\":\"景氣差：全球經濟放緩，各行各業縮減資本支出。\"}],[\"$\",\"li\",\"2\",{\"children\":\"股價反應：通常會領先實際財報半年到一年。\"}]]}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、判斷循環第一招：看懂原物料「鐵礦砂價格」\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"鐵礦砂是煉鋼最重要的原料，佔成本極高比例。它的價格走勢，就像是鋼鐵業的「麵粉價」。當鐵礦砂價格從谷底翻揚，代表下游需求開始回溫，鋼廠準備增產，是景氣復甦的領先訊號。反之，若價格持續破底，表示需求疲弱，景氣仍在下行階段。你可以觀察國際鐵礦砂期貨報價，注意趨勢的轉變。\"}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、第二招：用「BDI 指數」看全球貿易熱度\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"鐵礦砂、煤炭這些大宗原物料，都要靠海運散裝船運輸，所以運費的變化能反映全球貿易的熱絡程度。波羅的海乾散貨指數（BDI, Baltic Dry Index）就是衡量散裝航運運價的關鍵指標。當 BDI 指數連續上漲，代表全球原物料需求強勁，鋼鐵需求也可能同步增溫，是個重要的輔助觀察指標。\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"指標名稱\"}],[\"$\",\"th\",\"1\",{\"children\":\"代表意義\"}],[\"$\",\"th\",\"2\",{\"children\":\"觀察重點\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"鐵礦砂價格\"}],[\"$\",\"td\",\"1\",{\"children\":\"鋼鐵生產成本與直接需求\"}],[\"$\",\"td\",\"2\",{\"children\":\"趨勢是否由跌轉升\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"BDI 指數\"}],[\"$\",\"td\",\"1\",{\"children\":\"全球原物料運輸熱度\"}],[\"$\",\"td\",\"2\",{\"children\":\"是否與鐵礦砂同步上揚\"}]]}],[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"中國鋼材庫存\"}],[\"$\",\"td\",\"1\",{\"children\":\"終端市場的消化能力\"}],[\"$\",\"td\",\"2\",{\"children\":\"庫存是否由增轉減\"}]]}]]}]]}]}],[\"$\",\"figure\",\"2\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[\"$L18\",\"$L19\"]}]]]}],\"$L1a\",\"$L1b\",\"$L1c\",\"$L1d\",\"$L1e\"],null]}]]}]}]\n18:[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"!1. 庫存由降轉升!2. 報價利多卻不漲!3. BDI 指數領先下彎\"}]\n19:[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"小心！景氣反轉的 3 個警訊\"}]\n1a:[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、第三招：盯緊「中國鋼材庫存」的增減\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"中國是全球最大的鋼鐵生產國與消費國，它的庫存數據極具參考價值。「中國鋼材社會庫存」反映了市場上還沒被賣掉的鋼材數量。如果庫存持續下降，代表終端需求強勁，鋼廠出貨順暢，是景氣熱絡的象徵。但如果庫存開始堆積、由降轉升，就要小心了，這可能是需求觸頂、供給過剩的警訊，景氣可能即將反轉。\"}]]]}]\n1b:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、如何整合三個指標，看懂鋼鐵循環四階段？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"單看一個指標可能會誤判，最好的方式是將三者整合起來，描繪出景氣循環的全貌。從復甦期、繁榮期、衰退期到蕭條期，每個階段的指標表現都不同。學會判斷當下所處的階段，才能幫助你做出相對應的投資決策，而不是等到新聞報最大的利多時才跳進去。\"}],[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"復甦期：鐵礦砂、BDI 止跌回升，庫存開始下降。股價通常在此時發動。\"}],[\"$\",\"li\",\"1\",{\"children\":\"繁榮期：鐵礦砂、BDI 持續上漲，庫存維持低檔。財報數字亮眼，利多消息頻傳。\"}],[\"$\",\"li\",\"2\",{\"children\":\"衰退期：鐵礦砂、BDI 從高點回落，庫存開始累積。股價領先反應，出現下跌。\"}],[\"$\",\"li\",\"3\",{\"children\":\"蕭條期：鐵礦砂、BDI 在低檔盤整，庫存偏高。財報難看，市場氣氛悲觀。\"}]]}]]]}]\n1c:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"鋼鐵股可以定期定額嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"比較不建議。因為鋼鐵股的景氣循環特性，股價波動非常大。若在景氣高點開始定期定額，可能會經歷很長的虧損期。這種股票比較適合在景氣谷底佈局，並在繁榮期分批出場，屬於波段操作的類型。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"這些指標要去哪裡查？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"國際鐵礦砂價格、BDI 指數都可以在國際財經網站上找到即時報價。中國鋼材庫存數據則可以透過產業資訊網站或券商報告取得。股市大佬的「族群透視」功能，也為會員整理了相關的關鍵圖表。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"除了這三個指標，還有其他參考嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"有的。例如可以觀察主要鋼廠的「盤價」，也就是鋼廠每個月或每季開出的產品價格，盤價連續上漲代表市況良好。另外，觀察美國、中國的基礎建設計畫或製造業採購經理人指數 (PMI)，也能幫助判斷終端需求。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"為什麼有時候鋼價漲，但股價卻不漲？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"這就是所謂的「利多出盡」。市場的資金很聰明，股價通常會提早反應預期。當鋼價上漲的消息已經被市場消化完畢，或是大家預期未來成長力道將減緩時，即使當下報價還在高檔，股價也可能先行回落。\"}]]}]]}]]]}]\n1d:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"總結來說，操作鋼鐵股的核心是「判斷景氣位階」，而不是「挑選好公司」。與其追逐新聞消息，不如建立自己的觀察清單，定期追蹤鐵礦砂、BDI 指數與中國庫存這三大領先指標。當指標從谷底翻揚時保持關注，當指標在高檔反轉時提高警覺，才能有效提升決策品質。\"}]]]}]\n1e:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L17\",\"0-在族群透視頁追蹤\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"在族群透視頁追蹤關鍵數據\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L17\",\"0-到個股透視頁查詢\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"到個股透視頁查詢財報狀況\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L17\",\"0-學習更多景氣循環\",{\"href\":\"/learn\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"學習更多景氣循環股知識\"}]]}]]}]]]}]\n13:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\nf:null\n1f:I[80622,[],\"IconMark\"]\n11:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"鋼鐵股怎麼看循環位階？3 個關鍵數字看懂景氣｜股市大佬 TradeBoss\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"看到新聞說鋼鐵報價大漲，相關股票也跟著紅通通，好像不追不行？但為什麼常常一買進就風雲變色，讓你套在山頂上？這就是因為你沒看懂「景氣循環」，本文將教你用 3 個指標判斷鋼鐵業現在走到哪個階段，讓你不再只憑感覺進出。\"}],[\"$\",\"link\",\"2\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}],[\"$\",\"$L1f\",\"3\",{}]],\"error\":null,\"digest\":\"$undefined\"}\n16:\"$11:metadata\"\n"}