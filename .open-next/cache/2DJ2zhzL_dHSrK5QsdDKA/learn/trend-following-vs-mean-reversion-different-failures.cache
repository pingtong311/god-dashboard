ildren\":[[\"$\",\"summary\",null,{\"className\":\"LearnArticle_tocSummary__YBddG\",\"children\":\"本文目錄\"}],[\"$\",\"ol\",null,{\"className\":\"LearnArticle_tocList__Rq_Lz\",\"children\":[[\"$\",\"li\",\"sec-1\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-1\",\"children\":\"一、先用一句話分開兩套邏輯\"}]}],[\"$\",\"li\",\"sec-2\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-2\",\"children\":\"二、失敗長相不一樣，檢討方式也不該一樣\"}]}],[\"$\",\"li\",\"sec-3\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-3\",\"children\":\"三、市況不匹配，看起來會像你不會做\"}]}],[\"$\",\"li\",\"sec-4\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-4\",\"children\":\"四、部位公式也要跟著失敗長相走\"}]}],[\"$\",\"li\",\"sec-5\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-5\",\"children\":\"五、不要追求「兩個優點都要」\"}]}],[\"$\",\"li\",\"sec-6\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-6\",\"children\":\"常見問題 FAQ\"}]}],[\"$\",\"li\",\"sec-7\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-7\",\"children\":\"總結\"}]}],[\"$\",\"li\",\"sec-8\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-8\",\"children\":\"延伸閱讀\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"LearnArticle_body__6B7Mb\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_intro__ATV5c\",\"children\":\"順勢想做的是：走出來的行情繼續走，用一連串小代價換少數大段。逆勢想做的是：走太遠的價格比較容易回來，用比較高的勝率換單次可能較大的風險。兩套都可以寫成規則，也都可以虧錢。真正要把策略選對，先問你比較受不了哪一種失敗——連虧很多次，還是偶爾虧很大一次。選錯痛覺，再好的期望值你也執行不完。\"}],[[\"$\",\"figure\",\"figure-0\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"虧 3 次每次 −1%賺 2 次每次 +1%勝率 40% 也可能是正期望，前提是賺的比虧的大、且扣得起成本短線先扣約 0.24% 當沖成本，再看還剩多少\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"示意圖｜期望值：勝率要配上平均賺賠，再扣成本（教學結構，不是某檔實盤）\"}]]}]],[\"$\",\"div\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"順勢的日常常是連虧，逆勢的風險常在單筆過大\"}],[\"$\",\"li\",\"1\",{\"children\":\"用你受得了的失敗長相選策略，不要用誰比較神來選\"}],[\"$\",\"li\",\"2\",{\"children\":\"同一套規則，換到不適合的市況，失敗會看起來像「你不會做」\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、先用一句話分開兩套邏輯\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"順勢假設：價格離開區間之後，後續移動仍可能對你有利，所以錯了先用小停損離開，對了才讓它跑。逆勢假設：價格離開合理區之後比較容易回來，所以你是在比較極端的位置接，錯了可能要付比較大的代價。兩句話都不是真理，只是適用邊界不同。沒有邊界的策略討論，最後都會變成口號比賽。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"順勢用小虧換少數大段\"}],[\"$\",\"li\",\"1\",{\"children\":\"逆勢用較高勝率換單筆可能較大的風險\"}],[\"$\",\"li\",\"2\",{\"children\":\"先講邊界，再講誰比較厲害\"}]]}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、失敗長相不一樣，檢討方式也不該一樣\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"順勢在盤整市會連續停損，資金曲線像被砂紙磨。逆勢在單邊市會遇到「它不回來得更遠」，單筆虧損突然變醜。若你用逆勢的痛覺去檢討順勢，會在最該付成本的階段放棄；若你用順勢的痛覺去檢討逆勢，會在單筆風險爆掉前還覺得勝率看起來不錯。策略解析最有用的一步，就是先承認這兩種紅字不是同一種病。\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"策略\"}],[\"$\",\"th\",\"1\",{\"children\":\"好日子長什麼樣\"}],[\"$\",\"th\",\"2\",{\"children\":\"失敗長什麼樣\"}],[\"$\",\"th\",\"3\",{\"children\":\"最容易做錯的檢討\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"順勢\"}],[\"$\",\"td\",\"1\",{\"children\":\"少數大段蓋過一串小虧\"}],[\"$\",\"td\",\"2\",{\"children\":\"盤整連虧、假突破\"}],[\"$\",\"td\",\"3\",{\"children\":\"連虧就換方法\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"逆勢\"}],[\"$\",\"td\",\"1\",{\"children\":\"多次小賺、勝率看起來高\"}],[\"$\",\"td\",\"2\",{\"children\":\"單邊走太遠、單筆很大\"}],[\"$\",\"td\",\"3\",{\"children\":\"勝率高就加大\"}]]}],[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"混用卻沒規則\"}],[\"$\",\"td\",\"1\",{\"children\":\"偶爾都對\"}],[\"$\",\"td\",\"2\",{\"children\":\"兩種失敗一起出現\"}],[\"$\",\"td\",\"3\",{\"children\":\"覺得自己兩個都會\"}]]}]]}]]}]}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、市況不匹配，看起來會像你不會做\"}],[\"$L19\",\"$L1a\",\"$L1b\"]]}],\"$L1c\",\"$L1d\",\"$L1e\",\"$L1f\",\"$L20\"],\"$L21\"]}]]}]}]\n19:[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"同一套順勢規則，在明確波段裡像天才，在狹幅震盪裡像笨蛋。同一套逆勢規則相反。所以「最近都不行」要先問市況，再問自己。沒有市況標籤的檢討，會讓你永遠在兩套方法之間跳，永遠湊不滿乾淨樣本。比較笨的做法是：先選一種當主策略，用一段固定時間只評它，並事先寫它最怕哪種市況。怕的市況出現，減碼或停用，不是臨時發明另一套。\"}]\n1a:[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"主策略先只選一種\"}],[\"$\",\"li\",\"1\",{\"children\":\"寫下它最怕的市況\"}],[\"$\",\"li\",\"2\",{\"children\":\"怕的市況出現就減碼或停，不臨場混用\"}]]}]\n1b:[\"$\",\"figure\",\"2\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"✓我比較怕哪種紅字✓部位撐不撐得過✓怕的市況怎麼停\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"選策略三問\"}]]}]\n1c:[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、部位公式也要跟著失敗長相走\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"順勢若單筆太大，連虧幾次就會逼你改規則，系統還沒碰到大段就先死。逆勢若單筆太大，一次不回歸就能把前面的勝率全部吐掉。所以部位不是美學，是讓你活過該策略最醜階段的工具。很多人策略選對、部位選成另一套，於是兩種失敗他都嚐得到。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"順勢要把連虧次數算進單筆上限\"}],[\"$\",\"li\",\"1\",{\"children\":\"逆勢要把「它還能再走多遠」算進單筆上限\"}],[\"$\",\"li\",\"2\",{\"children\":\"部位跟策略不匹配，等於沒選策略\"}]]}]]]}]\n1d:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、不要追求「兩個優點都要」\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"又要高勝率、又要大賺、又要連虧很少、又要單筆很小，這不是策略，是願望清單。能成功的做法通常只選一種痛來承受，並把另一種痛用規則拒絕。你要的是可執行的不完整，不是紙上完美。把願望清單拿去回測，也會逼出過度最佳化：參數看起來兩個優點都有，一上實盤就兩個缺點都來。\"}]]]}]\n1e:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"哪一種比較適合新手？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"看你比較受不了哪一種痛。受不了連虧，順勢會很難做完；受不了單筆大虧，逆勢會很難做完。先用小部位驗證痛覺，再談適不適合。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"可以兩個都做嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"可以，但要分開帳戶或分開額度，並且各自有停用條件。混在同一筆決策裡，通常會變成盤中即興。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"怎麼判斷現在是趨勢還是盤整？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"沒有完美開關。比較誠實的是用事前定義的粗濾網，例如波動與區間寬度，並且接受濾網會錯。濾網錯了就減碼，不要改寫歷史。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"突破算順勢還是逆勢？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"突破後順勢做下去，比較接近順勢。在突破失敗處立刻反向接，比較接近逆勢。同一根 K 線可以走出兩套完全不同的後續規則。\"}]]}]]}]]]}]\n1f:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"順勢與逆勢的差別，首先是失敗長相不同。用你受得了的痛來選策略，用部位活過最醜階段，不要追求兩個優點都要。市況不匹配時，先減碼，不要臨場混用。\"}]]]}]\n20:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L18\",\"0-趨勢交易者怎麼看\",{\"href\":\"/learn/how-trend-traders-think-about-losing-streaks\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"趨勢交易者怎麼看連虧\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L18\",\"0-期望值\",{\"href\":\"/learn/what-is-expectancy-in-trading\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"期望值\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L18\",\"0-策略失效怎麼判斷\",{\"href\":\"/learn/how-to-tell-if-a-strategy-is-broken\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"策略失效怎麼判斷\"}]]}]]}]]]}]\n21:[\"$\",\"div\",null,{\"className\":\"LearnArticle_related__9qV55\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_relatedTitle__RXfrl\",\"children\":\"相關文章\"}],[[\"$\",\"$L18\",\"how-trend-traders-think-about-losing-streaks\",{\"href\":\"/learn/how-trend-traders-think-about-losing-streaks\",\"className\":\"LearnArticle_relatedLink__mibXe\",\"children\":\"趨勢交易者怎麼看連虧\"}],[\"$\",\"$L18\",\"what-is-expectancy-in-trading\",{\"href\":\"/learn/what-is-expectancy-in-trading\",\"className\":\"LearnArticle_relatedLink__mibXe\",\"children\":\"期望值\"}],[\"$\",\"$L18\",\"how-to-tell-if-a-strategy-is-broken\",{\"href\":\"/learn/how-to-tell-if-a-strategy-is-broken\",\"className\":\"LearnArticle_relatedLink__mibXe\",\"children\":\"策略失效怎麼判斷\"}]]]}]\n14:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\n10:null\n22:I[80622,[],\"IconMark\"]\n12:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"順勢和逆勢差在哪？兩套策略的失敗方式完全不同｜股市大佬 TradeBoss\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"順勢想做的是：走出來的行情繼續走，用一連串小代價換少數大段。逆勢想做的是：走太遠的價格比較容易回來，用比較高的勝率換單次可能較大的風險。兩套都可以寫成規則，也都可以虧錢。真正要把策略選對，先問你比較受不了哪一種失敗——連虧很多次，還是偶爾虧很大一次。選錯痛覺，再好的期望值你也執行\"}],[\"$\",\"link\",\"2\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}],[\"$\",\"$L22\",\"3\",{}]],\"error\":null,\"digest\":\"$undefined\"}\n17:\"$12:metadata\"\n"}