}],[\"$\",\"ol\",null,{\"className\":\"LearnArticle_tocList__Rq_Lz\",\"children\":[[\"$\",\"li\",\"sec-1\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-1\",\"children\":\"一、為什麼搞懂這些日期很重要？錯過一天，股利一塊都領不到\"}]}],[\"$\",\"li\",\"sec-2\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-2\",\"children\":\"二、除權、除息差在哪？現金和股票怎麼分？\"}]}],[\"$\",\"li\",\"sec-3\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-3\",\"children\":\"三、如何計算除權息參考價？為什麼股價會下跌？\"}]}],[\"$\",\"li\",\"sec-4\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-4\",\"children\":\"四、什麼是「填息」？領到股利不代表真的賺錢\"}]}],[\"$\",\"li\",\"sec-5\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-5\",\"children\":\"五、股利發放日要做什麼？錢會自動進來嗎？\"}]}],[\"$\",\"li\",\"sec-6\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-6\",\"children\":\"常見問題 FAQ\"}]}],[\"$\",\"li\",\"sec-7\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-7\",\"children\":\"總結\"}]}],[\"$\",\"li\",\"sec-8\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-8\",\"children\":\"延伸閱讀\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"LearnArticle_body__6B7Mb\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_intro__ATV5c\",\"children\":\"公司宣布配息是好消息，但打開行事曆，「除權息日」、「基準日」、「發放日」這些名詞看得眼花撩亂，到底哪天買進才有得分？錢什麼時候才會進戶頭？這篇一次幫你整理清楚。\"}],[[\"$\",\"figure\",\"figure-0\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"沒扣成本的勝率，看起來都會比較漂亮0.029%手續費 1 折來回0.15%當沖證交稅0.06%滑價估計三項合計約 0.24%；留倉稅率更高，約 0.39%\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"示意圖｜當沖來回成本：1 折手續費 + 證交稅 + 滑價（教學結構，不是某檔實盤）\"}]]}]],[\"$\",\"div\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"想領取股利，最晚要在「除權息交易日」的前一個營業日買進並持有。\"}],[\"$\",\"li\",\"1\",{\"children\":\"除權息當天股價會下跌，總資產不變，要等股價漲回來的「填息」才算真正獲利。\"}],[\"$\",\"li\",\"2\",{\"children\":\"從除權息日到你實際拿到股利，通常需要等待 1 到 2 個月。\"}],[\"$\",\"li\",\"3\",{\"children\":\"股利發放日當天，現金股利會自動匯入你的證券交割銀行戶頭，不用另外申請。\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、為什麼搞懂這些日期很重要？錯過一天，股利一塊都領不到\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"每年股東會後，公司會公布當年度的配息政策，接著就是一連串的日期。其中最重要的就是「除權息交易日」，這天是決定你是否能領到股利的資格分水嶺。只要在這天之前持有股票，你就在股東名冊上，公司就會把股利分給你。\"}],[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"股東會決議：決定要不要發、發多少。\"}],[\"$\",\"li\",\"1\",{\"children\":\"董事會公告：訂下除權息的明確日期。\"}],[\"$\",\"li\",\"2\",{\"children\":\"除權息交易日：最關鍵的一天，當天開盤前持有股票者才有資格。\"}],[\"$\",\"li\",\"3\",{\"children\":\"最後過戶日：交易日後兩天（T+2），完成股權登記。\"}],[\"$\",\"li\",\"4\",{\"children\":\"停止過戶期間：公司整理股東名冊，通常為期五天。\"}],[\"$\",\"li\",\"5\",{\"children\":\"除權息基準日：名冊整理好的最後一天。\"}],[\"$\",\"li\",\"6\",{\"children\":\"股利發放日：公司把錢或股票發給你的日子。\"}]]}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、除權、除息差在哪？現金和股票怎麼分？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"「除權息」是個統稱，其實可以拆成「除息」和「除權」兩種。簡單來說，「除息」是發放現金，「除權」是發放股票。兩種方式都會讓公司總市值下降，所以股價會在交易日當天向下調整，以反映發出去的價值。\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"項目\"}],[\"$\",\"th\",\"1\",{\"children\":\"除息 (發現金股利)\"}],[\"$\",\"th\",\"2\",{\"children\":\"除權 (發股票股利)\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"股東拿到什麼\"}],[\"$\",\"td\",\"1\",{\"children\":\"現金，直接匯入銀行戶頭\"}],[\"$\",\"td\",\"2\",{\"children\":\"額外的股票，存入集保帳戶\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"對股價的影響\"}],[\"$\",\"td\",\"1\",{\"children\":\"股價會減去「現金股利」金額\"}],[\"$\",\"td\",\"2\",{\"children\":\"股價會因「股本膨脹」而降低\"}]]}],[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"舉例說明\"}],[\"$\",\"td\",\"1\",{\"children\":\"股價 100 元，配息 5 元。除息後參考價變 95 元。\"}],[\"$\",\"td\",\"2\",{\"children\":\"股價 100 元，配股 1 元 (等於每千股送 100 股)。除權後參考價變 100 / (1+0.1) ≈ 90.9 元。\"}]]}]]}]]}]}]]]}],\"$L18\",\"$L19\",\"$L1a\",\"$L1b\",\"$L1c\",\"$L1d\"],null]}]]}]}]\n18:[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、如何計算除權息參考價？為什麼股價會下跌？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"很多人會在除權息當天嚇一跳，以為自己的股票大跌了。其實這是正常的價格調整，因為公司把一部分價值發還給股東，股價自然要扣除這部分。你的總資產其實沒有變，只是從「全部是股票」變成「股票＋現金」。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"除息參考價計算：前一天收盤價 - 現金股利。例如：收盤價 120 元，配息 3 元，隔天參考價就是 117 元。\"}],[\"$\",\"li\",\"1\",{\"children\":\"除權參考價計算：前一天收盤價 ÷ (1 + 股票股利 ÷ 10)。例如：收盤價 100 元，配股 1 元，隔天參考價就是 100 ÷ (1 + 1/10) = 90.9 元。\"}],[\"$\",\"li\",\"2\",{\"children\":\"常見錯誤：把除權息的價格下跌當成虧損。這只是資產形式的轉換，真正的賺賠要看後續股價是否「填息」。\"}]]}],[\"$\",\"figure\",\"2\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"✓確認除權息日期✓算好最晚買進日✓檢查交割銀行帳戶✓留意股價是否填息\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"股利入袋檢查清單\"}]]}]]]}]\n19:[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、什麼是「填息」？領到股利不代表真的賺錢\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"領到股利固然開心，但這不代表你的投資已經獲利。前面提到，股價會因除權息而下跌，形成一個「除權息缺口」。如果未來股價漲回除權息前的價位，這個過程就叫做「填息」。成功填息，你拿到的股利才算是真正多出來的獲利。反之，如果股價一直沒漲回來，甚至繼續下跌，那就叫「貼息」，等於是拿自己的錢配給自己，還要被扣稅。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"判斷方法：觀察除權息後，股價是否能漲回除權息前的收盤價。\"}],[\"$\",\"li\",\"1\",{\"children\":\"填息天數：市場常用來判斷一檔股票強弱的指標，填息天數越短，代表市場對該股票的後市越看好。\"}],[\"$\",\"li\",\"2\",{\"children\":\"一個數字門檻：一般來說，能在一個月內完成填息，通常被視為表現強勢的訊號。\"}]]}]]]}]\n1a:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、股利發放日要做什麼？錢會自動進來嗎？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"終於來到最後一關「股利發放日」！這天你不需要做任何事。如果是現金股利，公司會委託股務代理機構，直接將款項匯入你開立證券戶時設定的「交割銀行帳戶」。如果是股票股利，新的股數也會自動撥入你的集保帳戶。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"檢查現金股利：登入網路銀行或刷存摺，帳戶摘要通常會註明「股利」或公司簡稱。\"}],[\"$\",\"li\",\"1\",{\"children\":\"檢查股票股利：登入你的券商 App，確認庫存股數是否已經增加。\"}],[\"$\",\"li\",\"2\",{\"children\":\"沒收到怎麼辦：如果發放日當天過了下午三點半還沒收到，可以先聯繫你的營業員，或直接致電該公司的股務代理部門查詢。\"}]]}]]]}]\n1b:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"除權息當天賣掉股票，還能領到股利嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"可以。台股實行 T+2 交割制度，只要你在除權息交易日的「前一個營業日」收盤時還持有股票，你就已經在股東名冊上，具備領取股利的資格。因此，除權息當天開盤後就賣出，並不會影響你領息的權利。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"我怎麼知道我的股票什麼時候要除權息？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"除了留意公司發布的重大訊息，你使用的券商 App 通常也會有行事曆功能。在「股市大佬」的「除權息行事曆」專區，我們也幫你整理好了全市場的時程表，方便你一站式查詢。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"領到的股利要繳稅嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"需要。股利所得會被計入年度綜合所得稅，你可以選擇併入綜合所得計算（有 8.5% 的可抵減稅額，上限 8 萬元），或是選擇 28% 的稅率分離課稅。此外，單次股利給付若超過新台幣兩萬元，還會先被扣繳 2.11% 的二代健保補充保費。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"如果我在除權息之後才買進，會怎麼樣？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"如果你在除權息交易日或之後才買進，你將無法領到「這一次」的股利。不過，好處是你買進的成本價是除權息後的較低價格，你可以等待下一次的除權息，或是期待股價上漲賺取價差。\"}]]}]]}]]]}]\n1c:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"搞懂股利發放流程的核心原則很簡單：在「除權息交易日」前一天持有股票，就能參與配發。領到股利後，記得關注股價是否「填息」，才是判斷這次投資是否真正獲利的關鍵。\"}]]]}]\n1d:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L17\",\"0-查詢最新除權息日\",{\"href\":\"/s/2330\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"查詢最新除權息日期\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L17\",\"0-深入了解個股的歷\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"深入了解個股的歷年配息紀錄\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L17\",\"0-新手入門？從台股\",{\"href\":\"/school\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"新手入門？從台股學堂開始\"}]]}]]}]]]}]\n13:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\nf:null\n1e:I[80622,[],\"IconMark\"]\n11:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"股利什麼時候發？一次看懂除權息、股利發放日完整流程｜股市大佬 TradeBoss\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"公司宣布配息是好消息，但打開行事曆，「除權息日」、「基準日」、「發放日」這些名詞看得眼花撩亂，到底哪天買進才有得分？錢什麼時候才會進戶頭？這篇一次幫你整理清楚。\"}],[\"$\",\"link\",\"2\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}],[\"$\",\"$L1e\",\"3\",{}]],\"error\":null,\"digest\":\"$undefined\"}\n16:\"$11:metadata\"\n"}