en\":[\"learn\",[\"$\",\"$1\",\"c\",{\"children\":[null,[\"$\",\"$L4\",null,{\"parallelRouterKey\":\"children\",\"error\":\"$undefined\",\"errorStyles\":\"$undefined\",\"errorScripts\":\"$undefined\",\"template\":[\"$\",\"$L5\",null,{}],\"templateStyles\":\"$undefined\",\"templateScripts\":\"$undefined\",\"notFound\":\"$undefined\",\"forbidden\":\"$undefined\",\"unauthorized\":\"$undefined\"}]]}],{\"children\":[[\"slug\",\"dotcom-bubble-2000-story-vs-price\",\"d\"],\"$L9\",{\"children\":[\"__PAGE__\",\"$La\",{},null,false]},null,false]},null,false]},null,false],\"$Lb\",false]],\"m\":\"$undefined\",\"G\":[\"$c\",[]],\"s\":false,\"S\":true}\ne:I[24431,[],\"OutletBoundary\"]\n10:I[15278,[],\"AsyncMetadataOutlet\"]\n12:I[24431,[],\"ViewportBoundary\"]\n14:I[24431,[],\"MetadataBoundary\"]\n15:\"$Sreact.suspense\"\n9:[\"$\",\"$1\",\"c\",{\"children\":[null,[\"$\",\"$L4\",null,{\"parallelRouterKey\":\"children\",\"error\":\"$undefined\",\"errorStyles\":\"$undefined\",\"errorScripts\":\"$undefined\",\"template\":[\"$\",\"$L5\",null,{}],\"templateStyles\":\"$undefined\",\"templateScripts\":\"$undefined\",\"notFound\":\"$undefined\",\"forbidden\":\"$undefined\",\"unauthorized\":\"$undefined\"}]]}]\na:[\"$\",\"$1\",\"c\",{\"children\":[\"$Ld\",[[\"$\",\"link\",\"0\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/css/3eaf36e367672966.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"$undefined\"}]],[\"$\",\"$Le\",null,{\"children\":[\"$Lf\",[\"$\",\"$L10\",null,{\"promise\":\"$@11\"}]]}]]}]\nb:[\"$\",\"$1\",\"h\",{\"children\":[null,[[\"$\",\"$L12\",null,{\"children\":\"$L13\"}],[\"$\",\"meta\",null,{\"name\":\"next-size-adjust\",\"content\":\"\"}]],[\"$\",\"$L14\",null,{\"children\":[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$15\",null,{\"fallback\":null,\"children\":\"$L16\"}]}]}]]}]\n17:I[52619,[\"2619\",\"static/chunks/2619-04bc32f026a0d946.js\",\"6309\",\"static/chunks/app/learn/%5Bslug%5D/page-f7b99344f7e2ee16.js\"],\"\"]\nd:[\"$\",\"div\",null,{\"className\":\"LearnArticle_wrap__LIQ8G\",\"children\":[\"$\",\"article\",null,{\"className\":\"LearnArticle_article__2nBbk\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_meta__etj_G\",\"children\":[[\"$\",\"$L17\",null,{\"className\":\"LearnArticle_cat__GQMlg\",\"href\":\"/learn?c=events\",\"children\":\"金融大事件\"}],[\"$\",\"span\",null,{\"className\":\"LearnArticle_read__QEj6a\",\"children\":\"閱讀約 4 分鐘\"}]]}],[\"$\",\"h1\",null,{\"className\":\"LearnArticle_title__0_la8\",\"children\":\"2000年科技泡沫怎麼看？故事可以對，價格仍能先錯\"}],[\"$\",\"details\",null,{\"className\":\"LearnArticle_toc__LcSAa\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"LearnArticle_tocSummary__YBddG\",\"children\":\"本文目錄\"}],[\"$\",\"ol\",null,{\"className\":\"LearnArticle_tocList__Rq_Lz\",\"children\":[[\"$\",\"li\",\"sec-1\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-1\",\"children\":\"一、先承認：後來的世界確實變了\"}]}],[\"$\",\"li\",\"sec-2\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-2\",\"children\":\"二、故事好講的時候，數字會被當成掃興\"}]}],[\"$\",\"li\",\"sec-3\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-3\",\"children\":\"三、泡沫形成，通常不是一天的瘋狂\"}]}],[\"$\",\"li\",\"sec-4\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-4\",\"children\":\"四、台股讀者為什麼還要讀美國那段\"}]}],[\"$\",\"li\",\"sec-5\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-5\",\"children\":\"五、能帶走的不是「不要碰科技」\"}]}],[\"$\",\"li\",\"sec-6\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-6\",\"children\":\"常見問題 FAQ\"}]}],[\"$\",\"li\",\"sec-7\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-7\",\"children\":\"總結\"}]}],[\"$\",\"li\",\"sec-8\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-8\",\"children\":\"延伸閱讀\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"LearnArticle_body__6B7Mb\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_intro__ATV5c\",\"children\":\"二〇〇〇年前後被稱作科技泡沫的那段，事後最好講的一句是：網路是真的，價格是假的。對今天還在聽 AI、電動車、生技故事的人，這句仍然刺耳、也仍然有用。產業方向對，不能自動證明你買進的價格合理。把兩件事焊在一起，是泡沫敘述最喜歡的焊法。\"}],[],[\"$\",\"div\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"產業判斷與買進價格是兩筆帳，對了前者救不了後者\"}],[\"$\",\"li\",\"1\",{\"children\":\"故事愈好講、愈不需要數字時，愈要檢查價格已經預設了什麼\"}],[\"$\",\"li\",\"2\",{\"children\":\"泡沫不是因為未來是假的，常常是因為未來被提前付完\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、先承認：後來的世界確實變了\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"事後嘲笑當時的人很容易，因為我們已經住在網路真的改變生活的世界。教材若只停在嘲笑，會讓下一次的人以為「真的趨勢就不會有泡沫」。比較誠實的讀法是：趨勢可以是真的，價格仍可以先走完一輪做不到的成長。你要分開的是敘述的真假，與價格有沒有把十年後的事今年就付完。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"趨勢真假與價格高低是兩題\"}],[\"$\",\"li\",\"1\",{\"children\":\"真的趨勢也可以先泡沫\"}],[\"$\",\"li\",\"2\",{\"children\":\"嘲笑幫不了你下一次的判斷\"}]]}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、故事好講的時候，數字會被當成掃興\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"當時被廣泛流傳的敘述，強調使用者、點擊與未來市場，獲利可以以後再談。以後再談不是罪，罪在把「以後」當成現在就可以任意出價的理由。當反對的人只能問「現在賺不賺錢」而被當成不懂未來，擁擠就形成了。今天的題材只要開始用「你看不懂」來擋數字，結構就很像。\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"當時常見說法\"}],[\"$\",\"th\",\"1\",{\"children\":\"它跳過什麼\"}],[\"$\",\"th\",\"2\",{\"children\":\"今天的對照問法\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"未來市場極大\"}],[\"$\",\"td\",\"1\",{\"children\":\"現在的價格預設了多少成長\"}],[\"$\",\"td\",\"2\",{\"children\":\"這價格要實現什麼才合理\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"現在不獲利沒關係\"}],[\"$\",\"td\",\"1\",{\"children\":\"資金能撐多久\"}],[\"$\",\"td\",\"2\",{\"children\":\"誰在付現在的虧損\"}]]}],[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"看不懂的人會被淘汰\"}],[\"$\",\"td\",\"1\",{\"children\":\"相反證據\"}],[\"$\",\"td\",\"2\",{\"children\":\"有沒有一句話在擋數字\"}]]}],[\"$\",\"tr\",\"3\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"這次不一樣\"}],[\"$\",\"td\",\"1\",{\"children\":\"哪些其實一樣\"}],[\"$\",\"td\",\"2\",{\"children\":\"擁擠、槓桿、一句話敘述\"}]]}]]}]]}]}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、泡沫形成，通常不是一天的瘋狂\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"它比較像一段時間裡，合理的產業觀察被一次次加碼成不合理的價格。每一個加碼當下都有理由。所以當事人很少覺得自己在泡沫裡。能做的不是自詡清醒，是替每一筆看法寫失效：怎樣的價格或時間，代表你付太多未來了。沒有這一行，趨勢信仰會在退潮時要求你攤平。\"}],[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"把產業看法與這筆價格分開寫\"}],[\"$\",\"li\",\"1\",{\"children\":\"寫下怎樣叫付太多未來\"}],[\"$\",\"li\",\"2\",{\"children\":\"退潮時先問規則，再問信仰\"}]]}],[\"$\",\"figure\",\"2\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[\"$L18\",\"$L19\"]}]]]}],\"$L1a\",\"$L1b\",\"$L1c\",\"$L1d\",\"$L1e\"],\"$L1f\"]}]]}]}]\n18:[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"!未來極大所以現在隨便出價!看不懂的人會被淘汰!這次不一樣\"}]\n19:[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"焊在一起的句子\"}]\n1a:[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、台股讀者為什麼還要讀美國那段\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"因為台股後來也反覆用同一種焊法：對的產業，配上擁擠的價格。科技泡沫提供的是清楚的事後樣本，不是美國專屬病理。讀它是為了在下一輪「未來已定」的句子裡，多問一個現在的數字。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"焊法會跨市場重複\"}],[\"$\",\"li\",\"1\",{\"children\":\"樣本在歷史裡，檢查在今天\"}],[\"$\",\"li\",\"2\",{\"children\":\"不必等同一個產業名稱才適用\"}]]}]]]}]\n1b:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、能帶走的不是「不要碰科技」\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"這篇若被讀成不要碰科技，就讀歪了。能帶走的是會計：故事一筆、價格一筆。兩筆都要過，才叫研究。只有故事，叫題材；只有價格沒有故事，也可能只是便宜的陷阱。泡沫教材教的是不要讓故事代簽價格那一筆。\"}]]]}]\n1c:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"那我該不該相信長期趨勢？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"可以當背景。下單仍要問這筆價格預設了什麼。背景不能代替價格那一筆帳。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"如何知道價格是不是付太多未來？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"沒有通用公式。至少要能說出：要實現怎樣的成長，現在的價格才說得通。說不出來，就還只是感覺。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"泡沫一定會破嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"被稱作泡沫的段落，事後都經歷過大幅回落。事前沒有保證章。所以才更需要單筆失效條件，而不是全國預測。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"跟題材輪動有什麼關係？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"題材把故事傳開，泡沫把故事的價格付滿。兩篇可以一起讀：一段講資金換故事，一段講故事把價格預支完。\"}]]}]]}]]]}]\n1d:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"二〇〇〇年教的不是網路是假的，是故事可以對、價格仍能先錯。把產業判斷與買進價格分成兩筆帳。故事不能代簽價格。\"}]]]}]\n1e:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L17\",\"0-題材輪動\",{\"href\":\"/learn/what-theme-rotation-is-actually-doing\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"題材輪動\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L17\",\"0-1990 台股萬\",{\"href\":\"/learn/taiwan-1990-crash-what-it-still-teaches\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"1990 台股萬點\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L17\",\"0-確認偏誤\",{\"href\":\"/learn/confirmation-bias-in-trading-decisions\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"確認偏誤\"}]]}]]}]]]}]\n1f:[\"$\",\"div\",null,{\"className\":\"LearnArticle_related__9qV55\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_relatedTitle__RXfrl\",\"children\":\"相關文章\"}],[[\"$\",\"$L17\",\"what-theme-rotation-is-actually-doing\",{\"href\":\"/learn/what-theme-rotation-is-actually-doing\",\"className\":\"LearnArticle_relatedLink__mibXe\",\"children\":\"題材輪動\"}],[\"$\",\"$L17\",\"taiwan-1990-crash-what-it-still-teaches\",{\"href\":\"/learn/taiwan-1990-crash-what-it-still-teaches\",\"className\":\"LearnArticle_relatedLink__mibXe\",\"children\":\"1990 台股萬點\"}],[\"$\",\"$L17\",\"confirmation-bias-in-trading-decisions\",{\"href\":\"/learn/confirmation-bias-in-trading-decisions\",\"className\":\"LearnArticle_relatedLink__mibXe\",\"children\":\"確認偏誤\"}]]]}]\n13:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\nf:null\n20:I[80622,[],\"IconMark\"]\n11:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"2000年科技泡沫怎麼看？故事可以對，價格仍能先錯｜股市大佬 TradeBoss\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"二〇〇〇年前後被稱作科技泡沫的那段，事後最好講的一句是：網路是真的，價格是假的。對今天還在聽 AI、電動車、生技故事的人，這句仍然刺耳、也仍然有用。產業方向對，不能自動證明你買進的價格合理。把兩件事焊在一起，是泡沫敘述最喜歡的焊法。\"}],[\"$\",\"link\",\"2\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}],[\"$\",\"$L20\",\"3\",{}]],\"error\":null,\"digest\":\"$undefined\"}\n16:\"$11:metadata\"\n"}