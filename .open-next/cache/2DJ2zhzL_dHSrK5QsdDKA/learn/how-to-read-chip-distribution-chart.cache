earnArticle_article__2nBbk\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_meta__etj_G\",\"children\":[[\"$\",\"$L17\",null,{\"className\":\"LearnArticle_cat__GQMlg\",\"href\":\"/learn?c=tech\",\"children\":\"技術面\"}],[\"$\",\"span\",null,{\"className\":\"LearnArticle_read__QEj6a\",\"children\":\"閱讀約 7 分鐘\"}]]}],[\"$\",\"h1\",null,{\"className\":\"LearnArticle_title__0_la8\",\"children\":\"籌碼分佈圖怎麼讀？3 步驟看懂壓力支撐，避開主力出貨陷阱\"}],[\"$\",\"details\",null,{\"className\":\"LearnArticle_toc__LcSAa\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"LearnArticle_tocSummary__YBddG\",\"children\":\"本文目錄\"}],[\"$\",\"ol\",null,{\"className\":\"LearnArticle_tocList__Rq_Lz\",\"children\":[[\"$\",\"li\",\"sec-1\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-1\",\"children\":\"一、什麼是籌碼分佈圖？它跟 K 棒有什麼不同？\"}]}],[\"$\",\"li\",\"sec-2\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-2\",\"children\":\"二、如何一眼找出「壓力區」與「支撐區」？\"}]}],[\"$\",\"li\",\"sec-3\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-3\",\"children\":\"三、單峰密集 vs. 雙峰發散：看懂主力動向\"}]}],[\"$\",\"li\",\"sec-4\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-4\",\"children\":\"四、籌碼分佈圖的 3 個常見盲點\"}]}],[\"$\",\"li\",\"sec-5\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-5\",\"children\":\"五、搭配「券商分點」一起看，讓判斷更精準\"}]}],[\"$\",\"li\",\"sec-6\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-6\",\"children\":\"常見問題 FAQ\"}]}],[\"$\",\"li\",\"sec-7\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-7\",\"children\":\"總結\"}]}],[\"$\",\"li\",\"sec-8\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-8\",\"children\":\"延伸閱讀\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"LearnArticle_body__6B7Mb\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_intro__ATV5c\",\"children\":\"打開個股線圖，右邊那一堆長長短短的橫條，就是「籌碼分佈圖」。它看起來很複雜，但其實是在告訴你：這檔股票的股東們，都買在什麼價位。這篇文章會教你怎麼從這些橫條中，一眼看出哪裡是壓力、哪裡是支撐，避開買了就跌的窘境。\"}],[[\"$\",\"figure\",\"figure-0\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"壓力區（前高附近）支撐區（前低附近）價格常在區間反應，也可能直接穿過穿過之後，舊支撐可能變成新壓力\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"示意圖｜支撐與壓力是區間，不是保證守得住的一條線（教學結構，不是某檔實盤）\"}]]}]],[\"$\",\"div\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"籌碼分佈圖顯示在不同價位，有多少股票被持有。\"}],[\"$\",\"li\",\"1\",{\"children\":\"最長的橫條是「成本密集區」，是關鍵的支撐或壓力。\"}],[\"$\",\"li\",\"2\",{\"children\":\"股價在成本區下方，此區為壓力；在上方，則為支撐。\"}],[\"$\",\"li\",\"3\",{\"children\":\"籌碼出現「雙峰」型態，可能代表主力已在高點換手。\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、什麼是籌碼分佈圖？它跟 K 棒有什麼不同？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"很多人會把籌碼分佈圖跟 K 棒搞混。K 棒記錄的是「一段時間內」的價格開高低收，看的是價格的動態變化。而籌碼分佈圖是一個靜態的快照，它顯示的是「在某個時間點上」，所有流通在外的股票，它們的持有成本落在哪個價格區間。簡單說，K 棒看的是「價格」，籌碼分佈圖看的是「成本」。\"}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、如何一眼找出「壓力區」與「支撐區」？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"不用學複雜的理論，只要記住一個原則：圖上最長的那根橫條，就是最重要的「成交密集區」。這個價位代表最多人買進的成本區，因此具有強大的心理影響力。當股價來到這裡，持有者的反應會決定股價的走向。這個最長的橫條，就是我們判斷支撐或壓力的黃金標準。\"}],[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"股價在「密集區」下方：代表這區間買進的人全部虧損，一但股價漲回成本價，他們會急著賣出解套，形成強大的「壓力」。例如密集區在 100 元，現價 90 元，那 100 元就是壓力。\"}],[\"$\",\"li\",\"1\",{\"children\":\"股價在「密集區」上方：代表這區間買進的人都在獲利，心態穩定，不急著賣。當股價回檔到這個價位時，他們傾向繼續持有，甚至加碼，形成穩固的「支撐」。例如密集區在 100 元，現價 110 元，那 100 元就是支撐。\"}]]}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、單峰密集 vs. 雙峰發散：看懂主力動向\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"籌碼分佈圖的整體形狀，也透露出籌碼的穩定度。我們可以把它簡化成兩種常見型態：「單峰密集」和「雙峰發散」。這兩種型態暗示了主力可能的動向，幫助我們判斷現在是處於吸籌階段，還是出貨階段。\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"籌碼型態\"}],[\"$\",\"th\",\"1\",{\"children\":\"代表意涵\"}],[\"$\",\"th\",\"2\",{\"children\":\"散戶應對策略\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"單峰密集\"}],[\"$\",\"td\",\"1\",{\"children\":\"籌碼高度集中，多空成本趨於一致。若股價在低檔整理後出現，可能是主力吸籌完畢。\"}],\"$L18\"]}],\"$L19\"]}]]}]}],\"$L1a\"]]}],\"$L1b\",\"$L1c\",\"$L1d\",\"$L1e\",\"$L1f\"],null]}]]}]}]\n18:[\"$\",\"td\",\"2\",{\"children\":\"觀察股價是否能帶量突破並站穩在密集區之上，這通常是個較強的訊號。\"}]\n19:[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"雙峰發散\"}],[\"$\",\"td\",\"1\",{\"children\":\"籌碼分散在上下兩個價位區。通常是低檔的獲利者，在高檔將股票賣給了另一批人。\"}],[\"$\",\"td\",\"2\",{\"children\":\"若股價跌破下方的密集區，代表高檔承接的人全數套牢，後續賣壓會非常沉重。\"}]]}]\n1a:[\"$\",\"figure\",\"2\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"✓低檔單峰：主力吸籌✓高檔單峰：留意風險✓雙峰發散：籌碼換手\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"籌碼圖型態速查\"}]]}]\n1b:[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、籌碼分佈圖的 3 個常見盲點\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"沒有任何指標是百分之百準確的。籌碼分佈圖是根據歷史成交資料計算而來，在某些情況下可能會失真。了解它的限制，才能避免被錯誤的訊號誤導，做出錯誤的決策。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"時間週期的影響：你看的是 60 天還是 240 天的分佈？短、中、長期的成本結構完全不同。新手建議先從 120 日（約半年）的週期看起，比較能掌握波段主力的成本。\"}],[\"$\",\"li\",\"1\",{\"children\":\"除權息造成失真：公司除權息後，股價會向下調整，但股東的實際成本沒有改變。記得要看「還原權值」的線圖，籌碼分佈圖的價位才會是準確的。\"}],[\"$\",\"li\",\"2\",{\"children\":\"當沖交易的雜訊：當沖客當天的買賣量雖然會被計入，但他們並不會持有股票過夜。如果一檔股票當沖比例過高，可能會讓成交密集區看起來比實際留倉的更大。\"}]]}]]]}]\n1c:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、搭配「券商分點」一起看，讓判斷更精準\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"籌碼分佈圖告訴我們「成本在哪」，但沒說是「誰的成本」。如果我們能知道這些成本是來自少數人，還是分散在多數人手上，判斷的準確度就會大幅提升。這時候，就要搭配「券商分點」的資料一起看。在股市大佬的個股透視頁面中，你可以輕易比對出關鍵價位的買盤來源。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"舉例來說，你從籌碼分佈圖發現 100 元是成本密集區。接著你查詢買賣日報，發現在 98-102 元這段期間，買超前三名的券商就合計買了總成交量的 30%，而賣方券商非常分散。這就是一個籌碼由散戶流向大戶的「籌碼集中」訊號，後續值得密切關注。\"}]]}]]]}]\n1d:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"圖上的紅色和綠色代表什麼？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"紅色代表目前股價高於該成本區，在此買進的持有者是「獲利」的；綠色則代表目前股價低於該成本區，持有者處於「虧損」狀態。但要注意，整片紅色只代表帳面獲利，不代表明天一定會繼續漲。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"籌碼峰越長越好嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"不一定。長度只代表此價位的成交量大，是多空雙方的必爭之地。關鍵在於目前股價相對於這根長峰的位置。股價在長峰之上，它就是支撐；股價在長峰之下，它就是沉重的壓力。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"我應該看幾天的籌碼分佈圖？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"這取決於你的交易週期。做短線或當沖的交易者可看 20-60 日。做波段或中長線的投資人，建議看 120-240 日，才能了解較長期的主力成本區。新手可以從 120 日（約半年）開始練習。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"籌碼分佈圖每天都會變嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"是的，因為每天都有新的成交，所以分佈圖會緩慢變化。但是，一個穩固的「成本密集區」通常需要好幾週甚至好幾個月的換手才會形成，因此不會在一天內就輕易轉移。\"}]]}]]}]]]}]\n1e:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"總結來說，看籌碼分佈圖的關鍵，就是找出「最長的橫條」在哪裡。把這個價位當成多空分水嶺：股價站上它，視為支撐；股價跌破它，視為壓力。用這個簡單原則，就能幫你避開許多追高殺低的窘境。\"}]]]}]\n1f:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L17\",\"0-查詢個股的券商分\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"查詢個股的券商分點資料\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L17\",\"0-更多籌碼教學，請\",{\"href\":\"/school\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"更多籌碼教學，請看台股學堂\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L17\",\"0-用技術型態掃描工\",{\"href\":\"/chart\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"用技術型態掃描工具輔助判斷\"}]]}]]}]]]}]\n13:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\nf:null\n20:I[80622,[],\"IconMark\"]\n11:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"籌碼分佈圖怎麼讀？3 步驟看懂壓力支撐，避開主力出貨陷阱｜股市大佬 TradeBoss\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"打開個股線圖，右邊那一堆長長短短的橫條，就是「籌碼分佈圖」。它看起來很複雜，但其實是在告訴你：這檔股票的股東們，都買在什麼價位。這篇文章會教你怎麼從這些橫條中，一眼看出哪裡是壓力、哪裡是支撐，避開買了就跌的窘境。\"}],[\"$\",\"link\",\"2\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}],[\"$\",\"$L20\",\"3\",{}]],\"error\":null,\"digest\":\"$undefined\"}\n16:\"$11:metadata\"\n"}