}],[\"$\",\"li\",\"sec-4\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-4\",\"children\":\"四、關鍵數字三：單筆成交 vs. 成交筆數，哪個重要？\"}]}],[\"$\",\"li\",\"sec-5\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-5\",\"children\":\"五、漲停鎖死後，隔天一定會續漲嗎？常見的 3 個迷思\"}]}],[\"$\",\"li\",\"sec-6\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-6\",\"children\":\"常見問題 FAQ\"}]}],[\"$\",\"li\",\"sec-7\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-7\",\"children\":\"總結\"}]}],[\"$\",\"li\",\"sec-8\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-8\",\"children\":\"延伸閱讀\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"LearnArticle_body__6B7Mb\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_intro__ATV5c\",\"children\":\"手上的股票亮燈漲停，或是看到市場熱門股一價到底，心情很興奮，但打開盤口看，一長串的委買單，數字到底代表什麼？這篇會教你從幾個關鍵數字，判斷這個漲停是「鎖得牢」的強勢訊號，還是有人在暗中出貨的「假拉抬」。\"}],[[\"$\",\"figure\",\"figure-0\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"中間缺口是價差；張數是意願，不是承諾151.542 張151.088 張150.5120 張150.095 張149.5160 張149.070 張賣方五檔買方五檔大單靠近就消失，多半沒打算成交\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"示意圖｜五檔掛單：上面是想賣的，下面是想買的，都能隨時撤（教學結構，不是某檔實盤）\"}]]}]],[\"$\",\"div\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"漲停鎖死的強度，關鍵在「未成交委買張數」是否夠多、夠穩定。\"}],[\"$\",\"li\",\"1\",{\"children\":\"觀察「內盤成交」是否突然暴增，這可能是主力在漲停價倒貨的警訊。\"}],[\"$\",\"li\",\"2\",{\"children\":\"單筆大單敲進不代表絕對強勢，重點是成交後的委買張數變化。\"}],[\"$\",\"li\",\"3\",{\"children\":\"隔日開盤走勢，比單純看漲停鎖死時的掛單量更重要。\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、什麼是「漲停鎖死」？為什麼掛單還買不到？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"在台股，一檔股票每天最多只能上漲 10%，這個上限就是「漲停價」。當股價碰到這個天花板，而且想買的人遠遠多於想賣的人，所有賣單一掛出來就被瞬間成交，就會造成委買單不斷累積，形成「漲停鎖死」的狀態。這時候，就算你掛漲停價買進，也只能依下單時間排隊，如果沒人賣，就一直買不到。\"}],[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"漲停價的計算：當日開盤參考價 × 110%。\"}],[\"$\",\"li\",\"1\",{\"children\":\"鎖死的狀態：市場上所有願意賣的股票，都已經被排隊的買單吃掉。\"}],[\"$\",\"li\",\"2\",{\"children\":\"排隊買進：投資人只能掛漲停價買進，並依照委託時間的先後順序等待成交。\"}],[\"$\",\"li\",\"3\",{\"children\":\"賣方優勢：想賣的人可以隨時掛市價賣出，會立刻以漲停價成交。\"}]]}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、關鍵數字一：如何判斷「委買張數」是多還是少？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"看到委買掛單有好幾千、甚至上萬張，感覺很強，但多少才算「鎖得夠牢」？這沒有絕對標準，但可以用「股本」和「成交量」來相對評估。一個簡單的判斷法是，收盤時的委買張數，至少要是當天總成交量的 10% 以上，這樣的鎖單強度才算比較穩定。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"例如，一檔股票今天成交量是 8,000 張，那麼在漲停鎖死時，委買掛單如果能穩定維持在 800 張以上，就代表追價意願相對積極。如果掛單只有幾十張，那只要一筆稍微大一點的賣單，就可能讓漲停打開。\"}]]}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、關鍵數字二：「內盤成交」突然變多，是危險訊號？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"漲停時，理論上所有成交都應該是紅字的「外盤成交」，因為是買方用漲停價去追價買進。但如果你在盤中明細看到，突然出現好幾筆綠字的「內盤成交」，就要特別小心了。這代表有人直接把股票賣給排隊的委買單，也就是俗稱的「倒貨」，這可能是漲勢轉弱的警訊。\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":\"$L18\"}],\"$L19\"]]}],\"$L1a\",\"$L1b\",\"$L1c\",\"$L1d\",\"$L1e\"],null]}]]}]}]\n18:[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"訊號類型\"}],[\"$\",\"th\",\"1\",{\"children\":\"代表意義\"}],[\"$\",\"th\",\"2\",{\"children\":\"後續觀察重點\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"幾乎全是外盤成交\"}],[\"$\",\"td\",\"1\",{\"children\":\"買盤強勁，市場惜售\"}],[\"$\",\"td\",\"2\",{\"children\":\"委買張數是否持續增加\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"偶有零星內盤成交\"}],[\"$\",\"td\",\"1\",{\"children\":\"少量散戶獲利了結，屬正常現象\"}],[\"$\",\"td\",\"2\",{\"children\":\"委買張數是否快速補回\"}]]}],[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"連續出現大單內盤成交\"}],[\"$\",\"td\",\"1\",{\"children\":\"主力可能在漲停價出貨\"}],[\"$\",\"td\",\"2\",{\"children\":\"委買張數是否急遽減少\"}]]}]]}]]}]\n19:[\"$\",\"figure\",\"2\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"!委買張數突然急降!連續出現內盤大單!漲停打開後補單慢!主力分點邊拉邊賣\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"小心！漲停時的危險訊號\"}]]}]\n1a:[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、關鍵數字三：單筆成交 vs. 成交筆數，哪個重要？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"除了看總掛單量，成交的「品質」也很重要。有時候你會看到一筆超大單敲開漲停又馬上鎖回去，這可能是主力為了吸引市場注意力的「點火單」。我們更該注意的是，成交的「筆數」是否頻繁且穩定。如果成交筆數很少，代表市場買賣意願低，流動性差，這種漲停的穩定性就比較差。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"觀察成交明細，是少數幾筆大單，還是多筆小單持續成交。\"}],[\"$\",\"li\",\"1\",{\"children\":\"大單敲進後，委買張數是增加還是減少？增加代表市場追價意願強。\"}],[\"$\",\"li\",\"2\",{\"children\":\"避免只看單一筆成交，要看一段時間內的整體變化。\"}]]}]]]}]\n1b:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、漲停鎖死後，隔天一定會續漲嗎？常見的 3 個迷思\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"很多人以為漲停鎖死就代表隔天穩了，但市場沒有絕對。有時前一天鎖得好好的，隔天卻直接開低走低。這可能是因為整體大盤氣氛轉差，或是公司剛好發布了利空消息。因此，不能單憑漲停鎖死就斷定後市，還要留意以下幾個常見的迷思。\"}],[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"迷思一：鎖單張數越多越好。真相是，有時是主力刻意掛大單營造氣氛，但隨時可以抽單。穩定性比絕對數量更重要。\"}],[\"$\",\"li\",\"1\",{\"children\":\"迷思二：一價到底最強勢。真相是，開盤就漲停鎖死，雖然強勢，但也讓前一天的持有人無法換手，籌碼穩定度反而有疑慮。\"}],[\"$\",\"li\",\"2\",{\"children\":\"迷思三：漲停打開再鎖回去是洗盤。真相是，也可能是主力出貨的跡象，打開是為了倒貨給追價的人，需要搭配內盤成交量一起判斷。\"}]]}]]]}]\n1c:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"漲停時掛市價買，一定能買到嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"不一定。市價單會以漲停價送出，但仍需按照時間順序排隊。如果排在你前面的人非常多，且當天都沒有賣單釋出，你的單子就不會成交。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"如何知道自己排在第幾位？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"一般券商軟體無法看到精確的排隊順位。投資人只能看到總委買張數，無法得知自己的單子在隊伍的哪個位置，這是交易所的撮合機制。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"為什麼有時候漲停會突然打開一下又鎖回去？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"這通常有兩種可能：一是突然有一筆或多筆大賣單摜破了所有委買掛單；二是主力刻意抽掉部分委買單，讓股價打開來測試賣壓或吸引追價買盤，再重新掛單鎖上。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"尾盤才漲停鎖死，跟一早就鎖死，哪個比較好？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"各有優劣。一早就鎖死代表買氣非常強勁，但籌碼未經換手；尾盤才鎖死，代表經過一天多空交戰後由多方勝出，籌碼經過換手比較穩定，但隔天續強的力道可能不如早盤鎖死。\"}]]}]]}]]]}]\n1d:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"看懂漲停鎖死的盤口，不是只看委買張數有多大，而是要動態觀察「張數的穩定性」、「內盤成交的變化」與「成交筆數的品質」。把這三者結合起來，才能更準確地判斷漲停的真實強度，避免在市場最熱絡的時候，反而接到別人倒出來的籌碼。\"}]]]}]\n1e:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L17\",\"0-想知道哪些券商是\",{\"href\":\"/chips/2330\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"想知道哪些券商是關鍵主力？可以到分點排行找線索\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L17\",\"0-除了盤口，基本面\",{\"href\":\"/school\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"除了盤口，基本面也很重要，來台股學堂打好基礎\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L17\",\"0-想練習盤感？試試\",{\"href\":\"/sim\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"想練習盤感？試試我們的練功房模擬交易功能\"}]]}]]}]]]}]\n13:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\nf:null\n1f:I[80622,[],\"IconMark\"]\n11:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"漲停鎖死時盤口怎麼讀？看懂「委買張數」3 個數字，判斷是真強勢還是假拉抬｜股市大佬 TradeBoss\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"手上的股票亮燈漲停，或是看到市場熱門股一價到底，心情很興奮，但打開盤口看，一長串的委買單，數字到底代表什麼？這篇會教你從幾個關鍵數字，判斷這個漲停是「鎖得牢」的強勢訊號，還是有人在暗中出貨的「假拉抬」。\"}],[\"$\",\"link\",\"2\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}],[\"$\",\"$L1f\",\"3\",{}]],\"error\":null,\"digest\":\"$undefined\"}\n16:\"$11:metadata\"\n"}