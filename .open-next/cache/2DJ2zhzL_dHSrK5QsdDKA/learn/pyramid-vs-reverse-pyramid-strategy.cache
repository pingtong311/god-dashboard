ticle_toc__LcSAa\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"LearnArticle_tocSummary__YBddG\",\"children\":\"本文目錄\"}],[\"$\",\"ol\",null,{\"className\":\"LearnArticle_tocList__Rq_Lz\",\"children\":[[\"$\",\"li\",\"sec-1\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-1\",\"children\":\"一、為什麼股票上漲了還要加碼，不是該賣嗎？\"}]}],[\"$\",\"li\",\"sec-2\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-2\",\"children\":\"二、金字塔加碼法：越漲買越少，穩穩抱住獲利\"}]}],[\"$\",\"li\",\"sec-3\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-3\",\"children\":\"三、倒金字塔加碼法：越漲買越多，風險與獲利都放大\"}]}],[\"$\",\"li\",\"sec-4\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-4\",\"children\":\"四、一張表看懂：金字塔 vs. 倒金字塔，我該用哪個？\"}]}],[\"$\",\"li\",\"sec-5\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-5\",\"children\":\"五、加碼前必看！3 個最容易犯的致命錯誤\"}]}],[\"$\",\"li\",\"sec-6\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-6\",\"children\":\"常見問題 FAQ\"}]}],[\"$\",\"li\",\"sec-7\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-7\",\"children\":\"總結\"}]}],[\"$\",\"li\",\"sec-8\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-8\",\"children\":\"延伸閱讀\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"LearnArticle_body__6B7Mb\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_intro__ATV5c\",\"children\":\"看到持股上漲，心裡很癢想加碼，但又怕一次買太多，行情一反轉就被套在高點？其實「順勢加碼」是有策略的。這篇就是要教你兩種最常見的資金控管方法：金字塔加碼與倒金字塔加碼，讓你學會如何放大獲利，同時控制風險。\"}],[],[\"$\",\"div\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"金字塔加碼：漲越多買越少，成本拉高幅度小，風險較低，適合穩健型投資人。\"}],[\"$\",\"li\",\"1\",{\"children\":\"倒金字塔加碼：漲越多買越多，成本拉高快，風險與潛在獲利都很大，適合積極型投資人。\"}],[\"$\",\"li\",\"2\",{\"children\":\"加碼前提：必須先確認趨勢成形（如站上關鍵均線），且設定好明確的停損點。\"}],[\"$\",\"li\",\"3\",{\"children\":\"最大誤區：把加碼用在虧損的部位（攤平），這會讓虧損快速擴大，是致命錯誤。\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、為什麼股票上漲了還要加碼，不是該賣嗎？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"很多散戶的習慣是「賺一點就跑，賠錢就死抱」，結果賺小錢、賠大錢。專業的交易者正好相反，他們會「讓獲利奔跑，並迅速停損」。順勢加碼的目的，就是在你看對方向時，勇敢擴大戰果，將資金集中在表現強勢的股票上，而不是死守那些不斷虧損的部位。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"放大獲利：當你看對趨勢，加碼能讓你在同一波行情中賺得更多。\"}],[\"$\",\"li\",\"1\",{\"children\":\"順勢而為：股價走勢通常有慣性，順著趨勢操作的成功機率較高。\"}],[\"$\",\"li\",\"2\",{\"children\":\"提升資金效率：將資金集中在正在上漲的強勢股，而不是被套牢的弱勢股。\"}]]}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、金字塔加碼法：越漲買越少，穩穩抱住獲利\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"金字塔加碼，又稱正金字塔，是相對穩健的作法。它的核心精神是「第一筆投入的資金最多，之後隨著股價上漲，加碼的資金越來越少」，就像一個正三角形，底部最寬。這樣做的好處是，你的平均成本不會被拉得太高，即使股價稍微回檔，整體部位依然能保持獲利，心理壓力比較小。\"}],[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"假設在 100 元買進 4 張（基礎部位）。\"}],[\"$\",\"li\",\"1\",{\"children\":\"股價漲到 110 元，確認趨勢向上，加碼 2 張。\"}],[\"$\",\"li\",\"2\",{\"children\":\"股價續漲到 120 元，動能仍在，再加碼 1 張。\"}],[\"$\",\"li\",\"3\",{\"children\":\"結果：總持有 7 張，平均成本約 105.7 元。就算股價拉回到 110 元，你的帳戶整體還是賺錢的。\"}]]}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、倒金字塔加碼法：越漲買越多，風險與獲利都放大\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"倒金字塔加碼，又稱倒三角形，是一種比較激進的策略。它的作法完全相反：「第一筆資金只是試水溫，部位很小，確認趨勢後，越漲投入的資金越多」。這種方法會讓你的平均成本快速墊高，風險也急遽增加。只要股價一回檔，很容易就從賺錢變賠錢。但如果成功抓到主升段，獲利會非常驚人。\"}],[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"假設在 100 元試單買進 1 張。\"}],[\"$\",\"li\",\"1\",{\"children\":\"股價漲到 110 元，趨勢轉強，加碼 2 張。\"}],[\"$\",\"li\",\"2\",{\"children\":\"股價噴出到 120 元，突破關鍵價位，再重壓 4 張。\"}],[\"$\",\"li\",\"3\",{\"children\":\"結果：總持有 7 張，平均成本飆高到約 115.7 元。如果股價只是小幅拉回到 110 元，你的整體部位就會立刻轉為虧損。\"}]]}],[\"$\",\"figure\",\"2\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[\"$L18\",\"$L19\"]}]]]}],\"$L1a\",\"$L1b\",\"$L1c\",\"$L1d\",\"$L1e\"],null]}]]}]}]\n18:[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"11. 底部試單倉位輕22. 越往上買越多33. 平均成本拉高快44. 風險獲利都放大\"}]\n19:[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"倒金字塔加碼：積極型策略\"}]\n1a:[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、一張表看懂：金字塔 vs. 倒金字塔，我該用哪個？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"這兩種方法沒有絕對的好壞，只有適不適合你的個性和當下的盤勢。如果你是追求穩健的波段操作者，金字塔法比較適合你；如果你是能承受高風險、想在強勢噴出段賺取最大利潤的積極交易者，倒金字塔法可能是你的選項。用下表可以看得更清楚：\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"比較項目\"}],[\"$\",\"th\",\"1\",{\"children\":\"金字塔加碼 (正金字塔)\"}],[\"$\",\"th\",\"2\",{\"children\":\"倒金字塔加碼 (倒三角)\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"資金配置\"}],[\"$\",\"td\",\"1\",{\"children\":\"首次投入最多，越漲買越少\"}],[\"$\",\"td\",\"2\",{\"children\":\"首次投入最少，越漲買越多\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"平均成本\"}],[\"$\",\"td\",\"1\",{\"children\":\"拉高速度慢\"}],[\"$\",\"td\",\"2\",{\"children\":\"拉高速度快\"}]]}],[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"風險程度\"}],[\"$\",\"td\",\"1\",{\"children\":\"相對較低，回檔時有緩衝\"}],[\"$\",\"td\",\"2\",{\"children\":\"相對較高，回檔易由賺轉虧\"}]]}],[\"$\",\"tr\",\"3\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"心理壓力\"}],[\"$\",\"td\",\"1\",{\"children\":\"較小，持有成本離市價遠\"}],[\"$\",\"td\",\"2\",{\"children\":\"較大，持有成本離市價近\"}]]}],[\"$\",\"tr\",\"4\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"適合情境\"}],[\"$\",\"td\",\"1\",{\"children\":\"趨勢穩健的波段操作\"}],[\"$\",\"td\",\"2\",{\"children\":\"趨勢明確的強勢噴出段\"}]]}],[\"$\",\"tr\",\"5\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"適合對象\"}],[\"$\",\"td\",\"1\",{\"children\":\"穩健型、波段交易者\"}],[\"$\",\"td\",\"2\",{\"children\":\"積極型、短線交易者\"}]]}]]}]]}]}]]]}]\n1b:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、加碼前必看！3 個最容易犯的致命錯誤\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"無論你選擇哪種加碼方式，都必須避開以下幾個常見的陷阱。這些錯誤輕則讓獲利回吐，重則導致嚴重虧損，甚至讓你對交易失去信心。請務必在每次按下加碼的買進鈕前，再三檢查。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"把攤平當加碼：最致命的錯誤。加碼只適用於「已經獲利」的部位，是順勢操作；在虧損時越買越多叫「攤平」，是逆勢操作，容易越套越深。\"}],[\"$\",\"li\",\"1\",{\"children\":\"沒有設定停損點：加碼前，必須先想好「如果整筆單看錯了，要在哪裡全部出場」。否則一次失誤就可能賠掉前面累積的所有獲利。\"}],[\"$\",\"li\",\"2\",{\"children\":\"憑感覺隨意加碼：加碼應該有計畫，例如「突破前高再加」、「站穩月線再加」，而不是看它漲了 2% 就衝動買進，這樣會打亂你的成本結構與風險控制。\"}]]}]]]}]\n1c:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"如果我一開始就 All in，是不是就不用煩惱加碼了？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"一次性投入雖然簡單，但風險也最集中。若買進後立刻下跌，就沒有多餘資金可以操作。分批投入的加碼策略，能讓你先用小部位測試水溫，看對方向再放大戰果，是更靈活的資金管理方式。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"加碼的間距要怎麼抓？漲多少才加一次？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"這沒有標準答案，取決於你的交易週期和風險偏好。短線交易者可能看漲 5% 或突破關鍵價位就加碼；波段交易者可能會等股價站穩月線、季線，或出現「帶量長紅 K」等更明確的訊號時才動作。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"這兩種方法聽起來都很棒，可以混合使用嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"可以，但需要有清楚的策略。例如，你可以用金字塔法建立基本倉位，當股價出現強烈噴出訊號時，再用一筆小資金採倒金字塔法追擊。重點是，你必須清楚知道自己每筆交易背後的邏輯與風險。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"倒金字塔風險這麼高，為什麼還有人用？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"因為在主升段行情中，它的獲利潛力最驚人。當一檔股票進入強勢噴出階段，後面的漲幅往往最大最快。倒金字塔法就是為了捕捉這種行情，用較高的風險去換取極大化的報酬，適合風險承受度高的積極交易者。\"}]]}]]}]]]}]\n1d:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"總結來說，金字塔加碼法是「防守反擊」，先求穩再求勝；倒金字塔加碼法則像「全力進攻」，風險高但潛在報酬也大。無論選擇哪一種，前提都是「順勢而為」並「嚴設停損」，這才是長期在市場中生存的關鍵。\"}]]]}]\n1e:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L17\",\"0-學習更多交易觀念\",{\"href\":\"/school\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"學習更多交易觀念：台股學堂\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L17\",\"0-尋找趨勢成形的股\",{\"href\":\"/chart\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"尋找趨勢成形的股票：技術型態掃描\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L17\",\"0-研究個股籌碼與價\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"研究個股籌碼與價量：個股透視\"}]]}]]}]]]}]\n13:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\nf:null\n1f:I[80622,[],\"IconMark\"]\n11:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"金字塔加碼、倒金字塔加碼差在哪？3 個重點看懂順勢交易的資金控管｜股市大佬 TradeBoss\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"看到持股上漲，心裡很癢想加碼，但又怕一次買太多，行情一反轉就被套在高點？其實「順勢加碼」是有策略的。這篇就是要教你兩種最常見的資金控管方法：金字塔加碼與倒金字塔加碼，讓你學會如何放大獲利，同時控制風險。\"}],[\"$\",\"link\",\"2\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}],[\"$\",\"$L1f\",\"3\",{}]],\"error\":null,\"digest\":\"$undefined\"}\n16:\"$11:metadata\"\n"}