\"className\":\"LearnArticle_article__2nBbk\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_meta__etj_G\",\"children\":[[\"$\",\"$L17\",null,{\"className\":\"LearnArticle_cat__GQMlg\",\"href\":\"/learn?c=rules\",\"children\":\"制度與工具\"}],[\"$\",\"span\",null,{\"className\":\"LearnArticle_read__QEj6a\",\"children\":\"閱讀約 6 分鐘\"}]]}],[\"$\",\"h1\",null,{\"className\":\"LearnArticle_title__0_la8\",\"children\":\"可轉債是什麼？跟股票差在哪？3分鐘看懂如何參與行情\"}],[\"$\",\"details\",null,{\"className\":\"LearnArticle_toc__LcSAa\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"LearnArticle_tocSummary__YBddG\",\"children\":\"本文目錄\"}],[\"$\",\"ol\",null,{\"className\":\"LearnArticle_tocList__Rq_Lz\",\"children\":[[\"$\",\"li\",\"sec-1\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-1\",\"children\":\"一、可轉債到底是什麼？一張圖看懂它的「雙重身份」\"}]}],[\"$\",\"li\",\"sec-2\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-2\",\"children\":\"二、它跟股價有什麼關係？搞懂「轉換價格」這個關鍵數字\"}]}],[\"$\",\"li\",\"sec-3\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-3\",\"children\":\"三、為什麼常聽到大戶在買「CBAS」？\"}]}],[\"$\",\"li\",\"sec-4\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-4\",\"children\":\"四、散戶怎麼觀察可轉債行情？注意兩個時間點\"}]}],[\"$\",\"li\",\"sec-5\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-5\",\"children\":\"五、解讀可轉債的常見錯誤：別看到黑影就開槍\"}]}],[\"$\",\"li\",\"sec-6\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-6\",\"children\":\"常見問題 FAQ\"}]}],[\"$\",\"li\",\"sec-7\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-7\",\"children\":\"總結\"}]}],[\"$\",\"li\",\"sec-8\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-8\",\"children\":\"延伸閱讀\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"LearnArticle_body__6B7Mb\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_intro__ATV5c\",\"children\":\"常聽到新聞說某檔股票有「可轉債」行情，但它不是債券嗎？怎麼會跟股價有關？這篇文章就是要用最簡單的方式，讓你搞懂可轉債是什麼，以及它如何影響你手中的股票。\"}],[[\"$\",\"figure\",\"figure-0\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"沒扣成本的勝率，看起來都會比較漂亮0.029%手續費 1 折來回0.15%當沖證交稅0.06%滑價估計三項合計約 0.24%；留倉稅率更高，約 0.39%\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"示意圖｜當沖來回成本：1 折手續費 + 證交稅 + 滑價（教學結構，不是某檔實盤）\"}]]}]],[\"$\",\"div\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"可轉債是「可以換成股票的債券」，兼具債券的保本性和股票的上漲潛力。\"}],[\"$\",\"li\",\"1\",{\"children\":\"當股價超過「轉換價」，持有者傾向換成股票賣出，可能造成短線籌碼變動。\"}],[\"$\",\"li\",\"2\",{\"children\":\"觀察「轉換價」與「到期日」是判斷可轉債動向的兩個關鍵。\"}],[\"$\",\"li\",\"3\",{\"children\":\"散戶不一定要直接買，但看懂它能幫助你判斷公司動向與籌碼流動。\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、可轉債到底是什麼？一張圖看懂它的「雙重身份」\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"簡單來說，可轉債（Convertible Bond, 簡稱 CB）就是一張「附帶股票選擇權的債券」。你借錢給公司，公司發給你一張債券，這張債券除了像一般債券一樣有到期日和利息外，還多了一個特殊權利：在特定條件下，你可以把這張債券換成該公司的股票。這個雙重身份讓它進可攻、退可守。\"}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、它跟股價有什麼關係？搞懂「轉換價格」這個關鍵數字\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"「轉換價格」是決定可轉債魔力的核心數字，它決定了你一張債券可以換到多少股股票。假設A公司發行一張面額 10 萬的可轉債，約定轉換價為 50 元。這代表未來你可以用這張債券換到 100,000 元 / 50 元 = 2,000 股（也就是 2 張）A公司的股票。\"}],[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"當股價只有 40 元：換成股票只值 8 萬，不如抱著債券等還本，沒人想換。\"}],[\"$\",\"li\",\"1\",{\"children\":\"當股價漲到 60 元：換成股票價值 12 萬，比債券面額 10 萬還高，這時持有者就有誘因把債券換成股票賣出，賺取中間的價差。\"}],[\"$\",\"li\",\"2\",{\"children\":\"判斷關鍵：拿「轉換後的股票價值」和「債券面額」比大小，就能看出持有人的動向。\"}]]}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、為什麼常聽到大戶在買「CBAS」？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"你可能聽過一個更進階的名詞叫 CBAS（可轉債資產交換）。你可以把它想像成是將可轉債「拆開來賣」。專業機構會把可轉債拆成「固定收益的債券」和「轉換股票的權利」兩部分。前者賣給追求穩定收益的銀行或保險公司，後者（權利）就賣給想參與股價波動的投資人。市場上許多關於可轉債的操作，其實是在交易這個「權利」。\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"項目\"}],[\"$\",\"th\",\"1\",{\"children\":\"可轉債 (CB)\"}],[\"$\",\"th\",\"2\",{\"children\":\"可轉債資產交換 (CBAS)\"}]]}]}],\"$L18\"]}]}],\"$L19\"]]}],\"$L1a\",\"$L1b\",\"$L1c\",\"$L1d\",\"$L1e\"],null]}]]}]}]\n18:[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"持有標的\"}],[\"$\",\"td\",\"1\",{\"children\":\"完整的債券\"}],[\"$\",\"td\",\"2\",{\"children\":\"轉換成股票的「權利」\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"參與者\"}],[\"$\",\"td\",\"1\",{\"children\":\"一般投資人、法人\"}],[\"$\",\"td\",\"2\",{\"children\":\"專業投資機構、大戶\"}]]}],[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"資金門檻\"}],[\"$\",\"td\",\"1\",{\"children\":\"較高（一張面額 10 萬）\"}],[\"$\",\"td\",\"2\",{\"children\":\"較低（只買權利的部分）\"}]]}],[\"$\",\"tr\",\"3\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"風險特性\"}],[\"$\",\"td\",\"1\",{\"children\":\"有債券價值保底，風險較低\"}],[\"$\",\"td\",\"2\",{\"children\":\"純粹的權利金，槓桿高、風險高\"}]]}]]}]\n19:[\"$\",\"figure\",\"2\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"!發CB ≠ 股價保證漲!轉換價 ≠ 絕對支撐線!有人買 ≠ 你也要複製操作\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"解讀可轉債的常見迷思\"}]]}]\n1a:[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、散戶怎麼觀察可轉債行情？注意兩個時間點\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"對一般只買賣股票的投資人來說，不一定要親自操作可轉債，但看懂它的動態可以幫助你判斷股價可能的走向。有兩個時間點，特別值得你打開軟體多留意一下相關個股的籌碼變化。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"閉鎖期結束後：可轉債發行後通常有三個月不能轉換，這就是閉鎖期。閉鎖期一過，如果股價遠高於轉換價，就可能出現一波賣壓，因為早期持有的投資人會開始換成股票來實現獲利。\"}],[\"$\",\"li\",\"1\",{\"children\":\"到期日或賣回日前：反過來說，如果股價長期低於轉換價，持有者寧可公司還錢。為了避免現金流出，公司派或主力有時會設法讓股價站上轉換價，誘導持有者轉換成股票。這可能就成為股價的支撐力道。\"}]]}]]]}]\n1b:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、解讀可轉債的常見錯誤：別看到黑影就開槍\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"看到公司發行可轉債，就直接認定股價準備要大漲，這是最常見的誤解。發行可轉債本質上是公司的募資方式之一，就像現金增資或銀行貸款一樣。股價的長期走勢，最終還是要回歸公司的獲利能力、產業前景和市場整體的氣氛，不能單憑一個籌資活動就做出買賣決策。\"}]]]}]\n1c:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"可轉債要去哪裡買？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"可轉債可以在證券市場上交易，代碼通常是股票代碼後面加數字（例如 23301）。但它的交易量通常不大，流動性比股票差很多，一般散戶較少直接在次級市場購買。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"如果公司倒閉了，我的可轉債會怎麼樣？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"如果公司不幸倒閉清算，債權人的求償順位會優先於股東。因此，持有可轉債（屬於債券）的投資人，拿回部分資金的機會比只持有股票的股東要高一些。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"「轉換溢價率」是什麼意思？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"意思是，用可轉債目前的市價去換成股票，會比直接在市場上買股票貴了多少百分比。溢價率越高，代表市場越看好未來股價會繼續漲，所以願意用更貴的價格來「卡位」。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"為什麼有些可轉債的價格會超過 100 元？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"可轉債的面額是 10 萬元，發行價訂為 100 元。當市價超過 100 元，代表市場預期未來股價上漲、可以轉換成股票獲利的機率很高，因此願意用更高的價格買入這張債券，這就是它的「股性」所帶來的溢價。\"}]]}]]}]]]}]\n1d:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"總結來說，可轉債是公司的一種籌資工具，對投資人則是「下檔有債券保底、上檔有股票空間」的選擇。散戶不一定要直接參與，但學會看懂轉換價格與關鍵時間點，就能多一個觀察公司動態與籌碼流向的實用角度。\"}]]]}]\n1e:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L17\",\"0-想學更多？來台股\",{\"href\":\"/school\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"想學更多？來台股學堂打好基礎\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L17\",\"0-查詢個股的詳細籌\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"查詢個股的詳細籌碼與價量資料\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L17\",\"0-用大盤總覽掌握市\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"用大盤總覽掌握市場整體趨勢\"}]]}]]}]]]}]\n13:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\nf:null\n1f:I[80622,[],\"IconMark\"]\n11:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"可轉債是什麼？跟股票差在哪？3分鐘看懂如何參與行情｜股市大佬 TradeBoss\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"常聽到新聞說某檔股票有「可轉債」行情，但它不是債券嗎？怎麼會跟股價有關？這篇文章就是要用最簡單的方式，讓你搞懂可轉債是什麼，以及它如何影響你手中的股票。\"}],[\"$\",\"link\",\"2\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}],[\"$\",\"$L1f\",\"3\",{}]],\"error\":null,\"digest\":\"$undefined\"}\n16:\"$11:metadata\"\n"}