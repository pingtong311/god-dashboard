en\":[\"$\",\"a\",null,{\"href\":\"#sec-2\",\"children\":\"二、三條界線\"}]}],[\"$\",\"li\",\"sec-3\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-3\",\"children\":\"三、十倍股敘事的倖存者偏差\"}]}],[\"$\",\"li\",\"sec-4\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-4\",\"children\":\"四、業餘時間的誠實用法\"}]}],[\"$\",\"li\",\"sec-5\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-5\",\"children\":\"五、最小動作\"}]}],[\"$\",\"li\",\"sec-6\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-6\",\"children\":\"常見問題 FAQ\"}]}],[\"$\",\"li\",\"sec-7\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-7\",\"children\":\"總結\"}]}],[\"$\",\"li\",\"sec-8\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-8\",\"children\":\"延伸閱讀\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"LearnArticle_body__6B7Mb\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_intro__ATV5c\",\"children\":\"彼得·林區的公開著作很常被做成一句話：買你了解的公司。於是有人在賣場看到洗衣精就想下單。書裡比較完整的意思是：日常生活可以給你線索，但線索要再經過你自己講得清楚的生意邏輯，才有資格進觀察名單。線索不是指令。這篇把誤讀拆開。\"}],[],[\"$\",\"div\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"會用產品，只是觀察的起點，不是下單理由\"}],[\"$\",\"li\",\"1\",{\"children\":\"十倍股故事最容易讓人省略失敗的樣本\"}],[\"$\",\"li\",\"2\",{\"children\":\"業餘時間做功課，不表示可以忽略流動性與等待\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、那句話本來在擋什麼\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"公開寫作的背景，是很多人買自己完全講不清楚的東西，只因為名字聽起來專業。他要擋的是外包判斷。後來被翻成「生活裡碰到就買」，方向剛好反了：生活線索變成新的外包——外包給自己的使用習慣。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"原意是擋不懂的東西\"}],[\"$\",\"li\",\"1\",{\"children\":\"使用習慣不是研究\"}],[\"$\",\"li\",\"2\",{\"children\":\"線索要再翻譯成生意\"}]]}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、三條界線\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"第一，你能講清它怎麼收費、對手是誰。第二，你能講清它為什麼現在這個價格值得你承擔波動。第三，你能講清怎樣算你錯了。三條少一條，「我有用過」就還只是生活，不是方法。\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"日常句子\"}],[\"$\",\"th\",\"1\",{\"children\":\"比較穩的翻譯\"}],[\"$\",\"th\",\"2\",{\"children\":\"仍缺的\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"這家店總是客滿\"}],[\"$\",\"td\",\"1\",{\"children\":\"需求可能不差\"}],[\"$\",\"td\",\"2\",{\"children\":\"利潤誰拿走\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"我很愛用\"}],[\"$\",\"td\",\"1\",{\"children\":\"產品有人要\"}],[\"$\",\"td\",\"2\",{\"children\":\"公司賺不賺得到\"}]]}],[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"大家都在講\"}],[\"$\",\"td\",\"1\",{\"children\":\"敘述很熱\"}],[\"$\",\"td\",\"2\",{\"children\":\"是不是已經擁擠\"}]]}],[\"$\",\"tr\",\"3\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"以前漲過很多\"}],[\"$\",\"td\",\"1\",{\"children\":\"倖存者故事\"}],[\"$\",\"td\",\"2\",{\"children\":\"失敗的沒被講\"}]]}]]}]]}]}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、十倍股敘事的倖存者偏差\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"書裡舉過很多後來變很大的例子，傳播時只剩這些例子。公開討論很少同等篇幅講「看起來也懂、後來沒走成那樣」的公司。把教材讀成尋寶圖，會低估等待與失敗率。倖存者偏差那題，題庫裡也有。\"}],[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"先承認例子已被過濾\"}],[\"$\",\"li\",\"1\",{\"children\":\"再問你能不能接受多數線索沒結果\"}],[\"$\",\"li\",\"2\",{\"children\":\"最後才把生活觀察放進名單\"}]]}],[\"$\",\"figure\",\"2\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"✓怎麼收費✓價格值不值得波動✓怎樣算錯\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"三條界線\"}]]}]]]}],[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[\"$L18\",[\"$L19\",\"$L1a\"]]}],\"$L1b\",\"$L1c\",\"$L1d\",\"$L1e\"],\"$L1f\"]}]]}]}]\n18:[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、業餘時間的誠實用法\"}]\n19:[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"他鼓勵有工作的人用自己的視野。誠實的另一半是：視野有限、時間有限、流動性可能不夠。生活觀察適合當起點，不適合當高週轉策略的引擎。\"}]\n1a:[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"起點可以來自生活\"}],[\"$\",\"li\",\"1\",{\"children\":\"引擎仍要規則與風險\"}],[\"$\",\"li\",\"2\",{\"children\":\"時間少就少做決定\"}]]}]\n1b:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、最小動作\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"把「我有用過所以想買」改寫成三段：我看到的使用線索、我對生意的理解、我的失效。第三段寫不出來，就還只是想買。\"}]]]}]\n1c:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"完全不碰自己沒用不過的公司嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"不是。那句話是起點，不是禁令。講不清楚的，部位就要更小或不動。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"十倍股能不能當目標？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"當故事可以。當必須達成的數字，會讓你忽略失敗樣本。本站也不寫這類保證。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"和能力圈是不是同一句？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"很近。林區較常從生活線索講起，能力圈較常從「講不清楚就不重倉」講起。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"台股通路觀察有用嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"可當一層。仍要補財報、競爭與流動性，不能只靠排隊人潮。\"}]]}]]}]]]}]\n1d:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"「買你懂的」是在擋外包判斷，不是叫你買自己用過的東西。生活是線索，生意與失效才是方法。十倍故事已被過濾。\"}]]]}]\n1e:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L17\",\"0-巴菲特能力圈\",{\"href\":\"/learn/buffett-circle-of-competence\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"巴菲特能力圈\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L17\",\"0-後見之明偏差\",{\"href\":\"/learn/hindsight-bias-in-trading\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"後見之明偏差\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L17\",\"0-題材輪動\",{\"href\":\"/learn/what-theme-rotation-is-actually-doing\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"題材輪動\"}]]}]]}]]]}]\n1f:[\"$\",\"div\",null,{\"className\":\"LearnArticle_relate