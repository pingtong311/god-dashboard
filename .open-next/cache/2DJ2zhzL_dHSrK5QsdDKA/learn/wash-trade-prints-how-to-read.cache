src=\"/_next/static/chunks/app/layout-4382c12d510386d3.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/learn/%5Bslug%5D/page-f7b99344f7e2ee16.js\" async=\"\"></script><meta name=\"next-size-adjust\" content=\"\"/><title>對敲在逐筆明細怎麼看？4個常見誤讀｜股市大佬 TradeBoss</title><meta name=\"description\" content=\"逐筆明細一筆買、一筆賣，價格差不多、張數也差不多，有人會立刻說：這是對敲。對敲指的是沒有真實換手意圖的虛假成交，在規範裡不是技巧，是不該做的事。公開逐筆看起來像來回，遠遠不足以證明那件事。合法的雙向成交、拆單、不同人之間的正常撮合，長相可以非常像。這篇只幫你少讀成陰謀，不是教你辨\"/><link rel=\"icon\" href=\"/favicon.ico\" type=\"image/x-icon\" sizes=\"16x16\"/><script>(function(){try{var t=localStorage.getItem('obsidian-theme');if(t!=='light'&&t!=='dark')t='dark';document.documentElement.setAttribute('data-theme',t);document.documentElement.style.colorScheme=(t==='light'?'light':'dark');}catch(e){document.documentElement.setAttribute('data-theme','dark');}})();(function(){try{if(localStorage.getItem('obsidian-comfort-read')==='1')document.documentElement.classList.add('comfort-read');}catch(e){}})();(function(){try{var s=localStorage.getItem('obsidian-updown');if(s==='us')document.documentElement.setAttribute('data-updown','us');}catch(e){}})();(function(){try{var prefs=JSON.parse(localStorage.getItem('bs-preferences-v1')||'{}');var root=document.documentElement;prefs=prefs&&typeof prefs==='object'?prefs:{};root.setAttribute('data-font-size',['standard','large','xlarge','huge'].indexOf(prefs.fontSize)>=0?prefs.fontSize:'standard');root.setAttribute('data-density',prefs.density==='compact'?'compact':'comfortable');}catch(e){}})();</script><script src=\"/_next/static/chunks/polyfills-42372ed130431b0a.js\" noModule=\"\"></script></head><body class=\"min-h-screen bg-background text-foreground selection:bg-cyan/30 review-mode pb-40 lg:pb-16\" data-review-theme=\"dark\"><div hidden=\"\"><!--$--><!--/$--></div><a href=\"#main-content\" class=\"skip-link fixed left-3 top-3 z-[80] -translate-y-24 rounded-xl bg-accent px-4 py-2 font-black text-bg shadow-lg transition focus:translate-y-0\">跳到主要內容</a><main id=\"main-content\" class=\"w-full\"><div class=\"LearnArticle_wrap__LIQ8G\"><article class=\"LearnArticle_article__2nBbk\"><p class=\"LearnArticle_meta__etj_G\"><a class=\"LearnArticle_cat__GQMlg\" href=\"/learn?c=orderbook\">盤口掛單</a><span class=\"LearnArticle_read__QEj6a\">閱讀約 5 分鐘</span></p><h1 class=\"LearnArticle_title__0_la8\">對敲在逐筆明細怎麼看？4個常見誤讀</h1><details class=\"LearnArticle_toc__LcSAa\"><summary class=\"LearnArticle_tocSummary__YBddG\">本文目錄</summary><ol class=\"LearnArticle_tocList__Rq_Lz\"><li><a href=\"#sec-1\">一、先把法律位置講清楚</a></li><li><a href=\"#sec-2\">二、人們在逐筆上指的通常是什麼</a></li><li><a href=\"#sec-3\">三、合法成交為什麼長得很像</a></li><li><a href=\"#sec-4\">四、公開資料不能拿來當判決</a></li><li><a href=\"#sec-5\">五、比較穩的讀法是降低陰謀，不是抓人</a></li><li><a href=\"#sec-6\">常見問題 FAQ</a></li><li><a href=\"#sec-7\">總結</a></li><li><a href=\"#sec-8\">延伸閱讀</a></li></ol></details><div class=\"LearnArticle_body__6B7Mb\"><p class=\"LearnArticle_intro__ATV5c\">逐筆明細一筆買、一筆賣，價格差不多、張數也差不多，有人會立刻說：這是對敲。對敲指的是沒有真實換手意圖的虛假成交，在規範裡不是技巧，是不該做的事。公開逐筆看起來像來回，遠遠不足以證明那件事。合法的雙向成交、拆單、不同人之間的正常撮合，長相可以非常像。這篇只幫你少讀成陰謀，不是教你辨認兇手，更不是教你做。</p><figure class=\"LearnArticle_fig__uoT7r\"><div class=\"LearnArticle_figFrame__jJ7E4\">中間缺口是價差；張數是意願，不是承諾151.542 張151.088 張150.5120 張150.095 張149.5160 張149.070 張賣方五檔買方五檔大單靠近就消失，多半沒打算成交</div><figcaption class=\"LearnArticle_figCap__LnUbb\">示意圖｜五檔掛單：上面是想賣的，下面是想買的，都能隨時撤（教學結構，不是某檔實盤）</figcaption></figure><div class=\"LearnArticle_tldr__Br5BY\"><b class=\"LearnArticle_tldrTitle__K5PBN\">本文重點</b><ul class=\"LearnArticle_tldrList__VSc2_\"><li>對敲是違法的虛假成交，教學文只談誤讀，不要學、不要做</li><li>同價來回在正常市場一天可以出現很多次</li><li>公開逐筆沒有帳戶對照，不能拿來定罪，也不能拿來跟風</li></ul></div><section id=\"sec-1\" class=\"LearnArticle_section__hLVjU\"><h2 class=\"LearnArticle_h2__NmJ08\">一、先把法律位置講清楚</h2><p class=\"LearnArticle_p__aZlQ1\">對敲、沖洗這一類做法，核心是製造看起來有成交、實際上沒有真實買賣意圖的紀錄。它不是盤口技巧，也不是比較厲害的看盤。寫這篇的唯一理由，是太多人會在逐筆上「抓對敲」，再把自己的情緒交給一個無法驗證的故事。正確態度只有兩個：不要做；也不要在沒有帳戶證據時指控誰做了。其餘都是誤讀管理。</p><ul class=\"LearnArticle_listCheck__xx1CF\"><li>這是規範禁止的行為，不是技巧</li><li>公開畫面不能證明誰對敲</li><li>把精力放在少誤讀，不放在學手法</li></ul></section><section id=\"sec-2\" class=\"LearnArticle_section__hLVjU\"><h2 class=\"LearnArticle_h2__NmJ08\">二、人們在逐筆上指的通常是什麼</h2><p class=\"LearnArticle_p__aZlQ1\">口語裡被叫成對敲的，多半是：同一價附近買一筆賣一筆、張數接近、短時間反覆、淨變化看起來不大。這些是「看起來像雙向」的表面。表面可以來自一個人，也可以來自很多不相干的人在同一個價相遇。你的看盤軟體不會把帳戶塗上顏色。沒有顏色，形狀不能當指紋。</p></section><section id=\"sec-3\" class=\"LearnArticle_section__hLVjU\"><h2 class=\"LearnArticle_h2__NmJ08\">三、合法成交為什麼長得很像</h2><p class=\"LearnArticle_p__aZlQ1\">最佳買與最佳賣很近時，主動買與主動賣本來就會在差不多的價格交替出現。拆單會讓張數看起來整齊。開盤與收盤附近、漲跌停附近，撮合規則也會吐出一串看起來很齊的成交。把「齊」讀成「有人在配」，是眼睛喜歡規律，不是你抓到了什麼。規律在撮合裡是常態。</p><div class=\"LearnArticle_tblScroll__z9kbb\"><table class=\"LearnArticle_tbl__0yNgv\"><thead><tr><th>逐筆長相</th><th>容易讀成</th><th>也同樣可能是</th></tr></thead><tbody><tr><td>同價買一筆賣一筆</td><td>有人對敲</td><td>兩邊都有人要立刻成交</td></tr><tr><td>張數幾乎一樣</td><td>同一手在配</td><td>拆單單位本來就接近</td></tr><tr><td>短時間來回很多次</td><td>在做量</td><td>流動性好時雙向本來就密</td></tr><tr><td>價格不太動、量卻有</td><td>虛假換手</td><td>買賣意願剛好在同一價相遇</td></tr></tbody></table></div><figure class=\"LearnArticle_fig__uoT7r\"><div class=\"LearnArticle_figFrame__jJ7E4\">✓這個價兩邊都有人急✓齊不等於配✓沒帳戶就停在描述</div><figcaption class=\"LearnArticle_figCap__LnUbb\">比較穩的句子</figcaption></figure></section><section id=\"sec-4\" class=\"LearnArticle_section__hLVjU\"><h2 class=\"LearnArticle_h2__NmJ08\">四、公開資料不能拿來當判決</h2><p class=\"LearnArticle_p__aZlQ1\">監理若要查這類行為，靠的不是你截圖的三筆明細，而是帳戶、委託與成交的對照。一般看盤者沒有那些資料，卻常先寫完劇本：有人在對敲、所以接下來會怎樣。劇本一寫，後面每筆成交都變成證據。這是確認偏誤，不是辨識。你愈確定自己看見了不該看的東西，愈該停下來問：我有沒有帳戶？沒有就沒有判決權。</p><ol class=\"LearnArticle_listNum__86N5S\"><li>沒有帳戶對照，就沒有鑑定</li><li>不要用三筆齊的成交寫劇本</li><li>更不要因為劇本去模仿任何手法</li></ol></section><section id=\"sec-5\" class=\"LearnArticle_section__hLVjU\"><h2 class=\"LearnArticle_h2__NmJ08\">五、比較穩的讀法是降低陰謀，不是抓人</h2><p class=\"LearnArticle_p__aZlQ1\">看到雙向成交，比較有用的句子是：這個價現在兩邊都有人願意立刻成交。這句話描述流動性，不指控人格。流動性好不好，影響的是你自己的滑價與能不能走，這才是一般看盤用得上的層。把逐筆當成抓對敲的現場，精力會用錯地方，也容易把自己訓練成什麼都像有人在配。那不是更敏銳，是更累、也更容易被自己嚇到。</p></section><section id=\"sec-6\" class=\"LearnArticle_section__hLVjU\"><h2 class=\"LearnArticle_h2__NmJ08\">常見問題 FAQ</h2><div class=\"LearnArticle_faq__cemBp\"><details class=\"LearnArticle_faqItem__I9h0U\"><summary>看起來很像，能不能懷疑？</summary><p class=\"LearnArticle_faqA__IPuvc\">你可以覺得「這串成交很齊」。要把齊翻譯成違法，需要帳戶層資料。公開畫面停在描述就好。</p></details><details class=\"LearnArticle_faqItem__I9h0U\"><summary>量突然放大又不太跌，是不是對敲？</summary><p class=\"LearnArticle_faqA__IPuvc\">量價組合有很多解釋：兩邊都急、消息、程式、打開漲跌停。單一組合不能當罪名。</p></details><details class=\"LearnArticle_faqItem__I9h0U\"><summary>這篇為什麼還要寫怎麼看？</summary><p class=\"LearnArticle_faqA__IPuvc\">因為誤讀本身會害人：你會用一個無法驗證的故事做決定。看，是為了少讀成陰謀，不是為了學會做。</p></details><details class=\"LearnArticle_faqItem__I9h0U\"><summary>發現真的很可疑該怎麼辦？</summary><p class=\"LearnArticle_faqA__IPuvc\">一般投資人沒有調查權。不要模仿、不要傳播指控。規範與檢舉管道以主管機關公告為準，本文不展開。</p></details></div></section><section id=\"sec-7\" class=\"LearnArticle_section__hLVjU\"><h2 class=\"LearnArticle_h2__NmJ08\">總結</h2><p class=\"LearnArticle_p__aZlQ1\">對敲是違法行為，不要學。公開逐筆的同價來回，合法雙向成交也常長這樣。沒有帳戶就沒有鑑定，只描述流動性，不寫抓人劇本。</p></section><section id=\"sec-8\" class=\"LearnArticle_section__hLVjU\"><h2 class=\"LearnArticle_h2__NmJ08\">延伸閱讀</h2><ul class=\"LearnArticle_list__WjxqC\"><li><a class=\"LearnArticle_link__gMwHV\" href=\"/learn/how-to-read-order-book-five-levels\">五檔掛單四層讀法</a></li><li><a class=\"LearnArticle_link__gMwHV\" href=\"/diary\">新手導覽</a></li><li><a class=\"LearnArticle_link__gMwHV\" href=\"/school\">台股學堂</a></li></ul></section><div class=\"LearnArticle_related__9qV55\"><p class=\"LearnArticle_relatedTitle__RXfrl\">相關文章</p><a class=\"LearnArticle_relatedLink__mibXe\" href=\"/learn/how-to-read-order-book-five-levels\">五檔掛單四層讀法</a></div></div></article></div><!--$--><!--/$--></main><script src=\"/_next/static/chunks/webpack-1cf2182201f6bdb6.js\" id=\"_R_\" async=\"\"></script><script>(self.__next_f=self.__next_f||[]).push([0])</script><script>self.__next_f.push([1,\"1:\\\"$Sreact.fragment\\\"\\n2:I[81259,[\\\"2619\\\",\\\"static/chunks/2619-04bc32f026a0d946.js\\\",\\\"7177\\\",\