\"fallback\":null,\"children\":\"$L17\"}]}]}]]}]\n18:I[52619,[\"2619\",\"static/chunks/2619-04bc32f026a0d946.js\",\"6309\",\"static/chunks/app/learn/%5Bslug%5D/page-f7b99344f7e2ee16.js\"],\"\"]\ne:[\"$\",\"div\",null,{\"className\":\"LearnArticle_wrap__LIQ8G\",\"children\":[\"$\",\"article\",null,{\"className\":\"LearnArticle_article__2nBbk\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_meta__etj_G\",\"children\":[[\"$\",\"$L18\",null,{\"className\":\"LearnArticle_cat__GQMlg\",\"href\":\"/learn?c=tech\",\"children\":\"技術面\"}],[\"$\",\"span\",null,{\"className\":\"LearnArticle_read__QEj6a\",\"children\":\"閱讀約 6 分鐘\"}]]}],[\"$\",\"h1\",null,{\"className\":\"LearnArticle_title__0_la8\",\"children\":\"台股振幅怎麼算？超過7%要注意3分鐘看懂振幅大小的意義\"}],[\"$\",\"details\",null,{\"className\":\"LearnArticle_toc__LcSAa\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"LearnArticle_tocSummary__YBddG\",\"children\":\"本文目錄\"}],[\"$\",\"ol\",null,{\"className\":\"LearnArticle_tocList__Rq_Lz\",\"children\":[[\"$\",\"li\",\"sec-1\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-1\",\"children\":\"一、振幅到底是什麼？我該怎麼自己算？\"}]}],[\"$\",\"li\",\"sec-2\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-2\",\"children\":\"二、振幅 3% 跟 10% 差在哪？看懂數字背後的多空角力\"}]}],[\"$\",\"li\",\"sec-3\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-3\",\"children\":\"三、只看振幅會犯什麼錯？小心！一定要搭配「成交量」\"}]}],[\"$\",\"li\",\"sec-4\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-4\",\"children\":\"四、同樣是 10% 大振幅，出現在高點和低點意思一樣嗎？\"}]}],[\"$\",\"li\",\"sec-5\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-5\",\"children\":\"五、如何快速找到今天市場上波動大的股票？\"}]}],[\"$\",\"li\",\"sec-6\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-6\",\"children\":\"常見問題 FAQ\"}]}],[\"$\",\"li\",\"sec-7\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-7\",\"children\":\"總結\"}]}],[\"$\",\"li\",\"sec-8\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-8\",\"children\":\"延伸閱讀\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"LearnArticle_body__6B7Mb\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_intro__ATV5c\",\"children\":\"看著盤中股價上沖下洗，心裡七上八下，到底今天這檔股票的波動算大還是小？這篇文章就是要教你看懂「振幅」這個指標，讓你一眼判斷當天多空交戰的激烈程度。\"}],[[\"$\",\"figure\",\"figure-0\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"開／高／低／收實體＝開收之間；影線＝最高與最低紅 K 收漲綠 K 收跌十字線長紅長綠\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"示意圖｜日 K：紅漲綠跌，影線是當天曾走過的路（教學結構，不是某檔實盤）\"}]]}]],[\"$\",\"div\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"振幅公式為：(當日最高價 - 最低價) ÷ 昨日收盤價 x 100%。\"}],[\"$\",\"li\",\"1\",{\"children\":\"單日振幅超過 7% 代表多空交戰激烈，可能是趨勢轉折或延續的信號。\"}],[\"$\",\"li\",\"2\",{\"children\":\"高檔爆量長黑K配上大振幅，是潛在的賣出訊號，需特別留意。\"}],[\"$\",\"li\",\"3\",{\"children\":\"振幅需搭配成交量與 K 棒位置一起看，單看振幅數字容易誤判。\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、振幅到底是什麼？我該怎麼自己算？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"「振幅」指的是一檔股票在一天之內的價格波動範圍，簡單來說，就是今天股價最高點到最低點的距離，佔昨天收盤價的百分比。這個數字可以幫助我們了解這檔股票今天交易的熱絡程度，以及多空雙方力量的拉扯有多激烈。\"}],[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"第一步：找出今天的最高價與最低價。\"}],[\"$\",\"li\",\"1\",{\"children\":\"第二步：找出昨天的收盤價當作計算基礎。\"}],[\"$\",\"li\",\"2\",{\"children\":\"第三步：套入公式：(最高價 - 最低價) ÷ 昨日收盤價 × 100%。\"}],[\"$\",\"li\",\"3\",{\"children\":\"舉例：假設 A 股票昨天收 100 元，今天盤中最高漲到 105 元，最低跌到 98 元。那今天的振幅就是 (105 - 98) ÷ 100 × 100% = 7%。\"}]]}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、振幅 3% 跟 10% 差在哪？看懂數字背後的多空角力\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"算出來的振幅數字，到底代表什麼意思？你可以把它想像成拔河比賽的激烈程度。振幅小，表示兩邊力氣差不多，繩子不太動；振幅大，表示兩邊都用盡全力，繩子來回拉扯的幅度就很大。一般來說，我們可以透過一個簡單的門檻來快速判斷。\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"振幅大小\"}],[\"$\",\"th\",\"1\",{\"children\":\"市場狀態\"}],[\"$\",\"th\",\"2\",{\"children\":\"可能的後續走勢\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"小於 3%\"}],[\"$\",\"td\",\"1\",{\"children\":\"多空雙方觀望，交投冷清\"}],[\"$\",\"td\",\"2\",{\"children\":\"盤整或等待方向\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"3% - 7%\"}],[\"$\",\"td\",\"1\",{\"children\":\"市場有一定熱度，正常波動\"}],[\"$\",\"td\",\"2\",{\"children\":\"延續原有趨勢\"}]]}],[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"大於 7%\"}],[\"$\",\"td\",\"1\",{\"children\":\"多空交戰激烈，有主力介入\"}],[\"$\",\"td\",\"2\",{\"children\":\"可能出現轉折或趨勢加速\"}]]}]]}]]}]}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、只看振幅會犯什麼錯？小心！一定要搭配「成交量」\"}],[\"$L19\",\"$L1a\",\"$L1b\"]]}],\"$L1c\",\"$L1d\",\"$L1e\",\"$L1f\",\"$L20\"],null]}]]}]}]\n19:[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"很多新手看到大振幅就覺得很興奮，但這是常見的錯誤。振幅只告訴你「波動很大」，卻沒說波動是往上還是往下。因此，你必須搭配「成交量」一起看，才能更準確地解讀市場訊息。成交量代表參與這場拔河比賽的人數，人多又拉扯激烈，才具有參考意義。\"}]\n1a:[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"高檔大振幅 + 爆量長黑K：主力可能在出貨，是個警訊。\"}],[\"$\",\"li\",\"1\",{\"children\":\"低檔大振幅 + 爆量長紅K：可能有資金進場承接，是觀察訊號。\"}],[\"$\",\"li\",\"2\",{\"children\":\"量縮 + 小振幅：處於整理階段，市場在等待方向。\"}],[\"$\",\"li\",\"3\",{\"children\":\"價漲量增 + 振幅放大：健康的攻擊訊號，趨勢可能延續。\"}]]}]\n1b:[\"$\",\"figure\",\"2\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"✓成交量大小✓K棒收盤位置✓股價相對高低點\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"解讀振幅的三個搭配指標\"}]]}]\n1c:[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、同樣是 10% 大振幅，出現在高點和低點意思一樣嗎？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"除了成交量，股價所在的「位階」也是判斷大振幅意義的關鍵。同樣是 10% 的大振幅，出現在長期上漲後的高點，跟出現在長期下跌後的低點，意思完全不同。前者可能是危險信號，後者則可能是機會的開端。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"想像一檔股票從 50 元漲到 150 元，已經漲了一大段。這時在高檔區出現超過 10% 的大振幅，而且收盤時收在相對低點，就要小心是不是有人在高點倒貨。反之，如果股價已經盤整或下跌很久，在相對低檔區出現帶量的大振幅紅K棒，就可能是攻擊發起的信號。\"}]]}]]]}]\n1d:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、如何快速找到今天市場上波動大的股票？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"每天台股上千檔股票，要自己一檔一檔算振幅太花時間了。其實你可以利用工具來幫你快速篩選。在股市大佬的「今日戰情」頁面中，我們已經幫你整理好當日振幅排行，你可以直接排序，找出當天市場上波動最劇烈的股票。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"找到目標後，再點進「個股透視」頁面，結合我們前面提到的 K 線、成交量與股價位階一起判斷，就能大幅節省你做功課的時間，把精力專注在分析解讀上。\"}]]}]]]}]\n1e:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"振幅跟漲跌幅有什麼不一樣？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"漲跌幅是「收盤價」跟「昨日收盤價」的比較，只看結果。振幅是「最高價」跟「最低價」的差距，看的是過程中的波動範圍。一檔股票可能振幅很大，但收盤時漲跌幅很小，例如開高走低又拉回平盤。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"振幅會是負的嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"不會。振幅的計算是取最高價和最低價的差距，這個差距一定是正數或零，所以振幅最小就是 0%，不會出現負數。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"當沖交易者是不是特別喜歡看振幅？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"是的，因為當沖交易者需要在一天內完成買賣來賺取價差，越大的振幅代表潛在的價差空間也越大。因此，振幅排行是許多短線交易者會關注的重要數據。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"除權息當天的振幅參考價值高嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"除權息當天因為股價會先扣除股利價值，開盤的參考價會比昨天的收盤價低，這會讓振幅的計算基礎改變。雖然公式依然適用，但在解讀上要特別小心，建議可以觀察幾天，等股價回穩後再來看會比較客觀。\"}]]}]]}]]]}]\n1f:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"總結來說，振幅是衡量股價波動的尺，但單一把尺無法蓋出房子。記得將振幅搭配「成交量」與「K棒位階」這兩大樑柱一起看，才能建構出更穩固的盤勢判斷。\"}]]]}]\n20:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L18\",\"0-想知道今天誰最刺\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"想知道今天誰最刺激？來看今日戰情\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L18\",\"0-看不懂K棒？台股\",{\"href\":\"/school\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"看不懂K棒？台股學堂從零教你\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L18\",\"0-深入研究個股籌碼\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"深入研究個股籌碼，從這裡開始\"}]]}]]}]]]}]\n14:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\n10:null\n21:I[80622,[],\"IconMark\"]\n12:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"台股振幅怎麼算？超過7%要注意3分鐘看懂振幅大小的意義｜股市大佬 TradeBoss\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"看著盤中股價上沖下洗，心裡七上八下，到底今天這檔股票的波動算大還是小？這篇文章就是要教你看懂「振幅」這個指標，讓你一眼判斷當天多空交戰的激烈程度。\"}],[\"$\",\"link\",\"2\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}],[\"$\",\"$L21\",\"3\",{}]],\"error\":null,\"digest\":\"$undefined\"}\n17:\"$12:metadata\"\n"}