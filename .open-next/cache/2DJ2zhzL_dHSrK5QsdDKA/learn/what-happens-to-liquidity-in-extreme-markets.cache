e:[\"$\",\"div\",null,{\"className\":\"LearnArticle_wrap__LIQ8G\",\"children\":[\"$\",\"article\",null,{\"className\":\"LearnArticle_article__2nBbk\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_meta__etj_G\",\"children\":[[\"$\",\"$L18\",null,{\"className\":\"LearnArticle_cat__GQMlg\",\"href\":\"/learn?c=events\",\"children\":\"金融大事件\"}],[\"$\",\"span\",null,{\"className\":\"LearnArticle_read__QEj6a\",\"children\":\"閱讀約 7 分鐘\"}]]}],[\"$\",\"h1\",null,{\"className\":\"LearnArticle_title__0_la8\",\"children\":\"極端行情下流動性會怎樣？3 個訊號看懂股票賣不掉的風險\"}],[\"$\",\"details\",null,{\"className\":\"LearnArticle_toc__LcSAa\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"LearnArticle_tocSummary__YBddG\",\"children\":\"本文目錄\"}],[\"$\",\"ol\",null,{\"className\":\"LearnArticle_tocList__Rq_Lz\",\"children\":[[\"$\",\"li\",\"sec-1\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-1\",\"children\":\"一、到底什麼是「流動性」？為什麼它比漲跌重要？\"}]}],[\"$\",\"li\",\"sec-2\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-2\",\"children\":\"二、如何判斷一檔股票的流動性好不好？\"}]}],[\"$\",\"li\",\"sec-3\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-3\",\"children\":\"三、為什麼市場大跌或大漲時，流動性會突然消失？\"}]}],[\"$\",\"li\",\"sec-4\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-4\",\"children\":\"四、跌停鎖死怎麼辦？掛市價單也賣不掉嗎？\"}]}],[\"$\",\"li\",\"sec-5\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-5\",\"children\":\"五、散戶如何避開流動性風險？三個實用原則\"}]}],[\"$\",\"li\",\"sec-6\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-6\",\"children\":\"常見問題 FAQ\"}]}],[\"$\",\"li\",\"sec-7\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-7\",\"children\":\"總結\"}]}],[\"$\",\"li\",\"sec-8\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-8\",\"children\":\"延伸閱讀\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"LearnArticle_body__6B7Mb\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_intro__ATV5c\",\"children\":\"市場恐慌大跌時，打開看盤軟體，發現手上的股票明明有報價，掛賣單卻怎麼樣都賣不掉？或是漲停時想追價，卻一整天都買不到？這就是「流動性風險」。這篇文章會教你怎麼從盤中幾個簡單數字，判斷流動性是否正在枯竭，保護你的資產。\"}],[],[\"$\",\"div\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"流動性是指「想買就買得到、想賣就賣得掉」的能力，價格穩定是關鍵。\"}],[\"$\",\"li\",\"1\",{\"children\":\"極端行情下，買賣方不願出價，導致掛單稀疏，是流動性枯竭的前兆。\"}],[\"$\",\"li\",\"2\",{\"children\":\"觀察「五檔報價」的掛單量厚度，是判斷個股流動性的最直接方法。\"}],[\"$\",\"li\",\"3\",{\"children\":\"成交量小的冷門股，在市場恐慌時更容易出現流動性問題，應特別留意。\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、到底什麼是「流動性」？為什麼它比漲跌重要？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"流動性（Liquidity）白話說，就是「把手上的股票換成現金的容易程度」。好的流動性代表你想買的時候隨時有人賣，想賣的時候隨時有人買，而且不會因為你的一筆交易就讓價格劇烈跳動。在平穩的市場中，我們很少擔心這個問題，但在市場恐慌或暴漲時，流動性可能瞬間消失，讓你手上部位「看得到、賣不掉」，這是比帳面虧損更可怕的風險。\"}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、如何判斷一檔股票的流動性好不好？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"最簡單的方式，就是看盤中「五檔報價」的掛單量。五檔報價顯示的是最接近成交價的五個買進價位與五個賣出價位，以及それぞれの價位有多少張股票在排隊等著成交。掛單量越厚、越綿密，代表流動性越好。反之，如果掛單量稀疏，甚至出現「斷層」，代表流動性很差，一有風吹草動就可能造成價格劇烈波動。\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"比較項目\"}],[\"$\",\"th\",\"1\",{\"children\":\"流動性佳的股票\"}],[\"$\",\"th\",\"2\",{\"children\":\"流動性差的股票\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"五檔買賣掛單\"}],[\"$\",\"td\",\"1\",{\"children\":\"每個價位都有數十到數百張掛單\"}],[\"$\",\"td\",\"2\",{\"children\":\"每個價位只有個位數掛單，或某些價位沒掛單\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"買賣價差 (Spread)\"}],[\"$\",\"td\",\"1\",{\"children\":\"通常只差一檔（例如買 100.0 / 賣 100.5）\"}],[\"$\",\"td\",\"2\",{\"children\":\"價差可能跳好幾檔（例如買 98.0 / 賣 100.5）\"}]]}],[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"成交狀況\"}],[\"$\",\"td\",\"1\",{\"children\":\"連續且頻繁，每分鐘都有成交紀錄\"}],[\"$\",\"td\",\"2\",{\"children\":\"可能好幾分鐘才成交一筆，價格跳動大\"}]]}]]}]]}]}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、為什麼市場大跌或大漲時，流動性會突然消失？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"這背後是群眾心理。當市場出現重大利空，所有人都想賣股票換現金，買方會瞬間縮手觀望，導致賣單滿天飛，卻沒有足夠的買單承接，股價就會連續跌停。反之，當市場有重大利多，所有人都想搶進，持有者惜售，導致買單高掛，卻沒有賣單願意倒出來，股價就容易連續漲停。在這兩種極端情況下，市場的交易功能近乎停滯，這就是流動性枯竭。\"}],[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"恐慌性賣壓：在崩跌時，潛在買家會選擇等待更低的價格，導致買盤真空。\"}],[\"$\",\"li\",\"1\",{\"children\":\"追價性買盤：在噴出時，持有者預期還有更高價，選擇鎖住不賣，導致賣盤真空。\"}],\"$L19\"]}],\"$L1a\"]]}],\"$L1b\",\"$L1c\",\"$L1d\",\"$L1e\",\"$L1f\"],null]}]]}]}]\n19:[\"$\",\"li\",\"2\",{\"children\":\"資訊不對稱：當市場充滿不確定性，交易者寧願不做不錯，先退場觀望。\"}]\n1a:[\"$\",\"figure\",\"2\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"✓降低高風險個股持有✓分批進出避免衝擊✓保留部分現金部位\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"極端行情下的自保清單\"}]]}]\n1b:[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、跌停鎖死怎麼辦？掛市價單也賣不掉嗎？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"當一檔股票跌停鎖死時，你會看到委賣張數高掛數千甚至數萬張，但委買張數卻是 0 或個位數。這表示在跌停這個價位，有成千上萬張股票等著要賣，但沒有人想買。你的賣單只是排在長長的隊伍後面，成交機會微乎其微。即使你掛「市價賣出」，系統也只會幫你用當下的跌停價去掛單，一樣要排隊，並不會 magically 找到買家。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"跌停價 = 當日最低價，無法用更低的價格賣出。\"}],[\"$\",\"li\",\"1\",{\"children\":\"成交原則是「價格優先、時間優先」，所有跌停賣單都在排隊。\"}],[\"$\",\"li\",\"2\",{\"children\":\"想成功賣出，只能期待有新的買盤進場，打開跌停。\"}]]}]]]}]\n1c:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、散戶如何避開流動性風險？三個實用原則\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"雖然我們無法預測極端行情，但可以透過一些原則來降低自己被困住的風險。關鍵在於，在投入資金前就先評估這檔標的「好不好進出」，而不是只看它會不會漲。特別是資金部位較大的投資人，更應該把流動性當作重要的選股標準之一。\"}],[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"優先選擇日均成交量大的標的：一般來說，日均成交量超過 1,000 張的股票，流動性會比較有保障。成交量太小的冷門股，應避免投入過多資金。\"}],[\"$\",\"li\",\"1\",{\"children\":\"下單前瞥一眼五檔報價：養成習慣，在送出委託單前，快速看一下買賣掛單是否充足，價差是否合理。如果掛單很薄，就要有心理準備，實際成交價可能不如預期。\"}],[\"$\",\"li\",\"2\",{\"children\":\"分散持股：不要將所有資金重壓在單一檔股票，尤其是中小型股。適度分散，即使某檔股票暫時賣不掉，也不會影響你全部的資金運用。\"}]]}]]]}]\n1d:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"流動性跟成交量是一樣的嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"不完全一樣。高成交量通常代表好的流動性，但流動性更強調「價格的穩定性」。你可以在成交量大的情況下，因為一筆大單就造成價格劇烈滑動，這就是流動性不夠深的表現。好的流動性是，即使有大單進出，價格也能保持相對穩定。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"跌停板的股票，為什麼掛市價賣也賣不掉？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"因為「市價單」需要有對手方才能成交。當股票跌停時，市場上只有想賣的人，沒有想買的人。你的市價賣單會被系統自動轉為「跌停價賣單」，然後跟其他數千張賣單一起排隊，等待買方出現。在買盤出現前，是無法成交的。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"是不是所有股票在股災時都會喪失流動性？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"大部分股票的流動性都會下降，但程度不同。通常大型權值股、台灣50成分股等，因為機構法人與投資者眾多，即使在股災中仍能維持一定的交易量能。而中小型股、投機性較高的股票，流動性枯竭的狀況會嚴重許多。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"盤前試撮合出現漲停或跌停，代表流動性有問題嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"這是一個非常強烈的警訊。盤前試撮的價格，反映了所有掛單在開盤前的多空意向。如果出現漲停或跌停，代表買方或賣方的力量極度失衡，預告了開盤後這檔股票的流動性將會非常單向，交易會很困難。\"}]]}]]}]]]}]\n1e:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"在投入資金前，除了看 K 線圖，更要養成看「五檔報價」的習慣。確認買賣掛單充足、價差合理，才能確保在關鍵時刻，你的資產能夠順利進出，而不是卡在帳面上動彈不得。\"}]]]}]\n1f:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L18\",\"0-台股學堂：學習更\",{\"href\":\"/school\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"台股學堂：學習更多基礎知識\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L18\",\"0-個股透視：查詢個\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"個股透視：查詢個股的五檔報價與成交明細\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L18\",\"0-大盤總覽：掌握市\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"大盤總覽：掌握市場整體的恐慌指數\"}]]}]]}]]]}]\n14:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\n10:null\n20:I[80622,[],\"IconMark\"]\n12:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"極端行情下流動性會怎樣？3 個訊號看懂股票賣不掉的風險｜股市大佬 TradeBoss\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"市場恐慌大跌時，打開看盤軟體，發現手上的股票明明有報價，掛賣單卻怎麼樣都賣不掉？或是漲停時想追價，卻一整天都買不到？這就是「流動性風險」。這篇文章會教你怎麼從盤中幾個簡單數字，判斷流動性是否正在枯竭，保護你的資產。\"}],[\"$\",\"link\",\"2\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}],[\"$\",\"$L20\",\"3\",{}]],\"error\":null,\"digest\":\"$undefined\"}\n17:\"$12:metadata\"\n"}