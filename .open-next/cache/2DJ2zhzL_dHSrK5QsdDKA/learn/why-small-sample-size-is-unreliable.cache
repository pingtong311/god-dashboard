[\"$\",\"link\",\"0\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/css/3eaf36e367672966.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"$undefined\"}]],[\"$\",\"$Le\",null,{\"children\":[\"$Lf\",[\"$\",\"$L10\",null,{\"promise\":\"$@11\"}]]}]]}]\nb:[\"$\",\"$1\",\"h\",{\"children\":[null,[[\"$\",\"$L12\",null,{\"children\":\"$L13\"}],[\"$\",\"meta\",null,{\"name\":\"next-size-adjust\",\"content\":\"\"}]],[\"$\",\"$L14\",null,{\"children\":[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$15\",null,{\"fallback\":null,\"children\":\"$L16\"}]}]}]]}]\n17:I[52619,[\"2619\",\"static/chunks/2619-04bc32f026a0d946.js\",\"6309\",\"static/chunks/app/learn/%5Bslug%5D/page-f7b99344f7e2ee16.js\"],\"\"]\nd:[\"$\",\"div\",null,{\"className\":\"LearnArticle_wrap__LIQ8G\",\"children\":[\"$\",\"article\",null,{\"className\":\"LearnArticle_article__2nBbk\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_meta__etj_G\",\"children\":[[\"$\",\"$L17\",null,{\"className\":\"LearnArticle_cat__GQMlg\",\"href\":\"/learn?c=mindset\",\"children\":\"心態與風控\"}],[\"$\",\"span\",null,{\"className\":\"LearnArticle_read__QEj6a\",\"children\":\"閱讀約 6 分鐘\"}]]}],[\"$\",\"h1\",null,{\"className\":\"LearnArticle_title__0_la8\",\"children\":\"樣本數太少為什麼不能用？回測 10 次勝率 8 成，小心只是運氣好\"}],[\"$\",\"details\",null,{\"className\":\"LearnArticle_toc__LcSAa\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"LearnArticle_tocSummary__YBddG\",\"children\":\"本文目錄\"}],[\"$\",\"ol\",null,{\"className\":\"LearnArticle_tocList__Rq_Lz\",\"children\":[[\"$\",\"li\",\"sec-1\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-1\",\"children\":\"一、為什麼回測 10 次對 8 次，不代表勝率 80%？\"}]}],[\"$\",\"li\",\"sec-2\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-2\",\"children\":\"二、看分點籌碼，只看一天就夠了嗎？\"}]}],[\"$\",\"li\",\"sec-3\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-3\",\"children\":\"三、到底要多少樣本數，才算「夠多」？\"}]}],[\"$\",\"li\",\"sec-4\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-4\",\"children\":\"四、小心「存活者偏誤」：你只看到成功的故事\"}]}],[\"$\",\"li\",\"sec-5\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-5\",\"children\":\"五、如何用股市大佬，建立自己的觀察清單？\"}]}],[\"$\",\"li\",\"sec-6\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-6\",\"children\":\"常見問題 FAQ\"}]}],[\"$\",\"li\",\"sec-7\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-7\",\"children\":\"總結\"}]}],[\"$\",\"li\",\"sec-8\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-8\",\"children\":\"延伸閱讀\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"LearnArticle_body__6B7Mb\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_intro__ATV5c\",\"children\":\"在網路上看到有人分享交易策略，回測 5 次對了 4 次，勝率高達 80%，看起來很誘人？先別急著投入資金。這種「樣本數太少」的結論，很可能是投資中最常見的陷阱之一，這篇文章會教你如何識破它。\"}],[[\"$\",\"figure\",\"figure-0\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"虧 3 次每次 −1%賺 2 次每次 +1%勝率 40% 也可能是正期望，前提是賺的比虧的大、且扣得起成本短線先扣約 0.24% 當沖成本，再看還剩多少\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"示意圖｜期望值：勝率要配上平均賺賠，再扣成本（教學結構，不是某檔實盤）\"}]]}]],[\"$\",\"div\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"樣本數太少，「勝率」只是巧合：回測次數低於 30 次的策略，高勝率很可能只是運氣。\"}],[\"$\",\"li\",\"1\",{\"children\":\"單一分點的單日進出不代表趨勢：只看一天或一檔股票的買賣，無法判斷主力真實意圖。\"}],[\"$\",\"li\",\"2\",{\"children\":\"如何建立有效觀察？至少觀察一個月、或超過 50 次交易紀錄，結論才比較可靠。\"}],[\"$\",\"li\",\"3\",{\"children\":\"別把「個案」當「通則」：成功的案例可能只是特例，要找的是能重複發生的規律。\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、為什麼回測 10 次對 8 次，不代表勝率 80%？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"這就像丟銅板一樣。理論上正反面機率各 50%，但如果只丟 10 次，很可能出現 8 次正面、2 次反面的結果。你會因此斷定這枚銅板有問題，丟出正面的機率是 80% 嗎？當然不會。交易策略也是同樣道理，在短期、少數的回測中，運氣佔了很大成份。一個策略的真實效益，需要經過大量且不同市場情境的驗證，才能排除偶然性，看出它真正的規律。\"}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、看分點籌碼，只看一天就夠了嗎？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"打開個股的分點進出表，看到某個券商分點今天大買了 500 張，就覺得是主力進場，明天準備大漲？這也是典型的樣本不足。這筆大單可能只是某個大戶的單日操作，甚至是避險、轉倉需求，隔天可能就賣掉了。只用一天的數據去推斷一個「主力」的長期意圖，風險非常高。有效的觀察，應該是拉長時間，例如看他一週、一個月內是持續買進還是買賣互見，才能拼湊出更完整的圖像。\"}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、到底要多少樣本數，才算「夠多」？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"這沒有絕對標準答案，但我們可以建立一個基本的判斷門檻。在統計學上，樣本數 30 常被當作一個分水嶺，超過 30，數據分佈會比較接近常態，結論比較穩定。在股市回測中，至少要有 50-100 次以上的交易紀錄，才比較有參考價值。觀察分點法人，至少要看一整季（三個月）的連續進出，才能判斷其趨勢。重點是，要多到足以排除單純的運氣。\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"觀察項目\"}],[\"$\",\"th\",\"1\",{\"children\":\"樣本數太少 (例：<10次)\"}],[\"$\",\"th\",\"2\",{\"children\":\"樣本數充足 (例：>50次)\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"結論可信度\"}],[\"$\",\"td\",\"1\",{\"children\":\"低，可能為巧合\"}],[\"$\",\"td\",\"2\",{\"children\":\"高，較能反映規律\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[\"$L18\",\"$L19\",\"$L1a\"]}],\"$L1b\"]}]]}]}],\"$L1c\"]]}],\"$L1d\",\"$L1e\",\"$L1f\",\"$L20\",\"$L21\"],null]}]]}]}]\n18:[\"$\",\"td\",\"0\",{\"children\":\"反映的現象\"}]\n19:[\"$\",\"td\",\"1\",{\"children\":\"單一事件、特例\"}]\n1a:[\"$\",\"td\",\"2\",{\"children\":\"長期趨勢、通則\"}]\n1b:[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"決策風險\"}],[\"$\",\"td\",\"1\",{\"children\":\"高，容易誤判\"}],[\"$\",\"td\",\"2\",{\"children\":\"較低，有數據支撐\"}]]}]\n1c:[\"$\",\"figure\",\"2\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"✓定義觀察對象✓拉長觀察時間✓記錄並驗證規律\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"建立可靠觀察的 3 步驟\"}]]}]\n1d:[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、小心「存活者偏誤」：你只看到成功的故事\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"樣本數太少的問題，經常伴隨著「存活者偏誤」。意思是，你看到的資訊，都已經被篩選過了。在社群媒體上，大家只會分享賺錢的單，虧錢的都默默刪文了。你看到某個策略好像很神，是因為用了這策略失敗的 100 個人都沒出聲，只有成功的那 1 個人大肆宣揚。這會讓你嚴重高估策略的勝率，因為你的「樣本」本身就是偏頗的。\"}]]]}]\n1e:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、如何用股市大佬，建立自己的觀察清單？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"與其相信別人樣本數不足的結論，不如自己動手驗證。你可以利用「個股透視」功能，設定不同的時間區間，例如三個月、半年，去觀察特定分點在這段時間內的累積買賣超。這樣得出的數據，遠比只看一天的排行榜來得可靠。把幾個你長期關注的分點或指標建立成自己的觀察清單，持續追蹤，這才是建立自己交易邏輯的穩固基礎。\"}]]]}]\n1f:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"如果一個策略只適用於特殊情況，樣本數本來就很少怎麼辦？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"這種情況下，更要謹慎。你可以把條件放寬一點點來增加回測樣本，或者接受這是一個「低頻率」策略，配置的資金就不能太多，並搭配其他更穩健的策略一起使用。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"新聞說某外資「大買」某檔股票，這算樣本數太少嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"是的，這只是單一事件。你需要去查證該外資過去一段時間（例如一季）是持續買進還是買賣互見，以及它在其他同類股票上的操作，才能更完整地判斷其意圖。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"看到某個網路名人推薦的股票漲了，這可以信嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"這也是典型的樣本數不足加上存活者偏誤。你只看到他推薦成功的案例，卻沒看到失敗的。一個可信的分析，會提供的是「方法」與「數據」，而不是單一的標的。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"是不是樣本數越多就一定越好？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"在一定範圍內是的，但也要注意數據的「時效性」。例如，十年前的交易模式，可能已不適用今日的市場。因此，選擇「近期且足夠多」的樣本，會比單純追求海量但過時的數據來得更有意義。\"}]]}]]}]]]}]\n20:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"總結來說，下次看到任何驚人的數據時，先問自己一個問題：「這個結論的樣本數是多少？」養成檢查數據規模的習慣，能幫你過濾掉市場上 90% 的雜訊與看似誘人的陷阱。\"}]]]}]\n21:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L17\",\"0-用「個股透視」拉\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"用「個股透視」拉長時間看籌碼\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L17\",\"0-更多籌碼教學，都\",{\"href\":\"/school\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"更多籌碼教學，都在台股學堂\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L17\",\"0-看看其他教學專欄\",{\"href\":\"/learn\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"看看其他教學專欄文章\"}]]}]]}]]]}]\n13:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\nf:null\n22:I[80622,[],\"IconMark\"]\n11:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"樣本數太少為什麼不能用？回測 10 次勝率 8 成，小心只是運氣好｜股市大佬 TradeBoss\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"在網路上看到有人分享交易策略，回測 5 次對了 4 次，勝率高達 80%，看起來很誘人？先別急著投入資金。這種「樣本數太少」的結論，很可能是投資中最常見的陷阱之一，這篇文章會教你如何識破它。\"}],[\"$\",\"link\",\"2\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}],[\"$\",\"$L22\",\"3\",{}]],\"error\":null,\"digest\":\"$undefined\"}\n16:\"$11:metadata\"\n"}