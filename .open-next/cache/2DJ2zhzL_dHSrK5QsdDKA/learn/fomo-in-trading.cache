\",\"$1\",\"c\",{\"children\":[null,[\"$\",\"$L4\",null,{\"parallelRouterKey\":\"children\",\"error\":\"$undefined\",\"errorStyles\":\"$undefined\",\"errorScripts\":\"$undefined\",\"template\":[\"$\",\"$L5\",null,{}],\"templateStyles\":\"$undefined\",\"templateScripts\":\"$undefined\",\"notFound\":\"$undefined\",\"forbidden\":\"$undefined\",\"unauthorized\":\"$undefined\"}]]}],{\"children\":[[\"slug\",\"fomo-in-trading\",\"d\"],\"$L9\",{\"children\":[\"__PAGE__\",\"$La\",{},null,false]},null,false]},null,false]},null,false],\"$Lb\",false]],\"m\":\"$undefined\",\"G\":[\"$c\",[]],\"s\":false,\"S\":true}\ne:I[24431,[],\"OutletBoundary\"]\n10:I[15278,[],\"AsyncMetadataOutlet\"]\n12:I[24431,[],\"ViewportBoundary\"]\n14:I[24431,[],\"MetadataBoundary\"]\n15:\"$Sreact.suspense\"\n9:[\"$\",\"$1\",\"c\",{\"children\":[null,[\"$\",\"$L4\",null,{\"parallelRouterKey\":\"children\",\"error\":\"$undefined\",\"errorStyles\":\"$undefined\",\"errorScripts\":\"$undefined\",\"template\":[\"$\",\"$L5\",null,{}],\"templateStyles\":\"$undefined\",\"templateScripts\":\"$undefined\",\"notFound\":\"$undefined\",\"forbidden\":\"$undefined\",\"unauthorized\":\"$undefined\"}]]}]\na:[\"$\",\"$1\",\"c\",{\"children\":[\"$Ld\",[[\"$\",\"link\",\"0\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/css/3eaf36e367672966.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"$undefined\"}]],[\"$\",\"$Le\",null,{\"children\":[\"$Lf\",[\"$\",\"$L10\",null,{\"promise\":\"$@11\"}]]}]]}]\nb:[\"$\",\"$1\",\"h\",{\"children\":[null,[[\"$\",\"$L12\",null,{\"children\":\"$L13\"}],[\"$\",\"meta\",null,{\"name\":\"next-size-adjust\",\"content\":\"\"}]],[\"$\",\"$L14\",null,{\"children\":[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$15\",null,{\"fallback\":null,\"children\":\"$L16\"}]}]}]]}]\n17:I[52619,[\"2619\",\"static/chunks/2619-04bc32f026a0d946.js\",\"6309\",\"static/chunks/app/learn/%5Bslug%5D/page-f7b99344f7e2ee16.js\"],\"\"]\nd:[\"$\",\"div\",null,{\"className\":\"LearnArticle_wrap__LIQ8G\",\"children\":[\"$\",\"article\",null,{\"className\":\"LearnArticle_article__2nBbk\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_meta__etj_G\",\"children\":[[\"$\",\"$L17\",null,{\"className\":\"LearnArticle_cat__GQMlg\",\"href\":\"/learn?c=mindset\",\"children\":\"心態與風控\"}],[\"$\",\"span\",null,{\"className\":\"LearnArticle_read__QEj6a\",\"children\":\"閱讀約 5 分鐘\"}]]}],[\"$\",\"h1\",null,{\"className\":\"LearnArticle_title__0_la8\",\"children\":\"為什麼你總在最不該進場的時候覺得非買不可\"}],[\"$\",\"details\",null,{\"className\":\"LearnArticle_toc__LcSAa\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"LearnArticle_tocSummary__YBddG\",\"children\":\"本文目錄\"}],[\"$\",\"ol\",null,{\"className\":\"LearnArticle_tocList__Rq_Lz\",\"children\":[[\"$\",\"li\",\"sec-1\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-1\",\"children\":\"一、錯失恐懼在什麼時候最強\"}]}],[\"$\",\"li\",\"sec-2\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-2\",\"children\":\"二、它讓風險評估直接失效\"}]}],[\"$\",\"li\",\"sec-3\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-3\",\"children\":\"三、為什麼「這次不一樣」特別危險\"}]}],[\"$\",\"li\",\"sec-4\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-4\",\"children\":\"四、處理方式一：把感受當成訊號而不是理由\"}]}],[\"$\",\"li\",\"sec-5\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-5\",\"children\":\"五、處理方式二：強制降低第一次的規模\"}]}],[\"$\",\"li\",\"sec-6\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-6\",\"children\":\"六、處理方式三：記錄「沒做的那些」\"}]}],[\"$\",\"li\",\"sec-7\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-7\",\"children\":\"七、機會其實不稀缺\"}]}],[\"$\",\"li\",\"sec-8\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-8\",\"children\":\"常見問題 FAQ\"}]}],[\"$\",\"li\",\"sec-9\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-9\",\"children\":\"總結\"}]}],[\"$\",\"li\",\"sec-10\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-10\",\"children\":\"延伸閱讀\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"LearnArticle_body__6B7Mb\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_intro__ATV5c\",\"children\":\"看到一檔股票連續大漲、群組裡都在討論，那種「再不進場就來不及」的感覺會非常強烈。這種感覺有個特徵值得注意：它的強度和進場的合理程度，經常是反向的。\"}],[],[\"$\",\"div\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"錯失恐懼在價格已漲、旁人在賺、自己沒部位時最強，而那正是資訊擴散最廣的階段\"}],[\"$\",\"li\",\"1\",{\"children\":\"把那個感覺當成判斷力下降的提醒、強制縮小規模、並記錄放棄的標的\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、錯失恐懼在什麼時候最強\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"它需要三個條件同時成立：價格已經明顯上漲、身邊有人在賺、以及你手上沒有部位。三者齊備時感受最強。問題在於這三個條件本身就描述了一個「資訊已經擴散開來」的狀態——也就是還沒進場的人正在變少的階段。感受最強的時候，剩餘空間通常最小。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"價格已明顯上漲\"}],[\"$\",\"li\",\"1\",{\"children\":\"身邊有人在賺，且說得出來\"}],[\"$\",\"li\",\"2\",{\"children\":\"你手上沒有部位\"}]]}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、它讓風險評估直接失效\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"正常的評估流程是先看風險再看報酬。錯失恐懼會把順序反過來：先看到別人賺多少，然後才想到風險，而且會傾向低估。實際表現出來的就是——這一筆的停損位置特別遠或根本沒設，部位卻特別大。這個組合是所有進場方式裡最貴的一種。\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"狀態\"}],[\"$\",\"th\",\"1\",{\"children\":\"正常評估\"}],[\"$\",\"th\",\"2\",{\"children\":\"錯失恐懼下\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"評估順序\"}],[\"$\",\"td\",\"1\",{\"children\":\"先風險後報酬\"}],[\"$\",\"td\",\"2\",{\"children\":\"先報酬，風險事後補\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"失效條件\"}],[\"$\",\"td\",\"1\",{\"children\":\"事前寫定\"}],[\"$\",\"td\",\"2\",{\"children\":\"常常沒有\"}]]}],[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"部位大小\"}],[\"$\",\"td\",\"1\",{\"children\":\"依風險距離回推\"}],[\"$\",\"td\",\"2\",{\"children\":\"憑感覺，偏大\"}]]}],[\"$\",\"tr\",\"3\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"進場理由\"}],[\"$\",\"td\",\"1\",{\"children\":\"符合既有規則\"}],[\"$\",\"td\",\"2\",{\"children\":\"因為別人在賺\"}]]}]]}]]}]}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、為什麼「這次不一樣」特別危險\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"當你發現自己在為破例找理由時，那個理由通常都成立——產業真的在成長、政策真的有利、需求真的存在。問題不是理由假，而是這些理由跟「現在這個價格是否合理」是兩件不同的事。看對方向和買在好價格可以完全分開，前者無法補償後者。\"}]]]}],[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、處理方式一：把感受當成訊號而不是理由\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"最實用的一招是重新定義那個感覺：不要把它當成「該進場了」的訊號，而是當成「我現在的判斷力正在下降」的提醒。這個轉換不需要意志力，只需要事前決定好這個對應關係。感覺出現時，第一個動作變成檢查而不是下單。\"}],\"$L18\",\"$L19\"]]}],\"$L1a\",\"$L1b\",\"$L1c\",\"$L1d\",\"$L1e\",\"$L1f\"],null]}]]}]}]\n18:[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"感覺出現時，先當成判斷力下降的提醒\"}],[\"$\",\"li\",\"1\",{\"children\":\"第一個動作是檢查規則，不是下單\"}],[\"$\",\"li\",\"2\",{\"children\":\"事前就把這個對應關係寫下來\"}]]}]\n19:[\"$\",\"figure\",\"2\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"✓當成判斷力下降訊號✓強制縮小規模✓記錄放棄的標的\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"三個處理方式\"}]]}]\n1a:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、處理方式二：強制降低第一次的規模\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"如果檢查完仍然決定要做，規定這種情況下的部位必須明顯小於平常。理由是這種進場的資訊品質較差，理應用較小的規模承擔。這比「完全不做」更容易執行，因為它同時滿足了參與的需求和風險控制的要求。\"}]]]}]\n1b:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"六、處理方式三：記錄「沒做的那些」\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"多數人只記得自己錯過的那幾檔飛上去的股票，完全不記得放棄的那些後來跌了。這種選擇性記憶會不斷強化錯失恐懼。解法是把「因為太熱鬧而放棄」的標的記下來，一個月後回頭看。多數人第一次做這件事會很意外——放棄的裡面有不少後來走弱。\"}],[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"把因為太熱鬧而放棄的標的記下來\"}],[\"$\",\"li\",\"1\",{\"children\":\"一個月後回頭看它們的走勢\"}],[\"$\",\"li\",\"2\",{\"children\":\"用數字對抗選擇性記憶\"}]]}]]]}]\n1c:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"七、機會其實不稀缺\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"錯失恐懼的核心假設是「這是難得的機會」。但市場每天都在運作，符合任何一套規則的機會會反覆出現。真正稀缺的不是機會，而是你的資金和心理狀態——這兩樣用完了才是真的沒有下一次。理解這個順序，那種急迫感會明顯下降。\"}]]]}]\n1d:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"看到大家都在賺，真的不能進場嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"可以，但要先做兩件事：確認它符合你原本的規則，以及把部位降到明顯小於平常。這種進場的資訊品質較差，理應用較小規模承擔。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"怎麼分辨是真機會還是錯失恐懼？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"看能不能在進場前寫出完整的失效條件與出場條件。寫得出來且符合原本規則，是機會；寫不出來卻很想下單，通常是錯失恐懼。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"「這次不一樣」有時候真的不一樣吧？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"理由常常是對的，但那跟現在這個價格是否合理是兩件事。看對方向和買在好價格可以完全分開，而前者無法補償後者。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"怎麼降低錯過的焦慮？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"記錄那些「因為太熱鬧而放棄」的標的，一個月後回頭看。多數人會發現放棄的裡面有不少後來走弱，只是這些從來不會被記住。用數字對抗選擇性記憶。\"}]]}]]}]]]}]\n1e:[\"$\",\"section\",\"sec-9\",{\"id\":\"sec-9\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"錯失恐懼在價格已漲、旁人在賺、自己沒部位時最強，而那正是資訊擴散最廣的階段。把那個感覺當成判斷力下降的提醒、強制縮小規模、並記錄放棄的標的。\"}]]]}]\n1f:[\"$\",\"section\",\"sec-10\",{\"id\":\"sec-10\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L17\",\"0-題材行情的四個階\",{\"href\":\"/learn\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"題材行情的四個階段\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L17\",\"0-交易觀念與名詞：\",{\"href\":\"/school\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"交易觀念與名詞：台股學堂\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L17\",\"0-本站的立場與免責\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"本站的立場與免責說明\"}]]}]]}]]]}]\n13:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\nf:null\n20:I[80622,[],\"IconMark\"]\n11:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"為什麼你總在最不該進場的時候覺得非買不可｜股市大佬 TradeBoss\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"看到一檔股票連續大漲、群組裡都在討論，那種「再不進場就來不及」的感覺會非常強烈。這種感覺有個特徵值得注意：它的強度和進場的合理程度，經常是反向的。\"}],[\"$\",\"link\",\"2\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}],[\"$\",\"$L20\",\"3\",{}]],\"error\":null,\"digest\":\"$undefined\"}\n16:\"$11:metadata\"\n"}