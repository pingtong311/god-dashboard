":[\"$\",\"$15\",null,{\"fallback\":null,\"children\":\"$L16\"}]}]}]]}]\n17:I[52619,[\"2619\",\"static/chunks/2619-04bc32f026a0d946.js\",\"6309\",\"static/chunks/app/learn/%5Bslug%5D/page-f7b99344f7e2ee16.js\"],\"\"]\nd:[\"$\",\"div\",null,{\"className\":\"LearnArticle_wrap__LIQ8G\",\"children\":[\"$\",\"article\",null,{\"className\":\"LearnArticle_article__2nBbk\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_meta__etj_G\",\"children\":[[\"$\",\"$L17\",null,{\"className\":\"LearnArticle_cat__GQMlg\",\"href\":\"/learn?c=rules\",\"children\":\"制度與工具\"}],[\"$\",\"span\",null,{\"className\":\"LearnArticle_read__QEj6a\",\"children\":\"閱讀約 6 分鐘\"}]]}],[\"$\",\"h1\",null,{\"className\":\"LearnArticle_title__0_la8\",\"children\":\"存貨周轉率怎麼看？3步驟看懂公司賣貨速度，避開庫存地雷\"}],[\"$\",\"details\",null,{\"className\":\"LearnArticle_toc__LcSAa\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"LearnArticle_tocSummary__YBddG\",\"children\":\"本文目錄\"}],[\"$\",\"ol\",null,{\"className\":\"LearnArticle_tocList__Rq_Lz\",\"children\":[[\"$\",\"li\",\"sec-1\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-1\",\"children\":\"一、存貨周轉率是什麼？為什麼散戶也要懂？\"}]}],[\"$\",\"li\",\"sec-2\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-2\",\"children\":\"二、存貨周轉率的數字在哪找？怎麼算？\"}]}],[\"$\",\"li\",\"sec-3\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-3\",\"children\":\"三、存貨周轉率越高越好嗎？看懂優缺點比較表\"}]}],[\"$\",\"li\",\"sec-4\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-4\",\"children\":\"四、搭配「存貨周轉天數」一起看，判斷更精準\"}]}],[\"$\",\"li\",\"sec-5\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-5\",\"children\":\"五、如何應用在選股上？散戶最常犯的三個錯\"}]}],[\"$\",\"li\",\"sec-6\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-6\",\"children\":\"常見問題 FAQ\"}]}],[\"$\",\"li\",\"sec-7\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-7\",\"children\":\"總結\"}]}],[\"$\",\"li\",\"sec-8\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-8\",\"children\":\"延伸閱讀\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"LearnArticle_body__6B7Mb\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_intro__ATV5c\",\"children\":\"看到財報一堆數字就頭痛？「存貨周轉率」聽起來很專業，但它其實是判斷公司賣貨速度的照妖鏡。這篇會教你怎麼用這個指標，一眼看出公司的產品到底夯不夯。\"}],[[\"$\",\"figure\",\"figure-0\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"沒扣成本的勝率，看起來都會比較漂亮0.029%手續費 1 折來回0.15%當沖證交稅0.06%滑價估計三項合計約 0.24%；留倉稅率更高，約 0.39%\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"示意圖｜當沖來回成本：1 折手續費 + 證交稅 + 滑價（教學結構，不是某檔實盤）\"}]]}]],[\"$\",\"div\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"存貨周轉率越高，代表公司賣貨速度越快，資金運用效率越好。\"}],[\"$\",\"li\",\"1\",{\"children\":\"比較存貨周轉率時，要跟「公司自己過去」和「同產業對手」比才有意義。\"}],[\"$\",\"li\",\"2\",{\"children\":\"存貨周轉天數越短越好，代表商品從進貨到賣出所需時間很短。\"}],[\"$\",\"li\",\"3\",{\"children\":\"單看一季數字容易誤判，建議觀察至少連續 4 季的趨勢變化。\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、存貨周轉率是什麼？為什麼散戶也要懂？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"簡單來說，「存貨周轉率」就像餐廳的「翻桌率」。翻桌率越高，代表客人一直來、生意很好；存貨周轉率越高，就代表公司產品賣得很快，很少堆在倉庫裡。這個數字能幫助我們判斷一家公司的產品競爭力與經營效率，即使不看盤，也能從財報看出端倪。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"判斷產品熱銷程度：數字越高，表示產品很受市場歡迎。\"}],[\"$\",\"li\",\"1\",{\"children\":\"衡量庫存管理能力：高周轉代表公司不會囤積過多貨品，減少倉儲成本與跌價風險。\"}],[\"$\",\"li\",\"2\",{\"children\":\"評估資金運用效率：貨賣得快，錢就能越快收回來，再投入下一批生產，形成良性循環。\"}]]}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、存貨周轉率的數字在哪找？怎麼算？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"你不需要自己拿計算機按。現在的看盤軟體或財經網站，通常都會直接把算好的數字列出來。但了解它的算法，能讓你更懂它背後的意義。公式是：「銷貨成本 ÷ 平均存貨價值」。銷貨成本就是公司賣出商品的總成本；平均存貨就是期初跟期末倉庫裡貨品的平均價值。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"舉例來說，A 公司一整年的銷貨成本是 1,000 萬，年初倉庫有 150 萬的貨，年底有 250 萬的貨，平均存貨就是 (150+250)÷2 = 200 萬。那麼它的存貨周轉率就是 1,000 ÷ 200 = 5（次）。代表這家公司一年內把所有庫存賣掉、再補貨，循環了 5 次。\"}]]}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、存貨周轉率越高越好嗎？看懂優缺點比較表\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"大部分情況下，存貨周轉率是越高越好，代表經營效率佳。但凡事沒有絕對，太高或太低都可能有潛在問題。不同產業的標準也完全不同，例如賣麵包的周轉率一定比賣飛機的高很多。透過下表，你可以快速了解高低周轉率各自代表的意義。\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"特性\"}],\"$L18\",\"$L19\"]}]}],\"$L1a\"]}]}],\"$L1b\"]]}],\"$L1c\",\"$L1d\",\"$L1e\",\"$L1f\",\"$L20\"],null]}]]}]}]\n18:[\"$\",\"th\",\"1\",{\"children\":\"存貨周轉率【高】\"}]\n19:[\"$\",\"th\",\"2\",{\"children\":\"存貨周轉率【低】\"}]\n1a:[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"優點\"}],[\"$\",\"td\",\"1\",{\"children\":\"產品暢銷、資金積壓少\"}],[\"$\",\"td\",\"2\",{\"children\":\"不易缺貨、可應付急單\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"缺點\"}],[\"$\",\"td\",\"1\",{\"children\":\"可能因頻繁缺貨錯失訂單\"}],[\"$\",\"td\",\"2\",{\"children\":\"產品滯銷、庫存成本與跌價風險高\"}]]}],[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"常見產業\"}],[\"$\",\"td\",\"1\",{\"children\":\"食品、零售、快時尚\"}],[\"$\",\"td\",\"2\",{\"children\":\"精品、重工業、營建\"}]]}]]}]\n1b:[\"$\",\"figure\",\"2\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"!禁止跨產業比較!小心季節性因素!搭配毛利率檢查\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"解讀數字的常見陷阱\"}]]}]\n1c:[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、搭配「存貨周轉天數」一起看，判斷更精準\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"如果覺得「一年轉幾次」很抽象，可以把它換算成「賣光要幾天」，這就是「存貨周轉天數」。這個數字越短越好，代表商品從進貨到賣給客人，中間停留的時間很短。公式是：「365 天 ÷ 存貨周轉率」。\"}],[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"延續剛才的例子，A 公司的存貨周轉率是 5 次。\"}],[\"$\",\"li\",\"1\",{\"children\":\"它的存貨周轉天數就是：365 ÷ 5 = 73 天。\"}],[\"$\",\"li\",\"2\",{\"children\":\"這表示，A 公司的商品平均需要 73 天才能全部賣掉。如果它的同業平均是 90 天，那 A 公司的表現就算相當不錯。\"}]]}]]]}]\n1d:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、如何應用在選股上？散戶最常犯的三個錯\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"學會看懂存貨周轉率後，你就有了一項避開「庫存地雷股」的實用工具。但在實際應用時，請務必避開以下三個常見的錯誤，才能讓你的判斷更客觀，而不是被單一數字誤導。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"常見錯誤一：跨產業比較。拿台積電的周轉率去跟統一超比較，是沒有意義的。請務必在同一個產業裡比較，才能看出誰是前段班。\"}],[\"$\",\"li\",\"1\",{\"children\":\"常見錯誤二：只看單一季度。很多產業有淡旺季之分，例如第四季電子業出貨旺季，周轉率通常會拉高。要觀察至少連續四個季度，看長期趨勢是向上還是向下。\"}],[\"$\",\"li\",\"2\",{\"children\":\"常見錯誤三：忽略毛利率變化。如果周轉率變高，但毛利率卻大幅下滑，這可能是公司正在「流血大拍賣」清庫存，這種成長並不健康。\"}]]}]]]}]\n1e:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"存貨周轉率多少才算「好」？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"沒有絕對標準。重點是跟公司自己過去的表現，以及同產業的競爭對手比較。如果數字持續上升，且優於同業平均，就是一個健康的訊號。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"為什麼電子業的存貨周轉率特別重要？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"因為電子產品生命週期短、跌價快。庫存放太久，很快就變沒價值的過時品，會嚴重侵蝕獲利。所以高周轉率對電子業來說是生存關鍵。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"存貨周轉率突然大幅下降，代表什麼？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"這通常是個警訊。可能代表產品賣不動、市場需求減弱，或是公司對未來景氣過度樂觀而生產太多。需要留意後續財報是否出現虧損。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"如果一家公司完全沒有存貨，是最好的嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"不一定。這通常只適用於服務業或軟體業。對於製造業或零售業，零庫存代表無法應對突如其來的訂單，可能會流失客戶，反而不利於長期發展。\"}]]}]]}]]]}]\n1f:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"觀察存貨周轉率，重點在於「比較」與「趨勢」。找一家周轉率持續進步、且優於同業的公司，通常代表它的產品競爭力與管理能力正在提升。\"}]]]}]\n20:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L17\",\"0-想學更多財報指標\",{\"href\":\"/school\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"想學更多財報指標？台股學堂都幫你整理好了\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L17\",\"0-立即查詢個股的最\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"立即查詢個股的最新存貨周轉率\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L17\",\"0-看看哪些產業族群\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"看看哪些產業族群最近庫存壓力大\"}]]}]]}]]]}]\n13:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\nf:null\n21:I[80622,[],\"IconMark\"]\n11:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"存貨周轉率怎麼看？3步驟看懂公司賣貨速度，避開庫存地雷｜股市大佬 TradeBoss\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"看到財報一堆數字就頭痛？「存貨周轉率」聽起來很專業，但它其實是判斷公司賣貨速度的照妖鏡。這篇會教你怎麼用這個指標，一眼看出公司的產品到底夯不夯。\"}],[\"$\",\"link\",\"2\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}],[\"$\",\"$L21\",\"3\",{}]],\"error\":null,\"digest\":\"$undefined\"}\n16:\"$11:metadata\"\n"}