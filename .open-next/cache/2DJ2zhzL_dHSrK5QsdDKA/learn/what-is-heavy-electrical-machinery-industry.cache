l,{}]]}]]}]]}],{\"children\":[\"learn\",[\"$\",\"$1\",\"c\",{\"children\":[null,[\"$\",\"$L4\",null,{\"parallelRouterKey\":\"children\",\"error\":\"$undefined\",\"errorStyles\":\"$undefined\",\"errorScripts\":\"$undefined\",\"template\":[\"$\",\"$L5\",null,{}],\"templateStyles\":\"$undefined\",\"templateScripts\":\"$undefined\",\"notFound\":\"$undefined\",\"forbidden\":\"$undefined\",\"unauthorized\":\"$undefined\"}]]}],{\"children\":[[\"slug\",\"what-is-heavy-electrical-machinery-industry\",\"d\"],\"$L9\",{\"children\":[\"__PAGE__\",\"$La\",{},null,false]},null,false]},null,false]},null,false],\"$Lb\",false]],\"m\":\"$undefined\",\"G\":[\"$c\",[]],\"s\":false,\"S\":true}\ne:I[24431,[],\"OutletBoundary\"]\n10:I[15278,[],\"AsyncMetadataOutlet\"]\n12:I[24431,[],\"ViewportBoundary\"]\n14:I[24431,[],\"MetadataBoundary\"]\n15:\"$Sreact.suspense\"\n9:[\"$\",\"$1\",\"c\",{\"children\":[null,[\"$\",\"$L4\",null,{\"parallelRouterKey\":\"children\",\"error\":\"$undefined\",\"errorStyles\":\"$undefined\",\"errorScripts\":\"$undefined\",\"template\":[\"$\",\"$L5\",null,{}],\"templateStyles\":\"$undefined\",\"templateScripts\":\"$undefined\",\"notFound\":\"$undefined\",\"forbidden\":\"$undefined\",\"unauthorized\":\"$undefined\"}]]}]\na:[\"$\",\"$1\",\"c\",{\"children\":[\"$Ld\",[[\"$\",\"link\",\"0\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/css/3eaf36e367672966.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"$undefined\"}]],[\"$\",\"$Le\",null,{\"children\":[\"$Lf\",[\"$\",\"$L10\",null,{\"promise\":\"$@11\"}]]}]]}]\nb:[\"$\",\"$1\",\"h\",{\"children\":[null,[[\"$\",\"$L12\",null,{\"children\":\"$L13\"}],[\"$\",\"meta\",null,{\"name\":\"next-size-adjust\",\"content\":\"\"}]],[\"$\",\"$L14\",null,{\"children\":[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$15\",null,{\"fallback\":null,\"children\":\"$L16\"}]}]}]]}]\n17:I[52619,[\"2619\",\"static/chunks/2619-04bc32f026a0d946.js\",\"6309\",\"static/chunks/app/learn/%5Bslug%5D/page-f7b99344f7e2ee16.js\"],\"\"]\nd:[\"$\",\"div\",null,{\"className\":\"LearnArticle_wrap__LIQ8G\",\"children\":[\"$\",\"article\",null,{\"className\":\"LearnArticle_article__2nBbk\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_meta__etj_G\",\"children\":[[\"$\",\"$L17\",null,{\"className\":\"LearnArticle_cat__GQMlg\",\"href\":\"/learn?c=trends\",\"children\":\"產業與趨勢\"}],[\"$\",\"span\",null,{\"className\":\"LearnArticle_read__QEj6a\",\"children\":\"閱讀約 7 分鐘\"}]]}],[\"$\",\"h1\",null,{\"className\":\"LearnArticle_title__0_la8\",\"children\":\"重電產業在做什麼？不只蓋電廠，3 分鐘看懂台電強韌電網計畫商機\"}],[\"$\",\"details\",null,{\"className\":\"LearnArticle_toc__LcSAa\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"LearnArticle_tocSummary__YBddG\",\"children\":\"本文目錄\"}],[\"$\",\"ol\",null,{\"className\":\"LearnArticle_tocList__Rq_Lz\",\"children\":[[\"$\",\"li\",\"sec-1\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-1\",\"children\":\"一、「重電」到底是什麼？跟家裡的電器差在哪？\"}]}],[\"$\",\"li\",\"sec-2\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-2\",\"children\":\"二、為什麼最近重電股這麼紅？關鍵在「台電強韌電網計畫」\"}]}],[\"$\",\"li\",\"sec-3\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-3\",\"children\":\"三、重電產業鏈有哪些角色？一張表看懂誰在做什麼\"}]}],[\"$\",\"li\",\"sec-4\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-4\",\"children\":\"四、如何判斷一家重電公司的好壞？看懂 3 個關鍵數字\"}]}],[\"$\",\"li\",\"sec-5\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-5\",\"children\":\"五、常見迷思：營收創新高，就代表公司前景一片大好嗎？\"}]}],[\"$\",\"li\",\"sec-6\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-6\",\"children\":\"常見問題 FAQ\"}]}],[\"$\",\"li\",\"sec-7\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-7\",\"children\":\"總結\"}]}],[\"$\",\"li\",\"sec-8\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-8\",\"children\":\"延伸閱讀\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"LearnArticle_body__6B7Mb\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_intro__ATV5c\",\"children\":\"最近常常聽到新聞、分析師在談「重電」，好像是市場上最熱門的題材，但打開看盤軟體，看到一堆公司名字，還是搞不懂它們到底是做什麼的？跟我們家裡的電鍋、冷氣有什麼不一樣？這篇文章會用最簡單的方式，帶你了解重電產業的核心，以及如何從公開資訊判斷它的成長潛力。\"}],[],[\"$\",\"div\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"重電不只是蓋發電廠，更關鍵的業務是「輸電」與「配電」的設備。\"}],[\"$\",\"li\",\"1\",{\"children\":\"台電「強韌電網計畫」是近年最大的成長動能，需求長達十年。\"}],[\"$\",\"li\",\"2\",{\"children\":\"判斷公司好壞，要看「在手訂單」而非只看當月營收。\"}],[\"$\",\"li\",\"3\",{\"children\":\"毛利率的變化比營收更重要，它反映了公司的成本控制與議價能力。\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、「重電」到底是什麼？跟家裡的電器差在哪？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"簡單來說，電力系統就像自來水系統。發電廠是「水庫」，負責生產；家裡的電器是「水龍頭」，負責使用。而「重電」產業，就是負責中間那段最關鍵的「水管網路」，也就是把電力從發電廠安全、穩定地送到你家。這些設備包括大型變壓器、電纜、開關設備等，體積大、技術門檻高，所以稱為「重」電。跟一般家電（輕電）相比，它們的客戶不是一般民眾，而是台電或大型工廠。\"}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、為什麼最近重電股這麼紅？關鍵在「台電強韌電網計畫」\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"過去幾年，台灣偶爾會發生大規模停電，原因常是單一電廠或線路故障，就影響到大範圍地區。為了解決這個問題，台電啟動了長達十年的「強韌電網計畫」，總預算超過 5000 億。這個計畫的核心有兩個：一是「設備汰舊換新」，把用了幾十年的老舊設備換掉；二是「分散風險」，建立更多備援線路，讓電網像一個多節點的漁網，就算破了一個洞，其他地方還能正常運作。這就為重電設備製造商帶來了龐大且長期的訂單需求。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"一個常見錯誤：以為這只是短期題材。強韌電網計畫是長達十年的國家級建設，需求穩定。\"}],[\"$\",\"li\",\"1\",{\"children\":\"一個判斷方法：觀察政府預算的執行進度，就能推估未來幾年產業的需求強度。\"}],[\"$\",\"li\",\"2\",{\"children\":\"一組數字門檻：整個計畫總預算達 5,645 億元（以主管機關最新公告為準，2026-08 查證），規模非常龐大。\"}]]}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、重電產業鏈有哪些角色？一張表看懂誰在做什麼\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"整個電力系統可以粗略分成發電、輸配電、儲能與用戶端。雖然大家統稱「重電股」，但每家公司專長的領域不同，有的做變壓器，有的做電纜。了解它們在產業鏈的位置，有助於你判斷誰會最先受惠於政策。例如，電網更新計畫最直接相關的就是「輸配電」環節的廠商。\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"產業環節\"}],[\"$\",\"th\",\"1\",{\"children\":\"主要產品/服務\"}],[\"$\",\"th\",\"2\",{\"children\":\"關注重點\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"發電\"}],[\"$\",\"td\",\"1\",{\"children\":\"發電機、鍋爐、汽輪機\"}],[\"$\",\"td\",\"2\",{\"children\":\"燃料成本、發電效率\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"輸配電\"}],[\"$\",\"td\",\"1\",{\"children\":\"變壓器、開關設備、電線電纜\"}],[\"$\",\"td\",\"2\",{\"children\":\"台電標案、在手訂單、銅價\"}]]}],\"$L18\",\"$L19\"]}]]}]}],\"$L1a\"]]}],\"$L1b\",\"$L1c\",\"$L1d\",\"$L1e\",\"$L1f\"],null]}]]}]}]\n18:[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"儲能\"}],[\"$\",\"td\",\"1\",{\"children\":\"電池系統、能源管理系統 (EMS)\"}],[\"$\",\"td\",\"2\",{\"children\":\"電池芯成本、系統整合能力\"}]]}]\n19:[\"$\",\"tr\",\"3\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"用戶端\"}],[\"$\",\"td\",\"1\",{\"children\":\"智慧電表、充電樁設備\"}],[\"$\",\"td\",\"2\",{\"children\":\"政策補助、安裝普及率\"}]]}]\n1a:[\"$\",\"figure\",\"2\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"✓在手訂單飽滿度✓毛利率是否提升✓訂單營收比\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"檢視重電公司 3 指標\"}]]}]\n1b:[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、如何判斷一家重電公司的好壞？看懂 3 個關鍵數字\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"當市場一窩蜂討論時，我們更要回歸基本面，看數字說話。對於重電這種訂單能見度高的產業，有三個數字比股價漲跌更重要，它們能幫助你判斷一家公司的營運狀況是否真的健康。\"}],[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"在手訂單金額：這代表公司未來幾年的收入保障。如果一家公司一年的營收是 100 億，但它手上有 300 億的訂單待執行，代表未來三年的生意都已經有著落了，營運相對穩健。\"}],[\"$\",\"li\",\"1\",{\"children\":\"毛利率趨勢：營收增加不代表獲利一定增加。要觀察毛利率是否跟著提升。如果毛利率下滑，可能代表公司接到利潤較差的案子，或是原物料（如銅）成本上漲侵蝕了獲利。\"}],[\"$\",\"li\",\"2\",{\"children\":\"訂單營收比：將「在手訂單」除以「年營收」。這個數字如果大於 2，通常表示訂單能見度高，產能利用率也較為飽滿，是個不錯的參考指標。\"}]]}]]]}]\n1c:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、常見迷思：營收創新高，就代表公司前景一片大好嗎？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"很多散戶看到「營收創歷史新高」的新聞就急著進場，但在重電產業，這可能是一個落後指標。因為重電業的專案工期很長，從接單、生產到裝機、驗收，可能要好幾年。營收是「已經完成並認列」的數字，但股價通常會提早反應「未來」的預期。因此，與其只看當月營收，不如去關注法說會或財報中公布的「在手訂單」或「新增訂單」金額，那才是真正領先的指標，更能反映公司的成長動能。\"}]]]}]\n1d:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"重電股跟綠能股有什麼不一樣？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"它們是合作關係，但業務不同。綠能（如太陽能、風力發電）是負責「產生」電力，屬於發電端；重電則是負責建立穩定可靠的「電網」，來輸送這些電力。綠能發展越快，對電網穩定性的要求就越高，也就越需要重電產業的設備來配合。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"這些公司的訂單都只來自台電嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"不完全是。雖然台電的強韌電網計畫是目前國內最大的訂單來源，但許多台灣的重電公司技術實力堅強，也積極拓展海外市場，例如美國的基礎建設計畫、東南亞的電網升級，都是重要的外銷機會。可以從公司的財報中觀察內外銷比重。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"強韌電網計畫會持續多久？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"根據台電的規劃，這是一個為期十年的長期計畫（2022-2032）。這代表相關的設備採購和工程需求，在未來幾年內都會持續釋出，為產業帶來相對穩定的成長動能，而不是曇花一現的短期題材。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"股價已經漲這麼多了，現在還能關注嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"我們的重點是學習如何評估一間公司的價值，而不是預測股價高低。與其煩惱價位，不如回頭檢視基本面：公司的在手訂單是否持續增加？毛利率有沒有改善？目前的股價是否已經過度反映了未來的獲利預期？學會這些判斷方法，比猜測市場情緒更重要。\"}]]}]]}]]]}]\n1e:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"總結來說，觀察重電產業的重點，要先從「政策驅動」來理解龐大需求的來源，再用「在手訂單」與「毛利率趨勢」這兩個指標，來檢視個別公司的執行能力與獲利品質。學會看懂訂單的含金量，比單純追逐市場熱度來得更踏實。\"}]]]}]\n1f:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L17\",\"0-到「台股學堂」看\",{\"href\":\"/school\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"到「台股學堂」看更多產業知識\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L17\",\"0-用「族群透視」找\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"用「族群透視」找出相關概念股\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L17\",\"0-查詢個股的詳細財\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"查詢個股的詳細財務數據\"}]]}]]}]]]}]\n13:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\nf:null\n20:I[80622,[],\"IconMark\"]\n11:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"重電產業在做什麼？不只蓋電廠，3 分鐘看懂台電強韌電網計畫商機｜股市大佬 TradeBoss\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"最近常常聽到新聞、分析師在談「重電」，好像是市場上最熱門的題材，但打開看盤軟體，看到一堆公司名字，還是搞不懂它們到底是做什麼的？跟我們家裡的電鍋、冷氣有什麼不一樣？這篇文章會用最簡單的方式，帶你了解重電產業的核心，以及如何從公開資訊判斷它的成長潛力。\"}],[\"$\",\"link\",\"2\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}],[\"$\",\"$L20\",\"3\",{}]],\"error\":null,\"digest\":\"$undefined\"}\n16:\"$11:metadata\"\n"}