2619\",\"static/chunks/2619-04bc32f026a0d946.js\",\"6309\",\"static/chunks/app/learn/%5Bslug%5D/page-f7b99344f7e2ee16.js\"],\"\"]\nd:[\"$\",\"div\",null,{\"className\":\"LearnArticle_wrap__LIQ8G\",\"children\":[\"$\",\"article\",null,{\"className\":\"LearnArticle_article__2nBbk\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_meta__etj_G\",\"children\":[[\"$\",\"$L17\",null,{\"className\":\"LearnArticle_cat__GQMlg\",\"href\":\"/learn?c=tech\",\"children\":\"技術面\"}],[\"$\",\"span\",null,{\"className\":\"LearnArticle_read__QEj6a\",\"children\":\"閱讀約 9 分鐘\"}]]}],[\"$\",\"h1\",null,{\"className\":\"LearnArticle_title__0_la8\",\"children\":\"RSI 指標怎麼看？一篇搞懂鈍化、背離與黃金交叉的買賣點\"}],[\"$\",\"details\",null,{\"className\":\"LearnArticle_toc__LcSAa\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"LearnArticle_tocSummary__YBddG\",\"children\":\"本文目錄\"}],[\"$\",\"ol\",null,{\"className\":\"LearnArticle_tocList__Rq_Lz\",\"children\":[[\"$\",\"li\",\"sec-1\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-1\",\"children\":\"一、K 線圖底下那條線是什麼？RSI 指標一眼看懂股價溫度\"}]}],[\"$\",\"li\",\"sec-2\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-2\",\"children\":\"二、RSI 超過 80 就該賣？小心「高檔鈍化」賣在半山腰\"}]}],[\"$\",\"li\",\"sec-3\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-3\",\"children\":\"三、RSI 低於 20 能進場？當心「低檔鈍化」的無底洞\"}]}],[\"$\",\"li\",\"sec-4\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-4\",\"children\":\"四、只看一條線不夠？用 RSI 雙線「黃金交叉」找機會點\"}]}],[\"$\",\"li\",\"sec-5\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-5\",\"children\":\"五、股價創新高，指標卻沒跟上？看懂「背離」提早發現反轉警訊\"}]}],[\"$\",\"li\",\"sec-6\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-6\",\"children\":\"常見問題 FAQ\"}]}],[\"$\",\"li\",\"sec-7\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-7\",\"children\":\"總結\"}]}],[\"$\",\"li\",\"sec-8\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-8\",\"children\":\"延伸閱讀\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"LearnArticle_body__6B7Mb\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_intro__ATV5c\",\"children\":\"打開 K 線圖，底下那條彎來彎去的線，一下衝上 80、一下跌破 20，這就是 RSI 指標。很多人以為數字高就該賣、數字低就該買，結果常常賣在起漲點、買在下跌段。這篇文章會用具體數字和情境，教你看懂 RSI 背後的強弱訊號，不再對著指標乾瞪眼。\"}],[[\"$\",\"figure\",\"figure-0\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"0–100 的相對強弱，不是下一個方向705030高檔鈍化超買 ≠ 明天會跌；先看它是趨勢還是震盪\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"示意圖｜RSI：70 以上常叫超買，強勢股也可以在高檔鈍化很久（教學結構，不是某檔實盤）\"}]]}]],[\"$\",\"div\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"RSI 高於 80 代表市場過熱，但若持續居高不下（鈍化），表示趨勢強勁，不是立刻賣出的訊號。\"}],[\"$\",\"li\",\"1\",{\"children\":\"RSI 低於 20 代表市場過冷，但若持續低迷（鈍化），表示趨勢疲弱，不該當作馬上進場的理由。\"}],[\"$\",\"li\",\"2\",{\"children\":\"當短天期 RSI 向上穿越長天期（黃金交叉），是買進力道增強的參考訊號。\"}],[\"$\",\"li\",\"3\",{\"children\":\"股價創新高、RSI 卻沒有跟上（背離），是趨勢可能反轉的警訊，需要特別留意。\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、K 線圖底下那條線是什麼？RSI 指標一眼看懂股價溫度\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"RSI 的全名是「相對強弱指標」（Relative Strength Index），你可以把它想像成一個「股價溫度計」，測量的是一段時間內，股價上漲和下跌力量的相對強度。它的數值在 0 到 100 之間。簡單來說，當 RSI 數值越高，代表近期買進的力道越強、市場情緒越熱；反之，數值越低，代表賣出的力道較強、市場情緒偏冷。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"一個判斷方法：傳統上認為 RSI > 70 為「超買區」（市場過熱），RSI < 30 為「超賣區」（市場過冷）。但這只是一個初步的觀察區間，不是絕對的買賣指令。\"}],[\"$\",\"li\",\"1\",{\"children\":\"一組數字門檻：更積極的觀察者會用 80 和 20 作為更極端的「過熱」與「過冷」分界線，訊號更少，但可能更顯著。\"}],[\"$\",\"li\",\"2\",{\"children\":\"一個常見錯誤：看到 RSI 進入超買或超賣區就立刻反向操作。這是最常見的錯誤，因為強勢的股票可能持續過熱，弱勢的股票也可能持續過冷。\"}]]}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、RSI 超過 80 就該賣？小心「高檔鈍化」賣在半山腰\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"很多投資人看到 RSI 衝上 80，就覺得「太高了、該賣了」，結果眼睜睜看著股價繼續向上衝。這種情況稱為「高檔鈍化」，意思是市場買氣非常強勁，導致 RSI 指標一直「黏」在高檔區（例如持續在 80 以上），失去了上下擺盪的參考價值。這在市場關注度高的股票上特別常見。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"一個判斷方法：當 RSI 連續 3 到 5 個交易日都維持在 80 以上，就可視為進入高檔鈍化。這時候它代表的不是「即將反轉」，而是「趨勢很強」。\"}],[\"$\",\"li\",\"1\",{\"children\":\"應對策略：在鈍化期間，不應急著賣出。反而要觀察 RSI 何時「跌破」80 或 70 這個關卡，這才可能是第一道力道減弱的警訊。\"}],[\"$\",\"li\",\"2\",{\"children\":\"舉例：假設一檔股票從 100 元開始漲，RSI 很快就衝到 85。如果接下來股價漲到 120 元，RSI 都維持在 80-90 之間，這就是典型的軋空行情，太早賣出就會錯過後段利潤。\"}]]}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[\"$L18\",[\"$L19\",\"$L1a\",\"$L1b\"]]}],\"$L1c\",\"$L1d\",\"$L1e\",\"$L1f\",\"$L20\"],null]}]]}]}]\n18:[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、RSI 低於 20 能進場？當心「低檔鈍化」的無底洞\"}]\n19:[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"同樣的道理，看到 RSI 掉到 20 以下，也別高興得太早，以為撿到便宜。當一檔股票基本面或籌碼面出現問題，賣壓會持續不斷，股價一直破底，這時 RSI 也會「躺平」在低檔區，這就是「低檔鈍化」。此時若貿然進場，很可能接到不斷掉下來的刀子。\"}]\n1a:[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"一個判斷方法：當 RSI 連續好幾天都在 20 以下徘徊，代表市場棄守的賣壓沉重，趨勢非常疲弱。\"}],[\"$\",\"li\",\"1\",{\"children\":\"應對策略：不要因為 RSI 低就買進。更好的做法是耐心等待，直到 RSI 明顯由下往上「突破」20 或 30，這代表賣壓暫歇，開始有買盤進場承接，是相對安全的觀察點。\"}],[\"$\",\"li\",\"2\",{\"children\":\"一個常見錯誤：只看 RSI 低就分批往下承接，完全不看 K 線是否止跌。這在空頭走勢中，很容易讓資產持續縮水。\"}]]}]\n1b:[\"$\",\"figure\",\"2\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"!看到超買就放空!看到超賣就進場!忽略鈍化的趨勢!把指標當絕對預測\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"使用 RSI 的常見誤區\"}]]}]\n1c:[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、只看一條線不夠？用 RSI 雙線「黃金交叉」找機會點\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"為了讓訊號更穩定，很多人會同時看兩條不同週期的 RSI 線，例如一條短天期（如 6 日 RSI）和一條長天期（如 12 日 RSI）。短天期線反應快，長天期線反應慢。當短線向上穿越長線，稱為「黃金交叉」，反之則是「死亡交叉」。這提供了比單純看 80/20 更豐富的動能變化資訊。\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"訊號類型\"}],[\"$\",\"th\",\"1\",{\"children\":\"線圖特徵\"}],[\"$\",\"th\",\"2\",{\"children\":\"代表意義\"}],[\"$\",\"th\",\"3\",{\"children\":\"應對策略\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"黃金交叉\"}],[\"$\",\"td\",\"1\",{\"children\":\"短天期 RSI 線由下往上，穿越長天期 RSI 線。\"}],[\"$\",\"td\",\"2\",{\"children\":\"短期買進力道轉強，勝過長期平均，市場可能轉趨樂觀。\"}],[\"$\",\"td\",\"3\",{\"children\":\"可視為一個參考的進場或加碼訊號，若伴隨成交量放大則更佳。\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"死亡交叉\"}],[\"$\",\"td\",\"1\",{\"children\":\"短天期 RSI 線由上往下，跌破長天期 RSI 線。\"}],[\"$\",\"td\",\"2\",{\"children\":\"短期買進力道轉弱，低於長期平均，市場可能轉趨保守。\"}],[\"$\",\"td\",\"3\",{\"children\":\"可視為一個參考的出場或減碼訊號，若股價也跌破重要支撐則應更謹慎。\"}]]}]]}]]}]}]]]}]\n1d:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、股價創新高，指標卻沒跟上？看懂「背離」提早發現反轉警訊\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"「背離」是 RSI 最高階、也最有效的用法之一。意思是股價的走勢和 RSI 指標的走勢「不同步」。當股價創下新高，照理說買氣應該很旺，RSI 也該跟著創高。如果沒有，就代表上漲的力道正在減弱，像一台引擎空轉的車，隨時可能熄火。這就是「熊市背離」或「負背離」，是重要的警訊。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"熊市背離（負背離）：股價創下「更高的高點」，但 RSI 指標卻畫出「更低的高點」。這是上漲力道衰退的警訊，預示可能回檔或反轉。\"}],[\"$\",\"li\",\"1\",{\"children\":\"牛市背離（正背離）：股價創下「更低的低點」，但 RSI 指標卻出現「更高的低點」。這是下跌力道趨緩的訊號，預示可能止跌或反彈。\"}],[\"$\",\"li\",\"2\",{\"children\":\"一個判斷方法：背離出現後，不代表股價會「立刻」反轉，但它提醒你該提高警覺。可以搭配觀察後續 K 線是否出現長黑、或跌破短期均線來做確認。\"}]]}]]]}]\n1e:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"RSI 的參數要設定幾天比較好？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"市場上最常見的預設值是 14 天。如果你是做短線交易，可能會縮短到 6 天或 9 天來提高敏感度，但雜訊也會變多。建議新手先從系統預設的 14 天開始，熟悉它的節奏後再考慮調整。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"RSI 指標在哪裡看得到？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"大部分的券商看盤軟體都有內建。在股市大佬的「個股透視」頁面，技術分析圖中也可以直接開啟 RSI 指標，並與 K 線圖對照，方便你練習判讀。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"RSI 出現黃金交叉就一定會漲嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"不一定。任何技術指標都不是百分之百準確的水晶球。黃金交叉只代表「短期買進的力道相對增強」，是一個參考訊號，仍需要搭配成交量、K 線型態等其他資訊來做綜合判斷，提高準確度。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"RSI 的「鈍化」跟「背離」哪個訊號比較重要？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"「背離」通常被視為更強烈的「反轉」警訊。鈍化代表的是「趨勢的延續」，而背離則是「趨勢可能即將結束」的信號。如果一檔股票在高檔鈍化很久之後，開始出現背離現象，就必須特別留意風險了。\"}]]}]]}]]]}]\n1f:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"總結來說，不要再單純地看 RSI 超過 80 就賣、低於 20 就買。你應該學會觀察「鈍化」來判斷趨勢是否強勁，並利用「黃金/死亡交叉」與「背離」來尋找更可靠的轉折訊號，才能真正發揮 RSI 指標的輔助價值。\"}]]]}]\n20:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L17\",\"0-在「個股透視」頁\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"在「個股透視」頁面，練習看 RSI 指標\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L17\",\"0-想學更多？到「台\",{\"href\":\"/school\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"想學更多？到「台股學堂」看懂技術分析\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L17\",\"0-用「技術型態掃描\",{\"href\":\"/chart\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"用「技術型態掃描」找出更多機會\"}]]}]]}]]]}]\n13:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\nf:null\n21:I[80622,[],\"IconMark\"]\n11:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"RSI 指標怎麼看？一篇搞懂鈍化、背離與黃金交叉的買賣點｜股市大佬 TradeBoss\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"打開 K 線圖，底下那條彎來彎去的線，一下衝上 80、一下跌破 20，這就是 RSI 指標。很多人以為數字高就該賣、數字低就該買，結果常常賣在起漲點、買在下跌段。這篇文章會用具體數字和情境，教你看懂 RSI 背後的強弱訊號，不再對著指標乾瞪眼。\"}],[\"$\",\"link\",\"2\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}],[\"$\",\"$L21\",\"3\",{}]],\"error\":null,\"digest\":\"$undefined\"}\n16:\"$11:metadata\"\n"}