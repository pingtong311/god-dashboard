":\"$undefined\",\"notFound\":\"$undefined\",\"forbidden\":\"$undefined\",\"unauthorized\":\"$undefined\"}]]}]\na:[\"$\",\"$1\",\"c\",{\"children\":[\"$Ld\",[[\"$\",\"link\",\"0\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/css/3eaf36e367672966.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"$undefined\"}]],[\"$\",\"$Le\",null,{\"children\":[\"$Lf\",[\"$\",\"$L10\",null,{\"promise\":\"$@11\"}]]}]]}]\nb:[\"$\",\"$1\",\"h\",{\"children\":[null,[[\"$\",\"$L12\",null,{\"children\":\"$L13\"}],[\"$\",\"meta\",null,{\"name\":\"next-size-adjust\",\"content\":\"\"}]],[\"$\",\"$L14\",null,{\"children\":[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$15\",null,{\"fallback\":null,\"children\":\"$L16\"}]}]}]]}]\n17:I[52619,[\"2619\",\"static/chunks/2619-04bc32f026a0d946.js\",\"6309\",\"static/chunks/app/learn/%5Bslug%5D/page-f7b99344f7e2ee16.js\"],\"\"]\nd:[\"$\",\"div\",null,{\"className\":\"LearnArticle_wrap__LIQ8G\",\"children\":[\"$\",\"article\",null,{\"className\":\"LearnArticle_article__2nBbk\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_meta__etj_G\",\"children\":[[\"$\",\"$L17\",null,{\"className\":\"LearnArticle_cat__GQMlg\",\"href\":\"/learn?c=strategy\",\"children\":\"策略解析\"}],[\"$\",\"span\",null,{\"className\":\"LearnArticle_read__QEj6a\",\"children\":\"閱讀約 5 分鐘\"}]]}],[\"$\",\"h1\",null,{\"className\":\"LearnArticle_title__0_la8\",\"children\":\"最大回撤怎麼看？先問你睡不睡得著，再談報酬\"}],[\"$\",\"details\",null,{\"className\":\"LearnArticle_toc__LcSAa\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"LearnArticle_tocSummary__YBddG\",\"children\":\"本文目錄\"}],[\"$\",\"ol\",null,{\"className\":\"LearnArticle_tocList__Rq_Lz\",\"children\":[[\"$\",\"li\",\"sec-1\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-1\",\"children\":\"一、它在量什麼，不在量什麼\"}]}],[\"$\",\"li\",\"sec-2\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-2\",\"children\":\"二、回測裡的回撤，通常比實盤客氣\"}]}],[\"$\",\"li\",\"sec-3\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-3\",\"children\":\"三、用回撤回推部位，是它最實用的用法\"}]}],[\"$\",\"li\",\"sec-4\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-4\",\"children\":\"四、回撤中最貴的三個動作\"}]}],[\"$\",\"li\",\"sec-5\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-5\",\"children\":\"五、成功不是沒有回撤，是回撤發生時你還在規則裡\"}]}],[\"$\",\"li\",\"sec-6\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-6\",\"children\":\"常見問題 FAQ\"}]}],[\"$\",\"li\",\"sec-7\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-7\",\"children\":\"總結\"}]}],[\"$\",\"li\",\"sec-8\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-8\",\"children\":\"延伸閱讀\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"LearnArticle_body__6B7Mb\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_intro__ATV5c\",\"children\":\"報酬率很好看的策略，常常在最大回撤那一欄寫著你其實做不完的數字。最大回撤量的是：從高點走到最低點，中間你要忍受多少帳面損失。它不告訴你未來一定會再來一次同樣幅度，但它告訴你——若你連歷史上已發生過的都受不了，這套做法對你等於不存在。先問睡不睡得著，再談報酬漂不漂亮。\"}],[[\"$\",\"figure\",\"figure-0\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"虧 3 次每次 −1%賺 2 次每次 +1%勝率 40% 也可能是正期望，前提是賺的比虧的大、且扣得起成本短線先扣約 0.24% 當沖成本，再看還剩多少\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"示意圖｜期望值：勝率要配上平均賺賠，再扣成本（教學結構，不是某檔實盤）\"}]]}]],[\"$\",\"div\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"最大回撤是做不做得完的上限，不是裝飾統計\"}],[\"$\",\"li\",\"1\",{\"children\":\"回測常低估真實回撤，實盤還有成本與執行誤差\"}],[\"$\",\"li\",\"2\",{\"children\":\"用你能忍受的回撤回推部位，不要用想要的報酬反推\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、它在量什麼，不在量什麼\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"最大回撤看的是權益曲線從一個高峰到後來谷底的最大跌幅。它不是單筆虧損，也不是年化報酬的反面。一套方法可以平均看起來不錯，卻在某一段坐了很深的電梯。你若只看平均，會低估中途下車的機率。對交易者，這個數字的意義是：過程有多醜。過程太醜，結果再好也輪不到你。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"量的是高峰到谷底，不是單筆\"}],[\"$\",\"li\",\"1\",{\"children\":\"平均報酬掩蓋不了中途有多醜\"}],[\"$\",\"li\",\"2\",{\"children\":\"做不完的回撤，等於對你無效\"}]]}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、回測裡的回撤，通常比實盤客氣\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"歷史測試常漏掉滑價、心理、以及你不會真的照做的那些日子。參數若經過反覆調整，回撤還會被「剛好避掉」最醜的那段。所以看到回測最大回撤只有一點點，不要太感動。比較誠實的用法是：把這個數字當成下限，再問自己能不能接受更大一點。能接受，部位才有資格討論放大；不能，先縮小，或換一套比較醜得過的方法。\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"你看到的數字\"}],[\"$\",\"th\",\"1\",{\"children\":\"它可能漏了什麼\"}],[\"$\",\"th\",\"2\",{\"children\":\"比較穩的讀法\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"回測回撤很小\"}],[\"$\",\"td\",\"1\",{\"children\":\"參數剛好避掉醜段\"}],[\"$\",\"td\",\"2\",{\"children\":\"當成樂觀下限\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"實盤回撤比回測深\"}],[\"$\",\"td\",\"1\",{\"children\":\"成本與執行誤差\"}],[\"$\",\"td\",\"2\",{\"children\":\"用實盤更新上限\"}]]}],[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"單筆不大但回撤很深\"}],[\"$\",\"td\",\"1\",{\"children\":\"連虧或相關部位重疊\"}],[\"$\",\"td\",\"2\",{\"children\":\"檢查頻率與重疊\"}]]}],[\"$\",\"tr\",\"3\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"回撤恢復很快\"}],[\"$\",\"td\",\"1\",{\"children\":\"樣本可能太短\"}],[\"$\",\"td\",\"2\",{\"children\":\"先問恢復是不是湊巧\"}]]}]]}]]}]}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、用回撤回推部位，是它最實用的用法\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"假設歷史最大回撤是百分之二十，你知道自己百分之十就睡不著，那不是去找更神的參數，是把部位至少砍半，或承認這套不適合你。公式不必很複雜：能忍受的回撤，除以方法看起來會走出的回撤，得到你能用的規模倍數。超過這個倍數，報酬率再吸引人，執行時也會變形。變形之後的成績，不能再算給原策略。\"}],\"$L18\",\"$L19\"]]}],\"$L1a\",\"$L1b\",\"$L1c\",\"$L1d\",\"$L1e\"],\"$L1f\"]}]]}]}]\n18:[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"先寫自己能忍受的回撤\"}],[\"$\",\"li\",\"1\",{\"children\":\"再看方法歷史與合理緩衝\"}],[\"$\",\"li\",\"2\",{\"children\":\"相除得到規模，超過就不做那麼大\"}]]}]\n19:[\"$\",\"figure\",\"2\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"!加大翻本!改參數美化!新開一堆方法\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"回撤期三個貴動作\"}]]}]\n1a:[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、回撤中最貴的三個動作\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"加大部位想趕快回來、改參數讓曲線變漂亮、以及同時開很多套新方法。三個動作都在同一件事上作弊：不願意付已經答應要付的過程成本。回撤期能做的正當事很少：減碼、停用條件若觸發就停、把執行紀錄寫清楚。看起來很被動，卻是少數不會把回撤做成爆掉的路。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"不在回撤期加大\"}],[\"$\",\"li\",\"1\",{\"children\":\"不在回撤期改參數騙自己\"}],[\"$\",\"li\",\"2\",{\"children\":\"不在回撤期新開一堆方法\"}]]}]]]}]\n1b:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、成功不是沒有回撤，是回撤發生時你還在規則裡\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"沒有回撤的曲線，要麼樣本太短，要麼風險被藏在沒爆過的地方。比較健康的目標是：回撤來的時候，你還按事前寫的做，並且生活不被帳戶綁架。這才叫策略被你擁有。否則你擁有的只是一段還沒經歷過冬天的夏天。\"}]]]}]\n1c:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"最大回撤和單筆停損有什麼不同？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"單筆停損管一筆，最大回撤管一連串之後的權益掉多深。兩者都要，不能互相替代。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"回撤恢復時間要看嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"要。同樣深度，恢復很快和趴很久，對睡眠的意義不同。深度與時間最好一起看。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"夏普比率比較高是不是就比較好？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"夏普看的是平均報酬相對波動，不一定告訴你最醜的那段有多醜。回撤與夏普要一起看，不要只挑好看的那一個。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"可不可以用很小部位避開回撤？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"小部位降低痛苦，不消除策略結構。它適合拿來驗證你做不做得完，不適合拿來假裝回撤不存在。\"}]]}]]}]]]}]\n1d:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"最大回撤量的是過程有多醜，以及你做不做得完。回測通常偏樂觀，要用能忍受的回撤回推部位。回撤期不加大、不改參數騙人，成功是還留在規則裡。\"}]]]}]\n1e:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L17\",\"0-策略失效三件事\",{\"href\":\"/learn/how-to-tell-if-a-strategy-is-broken\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"策略失效三件事\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L17\",\"0-部位大小\",{\"href\":\"/learn/how-to-size-your-position\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"部位大小\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L17\",\"0-從虧光到重建\",{\"href\":\"/learn/from-blowing-up-to-rebuilding-a-trading-account\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"從虧光到重建\"}]]}]]}]]]}]\n1f:[\"$\",\"div\",null,{\"className\":\"LearnArticle_related__9qV55\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_relatedTitle__RXfrl\",\"children\":\"相關文章\"}],[[\"$\",\"$L17\",\"how-to-tell-if-a-strategy-is-broken\",{\"href\":\"/learn/how-to-tell-if-a-strategy-is-broken\",\"className\":\"LearnArticle_relatedLink__mibXe\",\"children\":\"策略失效三件事\"}],[\"$\",\"$L17\",\"how-to-size-your-position\",{\"href\":\"/learn/how-to-size-your-position\",\"className\":\"LearnArticle_relatedLink__mibXe\",\"children\":\"部位大小\"}],[\"$\",\"$L17\",\"from-blowing-up-to-rebuilding-a-trading-account\",{\"href\":\"/learn/from-blowing-up-to-rebuilding-a-trading-account\",\"className\":\"LearnArticle_relatedLink__mibXe\",\"children\":\"從虧光到重建\"}]]]}]\n13:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\nf:null\n20:I[80622,[],\"IconMark\"]\n11:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"最大回撤怎麼看？先問你睡不睡得著，再談報酬｜股市大佬 TradeBoss\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"報酬率很好看的策略，常常在最大回撤那一欄寫著你其實做不完的數字。最大回撤量的是：從高點走到最低點，中間你要忍受多少帳面損失。它不告訴你未來一定會再來一次同樣幅度，但它告訴你——若你連歷史上已發生過的都受不了，這套做法對你等於不存在。先問睡不睡得著，再談報酬漂不漂亮。\"}],[\"$\",\"link\",\"2\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}],[\"$\",\"$L20\",\"3\",{}]],\"error\":null,\"digest\":\"$undefined\"}\n16:\"$11:metadata\"\n"}