en\":[\"$\",\"a\",null,{\"href\":\"#sec-5\",\"children\":\"五、第二個問題最關鍵\"}]}],[\"$\",\"li\",\"sec-6\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-6\",\"children\":\"六、比較安全的替代做法\"}]}],[\"$\",\"li\",\"sec-7\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-7\",\"children\":\"七、槓桿會把問題放大\"}]}],[\"$\",\"li\",\"sec-8\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-8\",\"children\":\"常見問題 FAQ\"}]}],[\"$\",\"li\",\"sec-9\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-9\",\"children\":\"總結\"}]}],[\"$\",\"li\",\"sec-10\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-10\",\"children\":\"延伸閱讀\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"LearnArticle_body__6B7Mb\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_intro__ATV5c\",\"children\":\"價格跌了，再買一些把平均成本拉低——聽起來像理性的算術。問題是這個算術只計算了成本，沒有計算風險。同樣的動作在兩種情況下意義完全相反，而多數人做的是比較危險的那一種。\"}],[],[\"$\",\"div\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"攤平降低平均成本，卻同時放大部位、壓縮可承受跌幅、加重心理承諾\"}],[\"$\",\"li\",\"1\",{\"children\":\"它和計畫性分批的差別在決定時間點\"}],[\"$\",\"li\",\"2\",{\"children\":\"加碼前先問：如果現在沒有部位，我今天會買嗎\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、攤平和計畫性分批不是同一件事\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"計畫性分批是在進場前就決定「分幾次買、在什麼條件下買下一批、總部位上限多少」。攤平則是進場後因為虧損才決定再買。差別不在動作，而在決定的時間點：一個是計畫，一個是反應。反應性的加碼幾乎都沒有總量上限，這是最危險的部分。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"計畫性分批：事前決定次數、條件與總量上限\"}],[\"$\",\"li\",\"1\",{\"children\":\"攤平：事後因為虧損而決定\"}],[\"$\",\"li\",\"2\",{\"children\":\"差別在決定的時間點，不在動作本身\"}]]}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、平均成本下降，但風險上升\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"攤平確實會讓平均成本下降，這是算術事實。但它同時做了另外三件事：部位變大、單次可承受的價格變動變小、以及你對這個判斷的心理承諾變重。三件事加起來的結果是——如果原本的判斷是錯的，你現在錯得更多。降低成本和降低風險是兩件不同的事，攤平只做到前者。\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"攤平之後\"}],[\"$\",\"th\",\"1\",{\"children\":\"變化\"}],[\"$\",\"th\",\"2\",{\"children\":\"實際含意\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"平均成本\"}],[\"$\",\"td\",\"1\",{\"children\":\"下降\"}],[\"$\",\"td\",\"2\",{\"children\":\"帳面看起來比較舒服\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"總部位\"}],[\"$\",\"td\",\"1\",{\"children\":\"上升\"}],[\"$\",\"td\",\"2\",{\"children\":\"同樣跌幅的金額損失變大\"}]]}],[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"可承受跌幅\"}],[\"$\",\"td\",\"1\",{\"children\":\"下降\"}],[\"$\",\"td\",\"2\",{\"children\":\"更容易被迫處理\"}]]}],[\"$\",\"tr\",\"3\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"心理承諾\"}],[\"$\",\"td\",\"1\",{\"children\":\"上升\"}],[\"$\",\"td\",\"2\",{\"children\":\"更難承認判斷錯誤\"}]]}]]}]]}]}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、它為什麼常常「有效」\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"攤平大多數時候確實會成功，因為價格在多數時間是震盪的。這正是它危險的原因：頻繁的成功會建立強烈的信心，直到遇上一次不回頭的走勢。這種「多次小成功、一次大失敗」的結構，跟高勝率負期望值是同一件事——舒服，但長期是負的。\"}],[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"震盪市況下多半會成功\"}],[\"$\",\"li\",\"1\",{\"children\":\"頻繁成功建立過度信心\"}],[\"$\",\"li\",\"2\",{\"children\":\"一次不回頭的走勢就抵掉所有小成功\"}]]}]]]}],[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[\"$L18\",[\"$L19\",\"$L1a\",\"$L1b\"]]}],\"$L1c\",\"$L1d\",\"$L1e\",\"$L1f\",\"$L20\",\"$L21\"],null]}]]}]}]\n18:[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、三個問題判斷自己在做什麼\"}]\n19:[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"在按下加碼之前，問自己三個問題。這三個問題的設計是為了區分「這是計畫的一部分」和「這是不想認錯」，而且必須誠實回答，因為當下最容易做的就是自我合理化。\"}]\n1a:[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"這次加碼在我進場前就規劃好了嗎\"}],[\"$\",\"li\",\"1\",{\"children\":\"如果我現在手上沒有部位，我今天會用這個價格買嗎\"}],[\"$\",\"li\",\"2\",{\"children\":\"加完之後的總部位，還在我事前設定的上限內嗎\"}]]}]\n1b:[\"$\",\"figure\",\"2\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"1事前規劃過嗎2現在沒部位會買嗎3還在上限內嗎\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"加碼前的三個問題\"}]]}]\n1c:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、第二個問題最關鍵\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"「如果現在手上沒有部位，我今天會買嗎」這個問題會直接暴露沉沒成本的影響。如果答案是不會，那唯一支撐你加碼的理由就是已經虧損的那部分，而已經發生的虧損跟這檔股票的未來完全無關。這是行為財務學裡最基本也最常被忽略的一條。\"}]]]}]\n1d:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"六、比較安全的替代做法\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"如果你的方法確實需要在下跌時建立部位，把它變成事前規則：總部位上限、每批的間距、以及最重要的——整體失效條件。有整體失效條件的分批和沒有的攤平，長期結果差異極大，因為前者的最壞情況是有界的。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"事前寫下總部位上限\"}],[\"$\",\"li\",\"1\",{\"children\":\"事前寫下每批的間距與條件\"}],[\"$\",\"li\",\"2\",{\"children\":\"設定整體失效條件，讓最壞情況有界\"}],[\"$\",\"li\",\"3\",{\"children\":\"首批就用小於單筆上限的規模\"}]]}]]]}]\n1e:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"七、槓桿會把問題放大\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"使用信用交易時攤平的風險完全不同，因為除了價格風險還有維持率的問題。部位變大會同時降低你的緩衝空間，可能在判斷還沒被驗證之前就被迫處理。用槓桿攤平，本質上是在賭時間，而時間不是你能控制的變數。\"}]]]}]\n1f:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"攤平一定不好嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"不是動作本身的問題，是決定時間點的問題。事前規劃好次數、條件與總量上限的分批，最壞情況有界；因為虧損才決定加碼的攤平通常沒有上限，這才是危險的部分。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"為什麼我攤平大多都成功？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"因為價格在多數時間是震盪的。這正是它危險的地方——頻繁的成功會建立過度信心，結構上等於高勝率但負期望值，一次不回頭的走勢就會抵掉所有小成功。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"怎麼判斷自己是加碼還是不想認錯？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"問一個問題：如果現在手上沒有部位，我今天會用這個價格買嗎？答案是不會的話，支撐你加碼的就只是已經發生的虧損，而那跟未來走勢無關。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"用融資可以攤平嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"風險性質完全不同。除了價格風險還有維持率問題，部位變大會壓縮緩衝空間，可能在判斷被驗證之前就被迫處理。等於在賭時間，而時間不由你控制。\"}]]}]]}]]]}]\n20:[\"$\",\"section\",\"sec-9\",{\"id\":\"sec-9\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"攤平降低平均成本，卻同時放大部位、壓縮可承受跌幅、加重心理承諾。它和計畫性分批的差別在決定時間點。加碼前先問：如果現在沒有部位，我今天會買嗎。\"}]]]}]\n21:[\"$\",\"section\",\"sec-10\",{\"id\":\"sec-10\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L17\",\"0-交易觀念與名詞：\",{\"href\":\"/school\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"交易觀念與名詞：台股學堂\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L17\",\"0-更多台股教學文\",{\"href\":\"/learn\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"更多台股教學文\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L17\",\"0-本站的立場與免責\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"本站的立場與免責說明\"}]]}]]}]]]}]\n13:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\nf:null\n22:I[80622,[],\"IconMark\"]\n11:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"攤平為什麼危險？它讓錯誤變大而不是變小｜股市大佬 TradeBoss\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"價格跌了，再買一些把平均成本拉低——聽起來像理性的算術。問題是這個算術只計算了成本，沒有計算風險。同樣的動作在兩種情況下意義完全相反，而多數人做的是比較危險的那一種。\"}],[\"$\",\"link\",\"2\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}],[\"$\",\"$L22\",\"3\",{}]],\"error\":null,\"digest\":\"$undefined\"}\n16:\"$11:metadata\"\n"}