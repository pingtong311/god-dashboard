l,{\"hidden\":true,\"children\":[\"$\",\"$15\",null,{\"fallback\":null,\"children\":\"$L16\"}]}]}]]}]\n17:I[52619,[\"2619\",\"static/chunks/2619-04bc32f026a0d946.js\",\"6309\",\"static/chunks/app/learn/%5Bslug%5D/page-f7b99344f7e2ee16.js\"],\"\"]\nd:[\"$\",\"div\",null,{\"className\":\"LearnArticle_wrap__LIQ8G\",\"children\":[\"$\",\"article\",null,{\"className\":\"LearnArticle_article__2nBbk\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_meta__etj_G\",\"children\":[[\"$\",\"$L17\",null,{\"className\":\"LearnArticle_cat__GQMlg\",\"href\":\"/learn?c=themes\",\"children\":\"題材專欄\"}],[\"$\",\"span\",null,{\"className\":\"LearnArticle_read__QEj6a\",\"children\":\"閱讀約 5 分鐘\"}]]}],[\"$\",\"h1\",null,{\"className\":\"LearnArticle_title__0_la8\",\"children\":\"題材重演為什麼常失敗？3個教訓先記\"}],[\"$\",\"details\",null,{\"className\":\"LearnArticle_toc__LcSAa\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"LearnArticle_tocSummary__YBddG\",\"children\":\"本文目錄\"}],[\"$\",\"ol\",null,{\"className\":\"LearnArticle_tocList__Rq_Lz\",\"children\":[[\"$\",\"li\",\"sec-1\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-1\",\"children\":\"一、回收的是名字，不是整齣戲\"}]}],[\"$\",\"li\",\"sec-2\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-2\",\"children\":\"二、三個常讓重演走樣的地方\"}]}],[\"$\",\"li\",\"sec-3\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-3\",\"children\":\"三、以為上次的飆股劇本會重來，多半是誤解\"}]}],[\"$\",\"li\",\"sec-4\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-4\",\"children\":\"四、後見之明會把上次修成必勝講義\"}]}],[\"$\",\"li\",\"sec-5\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-5\",\"children\":\"五、重演能留下的最小用法\"}]}],[\"$\",\"li\",\"sec-6\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-6\",\"children\":\"常見問題 FAQ\"}]}],[\"$\",\"li\",\"sec-7\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-7\",\"children\":\"總結\"}]}],[\"$\",\"li\",\"sec-8\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-8\",\"children\":\"延伸閱讀\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"LearnArticle_body__6B7Mb\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_intro__ATV5c\",\"children\":\"市場很會回收名詞。去年好用的那句話，今年換一則新聞又能再講一次。熟悉感很舒服，也最容易讓人把上次的走法直接套上來。重演常失敗，不是因為名詞變假，而是因為人換了、量換了、大家都記得上次所以價格已經先把期待算進去。這篇只記三個教訓，不幫你判斷這次該不該信。\"}],[[\"$\",\"figure\",\"figure-0\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"越後面越熱鬧，通常也越貴、越好離開佈局沒新聞命名故事出現擁擠人人都知退燒利多變鈍新聞出現時，常常已經不是第一段\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"示意圖｜題材四階段：佈局 → 命名 → 擁擠 → 退燒（教學結構，不是某檔實盤）\"}]]}]],[\"$\",\"div\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"名詞相同，不代表參與者與流動性相同\"}],[\"$\",\"li\",\"1\",{\"children\":\"上次的結果會被寫進這次的價格期待\"}],[\"$\",\"li\",\"2\",{\"children\":\"熟悉感要當警示，不當證明\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、回收的是名字，不是整齣戲\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"題材名詞像衣服，可以反覆穿。穿的人、場合、天氣都不同。你若只對名字眼熟，就以為走勢也會眼熟，等於用舊地圖走新路。比較老實的讀法是：這次公開資訊是什麼、誰在交易、量夠不夠讓同樣的句子再走一遍。名字只能當索引，不能當劇本。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"先當索引，不當劇本\"}],[\"$\",\"li\",\"1\",{\"children\":\"問這次誰在、量在哪\"}],[\"$\",\"li\",\"2\",{\"children\":\"眼熟不能當證據\"}]]}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、三個常讓重演走樣的地方\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"第一，參與者不同。上次進來的人，這次可能還記得痛，反應會比較快，也可能根本不在了。第二，流動性位置不同。同樣的句子，在薄的市場與厚的市場走出來的速度差很多。第三，期待已經被寫進價格。大家都記得上次，開場就可能把高潮先走完。三個只要有一個變了，重演就會長得不像記憶。\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"你以為沒變\"}],[\"$\",\"th\",\"1\",{\"children\":\"實際常變\"}],[\"$\",\"th\",\"2\",{\"children\":\"教訓\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"還是同一句話\"}],[\"$\",\"td\",\"1\",{\"children\":\"聽的人與部位不同\"}],[\"$\",\"td\",\"2\",{\"children\":\"先問誰在交易\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"上次怎麼走這次也會\"}],[\"$\",\"td\",\"1\",{\"children\":\"流動性位置不同\"}],[\"$\",\"td\",\"2\",{\"children\":\"先問現在好不好離開\"}]]}],[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"既然眼熟就比較早\"}],[\"$\",\"td\",\"1\",{\"children\":\"期待可能已被算進價格\"}],[\"$\",\"td\",\"2\",{\"children\":\"熟悉感當警示\"}]]}],[\"$\",\"tr\",\"3\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"失敗只是時機不對\"}],[\"$\",\"td\",\"1\",{\"children\":\"結構已經不同\"}],[\"$\",\"td\",\"2\",{\"children\":\"不要用時機兩個字跳過檢查\"}]]}]]}]]}]}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、以為上次的飆股劇本會重來，多半是誤解\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"把上次的飆股故事當成續集預告，是常見誤解。上次能走成那樣，通常疊了當時才有的擁擠、流動性與意外。續集保留名詞，很少保留整組條件。你把續集當成同一部電影，會在開場就用上一集的膽子。膽子來自記憶，不是來自這次的檢查。\"}],\"$L18\",\"$L19\"]]}],\"$L1a\",\"$L1b\",\"$L1c\",\"$L1d\",\"$L1e\"],\"$L1f\"]}]]}]}]\n18:[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"先列出上次真正疊上的條件\"}],[\"$\",\"li\",\"1\",{\"children\":\"再問這次哪幾條還在\"}],[\"$\",\"li\",\"2\",{\"children\":\"少一條，就把期待收一格，不要用名詞補齊\"}]]}]\n19:[\"$\",\"figure\",\"2\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"!名字當劇本!講義當先見!時機兩個字跳過檢查\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"三種續集腦\"}]]}]\n1a:[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、後見之明會把上次修成必勝講義\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"走完的題材，教材會變得很順：當時很明顯、當時該怎樣。順的故事刪掉了當時拿不到的資訊，也刪掉了失敗的分支。你拿這份講義去等重演，會覺得自己比較聰明，其實只是拿著已經改過的答案再考一次。讀上次，要先問當時公開的是什麼，後來補上的不能當自己的先見。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"先分當時拿得到與後來才補的\"}],[\"$\",\"li\",\"1\",{\"children\":\"只把前者當練習題\"}],[\"$\",\"li\",\"2\",{\"children\":\"講義愈順，愈要懷疑被修過\"}]]}]]]}]\n1b:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、重演能留下的最小用法\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"名詞再出現時，寫三行：這次新的事實是什麼、誰看起來在交易、我怎樣算這次不像上次。三行都有，你才是在比較結構，不是在追續集。三行都沒有，熟悉感會替你做決定。結構比較能教你，續集比較能帶你走。\"}]]]}]\n1c:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"名詞再出現，是不是比較容易成功？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"熟悉只說明好講。成功還要看這次的人、量與期待，不能用名詞折抵檢查。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"完全當新題材看，會不會太小心？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"當新的至少逼你重寫理由與失效。太熟才要小心，因為膽子會偷偷借上次的。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"產業長期趨勢對，重演是不是就比較真？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"趨勢可以對，價格仍可能先走完一輪敘述。長期看法與這筆失效要分開寫。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"怎樣才算這次不像上次？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"參與者、流動性、開場期待有一項對不上，就要把不像寫下來，不要等走完再承認。\"}]]}]]}]]]}]\n1d:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"題材重演常失敗，因為人、量與價格裡的期待都變了。名詞當索引，不當劇本。熟悉感當警示，不當證明。\"}]]]}]\n1e:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L17\",\"0-後見之明偏差\",{\"href\":\"/learn/hindsight-bias-in-trading\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"後見之明偏差\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L17\",\"0-題材股生命週期\",{\"href\":\"/learn/theme-stock-lifecycle\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"題材股生命週期\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L17\",\"0-從眾行為\",{\"href\":\"/learn/herding-in-markets\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"從眾行為\"}]]}]]}]]]}]\n1f:[\"$\",\"div\",null,{\"className\":\"LearnArticle_related__9qV55\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_relatedTitle__RXfrl\",\"children\":\"相關文章\"}],[[\"$\",\"$L17\",\"hindsight-bias-in-trading\",{\"href\":\"/learn/hindsight-bias-in-trading\",\"className\":\"LearnArticle_relatedLink__mibXe\",\"children\":\"後見之明偏差\"}],[\"$\",\"$L17\",\"theme-stock-lifecycle\",{\"href\":\"/learn/theme-stock-lifecycle\",\"className\":\"LearnArticle_relatedLink__mibXe\",\"children\":\"題材股生命週期\"}],[\"$\",\"$L17\",\"herding-in-markets\",{\"href\":\"/learn/herding-in-markets\",\"className\":\"LearnArticle_relatedLink__mibXe\",\"children\":\"從眾行為\"}]]]}]\n13:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\nf:null\n20:I[80622,[],\"IconMark\"]\n11:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"題材重演為什麼常失敗？3個教訓先記｜股市大佬 TradeBoss\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"市場很會回收名詞。去年好用的那句話，今年換一則新聞又能再講一次。熟悉感很舒服，也最容易讓人把上次的走法直接套上來。重演常失敗，不是因為名詞變假，而是因為人換了、量換了、大家都記得上次所以價格已經先把期待算進去。這篇只記三個教訓，不幫你判斷這次該不該信。\"}],[\"$\",\"link\",\"2\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}],[\"$\",\"$L20\",\"3\",{}]],\"error\":null,\"digest\":\"$undefined\"}\n16:\"$11:metadata\"\n"}