,\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"$undefined\"}]],[\"$\",\"$Le\",null,{\"children\":[\"$Lf\",[\"$\",\"$L10\",null,{\"promise\":\"$@11\"}]]}]]}]\nb:[\"$\",\"$1\",\"h\",{\"children\":[null,[[\"$\",\"$L12\",null,{\"children\":\"$L13\"}],[\"$\",\"meta\",null,{\"name\":\"next-size-adjust\",\"content\":\"\"}]],[\"$\",\"$L14\",null,{\"children\":[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$15\",null,{\"fallback\":null,\"children\":\"$L16\"}]}]}]]}]\n17:I[52619,[\"2619\",\"static/chunks/2619-04bc32f026a0d946.js\",\"6309\",\"static/chunks/app/learn/%5Bslug%5D/page-f7b99344f7e2ee16.js\"],\"\"]\nd:[\"$\",\"div\",null,{\"className\":\"LearnArticle_wrap__LIQ8G\",\"children\":[\"$\",\"article\",null,{\"className\":\"LearnArticle_article__2nBbk\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_meta__etj_G\",\"children\":[[\"$\",\"$L17\",null,{\"className\":\"LearnArticle_cat__GQMlg\",\"href\":\"/learn?c=rules\",\"children\":\"制度與工具\"}],[\"$\",\"span\",null,{\"className\":\"LearnArticle_read__QEj6a\",\"children\":\"閱讀約 7 分鐘\"}]]}],[\"$\",\"h1\",null,{\"className\":\"LearnArticle_title__0_la8\",\"children\":\"本益比怎麼算才合理？3步驟看懂股票貴不貴，避開估值陷阱\"}],[\"$\",\"details\",null,{\"className\":\"LearnArticle_toc__LcSAa\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"LearnArticle_tocSummary__YBddG\",\"children\":\"本文目錄\"}],[\"$\",\"ol\",null,{\"className\":\"LearnArticle_tocList__Rq_Lz\",\"children\":[[\"$\",\"li\",\"sec-1\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-1\",\"children\":\"一、本益比是什麼？為什麼不能只看數字高低？\"}]}],[\"$\",\"li\",\"sec-2\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-2\",\"children\":\"二、第一步：如何計算「現在的」本益比？\"}]}],[\"$\",\"li\",\"sec-3\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-3\",\"children\":\"三、第二步：怎麼判斷本益比是貴還是便宜？\"}]}],[\"$\",\"li\",\"sec-4\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-4\",\"children\":\"四、第三步：哪些股票不適合用本益比評估？\"}]}],[\"$\",\"li\",\"sec-5\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-5\",\"children\":\"五、實戰演練：一個簡單的合理本益比評估流程\"}]}],[\"$\",\"li\",\"sec-6\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-6\",\"children\":\"常見問題 FAQ\"}]}],[\"$\",\"li\",\"sec-7\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-7\",\"children\":\"總結\"}]}],[\"$\",\"li\",\"sec-8\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-8\",\"children\":\"延伸閱讀\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"LearnArticle_body__6B7Mb\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_intro__ATV5c\",\"children\":\"打開報價軟體，看到 A 股票本益比 15 倍，B 股票 30 倍，是不是覺得 15 倍的比較便宜？這其實是常見的誤解。這篇文章會帶你學會如何判斷「合理的」本益比，而不是只會比大小，讓你對股價的貴俗更有概念。\"}],[[\"$\",\"figure\",\"figure-0\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"沒扣成本的勝率，看起來都會比較漂亮0.029%手續費 1 折來回0.15%當沖證交稅0.06%滑價估計三項合計約 0.24%；留倉稅率更高，約 0.39%\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"示意圖｜當沖來回成本：1 折手續費 + 證交稅 + 滑價（教學結構，不是某檔實盤）\"}]]}]],[\"$\",\"div\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"本益比公式是「股價 ÷ 每股盈餘(EPS)」，代表投資多久能回本。\"}],[\"$\",\"li\",\"1\",{\"children\":\"合理本益比沒有絕對數字，要跟「自己過去」和「同業平均」比較。\"}],[\"$\",\"li\",\"2\",{\"children\":\"成長型公司本益比通常較高，景氣循環股則要小心高點的低本益比陷阱。\"}],[\"$\",\"li\",\"3\",{\"children\":\"虧損或獲利不穩的公司，本益比會失真，不適合單獨用來評估。\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、本益比是什麼？為什麼不能只看數字高低？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"本益比（Price-to-Earnings Ratio, P/E Ratio）的公式是「股價 ÷ 每股盈餘(EPS)」，意思是「這筆投資要花幾年才能回本」。假設你開一家雞排店花了 100 萬，每年淨賺 10 萬，這樣 10 年回本，本益比就是 10 倍。所以，本益比是衡量股票貴不貴的常用指標，但它不是一個絕對的數字。不同產業、不同成長階段的公司，市場願意給的「回本年限」也完全不同。\"}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、第一步：如何計算「現在的」本益比？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"計算本益比需要股價和每股盈餘（EPS）。股價很簡單，就是現在的市價。但 EPS 有兩種算法：一種是「歷史本益比」，用的是過去四季已公布的 EPS 總和，數字客觀但反映的是過去；另一種是「預估本益比」，用的是分析師預估的未來一年 EPS，有前瞻性但可能不準。對一般投資人來說，先學會看歷史本益比最實在。例如，股價 120 元，過去四季 EPS 加總是 8 元，那本益比就是 120 ÷ 8 = 15 倍。\"}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、第二步：怎麼判斷本益比是貴還是便宜？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"判斷本益比是否合理，關鍵在於「比較」。單獨一個數字沒有意義，你必須有比較的基準點。最實用的比較方式有兩種：跟自己過去比，以及跟同產業的對手比。這樣才能知道，現在的股價相對於公司自身的歷史表現、以及在同業中的地位，是昂貴還是便宜。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"跟自己比：查看這檔股票過去 3-5 年的「本益比區間」，如果現在的數字接近歷史高點，可能就偏貴了。\"}],[\"$\",\"li\",\"1\",{\"children\":\"跟同業比：找出業務相似的公司，看看它們的本益比平均落在哪個水準，避免拿半導體股跟食品股比較。\"}]]}],[\"$\",\"div\",\"2\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"產業類別\"}],[\"$\",\"th\",\"1\",{\"children\":\"本益比參考區間\"}],\"$L18\"]}]}],\"$L19\"]}]}],\"$L1a\"]]}],\"$L1b\",\"$L1c\",\"$L1d\",\"$L1e\",\"$L1f\"],null]}]]}]}]\n18:[\"$\",\"th\",\"2\",{\"children\":\"特性\"}]\n19:[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"電信業\"}],[\"$\",\"td\",\"1\",{\"children\":\"10 - 15 倍\"}],[\"$\",\"td\",\"2\",{\"children\":\"獲利穩定，成長性低\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"金融業\"}],[\"$\",\"td\",\"1\",{\"children\":\"8 - 15 倍\"}],[\"$\",\"td\",\"2\",{\"children\":\"受利率政策與景氣影響大\"}]]}],[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"半導體設計\"}],[\"$\",\"td\",\"1\",{\"children\":\"20 - 40+ 倍\"}],[\"$\",\"td\",\"2\",{\"children\":\"高成長，高研發，市場期待高\"}]]}],[\"$\",\"tr\",\"3\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"傳統製造業\"}],[\"$\",\"td\",\"1\",{\"children\":\"10 - 20 倍\"}],[\"$\",\"td\",\"2\",{\"children\":\"獲利相對穩定，受景氣循環影響\"}]]}]]}]\n1a:[\"$\",\"figure\",\"3\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"!公司正在虧損!獲利暴起暴落!景氣循環高峰!一次性獲利入帳\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"小心！這些情況本益比會失真\"}]]}]\n1b:[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、第三步：哪些股票不適合用本益比評估？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"本益比雖然好用，但不是萬靈丹。遇到某些類型的公司，這個指標會完全失真，如果硬要拿來評估，很容易做出錯誤的判斷。了解它的限制，你才能在對的時機使用對的工具，避開估值陷阱。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"虧損中的公司：EPS 是負的，本益比沒有意義，通常會顯示為 N/A。\"}],[\"$\",\"li\",\"1\",{\"children\":\"獲利暴起暴落的公司：單季獲利大增或大減，會讓本益比瞬間變很低或很高，失去參考價值。\"}],[\"$\",\"li\",\"2\",{\"children\":\"景氣循環股：在景氣最高峰時，獲利最好，本益比看起來最低，但這往往是反轉的訊號。\"}],[\"$\",\"li\",\"3\",{\"children\":\"營建股或資產股：獲利來源是一次性建案入帳或資產變賣，用本益比評估容易失準。\"}]]}]]]}]\n1c:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、實戰演練：一個簡單的合理本益比評估流程\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"了解原理後，我們可以整理出一個實際可行的評估流程。這個流程能幫助你系統性地思考，而不是只憑感覺。在股市大佬的「個股透視」頁面，我們也提供了歷史本益比河流圖，讓你一眼看出現在的股價位階，省去自己動手算的麻煩。\"}],[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"確認公司近 4 季 EPS 是正數且相對穩定。\"}],[\"$\",\"li\",\"1\",{\"children\":\"計算目前本益比（股價 ÷ 近四季 EPS）。\"}],[\"$\",\"li\",\"2\",{\"children\":\"找出同業的平均本益比，以及這家公司過去三年的本益比區間。\"}],[\"$\",\"li\",\"3\",{\"children\":\"綜合比較，判斷目前股價是落在昂貴、合理還是便宜的區間。\"}]]}]]]}]\n1d:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"本益比越低就代表越值得買嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"不一定。低本益比可能代表公司成長停滯，或市場不看好它的未來。景氣循環股在景氣高點時，也常常出現低本益比的陷阱，需要特別小心。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"為什麼有些高成長股本益比 50 倍以上還一直漲？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"因為市場預期它未來的獲利會高速成長，願意用更高的價格買進。投資人看的是未來的潛力，而不是過去的獲利數字，這也反映了本益比包含「市場情緒」的成分。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"負的本益比是什麼意思？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"當一家公司虧損時（EPS 為負數），算出來的本益比就是負的。這個數字沒有參考意義，通常會直接顯示「N/A」或「-」，評估這類公司需要改用股價淨值比 (PBR) 等其他指標。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"我應該用「預估本益比」還是「歷史本益比」？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"預估本益比（Forward P/E）更具前瞻性，但準確度仰賴分析師的預測能力。歷史本益比（Trailing P/E）則是根據已發生的事實計算，比較客觀。新手建議先從歷史本益比看起，建立基本概念。\"}]]}]]}]]]}]\n1e:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"評估本益比的關鍵，不在於追求一個完美的數字，而是建立一個「比較」的基準。透過跟公司自己的過去比、跟同業的現在比，你就能為股價找到一個相對合理的錨點，幫助你避開買在瘋狂高點的風險。\"}]]]}]\n1f:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L17\",\"0-用本益比河流圖，\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"用本益比河流圖，一眼看出股價位階\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L17\",\"0-查詢不同產業的估\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"查詢不同產業的估值水平\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L17\",\"0-更多估值方法，請\",{\"href\":\"/school\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"更多估值方法，請看台股學堂\"}]]}]]}]]]}]\n13:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\nf:null\n20:I[80622,[],\"IconMark\"]\n11:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"本益比怎麼算才合理？3步驟看懂股票貴不貴，避開估值陷阱｜股市大佬 TradeBoss\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"打開報價軟體，看到 A 股票本益比 15 倍，B 股票 30 倍，是不是覺得 15 倍的比較便宜？這其實是常見的誤解。這篇文章會帶你學會如何判斷「合理的」本益比，而不是只會比大小，讓你對股價的貴俗更有概念。\"}],[\"$\",\"link\",\"2\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}],[\"$\",\"$L20\",\"3\",{}]],\"error\":null,\"digest\":\"$undefined\"}\n16:\"$11:metadata\"\n"}