pp/learn/%5Bslug%5D/page-f7b99344f7e2ee16.js\"],\"\"]\nd:[\"$\",\"div\",null,{\"className\":\"LearnArticle_wrap__LIQ8G\",\"children\":[\"$\",\"article\",null,{\"className\":\"LearnArticle_article__2nBbk\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_meta__etj_G\",\"children\":[[\"$\",\"$L17\",null,{\"className\":\"LearnArticle_cat__GQMlg\",\"href\":\"/learn?c=events\",\"children\":\"金融大事件\"}],[\"$\",\"span\",null,{\"className\":\"LearnArticle_read__QEj6a\",\"children\":\"閱讀約 7 分鐘\"}]]}],[\"$\",\"h1\",null,{\"className\":\"LearnArticle_title__0_la8\",\"children\":\"區域性銀行危機回顧：為何一家美國銀行倒閉，會影響我的台股持股？3 個避險觀察點\"}],[\"$\",\"details\",null,{\"className\":\"LearnArticle_toc__LcSAa\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"LearnArticle_tocSummary__YBddG\",\"children\":\"本文目錄\"}],[\"$\",\"ol\",null,{\"className\":\"LearnArticle_tocList__Rq_Lz\",\"children\":[[\"$\",\"li\",\"sec-1\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-1\",\"children\":\"一、「美國銀行倒了，干我何事？」3 個連鎖反應，看懂全球風險如何影響台股\"}]}],[\"$\",\"li\",\"sec-2\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-2\",\"children\":\"二、危機的火種是什麼？不只是升息這麼簡單\"}]}],[\"$\",\"li\",\"sec-3\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-3\",\"children\":\"三、如何判斷我的金融股安不安全？3 個財務指標檢查銀行體質\"}]}],[\"$\",\"li\",\"sec-4\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-4\",\"children\":\"四、台灣的銀行也一樣危險嗎？從監管制度看兩地差異\"}]}],[\"$\",\"li\",\"sec-5\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-5\",\"children\":\"五、危機也是轉機？金融風暴後，散戶該如何調整投資策略\"}]}],[\"$\",\"li\",\"sec-6\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-6\",\"children\":\"常見問題 FAQ\"}]}],[\"$\",\"li\",\"sec-7\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-7\",\"children\":\"總結\"}]}],[\"$\",\"li\",\"sec-8\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-8\",\"children\":\"延伸閱讀\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"LearnArticle_body__6B7Mb\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_intro__ATV5c\",\"children\":\"看到國外某家銀行倒閉的新聞，是不是覺得離自己很遠，但又隱約擔心手上的金融股？為什麼美國一家地方銀行出事，會讓全球股市跟著緊張？這篇文章就是要帶你回顧歷史，看懂危機背後的連鎖反應，並學會幾個簡單的觀察點，保護自己的資產。\"}],[],[\"$\",\"div\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"危機主因常是「利率急升」與「資產過度集中」，導致銀行資產價值縮水。\"}],[\"$\",\"li\",\"1\",{\"children\":\"觀察銀行的「未實現損益」與「存款流失速度」，是評估其體質的關鍵。\"}],[\"$\",\"li\",\"2\",{\"children\":\"台灣金融監管相對嚴格，但仍需留意全球系統性風險對台股的間接衝擊。\"}],[\"$\",\"li\",\"3\",{\"children\":\"危機不代表所有金融股都危險，體質好的公司反而是長期觀察的機會點。\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、「美國銀行倒了，干我何事？」3 個連鎖反應，看懂全球風險如何影響台股\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"很多人覺得，國外一家區域性銀行出問題，跟台灣投資人距離很遠。但金融市場是全球連動的，一隻蝴蝶拍動翅膀，就可能引發風暴。當危機發生時，至少會透過三條路徑影響到你的台股部位，即使你一股金融股都沒買，也可能受到衝擊。\"}],[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"信心衝擊：投資人會擔心其他銀行也有類似問題，開始拋售全球的金融股，引發恐慌性賣壓。這種情緒會蔓延，讓整個市場氣氛變差。\"}],[\"$\",\"li\",\"1\",{\"children\":\"流動性緊縮：銀行之間為了自保，會變得不願意互相借錢，導致市場上的資金變少。這會讓企業更難取得貸款，影響經濟活動，進而衝擊股市。\"}],[\"$\",\"li\",\"2\",{\"children\":\"外資撤離：全球風險升高時，外資會優先從新興市場（例如台灣）把錢抽走，轉向美元、美債等相對安全的資產。外資賣超，台股自然會承受壓力。\"}]]}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、危機的火種是什麼？不只是升息這麼簡單\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"多數銀行危機的引爆點，都跟「利率快速變化」有關。想像一下，銀行在利率低的時候，買了很多年利率只有 2% 的長期政府公債。當聯準會為了對抗通膨，在短時間內把利率拉高到 5%，這些 2% 的舊公債在市場上就沒人要了，價值會大跌。這就是所謂的「未實現虧損」。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"這個虧損平常只是帳面數字，但如果存戶因為恐慌，大量提領存款（也就是擠兌），銀行就必須被迫在市場上「認賠賣出」這些不值錢的公債來換取現金。一旦紙上虧損變成實際虧損，就可能侵蝕掉銀行的資本，引發倒閉危機。\"}]]}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、如何判斷我的金融股安不安全？3 個財務指標檢查銀行體質\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"我們無法預測下一次危機會在哪裡發生，但可以學會檢查一家銀行的體質是否穩健，來降低自己的風險。平時可以留意財報中的幾個關鍵數字，它們就像銀行的健康檢查報告，能告訴我們它對抗風險的能力。\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"檢查指標\"}],[\"$\",\"th\",\"1\",{\"children\":\"風險可能較高\"}],[\"$\",\"th\",\"2\",{\"children\":\"體質相對穩健\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"未實現損益\"}],[\"$\",\"td\",\"1\",{\"children\":\"帳上鉅額虧損，且佔淨值比重高\"}],\"$L18\"]}],\"$L19\",\"$L1a\"]}]]}]}],\"$L1b\"]]}],\"$L1c\",\"$L1d\",\"$L1e\",\"$L1f\",\"$L20\"],null]}]]}]}]\n18:[\"$\",\"td\",\"2\",{\"children\":\"虧損佔淨值比重低，或甚至有獲利\"}]\n19:[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"存款結構\"}],[\"$\",\"td\",\"1\",{\"children\":\"存款集中在少數幾家大企業客戶\"}],[\"$\",\"td\",\"2\",{\"children\":\"存款分散在大量的小額個人存戶\"}]]}]\n1a:[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"資本適足率 (BIS)\"}],[\"$\",\"td\",\"1\",{\"children\":\"僅略高於法定最低要求 (如 8-10%)\"}],[\"$\",\"td\",\"2\",{\"children\":\"遠高於法定要求 (如 12% 以上)\"}]]}]\n1b:[\"$\",\"figure\",\"2\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"✓未實現損益佔比✓存款結構是否分散✓資本適足率是否夠高\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"檢查金融股體質 3 指標\"}]]}]\n1c:[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、台灣的銀行也一樣危險嗎？從監管制度看兩地差異\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"看到國外案例，許多人會擔心台灣的銀行是否也一樣脆弱。整體來說，台灣的金融監管比美國部分區域性銀行更為嚴格，這提供了一層保護。但這不代表可以完全鬆懈，因為全球化的影響無可避免。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"監管強度：台灣金管會對銀行的資本要求、流動性覆蓋率（LCR）都有嚴格規範，避免銀行持有過高風險的資產。\"}],[\"$\",\"li\",\"1\",{\"children\":\"存款保險：台灣有中央存款保險制度，每位存戶在單一銀行的存款本息合計有最高新台幣 300 萬元的保障，能有效穩定存戶信心。\"}],[\"$\",\"li\",\"2\",{\"children\":\"業務結構：多數台灣銀行的業務相對傳統，較少涉入高風險的金融衍生商品，體質相對單純穩健。\"}]]}]]]}]\n1d:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、危機也是轉機？金融風暴後，散戶該如何調整投資策略\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"市場恐慌時，常常會出現「錯殺」的情況，也就是體質好的公司跟著有問題的公司一起被拋售。這對做好功課的投資人來說，反而是長期布局的機會。重點不是在下跌時去猜底部，而是利用這個時機，重新檢視自己的持股，汰弱留強。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"你可以列出觀察清單，專注在那些受危機影響小、財務結構健全、具備長期競爭力的龍頭公司。等待市場恐慌情緒過去，訊號趨於穩定後，再考慮分批投入，而不是在風暴中心點試圖在低點承接。\"}]]}]]]}]\n1e:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"什麼是「未實現損益」？為什麼這麼重要？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"這是指銀行持有債券等金融資產，其「市價」和當初「買入成本」之間的差額。如果市價下跌，就會產生未實現虧損。平常這只是帳面數字，但若銀行被迫賣掉資產換現金，虧損就會成真，直接衝擊銀行的獲利與資本。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"央行升息為什麼會引發銀行危機？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"快速升息會讓銀行過去在低利率時期買的長期債券價格大跌。同時，升息也可能讓存款戶把錢移到利率更高的投資工具，造成銀行存款流失。當銀行需要賣掉下跌的債券來應付提款時，就可能引爆虧損。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"台灣的存款保險制度安全嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"是的，台灣的中央存款保險公司為每位存戶在同一家要保機構的存款本息，提供最高新台幣 300 萬元的保障。這項制度能有效穩定民眾信心，避免因恐慌引發大規模擠兌潮。（資訊查證月份：2026-08）\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"銀行危機發生時，我應該馬上賣掉所有金融股嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"不建議因恐慌而全面拋售。重點是區分風險，檢視您持股的銀行體質是否健全，例如資本適足率是否遠高於標準、資產品質如何。系統性風險下，好公司和壞公司都可能下跌，但體質好的公司長期恢復力更強。\"}]]}]]}]]]}]\n1f:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"總結來說，回顧區域性銀行危機，教我們最重要的事是「風險管理」。平時就該了解自己持股的財務體質，特別是利率變動下的資產曝險。面對危機時，保持冷靜、不隨意拋售，才能在市場回穩後掌握先機。\"}]]]}]\n20:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L17\",\"0-用「個股透視」檢\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"用「個股透視」檢查公司財報\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L17\",\"0-從「大盤總覽」看\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"從「大盤總覽」看外資流向\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L17\",\"0-到「台股學堂」了\",{\"href\":\"/school\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"到「台股學堂」了解更多名詞\"}]]}]]}]]]}]\n13:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\nf:null\n21:I[80622,[],\"IconMark\"]\n11:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"區域性銀行危機回顧：為何一家美國銀行倒閉，會影響我的台股持股？3 個避險觀察點｜股市大佬 TradeBoss\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"看到國外某家銀行倒閉的新聞，是不是覺得離自己很遠，但又隱約擔心手上的金融股？為什麼美國一家地方銀行出事，會讓全球股市跟著緊張？這篇文章就是要帶你回顧歷史，看懂危機背後的連鎖反應，並學會幾個簡單的觀察點，保護自己的資產。\"}],[\"$\",\"link\",\"2\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}],[\"$\",\"$L21\",\"3\",{}]],\"error\":null,\"digest\":\"$undefined\"}\n16:\"$11:metadata\"\n"}