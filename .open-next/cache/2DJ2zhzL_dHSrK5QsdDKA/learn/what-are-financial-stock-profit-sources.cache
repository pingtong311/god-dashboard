,\\\"span\\\",null,{\\\"className\\\":\\\"LearnArticle_read__QEj6a\\\",\\\"children\\\":\\\"閱讀約 6 分鐘\\\"}]]}],[\\\"$\\\",\\\"h1\\\",null,{\\\"className\\\":\\\"LearnArticle_title__0_la8\\\",\\\"children\\\":\\\"金融股的獲利來源是什麼？銀行、保險、證券 3 大業務怎麼賺錢一次看懂\\\"}],[\\\"$\\\",\\\"details\\\",null,{\\\"className\\\":\\\"LearnArticle_toc__LcSAa\\\",\\\"children\\\":[[\\\"$\\\",\\\"summary\\\",null,{\\\"className\\\":\\\"LearnArticle_tocSummary__YBddG\\\",\\\"children\\\":\\\"本文目錄\\\"}],[\\\"$\\\",\\\"ol\\\",null,{\\\"className\\\":\\\"LearnArticle_tocList__Rq_Lz\\\",\\\"children\\\":[[\\\"$\\\",\\\"li\\\",\\\"sec-1\\\",{\\\"children\\\":[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"#sec-1\\\",\\\"children\\\":\\\"一、為什麼要懂金融股的獲利來源？不只為了領股息！\\\"}]}],[\\\"$\\\",\\\"li\\\",\\\"sec-2\\\",{\\\"children\\\":[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"#sec-2\\\",\\\"children\\\":\\\"二、銀行業：最傳統的「利差」生意怎麼賺？\\\"}]}],[\\\"$\\\",\\\"li\\\",\\\"sec-3\\\",{\\\"children\\\":[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"#sec-3\\\",\\\"children\\\":\\\"三、保險業：收進來的龐大保費都拿去做什麼了？\\\"}]}],[\\\"$\\\",\\\"li\\\",\\\"sec-4\\\",{\\\"children\\\":[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"#sec-4\\\",\\\"children\\\":\\\"四、證券業：台股成交量就是它們的生命線？\\\"}]}],[\\\"$\\\",\\\"li\\\",\\\"sec-5\\\",{\\\"children\\\":[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"#sec-5\\\",\\\"children\\\":\\\"五、一張表看懂：銀行、保險、證券獲利模式差在哪？\\\"}]}],[\\\"$\\\",\\\"li\\\",\\\"sec-6\\\",{\\\"children\\\":[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"#sec-6\\\",\\\"children\\\":\\\"常見問題 FAQ\\\"}]}],[\\\"$\\\",\\\"li\\\",\\\"sec-7\\\",{\\\"children\\\":[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"#sec-7\\\",\\\"children\\\":\\\"總結\\\"}]}],[\\\"$\\\",\\\"li\\\",\\\"sec-8\\\",{\\\"children\\\":[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"#sec-8\\\",\\\"children\\\":\\\"延伸閱讀\\\"}]}]]}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"LearnArticle_body__6B7Mb\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"LearnArticle_intro__ATV5c\\\",\\\"children\\\":\\\"很多人喜歡存金融股，覺得每年穩穩領股息就好，但你知道銀行、保險、證券公司賺錢的方式其實差很多嗎？搞懂它們的獲利來源，才能在市場變動時，判斷誰的體質比較穩健，而不是只看股價高低。\\\"}],[],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"LearnArticle_tldr__Br5BY\\\",\\\"children\\\":[[\\\"$\\\",\\\"b\\\",null,{\\\"className\\\":\\\"LearnArticle_tldrTitle__K5PBN\\\",\\\"children\\\":\\\"本文重點\\\"}],[\\\"$\\\",\\\"ul\\\",null,{\\\"className\\\":\\\"LearnArticle_tldrList__VSc2_\\\",\\\"children\\\":[[\\\"$\\\",\\\"li\\\",\\\"0\\\",{\\\"children\\\":\\\"銀行主要靠「存放款利差」賺錢，升息通常對它們是利多。\\\"}],[\\\"$\\\",\\\"li\\\",\\\"1\\\",{\\\"children\\\":\\\"保險公司靠「保費收入」的投資收益，股債市表現對獲利影響很大。\\\"}],[\\\"$\\\",\\\"li\\\",\\\"2\\\",{\\\"children\\\":\\\"證券商獲利看「手續費」和「自營操作」，台股成交量是關鍵指標。\\\"}],[\\\"$\\\",\\\"li\\\",\\\"3\\\",{\\\"children\\\":\\\"看懂金融股獲利結構，才能判斷市場趨勢對哪一種類型更有利。\\\"}]]}]]}],[[\\\"$\\\",\\\"section\\\",\\\"sec-1\\\",{\\\"id\\\":\\\"sec-1\\\",\\\"className\\\":\\\"LearnArticle_section__hLVjU\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"LearnArticle_h2__NmJ08\\\",\\\"children\\\":\\\"一、為什麼要懂金融股的獲利來源？不只為了領股息！\\\"}],[[\\\"$\\\",\\\"p\\\",\\\"0\\\",{\\\"className\\\":\\\"LearnArticle_p__aZlQ1\\\",\\\"children\\\":\\\"把金融股全部當成一樣的「存股」標的，是常見的誤區。事實上，不同類型的金融股，獲利模式天差地遠，對市場環境的反應也完全不同。搞懂它們怎麼賺錢，你才能判斷在升息、降息或股市多空時，哪一類的公司比較有機會勝出，而不是買了之後才發現「怎麼別人漲、我的都沒動」。\\\"}],[\\\"$\\\",\\\"ul\\\",\\\"1\\\",{\\\"className\\\":\\\"LearnArticle_listCheck__xx1CF\\\",\\\"children\\\":[[\\\"$\\\",\\\"li\\\",\\\"0\\\",{\\\"children\\\":\\\"判斷升息／降息環境下的贏家\\\"}],[\\\"$\\\",\\\"li\\\",\\\"1\\\",{\\\"children\\\":\\\"評估股市多空對獲利的衝擊\\\"}],[\\\"$\\\",\\\"li\\\",\\\"2\\\",{\\\"children\\\":\\\"避開體質轉弱、獲利衰退的公司\\\"}]]}]]]}],[\\\"$\\\",\\\"section\\\",\\\"sec-2\\\",{\\\"id\\\":\\\"sec-2\\\",\\\"className\\\":\\\"LearnArticle_section__hLVjU\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"LearnArticle_h2__NmJ08\\\",\\\"children\\\":\\\"二、銀行業：最傳統的「利差」生意怎麼賺？\\\"}],[[\\\"$\\\",\\\"p\\\",\\\"0\\\",{\\\"className\\\":\\\"LearnArticle_p__aZlQ1\\\",\\\"children\\\":\\\"銀行業的核心業務，就是向大眾吸收存款（資金成本），再把這些錢放款給需要資金的個人或企業（賺取利息）。中間的利率差距，就是所謂的「利差」，這是銀行最穩定、最主要的獲利來源。簡單來說，假設銀行用 1% 的利率吸收民眾存款 100 萬，再用 3% 的利率放款給企業，中間的 2% 就是它的毛利。因此，當央行升息時，銀行的放款利率通常會調升得比存款利率快又多，利差擴大，對獲利就是一大利多。\\\"}]]]}],[\\\"$\\\",\\\"section\\\",\\\"sec-3\\\",{\\\"id\\\":\\\"sec-3\\\",\\\"className\\\":\\\"LearnArticle_section__hLVjU\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"LearnArticle_h2__NmJ08\\\",\\\"children\\\":\\\"三、保險業：收進來的龐大保費都拿去做什麼了？\\\"}],[[\\\"$\\\",\\\"p\\\",\\\"0\\\",{\\\"className\\\":\\\"LearnArticle_p__aZlQ1\\\",\\\"children\\\":\\\"保險公司，特別是壽險公司，會向保戶收取大量的保費，累積成一筆非常龐大的「可運用資金」。它們會將這筆錢投資到國內外的股票、債券、不動產等各種金融商品，賺取投資收益。這也是為什麼保險公司的獲利，跟資本市場的表現高度相關。如果股、債市走多頭，投資收益就好；反之，若遇到空頭市場，就可能出現龐大的投資虧損，直接衝擊當期獲利。\\\"}],[\\\"$\\\",\\\"figure\\\",\\\"1\\\",{\\\"className\\\":\\\"LearnArticle_fig__uoT7r\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"LearnArticle_figFrame__jJ7E4\\\",\\\"children\\\":\\\"✓確認主要業務類型✓對照當前利率環境✓檢視獲利穩定性\\\"}],[\\\"$\\\",\\\"figcaption\\\",null,{\\\"className\\\":\\\"LearnArticle_figCap__LnUbb\\\",\\\"children\\\":\\\"分析金融股 3 個檢查點\\\"}]]}]]]}],[\\\"$\\\",\\\"section\\\",\\\"sec-4\\\",{\\\"id\\\":\\\"sec-4\\\",\\\"className\\\":\\\"LearnArticle_section__hLVjU\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"LearnArticle_h2__NmJ08\\\",\\\"children\\\":\\\"四、證券業：台股成交量就是它們的生命線？\\\"}],[[\\\"$\\\",\\\"p\\\",\\\"0\\\",{\\\"className\\\":\\\"LearnArticle_p__aZlQ1\\\",\\\"children\\\":\\\"證券公司的獲利主要有兩大塊：第一是「經紀業務」，也就是投資人買賣股票時付出的手續費，這部分收入完全跟台股的「成交量」掛鉤，市場越熱絡，它們就賺越多。第二是「自營業務」，也就是券商自己拿錢進場操作，這部分獲利的好壞就看操盤團隊的功力，波動性非常大。因此，判斷證券股的獲利，觀察台股每日成交量是一個非常直觀的指標。\\\"}]]]}],\\\"$L18\\\",\\\"$L19\\\",\\\"$L1a\\\",\\\"$L1b\\\"],null]}]]}]}]\\n\"])</script><script>self.__next_f.push([1,\"18:[\\\"$\\\",\\\"section\\\",\\\"sec-5\\\",{\\\"id\\\":\\\"sec-5\\\",\\\"className\\\":\\\"LearnArticle_section__hLVjU\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"LearnArticle_h2__NmJ08\\\",\\\"children\\\":\\\"五、一張表看懂：銀行、保險、證券獲利模式差在哪？\\\"}],[[\\\"$\\\",\\\"p\\\",\\\"0\\\",{\\\"className\\\":\\\"LearnArticle_p__aZlQ1\\\",\\\"children\\\":\\\"總結來說，這三類金融股的賺錢方程式完全不同，對市場變化的敏感度也天差地遠。用下面這張表，你可以快速掌握它們的核心差異，未來在挑選時，就能更有方向，知道該關注哪些重點。\\\"}],[\\\"$\\\",\\\"div\\\",\\\"1\\\",{\\\"className\\\":\\\"LearnArticle_tblScroll__z9kbb\\\",\\\"children\\\":[\\\"$\\\",\\\"table\\\",null,{\\\"className\\\":\\\"LearnArticle_tbl__0yNgv\\\",\\\"children\\\":[[\\\"$\\\",\\\"thead\\\",null,{\\\"children\\\":[\\\"$\\\",\\\"tr\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"th\\\",\\\"0\\\",{\\\"children\\\":\\\"業務類別\\\"}],[\\\"$\\\",\\\"th\\\",\\\"1\\\",{\\\"children\\\":\\\"主要獲利來源\\\"}],[\\\"$\\\",\\\"th\\\",\\\"2\\\",{\\\"children\\\":\\\"關鍵影響因素\\\"}],[\\\"$\\\",\\\"th\\\",\\\"3\\\",{\\\"children\\\":\\\"獲利穩定度\\\"}]]}]}],[\\\"$\\\",\\\"tbody\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"tr\\\",\\\"0\\\",{\\\"children\\\":[[\\\"$\\\",\\\"td\\\",\\\"0\\\",{\\\"children\\\":\\\"銀行\\\"}],[\\\"$\\\",\\\"td\\\",\\\"1\\\",{\\\"children\\\":\\\"存放款利差、手續費\\\"}],[\\\"$\\\",\\\"td\\\",\\\"2\\\",{\\\"children\\\":\\\"央行利率政策\\\"}],[\\\"$\\\",\\\"td\\\",\\\"3\\\",{\\\"children\\\":\\\"高\\\"}]]}],[\\\"$\\\",\\\"tr\\\",\\\"1\\\",{\\\"children\\\":[[\\\"$\\\",\\\"td\\\",\\\"0\\\",{\\\"children\\\":\\\"保險\\\"}],[\\\"$\\\",\\\"td\\\",\\\"1\\\",{\\\"children\\\":\\\"保費投資收益、保單利差損\\\"}],[\\\"$\\\",\\\"td\\\",\\\"2\\\",{\\\"children\\\":\\\"股債市行情、利率\\\"}],[\\\"$\\\",\\\"td\\\",\\\"3\\\",{\\\"children\\\":\\\"中\\\"}]]}],[\\\"$\\\",\\\"tr\\\",\\\"2\\\",{\\\"children\\\":[[\\\"$\\\",\\\"td\\\",\\\"0\\\",{\\\"children\\\":\\\"證券\\\"}],[\\\"$\\\",\\\"td\\\",\\\"1\\\",{\\\"children\\\":\\\"經紀手續費、自營操作\\\"}],[\\\"$\\\",\\\"td\\\",\\\"2\\\",{\\\"children\\\":\\\"台股成交量、市場波動\\\"}],[\\\"$\\\",\\\"td\\\",\\\"3\\\",{\\\"children\\\":\\\"低\\\"}]]}]]}]]}]}]]]}]\\n\"])</script><script>self.__next_f.push([1,\"19:[\\\"$\\\",\\\"section\\\",\\\"sec-6\\\",{\\\"id\\\":\\\"sec-6\\\",\\\"className\\\":\\\"LearnArticle_section__hLVjU\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"LearnArticle_h2__NmJ08\\\",\\\"children\\\":\\\"常見問題 FAQ\\\"}],[[\\\"$\\\",\\\"div\\\",\\\"0\\\",{\\\"className\\\":\\\"LearnArticle_faq__cemBp\\\",\\\"children\\\":[[\\\"$\\\",\\\"details\\\",\\\"0\\\",{\\\"className\\\":\\\"LearnArticle_faqItem__I9h0U\\\",\\\"children\\\":[[\\\"$\\\",\\\"summary\\\",null,{\\\"children\\\":\\\"升息對所有金融股都是好事嗎？\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"LearnArticle_faqA__IPuvc\\\",\\\"children\\\":\\\"不一定。升息主要對銀行業的利差擴大有利。但對保險業和證券業來說，升息可能導致債券價格下跌、股市資金緊縮，反而對投資收益造成壓力。\\\"}]]}],[\\\"$\\\",\\\"details\\\",\\\"1\\\",{\\\"className\\\":\\\"LearnArticle_faqItem__I9h0U\\\",\\\"children\\\":[[\\\"$\\\",\\\"summary\\\",null,{\\\"children\\\":\\\"金控公司（如富邦金、國泰金）的獲利要怎麼看？\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"LearnArticle_faqA__IPuvc\\\",\\\"children\\\":\\\"金控是控股公司，旗下通常同時有銀行、保險、證券等子公司。看金控獲利時，要去拆解是哪個子公司貢獻最多，才能判斷獲利來源的穩定性。例如，是以銀行為主體還是以壽險為主體，體質會完全不同。\\\"}]]}],[\\\"$\\\",\\\"details\\\",\\\"2\\\",{\\\"className\\\":\\\"LearnArticle_faqItem__I9h0U\\\",\\\"children\\\":[[\\\"$\\\",\\\"summary\\\",null,{\\\"children\\\":\\\"為什麼有些金融股的股價波動很大？\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"LearnArticle_faqA__IPuvc\\\",\\\"children\\\":\\\"通常是獲利來源比較不穩定的公司，例如以證券經紀或壽險投資為主的金融股。因為它們的獲利與資本市場行情高度相關，當股市或債市劇烈波動時，它們的盈虧也會跟著大幅擺盪。\\\"}]]}],[\\\"$\\\",\\\"details\\\",\\\"3\\\",{\\\"className\\\":\\\"LearnArticle_faqItem__I9h0U\\\",\\\"children\\\":[[\\\"$\\\",\\\"summary\\\",null,{\\\"children\\\":\\\"除了獲利來源，挑選金融股還要看什麼指標？\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"LearnArticle_faqA__IPuvc\\\",\\\"children\\\":\\\"可以關注幾個關鍵財務比率，例如銀行的「資本適足率 (BIS)」和「逾期放款比率」，保險業的「資本適足率 (RBC)」，這些都代表公司的風險承受能力與資產品質。\\\"}]]}]]}]]]}]\\n\"])</script><script>self.__next_f.push([1,\"1a:[\\\"$\\\",\\\"section\\\",\\\"sec-7\\\",{\\\"id\\\":\\\"sec-7\\\",\\\"className\\\":\\\"LearnArticle_section__hLVjU\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"LearnArticle_h2__NmJ08\\\",\\\"children\\\":\\\"總結\\\"}],[[\\\"$\\\",\\\"p\\\",\\\"0\\\",{\\\"className\\\":\\\"LearnArticle_p__aZlQ1\\\",\\\"children\\\":\\\"總結來說，挑選金融股不能只看殖利率高低。你必須先搞懂它是銀行、保險還是證券，了解它的主要獲利來源，再對照當前的經濟環境（例如是升息還是降息），才能找到體質相對穩健的標的。\\\"}]]]}]\\n1b:[\\\"$\\\",\\\"section\\\",\\\"sec-8\\\",{\\\"id\\\":\\\"sec-8\\\",\\\"className\\\":\\\"LearnArticle_section__hLVjU\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"LearnArticle_h2__NmJ08\\\",\\\"children\\\":\\\"延伸閱讀\\\"}],[[\\\"$\\\",\\\"ul\\\",\\\"0\\\",{\\\"className\\\":\\\"LearnArticle_list__WjxqC\\\",\\\"children\\\":[[\\\"$\\\",\\\"li\\\",\\\"0\\\",{\\\"children\\\":[[\\\"$\\\",\\\"$L17\\\",\\\"0-查詢個股詳細財務\\\",{\\\"href\\\":\\\"/diary\\\",\\\"className\\\":\\\"LearnArticle_link__gMwHV\\\",\\\"children\\\":\\\"查詢個股詳細財務數據\\\"}]]}],[\\\"$\\\",\\\"li\\\",\\\"1\\\",{\\\"children\\\":[[\\\"$\\\",\\\"$L17\\\",\\\"0-看看今年的除權息\\\",{\\\"href\\\":\\\"/s/2330\\\",\\\"className\\\":\\\"LearnArticle_link__gMwHV\\\",\\\"children\\\":\\\"看看今年的除權息日期\\\"}]]}],[\\\"$\\\",\\\"li\\\",\\\"2\\\",{\\\"children\\\":[[\\\"$\\\",\\\"$L17\\\",\\\"0-學習更多台股基本\\\",{\\\"href\\\":\\\"/school\\\",\\\"className\\\":\\\"LearnArticle_link__gMwHV\\\",\\\"children\\\":\\\"學習更多台股基本觀念\\\"}]]}]]}]]]}]\\n\"])</script><script>self.__next_f.push([1,\"13:[[\\\"$\\\",\\\"meta\\\",\\\"0\\\",{\\\"charSet\\\":\\\"utf-8\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"1\\\",{\\\"name\\\":\\\"viewport\\\",\\\"content\\\":\\\"width=device-width, initial-scale=1\\\"}]]\\nf:null\\n\"])</script><script>self.__next_f.push([1,\"1c:I[80622,[],\\\"IconMark\\\"]\\n11:{\\\"metadata\\\":[[\\\"$\\\",\\\"title\\\",\\\"0\\\",{\\\"children\\\":\\\"金融股的獲利來源是什麼？銀行、保險、證券 3 大業務怎麼賺錢一次看懂｜股市大佬 TradeBoss\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"1\\\",{\\\"name\\\":\\\"description\\\",\\\"content\\\":\\\"很多人喜歡存金融股，覺得每年穩穩領股息就好，但你知道銀行、保險、證券公司賺錢的方式其實差很多嗎？搞懂它們的獲利來源，才能在市場變動時，判斷誰的體質比較穩健，而不是只看股價高低。\\\"}],[\\\"$\\\",\\\"link\\\",\\\"2\\\",{\\\"rel\\\":\\\"icon\\\",\\\"href\\\":\\\"/favicon.ico\\\",\\\"type\\\":\\\"image/x-icon\\\",\\\"sizes\\\":\\\"16x16\\\"}],[\\\"$\\\",\\\"$L1c\\\",\\\"3\\\",{}]],\\\"error\\\":null,\\\"digest\\\":\\\"$undefined\\\"}\\n\"])</script><script>self.__next_f.push([1,\"16:\\\"$11:metadata\\\"\\n\"])</script></body></html>","rsc":"1:\"$Sreact.fragment\"\n2:I[81259,[\"2619\",\"static/chunks/2619-04bc32f026a0d946.js\",\"7177\",\"static/chunks/app/layout-4382c12d510386d3.js\"],\"default\"]\n3:I[89379,[\"2619\",\"static/chunks/2619-04bc32f026a0d946.js\",\"7177\",\"static/chunks/app/layout-4382c12d510386d3.js\"],\"default\"]\n4:I[9766,[],\"\"]\n5:I[98924,[],\"\"]\n6:I[10021,[\"2619\",\"static/chunks/2619-04bc32f026a0d946.js\",\"7177\",\"static/chunks/app/layout-4382c12d510386d3.js\"],\"default\"]\n7:I[10528,[\"2619\",\"static/chunks/2619-04bc32f026a0d946.js\",\"7177\",\"static/chunks/app/layout-4382c12d510386d3.js\"],\"default\"]\n8:I[50861,[\"2619\",\"static/chunks/2619-04bc32f026a0d946.js\",\"7177\",\"static/chunks/app/layout-4382c12d510386d3.js\"],\"default\"]\nc:I[57150,[],\"\"]\n:HL[\"/_next/static/media/3d26d2f3aa81a833-s.p.woff2\",\"font\",{\"crossOrigin\":\"\",\"type\":\"font/woff2\"}]\n:HL[\"/_next/static/media/604a121a6fa1a135-s.p.woff2\",\"font\",{\"crossOrigin\":\"\",\"type\":\"font/woff2\"}]\n:HL[\"/_next/static/media/6e1768769e6f59a2-s.p.woff2\",\"font\",{\"crossOrigin\":\"\",\"type\":\"font/woff2\"}]\n:HL[\"/_next/static/media/ab2e3a11646b0499-s.p.woff2\",\"font\",{\"crossOrigin\":\"\",\"type\":\"font/woff2\"}]\n:HL[\"/_next/static/css/75c047ba52e43fcc.css\",\"style\"]\n:HL[\"/_next/static/css/aa90c9a426448e43.css\",\"style\"]\n:HL[\"/_next/static/css/e55779c04dd245e2.css\",\"style\"]\n:HL[\"/_next/static/css/8c57d5c3b938342e.css\",\"style\"]\n:HL[\"/_next/static/css/3eaf36e367672966.css\",\"style\"]\n0:{\"P\":null,\"b\":\"2DJ2zhzL_dHSrK5QsdDKA\",\"p\":\"\",\"c\":[\"\",\"learn\",\"what-are-financial-stock-profit-sources\"],\"i\":false,\"f\":[[[\"\",{\"children\":[\"learn\",{\"children\":[[\"slug\",\"what-are-financial-stock-profit-sources\",\"d\"],{\"children\":[\"__PAGE__\",{}]}]}]},\"$undefined\",\"$undefined\",true],[\"\",[\"$\",\"$1\",\"c\",{\"children\":[[[\"$\",\"link\",\"0\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/css/75c047ba52e43fcc.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"$undefined\"}],[\"$\",\"link\",\"1\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/css/aa90c9a426448e43.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"$undefined\"}],[\"$\",\"link\",\"2\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/css/e55779c04dd245e2.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"$undefined\"}],[\"$\",\"link\",\"3\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/css/8c57d5c3b938342e.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"$undefined\"}]],[\"$\",\"html\",null,{\"lang\":\"zh-TW\",\"suppressHydrationWarning\":true,\"data-density\":\"comfortable\",\"data-font-size\":\"standard\",\"className\":\"__variable_07e1b6 __variable_cc7473 h-full antialiased\",\"children\":[[\"$\",\"head\",null,{\"children\":[\"$\",\"script\",null,{\"dangerouslySetInnerHTML\":{\"__html\":\"(function(){try{var t=localStorage.getItem('obsidian-theme');if(t!=='light'&&t!=='dark')t='dark';document.documentElement.setAttribute('data-theme',t);document.documentElement.style.colorScheme=(t==='light'?'light':'dark');}catch(e){document.documentElement.setAttribute('data-theme','dark');}})();(function(){try{if(localStorage.getItem('obsidian-comfort-read')==='1')document.documentElement.classList.add('comfort-read');}catch(e){}})();(function(){try{var s=localStorage.getItem('obsidian-updown');if(s==='us')document.documentElement.setAttribute('data-updown','us');}catch(e){}})();(function(){try{var prefs=JSON.parse(localStorage.getItem('bs-preferences-v1')||'{}');var root=document.documentElement;prefs=prefs&&typeof prefs==='object'?prefs:{};root.setAttribute('data-font-size',['standard','large','xlarge','huge'].indexO