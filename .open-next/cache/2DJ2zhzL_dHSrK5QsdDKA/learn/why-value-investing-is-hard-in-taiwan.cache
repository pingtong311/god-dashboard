\"$\",\"meta\",null,{\"name\":\"next-size-adjust\",\"content\":\"\"}]],[\"$\",\"$L14\",null,{\"children\":[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$15\",null,{\"fallback\":null,\"children\":\"$L16\"}]}]}]]}]\n17:I[52619,[\"2619\",\"static/chunks/2619-04bc32f026a0d946.js\",\"6309\",\"static/chunks/app/learn/%5Bslug%5D/page-f7b99344f7e2ee16.js\"],\"\"]\nd:[\"$\",\"div\",null,{\"className\":\"LearnArticle_wrap__LIQ8G\",\"children\":[\"$\",\"article\",null,{\"className\":\"LearnArticle_article__2nBbk\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_meta__etj_G\",\"children\":[[\"$\",\"$L17\",null,{\"className\":\"LearnArticle_cat__GQMlg\",\"href\":\"/learn?c=strategy\",\"children\":\"策略解析\"}],[\"$\",\"span\",null,{\"className\":\"LearnArticle_read__QEj6a\",\"children\":\"閱讀約 4 分鐘\"}]]}],[\"$\",\"h1\",null,{\"className\":\"LearnArticle_title__0_la8\",\"children\":\"價值投資在台股為什麼難？3個結構先看再談便宜\"}],[\"$\",\"details\",null,{\"className\":\"LearnArticle_toc__LcSAa\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"LearnArticle_tocSummary__YBddG\",\"children\":\"本文目錄\"}],[\"$\",\"ol\",null,{\"className\":\"LearnArticle_tocList__Rq_Lz\",\"children\":[[\"$\",\"li\",\"sec-1\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-1\",\"children\":\"一、便宜的第一問：它為什麼在這裡\"}]}],[\"$\",\"li\",\"sec-2\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-2\",\"children\":\"二、循環股會騙過本益比\"}]}],[\"$\",\"li\",\"sec-3\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-3\",\"children\":\"三、時間與流動性是第二層難\"}]}],[\"$\",\"li\",\"sec-4\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-4\",\"children\":\"四、治理與股利會改寫內在價值\"}]}],[\"$\",\"li\",\"sec-5\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-5\",\"children\":\"五、難，不表示觀念沒用\"}]}],[\"$\",\"li\",\"sec-6\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-6\",\"children\":\"常見問題 FAQ\"}]}],[\"$\",\"li\",\"sec-7\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-7\",\"children\":\"總結\"}]}],[\"$\",\"li\",\"sec-8\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-8\",\"children\":\"延伸閱讀\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"LearnArticle_body__6B7Mb\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_intro__ATV5c\",\"children\":\"價值投資聽起來很乾淨：算清楚值多少，便宜就拿著等。台股讓這句話變難的，不是觀念錯，是結構不一樣。循環股的「便宜」可能只是景氣冬天；便宜的東西也可能長期不流動；公司治理與股利政策會改寫你以為的內在價值。這篇只講難，不講放棄。\"}],[[\"$\",\"figure\",\"figure-0\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"虧 3 次每次 −1%賺 2 次每次 +1%勝率 40% 也可能是正期望，前提是賺的比虧的大、且扣得起成本短線先扣約 0.24% 當沖成本，再看還剩多少\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"示意圖｜期望值：勝率要配上平均賺賠，再扣成本（教學結構，不是某檔實盤）\"}]]}]],[\"$\",\"div\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"便宜要先問：它為什麼便宜，以及誰有能力讓它不便宜\"}],[\"$\",\"li\",\"1\",{\"children\":\"循環股的低本益比，常常是景氣位置，不是折扣\"}],[\"$\",\"li\",\"2\",{\"children\":\"等回歸的時間，可能長過你的資金與耐心\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、便宜的第一問：它為什麼在這裡\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"教科書假設市場暫時算錯，之後會算對。實務上，便宜可能來自循環底部、流動性差、治理疑慮、產業正在被替代，或只是暫時沒人看。四種便宜的後續完全不同。你若只用本益比或淨值比排序，等於把不同病因排成同一張特價表。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"先寫它為什麼便宜\"}],[\"$\",\"li\",\"1\",{\"children\":\"再寫誰有動機讓它被重估\"}],[\"$\",\"li\",\"2\",{\"children\":\"寫不出來就還只是低數字\"}]]}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、循環股會騙過本益比\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"獲利在高峰時，本益比看起來很便宜；獲利在谷底時，本益比看起來很貴。這是循環股的經典錯位。台股電子、原物料、航運都常出現這種長相。你用高峰獲利去除現價，會得到一個很誘人的倍數，那個倍數假設高峰會變成常態。假設不寫出來，價值就只是算術。\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"你看到的\"}],[\"$\",\"th\",\"1\",{\"children\":\"可能其實是\"}],[\"$\",\"th\",\"2\",{\"children\":\"先補的一問\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"本益比很低\"}],[\"$\",\"td\",\"1\",{\"children\":\"獲利在循環高峰\"}],[\"$\",\"td\",\"2\",{\"children\":\"常態獲利是多少\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"淨值比很低\"}],[\"$\",\"td\",\"1\",{\"children\":\"資產難變現或在折舊\"}],[\"$\",\"td\",\"2\",{\"children\":\"資產值不值得這個價\"}]]}],[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"殖利率很高\"}],[\"$\",\"td\",\"1\",{\"children\":\"股利不可持續\"}],[\"$\",\"td\",\"2\",{\"children\":\"現金從哪裡來\"}]]}],[\"$\",\"tr\",\"3\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"跌很深所以便宜\"}],[\"$\",\"td\",\"1\",{\"children\":\"產業位置變了\"}],[\"$\",\"td\",\"2\",{\"children\":\"需求還在不在\"}]]}]]}]]}]}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、時間與流動性是第二層難\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"就算判斷對，市場給你對的時間可能以年計。中間你要付的是機會成本、情緒與可能用到錢。小公司更常出現「便宜但走不掉」。價值若不能在你需要時變成現金，它對你的帳戶就不是價值。胃納量那篇講過離場；價值投資一樣要先問離場。\"}],\"$L18\",\"$L19\"]]}],\"$L1a\",\"$L1b\",\"$L1c\",\"$L1d\",\"$L1e\"],\"$L1f\"]}]]}]}]\n18:[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"先問你能等幾年\"}],[\"$\",\"li\",\"1\",{\"children\":\"再問這檔平常一天能走多少\"}],[\"$\",\"li\",\"2\",{\"children\":\"最後才談它便不便宜\"}]]}]\n19:[\"$\",\"figure\",\"2\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"✓為什麼便宜✓誰讓它重估✓我能等多久\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"先問三題\"}]]}]\n1a:[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、治理與股利會改寫內在價值\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"帳上有現金，不代表股東拿得到。轉投資、關係人、減資、增資、股利政策一變，你算的數字就要重做。台股這層不能當配角。價值投資不是只會算表，還要讀誰在控制公司、他過往怎麼對待小股東。這不是陰謀論，是公開資訊功課。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"現金在帳上≠現金在你口袋\"}],[\"$\",\"li\",\"1\",{\"children\":\"先讀股利與增減資歷史\"}],[\"$\",\"li\",\"2\",{\"children\":\"控制權結構要進估值假設\"}]]}]]]}]\n1b:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、難，不表示觀念沒用\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"難處提醒你：不要把低倍數自動翻譯成安全。觀念仍有用的地方是：它逼你問值不值、問風險、問時間。你可以用同一套問題去檢查成長故事，也可以用來拒絕自己聽起來很熱的題材。價值是問題清單，不是保證回歸的機器。\"}]]]}]\n1c:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"是不是台股不適合價值投資？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"不是不適合，是結構讓「等回歸」更貴。觀念能用，口訣不能直接搬。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"用ETF 是不是就避開這些難？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"寬基可以降低單一個股治理風險，仍有循環與評價風險。工具換了，問題不會全消失。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"高殖利率算不算價值？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"要先問股利來源穩不穩。高殖利率可以是價值，也可以是警訊。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"跟定期定額衝突嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"不一定。定期定額管的是投入節奏；價值管的是你對價格與風險的問題。兩套可以同時存在。\"}]]}]]}]]]}]\n1d:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"台股的便宜要先問病因、循環位置、等待時間與治理。低倍數不是安全證明。價值是問題清單，不是回歸保證。\"}]]]}]\n1e:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L17\",\"0-定期定額優缺點\",{\"href\":\"/learn/dca-pros-and-cons-in-taiwan-stocks\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"定期定額優缺點\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L17\",\"0-景氣循環股怎麼分\",{\"href\":\"/learn/cyclical-vs-defensive-stocks-taiwan\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"景氣循環股怎麼分類\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L17\",\"0-流動性與胃納量\",{\"href\":\"/learn/why-liquidity-decides-your-exit\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"流動性與胃納量\"}]]}]]}]]]}]\n1f:[\"$\",\"div\",null,{\"className\":\"LearnArticle_related__9qV55\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_relatedTitle__RXfrl\",\"children\":\"相關文章\"}],[[\"$\",\"$L17\",\"dca-pros-and-cons-in-taiwan-stocks\",{\"href\":\"/learn/dca-pros-and-cons-in-taiwan-stocks\",\"className\":\"LearnArticle_relatedLink__mibXe\",\"children\":\"定期定額優缺點\"}],[\"$\",\"$L17\",\"cyclical-vs-defensive-stocks-taiwan\",{\"href\":\"/learn/cyclical-vs-defensive-stocks-taiwan\",\"className\":\"LearnArticle_relatedLink__mibXe\",\"children\":\"景氣循環股怎麼分類\"}],[\"$\",\"$L17\",\"why-liquidity-decides-your-exit\",{\"href\":\"/learn/why-liquidity-decides-your-exit\",\"className\":\"LearnArticle_relatedLink__mibXe\",\"children\":\"流動性與胃納量\"}]]]}]\n13:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\nf:null\n20:I[80622,[],\"IconMark\"]\n11:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"價值投資在台股為什麼難？3個結構先看再談便宜｜股市大佬 TradeBoss\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"價值投資聽起來很乾淨：算清楚值多少，便宜就拿著等。台股讓這句話變難的，不是觀念錯，是結構不一樣。循環股的「便宜」可能只是景氣冬天；便宜的東西也可能長期不流動；公司治理與股利政策會改寫你以為的內在價值。這篇只講難，不講放棄。\"}],[\"$\",\"link\",\"2\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}],[\"$\",\"$L20\",\"3\",{}]],\"error\":null,\"digest\":\"$undefined\"}\n16:\"$11:metadata\"\n"}