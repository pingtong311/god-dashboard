f026a0d946.js\",\"6309\",\"static/chunks/app/learn/%5Bslug%5D/page-f7b99344f7e2ee16.js\"],\"\"]\nd:[\"$\",\"div\",null,{\"className\":\"LearnArticle_wrap__LIQ8G\",\"children\":[\"$\",\"article\",null,{\"className\":\"LearnArticle_article__2nBbk\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_meta__etj_G\",\"children\":[[\"$\",\"$L17\",null,{\"className\":\"LearnArticle_cat__GQMlg\",\"href\":\"/learn?c=platform\",\"children\":\"平台教學\"}],[\"$\",\"span\",null,{\"className\":\"LearnArticle_read__QEj6a\",\"children\":\"閱讀約 4 分鐘\"}]]}],[\"$\",\"h1\",null,{\"className\":\"LearnArticle_title__0_la8\",\"children\":\"股市大佬選股頁怎麼用？盤後排行怎麼看\"}],[\"$\",\"details\",null,{\"className\":\"LearnArticle_toc__LcSAa\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"LearnArticle_tocSummary__YBddG\",\"children\":\"本文目錄\"}],[\"$\",\"ol\",null,{\"className\":\"LearnArticle_tocList__Rq_Lz\",\"children\":[[\"$\",\"li\",\"sec-1\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-1\",\"children\":\"一、這一頁給你看什麼\"}]}],[\"$\",\"li\",\"sec-2\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-2\",\"children\":\"二、兩個分頁差在哪\"}]}],[\"$\",\"li\",\"sec-3\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-3\",\"children\":\"三、資料日與更新怎麼看\"}]}],[\"$\",\"li\",\"sec-4\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-4\",\"children\":\"四、結構參考不是進出點\"}]}],[\"$\",\"li\",\"sec-5\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-5\",\"children\":\"五、看完排行，下一步去哪\"}]}],[\"$\",\"li\",\"sec-6\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-6\",\"children\":\"常見問題 FAQ\"}]}],[\"$\",\"li\",\"sec-7\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-7\",\"children\":\"總結\"}]}],[\"$\",\"li\",\"sec-8\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-8\",\"children\":\"延伸閱讀\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"LearnArticle_body__6B7Mb\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_intro__ATV5c\",\"children\":\"選股兩個字很容易讓人以為這裡會告訴你明天買誰。股市大佬這一頁的標題其實是「當沖量價排行」，說明寫的是：依盤後成交量、分點淨買集中度、量比與流動性排序，方便核對資料列。它是盤後客觀排行與歷史統計，不是盤中買賣訊號，也不是叫你跟單。\"}],[],[\"$\",\"div\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"先看資料日，再看集中度、量比與成交量\"}],[\"$\",\"li\",\"1\",{\"children\":\"兩個分頁都是已發生的對照，不是進出指令\"}],[\"$\",\"li\",\"2\",{\"children\":\"量小於三千張要降權重，不要只看一列就下結論\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、這一頁給你看什麼\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"頁面上方會標選股基準日，並寫這是盤後篩選。會員看得到的是客觀排行：代號、名稱、產業、現價或收盤、籌碼集中度、量比、近二十日走勢小圖，以及一句分點資料摘要。流動性不足會標「量小於三千張」。頁面沒有把方向、明日情境或精確進出點開放給一般會員。你要把它當研究起點，不當操作單。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"先對齊資料日\"}],[\"$\",\"li\",\"1\",{\"children\":\"排行描述已發生的量價籌碼\"}],[\"$\",\"li\",\"2\",{\"children\":\"沒有會員版喊單欄位\"}]]}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、兩個分頁差在哪\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"第一個分頁是「盤後籌碼排行」：盤後篩出籌碼較集中、成交活躍且量能放大的列，並標資料日與流動性。使用說明寫：先看集中度、量比與成交量，再點進個股核對；不要只看單一排行。第二個分頁是「族群相對強弱」：把同族群裡資料日漲幅較高與較低者並列。使用說明寫：只核對資料日漲跌、成交量與產業分類，不把相對強弱轉成買賣方向。\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"分頁\"}],[\"$\",\"th\",\"1\",{\"children\":\"主要對照\"}],[\"$\",\"th\",\"2\",{\"children\":\"會員不該把它讀成\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"盤後籌碼排行\"}],[\"$\",\"td\",\"1\",{\"children\":\"集中度、量比、成交量、資料日\"}],[\"$\",\"td\",\"2\",{\"children\":\"明天一定續強\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"族群相對強弱\"}],[\"$\",\"td\",\"1\",{\"children\":\"同產業資料日漲跌分化\"}],[\"$\",\"td\",\"2\",{\"children\":\"弱的一定補漲\"}]]}],[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"量小於三千張\"}],[\"$\",\"td\",\"1\",{\"children\":\"流動性較低的提醒\"}],[\"$\",\"td\",\"2\",{\"children\":\"反而比較好做\"}]]}],[\"$\",\"tr\",\"3\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"近二十日小圖\"}],[\"$\",\"td\",\"1\",{\"children\":\"最近收盤序列的形狀\"}],[\"$\",\"td\",\"2\",{\"children\":\"保證延續的軌跡\"}]]}]]}]]}]}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、資料日與更新怎麼看\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"排行區有資料新鮮度：標的是選股基準日，屬分點與日線結算，不是盤中即時掃描。下次更新寫的是平日約二十一點三十分盤後整理，完整日報更晚。列上若同時出現盤中現價，會另標時間，兩者不混用。沒有可用的分點資料日時，頁面會說目前沒有資料列，而不是用舊日假裝成今日。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"基準日是盤後結算\"}],[\"$\",\"li\",\"1\",{\"children\":\"現價若出現會另標時間\"}],[\"$\",\"li\",\"2\",{\"children\":\"沒有資料日就不要硬讀\"}]]}],[\"$\",\"figure\",\"2\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"!把排行當明牌是誤讀!把相對強弱當方向!把參考線當成必達價\"}],\"$L18\"]}]]]}],\"$L19\",\"$L1a\",\"$L1b\",\"$L1c\",\"$L1d\"],null]}]]}]}]\n18:[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"三種誤讀\"}]\n19:[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、結構參考不是進出點\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"有些列會出現「結構／比例參考」，例如日 K 結構的參考低與參考高，或依收盤價算出的比例線，並註明可自行設提醒。這是讓你知道價格落在哪一帶，不是平台下的停損停利單，更不是目標價。若你要自己盯某一價，請到到價提醒頁用自己的條件；那仍然只是提醒，不是叫你成交。\"}]]]}]\n1a:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、看完排行，下一步去哪\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"使用說明的下一步是：把它當研究起點，排行只描述已發生的量價籌碼，不代表下一個交易日方向。你可以回學堂查集中度與量比的定義，或去隔日沖頁看分點次日反向賣超的歷史樣本。兩頁都還是客觀資料。不要把選股頁的第一列複製到群組裡當明牌，也不要以為沒出現在排行就不能研究。\"}]]]}]\n1b:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"為什麼今天一列都沒有？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"可能還沒有可用的分點資料日，或當天沒有列符合流動性與量價條件。頁面會直接說明，不要用昨天的截圖代替。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"集中度高是不是該買？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"不是。集中度只描述資料日買超是否集中於少數分點，不能辨識交易人，也不能當進出指令。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"族群相對強弱能不能當輪動訊號？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"不能。它只並列資料日漲跌分化。族群續強或轉弱都可能發生，平台不提供進出指令。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"會員和內部人員看到的一樣嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"不一樣。會員看客觀排行、分點摘要與日 K 結構參考；方向、情境與精確點位不是會員欄位。\"}]]}]]}]]]}]\n1c:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"選股頁是盤後量價籌碼排行與族群對照。先看資料日、集中度、量比與流動性。它給你客觀資料，不是叫你下單。\"}]]]}]\n1d:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L17\",\"0-選股頁\",{\"href\":\"/radar\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"選股頁\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L17\",\"0-隔日沖頁\",{\"href\":\"/radar\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"隔日沖頁\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L17\",\"0-台股學堂\",{\"href\":\"/school\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"台股學堂\"}]]}],[\"$\",\"li\",\"3\",{\"children\":[[\"$\",\"$L17\",\"0-法遵與免責聲明\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"法遵與免責聲明\"}]]}]]}]]]}]\n13:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\nf:null\n1e:I[80622,[],\"IconMark\"]\n11:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"股市大佬選股頁怎麼用？盤後排行怎麼看｜股市大佬 TradeBoss\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"選股兩個字很容易讓人以為這裡會告訴你明天買誰。股市大佬這一頁的標題其實是「當沖量價排行」，說明寫的是：依盤後成交量、分點淨買集中度、量比與流動性排序，方便核對資料列。它是盤後客觀排行與歷史統計，不是盤中買賣訊號，也不是叫你跟單。\"}],[\"$\",\"link\",\"2\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}],[\"$\",\"$L1e\",\"3\",{}]],\"error\":null,\"digest\":\"$undefined\"}\n16:\"$11:metadata\"\n"}