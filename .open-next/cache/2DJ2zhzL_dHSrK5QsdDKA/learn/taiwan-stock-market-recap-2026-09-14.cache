ame\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"指數名稱\"}],[\"$\",\"th\",\"1\",{\"children\":\"收盤價\"}],[\"$\",\"th\",\"2\",{\"children\":\"漲跌幅\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"加權指數\"}],[\"$\",\"td\",\"1\",{\"children\":\"45862.52\"}],[\"$\",\"td\",\"2\",{\"children\":\"-0.69%\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"櫃買指數\"}],[\"$\",\"td\",\"1\",{\"children\":\"394.67\"}],[\"$\",\"td\",\"2\",{\"children\":\"-0.21%\"}]]}]]}]]}]}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、族群表現：強弱分明\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"在今日市場普遍修正的氛圍中，仍有部分族群表現相對突出。資訊服務業以3.01%的漲幅領先，其中宏碁資訊（6811）表現強勁。金融業與金融保險業也分別有1.40%和1.23%的漲幅，富邦金（2881）為金融保險業的領漲個股。電子商務業亦有0.85%的漲幅。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"資訊服務業上漲3.01%，宏碁資訊（6811）領漲。\"}],[\"$\",\"li\",\"1\",{\"children\":\"金融業上漲1.40%，致和證（5864）表現突出。\"}],[\"$\",\"li\",\"2\",{\"children\":\"金融保險業上漲1.23%，富邦金（2881）為領漲個股。\"}],[\"$\",\"li\",\"3\",{\"children\":\"電子商務業上漲0.85%，網家（8044）表現相對強勢。\"}]]}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、個股觀察：光學股修正較深\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"今日個股表現分歧，部分股票逆勢上漲，也有股票呈現較大幅度的修正。在漲幅榜上，光鼎（6226）和全友（2305）均以接近漲停的幅度上漲，成交量也相對放大。伊雲谷（6689）也以9.98%的漲幅收盤。在跌幅榜方面，光學族群的玉晶光（3406）與大立光（3008）今日跌幅均達到近10%，顯示該族群今日面臨較大賣壓。上銀（2049）也下跌9.89%。\"}],[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"漲幅榜：光鼎（6226）上漲10.00%，成交量達33483張。\"}],[\"$\",\"li\",\"1\",{\"children\":\"漲幅榜：全友（2305）上漲9.99%，成交量達33465張。\"}],[\"$\",\"li\",\"2\",{\"children\":\"跌幅榜：玉晶光（3406）下跌10.00%，成交量4840張。\"}],[\"$\",\"li\",\"3\",{\"children\":\"跌幅榜：大立光（3008）下跌9.98%，成交量2655張。\"}]]}],[\"$\",\"div\",\"2\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":\"$L18\"}],\"$L19\"]]}],\"$L1a\",\"$L1b\",\"$L1c\",\"$L1d\",\"$L1e\"],null]}]]}]}]\n18:[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"個股代號\"}],[\"$\",\"th\",\"1\",{\"children\":\"個股名稱\"}],[\"$\",\"th\",\"2\",{\"children\":\"漲跌幅\"}],[\"$\",\"th\",\"3\",{\"children\":\"成交量（張）\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"6226\"}],[\"$\",\"td\",\"1\",{\"children\":\"光鼎\"}],[\"$\",\"td\",\"2\",{\"children\":\"+10.00%\"}],[\"$\",\"td\",\"3\",{\"children\":\"33483\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"2305\"}],[\"$\",\"td\",\"1\",{\"children\":\"全友\"}],[\"$\",\"td\",\"2\",{\"children\":\"+9.99%\"}],[\"$\",\"td\",\"3\",{\"children\":\"33465\"}]]}],[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"3406\"}],[\"$\",\"td\",\"1\",{\"children\":\"玉晶光\"}],[\"$\",\"td\",\"2\",{\"children\":\"-10.00%\"}],[\"$\",\"td\",\"3\",{\"children\":\"4840\"}]]}],[\"$\",\"tr\",\"3\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"3008\"}],[\"$\",\"td\",\"1\",{\"children\":\"大立光\"}],[\"$\",\"td\",\"2\",{\"children\":\"-9.98%\"}],[\"$\",\"td\",\"3\",{\"children\":\"2655\"}]]}]]}]]}]\n19:[\"$\",\"figure\",\"3\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"!外資現貨賣超!自營商現貨賣超!台指期淨空單增!融資維持率184.8%\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"法人動向概覽\"}]]}]\n1a:[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、法人動向與市場籌碼\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"從法人動向來看，外資與自營商今日在現貨市場皆呈現賣超。外資賣超約64萬張，自營商賣超約132萬張，兩者合計賣超金額較大。在期貨市場方面，台指期下跌0.95%，外資淨空單口數為82,658口，這兩者同時發生。全市場融資維持率為184.8%。\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"法人類別\"}],[\"$\",\"th\",\"1\",{\"children\":\"現貨買賣超（張）\"}],[\"$\",\"th\",\"2\",{\"children\":\"台指期淨部位（口）\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"外資\"}],[\"$\",\"td\",\"1\",{\"children\":\"-642,214\"}],[\"$\",\"td\",\"2\",{\"children\":\"82,658（淨空單）\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"自營商\"}],[\"$\",\"td\",\"1\",{\"children\":\"-1,326,224\"}],[\"$\",\"td\",\"2\",{\"children\":\"無公開資料\"}]]}]]}]]}]}]]]}]\n1b:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、國際盤與消息面\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"觀察國際主要股市表現，美股在昨日普遍上漲，S&P 500指數上漲0.86%，那斯達克指數上漲0.96%，費城半導體指數更是上漲1.81%。然而，亞洲市場表現則相對疲軟，韓國綜合指數（KOSPI）下跌3.26%，日經225指數下跌0.81%。近期關於美國政策與國際情勢方面，有報導指出川普駁斥中國向伊朗提供情資，以及淡化中國實體在美軍遇襲前協助伊朗的報導。此外，華許與川普之間走向對立，市場投資人預期聯準會可能升息，這些都是今日公開資料中提及的國際消息。\"}],[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"美股S&P 500指數上漲0.86%，那斯達克指數上漲0.96%。\"}],[\"$\",\"li\",\"1\",{\"children\":\"費城半導體指數上漲1.81%。\"}],[\"$\",\"li\",\"2\",{\"children\":\"韓國綜合指數（KOSPI）下跌3.26%，日經225指數下跌0.81%。\"}],[\"$\",\"li\",\"3\",{\"children\":\"川普駁斥中國向伊朗提供情資的報導。\"}],[\"$\",\"li\",\"4\",{\"children\":\"華許與川普走向對立，投資人預期聯準會可能升息。\"}]]}]]]}]\n1c:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"今天大盤表現如何？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"今日加權指數下跌0.69%，收在45862.52點，櫃買指數也下跌0.21%。整體上市股票下跌家數多於上漲家數。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"哪些族群今天比較強勢？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"資訊服務業、金融業、金融保險業和電子商務業今天表現相對強勢，其中資訊服務業漲幅最高，達到3.01%。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"外資今天有買賣超嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"外資今日在現貨市場賣超約64萬張，同時台指期淨空單口數為82,658口，這兩者同時發生。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"今天有哪些股票漲跌幅比較大？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"今日漲幅較大的有光鼎（6226）、全友（2305）；跌幅較大的則有玉晶光（3406）、大立光（3008）。\"}]]}]]}]]]}]\n1d:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"今日台股加權指數呈現下跌，主要受部分個股修正影響，但資訊服務與金融族群逆勢撐盤。法人在現貨市場合計賣超，顯示整體市場觀望氣氛較濃。\"}]]]}]\n1e:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"Le