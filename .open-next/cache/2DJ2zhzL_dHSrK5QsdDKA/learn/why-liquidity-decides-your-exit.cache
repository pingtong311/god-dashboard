cle_toc__LcSAa\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"LearnArticle_tocSummary__YBddG\",\"children\":\"本文目錄\"}],[\"$\",\"ol\",null,{\"className\":\"LearnArticle_tocList__Rq_Lz\",\"children\":[[\"$\",\"li\",\"sec-1\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-1\",\"children\":\"一、胃納量是什麼\"}]}],[\"$\",\"li\",\"sec-2\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-2\",\"children\":\"二、風險是非線性的\"}]}],[\"$\",\"li\",\"sec-3\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-3\",\"children\":\"三、買進和賣出的難度不對稱\"}]}],[\"$\",\"li\",\"sec-4\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-4\",\"children\":\"四、漲跌停鎖死是流動性歸零\"}]}],[\"$\",\"li\",\"sec-5\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-5\",\"children\":\"五、低流動性標的還有兩個附帶問題\"}]}],[\"$\",\"li\",\"sec-6\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-6\",\"children\":\"六、實務上的檢查\"}]}],[\"$\",\"li\",\"sec-7\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-7\",\"children\":\"七、為什麼今天的成交量不能單獨看\"}]}],[\"$\",\"li\",\"sec-8\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-8\",\"children\":\"常見問題 FAQ\"}]}],[\"$\",\"li\",\"sec-9\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-9\",\"children\":\"總結\"}]}],[\"$\",\"li\",\"sec-10\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-10\",\"children\":\"延伸閱讀\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"LearnArticle_body__6B7Mb\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_intro__ATV5c\",\"children\":\"研究一檔股票時，多數人問的是「它會不會漲」。但有個問題應該先問：如果我想出場，賣得掉嗎。這個問題在順利的時候完全不重要，在需要它的時候則決定一切。\"}],[[\"$\",\"figure\",\"figure-0\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"沒扣成本的勝率，看起來都會比較漂亮0.029%手續費 1 折來回0.15%當沖證交稅0.06%滑價估計三項合計約 0.24%；留倉稅率更高，約 0.39%\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"示意圖｜當沖來回成本：1 折手續費 + 證交稅 + 滑價（教學結構，不是某檔實盤）\"}]]}]],[\"$\",\"div\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"能買進不代表能賣出\"}],[\"$\",\"li\",\"1\",{\"children\":\"胃納量要算「部位佔日均量的比例」，而且風險是非線性的——超過一定程度後出場成本會突然惡化\"}],[\"$\",\"li\",\"2\",{\"children\":\"最需要流動性的時候通常流動性最差\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、胃納量是什麼\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"胃納量指的是這檔股票能承受多大的進出而不明顯影響價格。它跟成交量相關但不完全等同——成交量是已經發生的量，胃納量是「你的部位相對於那個量的比例」。同樣的成交量，對不同規模的資金意義完全不同。實務上最簡單的估法是把你的部位除以日均量，看佔幾成。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"成交量是已發生的量\"}],[\"$\",\"li\",\"1\",{\"children\":\"胃納量是你的部位相對於它的比例\"}],[\"$\",\"li\",\"2\",{\"children\":\"同樣成交量對不同規模意義不同\"}]]}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、風險是非線性的\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"這是最重要的一點：流動性下降時，出場成本不是線性上升，而是在某個程度之後突然惡化。原因是委託簿有厚度限制，賣壓超過一定量就會直接吃穿好幾檔。所以「稍微冷門一點」和「非常冷門」的差別，不是稍微難賣和比較難賣，而是可以賣和賣不掉。\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"部位佔日均量\"}],[\"$\",\"th\",\"1\",{\"children\":\"順利時\"}],[\"$\",\"th\",\"2\",{\"children\":\"需要快速出場時\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"低於百分之一\"}],[\"$\",\"td\",\"1\",{\"children\":\"幾乎無影響\"}],[\"$\",\"td\",\"2\",{\"children\":\"通常仍可承受\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"百分之幾\"}],[\"$\",\"td\",\"1\",{\"children\":\"略有滑價\"}],[\"$\",\"td\",\"2\",{\"children\":\"滑價明顯放大\"}]]}],[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"超過一成\"}],[\"$\",\"td\",\"1\",{\"children\":\"進出就會推動價格\"}],[\"$\",\"td\",\"2\",{\"children\":\"可能需要數日才出得完\"}]]}],[\"$\",\"tr\",\"3\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"漲跌停鎖死\"}],[\"$\",\"td\",\"1\",{\"children\":\"看不出問題\"}],[\"$\",\"td\",\"2\",{\"children\":\"流動性接近歸零\"}]]}]]}]]}]}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、買進和賣出的難度不對稱\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"買進通常比賣出容易，因為你可以慢慢買、可以放棄不買。賣出常常是被迫的——需要現金、判斷改變、或觸及停損。也就是說，你最需要流動性的時候，往往正好是流動性最差的時候，因為那些時刻通常伴隨市場壓力。用「買得到」推論「賣得掉」是很貴的錯誤。\"}],\"$L18\"]]}],\"$L19\",\"$L1a\",\"$L1b\",\"$L1c\",\"$L1d\",\"$L1e\",\"$L1f\"],null]}]]}]}]\n18:[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"買進可以慢慢來，也可以放棄\"}],[\"$\",\"li\",\"1\",{\"children\":\"賣出常常是被迫的\"}],[\"$\",\"li\",\"2\",{\"children\":\"最需要流動性時，流動性通常最差\"}]]}]\n19:[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、漲跌停鎖死是流動性歸零\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"價格鎖在漲跌停時，理論上還有成交但實際上排隊的委託遠超過可成交量，對個別投資人來說接近無法成交。跌停鎖死的處理原則是事前決定：確認自己能承受隔日的不確定，並且部位大小要以「可能連續兩天出不掉」為前提。這不是悲觀假設，歷史上發生過很多次。\"}],[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"鎖死時排隊委託遠超可成交量\"}],[\"$\",\"li\",\"1\",{\"children\":\"事前確認能承受隔日不確定\"}],[\"$\",\"li\",\"2\",{\"children\":\"部位以「可能連兩天出不掉」為前提\"}]]}],[\"$\",\"figure\",\"2\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"!滑價放大!訊號雜訊高!價差成本高!鎖死時出不掉\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"低流動性的四個代價\"}]]}]]]}]\n1a:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、低流動性標的還有兩個附帶問題\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"第一，價格容易被少量資金推動，所以量價訊號的雜訊比很差——你看到的異常可能只是幾百張造成的。第二，買賣價差通常較大，等於每次進出多付一筆固定成本。這兩件事讓低流動性標的的研究難度和交易成本同時上升。\"}]]]}]\n1b:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"六、實務上的檢查\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"在下單前做三個檢查，成本很低但能避開多數流動性問題。本站在名單類頁面會標示成交量偏低的標的，就是為了讓這個檢查不必每次手動做。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"看近二十日平均成交量，不只看今天\"}],[\"$\",\"li\",\"1\",{\"children\":\"算你的部位佔日均量幾成\"}],[\"$\",\"li\",\"2\",{\"children\":\"看買賣價差，價差大等於固定成本高\"}],[\"$\",\"li\",\"3\",{\"children\":\"問自己：如果明天必須出清，做得到嗎\"}]]}]]]}]\n1c:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"七、為什麼今天的成交量不能單獨看\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"因為爆量常常是一次性的。某檔股票因為消息今天成交量放大十倍，不代表明天還有那個量。用爆量當天的數字評估胃納量，會嚴重高估。比較穩的做法是看近二十日平均，並且用其中較低的幾天做保守估計。\"}]]]}]\n1d:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"成交量多少才算夠？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"沒有絕對數字，要看你的部位相對於日均量的比例。同樣的成交量對不同資金規模意義完全不同，所以要算比例而不是看絕對值。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"為什麼說風險是非線性的？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"因為委託簿有厚度限制，賣壓超過一定量會直接吃穿好幾檔。所以流動性下降到某個程度後，出場成本會突然惡化，而不是平滑上升。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"跌停鎖死該怎麼處理？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"處理要在事前：部位大小以「可能連續兩天出不掉」為前提決定。鎖死當下排隊委託遠超可成交量，對個別投資人接近無法成交，臨場沒有太多選項。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"可以用今天的成交量評估嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"不建議。爆量常常是一次性的，用那天的數字會嚴重高估胃納量。比較穩的是看近二十日平均，並用其中較低的幾天做保守估計。\"}]]}]]}]]]}]\n1e:[\"$\",\"section\",\"sec-9\",{\"id\":\"sec-9\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"能買進不代表能賣出。胃納量要算「部位佔日均量的比例」，而且風險是非線性的——超過一定程度後出場成本會突然惡化。最需要流動性的時候通常流動性最差。\"}]]]}]\n1f:[\"$\",\"section\",\"sec-10\",{\"id\":\"sec-10\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L17\",\"0-台股交易成本怎麼\",{\"href\":\"/learn\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"台股交易成本怎麼算\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L17\",\"0-台股制度與名詞：\",{\"href\":\"/school\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"台股制度與名詞：台股學堂\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L17\",\"0-本站資料口徑說明\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"本站資料口徑說明：使用手冊\"}]]}]]}]]]}]\n13:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\nf:null\n20:I[80622,[],\"IconMark\"]\n11:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"流動性為什麼決定你能不能出場？胃納量的意義｜股市大佬 TradeBoss\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"研究一檔股票時，多數人問的是「它會不會漲」。但有個問題應該先問：如果我想出場，賣得掉嗎。這個問題在順利的時候完全不重要，在需要它的時候則決定一切。\"}],[\"$\",\"link\",\"2\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}],[\"$\",\"$L20\",\"3\",{}]],\"error\":null,\"digest\":\"$undefined\"}\n16:\"$11:metadata\"\n"}