"unauthorized\":\"$undefined\"}]]}]\na:[\"$\",\"$1\",\"c\",{\"children\":[\"$Ld\",[[\"$\",\"link\",\"0\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/css/3eaf36e367672966.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"$undefined\"}]],[\"$\",\"$Le\",null,{\"children\":[\"$Lf\",[\"$\",\"$L10\",null,{\"promise\":\"$@11\"}]]}]]}]\nb:[\"$\",\"$1\",\"h\",{\"children\":[null,[[\"$\",\"$L12\",null,{\"children\":\"$L13\"}],[\"$\",\"meta\",null,{\"name\":\"next-size-adjust\",\"content\":\"\"}]],[\"$\",\"$L14\",null,{\"children\":[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$15\",null,{\"fallback\":null,\"children\":\"$L16\"}]}]}]]}]\n17:I[52619,[\"2619\",\"static/chunks/2619-04bc32f026a0d946.js\",\"6309\",\"static/chunks/app/learn/%5Bslug%5D/page-f7b99344f7e2ee16.js\"],\"\"]\nd:[\"$\",\"div\",null,{\"className\":\"LearnArticle_wrap__LIQ8G\",\"children\":[\"$\",\"article\",null,{\"className\":\"LearnArticle_article__2nBbk\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_meta__etj_G\",\"children\":[[\"$\",\"$L17\",null,{\"className\":\"LearnArticle_cat__GQMlg\",\"href\":\"/learn?c=events\",\"children\":\"金融大事件\"}],[\"$\",\"span\",null,{\"className\":\"LearnArticle_read__QEj6a\",\"children\":\"閱讀約 6 分鐘\"}]]}],[\"$\",\"h1\",null,{\"className\":\"LearnArticle_title__0_la8\",\"children\":\"歐債危機當時發生什麼？為何一個國家的債務，竟會讓全球股市跟著崩盤？\"}],[\"$\",\"details\",null,{\"className\":\"LearnArticle_toc__LcSAa\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"LearnArticle_tocSummary__YBddG\",\"children\":\"本文目錄\"}],[\"$\",\"ol\",null,{\"className\":\"LearnArticle_tocList__Rq_Lz\",\"children\":[[\"$\",\"li\",\"sec-1\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-1\",\"children\":\"一、故事的開頭：大家為什麼要湊在一起用歐元？\"}]}],[\"$\",\"li\",\"sec-2\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-2\",\"children\":\"二、風暴的核心：希臘的「假帳本」是怎麼被發現的？\"}]}],[\"$\",\"li\",\"sec-3\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-3\",\"children\":\"三、骨牌效應：為什麼一個希臘倒下，會拖垮整個歐洲？\"}]}],[\"$\",\"li\",\"sec-4\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-4\",\"children\":\"四、全球恐慌：歐債危機跟台股投資人有什麼關係？\"}]}],[\"$\",\"li\",\"sec-5\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-5\",\"children\":\"五、危機的啟示：我們能從中學到什麼判斷方法？\"}]}],[\"$\",\"li\",\"sec-6\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-6\",\"children\":\"常見問題 FAQ\"}]}],[\"$\",\"li\",\"sec-7\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-7\",\"children\":\"總結\"}]}],[\"$\",\"li\",\"sec-8\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-8\",\"children\":\"延伸閱讀\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"LearnArticle_body__6B7Mb\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_intro__ATV5c\",\"children\":\"新聞常提到「歐債危機」，好像是很久以前的事，但每次歐洲一有風吹草動，這個詞又會被拿出來。究竟當年發生了什麼，為什麼一個國家的債務問題，會搞到全球股市都跟著重挫？這篇文章會用白話文帶你搞懂來龍去脈。\"}],[],[\"$\",\"div\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"歐債危機起因是部分歐元區國家（如希臘）財政紀律差，靠做假帳才成功加入歐元區。\"}],[\"$\",\"li\",\"1\",{\"children\":\"使用歐元讓這些國家無法用「貨幣貶值」救出口，只能靠借貸度日，導致債務越滾越大。\"}],[\"$\",\"li\",\"2\",{\"children\":\"危機核心是「信心崩盤」，市場擔心這些國家會還不出錢，引發骨牌效應，衝擊全球金融。\"}],[\"$\",\"li\",\"3\",{\"children\":\"對台股投資人啟示：國際重大事件會影響台股，分散風險、關注全球資金流向很重要。\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、故事的開頭：大家為什麼要湊在一起用歐元？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"在聊危機之前，要先知道「歐元區」是怎麼來的。簡單說，歐洲各國為了讓彼此做生意更方便、更有力量跟美國抗衡，決定成立一個經濟聯盟，使用統一的貨幣「歐元」。為了確保這個聯盟體質健康，他們訂了嚴格的「入會標準」，要求想加入的國家必須是財政模範生，例如政府負債不能太高、預算赤字要控制在一定範圍內。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"政府負債佔 GDP 不超過 60%\"}],[\"$\",\"li\",\"1\",{\"children\":\"年度預算赤字佔 GDP 不超過 3%\"}],[\"$\",\"li\",\"2\",{\"children\":\"維持低通膨與穩定的匯率\"}]]}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、風暴的核心：希臘的「假帳本」是怎麼被發現的？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"理想很美好，但現實是，有些國家的體質根本不及格，例如希臘。為了搭上歐元這班列車，他們找了華爾街的金融機構幫忙，用複雜的金融手法「美化」帳本，把超標的債務藏起來，看起來就像個符合資格的模範生。這顆未爆彈一直埋著，直到 2008 年全球金融海嘯爆發，各國經濟都受到重創，希臘政府發現錢不夠用，再也藏不住了，才在 2009 年底承認過去的財報都是假的，實際的赤字與負債遠高於公布的數字。\"}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、骨牌效應：為什麼一個希臘倒下，會拖垮整個歐洲？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"一個國家做假帳，為什麼會搞得這麼嚴重？問題就出在「歐元」這個統一貨幣。過去如果國家經濟不好，可以讓自己的貨幣貶值，東西賣得便宜一點來救出口。但加入歐元區後，希臘不能自己印鈔票或決定匯率，失去了這個最重要的工具。更糟的是，當時很多德國、法國的大銀行都買了大量希臘的政府公債，一旦希臘宣布還不出錢（也就是違約），這些銀行就會倒大楣，進而引發全歐洲的金融連鎖風暴。市場開始擔心，下一個會不會是葡萄牙、愛爾蘭、西班牙？這就是所謂的「歐豬五國（PIIGS）」危機。\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"應對方式\"}],[\"$\",\"th\",\"1\",{\"children\":\"有自己貨幣的國家 (例：英國)\"}],[\"$\",\"th\",\"2\",{\"children\":\"歐元區國家 (例：希臘)\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"經濟衰退時\"}],[\"$\",\"td\",\"1\",{\"children\":\"可讓貨幣貶值，刺激出口\"}],[\"$\",\"td\",\"2\",{\"children\":\"不行，貨幣政策由歐洲央行統一決定\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"政府缺錢時\"}],[\"$\",\"td\",\"1\",{\"children\":\"可自己印鈔 (有通膨風險)\"}],\"$L18\"]}],\"$L19\"]}]]}]}],\"$L1a\"]]}],\"$L1b\",\"$L1c\",\"$L1d\",\"$L1e\",\"$L1f\"],null]}]]}]}]\n18:[\"$\",\"td\",\"2\",{\"children\":\"不行，不能自己印歐元\"}]\n19:[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"最終解決方案\"}],[\"$\",\"td\",\"1\",{\"children\":\"財政與貨幣政策雙管齊下\"}],[\"$\",\"td\",\"2\",{\"children\":\"只能靠借貸或尋求外部援助\"}]]}]\n1a:[\"$\",\"figure\",\"2\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"✓關注國際總經新聞✓資產要分散不同區域✓理解全球資金流動方向\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"從危機中學到的 3 個教訓\"}]]}]\n1b:[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、全球恐慌：歐債危機跟台股投資人有什麼關係？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"歐洲的火，很快就燒到全世界。當一個主要經濟體出現危機時，全球的投資人會因為害怕而變得非常保守，這個現象叫做「避險情緒升高」。他們會把錢從風險較高的地方抽走，例如股市，尤其是台灣這種新興市場的股市，然後把錢投到他們認為最安全的地方，例如美國政府公債。所以，即使台灣的公司基本面很好，但外資大量賣出持股把錢匯走，台股指數一樣會跟著大跌。這就是為什麼歐債危機期間，全球股市一片慘綠的原因。\"}]]]}]\n1c:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、危機的啟示：我們能從中學到什麼判斷方法？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"這段歷史給我們最大的啟示，就是「雞蛋不能放在同一個籃子裡」，而且這個籃子不只包含不同產業，還包含不同國家區域。即使你只投資台股，也要養成關心國際總經新聞的習慣。當你看到某個區域的風險升高時，可以留意一個指標叫「主權信用違約交換（CDS）」，可以把它想成是「國家的倒債保險費」，這個數字飆高，就代表市場認為該國還不出錢的風險大增，可能是個警訊。\"}]]]}]\n1d:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"歐債危機結束了嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"算是暫時被控制住了，但病根還在。歐洲央行透過大規模購債計畫穩住了市場，但部分國家高負債、低成長的根本問題並未完全解決，未來若經濟環境惡化，仍有復發風險。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"為什麼德國當時不願意直接幫希臘還錢？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"這不只是錢的問題，更是「道德風險」。如果輕易出手相救，其他國家可能會覺得「反正亂花錢最後會有大國買單」，導致大家都不遵守財政紀律，問題反而會更嚴重。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"新聞上說的「撙節政策」是什麼？為什麼會引發抗議？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"「撙節」就是省吃儉用，要求危機國家的政府減少公共支出（如削減公務員薪水、福利）並增加稅收來還債。這會讓民眾生活變得很痛苦、經濟更蕭條，所以常常引發大規模的街頭抗議。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"現在還需要擔心歐債問題嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"需要保持關注。雖然不像當年那麼緊急，但義大利等國的債務水平依然很高。未來如果全球經濟再次衰退或利率大幅上升，這些國家的還債壓力就會變大，可能再次成為市場的黑天鵝。\"}]]}]]}]]]}]\n1e:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"歐債危機的核心教訓是：在全球化的金融市場，沒有人是孤島。一個國家的財政問題，可以透過信心崩盤與資金流竄，演變成全球性的股災。因此，即使只投資台股，也要養成關注國際總經的習慣。\"}]]]}]\n1f:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L17\",\"0-學習更多財經名詞\",{\"href\":\"/school\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"學習更多財經名詞\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L17\",\"0-看看現在全球市場\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"看看現在全球市場情緒\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L17\",\"0-了解更多投資觀念\",{\"href\":\"/learn\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"了解更多投資觀念\"}]]}]]}]]]}]\n13:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\nf:null\n20:I[80622,[],\"IconMark\"]\n11:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"歐債危機當時發生什麼？為何一個國家的債務，竟會讓全球股市跟著崩盤？｜股市大佬 TradeBoss\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"新聞常提到「歐債危機」，好像是很久以前的事，但每次歐洲一有風吹草動，這個詞又會被拿出來。究竟當年發生了什麼，為什麼一個國家的債務問題，會搞到全球股市都跟著重挫？這篇文章會用白話文帶你搞懂來龍去脈。\"}],[\"$\",\"link\",\"2\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}],[\"$\",\"$L20\",\"3\",{}]],\"error\":null,\"digest\":\"$undefined\"}\n16:\"$11:metadata\"\n"}