e\",null,{\"className\":\"LearnArticle_article__2nBbk\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_meta__etj_G\",\"children\":[[\"$\",\"$L17\",null,{\"className\":\"LearnArticle_cat__GQMlg\",\"href\":\"/learn?c=trends\",\"children\":\"產業與趨勢\"}],[\"$\",\"span\",null,{\"className\":\"LearnArticle_read__QEj6a\",\"children\":\"閱讀約 6 分鐘\"}]]}],[\"$\",\"h1\",null,{\"className\":\"LearnArticle_title__0_la8\",\"children\":\"產業龍頭與二線股差在哪？3 個關鍵數字教你分辨\"}],[\"$\",\"details\",null,{\"className\":\"LearnArticle_toc__LcSAa\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"LearnArticle_tocSummary__YBddG\",\"children\":\"本文目錄\"}],[\"$\",\"ol\",null,{\"className\":\"LearnArticle_tocList__Rq_Lz\",\"children\":[[\"$\",\"li\",\"sec-1\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-1\",\"children\":\"一、為什麼要分龍頭股和二線股？不都一樣漲嗎？\"}]}],[\"$\",\"li\",\"sec-2\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-2\",\"children\":\"二、指標一：市值與股本，誰是市場的「大船」？\"}]}],[\"$\",\"li\",\"sec-3\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-3\",\"children\":\"三、指標二：獲利能力與市佔率，誰真的在賺錢？\"}]}],[\"$\",\"li\",\"sec-4\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-4\",\"children\":\"四、指標三：法人籌碼動向，大資金怎麼選？\"}]}],[\"$\",\"li\",\"sec-5\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-5\",\"children\":\"五、龍頭與二線股的輪動關係是什麼？\"}]}],[\"$\",\"li\",\"sec-6\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-6\",\"children\":\"常見問題 FAQ\"}]}],[\"$\",\"li\",\"sec-7\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-7\",\"children\":\"總結\"}]}],[\"$\",\"li\",\"sec-8\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-8\",\"children\":\"延伸閱讀\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"LearnArticle_body__6B7Mb\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_intro__ATV5c\",\"children\":\"同一個題材發酵，為什麼有些股票漲得穩、抱得久，有些卻是暴漲暴跌，一不小心就套在山頂？這很可能就是「龍頭股」和「二線股」的差別。這篇文章會帶你用 3 個具體指標，看懂兩者差異，幫你在題材輪動時，做出更適合自己的判斷。\"}],[],[\"$\",\"div\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"龍頭股通常市值大、獲利穩定，是法人長期佈局首選。\"}],[\"$\",\"li\",\"1\",{\"children\":\"二線股股本較小、股性活潑，題材發動時漲幅可能更驚人。\"}],[\"$\",\"li\",\"2\",{\"children\":\"判斷龍頭不只看股價高低，更要看市佔率與技術領先地位。\"}],[\"$\",\"li\",\"3\",{\"children\":\"資金輪動時，常由龍頭股先發動，再擴散到二線、三線股。\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、為什麼要分龍頭股和二線股？不都一樣漲嗎？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"很多人以為只要題材對了，買誰都沒差，這其實是個常見誤解。龍頭股和二線股的「體質」和「股性」完全不同，這會直接影響到股價的穩定度和上漲的續航力。搞懂差異，才能避免在市場波動時，因為選錯標的而承受不必要的風險。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"風險承受度不同：龍頭股相對穩健，適合穩健型投資人。\"}],[\"$\",\"li\",\"1\",{\"children\":\"資金門檻不同：龍頭股價位通常較高，二線股相對親民。\"}],[\"$\",\"li\",\"2\",{\"children\":\"期望報酬不同：想賺取波段價差，二線股機會較多；想長期持有，龍頭股較安心。\"}]]}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、指標一：市值與股本，誰是市場的「大船」？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"最直觀的區分方式就是看「市值」，也就是公司在市場上的總價值（市值 = 股價 × 在外流通股數）。龍頭股通常是千億市值起跳的大型企業，像航母一樣穩定；二線股則像快艇，靈活但顛簸。一般來說，市值超過 1000 億台幣，就具備了龍頭股的規模門檻。\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"特性\"}],[\"$\",\"th\",\"1\",{\"children\":\"龍頭股\"}],[\"$\",\"th\",\"2\",{\"children\":\"二線股\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"市值規模\"}],[\"$\",\"td\",\"1\",{\"children\":\"通常 > 1000 億台幣\"}],[\"$\",\"td\",\"2\",{\"children\":\"通常 < 500 億台幣\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"股本大小\"}],[\"$\",\"td\",\"1\",{\"children\":\"股本較大，籌碼分散\"}],[\"$\",\"td\",\"2\",{\"children\":\"股本較小，籌碼集中\"}]]}],[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"股價穩定性\"}],[\"$\",\"td\",\"1\",{\"children\":\"較高，不易暴漲暴跌\"}],[\"$\",\"td\",\"2\",{\"children\":\"較低，波動劇烈\"}]]}],[\"$\",\"tr\",\"3\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"法人關注度\"}],[\"$\",\"td\",\"1\",{\"children\":\"長期研究、重點持股\"}],[\"$\",\"td\",\"2\",{\"children\":\"題材發動時才受關注\"}]]}]]}]]}]}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、指標二：獲利能力與市佔率，誰真的在賺錢？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"股價短期是投票機，長期是體重計。一間公司是不是龍頭，最終要看它是不是真的能穩定獲利，以及在產業中的地位。你可以從財報中的「毛利率」和「營業利益率」來看獲利能力，並從公開資訊了解它的「市佔率」。龍頭企業通常有著難以撼動的護城河，例如技術專利或品牌價值。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"舉例來說：假設 A、B 兩家都是 AI 伺服器概念股。A 公司毛利率 30%、市佔率全球前三；B 公司毛利率 15%、市佔率不高但搭上題材。當市場回歸冷靜，資金會更青睞體質好的 A 公司。\"}]]}],\"$L18\"]]}],\"$L19\",\"$L1a\",\"$L1b\",\"$L1c\",\"$L1d\"],null]}]]}]}]\n18:[\"$\",\"figure\",\"2\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"1龍頭股先發動2資金擴散二線股3題材全面發酵4熱度退潮回檔\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"資金輪動 4 階段\"}]]}]\n19:[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、指標三：法人籌碼動向，大資金怎麼選？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"外資、投信這些「法人」資金龐大，他們的買賣動向是重要的參考指標。打開籌碼分點，你可以觀察到法人通常會長期、穩定地買進龍頭股，作為核心持股。而對於二線股，法人可能只在題材熱絡時做短線波段，買賣速度快。當你看到一檔股票的「外資持股比例」長期維持在 30% 以上，它很可能就是該產業的龍頭之一。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"判斷門檻：外資持股比例長期 > 30%\"}],[\"$\",\"li\",\"1\",{\"children\":\"觀察重點：投信近一個月是連續買超還是賣超\"}],[\"$\",\"li\",\"2\",{\"children\":\"常見錯誤：只看一天的主力進出就判斷方向，應拉長時間看趨勢。\"}]]}]]]}]\n1a:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、龍頭與二線股的輪動關係是什麼？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"在一個大的產業趨勢中，資金通常會先湧入最指標性的「龍頭股」，帶動整個族群的關注度。當龍頭股漲到一定程度、位階變高後，尋求更高報酬的資金就會開始尋找位階較低、股本較小的「二線股」。這就是所謂的「輪動」。理解這個節奏，可以幫助你判斷現在市場處於哪個階段。\"}],[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"龍頭發動期：產業龍頭率先上漲，確立趨勢。\"}],[\"$\",\"li\",\"1\",{\"children\":\"擴散期：資金外溢到體質好的二線績優股。\"}],[\"$\",\"li\",\"2\",{\"children\":\"投機期：題材最熱時，連虧錢的相關概念股都可能上漲。\"}],[\"$\",\"li\",\"3\",{\"children\":\"退潮期：龍頭股開始盤整或回檔，二線股跌幅通常更重。\"}]]}]]]}]\n1b:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"股價最高的就一定是龍頭股嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"不一定。股價高低跟公司市值、股本大小有關。有些公司股本小，股價可能很高但總市值不大。判斷龍頭應以「市值」和「產業市佔率」為主要依據，而非單純的股價數字。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"買二線股是不是比較容易賺到大波段？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"二線股因為股本小、籌碼輕，題材發酵時確實漲幅可能更驚人，但相對地，回檔修正時的跌幅也更重。這需要更高的風險承受能力，以及更嚴格的停損紀律。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"新手是不是應該只買龍頭股？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"對於剛入門、還不熟悉市場波動的投資人來說，從研究產業龍頭股開始是相對穩健的作法。因為龍頭股的資訊透明度高、財報穩定，較容易理解與分析，有助於建立正確的投資觀念。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"如何查詢一間公司的市值和市佔率？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"公司市值可以在各大看盤軟體或財經網站的個股基本資料中找到。市佔率則需要透過公司的法說會簡報、年報，或是產業研究報告來了解，這些資訊通常在網路上都能搜尋到。\"}]]}]]}]]]}]\n1c:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"總結來說，分辨龍頭股與二線股的核心在於「規模」與「體質」。優先選擇你看得懂的產業，從中找出市值最大、獲利最穩的龍頭，再觀察同族群的二線股，建立自己的觀察名單。這樣不論市場如何輪動，你都能清楚自己的選擇依據，而不是盲目追逐市場熱點。\"}]]]}]\n1d:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L17\",\"0-想知道更多產業分\",{\"href\":\"/school\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"想知道更多產業分類？來台股學堂看看\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L17\",\"0-用族群透視功能，\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"用族群透視功能，找出同題材的股票\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L17\",\"0-查詢個股市值與法\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"查詢個股市值與法人動向\"}]]}]]}]]]}]\n13:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\nf:null\n1e:I[80622,[],\"IconMark\"]\n11:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"產業龍頭與二線股差在哪？3 個關鍵數字教你分辨｜股市大佬 TradeBoss\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"同一個題材發酵，為什麼有些股票漲得穩、抱得久，有些卻是暴漲暴跌，一不小心就套在山頂？這很可能就是「龍頭股」和「二線股」的差別。這篇文章會帶你用 3 個具體指標，看懂兩者差異，幫你在題材輪動時，做出更適合自己的判斷。\"}],[\"$\",\"link\",\"2\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}],[\"$\",\"$L1e\",\"3\",{}]],\"error\":null,\"digest\":\"$undefined\"}\n16:\"$11:metadata\"\n"}