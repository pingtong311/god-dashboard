\"static/chunks/app/learn/%5Bslug%5D/page-f7b99344f7e2ee16.js\"],\"\"]\nd:[\"$\",\"div\",null,{\"className\":\"LearnArticle_wrap__LIQ8G\",\"children\":[\"$\",\"article\",null,{\"className\":\"LearnArticle_article__2nBbk\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_meta__etj_G\",\"children\":[[\"$\",\"$L17\",null,{\"className\":\"LearnArticle_cat__GQMlg\",\"href\":\"/learn?c=events\",\"children\":\"金融大事件\"}],[\"$\",\"span\",null,{\"className\":\"LearnArticle_read__QEj6a\",\"children\":\"閱讀約 7 分鐘\"}]]}],[\"$\",\"h1\",null,{\"className\":\"LearnArticle_title__0_la8\",\"children\":\"美國升息循環如何影響台股？搞懂 3 階段資金流向\"}],[\"$\",\"details\",null,{\"className\":\"LearnArticle_toc__LcSAa\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"LearnArticle_tocSummary__YBddG\",\"children\":\"本文目錄\"}],[\"$\",\"ol\",null,{\"className\":\"LearnArticle_tocList__Rq_Lz\",\"children\":[[\"$\",\"li\",\"sec-1\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-1\",\"children\":\"一、為什麼美國升息，台灣的股市會緊張？\"}]}],[\"$\",\"li\",\"sec-2\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-2\",\"children\":\"二、升息循環不是一次漲完，如何看懂三階段？\"}]}],[\"$\",\"li\",\"sec-3\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-3\",\"children\":\"三、所有股票都會跌嗎？哪些產業受衝擊最大？\"}]}],[\"$\",\"li\",\"sec-4\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-4\",\"children\":\"四、我該盯著哪些數字，判斷風向變了？\"}]}],[\"$\",\"li\",\"sec-5\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-5\",\"children\":\"五、升息循環結束後，就是進場的好時機嗎？\"}]}],[\"$\",\"li\",\"sec-6\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-6\",\"children\":\"常見問題 FAQ\"}]}],[\"$\",\"li\",\"sec-7\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-7\",\"children\":\"總結\"}]}],[\"$\",\"li\",\"sec-8\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-8\",\"children\":\"延伸閱讀\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"LearnArticle_body__6B7Mb\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_intro__ATV5c\",\"children\":\"常常聽到新聞說美國聯準會 (Fed) 又要升息，結果隔天台股就綠油油一片，但又有人說升息代表經濟好，到底該怎麼看？這篇文章就是要帶你弄懂，為什麼地球另一端的美國升息，會直接影響你手上台股的漲跌，以及在這種時期，該注意哪些訊號。\"}],[],[\"$\",\"div\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"升息讓美元變強勢，熱錢（外資）容易賣掉台股，把資金匯回美國。\"}],[\"$\",\"li\",\"1\",{\"children\":\"對未來獲利依賴高的「成長型電子股」，在升息環境下受到的估值修正壓力最大。\"}],[\"$\",\"li\",\"2\",{\"children\":\"「金融股」因為存放款利差可能擴大，通常在升息初期相對有支撐。\"}],[\"$\",\"li\",\"3\",{\"children\":\"市場通常會提前反應「預期」，聯準會開會前就可能出現波動，別等消息出來才動作。\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、為什麼美國升息，台灣的股市會緊張？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"簡單來說，錢會往「利息高」的地方跑。當美國聯準會（Fed）升息，代表把錢存在美國的銀行或買美國公債，能拿到的無風險利息變高了。這會吸引全球的資金流向美元資產，包含原本投資在台股的外資。當外資大量賣出台股、換成美元匯出，就容易造成台股下跌、台幣貶值的雙重壓力。\"}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、升息循環不是一次漲完，如何看懂三階段？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"升息不是單一事件，而是一個「循環」，就像爬樓梯一樣，會持續一段時間。我們可以把它粗略分成三個階段，每個階段市場的反應都不同。搞懂現在處於哪個階段，比只關心升息幾碼更重要。\"}],[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"預期階段：通膨數據開始升高，市場『猜測』聯準會快要升息了。這時候最敏感的成長股可能就開始修正，資金會悄悄轉向防禦型或價值型股票。\"}],[\"$\",\"li\",\"1\",{\"children\":\"執行階段：聯準會正式宣布開始升息，並且連續好幾次調高利率。這個階段對股市的衝擊最直接，市場波動會加劇，外資賣超的現象也最明顯。\"}],[\"$\",\"li\",\"2\",{\"children\":\"末端階段：通膨受到控制，聯準會暗示升息即將告一段落，甚至開始討論未來『降息』的可能性。市場會開始期待資金寬鬆，資金可能重新回流股市，為下一波行情做準備。\"}]]}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、所有股票都會跌嗎？哪些產業受衝擊最大？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"升息對不同類型的公司影響不同，不是所有股票都會一起跌。關鍵在於這家公司的「商業模式」與「財務體質」。有些公司甚至可能在升息環境中受益，了解其中的差異，才能幫助你檢視自己的持股。\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"產業類型\"}],[\"$\",\"th\",\"1\",{\"children\":\"升息影響\"}],[\"$\",\"th\",\"2\",{\"children\":\"為什麼？\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"成長型科技股\"}],[\"$\",\"td\",\"1\",{\"children\":\"負面衝擊大\"}],[\"$\",\"td\",\"2\",{\"children\":\"依賴借貸研發，資金成本變高；且估值多基於未來遙遠的獲利，利率升高會讓『現值』縮水。\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"金融股（銀行、壽險）\"}],[\"$\",\"td\",\"1\",{\"children\":\"相對有利\"}],[\"$\",\"td\",\"2\",{\"children\":\"銀行存放款利差擴大，能賺更多利息收入。壽險業的投資收益壓力也能減輕。\"}]]}],[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"高負債的傳產股\"}],[\"$\",\"td\",\"1\",{\"children\":\"負面衝擊\"}],[\"$\",\"td\",\"2\",{\"children\":\"需要大量資金蓋廠房、買設備的公司，利息支出會增加，侵蝕獲利。\"}]]}],\"$L18\"]}]]}]}],\"$L19\"]]}],\"$L1a\",\"$L1b\",\"$L1c\",\"$L1d\",\"$L1e\"],null]}]]}]}]\n18:[\"$\",\"tr\",\"3\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"內需、民生消費股\"}],[\"$\",\"td\",\"1\",{\"children\":\"影響相對小\"}],[\"$\",\"td\",\"2\",{\"children\":\"不管景氣好壞，大家都要吃飯、購物。這類公司獲利相對穩定，較不受國際資金流動影響。\"}]]}]\n19:[\"$\",\"figure\",\"2\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"📊外資賣超台股📈資金流向美元資產🧭台幣趨向貶值📘高本益比股壓力大\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"升息下的資金流向\"}]]}]\n1a:[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、我該盯著哪些數字，判斷風向變了？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"與其每天猜測股市漲跌，不如學會看懂幾個關鍵的經濟數據。這些數字是聯準會制定貨幣政策的重要依據，也是全球投資人都在關注的焦點。當這些數字出現轉變，往往預示著市場風向的變化。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"美國消費者物價指數 (CPI)：這是衡量通膨的核心指標。CPI 數字居高不下，聯準會升息的壓力就越大；反之，若 CPI 明顯降溫，市場就會開始期待停止升息。\"}],[\"$\",\"li\",\"1\",{\"children\":\"聯準會 (Fed) 會議紀錄：每年有八次利率決策會議。除了當下的決議，會後聲明稿與主席的發言，藏著未來政策走向的線索，市場會從中解讀「鷹派」（傾向緊縮）或「鴿派」（傾向寬鬆）的態度。\"}],[\"$\",\"li\",\"2\",{\"children\":\"外資買賣超與台幣匯率：這是最直接的資金流向指標。如果觀察到外資連續性地大賣台股，同時台幣匯率持續走貶，就代表資金正在撤出，需要提高警覺。\"}]]}]]]}]\n1b:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、升息循環結束後，就是進場的好時機嗎？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"歷史經驗告訴我們，股市通常會「領先反應」。當市場普遍預期升息循環即將結束，或甚至要轉為降息時，就算經濟數據還不好看，股市也可能提前半年就開始反彈。因此，重點不是等到『確認』降息才動作，而是觀察升息力道是否減弱，以及市場是否不再對壞消息感到恐慌。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"一個判斷方法是，當聯準會的升息幅度從每次三碼（0.75%）降到兩碼（0.5%），再降到一碼（0.25%），就代表緊縮力道正在減弱，市場的壓力也會隨之減輕。\"}]]}]]]}]\n1c:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"升息台股就一定會跌嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"不一定。如果市場早已預期到升息的幅度和時間，股價可能已經提前反應（price-in）。有時候，若升息代表經濟強勁，反而可能在短期內激勵市場。但整體而言，升息會對股市估值形成壓力。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"升息對我存了好幾年的高股息 ETF 有什麼影響？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"升息時，債券的殖利率會升高，這會讓高股息股票的吸引力『相對』下降一些。但因為高股息股票通常是體質穩健的成熟公司，它們的防禦性會比大起大落的成長股好，因此仍是資金避風港的選項之一。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"我該因為美國升息，就把手上的電子股全部賣掉嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"不需要恐慌性地清空持股。比較好的做法是「檢視」而非「拋售」。你可以檢查手上的電子股是否負債比過高、未來展望是否明確，並考慮適度降低估值過高、尚未獲利的公司比重，轉移到體質更穩健的標的。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"新聞說的「暴力升息」是什麼意思？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"這指的是聯準會為了快速抑制嚴重的通貨膨脹，採取比平常更激進的升息幅度。一般來說，一次升息一碼（0.25%）是標準，若一次升息兩碼（0.5%）甚至三碼（0.75%），就會被市場稱為「暴力升息」，對股市的衝擊也更大。\"}]]}]]}]]]}]\n1d:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"總結來說，面對美國升息循環，散戶投資人應將焦點從「追求短期漲幅」轉為「檢視持股體質」。理解資金流動的大方向，並適時調整高估值成長股與穩健價值股的比例，會比猜測單日漲跌來得更踏實。\"}]]]}]\n1e:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L17\",\"0-大盤資金流向怎麼\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"大盤資金流向怎麼看？\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L17\",\"0-什麼是本益比？如\",{\"href\":\"/s/2330\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"什麼是本益比？如何判斷估值高低\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L17\",\"0-更多台股名詞解釋\",{\"href\":\"/school\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"更多台股名詞解釋，都在台股學堂\"}]]}]]}]]]}]\n13:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\nf:null\n1f:I[80622,[],\"IconMark\"]\n11:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"美國升息循環如何影響台股？搞懂 3 階段資金流向｜股市大佬 TradeBoss\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"常常聽到新聞說美國聯準會 (Fed) 又要升息，結果隔天台股就綠油油一片，但又有人說升息代表經濟好，到底該怎麼看？這篇文章就是要帶你弄懂，為什麼地球另一端的美國升息，會直接影響你手上台股的漲跌，以及在這種時期，該注意哪些訊號。\"}],[\"$\",\"link\",\"2\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}],[\"$\",\"$L1f\",\"3\",{}]],\"error\":null,\"digest\":\"$undefined\"}\n16:\"$11:metadata\"\n"}