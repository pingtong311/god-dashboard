\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"原意是量速度與位置，不是給反向指令\"}],[\"$\",\"li\",\"1\",{\"children\":\"固定門檻是習慣，不是物理定律\"}],[\"$\",\"li\",\"2\",{\"children\":\"發明者自己也強調要配合市況，不能單獨使用\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、一把尺被做成紅綠燈\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"公開計算看的是上漲日與下跌日的相對力道。數字高是偏強，低是偏弱。後來的教學為了好記，加上固定門檻與反向動作。好記的代價是：趨勢市裡燈會一直亮，你會一直想做相反的事。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"高是偏強\"}],[\"$\",\"li\",\"1\",{\"children\":\"低是偏弱\"}],[\"$\",\"li\",\"2\",{\"children\":\"反向是後人加的口訣\"}]]}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、三個原意\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"第一，給一段時間一個可比較的速度。第二，讓不同股票的速度能放在同一把尺上討論。第三，提醒你「已經偏了」，不是命令你反向。第三個最常被拿掉。\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"口訣\"}],[\"$\",\"th\",\"1\",{\"children\":\"原意較接近\"}],[\"$\",\"th\",\"2\",{\"children\":\"趨勢市會怎樣\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"七十賣\"}],[\"$\",\"td\",\"1\",{\"children\":\"偏強提醒\"}],[\"$\",\"td\",\"2\",{\"children\":\"強可以很久\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"三十買\"}],[\"$\",\"td\",\"1\",{\"children\":\"偏弱提醒\"}],[\"$\",\"td\",\"2\",{\"children\":\"弱可以很久\"}]]}],[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"背離必轉\"}],[\"$\",\"td\",\"1\",{\"children\":\"速度不一致\"}],[\"$\",\"td\",\"2\",{\"children\":\"可以維持很久\"}]]}],[\"$\",\"tr\",\"3\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"參數永恆\"}],[\"$\",\"td\",\"1\",{\"children\":\"十四是習慣\"}],[\"$\",\"td\",\"2\",{\"children\":\"換週期意義就變\"}]]}]]}]]}]}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、發明者傳統裡的「配合」\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"同一批公開材料也常把指標放在一套流程裡，而不是單獨按鈴。單獨按鈴是傳播需要。流程裡還有市況、風險與離開。少了這些，指標只是玩具。\"}],[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"先分市況\"}],[\"$\",\"li\",\"1\",{\"children\":\"再決定尺有沒有發言權\"}],[\"$\",\"li\",\"2\",{\"children\":\"最後才看數字\"}]]}],[\"$\",\"figure\",\"2\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[\"$L18\",\"$L19\"]}]]]}],\"$L1a\",\"$L1b\",\"$L1c\",\"$L1d\",\"$L1e\"],\"$L1f\"]}]]}]}]\n18:[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"✓量速度✓可比較✓提醒不是命令\"}]\n19:[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"原意\"}]\n1a:[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、為什麼人物文還要再寫一次\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"機制文講失效。人物文講：口訣化是怎麼背叛原意的。以後看到任何以人名命名的指標，先問原意是尺還是鈴。大多數是尺。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"人名指標多半是尺\"}],[\"$\",\"li\",\"1\",{\"children\":\"鈴是後人裝的\"}],[\"$\",\"li\",\"2\",{\"children\":\"先拆口訣再讀數字\"}]]}]]]}]\n1b:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、最小動作\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"把你現在用的門檻寫成：這是習慣，趨勢市我不採用反向。寫不下去，就還在用紅綠燈。\"}]]]}]\n1c:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"發明人自己怎麼用門檻？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"公開材料強調配合，不是單獨按鈴。後人口訣不能代表原意全部。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"要不要改門檻？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"改了只是換敏感度。先寫何時不採用，比改數字重要。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"和其他威爾德指標呢？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"同一原則：先當尺，再問有沒有被做成鈴。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"和布林那篇有何相似？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"都是把「收斂／偏強」誤讀成即將發生的方向。\"}]]}]]}]]]}]\n1d:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"威爾德提出相對強弱是為了量偏強偏弱。七十賣三十買是後人口訣。趨勢市裡燈會一直亮。先當尺，再當鈴。\"}]]]}]\n1e:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"Le