[\"$\",\"a\",null,{\"href\":\"#sec-3\",\"children\":\"三、個股焦點：多檔電子股漲停，部分傳產股表現疲軟\"}]}],[\"$\",\"li\",\"sec-4\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-4\",\"children\":\"四、法人動向與籌碼：外資現貨買超，台指期淨空單仍高\"}]}],[\"$\",\"li\",\"sec-5\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-5\",\"children\":\"五、國際盤與市場消息：美股上揚，亞洲股市普遍走高\"}]}],[\"$\",\"li\",\"sec-6\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-6\",\"children\":\"常見問題 FAQ\"}]}],[\"$\",\"li\",\"sec-7\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-7\",\"children\":\"總結\"}]}],[\"$\",\"li\",\"sec-8\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-8\",\"children\":\"延伸閱讀\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"LearnArticle_body__6B7Mb\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_intro__ATV5c\",\"children\":\"今天（8月14日）台股大盤呈現上漲格局，加權指數收盤站上46021.48點，整體市場氣氛偏向積極。盤面重點集中在部分電子類股的表現，帶動指數向上。\"}],[[\"$\",\"figure\",\"figure-0\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"越後面越熱鬧，通常也越貴、越好離開佈局沒新聞命名故事出現擁擠人人都知退燒利多變鈍新聞出現時，常常已經不是第一段\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"示意圖｜題材四階段：佈局 → 命名 → 擁擠 → 退燒（教學結構，不是某檔實盤）\"}]]}]],[\"$\",\"div\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"今日台股大盤在國際股市普遍上揚的氣氛下，加權指數與櫃買指數雙雙收紅，電子類股表現尤其亮眼，整體市場呈現偏多格局\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、大盤總覽：指數齊揚，成交金額破兆\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"今日台灣股市主要指數均錄得漲幅。加權指數（衡量上市股票整體表現的指標）上漲1.10%，收在46021.48點；櫃買指數（衡量上櫃股票整體表現的指標）也上漲1.01%，收在406.12點。整體上市股票有423家上漲，505家下跌，平均漲跌幅為+0.13%，總成交金額達到約10237.0億元。\"}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、族群表現：電子類股領漲，造紙與居家生活類股偏弱\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"今日盤面強勢族群主要集中在電子相關產業。其中，「其他電子類」上漲1.03%，由萬潤（6187）領漲；「ETF」上漲0.89%，富邦科技（0052）表現突出；「綠能環保」上漲0.88%，山林水（8473）漲幅居前；「電子零組件業」上漲0.82%，宏致（3605）為領漲個股。相對地，造紙工業、居家生活、運動休閒等類股則呈現下跌。\"}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、個股焦點：多檔電子股漲停，部分傳產股表現疲軟\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"在個股表現方面，今日上市漲幅榜上有多檔電子股表現強勁，包括宏致（3605）、華碩（2357）、國巨（2327）、奇鋐（3017）、麗臺（2465）、台勝科（3532）等，漲幅接近或達到10%。跌幅榜上則有嘉澤（3533）、美利達（9914）、太空梭（2440）等個股跌幅較大。此外，聚賢研發、安葆、信昌電等個股今日當沖成交量比相對較高，顯示交易熱絡。\"}],[\"$\",\"figure\",\"1\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"1國際股市走向2法人籌碼變化3熱門族群動態4重要新聞發酵\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"盤後觀察重點\"}]]}]]]}],[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、法人動向與籌碼：外資現貨買超，台指期淨空單仍高\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"法人買賣超方面，外資今日現貨買超約501,705張，自營商現貨買超約717,754張。在期貨市場，台指期貨收盤上漲0.94%，未平倉量為92571口，其中外資在台指期淨空單為86,249口。全市場融資維持率（衡量投資人融資部位風險的指標）為194.7%，顯示整體市場融資壓力尚在合理範圍。\"}],\"$L18\"]]}],\"$L19\",\"$L1a\",\"$L1b\",\"$L1c\"],null]}]]}]}]\n18:[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"項目\"}],[\"$\",\"th\",\"1\",{\"children\":\"今日數據\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"加權指數漲跌幅\"}],[\"$\",\"td\",\"1\",{\"children\":\"+1.10%\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"櫃買指數漲跌幅\"}],[\"$\",\"td\",\"1\",{\"children\":\"+1.01%\"}]]}],[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"上市成交金額\"}],[\"$\",\"td\",\"1\",{\"children\":\"10237.0 億元\"}]]}],[\"$\",\"tr\",\"3\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"外資現貨買賣超\"}],[\"$\",\"td\",\"1\",{\"children\":\"約 501,705 張\"}]]}],[\"$\",\"tr\",\"4\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"自營商現貨買賣超\"}],[\"$\",\"td\",\"1\",{\"children\":\"約 717,754 張\"}]]}],[\"$\",\"tr\",\"5\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"外資台指期淨空單\"}],[\"$\",\"td\",\"1\",{\"children\":\"86,249 口\"}]]}],[\"$\",\"tr\",\"6\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"全市場融資維持率\"}],[\"$\",\"td\",\"1\",{\"children\":\"194.7%\"}]]}]]}]]}]}]\n19:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、國際盤與市場消息：美股上揚，亞洲股市普遍走高\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"國際股市方面，昨日美股主要指數均呈現上漲，其中S&P 500指數上漲0.58%，那斯達克指數上漲0.74%，費城半導體指數更是上漲1.84%。亞洲股市今日也普遍走高，韓國綜合指數（KOSPI）大漲3.68%，日經225指數上漲0.83%。近期市場消息方面，有關於個股財報與營運展望的公告，以及MSCI指數調整的相關報導。此外，關於美國前總統川普運用AI打擊中國規避關稅行為和獲得新的關稅武器對俄羅斯的報導也持續受到關注。\"}]]]}]\n1a:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"今天台股大盤表現如何？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"今天台股加權指數上漲1.10%，收在46021.48點；櫃買指數也上漲1.01%，收在406.12點。整體上市股票有423家上漲，505家下跌，成交金額約10237.0億元。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"哪些產業今天表現比較好？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"今日表現偏強的族群包括其他電子類、ETF、綠能環保以及電子零組件業。其中，其他電子類上漲1.03%，電子零組件業上漲0.82%。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"外資今天在台股做了什麼？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"外資今天在現貨市場買超約501,705張。在台指期貨方面，外資的淨空單部位為86,249口。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"融資維持率代表什麼？今天數據如何？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"融資維持率是衡量投資人融資部位風險的指標，數值越高表示融資壓力越小。今天全市場的融資維持率為194.7%。\"}]]}]]}]]]}]\n1b:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"今日台股大盤在國際股市普遍上揚的氣氛下，加權指數與櫃買指數雙雙收紅，電子類股表現尤其亮眼，整體市場呈現偏多格局。\"}]]]}]\n1c:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L17\",\"0-大盤總覽\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"大盤總覽\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L17\",\"0-台股學堂\",{\"href\":\"/school\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"台股學堂\"}]]}],[\"$\",\"li\",\"2\",{\"