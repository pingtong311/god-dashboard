__2nBbk\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_meta__etj_G\",\"children\":[[\"$\",\"$L17\",null,{\"className\":\"LearnArticle_cat__GQMlg\",\"href\":\"/learn?c=chips\",\"children\":\"籌碼面\"}],[\"$\",\"span\",null,{\"className\":\"LearnArticle_read__QEj6a\",\"children\":\"閱讀約 6 分鐘\"}]]}],[\"$\",\"h1\",null,{\"className\":\"LearnArticle_title__0_la8\",\"children\":\"加權指數 vs. 櫃買指數差在哪？一篇看懂台股兩大指標，搞懂市場風向\"}],[\"$\",\"details\",null,{\"className\":\"LearnArticle_toc__LcSAa\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"LearnArticle_tocSummary__YBddG\",\"children\":\"本文目錄\"}],[\"$\",\"ol\",null,{\"className\":\"LearnArticle_tocList__Rq_Lz\",\"children\":[[\"$\",\"li\",\"sec-1\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-1\",\"children\":\"一、加權指數是什麼？為什麼台積電打個噴嚏，指數就感冒？\"}]}],[\"$\",\"li\",\"sec-2\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-2\",\"children\":\"二、那櫃買指數又是什麼？它跟「中小型股」有什麼關係？\"}]}],[\"$\",\"li\",\"sec-3\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-3\",\"children\":\"三、一張表看懂：加權指數 vs. 櫃買指數哪裡不一樣？\"}]}],[\"$\",\"li\",\"sec-4\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-4\",\"children\":\"四、為什麼有時候加權漲、櫃買卻跌？看懂「資金輪動」的訊號\"}]}],[\"$\",\"li\",\"sec-5\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-5\",\"children\":\"五、我該怎麼用這兩個指數，幫助自己的投資判斷？\"}]}],[\"$\",\"li\",\"sec-6\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-6\",\"children\":\"常見問題 FAQ\"}]}],[\"$\",\"li\",\"sec-7\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-7\",\"children\":\"總結\"}]}],[\"$\",\"li\",\"sec-8\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-8\",\"children\":\"延伸閱讀\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"LearnArticle_body__6B7Mb\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_intro__ATV5c\",\"children\":\"打開看盤軟體，看到「加權指」和「櫃買指」兩個數字都在跳，到底哪個才代表大盤？它們漲跌不同步時，又該怎麼解讀？這篇文章會帶你一次搞懂這兩個重要的台股指標，讓你不再看錯市場方向。\"}],[[\"$\",\"figure\",\"figure-0\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"高集中度只說明買超很集中，不說明是誰、要幹嘛前 15 大其餘成交例：集中度 40%＝這批分點淨買超約當天成交的四成不能從集中度推出明天方向\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"示意圖｜分點集中度：前幾大買超合計，佔當天成交的比例（教學結構，不是某檔實盤）\"}]]}]],[\"$\",\"div\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"加權指數主要由大型上市公司組成，像台積電就佔了三成，是觀察外資動向的關鍵。\"}],[\"$\",\"li\",\"1\",{\"children\":\"櫃買指數由中小型上櫃公司組成，更能反映內資主力的活躍程度與市場人氣。\"}],[\"$\",\"li\",\"2\",{\"children\":\"當兩者走勢分歧，例如「拉積盤」，常代表資金集中在少數權值股，多數股票可能沒漲。\"}],[\"$\",\"li\",\"3\",{\"children\":\"觀察櫃買指數是否比加權指數強勢，是判斷市場風險偏好高低的好方法。\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、加權指數是什麼？為什麼台積電打個噴嚏，指數就感冒？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"「加權指數」就是我們最常聽到的「大盤指數」，它是由所有在「集中市場」上市的公司股票計算出來的。你可以把它想像成全班的「加權平均分數」，成績好的大個子同學（像台積電、聯發科）佔的比重特別高，所以只要他們表現好，就算其他同學考得普通，全班平均分數還是會很好看。這也是為什麼外資動向對加權指數影響這麼大，因為他們最愛買的就是這些大型權值股。\"}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、那櫃買指數又是什麼？它跟「中小型股」有什麼關係？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"「櫃買指數」（OTC 指數）代表的是在「櫃買中心」上櫃交易的公司表現。這些公司通常是規模比上市公司小的「中小型企業」，很多是新創或正在快速成長的公司。如果說加權指數是看大象走路，那櫃買指數就是看一群羚羊奔跑。它的股本較小、股性也比較活潑，對市場消息的反應更快，因此常被視為「內資」與「散戶」人氣的指標。\"}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、一張表看懂：加權指數 vs. 櫃買指數哪裡不一樣？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"了解了基本定義後，我們直接用一張表來比較，讓你一眼就看出兩者的核心差異。下次跟朋友聊到盤勢，你就能清楚地說出是「上市」強還是「上櫃」強，以及背後可能代表的意義。\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"比較項目\"}],[\"$\",\"th\",\"1\",{\"children\":\"台灣加權股價指數 (TAIEX)\"}],[\"$\",\"th\",\"2\",{\"children\":\"櫃買市場指數 (TPEx)\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"代表市場\"}],[\"$\",\"td\",\"1\",{\"children\":\"上市市場 (TSE)\"}],[\"$\",\"td\",\"2\",{\"children\":\"上櫃市場 (OTC)\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"主要成分股\"}],[\"$\",\"td\",\"1\",{\"children\":\"大型權值股，如台積電、聯發科、鴻海\"}],[\"$\",\"td\",\"2\",{\"children\":\"中小型成長股，股本較小\"}]]}],\"$L18\",\"$L19\",\"$L1a\"]}]]}]}],\"$L1b\"]]}],\"$L1c\",\"$L1d\",\"$L1e\",\"$L1f\",\"$L20\"],null]}]]}]}]\n18:[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"主要影響者\"}],[\"$\",\"td\",\"1\",{\"children\":\"外資法人、政府基金\"}],[\"$\",\"td\",\"2\",{\"children\":\"內資主力、投信、散戶\"}]]}]\n19:[\"$\",\"tr\",\"3\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"市場溫度計\"}],[\"$\",\"td\",\"1\",{\"children\":\"台股整體經濟的櫥窗\"}],[\"$\",\"td\",\"2\",{\"children\":\"市場內資活絡度、人氣指標\"}]]}]\n1a:[\"$\",\"tr\",\"4\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"股性\"}],[\"$\",\"td\",\"1\",{\"children\":\"相對穩健，受單一權值股影響大\"}],[\"$\",\"td\",\"2\",{\"children\":\"相對活潑，波動性較大\"}]]}]\n1b:[\"$\",\"figure\",\"2\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"✓同步上漲：市場氣氛佳✓同步下跌：保守應對✓走勢分歧：資金在輪動\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"觀察指數強弱的 3 個訊號\"}]]}]\n1c:[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、為什麼有時候加權漲、櫃買卻跌？看懂「資金輪動」的訊號\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"這就是散戶最困惑的地方。當加權指數大漲，櫃買指數卻沒跟上甚至下跌，常被稱為「拉積盤」或「垃圾盤」。意思是漲勢只集中在台積電等少數大型股，資金並沒有流到廣大的中小型股，你的股票很可能就沒漲到。反之，若櫃買指數漲得比加權指數兇，代表市場氣氛熱絡，內資信心充足，願意去追逐更有成長性的中小型股，這時你的操作機會可能就比較多。\"}]]]}]\n1d:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、我該怎麼用這兩個指數，幫助自己的投資判斷？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"這裡給你一個簡單的判斷方法。你可以把加權指數和櫃買指數的走勢圖放在一起比較，觀察它們的「相對強弱」。如果櫃買指數的紅 K 棒連續幾天都比加權指數的長，或是在盤整時櫃買指數率先向上突破，這通常是市場偏多頭的訊號。相反地，如果大盤反彈，但櫃買指數卻軟弱無力，就要提高警覺，可能是一波逃命波，後續下跌的風險較高。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"兩者同步上漲：多頭氣氛濃厚，多數股票都有機會。\"}],[\"$\",\"li\",\"1\",{\"children\":\"加權強、櫃買弱：注意是否為權值股撐盤，小心賺了指數賠了差價。\"}],[\"$\",\"li\",\"2\",{\"children\":\"櫃買強、加權弱：內資活躍，中小型股表現機會大，市場人氣旺。\"}],[\"$\",\"li\",\"3\",{\"children\":\"兩者同步下跌：空頭氣氛，建議保守應對，減少曝險。\"}]]}]]]}]\n1e:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"加權指數大漲，為什麼我的股票都沒動？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"很可能是因為當天的漲幅都集中在台積電等大型權值股身上，而你持有的可能是中小型股或上櫃股票，所以感受不到漲勢。可以打開櫃買指數看看，說不定它是下跌的。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"櫃買指數波動比較大，是不是代表比較好賺錢？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"波動大代表機會與風險並存。它可能在短時間內帶來較高的報酬，但也可能讓你承受更劇烈的虧損。這不代表「比較好賺」，而是需要更靈活的操作與更嚴格的風險控管。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"我只投資 0050 這種 ETF，還需要看櫃買指數嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"還是建議要看。櫃買指數是市場人氣的重要指標，即使你只投資大型股，當櫃買指數持續走弱，也代表市場整體的風險偏好正在下降，這股寒氣最終也可能傳導到上市市場。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"在哪裡可以同時看到這兩個指數的走勢？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"大部分的券商看盤軟體或財經網站，都會在首頁並列顯示加權指數與櫃買指數的即時走勢。在股市大佬的「大盤總覽」頁面，我們也提供了完整的指數資訊與分析工具。\"}]]}]]}]]]}]\n1f:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"把加權指數當作「天氣預報」，看整體趨勢與外資方向；把櫃買指數當作「體感溫度」，感受市場最真實的人氣與內資活力。兩者搭配觀察，更能掌握台股的完整脈動。\"}]]]}]\n20:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L17\",\"0-查看即時大盤總覽\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"查看即時大盤總覽\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L17\",\"0-學習更多台股名詞\",{\"href\":\"/school\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"學習更多台股名詞\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L17\",\"0-觀察熱門族群輪動\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"觀察熱門族群輪動\"}]]}]]}]]]}]\n13:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\nf:null\n21:I[80622,[],\"IconMark\"]\n11:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"加權指數 vs. 櫃買指數差在哪？一篇看懂台股兩大指標，搞懂市場風向｜股市大佬 TradeBoss\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"打開看盤軟體，看到「加權指」和「櫃買指」兩個數字都在跳，到底哪個才代表大盤？它們漲跌不同步時，又該怎麼解讀？這篇文章會帶你一次搞懂這兩個重要的台股指標，讓你不再看錯市場方向。\"}],[\"$\",\"link\",\"2\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}],[\"$\",\"$L21\",\"3\",{}]],\"error\":null,\"digest\":\"$undefined\"}\n16:\"$11:metadata\"\n"}