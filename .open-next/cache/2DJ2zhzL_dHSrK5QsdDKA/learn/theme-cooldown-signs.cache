,\"$15\",null,{\"fallback\":null,\"children\":\"$L16\"}]}]}]]}]\n17:I[52619,[\"2619\",\"static/chunks/2619-04bc32f026a0d946.js\",\"6309\",\"static/chunks/app/learn/%5Bslug%5D/page-f7b99344f7e2ee16.js\"],\"\"]\nd:[\"$\",\"div\",null,{\"className\":\"LearnArticle_wrap__LIQ8G\",\"children\":[\"$\",\"article\",null,{\"className\":\"LearnArticle_article__2nBbk\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_meta__etj_G\",\"children\":[[\"$\",\"$L17\",null,{\"className\":\"LearnArticle_cat__GQMlg\",\"href\":\"/learn?c=themes\",\"children\":\"題材專欄\"}],[\"$\",\"span\",null,{\"className\":\"LearnArticle_read__QEj6a\",\"children\":\"閱讀約 4 分鐘\"}]]}],[\"$\",\"h1\",null,{\"className\":\"LearnArticle_title__0_la8\",\"children\":\"題材退燒有哪些跡象？3個檢查比感覺準\"}],[\"$\",\"details\",null,{\"className\":\"LearnArticle_toc__LcSAa\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"LearnArticle_tocSummary__YBddG\",\"children\":\"本文目錄\"}],[\"$\",\"ol\",null,{\"className\":\"LearnArticle_tocList__Rq_Lz\",\"children\":[[\"$\",\"li\",\"sec-1\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-1\",\"children\":\"一、退燒通常沒有宣布\"}]}],[\"$\",\"li\",\"sec-2\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-2\",\"children\":\"二、三個比較寫得下來的跡象\"}]}],[\"$\",\"li\",\"sec-3\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-3\",\"children\":\"三、想在退潮時抄底，風險是分不清休息與結束\"}]}],[\"$\",\"li\",\"sec-4\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-4\",\"children\":\"四、報導量高，為什麼仍可能在退\"}]}],[\"$\",\"li\",\"sec-5\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-5\",\"children\":\"五、跡象要寫進當天，不要寫進事後\"}]}],[\"$\",\"li\",\"sec-6\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-6\",\"children\":\"常見問題 FAQ\"}]}],[\"$\",\"li\",\"sec-7\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-7\",\"children\":\"總結\"}]}],[\"$\",\"li\",\"sec-8\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-8\",\"children\":\"延伸閱讀\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"LearnArticle_body__6B7Mb\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_intro__ATV5c\",\"children\":\"退燒這兩個字聽起來像天氣變了，實際上很少有一天可以圈起來當紀念日。比較常看到的是：新聞還很多，可是價格不太理；量還在，可是推不高；相關名單愈來愈長，每一檔待的時間卻愈來愈短。這些是已發生的跡象，不是鬧鐘。這篇幫你把它們寫成檢查，避免只靠我覺得過熱。\"}],[[\"$\",\"figure\",\"figure-0\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"越後面越熱鬧，通常也越貴、越好離開佈局沒新聞命名故事出現擁擠人人都知退燒利多變鈍新聞出現時，常常已經不是第一段\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"示意圖｜題材四階段：佈局 → 命名 → 擁擠 → 退燒（教學結構，不是某檔實盤）\"}]]}]],[\"$\",\"div\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"退燒是一組跡象，很少是單一鐘聲\"}],[\"$\",\"li\",\"1\",{\"children\":\"利多變鈍、量大不漲、輪動變短，比感覺好記\"}],[\"$\",\"li\",\"2\",{\"children\":\"跡象用來調整期待，不拿來當反向訊號\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、退燒通常沒有宣布\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"題材熱的時候，每天都有新標題；冷的時候，標題常常還在。媒體不會幫你按暫停。你若等一句正式的結束，通常會等到價格已經走完一段。比較有用的是承認：退燒是過程，不是事件。過程能記的是反應有沒有變鈍，不是有沒有人出來認輸。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"標題還在，不代表熱度還在\"}],[\"$\",\"li\",\"1\",{\"children\":\"不要等正式宣布\"}],[\"$\",\"li\",\"2\",{\"children\":\"先看反應，再看故事\"}]]}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、三個比較寫得下來的跡象\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"第一，同樣等級的利多，價格反應明顯比前一波小，甚至當日就被吐回去。第二，成交量不小，可是價格推不高、或推高留不住。第三，相關清單還在變長，可是單一檔的強勢持續變短，輪動明顯加快。三個不必同一天齊，齊的時候你更該把期待收小，而不是突然改信反向。\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"跡象\"}],[\"$\",\"th\",\"1\",{\"children\":\"你看得到的\"}],[\"$\",\"th\",\"2\",{\"children\":\"不要翻譯成\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"利多變鈍\"}],[\"$\",\"td\",\"1\",{\"children\":\"好消息在，價格不太理\"}],[\"$\",\"td\",\"2\",{\"children\":\"明天一定反轉\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"量大不漲\"}],[\"$\",\"td\",\"1\",{\"children\":\"成交熱鬧、位置走不動\"}],[\"$\",\"td\",\"2\",{\"children\":\"一定有人在出貨\"}]]}],[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"輪動變短\"}],[\"$\",\"td\",\"1\",{\"children\":\"每天換人當領頭\"}],[\"$\",\"td\",\"2\",{\"children\":\"下一檔更補得兇\"}]]}],[\"$\",\"tr\",\"3\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"舊聞新煮\"}],[\"$\",\"td\",\"1\",{\"children\":\"標題換皮、事實沒增加\"}],[\"$\",\"td\",\"2\",{\"children\":\"關注愈高愈安全\"}]]}]]}]]}]}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、想在退潮時抄底，風險是分不清休息與結束\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"價格一回落，想抄底的風險是把所有回落都當成休息。休息與結束當下長得很像：都是熱度下降、都是有人說題材還在。分不清就用更大的部位去證明自己有遠見，帳單會比標題更清楚。先把跡象記下來，再決定這筆看法要不要那麼重。\"}],\"$L18\",\"$L19\"]]}],\"$L1a\",\"$L1b\",\"$L1c\",\"$L1d\",\"$L1e\"],\"$L1f\"]}]]}]}]\n18:[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"先標現在有哪幾條退燒跡象\"}],[\"$\",\"li\",\"1\",{\"children\":\"再寫怎樣算只是休息、怎樣算故事散了\"}],[\"$\",\"li\",\"2\",{\"children\":\"寫不出差別，就不要用回落當理由加重\"}]]}]\n19:[\"$\",\"figure\",\"2\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"!當鬧鐘!當出貨鐵證!當一定結束\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"三種誤譯\"}]]}]\n1a:[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、報導量高，為什麼仍可能在退\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"傳播有慣性。一則題材夠好講之後，標題會自己複製，不一定需要新事實。所以報導量維持高位，只說明這個名詞還好用，不說明還有新的資金願意用更高價格承認它。你要把報導拆成有沒有新內容。沒有新內容的熱鬧，比較像回音，不像啟動。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"先問這則有沒有新事實\"}],[\"$\",\"li\",\"1\",{\"children\":\"舊聞新煮當回音\"}],[\"$\",\"li\",\"2\",{\"children\":\"關注度不能單獨當熱度\"}]]}]]]}]\n1b:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、跡象要寫進當天，不要寫進事後\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"退燒一旦走完，人人都會說當時很明顯。當時你若沒記下利多鈍了、量大不漲、輪動變短，事後的明顯是後見之明。一行就夠：今天哪一條跡象出現、哪一條沒有。有底稿，你才知道自己是真的看到過程，還是只是結果出來後比較會說。\"}]]]}]\n1c:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"一個跡象出現就要當退燒嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"一個只能當提醒。兩、三個一起出現，比較值得把期待收小，仍不是鬧鐘。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"量大不漲一定是有人在出嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"不一定。也可能是漲多之後自然難推。先當價量對不上，不要先編主角。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"退燒後題材會不會再熱？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"會或不會，當下都無法用跡象保證。產業可能還在，交易熱度可以先走完一輪。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"和生命週期第四段有何不同？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"生命週期給階段框架。這篇把退燒拆成可當天勾選的跡象，方便對帳。\"}]]}]]}]]]}]\n1d:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"退燒少有鐘聲。利多變鈍、量大不漲、輪動變短，比我覺得過熱好記。跡象用來收期待，不拿來當反向。\"}]]]}]\n1e:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L17\",\"0-題材股生命週期\",{\"href\":\"/learn/theme-stock-lifecycle\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"題材股生命週期\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L17\",\"0-題材輪動怎麼看\",{\"href\":\"/learn/what-theme-rotation-is-actually-doing\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"題材輪動怎麼看\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L17\",\"0-後見之明偏差\",{\"href\":\"/learn/hindsight-bias-in-trading\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"後見之明偏差\"}]]}]]}]]]}]\n1f:[\"$\",\"div\",null,{\"className\":\"LearnArticle_related__9qV55\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_relatedTitle__RXfrl\",\"children\":\"相關文章\"}],[[\"$\",\"$L17\",\"theme-stock-lifecycle\",{\"href\":\"/learn/theme-stock-lifecycle\",\"className\":\"LearnArticle_relatedLink__mibXe\",\"children\":\"題材股生命週期\"}],[\"$\",\"$L17\",\"what-theme-rotation-is-actually-doing\",{\"href\":\"/learn/what-theme-rotation-is-actually-doing\",\"className\":\"LearnArticle_relatedLink__mibXe\",\"children\":\"題材輪動怎麼看\"}],[\"$\",\"$L17\",\"hindsight-bias-in-trading\",{\"href\":\"/learn/hindsight-bias-in-trading\",\"className\":\"LearnArticle_relatedLink__mibXe\",\"children\":\"後見之明偏差\"}]]]}]\n13:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\nf:null\n20:I[80622,[],\"IconMark\"]\n11:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"題材退燒有哪些跡象？3個檢查比感覺準｜股市大佬 TradeBoss\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"退燒這兩個字聽起來像天氣變了，實際上很少有一天可以圈起來當紀念日。比較常看到的是：新聞還很多，可是價格不太理；量還在，可是推不高；相關名單愈來愈長，每一檔待的時間卻愈來愈短。這些是已發生的跡象，不是鬧鐘。這篇幫你把它們寫成檢查，避免只靠我覺得過熱。\"}],[\"$\",\"link\",\"2\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}],[\"$\",\"$L20\",\"3\",{}]],\"error\":null,\"digest\":\"$undefined\"}\n16:\"$11:metadata\"\n"}