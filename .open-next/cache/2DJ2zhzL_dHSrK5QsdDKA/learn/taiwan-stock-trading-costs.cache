Name\":\"LearnArticle_tocList__Rq_Lz\",\"children\":[[\"$\",\"li\",\"sec-1\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-1\",\"children\":\"一、成本由三個部分組成\"}]}],[\"$\",\"li\",\"sec-2\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-2\",\"children\":\"二、為什麼滑價最容易被忽略\"}]}],[\"$\",\"li\",\"sec-3\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-3\",\"children\":\"三、算出你的損益兩平幅度\"}]}],[\"$\",\"li\",\"sec-4\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-4\",\"children\":\"四、成本對不同持有期間的影響差很大\"}]}],[\"$\",\"li\",\"sec-5\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-5\",\"children\":\"五、把成本算進期望值\"}]}],[\"$\",\"li\",\"sec-6\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-6\",\"children\":\"六、可以怎麼降低\"}]}],[\"$\",\"li\",\"sec-7\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-7\",\"children\":\"七、一個容易忘記的部分\"}]}],[\"$\",\"li\",\"sec-8\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-8\",\"children\":\"常見問題 FAQ\"}]}],[\"$\",\"li\",\"sec-9\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-9\",\"children\":\"總結\"}]}],[\"$\",\"li\",\"sec-10\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-10\",\"children\":\"延伸閱讀\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"LearnArticle_body__6B7Mb\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_intro__ATV5c\",\"children\":\"很多看起來可行的短線做法，扣掉成本就變成負的。這不是誇張——當平均獲利只有百分之一時，來回成本可能佔掉相當比例。這篇把成本拆開來算，讓你知道自己每筆至少要賺多少才算打平。\"}],[[\"$\",\"figure\",\"figure-0\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"沒扣成本的勝率，看起來都會比較漂亮0.029%手續費 1 折來回0.15%當沖證交稅0.06%滑價估計三項合計約 0.24%；留倉稅率更高，約 0.39%\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"示意圖｜當沖來回成本：1 折手續費 + 證交稅 + 滑價（教學結構，不是某檔實盤）\"}]]}]],[\"$\",\"div\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"成本由手續費、證交稅與滑價組成，加總就是你的損益兩平幅度\"}],[\"$\",\"li\",\"1\",{\"children\":\"如果平均獲利目標小於它，不管勝率多高長期都是負的\"}],[\"$\",\"li\",\"2\",{\"children\":\"算期望值時獲利要扣、虧損要加\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、成本由三個部分組成\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"第一是券商手續費，買進與賣出各收一次，實際費率依券商折扣而定。第二是證券交易稅，賣出時課徵，當日沖銷另有減半的規定。第三是滑價，也就是你預期的成交價與實際成交價的差距，這一項不會出現在對帳單上，但它是真實成本。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"手續費：買賣各一次，費率依券商折扣\"}],[\"$\",\"li\",\"1\",{\"children\":\"證交稅：賣出課徵，當沖另有減半規定\"}],[\"$\",\"li\",\"2\",{\"children\":\"滑價：不上帳但真實存在\"}]]}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、為什麼滑價最容易被忽略\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"手續費和稅有明確數字，滑價沒有，所以多數人算成本時直接跳過。但滑價在幾種情況下會明顯放大：流動性薄的標的、開盤初段、以及使用市價單的時候。如果你的做法常常需要立刻成交，滑價可能是三項裡最大的一項。實務上比較保守的做法是先給它一個估計值，之後用實際成交記錄回頭校正。\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"成本項目\"}],[\"$\",\"th\",\"1\",{\"children\":\"何時發生\"}],[\"$\",\"th\",\"2\",{\"children\":\"影響大小的因素\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"手續費\"}],[\"$\",\"td\",\"1\",{\"children\":\"買進與賣出各一次\"}],[\"$\",\"td\",\"2\",{\"children\":\"券商折扣、單筆金額\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"證交稅\"}],[\"$\",\"td\",\"1\",{\"children\":\"賣出時\"}],[\"$\",\"td\",\"2\",{\"children\":\"是否符合當沖減半規定\"}]]}],[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"滑價\"}],[\"$\",\"td\",\"1\",{\"children\":\"每次成交\"}],[\"$\",\"td\",\"2\",{\"children\":\"流動性、時段、委託方式\"}]]}]]}]]}]}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、算出你的損益兩平幅度\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"把三項成本用百分比加總，得到的數字就是「這一趟至少要漲多少才不虧」。這個數字非常實用，因為它直接告訴你哪些做法在數學上不可能：如果你的平均獲利目標小於損益兩平幅度，那不管勝率多高，長期都是負的。這是純算術，不是意見。\"}],\"$L18\"]]}],\"$L19\",\"$L1a\",\"$L1b\",\"$L1c\",\"$L1d\",\"$L1e\",\"$L1f\"],null]}]]}]}]\n18:[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"把買賣手續費換成百分比相加\"}],[\"$\",\"li\",\"1\",{\"children\":\"加上賣出的證交稅（確認是否符合減半）\"}],[\"$\",\"li\",\"2\",{\"children\":\"加上你估計的滑價\"}],[\"$\",\"li\",\"3\",{\"children\":\"總和就是這一趟的損益兩平幅度\"}]]}]\n19:[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、成本對不同持有期間的影響差很大\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"成本是固定發生在每一趟進出上，跟持有多久無關。所以持有一天賺百分之一，跟持有一個月賺百分之十，承擔的成本是一樣的，但成本佔獲利的比例差十倍。這解釋了一個常被誤解的現象：交易頻率越高，成本對期望值的侵蝕越嚴重，即使每次的勝率完全相同。\"}],[\"$\",\"figure\",\"1\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"!忘記算滑價!只在獲利端扣!忽略融資利息!用別人的費率算\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"四個常見錯誤\"}]]}]]]}]\n1a:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、把成本算進期望值\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"計算期望值時，平均獲利與平均虧損都要用扣完成本後的數字。很多人只在獲利端扣成本，虧損端忘記加——實際上虧損的那些也要付手續費與稅，所以真實虧損比帳面幅度更大。兩邊都算對之後，期望值通常會比原本估計的差一截。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"平均獲利要扣掉成本\"}],[\"$\",\"li\",\"1\",{\"children\":\"平均虧損要加上成本\"}],[\"$\",\"li\",\"2\",{\"children\":\"兩邊都調整後才是真實期望值\"}]]}]]]}]\n1b:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"六、可以怎麼降低\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"手續費折扣可以跟券商談，這是最直接的一項。滑價則靠委託方式與標的選擇——用限價單而不是市價單、避開流動性薄的標的與開盤初段。至於稅，那是法定的，只能確認自己是否符合相關減半規定，不能減少。降低成本不會讓一套負期望值的方法變正，但它能讓邊際的方法變可行。\"}],[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"手續費折扣可與券商討論\"}],[\"$\",\"li\",\"1\",{\"children\":\"多用限價單，減少滑價\"}],[\"$\",\"li\",\"2\",{\"children\":\"避開流動性薄的標的與開盤初段\"}],[\"$\",\"li\",\"3\",{\"children\":\"降低頻率也是降低總成本的方式\"}]]}]]]}]\n1c:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"七、一個容易忘記的部分\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"如果使用信用交易，還有利息成本，而且它隨持有天數累積。這一項對短線影響小，對抱幾週的部位影響就明顯。計算的時候要把它算進去，否則會低估真實成本。相關費率與計算方式以券商公告為準。\"}]]]}]\n1d:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"交易成本大概佔多少？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"取決於券商折扣、是否符合當沖減半規定、以及滑價大小，所以沒有通用數字。正確做法是用自己的實際費率算出「損益兩平幅度」，那個數字才對你有意義。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"為什麼說頻率越高成本影響越大？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"因為成本固定發生在每一趟進出上，跟持有多久無關。持有一天賺百分之一和持有一個月賺百分之十，付的成本一樣，但佔獲利的比例差十倍。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"滑價要怎麼估？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"先給一個保守的估計值，之後用實際成交記錄回頭校正——比對你預期的價格與實際成交價的差距。流動性薄的標的、開盤初段與市價單都會讓它放大。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"算期望值時虧損端也要調整嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"要。虧損的交易同樣要付手續費與稅，所以真實虧損比帳面幅度更大。只在獲利端扣成本是常見錯誤，會讓期望值被高估。\"}]]}]]}]]]}]\n1e:[\"$\",\"section\",\"sec-9\",{\"id\":\"sec-9\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"成本由手續費、證交稅與滑價組成，加總就是你的損益兩平幅度。如果平均獲利目標小於它，不管勝率多高長期都是負的。算期望值時獲利要扣、虧損要加。\"}]]]}]\n1f:[\"$\",\"section\",\"sec-10\",{\"id\":\"sec-10\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L17\",\"0-什麼是期望值\",{\"href\":\"/learn\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"什麼是期望值\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L17\",\"0-台股制度與名詞：\",{\"href\":\"/school\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"台股制度與名詞：台股學堂\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L17\",\"0-本站的立場與免責\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"本站的立場與免責說明\"}]]}]]}]]]}]\n13:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\nf:null\n20:I[80622,[],\"IconMark\"]\n11:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"台股交易成本怎麼算？短線最常被低估的一筆｜股市大佬 TradeBoss\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"很多看起來可行的短線做法，扣掉成本就變成負的。這不是誇張——當平均獲利只有百分之一時，來回成本可能佔掉相當比例。這篇把成本拆開來算，讓你知道自己每筆至少要賺多少才算打平。\"}],[\"$\",\"link\",\"2\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}],[\"$\",\"$L20\",\"3\",{}]],\"error\":null,\"digest\":\"$undefined\"}\n16:\"$11:metadata\"\n"}