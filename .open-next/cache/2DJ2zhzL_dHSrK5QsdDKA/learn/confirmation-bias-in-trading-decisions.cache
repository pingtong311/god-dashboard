"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_meta__etj_G\",\"children\":[[\"$\",\"$L17\",null,{\"className\":\"LearnArticle_cat__GQMlg\",\"href\":\"/learn?c=mindset\",\"children\":\"心態與風控\"}],[\"$\",\"span\",null,{\"className\":\"LearnArticle_read__QEj6a\",\"children\":\"閱讀約 5 分鐘\"}]]}],[\"$\",\"h1\",null,{\"className\":\"LearnArticle_title__0_la8\",\"children\":\"確認偏誤怎麼害你加碼？3個檢查讓證據不再只站你這邊\"}],[\"$\",\"details\",null,{\"className\":\"LearnArticle_toc__LcSAa\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"LearnArticle_tocSummary__YBddG\",\"children\":\"本文目錄\"}],[\"$\",\"ol\",null,{\"className\":\"LearnArticle_tocList__Rq_Lz\",\"children\":[[\"$\",\"li\",\"sec-1\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-1\",\"children\":\"一、它在盤上長什麼樣子\"}]}],[\"$\",\"li\",\"sec-2\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-2\",\"children\":\"二、加碼是偏誤最貴的出口\"}]}],[\"$\",\"li\",\"sec-3\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-3\",\"children\":\"三、三個檢查，讓相反證據也有入場券\"}]}],[\"$\",\"li\",\"sec-4\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-4\",\"children\":\"四、社群會把偏誤放大\"}]}],[\"$\",\"li\",\"sec-5\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-5\",\"children\":\"五、偏誤消滅不了，但可以讓它變貴\"}]}],[\"$\",\"li\",\"sec-6\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-6\",\"children\":\"常見問題 FAQ\"}]}],[\"$\",\"li\",\"sec-7\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-7\",\"children\":\"總結\"}]}],[\"$\",\"li\",\"sec-8\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-8\",\"children\":\"延伸閱讀\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"LearnArticle_body__6B7Mb\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_intro__ATV5c\",\"children\":\"確認偏誤不是交易員才有，是人腦的預設：先有立場，再找證據。放到交易裡特別貴，因為市場每天都提供正反兩面的材料，你永遠找得到支持自己的那一則。於是加碼變得很合理，出場變得很困難，檢討變得很會選樣。要成功，不是先消滅這個偏誤——消滅不了——而是設計檢查，讓相反證據也有固定入場券。\"}],[],[\"$\",\"div\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"先寫立場，再強迫自己找一條相反證據\"}],[\"$\",\"li\",\"1\",{\"children\":\"加碼前先問：有沒有新資訊，還是只是更想證明自己\"}],[\"$\",\"li\",\"2\",{\"children\":\"檢討時賺虧兩邊都要抽樣，不能只複盤痛的或爽的\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、它在盤上長什麼樣子\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"你看多的時候，分點買超特別顯眼，賣超會被解釋成洗盤；你看空的時候，同一張表又變成出貨。新聞、社群、甚至 K 線型態都會被同一套濾鏡處理。可怕的地方是當事人不覺得自己在篩選，只覺得「證據愈來愈明顯」。明顯往往不是市場變清楚，是你的濾鏡變厚。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"同一張表，立場不同解讀就翻面\"}],[\"$\",\"li\",\"1\",{\"children\":\"相反證據被快速合理化\"}],[\"$\",\"li\",\"2\",{\"children\":\"愈找愈確定，常常是濾鏡在工作\"}]]}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、加碼是偏誤最貴的出口\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"加碼需要一個故事：「我更對了」。確認偏誤會幫你生產這個故事，即使市場沒有新資訊。比較穩的做法是：加碼條件與進場條件一樣事先寫好，例如只有價格朝預期走、而且波動仍在你接受的範圍，才允許加。若加碼理由只是「我愈看愈對」，那就是偏誤在下單，不是市場給了新證據。\"}],[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"加碼條件必須事前寫，不能盤中發明\"}],[\"$\",\"li\",\"1\",{\"children\":\"先問有沒有新資訊，再問想不想證明自己\"}],[\"$\",\"li\",\"2\",{\"children\":\"沒有新資訊，預設不加\"}]]}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、三個檢查，讓相反證據也有入場券\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"第一，進場前先寫一句相反劇本：怎樣走你會承認自己錯。第二，每天固定看一則你不喜歡的解釋，不是為了被說服，是為了避免只活在同溫層。第三，檢討時用抽樣：賺的虧的各抽幾筆，強迫自己看兩邊。這三個檢查都不浪漫，但它們把「我只看見支持我的東西」變成可執行的流程，而不是道德提醒。\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"檢查\"}],[\"$\",\"th\",\"1\",{\"children\":\"你要做的事\"}],[\"$\",\"th\",\"2\",{\"children\":\"它擋什麼\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"相反劇本\"}],[\"$\",\"td\",\"1\",{\"children\":\"進場前寫怎樣叫看錯\"}],[\"$\",\"td\",\"2\",{\"children\":\"事後把任何走勢都解釋成支持自己\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"固定看反對意見\"}],[\"$\",\"td\",\"1\",{\"children\":\"每天一則你不喜歡的解釋\"}],[\"$\",\"td\",\"2\",{\"children\":\"同溫層愈看愈確定\"}]]}],[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"兩邊抽樣複盤\"}],[\"$\",\"td\",\"1\",{\"children\":\"賺虧各抽，不挑樣本\"}],[\"$\",\"td\",\"2\",{\"children\":\"只記得爽的或痛的\"}]]}],[\"$\",\"tr\",\"3\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"加碼要新資訊\"}],[\"$\",\"td\",\"1\",{\"children\":\"沒新資訊就不加\"}],[\"$\",\"td\",\"2\",{\"children\":\"用加碼滿足證明欲\"}]]}]]}]]}]}],[\"$\",\"figure\",\"2\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[\"$L18\",\"$L19\"]}]]]}],\"$L1a\",\"$L1b\",\"$L1c\",\"$L1d\",\"$L1e\"],\"$L1f\"]}]]}]}]\n18:[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"!愈找愈確定!相反證據秒被合理化!下單前先看群組\"}]\n19:[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"偏誤正在工作的跡象\"}]\n1a:[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、社群會把偏誤放大\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"群組、留言與短影片演算法，本來就會把你已經同意的內容再餵給你。看起來像研究，其實是回音。要成功不必退出所有社群，但要把社群降級成背景，不能升級成依據。依據只留自己寫下來的條件。若你發現自己需要先看群組才敢下單，判斷已經外包，偏誤只是在幫外包找理由。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"社群當背景，不當依據\"}],[\"$\",\"li\",\"1\",{\"children\":\"下單前不需要先看群組同不同意\"}],[\"$\",\"li\",\"2\",{\"children\":\"演算法愈順眼，愈要主動找相反說法\"}]]}]]]}]\n1b:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、偏誤消滅不了，但可以讓它變貴\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"不要立志變成完全客觀的人，那不現實。比較可行的是讓偏誤變貴：沒寫相反劇本就不能進場，沒新資訊就不能加碼，沒抽樣就不能下「我的方法沒用了」這種結論。門檻一提高，偏誤還在，只是比較難直接碰到帳戶。心法的工作不是改造人格，是改造流程。\"}]]]}]\n1c:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"我已經很客觀了，還需要這些檢查嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"愈覺得自己客觀，愈需要。確認偏誤的特徵就是當事人不覺得自己在篩選。用流程檢查，比用自我評價可靠。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"看相反意見會不會反而把自己搞亂？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"目的不是被說服，是避免只活在一種解釋裡。看完仍可維持原立場，但進場前要寫得出相反劇本。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"加碼一定是確認偏誤嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"不一定。事前寫好、且有新資訊的加碼，是規則。盤中因為「愈看愈對」而加，才比較像偏誤。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"檢討時只看虧的單可以嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"不夠。只看虧的會低估方法裡有效的部分；只看賺的會高估。兩邊抽樣，結論才比較不像心情。\"}]]}]]}]]]}]\n1d:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"確認偏誤會讓證據只站你這邊，加碼與檢討因此失真。進場先寫相反劇本、加碼要有新資訊、複盤兩邊抽樣。偏誤消滅不了，但可以用流程讓它比較難碰到帳戶。\"}]]]}]\n1e:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L17\",\"0-失效條件要事前寫\",{\"href\":\"/learn/write-invalidation-before-you-enter\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"失效條件要事前寫\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L17\",\"0-為什麼別人的方法\",{\"href\":\"/learn/why-others-methods-dont-work-for-you\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"為什麼別人的方法你用不起來\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L17\",\"0-台股學堂\",{\"href\":\"/school\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"台股學堂\"}]]}]]}]]]}]\n1f:[\"$\",\"div\",null,{\"className\":\"LearnArticle_related__9qV55\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_relatedTitle__RXfrl\",\"children\":\"相關文章\"}],[[\"$\",\"$L17\",\"write-invalidation-before-you-enter\",{\"href\":\"/learn/write-invalidation-before-you-enter\",\"className\":\"LearnArticle_relatedLink__mibXe\",\"children\":\"失效條件要事前寫\"}],[\"$\",\"$L17\",\"why-others-methods-dont-work-for-you\",{\"href\":\"/learn/why-others-methods-dont-work-for-you\",\"className\":\"LearnArticle_relatedLink__mibXe\",\"children\":\"為什麼別人的方法你用不起來\"}]]]}]\n13:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\nf:null\n20:I[80622,[],\"IconMark\"]\n11:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"確認偏誤怎麼害你加碼？3個檢查讓證據不再只站你這邊｜股市大佬 TradeBoss\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"確認偏誤不是交易員才有，是人腦的預設：先有立場，再找證據。放到交易裡特別貴，因為市場每天都提供正反兩面的材料，你永遠找得到支持自己的那一則。於是加碼變得很合理，出場變得很困難，檢討變得很會選樣。要成功，不是先消滅這個偏誤——消滅不了——而是設計檢查，讓相反證據也有固定入場券。\"}],[\"$\",\"link\",\"2\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}],[\"$\",\"$L20\",\"3\",{}]],\"error\":null,\"digest\":\"$undefined\"}\n16:\"$11:metadata\"\n"}