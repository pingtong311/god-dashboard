\\"#sec-6\\\",\\\"children\\\":\\\"常見問題 FAQ\\\"}]}],[\\\"$\\\",\\\"li\\\",\\\"sec-7\\\",{\\\"children\\\":[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"#sec-7\\\",\\\"children\\\":\\\"總結\\\"}]}],[\\\"$\\\",\\\"li\\\",\\\"sec-8\\\",{\\\"children\\\":[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"#sec-8\\\",\\\"children\\\":\\\"延伸閱讀\\\"}]}]]}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"LearnArticle_body__6B7Mb\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"LearnArticle_intro__ATV5c\\\",\\\"children\\\":\\\"看到財報一堆數字就頭痛？毛利率、營業利益率好像都代表「賺錢」，但數字高低到底差在哪？搞懂這兩個指標，你就能判斷一家公司賺錢的「品質」好不好。\\\"}],[[\\\"$\\\",\\\"figure\\\",\\\"figure-0\\\",{\\\"className\\\":\\\"LearnArticle_fig__uoT7r\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"LearnArticle_figFrame__jJ7E4\\\",\\\"children\\\":\\\"沒扣成本的勝率，看起來都會比較漂亮0.029%手續費 1 折來回0.15%當沖證交稅0.06%滑價估計三項合計約 0.24%；留倉稅率更高，約 0.39%\\\"}],[\\\"$\\\",\\\"figcaption\\\",null,{\\\"className\\\":\\\"LearnArticle_figCap__LnUbb\\\",\\\"children\\\":\\\"示意圖｜當沖來回成本：1 折手續費 + 證交稅 + 滑價（教學結構，不是某檔實盤）\\\"}]]}]],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"LearnArticle_tldr__Br5BY\\\",\\\"children\\\":[[\\\"$\\\",\\\"b\\\",null,{\\\"className\\\":\\\"LearnArticle_tldrTitle__K5PBN\\\",\\\"children\\\":\\\"本文重點\\\"}],[\\\"$\\\",\\\"ul\\\",null,{\\\"className\\\":\\\"LearnArticle_tldrList__VSc2_\\\",\\\"children\\\":[[\\\"$\\\",\\\"li\\\",\\\"0\\\",{\\\"children\\\":\\\"毛利率看「產品本身」的賺錢能力，越高代表成本控制越好。\\\"}],[\\\"$\\\",\\\"li\\\",\\\"1\\\",{\\\"children\\\":\\\"營業利益率看「公司本業」的綜合獲利能力，已計入管銷研發費用。\\\"}],[\\\"$\\\",\\\"li\\\",\\\"2\\\",{\\\"children\\\":\\\"兩者差距太大，可能代表公司行銷或研發開銷過高，需要留意。\\\"}],[\\\"$\\\",\\\"li\\\",\\\"3\\\",{\\\"children\\\":\\\"長期穩定的毛利率與營業利益率，比單季暴增的數字更重要。\\\"}]]}]]}],[[\\\"$\\\",\\\"section\\\",\\\"sec-1\\\",{\\\"id\\\":\\\"sec-1\\\",\\\"className\\\":\\\"LearnArticle_section__hLVjU\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"LearnArticle_h2__NmJ08\\\",\\\"children\\\":\\\"一、什麼是毛利率？數字越高代表什麼？\\\"}],[[\\\"$\\\",\\\"p\\\",\\\"0\\\",{\\\"className\\\":\\\"LearnArticle_p__aZlQ1\\\",\\\"children\\\":\\\"毛利率，就是公司賣出產品或服務後，扣掉「直接成本」（例如原料、生產線人工）後，還剩下多少利潤。你可以把它想成是「這門生意的基本賺頭好不好」。數字越高，通常代表公司的產品競爭力強，或者成本控制做得很好。\\\"}],[\\\"$\\\",\\\"ul\\\",\\\"1\\\",{\\\"className\\\":\\\"LearnArticle_listCheck__xx1CF\\\",\\\"children\\\":[[\\\"$\\\",\\\"li\\\",\\\"0\\\",{\\\"children\\\":\\\"計算公式：（營業收入 - 營業成本） ÷ 營業收入 x 100%\\\"}],[\\\"$\\\",\\\"li\\\",\\\"1\\\",{\\\"children\\\":\\\"判斷重點：毛利率越高，代表產品本身越值錢，或是生產效率高。\\\"}],[\\\"$\\\",\\\"li\\\",\\\"2\\\",{\\\"children\\\":\\\"常見錯誤：只看單一季度的毛利率。應該要看至少 3-5 年的趨勢，判斷是穩定、成長還是衰退。\\\"}]]}]]]}],[\\\"$\\\",\\\"section\\\",\\\"sec-2\\\",{\\\"id\\\":\\\"sec-2\\\",\\\"className\\\":\\\"LearnArticle_section__hLVjU\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"LearnArticle_h2__NmJ08\\\",\\\"children\\\":\\\"二、那營業利益率是什麼？為什麼它更重要？\\\"}],[[\\\"$\\\",\\\"p\\\",\\\"0\\\",{\\\"className\\\":\\\"LearnArticle_p__aZlQ1\\\",\\\"children\\\":\\\"營業利益率，是在毛利之後，再扣掉「營業費用」（例如辦公室租金、員工薪水、廣告費、研發費）算出來的。這個數字更能反映一家公司「靠本業賺錢的真實能力」。畢竟，公司要營運，不可能沒有這些管理、行銷等開銷。\\\"}],[\\\"$\\\",\\\"ul\\\",\\\"1\\\",{\\\"className\\\":\\\"LearnArticle_listCheck__xx1CF\\\",\\\"children\\\":[[\\\"$\\\",\\\"li\\\",\\\"0\\\",{\\\"children\\\":\\\"計算公式：營業利益 ÷ 營業收入 x 100%\\\"}],[\\\"$\\\",\\\"li\\\",\\\"1\\\",{\\\"children\\\":\\\"判斷重點：這是衡量公司核心業務賺錢效率的關鍵指標。\\\"}],[\\\"$\\\",\\\"li\\\",\\\"2\\\",{\\\"children\\\":\\\"常見錯誤：把營業利益跟稅後淨利搞混。營業利益只看本業，還沒計算業外收支（例如賣土地的獲利）和稅金。\\\"}]]}]]]}],[\\\"$\\\",\\\"section\\\",\\\"sec-3\\\",{\\\"id\\\":\\\"sec-3\\\",\\\"className\\\":\\\"LearnArticle_section__hLVjU\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"LearnArticle_h2__NmJ08\\\",\\\"children\\\":\\\"三、毛利率 vs. 營業利益率，一張表看懂關鍵差異\\\"}],[[\\\"$\\\",\\\"p\\\",\\\"0\\\",{\\\"className\\\":\\\"LearnArticle_p__aZlQ1\\\",\\\"children\\\":\\\"簡單說，毛利率到營業利益率中間的差距，就是「營業費用」。一家公司就算產品本身很賺錢（毛利率高），如果行銷或管理費用太高，最後放進口袋的錢（營業利益）也會變少。透過下表，你可以快速掌握兩者的不同。\\\"}],[\\\"$\\\",\\\"div\\\",\\\"1\\\",{\\\"className\\\":\\\"LearnArticle_tblScroll__z9kbb\\\",\\\"children\\\":[\\\"$\\\",\\\"table\\\",null,{\\\"className\\\":\\\"LearnArticle_tbl__0yNgv\\\",\\\"children\\\":[[\\\"$\\\",\\\"thead\\\",null,{\\\"children\\\":[\\\"$\\\",\\\"tr\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"th\\\",\\\"0\\\",{\\\"children\\\":\\\"比較項目\\\"}],[\\\"$\\\",\\\"th\\\",\\\"1\\\",{\\\"children\\\":\\\"毛利率\\\"}],[\\\"$\\\",\\\"th\\\",\\\"2\\\",{\\\"children\\\":\\\"營業利益率\\\"}]]}]}],\\\"$L18\\\"]}]}],\\\"$L19\\\"]]}],\\\"$L1a\\\",\\\"$L1b\\\",\\\"$L1c\\\",\\\"$L1d\\\",\\\"$L1e\\\"],null]}]]}]}]\\n\"])</script><script>self.__next_f.push([1,\"18:[\\\"$\\\",\\\"tbody\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"tr\\\",\\\"0\\\",{\\\"children\\\":[[\\\"$\\\",\\\"td\\\",\\\"0\\\",{\\\"children\\\":\\\"反映什麼？\\\"}],[\\\"$\\\",\\\"td\\\",\\\"1\\\",{\\\"children\\\":\\\"產品或服務的「直接」獲利能力\\\"}],[\\\"$\\\",\\\"td\\\",\\\"2\\\",{\\\"children\\\":\\\"公司「本業」的綜合獲利能力\\\"}]]}],[\\\"$\\\",\\\"tr\\\",\\\"1\\\",{\\\"children\\\":[[\\\"$\\\",\\\"td\\\",\\\"0\\\",{\\\"children\\\":\\\"考慮了什麼成本？\\\"}],[\\\"$\\\",\\\"td\\\",\\\"1\\\",{\\\"children\\\":\\\"只考慮銷貨的直接成本\\\"}],[\\\"$\\\",\\\"td\\\",\\\"2\\\",{\\\"children\\\":\\\"考慮直接成本＋所有營業費用\\\"}]]}],[\\\"$\\\",\\\"tr\\\",\\\"2\\\",{\\\"children\\\":[[\\\"$\\\",\\\"td\\\",\\\"0\\\",{\\\"children\\\":\\\"數字代表意義\\\"}],[\\\"$\\\",\\\"td\\\",\\\"1\\\",{\\\"children\\\":\\\"數字高，代表產品有競爭力或成本低\\\"}],[\\\"$\\\",\\\"td\\\",\\\"2\\\",{\\\"children\\\":\\\"數字高，代表公司經營效率好、費用控制得當\\\"}]]}]]}]\\n19:[\\\"$\\\",\\\"figure\\\",\\\"2\\\",{\\\"className\\\":\\\"LearnArticle_fig__uoT7r\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"LearnArticle_figFrame__jJ7E4\\\",\\\"children\\\":\\\"✓毛利率是否穩定或上升？✓營業利益率是否為正數？✓與同業相比是高還是低？✓兩者差距是否突然擴大？\\\"}],[\\\"$\\\",\\\"figcaption\\\",null,{\\\"className\\\":\\\"LearnArticle_figCap__LnUbb\\\",\\\"children\\\":\\\"財報速讀檢查清單\\\"}]]}]\\n\"])</script><script>self.__next_f.push([1,\"1a:[\\\"$\\\",\\\"section\\\",\\\"sec-4\\\",{\\\"id\\\":\\\"sec-4\\\",\\\"className\\\":\\\"LearnArticle_section__hLVjU\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"LearnArticle_h2__NmJ08\\\",\\\"children\\\":\\\"四、兩個數字差距很大，是警訊嗎？\\\"}],[[\\\"$\\\",\\\"p\\\",\\\"0\\\",{\\\"className\\\":\\\"LearnArticle_p__aZlQ1\\\",\\\"children\\\":\\\"當你發現一家公司毛利率很高，但營業利益率卻低很多，這就是一個需要留意的訊號。這代表公司的「營業費用」吃掉了大部分的利潤。例如，一家公司毛利率 50%，但營業利益率只有 5%，表示每賺 100 元，就有 45 元花在薪資、廣告、研發等費用上。\\\"}],[\\\"$\\\",\\\"ol\\\",\\\"1\\\",{\\\"className\\\":\\\"LearnArticle_listNum__86N5S\\\",\\\"children\\\":[[\\\"$\\\",\\\"li\\\",\\\"0\\\",{\\\"children\\\":\\\"找出原因：差距變大是因為行銷費用增加？還是研發投入變多？前者可能是短期策略，後者可能為了長期發展，需要進一步分析。\\\"}],[\\\"$\\\",\\\"li\\\",\\\"1\\\",{\\\"children\\\":\\\"設定門檻：一般來說，如果營業費用佔毛利的比重超過 50%，就需要特別小心，檢視公司的費用控管能力。\\\"}],[\\\"$\\\",\\\"li\\\",\\\"2\\\",{\\\"children\\\":\\\"與同業比較：不同產業的費用結構不同，例如品牌廠的行銷費高，生技公司的研發費高。把數字拿去跟同業比較，才能判斷是高還是低。\\\"}]]}]]]}]\\n\"])</script><script>self.__next_f.push([1,\"1b:[\\\"$\\\",\\\"section\\\",\\\"sec-5\\\",{\\\"id\\\":\\\"sec-5\\\",\\\"className\\\":\\\"LearnArticle_section__hLVjU\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"LearnArticle_h2__NmJ08\\\",\\\"children\\\":\\\"五、如何用股市大佬，快速查詢公司的獲利能力？\\\"}],[[\\\"$\\\",\\\"p\\\",\\\"0\\\",{\\\"className\\\":\\\"LearnArticle_p__aZlQ1\\\",\\\"children\\\":\\\"想知道一家公司的毛利率和營業利益率趨勢，不用自己翻閱厚重的財報慢慢算。在股市大佬的「個股透視」頁面，我們已經將歷年的數據整理成互動圖表，讓你一眼就能看出公司的獲利結構與長期變化，幫你省下大量研究時間。\\\"}]]]}]\\n\"])</script><script>self.__next_f.push([1,\"1c:[\\\"$\\\",\\\"section\\\",\\\"sec-6\\\",{\\\"id\\\":\\\"sec-6\\\",\\\"className\\\":\\\"LearnArticle_section__hLVjU\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"LearnArticle_h2__NmJ08\\\",\\\"children\\\":\\\"常見問題 FAQ\\\"}],[[\\\"$\\\",\\\"div\\\",\\\"0\\\",{\\\"className\\\":\\\"LearnArticle_faq__cemBp\\\",\\\"children\\\":[[\\\"$\\\",\\\"details\\\",\\\"0\\\",{\\\"className\\\":\\\"LearnArticle_faqItem__I9h0U\\\",\\\"children\\\":[[\\\"$\\\",\\\"summary\\\",null,{\\\"children\\\":\\\"毛利率是越高越好嗎？有沒有參考標準？\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"LearnArticle_faqA__IPuvc\\\",\\\"children\\\":\\\"是的，通常越高越好，但標準是相對的，必須跟「自己過去」和「同業」比較。例如，半導體業的 50% 和餐飲業的 50% 意義完全不同。重點是觀察趨勢是否穩定或向上。\\\"}]]}],[\\\"$\\\",\\\"details\\\",\\\"1\\\",{\\\"className\\\":\\\"LearnArticle_faqItem__I9h0U\\\",\\\"children\\\":[[\\\"$\\\",\\\"summary\\\",null,{\\\"children\\\":\\\"為什麼有些公司毛利率很高，但營業利益率卻很低？\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"LearnArticle_faqA__IPuvc\\\",\\\"children\\\":\\\"這通常代表公司的「營業費用」很高，可能投入大量行銷廣告（如品牌消費品）、研發費用（如生技、軟體業），或是管理開銷過大。這反映了公司的經營策略與費用控管效率。\\\"}]]}],[\\\"$\\\",\\\"details\\\",\\\"2\\\",{\\\"className\\\":\\\"LearnArticle_faqItem__I9h0U\\\",\\\"children\\\":[[\\\"$\\\",\\\"summary\\\",null,{\\\"children\\\":\\\"毛利率或營業利益率出現負數，代表什麼？\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"LearnArticle_faqA__IPuvc\\\",\\\"children\\\":\\\"毛利率為負，代表產品「賣一件賠一件」，連原料成本都無法回收，情況非常嚴重。營業利益率為負，則代表公司本業虧損，需要靠投資或其他業外收入來彌補。\\\"}]]}],[\\\"$\\\",\\\"details\\\",\\\"3\\\",{\\\"className\\\":\\\"LearnArticle_faqItem__I9h0U\\\",\\\"children\\\":[[\\\"$\\\",\\\"summary\\\",null,{\\\"children\\\":\\\"我應該只看這兩個指標來決定買賣嗎？\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"LearnArticle_faqA__IPuvc\\\",\\\"children\\\":\\\"絕對不行。這兩個指標只反映公司的「獲利能力」，但無法看出它的「成長性」或「財務健康狀況」。投資決策需要綜合判斷，建議搭配營收成長率、現金流量等其他指標一起看。\\\"}]]}]]}]]]}]\\n\"])</script><script>self.__next_f.push([1,\"1d:[\\\"$\\\",\\\"section\\\",\\\"sec-7\\\",{\\\"id\\\":\\\"sec-7\\\",\\\"className\\\":\\\"LearnArticle_section__hLVjU\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"LearnArticle_h2__NmJ08\\\",\\\"children\\\":\\\"總結\\\"}],[[\\\"$\\\",\\\"p\\\",\\\"0\\\",{\\\"className\\\":\\\"LearnArticle_p__aZlQ1\\\",\\\"children\\\":\\\"想判斷公司賺錢的真本事，不要只看毛利率，一定要把營業利益率拿來一起比較。觀察兩者的長期趨勢與差距，才能幫你避開那些看起來產品很賺錢，但實際開銷驚人的公司。\\\"}]]]}]\\n1e:[\\\"$\\\",\\\"section\\\",\\\"sec-8\\\",{\\\"id\\\":\\\"sec-8\\\",\\\"className\\\":\\\"LearnArticle_section__hLVjU\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"LearnArticle_h2__NmJ08\\\",\\\"children\\\":\\\"延伸閱讀\\\"}],[[\\\"$\\\",\\\"ul\\\",\\\"0\\\",{\\\"className\\\":\\\"LearnArticle_list__WjxqC\\\",\\\"children\\\":[[\\\"$\\\",\\\"li\\\",\\\"0\\\",{\\\"children\\\":[[\\\"$\\\",\\\"$L17\\\",\\\"0-到「個股透視」查\\\",{\\\"href\\\":\\\"/diary\\\",\\\"className\\\":\\\"LearnArticle_link__gMwHV\\\",\\\"children\\\":\\\"到「個股透視」查詢最新財報數字\\\"}]]}],[\\\"$\\\",\\\"li\\\",\\\"1\\\",{\\\"children\\\":[[\\\"$\\\",\\\"$L17\\\",\\\"0-更多財報名詞解釋\\\",{\\\"href\\\":\\\"/school\\\",\\\"className\\\":\\\"LearnArticle_link__gMwHV\\\",\\\"children\\\":\\\"更多財報名詞解釋，請看台股學堂\\\"}]]}],[\\\"$\\\",\\\"li\\\",\\\"2\\\",{\\\"children\\\":[[\\\"$\\\",\\\"$L17\\\",\\\"0-想知道哪些產業族\\\",{\\\"href\\\":\\\"/diary\\\",\\\"className\\\":\\\"LearnArticle_link__gMwHV\\\",\\\"children\\\":\\\"想知道哪些產業族群獲利最好？\\\"}]]}]]}]]]}]\\n\"])</script><script>self.__next_f.push([1,\"13:[[\\\"$\\\",\\\"meta\\\",\\\"0\\\",{\\\"charSet\\\":\\\"utf-8\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"1\\\",{\\\"name\\\":\\\"viewport\\\",\\\"content\\\":\\\"width=device-width, initial-scale=1\\\"}]]\\nf:null\\n\"])</script><script>self.__next_f.push([1,\"1f:I[80622,[],\\\"IconMark\\\"]\\n11:{\\\"metadata\\\":[[\\\"$\\\",\\\"title\\\",\\\"0\\\",{\\\"children\\\":\\\"毛利率、營業利益率差在哪？財報看這2個數字，秒懂公司真賺錢還假賺錢｜股市大佬 TradeBoss\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"1\\\",{\\\"name\\\":\\\"description\\\",\\\"content\\\":\\\"看到財報一堆數字就頭痛？毛利率、營業利益率好像都代表「賺錢」，但數字高低到底差在哪？搞懂這兩個指標，你就能判斷一家公司賺錢的「品質」好不好。\\\"}],[\\\"$\\\",\\\"link\\\",\\\"2\\\",{\\\"rel\\\":\\\"icon\\\",\\\"href\\\":\\\"/favicon.ico\\\",\\\"type\\\":\\\"image/x-icon\\\",\\\"sizes\\\":\\\"16x16\\\"}],[\\\"$\\\",\\\"$L1f\\\",\\\"3\\\",{}]],\\\"error\\\":null,\\\"digest\\\":\\\"$undefined\\\"}\\n\"])</script><script>self.__next_f.push([1,\"16:\\\"$11:metadata\\\"\\n\"])</script></body></html>","rsc":"1:\"$Sreact.fragment\"\n2:I[81259,[\"2619\",\"static/chunks/2619-04bc32f026a0d946.js\",\"7177\",\"static/chunks/app/layout-4382c12d510386d3.js\"],\