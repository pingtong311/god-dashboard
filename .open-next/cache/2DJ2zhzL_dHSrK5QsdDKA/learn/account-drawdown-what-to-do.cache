n\":true,\"children\":[\"$\",\"$15\",null,{\"fallback\":null,\"children\":\"$L16\"}]}]}]]}]\n17:I[52619,[\"2619\",\"static/chunks/2619-04bc32f026a0d946.js\",\"6309\",\"static/chunks/app/learn/%5Bslug%5D/page-f7b99344f7e2ee16.js\"],\"\"]\nd:[\"$\",\"div\",null,{\"className\":\"LearnArticle_wrap__LIQ8G\",\"children\":[\"$\",\"article\",null,{\"className\":\"LearnArticle_article__2nBbk\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_meta__etj_G\",\"children\":[[\"$\",\"$L17\",null,{\"className\":\"LearnArticle_cat__GQMlg\",\"href\":\"/learn?c=strategy\",\"children\":\"策略解析\"}],[\"$\",\"span\",null,{\"className\":\"LearnArticle_read__QEj6a\",\"children\":\"閱讀約 7 分鐘\"}]]}],[\"$\",\"h1\",null,{\"className\":\"LearnArticle_title__0_la8\",\"children\":\"帳戶回撤怎麼辦？3 步驟檢視策略盲點，別讓情緒左右判斷\"}],[\"$\",\"details\",null,{\"className\":\"LearnArticle_toc__LcSAa\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"LearnArticle_tocSummary__YBddG\",\"children\":\"本文目錄\"}],[\"$\",\"ol\",null,{\"className\":\"LearnArticle_tocList__Rq_Lz\",\"children\":[[\"$\",\"li\",\"sec-1\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-1\",\"children\":\"一、什麼是帳戶回撤？為何它是交易的必經之路？\"}]}],[\"$\",\"li\",\"sec-2\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-2\",\"children\":\"二、帳戶回撤率怎麼算？避免只看絕對金額的誤區\"}]}],[\"$\",\"li\",\"sec-3\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-3\",\"children\":\"三、為什麼會發生帳戶回撤？先找出原因才能對症下藥\"}]}],[\"$\",\"li\",\"sec-4\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-4\",\"children\":\"四、遇到回撤該怎麼辦？3 步驟客觀檢視你的交易策略\"}]}],[\"$\",\"li\",\"sec-5\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-5\",\"children\":\"五、如何從回撤中學習？為下次機會做好準備\"}]}],[\"$\",\"li\",\"sec-6\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-6\",\"children\":\"常見問題 FAQ\"}]}],[\"$\",\"li\",\"sec-7\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-7\",\"children\":\"總結\"}]}],[\"$\",\"li\",\"sec-8\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-8\",\"children\":\"延伸閱讀\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"LearnArticle_body__6B7Mb\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_intro__ATV5c\",\"children\":\"當你打開交易軟體，看到帳戶數字一路向下，是不是感到手足無措，不知道該停損還是加碼？這種情緒上的困擾，往往來自於對「帳戶回撤」的不理解。這篇文章將帶你跳脫情緒，用客觀的數據分析帳戶回撤的真正原因，並學會一套檢視策略的實用方法，幫助你在市場波動中保持冷靜。\"}],[[\"$\",\"figure\",\"figure-0\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"虧 3 次每次 −1%賺 2 次每次 +1%勝率 40% 也可能是正期望，前提是賺的比虧的大、且扣得起成本短線先扣約 0.24% 當沖成本，再看還剩多少\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"示意圖｜期望值：勝率要配上平均賺賠，再扣成本（教學結構，不是某檔實盤）\"}]]}]],[\"$\",\"div\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"帳戶回撤是交易常態，先別慌張\"}],[\"$\",\"li\",\"1\",{\"children\":\"學會計算回撤率，量化真實風險\"}],[\"$\",\"li\",\"2\",{\"children\":\"透過 3 步驟，客觀檢視策略盲點\"}],[\"$\",\"li\",\"3\",{\"children\":\"從回撤中學習，優化交易決策\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、什麼是帳戶回撤？為何它是交易的必經之路？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"帳戶回撤（Drawdown）指的是從帳戶淨值歷史最高點，到隨後任一個最低點之間的最大跌幅。舉例來說，如果你的帳戶從 100 萬元成長到 120 萬元，隨後又跌到 108 萬元，那麼這次回撤就是從 120 萬元跌到 108 萬元，跌幅為 12 萬元。回撤是任何交易者都無法避免的正常現象，無論是新手或經驗豐富的老手，都會在交易生涯中經歷不同程度的回撤。理解這一點，是保持平常心、避免情緒化決策的第一步。\"}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、帳戶回撤率怎麼算？避免只看絕對金額的誤區\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"只看絕對金額的跌幅，很容易忽略資金規模的差異。例如，帳戶從 100 萬跌到 90 萬，跌了 10 萬；另一個帳戶從 1000 萬跌到 990 萬，也是跌了 10 萬。雖然金額相同，但對前者來說是 10% 的損失，對後者卻僅是 1% 的損失。因此，我們更常使用「回撤率」來衡量。回撤率的計算公式為：(歷史高點 - 當前低點) ÷ 歷史高點 × 100%。這個百分比能更客觀地反映你的資金風險承受能力與策略的穩健性。學會用百分比思考，才能更精準地評估每次回撤的影響。\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"情境\"}],[\"$\",\"th\",\"1\",{\"children\":\"歷史高點\"}],[\"$\",\"th\",\"2\",{\"children\":\"當前低點\"}],[\"$\",\"th\",\"3\",{\"children\":\"絕對跌幅\"}],[\"$\",\"th\",\"4\",{\"children\":\"回撤率\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"小明帳戶\"}],[\"$\",\"td\",\"1\",{\"children\":\"1,000,000 元\"}],[\"$\",\"td\",\"2\",{\"children\":\"900,000 元\"}],[\"$\",\"td\",\"3\",{\"children\":\"100,000 元\"}],[\"$\",\"td\",\"4\",{\"children\":\"10.00%\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"老王帳戶\"}],[\"$\",\"td\",\"1\",{\"children\":\"10,000,000 元\"}],[\"$\",\"td\",\"2\",{\"children\":\"9,900,000 元\"}],[\"$\",\"td\",\"3\",{\"children\":\"100,000 元\"}],[\"$\",\"td\",\"4\",{\"children\":\"1.00%\"}]]}]]}]]}]}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、為什麼會發生帳戶回撤？先找出原因才能對症下藥\"}],[\"$L18\",\"$L19\"]]}],\"$L1a\",\"$L1b\",\"$L1c\",\"$L1d\",\"$L1e\"],null]}]]}]}]\n18:[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"帳戶回撤的原因很多元，絕非單一因素造成。常見的原因包括：市場環境變化（例如從多頭轉為盤整或空頭）、交易策略失效（原本有效的策略，在特定市場條件下不再適用）、或是個人情緒影響（例如過度自信導致部位過大、或恐慌性殺出）。找出回撤的根本原因，是解決問題的第一步。是市場趨勢改變了，還是你的策略有漏洞？或是你被新聞或社群討論影響了判斷？如上圖所示，仔細檢視這些環節，才能避免下次重蹈覆轍。\"}]\n19:[\"$\",\"figure\",\"1\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"✓交易紀錄完整？✓勝率與盈虧比？✓市場環境變了？✓情緒影響判斷？\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"檢視策略盲點清單\"}]]}]\n1a:[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、遇到回撤該怎麼辦？3 步驟客觀檢視你的交易策略\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"當回撤發生時，最重要的是保持冷靜，並啟動一套客觀的檢視流程，而不是憑直覺或情緒反應。以下提供 3 個步驟，幫助你系統性地分析：第一步，『數據化檢視』，仔細攤開你的交易紀錄，檢視勝率、盈虧比、平均獲利與虧損金額，看看是否有明顯的變化。第二步，『策略有效性評估』，確認你的交易策略是否偏離了最初的設定？市場環境是否已發生根本性改變，導致策略不再適用？第三步，『心理層面反思』，回想在決策過程中，是否有受到恐懼、貪婪或急躁等情緒影響？是否出現過度交易或部位失控的情況？\"}],[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"數據化檢視：分析交易勝率、盈虧比、平均獲利與虧損。\"}],[\"$\",\"li\",\"1\",{\"children\":\"策略有效性評估：檢查是否偏離策略，市場環境是否改變。\"}],[\"$\",\"li\",\"2\",{\"children\":\"心理層面反思：檢視是否受情緒影響，避免過度交易。\"}]]}]]]}]\n1b:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、如何從回撤中學習？為下次機會做好準備\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"回撤不只是損失，更是寶貴的學習機會。每次回撤都是對你交易系統的一次壓力測試，能幫助你發現策略的弱點和自身的盲點。在完成上述的客觀檢視後，你應該根據分析結果，對你的交易策略進行調整與優化。這可能包括修改進出場條件、調整風險管理規則、或是重新評估適合的市場環境。記住，成功的交易者並非從不虧損，而是懂得如何從虧損中學習，不斷精進自己的交易系統。透過持續的學習與調整，你將能提升在市場中長期穩定的能力。\"}]]]}]\n1c:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"帳戶回撤率多少算正常？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"回撤率沒有絕對的「正常」標準，它會因個人交易策略、風險偏好和市場環境而異。一般而言，積極型策略的回撤率會較高，保守型策略則較低。重要的是，回撤率應該在你能承受的心理範圍內。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"回撤時該加碼攤平嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"在回撤時盲目加碼攤平，是非常危險的行為。這可能導致虧損擴大，甚至超出你的承受範圍。正確的做法是先冷靜分析回撤原因，確認策略是否依然有效，並嚴格遵守風險管理原則，而不是憑情緒進行操作。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"帳戶回撤跟停損有什麼關係？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"停損是控制單筆交易虧損的風險管理手段，而帳戶回撤則是整體帳戶淨值從高點滑落的累積性指標。設定合理的停損點，是避免單筆虧損過大，進而控制整體帳戶回撤幅度的重要方法。兩者都是風險管理的重要環節。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"新手該如何應對帳戶回撤？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"新手應對回撤的關鍵在於學習與紀律。首先要理解回撤是常態，其次是建立一套明確的交易計畫和風險管理規則，並嚴格執行。每次回撤後，都要回顧交易紀錄，分析原因，從錯誤中學習，逐步優化自己的交易系統。\"}]]}]]}]]]}]\n1d:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"帳戶回撤是交易的必然現象，關鍵在於如何客觀面對與分析。透過量化回撤率、系統性檢視策略盲點，並從中學習，才能將回撤轉化為提升交易能力的機會，幫助你在變動的市場中，建立更穩健的投資心態與策略。\"}]]]}]\n1e:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L17\",\"0-前往台股學堂，學\",{\"href\":\"/school\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"前往台股學堂，學習更多交易知識\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L17\",\"0-透過個股透視，深\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"透過個股透視，深入分析籌碼動向\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L17\",\"0-探索台股教學專欄\",{\"href\":\"/learn\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"探索台股教學專欄，精進你的交易技巧\"}]]}],[\"$\",\"li\",\"3\",{\"children\":[[\"$\",\"$L17\",\"0-股市大佬新手導覽\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"股市大佬新手導覽，帶你快速上手\"}]]}]]}]]]}]\n13:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\nf:null\n1f:I[80622,[],\"IconMark\"]\n11:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"帳戶回撤怎麼辦？3 步驟檢視策略盲點，別讓情緒左右判斷｜股市大佬 TradeBoss\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"當你打開交易軟體，看到帳戶數字一路向下，是不是感到手足無措，不知道該停損還是加碼？這種情緒上的困擾，往往來自於對「帳戶回撤」的不理解。這篇文章將帶你跳脫情緒，用客觀的數據分析帳戶回撤的真正原因，並學會一套檢視策略的實用方法，幫助你在市場波動中保持冷靜。\"}],[\"$\",\"link\",\"2\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}],[\"$\",\"$L1f\",\"3\",{}]],\"error\":null,\"digest\":\"$undefined\"}\n16:\"$11:metadata\"\n"}