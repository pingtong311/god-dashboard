,\"a\",null,{\"href\":\"#sec-8\",\"children\":\"延伸閱讀\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"LearnArticle_body__6B7Mb\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_intro__ATV5c\",\"children\":\"看盤時最常卡住的，不是少一個指標，而是同一個詞在不同頁意思不一樣。台股學堂就是為這件事而設：把日報和網站用到的名詞，拆成「是什麼、為什麼重要、怎麼用」。它是課程與辭典，不是選股清單，更不是叫你下單的地方。\"}],[],[\"$\",\"div\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"先用搜尋框找名詞，比一次讀完全部快\"}],[\"$\",\"li\",\"1\",{\"children\":\"第一次來：新手起步、籌碼面、技術型態\"}],[\"$\",\"li\",\"2\",{\"children\":\"名詞卡只解釋定義與讀法，不給進出指令\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、這一頁在教什麼、不教什麼\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"學堂開頭就寫：把日報和網站用到的名詞，一篇一篇講清楚；看不懂就來查，不用一次看完。每張名詞卡固定三塊：是什麼、為什麼重要、怎麼用；有風險的詞會多一塊警示。底部若有「前往某某頁」，只是跳到對應功能看資料，不是叫你在那一頁下單。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"一篇只講一個名詞\"}],[\"$\",\"li\",\"1\",{\"children\":\"用到再查，不必一次讀完\"}],[\"$\",\"li\",\"2\",{\"children\":\"連結是去看資料，不是去喊單\"}]]}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、搜尋與分區怎麼用\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"標題下方有搜尋框，可直接打「券資比」「集中度」「頭肩底」這類詞。有關鍵字時，頁面改列搜尋結果；找不到會提示換詞。沒搜尋時，上方是分區按鈕：全部、新手起步、研究工具、籌碼面、技術型態、指標面、大環境、歷史條件案例。點一個分區，只留下那一區的名詞卡。\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"你在頁面上會看到\"}],[\"$\",\"th\",\"1\",{\"children\":\"適合什麼時候用\"}],[\"$\",\"th\",\"2\",{\"children\":\"不要誤會成\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"搜尋框\"}],[\"$\",\"td\",\"1\",{\"children\":\"已經知道名詞、只想查定義\"}],[\"$\",\"td\",\"2\",{\"children\":\"全站選股搜尋\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"分區按鈕\"}],[\"$\",\"td\",\"1\",{\"children\":\"想依主題瀏覽\"}],[\"$\",\"td\",\"2\",{\"children\":\"今日必讀清單\"}]]}],[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"名詞卡標題\"}],[\"$\",\"td\",\"1\",{\"children\":\"先看一句導讀再決定要不要展開\"}],[\"$\",\"td\",\"2\",{\"children\":\"操作指令\"}]]}],[\"$\",\"tr\",\"3\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"前往功能頁\"}],[\"$\",\"td\",\"1\",{\"children\":\"到對應頁核對資料日與欄位\"}],[\"$\",\"td\",\"2\",{\"children\":\"不是跟單入口\"}]]}]]}]]}]}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、第一次來：先看這三個分區\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"頁面有一塊「第一次來？照這個順序看」。建議順序是：先看新手起步，搞懂當沖是什麼、胃納量與停損；再看籌碼面，搞懂集中度、隔日沖分點與券資比；然後看技術型態，用圖認識 W 底、M 頭這類形狀。最後才去歷史條件案例練習核對資料。那一區寫明：只做歷史教學，不提供方向或進出規則。\"}],[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"新手起步：制度與風險詞\"}],[\"$\",\"li\",\"1\",{\"children\":\"籌碼面：分點與集中度\"}],[\"$\",\"li\",\"2\",{\"children\":\"技術型態：先看圖再看字\"}]]}],[\"$\",\"figure\",\"2\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"✓新手起步✓籌碼面✓技術型態\"}],\"$L18\"]}]]]}],\"$L19\",\"$L1a\",\"$L1b\",\"$L1c\",\"$L1d\"],null]}]]}]}]\n18:[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"第一次三區\"}]\n19:[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、名詞卡展開後怎麼讀\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"每張卡預設收合，只看標題與一句導讀。點開後依序讀三塊：是什麼先對齊定義，為什麼重要只說明這個數字能回答什麼、不能回答什麼，怎麼用告訴你到站上哪一頁核對。有的卡會附簡單圖形。別的頁若用錨點連過來，例如學堂某一則的網址後面帶名詞編號，頁面會自動打開那一張，避免你只停在標題。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"先對齊定義，再看應用\"}],[\"$\",\"li\",\"1\",{\"children\":\"怎麼用是指去哪一頁核對\"}],[\"$\",\"li\",\"2\",{\"children\":\"圖形是形狀說明，不是買賣圖\"}]]}]]]}]\n1a:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、讀完名詞，下一步去哪\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"學堂解決的是「這個詞是什麼」。若你要找使用路線，去新手導覽；若要找完整操作說明，去使用手冊；若只是想繼續讀長文，去教學專欄。這三條路都還是在講怎麼看資料，不是在發今日標的。看不懂的詞隨時回學堂搜一次，比在聊天室問一句沒有資料日的結論安全。\"}]]]}]\n1b:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"一定要從第一篇看到最後一篇嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"不必。頁面寫的是用到再查。第一次來只要先走建議的三個分區，其餘等你在別的頁碰到再搜。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"名詞卡裡的例子是不是叫我去做？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"不是。例子只幫你對齊定義。怎麼用那一塊是帶你去核對資料頁，不是下單步驟。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"學堂和教學專欄差在哪？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"學堂是名詞與制度卡片，一篇一件事。教學專欄是較長的主題文，可依分類瀏覽。兩頁都不是選股喊單。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"看到「勝率」「符合率」能直接當明天依據嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"不能。學堂會把這類數字定義成歷史樣本比例，必須連同樣本數與資料日讀，不能外推下一次。\"}]]}]]}]]]}]\n1c:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"學堂用搜尋與分區查名詞。第一次來先看新手起步、籌碼面與技術型態。卡片只解釋讀法，不叫你下單。\"}]]]}]\n1d:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L17\",\"0-台股學堂\",{\"href\":\"/school\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"台股學堂\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L17\",\"0-新手導覽\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"新手導覽\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L17\",\"0-台股教學專欄\",{\"href\":\"/learn\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"台股教學專欄\"}]]}],[\"$\",\"li\",\"3\",{\"children\":[[\"$\",\"$L17\",\"0-使用手冊\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"使用手冊\"}]]}]]}]]]}]\n13:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\nf:null\n1e:I[80622,[],\"IconMark\"]\n11:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"股市大佬學堂怎麼讀？先看這3個分區｜股市大佬 TradeBoss\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"看盤時最常卡住的，不是少一個指標，而是同一個詞在不同頁意思不一樣。台股學堂就是為這件事而設：把日報和網站用到的名詞，拆成「是什麼、為什麼重要、怎麼用」。它是課程與辭典，不是選股清單，更不是叫你下單的地方。\"}],[\"$\",\"link\",\"2\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}],[\"$\",\"$L1e\",\"3\",{}]],\"error\":null,\"digest\":\"$undefined\"}\n16:\"$11:metadata\"\n"}