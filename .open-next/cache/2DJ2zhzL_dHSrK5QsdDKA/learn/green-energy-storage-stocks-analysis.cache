\",null,{\"children\":[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$15\",null,{\"fallback\":null,\"children\":\"$L16\"}]}]}]]}]\n17:I[52619,[\"2619\",\"static/chunks/2619-04bc32f026a0d946.js\",\"6309\",\"static/chunks/app/learn/%5Bslug%5D/page-f7b99344f7e2ee16.js\"],\"\"]\nd:[\"$\",\"div\",null,{\"className\":\"LearnArticle_wrap__LIQ8G\",\"children\":[\"$\",\"article\",null,{\"className\":\"LearnArticle_article__2nBbk\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_meta__etj_G\",\"children\":[[\"$\",\"$L17\",null,{\"className\":\"LearnArticle_cat__GQMlg\",\"href\":\"/learn?c=themes\",\"children\":\"題材專欄\"}],[\"$\",\"span\",null,{\"className\":\"LearnArticle_read__QEj6a\",\"children\":\"閱讀約 7 分鐘\"}]]}],[\"$\",\"h1\",null,{\"className\":\"LearnArticle_title__0_la8\",\"children\":\"綠能儲能概念股怎麼挑？3 個指標看懂誰在賺錢，避開只會炒話題的公司\"}],[\"$\",\"details\",null,{\"className\":\"LearnArticle_toc__LcSAa\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"LearnArticle_tocSummary__YBddG\",\"children\":\"本文目錄\"}],[\"$\",\"ol\",null,{\"className\":\"LearnArticle_tocList__Rq_Lz\",\"children\":[[\"$\",\"li\",\"sec-1\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-1\",\"children\":\"一、為什麼綠能和儲能總是被綁在一起談？\"}]}],[\"$\",\"li\",\"sec-2\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-2\",\"children\":\"二、綠能產業鏈大解析：誰在最上游？誰最賺錢？\"}]}],[\"$\",\"li\",\"sec-3\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-3\",\"children\":\"三、第一個關鍵指標：營收連續成長，代表訂單沒斷過\"}]}],[\"$\",\"li\",\"sec-4\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-4\",\"children\":\"四、第二個關鍵指標：毛利率穩定或提升，代表有議價能力\"}]}],[\"$\",\"li\",\"sec-5\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-5\",\"children\":\"五、第三個關鍵指標：確認綠能業務佔比，誰是真槍實彈？\"}]}],[\"$\",\"li\",\"sec-6\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-6\",\"children\":\"常見問題 FAQ\"}]}],[\"$\",\"li\",\"sec-7\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-7\",\"children\":\"總結\"}]}],[\"$\",\"li\",\"sec-8\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-8\",\"children\":\"延伸閱讀\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"LearnArticle_body__6B7Mb\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_intro__ATV5c\",\"children\":\"新聞整天在說綠能、儲能是未來趨勢，打開看盤軟體，相關概念股一大串，但股價常常一天大漲、隔天大跌，根本不知道該從何看起。這篇文章就是要帶你拆解這個複雜的產業，搞懂不同公司在產業鏈中扮演的角色，以及如何判斷誰是真的有接到訂單在賺錢。\"}],[[\"$\",\"figure\",\"figure-0\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"越後面越熱鬧，通常也越貴、越好離開佈局沒新聞命名故事出現擁擠人人都知退燒利多變鈍新聞出現時，常常已經不是第一段\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"示意圖｜題材四階段：佈局 → 命名 → 擁擠 → 退燒（教學結構，不是某檔實盤）\"}]]}]],[\"$\",\"div\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"綠能產業不只太陽能，還包含風電、儲能系統，各有不同旺季與題材。\"}],[\"$\",\"li\",\"1\",{\"children\":\"判斷公司實力，要看「營收成長率」與「毛利率」，確認獲利是否跟上股價。\"}],[\"$\",\"li\",\"2\",{\"children\":\"儲能是綠能的關鍵配套，注意「台電標案」進度是觀察儲能廠商業績的重要線索。\"}],[\"$\",\"li\",\"3\",{\"children\":\"許多公司只是「沾邊」概念股，要從財報確認綠能業務佔比，避免追高。\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、為什麼綠能和儲能總是被綁在一起談？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"你可能常聽到「綠能儲能」四個字連在一起，這是因為它們是互補的夥伴。太陽能和風力發電雖然乾淨，但發電量不穩定，有太陽、有風才有電。儲能系統就像一個超大型的行動電源，可以在發電多的時候先把電存起來，等到用電高峰或沒太陽、沒風的時候再放出來，解決「靠天吃飯」的問題。因此，綠能發展越快，對儲能的需求就越大。\"}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、綠能產業鏈大解析：誰在最上游？誰最賺錢？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"整個綠能產業可以粗略分成「發電」和「儲電」兩大部分，每一部分又有很多環節。有些公司做原料，有些做零件，有些專門蓋電廠。了解一家公司在產業鏈中的位置，能幫助你判斷它的獲利模式和風險。一般來說，掌握關鍵技術或處於寡占市場的廠商，議價能力會比較強。\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"次產業別\"}],[\"$\",\"th\",\"1\",{\"children\":\"主要業務\"}],[\"$\",\"th\",\"2\",{\"children\":\"觀察重點\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"太陽能\"}],[\"$\",\"td\",\"1\",{\"children\":\"模組、電池、逆變器、電廠建置\"}],[\"$\",\"td\",\"2\",{\"children\":\"國際矽晶圓價格、國內電廠標案\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"風力發電\"}],[\"$\",\"td\",\"1\",{\"children\":\"風機塔架、葉片、水下基礎、運維\"}],[\"$\",\"td\",\"2\",{\"children\":\"離岸風場開發進度、躉購費率\"}]]}],[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"儲能系統\"}],[\"$\",\"td\",\"1\",{\"children\":\"電池芯、電力調節系統(PCS)、案場整合\"}],[\"$\",\"td\",\"2\",{\"children\":\"台電標案進度、儲能櫃建置量\"}]]}]]}]]}]}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、第一個關鍵指標：營收連續成長，代表訂單沒斷過\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"聽到好消息，股價先漲了，但公司到底有沒有真的接到訂單、賺到錢？最直接的證據就是「營收」。你可以觀察公司的「月營收年增率」（跟去年同個月比），如果能連續 3 個月以上都成長超過 20%，通常代表業務真的在擴張，而不是只有短期題材。反之，如果股價漲很多，營收卻沒跟上，就要特別小心。\"}],\"$L18\",\"$L19\"]]}],\"$L1a\",\"$L1b\",\"$L1c\",\"$L1d\",\"$L1e\"],null]}]]}]}]\n18:[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"打開財報，找到「每月營收」資料。\"}],[\"$\",\"li\",\"1\",{\"children\":\"計算「年增率（YoY）」，看是否連續數月正成長。\"}],[\"$\",\"li\",\"2\",{\"children\":\"門檻參考：連續 3 個月年增率 > 20%，代表成長動能強勁。\"}]]}]\n19:[\"$\",\"figure\",\"2\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"!只看題材不看財報!把沾邊股當純種股!忽略政策變動風險!沒注意原物料成本\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"常見的觀察誤區\"}]]}]\n1a:[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、第二個關鍵指標：毛利率穩定或提升，代表有議價能力\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"營收成長很重要，但如果都是做一筆賠一筆的生意，那也沒用。「毛利率」這個數字，就是看公司做生意的「賺頭」好不好。如果一家公司營收增加，毛利率也能維持穩定甚至提升，代表它的產品有競爭力，不用殺價搶訂單。如果營收暴增，毛利率卻一直下滑，可能就是接到利潤很差的案子，對長期獲利不見得是好事。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"毛利率 ＝ (營業收入 - 營業成本) / 營業收入。\"}],[\"$\",\"li\",\"1\",{\"children\":\"觀察至少最近四季的毛利率走勢，是往上還是往下。\"}],[\"$\",\"li\",\"2\",{\"children\":\"常見錯誤：只看營收很高，卻沒發現是來自低毛利的標案。\"}]]}]]]}]\n1b:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、第三個關鍵指標：確認綠能業務佔比，誰是真槍實彈？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"市場上很多公司被歸類為「綠能概念股」，但它原本可能是做電子零件或營建的，綠能只是其中一小部分新業務。這種「沾邊」的公司，股價很容易被題材帶動，但實際貢獻獲利卻很少。在研究前，可以先去公司的官網或年報，看看綠能相關產品佔總營收的比例有多高。佔比超過 30% 以上，才能算是比較純正的綠能股，業績也才會跟產業趨勢有較高的連動。\"}],[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"尋找公司年報或法說會簡報。\"}],[\"$\",\"li\",\"1\",{\"children\":\"確認「產品營收佔比」項目。\"}],[\"$\",\"li\",\"2\",{\"children\":\"判斷門檻：綠能相關業務佔總營收 > 30%，關聯度較高。\"}]]}]]]}]\n1c:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"太陽能、風力發電、儲能，哪個前景比較好？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"這三者是互補關係，不是誰取代誰。太陽能建置速度快，但晚上沒電；離岸風電在冬季發電量大，剛好補足用電缺口；儲能則是兩者都需要的重要配套。不同階段的政策重點不同，輪流會有市場關注度。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"很多電子廠也說自己是儲能概念股，這可信嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"許多電子廠確實有能力切入儲能的零組件，例如電源供應器、電池管理系統等。但你需要確認的是，這項新業務佔它整體營收的比例有多高？如果不到 5%，那對公司獲利的影響就很小，股價反應可能多為短期題材。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"看到新聞說某公司拿到台電大單，可以馬上跟進嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"先冷靜一下。首先，要去公開資訊觀測站確認公告的真實性與合約金額。其次，標案的利潤通常不高，要回頭檢視這家公司的毛利率變化，評估對獲利的實際貢獻。不要只看消息就急著做決定。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"國際油價下跌，會影響綠能股的表現嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"理論上，油價下跌會降低傳統能源的成本，可能會減緩各國推動綠能的急迫性。但目前全球減碳已是長期趨勢，多數國家的能源政策不會因為短期油價波動而輕易改變。因此影響是短期的心理層面居多，長期發展趨勢更為重要。\"}]]}]]}]]]}]\n1d:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"總結來說，觀察綠能儲能產業，不能只聽新聞題材。養成習慣，打開財報檢查營收成長與毛利率變化，並確認相關業務佔公司整體的比例，才能幫你找到在浪潮中真正站得穩的公司。\"}]]]}]\n1e:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L17\",\"0-到「族群透視」看\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"到「族群透視」看懂產業上下游\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L17\",\"0-用「個股透視」深\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"用「個股透視」深入研究公司財報\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L17\",\"0-不熟財報名詞？來\",{\"href\":\"/school\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"不熟財報名詞？來「台股學堂」打好基礎\"}]]}]]}]]]}]\n13:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\nf:null\n1f:I[80622,[],\"IconMark\"]\n11:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"綠能儲能概念股怎麼挑？3 個指標看懂誰在賺錢，避開只會炒話題的公司｜股市大佬 TradeBoss\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"新聞整天在說綠能、儲能是未來趨勢，打開看盤軟體，相關概念股一大串，但股價常常一天大漲、隔天大跌，根本不知道該從何看起。這篇文章就是要帶你拆解這個複雜的產業，搞懂不同公司在產業鏈中扮演的角色，以及如何判斷誰是真的有接到訂單在賺錢。\"}],[\"$\",\"link\",\"2\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}],[\"$\",\"$L1f\",\"3\",{}]],\"error\":null,\"digest\":\"$undefined\"}\n16:\"$11:metadata\"\n"}