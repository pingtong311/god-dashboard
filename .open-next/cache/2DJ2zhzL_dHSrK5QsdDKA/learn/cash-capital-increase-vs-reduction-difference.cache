sName\":\"LearnArticle_wrap__LIQ8G\",\"children\":[\"$\",\"article\",null,{\"className\":\"LearnArticle_article__2nBbk\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_meta__etj_G\",\"children\":[[\"$\",\"$L18\",null,{\"className\":\"LearnArticle_cat__GQMlg\",\"href\":\"/learn?c=rules\",\"children\":\"制度與工具\"}],[\"$\",\"span\",null,{\"className\":\"LearnArticle_read__QEj6a\",\"children\":\"閱讀約 8 分鐘\"}]]}],[\"$\",\"h1\",null,{\"className\":\"LearnArticle_title__0_la8\",\"children\":\"現金增資、減資是什麼？股價會漲還跌？一篇看懂對股東的影響\"}],[\"$\",\"details\",null,{\"className\":\"LearnArticle_toc__LcSAa\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"LearnArticle_tocSummary__YBddG\",\"children\":\"本文目錄\"}],[\"$\",\"ol\",null,{\"className\":\"LearnArticle_tocList__Rq_Lz\",\"children\":[[\"$\",\"li\",\"sec-1\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-1\",\"children\":\"一、什麼是現金增資？公司為什麼要跟股東拿錢？\"}]}],[\"$\",\"li\",\"sec-2\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-2\",\"children\":\"二、現金增資後，我的股價會怎麼算？\"}]}],[\"$\",\"li\",\"sec-3\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-3\",\"children\":\"三、那什麼是減資？為什麼公司要把股本變小？\"}]}],[\"$\",\"li\",\"sec-4\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-4\",\"children\":\"四、減資後，我的股票和股價會如何變化？\"}]}],[\"$\",\"li\",\"sec-5\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-5\",\"children\":\"五、我該參與增資認購嗎？看到減資公告怎麼辦？\"}]}],[\"$\",\"li\",\"sec-6\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-6\",\"children\":\"常見問題 FAQ\"}]}],[\"$\",\"li\",\"sec-7\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-7\",\"children\":\"總結\"}]}],[\"$\",\"li\",\"sec-8\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-8\",\"children\":\"延伸閱讀\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"LearnArticle_body__6B7Mb\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_intro__ATV5c\",\"children\":\"看到新聞說某公司要「現金增資」或「減資」，股價不是漲停就是跌停，搞不懂是利多還利空？這篇文章會帶你拆解這兩者的差別，讓你下次看到公告，能自己判斷對股東是好是壞。\"}],[[\"$\",\"figure\",\"figure-0\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"沒扣成本的勝率，看起來都會比較漂亮0.029%手續費 1 折來回0.15%當沖證交稅0.06%滑價估計三項合計約 0.24%；留倉稅率更高，約 0.39%\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"示意圖｜當沖來回成本：1 折手續費 + 證交稅 + 滑價（教學結構，不是某檔實盤）\"}]]}]],[\"$\",\"div\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"現金增資是公司向股東要錢，股本變大，短期可能稀釋獲利。\"}],[\"$\",\"li\",\"1\",{\"children\":\"減資是公司把錢退還股東或彌補虧損，股本變小，能提升每股盈餘 (EPS)。\"}],[\"$\",\"li\",\"2\",{\"children\":\"增資價與市價的「折價幅度」是關鍵，折價太多可能引發賣壓。\"}],[\"$\",\"li\",\"3\",{\"children\":\"減資後股價會重新計算，雖然總資產不變，但股價數字會變高。\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、什麼是現金增資？公司為什麼要跟股東拿錢？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"「現金增資」白話說，就是公司需要用錢，決定發行新的股票，向市場上的投資人（包含你我）募集資金。這就像一個麵包店生意變好，老闆想開分店，但手頭資金不夠，於是找股東們再投入一些錢來擴大規模。公司拿到錢，就能做更多事。\"}],[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"擴建廠房、買新設備：這是最常見的理由，代表公司看好未來訂單，準備擴大產能。\"}],[\"$\",\"li\",\"1\",{\"children\":\"償還銀行貸款：降低負債可以減少利息支出，讓公司財務結構更健康。\"}],[\"$\",\"li\",\"2\",{\"children\":\"投入研發或新事業：為了公司的長期成長，需要資金開發新技術或跨足新領域。\"}],[\"$\",\"li\",\"3\",{\"children\":\"充實營運資金：有時只是為了讓公司手頭現金更充裕，應付日常開銷。\"}]]}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、現金增資後，我的股價會怎麼算？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"增資會讓公司總股數變多，像是在一鍋湯裡加了水，每股能分到的獲利（EPS）短期內可能會被稀釋。為了平衡新舊股東的權益，增資後會有一個「除權參考價」當作新的開盤價。關鍵在於「認購價」跟「市價」的差距。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"假設 A 公司增資前股價 120 元，打算發行新股，讓股東用 100 元的價格認購。增資後的參考價就會介於 120 元和 100 元之間，公式算起來大約是 118.2 元。這代表你的帳面價值會稍微縮水，但你有權利用 100 元的優惠價買進新股，把價值補回來。\"}],[\"$\",\"li\",\"1\",{\"children\":\"【帶得走的東西】請留意「折價幅度」。如果認購價比市價低太多（例如折價超過 20%），可能會讓沒錢或不想參與認購的股東，搶在增資前賣掉股票，造成股價下跌壓力。一般來說，折價 10-15% 是比較健康的範圍。\"}]]}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、那什麼是減資？為什麼公司要把股本變小？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"「減資」跟增資正好相反，是公司把股本變小的過程。你可以想像成麵包店老闆覺得店太多了管不過來，決定收掉幾間，把當初開店的錢退還給股東。減資主要有兩種，目的和影響完全不同，一定要分清楚。\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":\"$L19\"}],\"$L1a\"]]}],\"$L1b\",\"$L1c\",\"$L1d\",\"$L1e\",\"$L1f\"],null]}]]}]}]\n19:[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"項目\"}],[\"$\",\"th\",\"1\",{\"children\":\"現金減資 (退錢)\"}],[\"$\",\"th\",\"2\",{\"children\":\"彌補虧損減資 (瘦身)\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"目的\"}],[\"$\",\"td\",\"1\",{\"children\":\"公司現金太多沒地方投資，退還給股東。\"}],[\"$\",\"td\",\"2\",{\"children\":\"打掉帳面上的累積虧損，讓財報好看。\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"股東拿到什麼\"}],[\"$\",\"td\",\"1\",{\"children\":\"一筆現金，不用繳稅。\"}],[\"$\",\"td\",\"2\",{\"children\":\"沒有現金，但公司財務結構變乾淨。\"}]]}],[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"市場看法\"}],[\"$\",\"td\",\"1\",{\"children\":\"通常是中性偏多，代表公司營運穩健。\"}],[\"$\",\"td\",\"2\",{\"children\":\"短空長多，觀察公司能否藉此轉機。\"}]]}],[\"$\",\"tr\",\"3\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"判斷重點\"}],[\"$\",\"td\",\"1\",{\"children\":\"公司是真的沒成長機會，還是對未來沒信心？\"}],[\"$\",\"td\",\"2\",{\"children\":\"減資後，本業營運有沒有機會轉虧為盈？\"}]]}]]}]]}]\n1a:[\"$\",\"figure\",\"2\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"✓增資的錢用在哪？✓減資的目的是什麼？✓增資折價幅度多大？✓減資後營運會改善嗎？\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"看到公告後的思考清單\"}]]}]\n1b:[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、減資後，我的股票和股價會如何變化？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"減資後，你的股票總市值理論上不會變，但「股數」和「股價」會改變。這點常常讓新手混淆，以為自己賺到或賠錢了。實際上，你的總資產在減資基準日當天是不變的。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"假設 B 公司股價 50 元，宣布現金減資 20% (也就是每股退 2 元現金)。你手上有 1,000 股，市值 50,000 元。\"}],[\"$\",\"li\",\"1\",{\"children\":\"減資後，你會拿到 2,000 元現金 (2元 x 1,000股)，股票剩下 800 股。\"}],[\"$\",\"li\",\"2\",{\"children\":\"新的參考價會變成 (50元 - 2元) / (1 - 0.2) = 48 / 0.8 = 60 元。\"}],[\"$\",\"li\",\"3\",{\"children\":\"此時你的總資產 = (800股 x 60元) + 2,000元現金 = 48,000 + 2,000 = 50,000 元。總值不變！\"}],[\"$\",\"li\",\"4\",{\"children\":\"【常見錯誤】看到股價從 50 元變成 60 元，以為自己賺了 10 元價差。千萬別忘了，你的股數也變少了，總價值不變。後續會漲會跌，要看市場對這家公司「瘦身」後的未來評價。\"}]]}]]]}]\n1c:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、我該參與增資認購嗎？看到減資公告怎麼辦？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"面對增資或減資，與其問別人該不該參加，不如建立自己的判斷標準。這不是聽別人給的標的，而是理解公司行為背後的動機。你可以用下面幾個問題來幫助自己思考，做出更適合自己的決定。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"思考增資的錢用在哪裡：公司拿這筆錢，是去蓋廠擴張，還是只為了還債發薪水？前者通常比後者更有想像空間。\"}],[\"$\",\"li\",\"1\",{\"children\":\"判斷減資的真實目的：是現金太多大方退錢（現金減資），還是為了讓財報由負轉正（彌補虧損減資）？前者通常是體質好的公司，後者則要觀察營運是否真的有起色。\"}],[\"$\",\"li\",\"2\",{\"children\":\"檢查公司的過往紀錄：這家公司過去辦理增資或減資的誠信如何？有沒有達成當初宣稱的目標？\"}],[\"$\",\"li\",\"3\",{\"children\":\"評估自己的資金狀況：參與現金增資需要額外拿出一筆錢，減資則會暫時讓股票無法交易。這些是否會影響你的資金規劃？\"}]]}]]]}]\n1d:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"增資或減資的股票，多久會恢復交易？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"通常會有一段時間的「暫停交易」，讓公司處理相關股務作業，時間長短不一，大約是 5 到 10 個交易日。詳細時程需以公司在公開資訊觀測站的公告為準。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"我不想參加現金增資，可以怎麼做？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"你可以直接放棄認購權利，什麼都不用做。或者，在特定期間內，你可以將你的「認股權利」在市場上賣給別人，賺取一點價差，這通常在券商軟體上可以操作。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"為什麼公司減資彌補虧損後，股價反而會漲？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"因為減資讓公司的財務報表變得更乾淨，每股淨值會提升。這讓公司有機會重新開始，未來只要稍微賺錢，因為股本變小，算出來的 EPS 就會很好看，因此吸引了看好它轉機的投資人。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"增資拿到的新股票，跟我的老股票有什麼不一樣？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"沒有任何不一樣。增資發行的新股票，權利和義務都和原來的股票完全相同。一旦發放並上市交易後，它們就會合併在一起，無法區分彼此。\"}]]}]]}]]]}]\n1e:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"總結來說，增資是「眾人一起把餅做大」，關鍵在於未來能否分到更多；減資則是「把餅切成更少塊，讓每一塊更有價值」，關鍵在於公司體質是否真的改善。下次看到公告，先判斷背後的目的，就能做出更理性的決策。\"}]]]}]\n1f:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L18\",\"0-想了解更多財報名\",{\"href\":\"/school\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"想了解更多財報名詞？來台股學堂打好基礎\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L18\",\"0-查詢個股的增資減\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"查詢個股的增資減資歷史，就在個股透視頁\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L18\",\"0-查看近期有哪些公\",{\"href\":\"/s/2330\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"查看近期有哪些公司要除權息或增減資\"}]]}]]}]]]}]\n14:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\n10:null\n20:I[80622,[],\"IconMark\"]\n12:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"現金增資、減資是什麼？股價會漲還跌？一篇看懂對股東的影響｜股市大佬 TradeBoss\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"看到新聞說某公司要「現金增資」或「減資」，股價不是漲停就是跌停，搞不懂是利多還利空？這篇文章會帶你拆解這兩者的差別，讓你下次看到公告，能自己判斷對股東是好是壞。\"}],[\"$\",\"link\",\"2\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}],[\"$\",\"$L20\",\"3\",{}]],\"error\":null,\"digest\":\"$undefined\"}\n17:\"$12:metadata\"\n"}