D/page-f7b99344f7e2ee16.js\"],\"\"]\nd:[\"$\",\"div\",null,{\"className\":\"LearnArticle_wrap__LIQ8G\",\"children\":[\"$\",\"article\",null,{\"className\":\"LearnArticle_article__2nBbk\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_meta__etj_G\",\"children\":[[\"$\",\"$L17\",null,{\"className\":\"LearnArticle_cat__GQMlg\",\"href\":\"/learn?c=rules\",\"children\":\"制度與工具\"}],[\"$\",\"span\",null,{\"className\":\"LearnArticle_read__QEj6a\",\"children\":\"閱讀約 4 分鐘\"}]]}],[\"$\",\"h1\",null,{\"className\":\"LearnArticle_title__0_la8\",\"children\":\"零股交易要注意哪3件事？盤中撮合跟整股不一樣\"}],[\"$\",\"details\",null,{\"className\":\"LearnArticle_toc__LcSAa\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"LearnArticle_tocSummary__YBddG\",\"children\":\"本文目錄\"}],[\"$\",\"ol\",null,{\"className\":\"LearnArticle_tocList__Rq_Lz\",\"children\":[[\"$\",\"li\",\"sec-1\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-1\",\"children\":\"一、先承認：你買的是同一家公司，但不是同一張桌子\"}]}],[\"$\",\"li\",\"sec-2\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-2\",\"children\":\"二、價差與量，是零股最常被低估的成本\"}]}],[\"$\",\"li\",\"sec-3\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-3\",\"children\":\"三、定期定額遇到的是費用與節奏\"}]}],[\"$\",\"li\",\"sec-4\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-4\",\"children\":\"四、不要用零股練習需要深度的策略\"}]}],[\"$\",\"li\",\"sec-5\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-5\",\"children\":\"五、檢查清單\"}]}],[\"$\",\"li\",\"sec-6\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-6\",\"children\":\"常見問題 FAQ\"}]}],[\"$\",\"li\",\"sec-7\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-7\",\"children\":\"總結\"}]}],[\"$\",\"li\",\"sec-8\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-8\",\"children\":\"延伸閱讀\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"LearnArticle_body__6B7Mb\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_intro__ATV5c\",\"children\":\"買不起一張，就改買零股，這條路讓很多人第一次進到台股。門檻低，不代表規則比較寬鬆。盤中零股的撮合節奏、可以成交的量、以及你看到的價格，都跟整股不是同一張桌子。用整股的習慣去等零股，會覺得市場在整你；其實是你坐錯桌。\"}],[[\"$\",\"figure\",\"figure-0\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"沒扣成本的勝率，看起來都會比較漂亮0.029%手續費 1 折來回0.15%當沖證交稅0.06%滑價估計三項合計約 0.24%；留倉稅率更高，約 0.39%\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"示意圖｜當沖來回成本：1 折手續費 + 證交稅 + 滑價（教學結構，不是某檔實盤）\"}]]}]],[\"$\",\"div\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"零股與整股的撮合時間與對手深度不同\"}],[\"$\",\"li\",\"1\",{\"children\":\"價差與成交不連續，比較容易發生「看得到吃不到」\"}],[\"$\",\"li\",\"2\",{\"children\":\"定期定額買零股，仍要算費用佔比\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、先承認：你買的是同一家公司，但不是同一張桌子\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"權利上，零股仍是股份。交易上，它常在另一套撮合裡找對手。盤中有自己的撮合時段，盤後也有定價。你在整股看到的五檔，不能直接當成零股一定走得到的價。先問自己現在下的是哪一種單，再問那個池子深不深。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"權利相似，撮合不同\"}],[\"$\",\"li\",\"1\",{\"children\":\"整股五檔不是零股保證\"}],[\"$\",\"li\",\"2\",{\"children\":\"先確認時段與單別\"}]]}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、價差與量，是零股最常被低估的成本\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"熱門股的零股比較好走；冷門股可能掛很久，或必須接受比較差的價格。小金額時，價差佔比可以比手續費更痛。你以為自己省下了買一張的壓力，可能把壓力換成「離開時更薄」。進得去仍要問出得來。\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"情境\"}],[\"$\",\"th\",\"1\",{\"children\":\"整股比較像\"}],[\"$\",\"th\",\"2\",{\"children\":\"零股比較像\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"熱門股\"}],[\"$\",\"td\",\"1\",{\"children\":\"五檔深、連續\"}],[\"$\",\"td\",\"2\",{\"children\":\"通常也走得動，仍要看當下量\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"冷門股\"}],[\"$\",\"td\",\"1\",{\"children\":\"已可能很薄\"}],[\"$\",\"td\",\"2\",{\"children\":\"更常掛著或折價成交\"}]]}],[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"急著走\"}],[\"$\",\"td\",\"1\",{\"children\":\"還可能推價\"}],[\"$\",\"td\",\"2\",{\"children\":\"對手更少，更易吃價差\"}]]}],[\"$\",\"tr\",\"3\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"定期小額\"}],[\"$\",\"td\",\"1\",{\"children\":\"張數門檻高\"}],[\"$\",\"td\",\"2\",{\"children\":\"進得了，費用佔比要另算\"}]]}]]}]]}]}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、定期定額遇到的是費用與節奏\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"每次買一點，費用若有低消或固定成分，小金額會被吃得比較兇。另外，扣款日碰到的價格，是那一時段零股池子的價格，不是你心裡的整股收盤。長期看，這層可能被時間攤平；短期拿來檢討「怎麼跟大盤不一樣」，常是桌子不同，不是你比較倒楣。\"}],\"$L18\",\"$L19\"]]}],\"$L1a\",\"$L1b\",\"$L1c\",\"$L1d\",\"$L1e\"],\"$L1f\"]}]]}]}]\n18:[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"先算一次買賣的費用佔比\"}],[\"$\",\"li\",\"1\",{\"children\":\"再問扣款時段的池子深不深\"}],[\"$\",\"li\",\"2\",{\"children\":\"最後才拿來跟整股收盤比\"}]]}]\n19:[\"$\",\"figure\",\"2\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"✓哪個時段✓走不走得動✓離開能接受什麼價\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"下單前三行\"}]]}]\n1a:[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、不要用零股練習需要深度的策略\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"當沖、搶漲停、看五檔進出，這些對深度敏感的做法，零股通常是錯教室。你可以在零股上學公司、學長期持有的情緒，但不要以為零股盤口等於整股盤口。教室選錯，會學到一套換桌就失效的直覺。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"深度策略不要用薄池子練\"}],[\"$\",\"li\",\"1\",{\"children\":\"零股適合降低門檻，不適合模擬整股盤口\"}],[\"$\",\"li\",\"2\",{\"children\":\"換桌要把直覺歸零\"}]]}]]]}]\n1b:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、檢查清單\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"下零股前寫三行：我現在用的是哪個時段、這檔零股平常走不走得動、我離開時能不能接受較差的價。三行寫得完，門檻低才是好處；寫不完，門檻低只是讓你比較容易坐錯桌。\"}]]]}]\n1c:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"盤中零股是不是跟整股同時成交？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"不是同一套連續撮合。時段與撮合方式不同，價格可以不一樣。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"零股會不會比較便宜？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"有時看到的價較低，有時較高，重點是當下池子。便宜要連離開成本一起看。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"可以只買零股當存股嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"機制上可以。仍要算費用佔比與這檔零股的流動性，不要只看門檻低。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"零股有沒有股東權？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"仍是股份，股利與股東權依公司與集保規定。交易機制與權利是兩層。\"}]]}]]}]]]}]\n1d:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"零股進得了門，撮合、價差與深度仍跟整股不同。先確認時段、流動性與費用佔比，再把門檻低當成好處。\"}]]]}]\n1e:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L17\",\"0-定期定額優缺點\",{\"href\":\"/learn/dca-pros-and-cons-in-taiwan-stocks\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"定期定額優缺點\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L17\",\"0-上市與上櫃差在哪\",{\"href\":\"/learn/listed-vs-otc-taiwan\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"上市與上櫃差在哪\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L17\",\"0-台股交易成本\",{\"href\":\"/learn/taiwan-stock-trading-costs\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"台股交易成本\"}]]}]]}]]]}]\n1f:[\"$\",\"div\",null,{\"className\":\"LearnArticle_related__9qV55\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_relatedTitle__RXfrl\",\"children\":\"相關文章\"}],[[\"$\",\"$L17\",\"dca-pros-and-cons-in-taiwan-stocks\",{\"href\":\"/learn/dca-pros-and-cons-in-taiwan-stocks\",\"className\":\"LearnArticle_relatedLink__mibXe\",\"children\":\"定期定額優缺點\"}],[\"$\",\"$L17\",\"listed-vs-otc-taiwan\",{\"href\":\"/learn/listed-vs-otc-taiwan\",\"className\":\"LearnArticle_relatedLink__mibXe\",\"children\":\"上市與上櫃差在哪\"}],[\"$\",\"$L17\",\"taiwan-stock-trading-costs\",{\"href\":\"/learn/taiwan-stock-trading-costs\",\"className\":\"LearnArticle_relatedLink__mibXe\",\"children\":\"台股交易成本\"}]]]}]\n13:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\nf:null\n20:I[80622,[],\"IconMark\"]\n11:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"零股交易要注意哪3件事？盤中撮合跟整股不一樣｜股市大佬 TradeBoss\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"買不起一張，就改買零股，這條路讓很多人第一次進到台股。門檻低，不代表規則比較寬鬆。盤中零股的撮合節奏、可以成交的量、以及你看到的價格，都跟整股不是同一張桌子。用整股的習慣去等零股，會覺得市場在整你；其實是你坐錯桌。\"}],[\"$\",\"link\",\"2\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}],[\"$\",\"$L20\",\"3\",{}]],\"error\":null,\"digest\":\"$undefined\"}\n16:\"$11:metadata\"\n"}