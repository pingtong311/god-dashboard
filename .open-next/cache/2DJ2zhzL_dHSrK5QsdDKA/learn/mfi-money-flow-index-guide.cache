\"17:I[52619,[\\\"2619\\\",\\\"static/chunks/2619-04bc32f026a0d946.js\\\",\\\"6309\\\",\\\"static/chunks/app/learn/%5Bslug%5D/page-f7b99344f7e2ee16.js\\\"],\\\"\\\"]\\n\"])</script><script>self.__next_f.push([1,\"d:[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"LearnArticle_wrap__LIQ8G\\\",\\\"children\\\":[\\\"$\\\",\\\"article\\\",null,{\\\"className\\\":\\\"LearnArticle_article__2nBbk\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"LearnArticle_meta__etj_G\\\",\\\"children\\\":[[\\\"$\\\",\\\"$L17\\\",null,{\\\"className\\\":\\\"LearnArticle_cat__GQMlg\\\",\\\"href\\\":\\\"/learn?c=tech\\\",\\\"children\\\":\\\"技術面\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"LearnArticle_read__QEj6a\\\",\\\"children\\\":\\\"閱讀約 7 分鐘\\\"}]]}],[\\\"$\\\",\\\"h1\\\",null,{\\\"className\\\":\\\"LearnArticle_title__0_la8\\\",\\\"children\\\":\\\"MFI 指標怎麼看？資金流向指標教學，3分鐘搞懂超買超賣\\\"}],[\\\"$\\\",\\\"details\\\",null,{\\\"className\\\":\\\"LearnArticle_toc__LcSAa\\\",\\\"children\\\":[[\\\"$\\\",\\\"summary\\\",null,{\\\"className\\\":\\\"LearnArticle_tocSummary__YBddG\\\",\\\"children\\\":\\\"本文目錄\\\"}],[\\\"$\\\",\\\"ol\\\",null,{\\\"className\\\":\\\"LearnArticle_tocList__Rq_Lz\\\",\\\"children\\\":[[\\\"$\\\",\\\"li\\\",\\\"sec-1\\\",{\\\"children\\\":[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"#sec-1\\\",\\\"children\\\":\\\"一、MFI 指標是什麼？不只看漲跌，更要看「錢」有沒有進來\\\"}]}],[\\\"$\\\",\\\"li\\\",\\\"sec-2\\\",{\\\"children\\\":[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"#sec-2\\\",\\\"children\\\":\\\"二、80 跟 20 這兩個數字，到底代表什麼意思？\\\"}]}],[\\\"$\\\",\\\"li\\\",\\\"sec-3\\\",{\\\"children\\\":[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"#sec-3\\\",\\\"children\\\":\\\"三、比超買超賣更關鍵的訊號：「背離」怎麼看？\\\"}]}],[\\\"$\\\",\\\"li\\\",\\\"sec-4\\\",{\\\"children\\\":[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"#sec-4\\\",\\\"children\\\":\\\"四、我該用幾天的 MFI？參數設定的常見選擇\\\"}]}],[\\\"$\\\",\\\"li\\\",\\\"sec-5\\\",{\\\"children\\\":[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"#sec-5\\\",\\\"children\\\":\\\"五、MFI 指標的限制：為什麼有時候會「鈍化」不準？\\\"}]}],[\\\"$\\\",\\\"li\\\",\\\"sec-6\\\",{\\\"children\\\":[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"#sec-6\\\",\\\"children\\\":\\\"常見問題 FAQ\\\"}]}],[\\\"$\\\",\\\"li\\\",\\\"sec-7\\\",{\\\"children\\\":[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"#sec-7\\\",\\\"children\\\":\\\"總結\\\"}]}],[\\\"$\\\",\\\"li\\\",\\\"sec-8\\\",{\\\"children\\\":[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"#sec-8\\\",\\\"children\\\":\\\"延伸閱讀\\\"}]}]]}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"LearnArticle_body__6B7Mb\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"LearnArticle_intro__ATV5c\\\",\\\"children\\\":\\\"看到 K 線圖下面那條彎彎曲曲的 MFI 線，數字跳來跳去，一下 80 一下 20，到底代表什麼？這篇文章就是要帶你搞懂「資金流量指標 MFI」，讓你不再只是看熱鬧，而是能看出資金的真實動向。\\\"}],[[\\\"$\\\",\\\"figure\\\",\\\"figure-0\\\",{\\\"className\\\":\\\"LearnArticle_fig__uoT7r\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"LearnArticle_figFrame__jJ7E4\\\",\\\"children\\\":\\\"0–100 的相對強弱，不是下一個方向705030高檔鈍化超買 ≠ 明天會跌；先看它是趨勢還是震盪\\\"}],[\\\"$\\\",\\\"figcaption\\\",null,{\\\"className\\\":\\\"LearnArticle_figCap__LnUbb\\\",\\\"children\\\":\\\"示意圖｜RSI：70 以上常叫超買，強勢股也可以在高檔鈍化很久（教學結構，不是某檔實盤）\\\"}]]}]],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"LearnArticle_tldr__Br5BY\\\",\\\"children\\\":[[\\\"$\\\",\\\"b\\\",null,{\\\"className\\\":\\\"LearnArticle_tldrTitle__K5PBN\\\",\\\"children\\\":\\\"本文重點\\\"}],[\\\"$\\\",\\\"ul\\\",null,{\\\"className\\\":\\\"LearnArticle_tldrList__VSc2_\\\",\\\"children\\\":[[\\\"$\\\",\\\"li\\\",\\\"0\\\",{\\\"children\\\":\\\"MFI 指標結合「價格」與「成交量」，判斷資金是淨流入還是淨流出。\\\"}],[\\\"$\\\",\\\"li\\\",\\\"1\\\",{\\\"children\\\":\\\"MFI 高於 80 是「超買區」，市場可能過熱；低於 20 是「超賣區」，可能超跌。\\\"}],[\\\"$\\\",\\\"li\\\",\\\"2\\\",{\\\"children\\\":\\\"指標出現「背離」（股價創新高、MFI 卻走低）是更重要的警示訊號。\\\"}],[\\\"$\\\",\\\"li\\\",\\\"3\\\",{\\\"children\\\":\\\"MFI 適合用在有成交量的中大型股，小型股或量縮股容易失準。\\\"}]]}]]}],[[\\\"$\\\",\\\"section\\\",\\\"sec-1\\\",{\\\"id\\\":\\\"sec-1\\\",\\\"className\\\":\\\"LearnArticle_section__hLVjU\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"LearnArticle_h2__NmJ08\\\",\\\"children\\\":\\\"一、MFI 指標是什麼？不只看漲跌，更要看「錢」有沒有進來\\\"}],[[\\\"$\\\",\\\"p\\\",\\\"0\\\",{\\\"className\\\":\\\"LearnArticle_p__aZlQ1\\\",\\\"children\\\":\\\"MFI 的全名是 Money Flow Index，中文是「資金流量指標」。你可以把它想像成一個更聰明的 RSI 指標。RSI 只看價格的漲跌，但 MFI 同時考慮了「價格」和「成交量」，用來衡量買賣雙方的力道，判斷錢是正在流入這檔股票，還是正在流出。當 MFI 數值越高，代表買盤越強勁，資金流入越多；反之，數值越低，代表賣壓沉重，資金正在撤出。\\\"}]]]}],[\\\"$\\\",\\\"section\\\",\\\"sec-2\\\",{\\\"id\\\":\\\"sec-2\\\",\\\"className\\\":\\\"LearnArticle_section__hLVjU\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"LearnArticle_h2__NmJ08\\\",\\\"children\\\":\\\"二、80 跟 20 這兩個數字，到底代表什麼意思？\\\"}],[[\\\"$\\\",\\\"p\\\",\\\"0\\\",{\\\"className\\\":\\\"LearnArticle_p__aZlQ1\\\",\\\"children\\\":\\\"在 MFI 指標圖上，你會看到兩條重要的參考線：80 和 20。它們分別代表「超買區」和「超賣區」。這是一個相對的概念，幫助我們判斷市場情緒是否過熱或過冷。當指標進入這些區域，不代表股價會立刻反轉，但可以提醒我們留意風險或機會可能正在醞釀。\\\"}],[\\\"$\\\",\\\"div\\\",\\\"1\\\",{\\\"className\\\":\\\"LearnArticle_tblScroll__z9kbb\\\",\\\"children\\\":[\\\"$\\\",\\\"table\\\",null,{\\\"className\\\":\\\"LearnArticle_tbl__0yNgv\\\",\\\"children\\\":[[\\\"$\\\",\\\"thead\\\",null,{\\\"children\\\":[\\\"$\\\",\\\"tr\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"th\\\",\\\"0\\\",{\\\"children\\\":\\\"判斷區域\\\"}],[\\\"$\\\",\\\"th\\\",\\\"1\\\",{\\\"children\\\":\\\"MFI 數值\\\"}],[\\\"$\\\",\\\"th\\\",\\\"2\\\",{\\\"children\\\":\\\"市場情緒\\\"}],[\\\"$\\\",\\\"th\\\",\\\"3\\\",{\\\"children\\\":\\\"可能的後續走勢\\\"}]]}]}],[\\\"$\\\",\\\"tbody\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"tr\\\",\\\"0\\\",{\\\"children\\\":[[\\\"$\\\",\\\"td\\\",\\\"0\\\",{\\\"children\\\":\\\"超買區\\\"}],[\\\"$\\\",\\\"td\\\",\\\"1\\\",{\\\"children\\\":\\\"\\u003e 80\\\"}],[\\\"$\\\",\\\"td\\\",\\\"2\\\",{\\\"children\\\":\\\"過度樂觀、追價意願高\\\"}],[\\\"$\\\",\\\"td\\\",\\\"3\\\",{\\\"children\\\":\\\"漲勢可能暫歇或反轉\\\"}]]}],[\\\"$\\\",\\\"tr\\\",\\\"1\\\",{\\\"children\\\":[[\\\"$\\\",\\\"td\\\",\\\"0\\\",{\\\"children\\\":\\\"超賣區\\\"}],[\\\"$\\\",\\\"td\\\",\\\"1\\\",{\\\"children\\\":\\\"\\u003c 20\\\"}],[\\\"$\\\",\\\"td\\\",\\\"2\\\",{\\\"children\\\":\\\"過度悲觀、拋售壓力大\\\"}],[\\\"$\\\",\\\"td\\\",\\\"3\\\",{\\\"children\\\":\\\"跌勢可能趨緩或反彈\\\"}]]}]]}]]}]}]]]}],[\\\"$\\\",\\\"section\\\",\\\"sec-3\\\",{\\\"id\\\":\\\"sec-3\\\",\\\"className\\\":\\\"LearnArticle_section__hLVjU\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"LearnArticle_h2__NmJ08\\\",\\\"children\\\":\\\"三、比超買超賣更關鍵的訊號：「背離」怎麼看？\\\"}],[[\\\"$\\\",\\\"p\\\",\\\"0\\\",{\\\"className\\\":\\\"LearnArticle_p__aZlQ1\\\",\\\"children\\\":\\\"學會看 MFI，最重要的不是只看 80 或 20，而是要找出「背離」訊號。背離指的是股價走勢和指標走勢出現不一致的情況，這往往是趨勢可能反轉的領先警訊。簡單來說，就是價格還在創新高，但買進的力道（錢）卻沒有跟上，這就要小心了。\\\"}],\\\"$L18\\\",\\\"$L19\\\"]]}],\\\"$L1a\\\",\\\"$L1b\\\",\\\"$L1c\\\",\\\"$L1d\\\",\\\"$L1e\\\"],null]}]]}]}]\\n\"])</script><script>self.__next_f.push([1,\"18:[\\\"$\\\",\\\"ul\\\",\\\"1\\\",{\\\"className\\\":\\\"LearnArticle_listCheck__xx1CF\\\",\\\"children\\\":[[\\\"$\\\",\\\"li\\\",\\\"0\\\",{\\\"children\\\":\\\"熊背離（警示訊號）：股價創新高，MFI 指標卻沒跟上，甚至走低。代表上漲力道減弱，資金可能悄悄流出。\\\"}],[\\\"$\\\",\\\"li\\\",\\\"1\\\",{\\\"children\\\":\\\"牛背離（機會訊號）：股價創新低，MFI 指標卻沒有跟著破底，反而打出更高的低點。代表下跌動能趨緩，資金有承接意願。\\\"}]]}]\\n19:[\\\"$\\\",\\\"figure\\\",\\\"2\\\",{\\\"className\\\":\\\"LearnArticle_fig__uoT7r\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"LearnArticle_figFrame__jJ7E4\\\",\\\"children\\\":\\\"!看到超買就立刻賣出!忽略指標鈍化的可能!套用在冷門小型股上\\\"}],[\\\"$\\\",\\\"figcaption\\\",null,{\\\"className\\\":\\\"LearnArticle_figCap__LnUbb\\\",\\\"children\\\":\\\"使用 MFI 指標的常見誤區\\\"}]]}]\\n1a:[\\\"$\\\",\\\"section\\\",\\\"sec-4\\\",{\\\"id\\\":\\\"sec-4\\\",\\\"className\\\":\\\"LearnArticle_section__hLVjU\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"LearnArticle_h2__NmJ08\\\",\\\"children\\\":\\\"四、我該用幾天的 MFI？參數設定的常見選擇\\\"}],[[\\\"$\\\",\\\"p\\\",\\\"0\\\",{\\\"className\\\":\\\"LearnArticle_p__aZlQ1\\\",\\\"children\\\":\\\"大部分看盤軟體的 MFI 預設參數都是 14 天，這也是最多人使用的週期，在反應速度和穩定性之間取得了不錯的平衡。但參數沒有絕對的好壞，你可以根據自己的交易頻率來調整。短線交易者可能偏好更敏感的短天期，長線投資人則需要更平滑的長天期來觀察趨勢。\\\"}],[\\\"$\\\",\\\"ol\\\",\\\"1\\\",{\\\"className\\\":\\\"LearnArticle_listNum__86N5S\\\",\\\"children\\\":[[\\\"$\\\",\\\"li\\\",\\\"0\\\",{\\\"children\\\":\\\"短天期（例如 9 日）：反應靈敏，適合短線交易者。但也容易出現假訊號，需要搭配其他指標過濾。\\\"}],[\\\"$\\\",\\\"li\\\",\\\"1\\\",{\\\"children\\\":\\\"標準天期（例如 14 日）：市場預設值，兼顧穩定與靈敏度，適合波段操作者。\\\"}],[\\\"$\\\",\\\"li\\\",\\\"2\\\",{\\\"children\\\":\\\"長天期（例如 21 日）：訊號穩定，適合長線趨勢判斷。但反應較慢，可能錯過最佳進出點。\\\"}]]}]]]}]\\n\"])</script><script>self.__next_f.push([1,\"1b:[\\\"$\\\",\\\"section\\\",\\\"sec-5\\\",{\\\"id\\\":\\\"sec-5\\\",\\\"className\\\":\\\"LearnArticle_section__hLVjU\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"LearnArticle_h2__NmJ08\\\",\\\"children\\\":\\\"五、MFI 指標的限制：為什麼有時候會「鈍化」不準？\\\"}],[[\\\"$\\\",\\\"p\\\",\\\"0\\\",{\\\"className\\\":\\\"LearnArticle_p__aZlQ1\\\",\\\"children\\\":\\\"任何技術指標都不是萬能的，MFI 也有它的限制。最常見的就是「鈍化」。在一波非常強勁的漲勢中，MFI 可能會一直維持在 80 以上的超買區，但股價卻持續上漲。這時候如果你只因為看到超買就賣出，很可能會錯過後面的行情。因此，絕對不能單獨只看 MFI 一個指標就做決定。\\\"}],[\\\"$\\\",\\\"ul\\\",\\\"1\\\",{\\\"className\\\":\\\"LearnArticle_list__WjxqC\\\",\\\"children\\\":[[\\\"$\\\",\\\"li\\\",\\\"0\\\",{\\\"children\\\":\\\"趨勢盤中的鈍化：在一段強勁的多頭或空頭走勢中，MFI 可能長時間停留在超買或超賣區，失去參考價值。\\\"}],[\\\"$\\\",\\\"li\\\",\\\"1\\\",{\\\"children\\\":\\\"適用對象有限：對於成交量小、股性不活潑的冷門股，MFI 容易因為幾筆大單就劇烈波動而失真。\\\"}],[\\\"$\\\",\\\"li\\\",\\\"2\\\",{\\\"children\\\":\\\"需要搭配使用：單獨使用 MFI 的勝率不高，最好搭配趨勢線、均線或 K 線型態一起判斷，才能提高準確度。\\\"}]]}]]]}]\\n\"])</script><script>self.__next_f.push([1,\"1c:[\\\"$\\\",\\\"section\\\",\\\"sec-6\\\",{\\\"id\\\":\\\"sec-6\\\",\\\"className\\\":\\\"LearnArticle_section__hLVjU\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"LearnArticle_h2__NmJ08\\\",\\\"children\\\":\\\"常見問題 FAQ\\\"}],[[\\\"$\\\",\\\"div\\\",\\\"0\\\",{\\\"className\\\":\\\"LearnArticle_faq__cemBp\\\",\\\"children\\\":[[\\\"$\\\",\\\"details\\\",\\\"0\\\",{\\\"className\\\":\\\"LearnArticle_faqItem__I9h0U\\\",\\\"children\\\":[[\\\"$\\\",\\\"summary\\\",null,{\\\"children\\\":\\\"MFI 和 RSI 有什麼不同？\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"LearnArticle_faqA__IPuvc\\\",\\\"children\\\":\\\"兩者都是判斷超買超賣的擺盪指標，但 MFI 多了「成交量」的考量，可以視為「成交量加權的 RSI」。因此 MFI 能更好地反映資金的真實力道，而不只是價格的變動。\\\"}]]}],[\\\"$\\\",\\\"details\\\",\\\"1\\\",{\\\"className\\\":\\\"LearnArticle_faqItem__I9h0U\\\",\\\"children\\\":[[\\\"$\\\",\\\"summary\\\",null,{\\\"children\\\":\\\"MFI 指標超過 80 是不是就該賣掉？\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"LearnArticle_faqA__IPuvc\\\",\\\"children\\\":\\\"不一定。這只代表市場很熱絡，資金追捧意願強。在強勢多頭行情中，股價可能繼續上漲。建議觀察是否出現「熊背離」或價格跌破重要支撐，再做決定。\\\"}]]}],[\\\"$\\\",\\\"details\\\",\\\"2\\\",{\\\"className\\\":\\\"LearnArticle_faqItem__I9h0U\\\",\\\"children\\\":[[\\\"$\\\",\\\"summary\\\",null,{\\\"children\\\":\\\"MFI 參數要設多少天最好？\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"LearnArticle_faqA__IPuvc\\\",\\\"children\\\":\\\"最常見的設定是 14 天，這是一個市場的公約數。短線交易者可能會縮短到 9 天，長線投資人則可能拉長到 21 天。沒有絕對的好壞，重點是找到適合自己交易週期的參數。\\\"}]]}],[\\\"$\\\",\\\"details\\\",\\\"3\\\",{\\\"className\\\":\\\"LearnArticle_faqItem__I9h0U\\\",\\\"children\\\":[[\\\"$\\\",\\\"summary\\\",null,{\\\"children\\\":\\\"為什麼有些股票的 MFI 指標好像沒什麼用？\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"LearnArticle_faqA__IPuvc\\\",\\\"children\\\":\\\"成交量太小或流動性差的股票，MFI 指標容易失真。一兩筆大單就可能讓指標劇烈擺盪，失去參考價值。MFI 比較適合用在市值較大、成交量充足的股票上。\\\"}]]}]]}]]]}]\\n\"])</script><script>self.__next_f.push([1,\"1d:[\\\"$\\\",\\\"section\\\",\\\"sec-7\\\",{\\\"id\\\":\\\"sec-7\\\",\\\"className\\\":\\\"LearnArticle_section__hLVjU\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"LearnArticle_h2__NmJ08\\\",\\\"children\\\":\\\"總結\\\"}],[[\\\"$\\\",\\\"p\\\",\\\"0\\\",{\\\"className\\\":\\\"LearnArticle_p__aZlQ1\\\",\\\"children\\\":\\\"總結來說，MFI 指標的核心用法是觀察 80/20 的超買超賣區，並找出股價與指標走勢不一致的「背離」訊號。記得，它是一個動能指標，不是單獨的買賣決策點，把它當作確認趨勢強弱的溫度計，你的交易判斷會更全面。\\\"}]]]}]\\n1e:[\\\"$\\\",\\\"section\\\",\\\"sec-8\\\",{\\\"id\\\":\\\"sec-8\\\",\\\"className\\\":\\\"LearnArticle_section__hLVjU\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"LearnArticle_h2__NmJ08\\\",\\\"children\\\":\\\"延伸閱讀\\\"}],[[\\\"$\\\",\\\"ul\\\",\\\"0\\\",{\\\"className\\\":\\\"LearnArticle_list__WjxqC\\\",\\\"children\\\":[[\\\"$\\\",\\\"li\\\",\\\"0\\\",{\\\"children\\\":[[\\\"$\\\",\\\"$L17\\\",\\\"0-想學習更多技術指\\\",{\\\"href\\\":\\\"/school\\\",\\\"className\\\":\\\"LearnArticle_link__gMwHV\\\",\\\"children\\\":\\\"想學習更多技術指標？來台股學堂打好基礎\\\"}]]}],[\\\"$\\\",\\\"li\\\",\\\"1\\\",{\\\"children\\\":[[\\\"$\\\",\\\"$L17\\\",\\\"0-在個股透視頁，查\\\",{\\\"href\\\":\\\"/diary\\\",\\\"className\\\":\\\"LearnArticle_link__gMwHV\\\",\\\"children\\\":\\\"在個股透視頁，查看你關注股票的 MFI 指標\\\"}]]}],[\\\"$\\\",\\\"li\\\",\\\"2\\\",{\\\"children\\\":[[\\\"$\\\",\\\"$L17\\\",\\\"0-搞懂更多量價關係\\\",{\\\"href\\\":\\\"/learn\\\",\\\"className\\\":\\\"LearnArticle_link__gMwHV\\\",\\\"children\\\":\\\"搞懂更多量價關係，請看我們的教學專欄\\\"}]]}]]}]]]}]\\n\"])</script><script>self.__next_f.push([1,\"13:[[\\\"$\\\",\\\"meta\\\",\\\"0\\\",{\\\"charSet\\\":\\\"utf-8\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"1\\\",{\\\"name\\\":\\\"viewport\\\",\\\"content\\\":\\\"width=device-width, initial-scale=1\\\"}]]\\nf:null\\n\"])</script><script>self.__next_f.push([1,\"1f:I[80622,[],\\\"IconMark\\\"]\\n11:{\\\"metadata\\\":[[\\\"$\\\",\\\"title\\\",\\\"0\\\",{\\\"children\\\":\\\"MFI 指標怎麼看？資金流向指標教學，3分鐘搞懂超買超賣｜股市大佬 TradeBoss\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"1\\\",{\\\"name\\\":\\\"description\\\",\\\"content\\\":\\\"看到 K 線圖下面那條彎彎曲曲的 MFI 線，數字跳來跳去，一下 80 一下 20，到底代表什麼？這篇文章就是要帶你搞懂「資金流量指標 MFI」，讓你不再只是看熱鬧，而是能看出資金的真實動向。\\\"}],[\\\"$\\\",\\\"link\\\",\\\"2\\\",{\\\"rel\\\":\\\"icon\\\",\\\"href\\\":\\\"/favicon.ico\\\",\\\"type\\\":\\\"image/x-icon\\\",\\\"sizes\\\":\\\"16x16\\\"}],[\\\"$\\\",\\\"$L1f\\\",\\\"3\\\",{}]],\\\"error\\\":null,\\\"digest\\\":\\\"$undefined\\\"}\\n\"])</script><script>self.__next_f.push([1,\"16:\\\"