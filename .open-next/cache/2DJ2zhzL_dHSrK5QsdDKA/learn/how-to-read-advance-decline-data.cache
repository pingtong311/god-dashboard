\":\"LearnArticle_article__2nBbk\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_meta__etj_G\",\"children\":[[\"$\",\"$L17\",null,{\"className\":\"LearnArticle_cat__GQMlg\",\"href\":\"/learn?c=chips\",\"children\":\"籌碼面\"}],[\"$\",\"span\",null,{\"className\":\"LearnArticle_read__QEj6a\",\"children\":\"閱讀約 6 分鐘\"}]]}],[\"$\",\"h1\",null,{\"className\":\"LearnArticle_title__0_la8\",\"children\":\"上漲下跌家數怎麼看？3個數字看懂大盤是真強還假強\"}],[\"$\",\"details\",null,{\"className\":\"LearnArticle_toc__LcSAa\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"LearnArticle_tocSummary__YBddG\",\"children\":\"本文目錄\"}],[\"$\",\"ol\",null,{\"className\":\"LearnArticle_tocList__Rq_Lz\",\"children\":[[\"$\",\"li\",\"sec-1\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-1\",\"children\":\"一、「上漲/下跌家數」是什麼？為什麼比只看指數重要？\"}]}],[\"$\",\"li\",\"sec-2\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-2\",\"children\":\"二、如何判斷今天市場是「真強」還是「虛胖」？\"}]}],[\"$\",\"li\",\"sec-3\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-3\",\"children\":\"三、除了數量，還有哪些數字能看出市場情緒？\"}]}],[\"$\",\"li\",\"sec-4\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-4\",\"children\":\"四、進階指標：什麼是「ADL 騰落線」？\"}]}],[\"$\",\"li\",\"sec-5\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-5\",\"children\":\"五、我在哪裡可以看到這些數據？\"}]}],[\"$\",\"li\",\"sec-6\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-6\",\"children\":\"常見問題 FAQ\"}]}],[\"$\",\"li\",\"sec-7\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-7\",\"children\":\"總結\"}]}],[\"$\",\"li\",\"sec-8\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-8\",\"children\":\"延伸閱讀\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"LearnArticle_body__6B7Mb\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_intro__ATV5c\",\"children\":\"每天看盤，看到「上漲家數 800 家、下跌家數 600 家」，這些數字到底代表什麼？明明加權指數是紅的，為什麼我的股票卻在跌？這篇文章教你從這些數字，看懂大盤背後的真實力道。\"}],[[\"$\",\"figure\",\"figure-0\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"高集中度只說明買超很集中，不說明是誰、要幹嘛前 15 大其餘成交例：集中度 40%＝這批分點淨買超約當天成交的四成不能從集中度推出明天方向\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"示意圖｜分點集中度：前幾大買超合計，佔當天成交的比例（教學結構，不是某檔實盤）\"}]]}]],[\"$\",\"div\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"上漲家數遠大於下跌家數，代表市場氣氛健康，多數股票都在漲。\"}],[\"$\",\"li\",\"1\",{\"children\":\"指數漲但下跌家數更多，要小心是「拉積盤」，權值股在撐盤。\"}],[\"$\",\"li\",\"2\",{\"children\":\"ADL 指標（騰落線）能看出大盤與中小型股的趨勢是否同步。\"}],[\"$\",\"li\",\"3\",{\"children\":\"漲停家數遠多於跌停家數，且總數夠多，表示短線動能強勁。\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、「上漲/下跌家數」是什麼？為什麼比只看指數重要？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"這組數字，是統計今天所有上市櫃公司裡，有多少家收盤價高於昨天（上漲）、多少家低於昨天（下跌）。它就像一次「股市健康檢查」，能反映出除了權值股之外，大多數股票的真實表現。這能避免你只看加權指數的漲跌，卻被幾檔大型股給誤導，做出錯誤的判斷。\"}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、如何判斷今天市場是「真強」還是「虛胖」？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"最直觀的方法，就是比較上漲和下跌的家數比例。如果大盤上漲，同時上漲家數也遠遠超過下跌家數（例如超過 2:1），這通常代表市場是全面性的上漲，買盤力道強勁。反之，如果指數小漲，但下跌家數卻比上漲家數多，這就是一個需要特別留意的警訊。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"健康上漲：指數漲 + 上漲家數 > 下跌家數。\"}],[\"$\",\"li\",\"1\",{\"children\":\"危險信號：指數漲 + 下跌家數 > 上漲家數（俗稱拉積盤）。\"}],[\"$\",\"li\",\"2\",{\"children\":\"普遍修正：指數跌 + 下跌家數 > 上漲家數。\"}],[\"$\",\"li\",\"3\",{\"children\":\"初步止穩：指數跌 + 上漲家數 > 下跌家數（可能有利空出盡的味道）。\"}]]}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、除了數量，還有哪些數字能看出市場情緒？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"除了單純的家數比較，我們還可以觀察「漲停」和「跌停」的家數。這兩組數字反映了市場最極端的情緒。當漲停家數多，代表市場追價意願非常強烈；反之，若跌停家數多，則顯示恐慌情緒正在蔓延。這對於判斷當下市場的熱度與風險，是個非常有用的參考。\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"市場情境\"}],[\"$\",\"th\",\"1\",{\"children\":\"漲停家數 vs 跌停家數\"}],[\"$\",\"th\",\"2\",{\"children\":\"可能解讀\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"多頭氣盛\"}],[\"$\",\"td\",\"1\",{\"children\":\"漲停遠大於跌停 (例: 30家 vs 2家)\"}],[\"$\",\"td\",\"2\",{\"children\":\"短線資金活躍，市場情緒樂觀。\"}]]}],\"$L18\",\"$L19\",\"$L1a\"]}]]}]}],\"$L1b\"]]}],\"$L1c\",\"$L1d\",\"$L1e\",\"$L1f\",\"$L20\"],null]}]]}]}]\n18:[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"空頭恐慌\"}],[\"$\",\"td\",\"1\",{\"children\":\"跌停遠大於漲停 (例: 3家 vs 25家)\"}],[\"$\",\"td\",\"2\",{\"children\":\"賣壓沉重，投資人信心不足。\"}]]}]\n19:[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"多空拉鋸\"}],[\"$\",\"td\",\"1\",{\"children\":\"兩者家數接近 (例: 10家 vs 8家)\"}],[\"$\",\"td\",\"2\",{\"children\":\"市場方向不明，短線波動可能加劇。\"}]]}]\n1a:[\"$\",\"tr\",\"3\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"冷清觀望\"}],[\"$\",\"td\",\"1\",{\"children\":\"兩者都很少 (例: 皆 < 5家)\"}],[\"$\",\"td\",\"2\",{\"children\":\"市場缺乏動能，資金可能在休息。\"}]]}]\n1b:[\"$\",\"figure\",\"2\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"!指數漲，下跌家數多!權值股拉抬指數!多數個股下跌!小心賺指數賠價差\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"小心！這種盤勢有鬼\"}]]}]\n1c:[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、進階指標：什麼是「ADL 騰落線」？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"如果你覺得每天比較數字很麻煩，可以看一個更長期的指標：「ADL 騰落線」(Advance-Decline Line)。它的算法很簡單，就是每日的「上漲家數」減去「下跌家數」，再把結果一天天累加起來畫成一條線。這條線可以幫助我們判斷整體市場的內在強度，看出趨勢的變化。\"}],[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"ADL 線與大盤指數同步向上：健康的多頭市場，大小股票一起漲。\"}],[\"$\",\"li\",\"1\",{\"children\":\"ADL 線與大盤指數同步向下：明確的空頭市場，普遍都在跌。\"}],[\"$\",\"li\",\"2\",{\"children\":\"大盤指數創新高，ADL 線卻沒有跟上：這叫「背離」，是個警訊。代表只有少數權值股在漲，多數股票已經跟不上了，行情可能隨時會反轉。\"}]]}]]]}]\n1d:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、我在哪裡可以看到這些數據？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"大部分的看盤軟體或證券 App，在「大盤」或「行情」的頁面都會提供即時的漲跌家數統計。在股市大佬的「大盤總覽」頁面，我們也整理了每日的詳細數據，包含漲跌停家數與 ADL 趨勢線，讓你可以一目了然，不用自己到處找。這些數據是觀察市場情緒最基本也最有效的工具之一。\"}]]]}]\n1e:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"平盤的股票算在哪一邊？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"平盤（收盤價與昨日相同）的股票，在計算上既不屬於上漲也不屬於下跌，所以會被排除在這兩類統計之外。因此，上漲家數加上下跌家數，通常會小於總上市櫃公司數量。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"為什麼指數大漲，我的股票卻跌了？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"這很可能是遇到了「拉積盤」，也就是靠台積電等幾檔大型權值股拉抬指數，但大多數中小型股卻是下跌的。這時看下跌家數通常會比上漲家數多，就是一個明顯的警訊。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"這個指標適用於個股嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"不適用。上漲下跌家數是「總體」指標，用來評估整個市場的健康程度，而不是用來判斷單一股票的買賣點。看個股還是要回歸其自身的籌碼、技術與基本面分析。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"數據要看上市、上櫃，還是全部加總？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"新手建議直接看「上市櫃合計」的總數，能最全面地反映台股整體的狀況。當你比較有經驗後，可以再分開看上市（偏向大型股）與上櫃（偏向中小型股）的數據，觀察兩邊市場的力道是否一致。\"}]]}]]}]]]}]\n1f:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"別再只盯著加權指數的紅綠燈。養成習慣，每天多看一眼「上漲與下跌家數」的比例，如果指數漲、但下跌家數卻比較多，就是該提高警覺的時候。這個簡單的動作，能幫你避開很多市場陷阱。\"}]]]}]\n20:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L17\",\"0-查看每日完整大盤\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"查看每日完整大盤數據\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L17\",\"0-想學更多指標？來\",{\"href\":\"/school\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"想學更多指標？來台股學堂\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L17\",\"0-每日盤後分析，幫\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"每日盤後分析，幫你畫重點\"}]]}]]}]]]}]\n13:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\nf:null\n21:I[80622,[],\"IconMark\"]\n11:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"上漲下跌家數怎麼看？3個數字看懂大盤是真強還假強｜股市大佬 TradeBoss\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"每天看盤，看到「上漲家數 800 家、下跌家數 600 家」，這些數字到底代表什麼？明明加權指數是紅的，為什麼我的股票卻在跌？這篇文章教你從這些數字，看懂大盤背後的真實力道。\"}],[\"$\",\"link\",\"2\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}],[\"$\",\"$L21\",\"3\",{}]],\"error\":null,\"digest\":\"$undefined\"}\n16:\"$11:metadata\"\n"}