\",\"li\",\"1\",{\"children\":\"櫃買指數表現亮眼，漲幅達1.19%。\"}],[\"$\",\"li\",\"2\",{\"children\":\"存託憑證與塑膠工業族群領漲。\"}],[\"$\",\"li\",\"3\",{\"children\":\"外資現貨買超，自營商則賣超。\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、台股大盤今日表現回顧\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"2026年8月27日台股加權指數以45975.22點作收，上漲0.31%，而櫃買指數則有更為明顯的漲幅，收在400.38點，上漲1.19%。上市股票整體表現，上漲家數為474家，下跌家數為448家，平均漲跌幅為0.48%，市場成交金額約8918.0億元。\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"指數名稱\"}],[\"$\",\"th\",\"1\",{\"children\":\"收盤價\"}],[\"$\",\"th\",\"2\",{\"children\":\"漲跌幅\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"加權指數\"}],[\"$\",\"td\",\"1\",{\"children\":\"45975.22\"}],[\"$\",\"td\",\"2\",{\"children\":\"+0.31%\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"櫃買指數\"}],[\"$\",\"td\",\"1\",{\"children\":\"400.38\"}],[\"$\",\"td\",\"2\",{\"children\":\"+1.19%\"}]]}],[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"上市平均漲跌幅\"}],[\"$\",\"td\",\"1\",{\"children\":\"-\"}],[\"$\",\"td\",\"2\",{\"children\":\"+0.48%\"}]]}]]}]]}]}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、盤面族群表現：電子零組件與塑膠工業領漲\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"今日盤面上表現較為強勁的族群包括存託憑證、塑膠工業、電子零組件業以及光電業。其中，存託憑證族群上漲2.69%，由泰金寶-DR（9105）領漲。塑膠工業族群上漲1.91%，國喬（1312）為該族群的領漲個股。電子零組件業上漲1.90%，台虹（8039）表現突出。相對地，居家生活類、觀光事業及橡膠工業等族群則呈現下跌。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"存託憑證族群上漲2.69%，泰金寶-DR（9105）領漲。\"}],[\"$\",\"li\",\"1\",{\"children\":\"塑膠工業族群上漲1.91%，國喬（1312）表現強勁。\"}],[\"$\",\"li\",\"2\",{\"children\":\"電子零組件業族群上漲1.90%，台虹（8039）漲幅居前。\"}],[\"$\",\"li\",\"3\",{\"children\":\"光電業族群上漲1.26%，聯一光（3441）為領漲個股。\"}],[\"$\",\"li\",\"4\",{\"children\":\"居家生活類、觀光事業、橡膠工業等族群今日表現偏弱。\"}]]}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、個股焦點：國喬、AMAX-KY漲停，和益、台光電下跌\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"在個股表現方面，今日有多檔股票達到漲停。其中，塑膠工業的國喬（1312）以10.00%的漲幅居上市漲幅榜之首，成交量約7796張。AMAX-KY（6933）與永悅健康-創（7835）也同樣以漲停作收。相對地，和益（1709）下跌7.95%，台光電（2383）下跌6.70%，為跌幅較大的股票。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"國喬（1312）漲幅10.00%，成交量7796張，屬於塑膠工業族群。\"}],\"$L18\",\"$L19\",\"$L1a\",\"$L1b\",\"$L1c\"]}],\"$L1d\"]]}],\"$L1e\",\"$L1f\",\"$L20\",\"$L21\",\"$L22\"],null]}]]}]}]\n18:[\"$\",\"li\",\"1\",{\"children\":\"AMAX-KY（6933）漲幅10.00%，成交量550張。\"}]\n19:[\"$\",\"li\",\"2\",{\"children\":\"台虹（8039）漲幅9.98%，成交量22503張，屬於電子零組件業族群。\"}]\n1a:[\"$\",\"li\",\"3\",{\"children\":\"和益（1709）跌幅7.95%，成交量26503張。\"}]\n1b:[\"$\",\"li\",\"4\",{\"children\":\"台光電（2383）跌幅6.70%，成交量3476張。\"}]\n1c:[\"$\",\"li\",\"5\",{\"children\":\"當沖熱門股中，合騏的量比高達49.5倍，但股價下跌7.52%。\"}]\n1d:[\"$\",\"figure\",\"2\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"!外資淨空單!國際盤分歧!美股漲跌互見\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"值得留意之處\"}]]}]\n1e:[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、法人籌碼與市場信心\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"在法人動向方面，外資今日在現貨市場買超約488,047張，而自營商則賣超約127,625張。期貨市場部分，台指期收盤上漲0.48%，未平倉口數為104881口，其中外資台指期淨空單為84,836口。全市場的融資維持率為193.3%。\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"項目\"}],[\"$\",\"th\",\"1\",{\"children\":\"數值\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"外資現貨買賣超\"}],[\"$\",\"td\",\"1\",{\"children\":\"約 488,047 張 (買超)\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"自營商現貨買賣超\"}],[\"$\",\"td\",\"1\",{\"children\":\"約 -127,625 張 (賣超)\"}]]}],[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"外資台指期淨空單\"}],[\"$\",\"td\",\"1\",{\"children\":\"84,836 口\"}]]}],[\"$\",\"tr\",\"3\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"全市場融資維持率\"}],[\"$\",\"td\",\"1\",{\"children\":\"193.3%\"}]]}]]}]]}]}]]]}]\n1f:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、國際市場動向與台股相關新聞\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"國際股市方面，昨日美股主要指數表現分歧，S&P 500下跌0.02%，那斯達克下跌0.08%，費城半導體則上漲0.20%。亞洲市場中，韓國綜合指數（KOSPI）上漲1.53%，日經225指數下跌0.20%。今日台股相關新聞主要圍繞在科技產業，特別是台積電（2330）的相關消息，例如其CoWoS技術引爆AI商機以及泰國PCB產值可能激增等。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"S&P 500指數下跌0.02%，那斯達克指數下跌0.08%。\"}],[\"$\",\"li\",\"1\",{\"children\":\"費城半導體指數上漲0.20%。\"}],[\"$\",\"li\",\"2\",{\"children\":\"韓國綜合指數（KOSPI）上漲1.53%，日經225指數下跌0.20%。\"}],[\"$\",\"li\",\"3\",{\"children\":\"今日台股新聞提及致茂擬發GDR佈局海外，以及台積電（2330）相關的AI、先進封裝與國際競爭消息。\"}],[\"$\",\"li\",\"4\",{\"children\":\"近三日國際消息關注美國資料中心、川普關稅以及聯準會理事庫克與川普的言論。\"}]]}]]]}]\n20:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"今天台股整體表現如何？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"2026年8月27日台股加權指數上漲0.31%，收在45975.22點。櫃買指數表現更為強勁，上漲1.19%，收在400.38點。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"哪些族群今天表現比較好？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"今日表現強勁的族群包括存託憑證、塑膠工業、電子零組件業以及光電業。其中存託憑證族群上漲2.69%，塑膠工業族群上漲1.91%。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"外資今天在台股做了什麼？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"外資今日在現貨市場買超約488,047張。在台指期貨市場，外資淨空單為84,836口。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"今天有沒有特別漲跌的個股？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"今日上市漲幅榜上，國喬（1312）、AMAX-KY（6933）與永悅健康-創（7835）均漲停。跌幅榜上則有和益（1709）與台光電（2383）跌幅較大。\"}]]}]]}]]]}]\n21:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"今日台股加權指數小幅收紅，櫃買指數表現相對強勁，電子零組件與塑膠工業族群為盤面焦點。\"}]]]}]\n22:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀