],[\"$\",\"span\",null,{\"className\":\"LearnArticle_read__QEj6a\",\"children\":\"閱讀約 6 分鐘\"}]]}],[\"$\",\"h1\",null,{\"className\":\"LearnArticle_title__0_la8\",\"children\":\"法說會是什麼？3個重點看懂公司未來，避開法說會陷阱\"}],[\"$\",\"details\",null,{\"className\":\"LearnArticle_toc__LcSAa\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"LearnArticle_tocSummary__YBddG\",\"children\":\"本文目錄\"}],[\"$\",\"ol\",null,{\"className\":\"LearnArticle_tocList__Rq_Lz\",\"children\":[[\"$\",\"li\",\"sec-1\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-1\",\"children\":\"一、法說會到底是什麼？為什麼散戶也要關心？\"}]}],[\"$\",\"li\",\"sec-2\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-2\",\"children\":\"二、法說會三大觀察重點，數字會說話！\"}]}],[\"$\",\"li\",\"sec-3\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-3\",\"children\":\"三、小心！為什麼法說會開完，股價反而下跌？\"}]}],[\"$\",\"li\",\"sec-4\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-4\",\"children\":\"四、會前怎麼準備？從哪裡找法說會資訊？\"}]}],[\"$\",\"li\",\"sec-5\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-5\",\"children\":\"五、法說會資料去哪看？股市大佬幫你對照價量\"}]}],[\"$\",\"li\",\"sec-6\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-6\",\"children\":\"常見問題 FAQ\"}]}],[\"$\",\"li\",\"sec-7\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-7\",\"children\":\"總結\"}]}],[\"$\",\"li\",\"sec-8\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-8\",\"children\":\"延伸閱讀\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"LearnArticle_body__6B7Mb\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_intro__ATV5c\",\"children\":\"新聞常說「法說會釋出利多」，結果股價隔天卻下跌？到底法說會上公司說了什麼才算數？這篇文章會教你聽懂法說會的弦外之音，找出真正影響股價的關鍵數字。\"}],[[\"$\",\"figure\",\"figure-0\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"沒扣成本的勝率，看起來都會比較漂亮0.029%手續費 1 折來回0.15%當沖證交稅0.06%滑價估計三項合計約 0.24%；留倉稅率更高，約 0.39%\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"示意圖｜當沖來回成本：1 折手續費 + 證交稅 + 滑價（教學結構，不是某檔實盤）\"}]]}]],[\"$\",\"div\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"法說會是公司向法人、分析師報告營運狀況與未來展望的會議。\"}],[\"$\",\"li\",\"1\",{\"children\":\"三大觀察重點：公司對未來的展望、毛利率變化、資本支出計畫。\"}],[\"$\",\"li\",\"2\",{\"children\":\"會後股價不一定馬上反應，需對照公司過往說法與實際表現來判斷。\"}],[\"$\",\"li\",\"3\",{\"children\":\"小心「法會變說會」：利多出盡或展望不如預期，都可能讓股價下跌。\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、法說會到底是什麼？為什麼散戶也要關心？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"「法說會」的全名是「法人說明會」，是上市櫃公司對專業投資機構（也就是法人）報告營運狀況、回答提問的會議。雖然我們散戶不能親自參加，但這就像一扇窗，讓我們能一窺公司高層怎麼看待自家生意，以及未來打算怎麼做。這些資訊會直接影響法人們的投資決策，進而牽動股價，所以當然值得我們關心。\"}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、法說會三大觀察重點，數字會說話！\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"在法說會上，經營團隊的發言可能很樂觀，但真正的重點藏在數字裡。與其聽故事，不如學會看懂三大關鍵指標。這三項數字分別代表公司對「未來市場的看法」、「賺錢的能力」、以及「成長的野心」，是所有專業投資人一定會檢視的核心項目。\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"觀察指標\"}],[\"$\",\"th\",\"1\",{\"children\":\"要看什麼（跟誰比？）\"}],[\"$\",\"th\",\"2\",{\"children\":\"為什麼重要\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"未來展望 (Guidance)\"}],[\"$\",\"td\",\"1\",{\"children\":\"公司預估的下季或全年營收、獲利目標。要跟「市場預期」與「公司上一季的說法」比較。\"}],[\"$\",\"td\",\"2\",{\"children\":\"直接影響法人調整對這家公司的評價。\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"毛利率與獲利能力\"}],[\"$\",\"td\",\"1\",{\"children\":\"預期毛利率是向上、持平或向下？產品組合、成本控制有沒有改善？\"}],[\"$\",\"td\",\"2\",{\"children\":\"代表公司產品的競爭力與賺錢的真實效率。\"}]]}],[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"資本支出 (Capex)\"}],[\"$\",\"td\",\"1\",{\"children\":\"未來要花多少錢擴廠、買設備？金額跟去年比是增加還減少？\"}],[\"$\",\"td\",\"2\",{\"children\":\"透露公司對產業景氣的判斷與擴張的企圖心。\"}]]}]]}]]}]}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、小心！為什麼法說會開完，股價反而下跌？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"這是一個常見的狀況，新聞標題寫著利多，股價卻不給面子，這常被戲稱為「法會變說會」。這通常不是單一原因造成的，背後可能代表市場的預期更高，或是好消息的背後藏著隱憂。學會判斷這幾種情況，可以幫你避開陷阱。\"}],\"$L19\",\"$L1a\"]]}],\"$L1b\",\"$L1c\",\"$L1d\",\"$L1e\",\"$L1f\"],null]}]]}]}]\n19:[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"利多出盡：市場早已預期到好消息，股價在法說會前已上漲，會後反而成為資金出場的時機。\"}],[\"$\",\"li\",\"1\",{\"children\":\"展望不如預期：雖然公司說未來會成長，但成長的幅度低於法人圈的普遍共識。\"}],[\"$\",\"li\",\"2\",{\"children\":\"細節藏著警訊：例如營收成長但毛利率下滑，或是庫存天數大幅增加，都可能是隱憂。\"}],[\"$\",\"li\",\"3\",{\"children\":\"態度趨於保守：管理層對未來景氣的用詞閃爍，或是不願給出明確的數字指引。\"}]]}]\n1a:[\"$\",\"figure\",\"2\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"!利多消息早已反應!展望低於市場預期!營收好但毛利下滑!管理層態度轉趨保守\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"小心「法會變說會」四警訊\"}]]}]\n1b:[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、會前怎麼準備？從哪裡找法說會資訊？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"想聽懂法說會的重點，事前的準備很重要。你可以在法說會前，先對公司近況有基本了解，這樣當天公司發布新資訊時，你才能馬上判斷是好是壞。這些資訊都是公開的，花點時間就能找到。\"}],[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"查詢法說會日期：可以到公開資訊觀測站的「法說會一覽表」，或券商軟體、財經網站的行事曆查詢。\"}],[\"$\",\"li\",\"1\",{\"children\":\"回顧近期財報：至少看一下最近兩季的營收、毛利率和EPS，了解目前的營運趨勢。\"}],[\"$\",\"li\",\"2\",{\"children\":\"了解市場預期：稍微看一下券商報告或財經新聞，了解分析師們普遍預估的數字是多少，建立一個比較的基準點。\"}]]}]]]}]\n1c:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、法說會資料去哪看？股市大佬幫你對照價量\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"你不需要親自參加或聽完每場會議。大部分公司在法說會後，都會將簡報檔（Slides）放在公司官網的「投資人關係」專區。公開資訊觀測站也會有會議的影音連結。更有效率的方式，是利用工具輔助。例如在股市大佬的「個股透視」頁面，我們會將法說會日期直接標示在K線圖上，讓你方便對照會後股價與籌碼的真實反應。\"}]]]}]\n1d:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"法說會跟股東會有什麼不一樣？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"法說會主要對象是法人機構，目的是報告營運現況與未來展望；股東會的對象是全體股東，主要議程是承認財報、選舉董監事等公司治理的法定事項。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"英文的法說會聽不懂怎麼辦？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"不用擔心，大部分公司會後都會在官網「投資人關係」專區提供簡報檔案或新聞稿，許多券商的研究報告也會有重點整理，可以幫助你快速掌握關鍵資訊。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"只有大型公司才會開法說會嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"不是的。根據主管機關規定，所有在台灣的上市櫃公司，每年都必須至少舉辦一次法人說明會。許多中小型公司也會自主舉辦，以增加與市場溝通的機會。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"法說會上公司說的內容可以完全相信嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"公司經營團隊通常會傾向傳達較為正面的訊息。因此，聰明的投資人要學習從數字和管理層的語氣中，判斷資訊的真實性，並對照公司過去的發言紀錄來評估其誠信。\"}]]}]]}]]]}]\n1e:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"總結來說，看懂法說會的關鍵在於「比較」：比較這次的說法與上次的差異、比較公司的展望與市場的預期。養成習慣，就能從中找到別人沒注意到的機會與風險。\"}]]]}]\n1f:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L18\",\"0-個股的歷史法說會\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"個股的歷史法說會紀錄在哪看？\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L18\",\"0-想學更多財報名詞\",{\"href\":\"/school\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"想學更多財報名詞？來台股學堂\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L18\",\"0-掌握最新法說會行\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"掌握最新法說會行事曆\"}]]}]]}]]]}]\n14:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\n10:null\n20:I[80622,[],\"IconMark\"]\n12:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"法說會是什麼？3個重點看懂公司未來，避開法說會陷阱｜股市大佬 TradeBoss\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"新聞常說「法說會釋出利多」，結果股價隔天卻下跌？到底法說會上公司說了什麼才算數？這篇文章會教你聽懂法說會的弦外之音，找出真正影響股價的關鍵數字。\"}],[\"$\",\"link\",\"2\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}],[\"$\",\"$L20\",\"3\",{}]],\"error\":null,\"digest\":\"$undefined\"}\n17:\"$12:metadata\"\n"}