,\"div\",null,{\"className\":\"LearnArticle_wrap__LIQ8G\",\"children\":[\"$\",\"article\",null,{\"className\":\"LearnArticle_article__2nBbk\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_meta__etj_G\",\"children\":[[\"$\",\"$L17\",null,{\"className\":\"LearnArticle_cat__GQMlg\",\"href\":\"/learn?c=themes\",\"children\":\"題材專欄\"}],[\"$\",\"span\",null,{\"className\":\"LearnArticle_read__QEj6a\",\"children\":\"閱讀約 5 分鐘\"}]]}],[\"$\",\"h1\",null,{\"className\":\"LearnArticle_title__0_la8\",\"children\":\"領漲股與跟風股差在哪？先做3個檢查\"}],[\"$\",\"details\",null,{\"className\":\"LearnArticle_toc__LcSAa\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"LearnArticle_tocSummary__YBddG\",\"children\":\"本文目錄\"}],[\"$\",\"ol\",null,{\"className\":\"LearnArticle_tocList__Rq_Lz\",\"children\":[[\"$\",\"li\",\"sec-1\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-1\",\"children\":\"一、先漲的，不一定是領頭\"}]}],[\"$\",\"li\",\"sec-2\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-2\",\"children\":\"二、三個檢查：帶動、自立、量從哪來\"}]}],[\"$\",\"li\",\"sec-3\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-3\",\"children\":\"三、領頭比較安全，是常見誤會\"}]}],[\"$\",\"li\",\"sec-4\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-4\",\"children\":\"四、跟風股為什麼常在擴散段變多\"}]}],[\"$\",\"li\",\"sec-5\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-5\",\"children\":\"五、最小用法：蓋住名字再講一次\"}]}],[\"$\",\"li\",\"sec-6\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-6\",\"children\":\"常見問題 FAQ\"}]}],[\"$\",\"li\",\"sec-7\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-7\",\"children\":\"總結\"}]}],[\"$\",\"li\",\"sec-8\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-8\",\"children\":\"延伸閱讀\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"LearnArticle_body__6B7Mb\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_intro__ATV5c\",\"children\":\"同一句題材裡，總有人先被點名，也總有人後來才被塞進清單。前者常被叫領漲，後者常被叫跟風。名字會影響你的膽子：領頭好像比較正、跟風好像比較便宜。比較有用的分法不是誰先漲，而是它動的時候同類跟不跟、沒有這個名詞時它自己還講不講得清。這篇幫你做三個檢查。\"}],[[\"$\",\"figure\",\"figure-0\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"越後面越熱鬧，通常也越貴、越好離開佈局沒新聞命名故事出現擁擠人人都知退燒利多變鈍新聞出現時，常常已經不是第一段\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"示意圖｜題材四階段：佈局 → 命名 → 擁擠 → 退燒（教學結構，不是某檔實盤）\"}]]}]],[\"$\",\"div\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"領頭要看帶不帶得動，不看誰先亮燈\"}],[\"$\",\"li\",\"1\",{\"children\":\"跟風不是罪，風險是它比較靠名字活\"}],[\"$\",\"li\",\"2\",{\"children\":\"沒有題材名詞時，理由還在的才比較像自己的股票\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、先漲的，不一定是領頭\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"彈性大的股票可以先亮，只因為它薄、它敏感，不因為它帶得動別人。領頭比較像：它動的時候，同族群的家數與金額會跟著偏。你若只用誰先漲來封領頭，會把當天最吵的那一檔誤認成火車頭。火車頭要看後面有沒有車廂，不是看汽笛誰先響。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"先亮可能只是彈性大\"}],[\"$\",\"li\",\"1\",{\"children\":\"領頭要看同類跟不跟\"}],[\"$\",\"li\",\"2\",{\"children\":\"汽笛響不等於有車廂\"}]]}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、三個檢查：帶動、自立、量從哪來\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"第一，它上漲或回落時，同類有沒有同步偏離。只有它自己走，比較像個股。第二，把題材名字蓋住，你還能不能用一句話說明它自己的生意為什麼被交易。蓋不住，它比較靠名字活。第三，量是它帶出來的，還是它去借榜上其他名字的熱度。三個檢查能讓領頭與跟風變成可記錄的差別，而不是感覺。\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"檢查\"}],[\"$\",\"th\",\"1\",{\"children\":\"比較像領頭\"}],[\"$\",\"th\",\"2\",{\"children\":\"比較像跟風\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"帶動\"}],[\"$\",\"td\",\"1\",{\"children\":\"它動，同類家數與金額跟著偏\"}],[\"$\",\"td\",\"2\",{\"children\":\"它動，旁邊沒什麼反應\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"自立\"}],[\"$\",\"td\",\"1\",{\"children\":\"蓋住題材名，理由還講得清\"}],[\"$\",\"td\",\"2\",{\"children\":\"沒有名字就說不出來\"}]]}],[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"量從哪來\"}],[\"$\",\"td\",\"1\",{\"children\":\"量先在它身上出現再擴散\"}],[\"$\",\"td\",\"2\",{\"children\":\"量跟著清單才出現\"}]]}],[\"$\",\"tr\",\"3\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"退潮時\"}],[\"$\",\"td\",\"1\",{\"children\":\"故事還有人認領\"}],[\"$\",\"td\",\"2\",{\"children\":\"名字一淡就沒人認\"}]]}]]}]]}]}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、領頭比較安全，是常見誤會\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"領頭被討論得多，進出也常比較有對手，所以當下比較好做。這不自動比較安全。領頭若已經把故事走得很滿，離開的門一樣會擠；跟風若連結清楚、你也寫得下失效，它也只是另一種觀察對象。安全來自你的上限與離開條件，不來自它在清單上的排位。把領頭當安全牌，會讓部位悄悄變大。\"}],\"$L18\",\"$L19\"]]}],\"$L1a\",\"$L1b\",\"$L1c\",\"$L1d\",\"$L1e\"],\"$L1f\"]}]]}]}]\n18:[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"先分開：好交易不等於低風險\"}],[\"$\",\"li\",\"1\",{\"children\":\"再寫這筆的上限，不要用領頭兩個字加碼\"}],[\"$\",\"li\",\"2\",{\"children\":\"跟風也不要用比較便宜三個字加碼\"}]]}]\n19:[\"$\",\"figure\",\"2\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"!領頭所以安全!跟風所以便宜!清單長所以完整\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"兩種加碼藉口\"}]]}]\n1a:[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、跟風股為什麼常在擴散段變多\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"領頭漲一段之後，市場會開始翻還沒動的名字，好讓故事繼續講。這時跟風清單會變長，連結也會變薄。你看到愈來愈多也算，通常不是題材變完整，而是傳播需要新主角。完整感是擴散段的產品，不是研究品質變高。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"清單變長，先當擴散\"}],[\"$\",\"li\",\"1\",{\"children\":\"也算愈多，連結通常愈薄\"}],[\"$\",\"li\",\"2\",{\"children\":\"完整感不能當功課分數\"}]]}]]]}]\n1b:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、最小用法：蓋住名字再講一次\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"看到被點成領頭或跟風的股票，先把題材名詞蓋住，用一句話重講它為什麼在這裡。講得出口，再去看帶動與量。講不出口，就把它留在背景，不要用排位說服自己。這個動作很慢，但能擋住名單對膽子的影響。\"}]]]}]\n1c:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"領頭換人，題材是不是結束了？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"不一定。可能換人帶，也可能熱度在散。看同類還跟不跟，不要只看誰最亮。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"跟風是不是都不能碰？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"不是能不能碰，是它比較靠名字。名字一淡，理由要還在，離開條件也要先寫。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"成交金額最大的就是領頭嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"金額大只說明今天好交易。還要看它動時同類跟不跟、蓋住名字理由還在不在。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"法人買超的比較像領頭嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"法人買超是另一層資料。它可以跟領頭重疊，也可以只是各自研究剛好同向。不要用單一買賣超封王。\"}]]}]]}]]]}]\n1d:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"領頭看帶不帶得動、名字蓋住理由還在不在、量從哪來。跟風不是罪，風險是比較靠名字活。排位不是安全等級。\"}]]]}]\n1e:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L17\",\"0-題材股生命週期\",{\"href\":\"/learn/theme-stock-lifecycle\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"題材股生命週期\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L17\",\"0-族群透視（會員）\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"族群透視（會員）\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L17\",\"0-題材輪動怎麼看\",{\"href\":\"/learn/what-theme-rotation-is-actually-doing\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"題材輪動怎麼看\"}]]}]]}]]]}]\n1f:[\"$\",\"div\",null,{\"className\":\"LearnArticle_related__9qV55\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_relatedTitle__RXfrl\",\"children\":\"相關文章\"}],[[\"$\",\"$L17\",\"theme-stock-lifecycle\",{\"href\":\"/learn/theme-stock-lifecycle\",\"className\":\"LearnArticle_relatedLink__mibXe\",\"children\":\"題材股生命週期\"}],[\"$\",\"$L17\",\"what-theme-rotation-is-actually-doing\",{\"href\":\"/learn/what-theme-rotation-is-actually-doing\",\"className\":\"LearnArticle_relatedLink__mibXe\",\"children\":\"題材輪動怎麼看\"}]]]}]\n13:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\nf:null\n20:I[80622,[],\"IconMark\"]\n11:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"領漲股與跟風股差在哪？先做3個檢查｜股市大佬 TradeBoss\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"同一句題材裡，總有人先被點名，也總有人後來才被塞進清單。前者常被叫領漲，後者常被叫跟風。名字會影響你的膽子：領頭好像比較正、跟風好像比較便宜。比較有用的分法不是誰先漲，而是它動的時候同類跟不跟、沒有這個名詞時它自己還講不講得清。這篇幫你做三個檢查。\"}],[\"$\",\"link\",\"2\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}],[\"$\",\"$L20\",\"3\",{}]],\"error\":null,\"digest\":\"$undefined\"}\n16:\"$11:metadata\"\n"}