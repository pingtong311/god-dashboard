"div\",null,{\"className\":\"LearnArticle_body__6B7Mb\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_intro__ATV5c\",\"children\":\"手機允許通知，不等於每一種市場事件都會推播。你還需要在App選擇主題，並確認事件是否符合設定的條件。請把手機權限、站內設定與實際事件分開檢查。\"}],[],null,[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三個地方要分開看\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"檢查項目\"}],[\"$\",\"th\",\"1\",{\"children\":\"你要確認什麼\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"手機系統\"}],[\"$\",\"td\",\"1\",{\"children\":\"允許App通知，並檢查專注模式及通知摘要設定\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"App通知設定\"}],[\"$\",\"td\",\"1\",{\"children\":\"登入正確帳號，開啟想收到的主題；確認個人的彙整或節流設定\"}]]}],[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"事件條件\"}],[\"$\",\"td\",\"1\",{\"children\":\"漲幅、成交量等條件是否都符合；未達條件不會因開啟主題就一定通知\"}]]}]]}]]}]}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"從哪裡設定？\"}],[[\"$\",\"ol\",\"0\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$1\",\"0-開啟\",{\"children\":\"開啟\"}],[\"$\",\"$L17\",\"1-通知中心\",{\"href\":\"/review\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"通知中心\"}],[\"$\",\"$1\",\"2-查看主題與個人設\",{\"children\":\"查看主題與個人設定。\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$1\",\"0-盤中也可以在\",{\"children\":\"盤中也可以在\"}],[\"$\",\"$L17\",\"1-盤中工作區\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"盤中工作區\"}],[\"$\",\"$1\",\"2-切到「通知設定」\",{\"children\":\"切到「通知設定」，不必離開工作區。\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$1\",\"0-收到訊息後先看日\",{\"children\":\"收到訊息後先看日期、時間、價格與成交量，確認不是舊通知。\"}]]}]]}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"漲幅達8%，不是預告即將鎖漲停\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"漲幅通知描述系統資料在觸發時已達到的條件，不是預測之後會發生什麼。例如通知顯示漲幅達8%，不能解讀為之後一定會漲停，更不代表買賣建議。除權息等情況也要使用當日適用的參考價，不能一律拿昨收自行比較。\"}]]]}],[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"成交量要看累計，還是單筆？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"請依欄位標示判讀。當日累計成交量是截至資料時間的累計，不是剛剛一筆的量；張數與股數也不能混用。不同通知主題的條件可能不同，以當頁說明與自己的設定為準。\"}]]]}],[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"站內有記錄，但手機沒有跳出？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"站內通知與裝置推播是不同階段。即使站內已產生記錄，網路、系統權限、專注模式或推播服務仍可能影響手機呈現。不要反覆註冊帳號；請透過App回饋提供發生時間、股票代號與裝置版本，勿提供密碼或驗證碼。\"}],[\"$\",\"p\",\"1\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":[[\"$\",\"$1\",\"0-接著閱讀\",{\"children\":\"接著閱讀\"}],[\"$\",\"$L17\",\"1-五檔與實際成交的\",{\"href\":\"/learn/how-to-read-order-book-five-levels\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"五檔與實際成交的差別\"}],[\"$\",\"$1\",\"2-，或到\",{\"children\":\"，或到\"}],[\"$\",\"$L17\",\"3-正式App安裝頁\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"正式App安裝頁\"}],[\"$\",\"$1\",\"4-確認安裝入口。\",{\"children\":\"確認安裝入口。\"}]]}]]]}]],null]}]]}]}]\n13:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scal