allelRouterKey\":\"children\",\"error\":\"$undefined\",\"errorStyles\":\"$undefined\",\"errorScripts\":\"$undefined\",\"template\":[\"$\",\"$L5\",null,{}],\"templateStyles\":\"$undefined\",\"templateScripts\":\"$undefined\",\"notFound\":\"$undefined\",\"forbidden\":\"$undefined\",\"unauthorized\":\"$undefined\"}]]}]\nb:[\"$\",\"$1\",\"c\",{\"children\":[\"$Le\",[[\"$\",\"link\",\"0\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/css/3eaf36e367672966.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"$undefined\"}]],[\"$\",\"$Lf\",null,{\"children\":[\"$L10\",[\"$\",\"$L11\",null,{\"promise\":\"$@12\"}]]}]]}]\nc:[\"$\",\"$1\",\"h\",{\"children\":[null,[[\"$\",\"$L13\",null,{\"children\":\"$L14\"}],[\"$\",\"meta\",null,{\"name\":\"next-size-adjust\",\"content\":\"\"}]],[\"$\",\"$L15\",null,{\"children\":[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$16\",null,{\"fallback\":null,\"children\":\"$L17\"}]}]}]]}]\n18:I[52619,[\"2619\",\"static/chunks/2619-04bc32f026a0d946.js\",\"6309\",\"static/chunks/app/learn/%5Bslug%5D/page-f7b99344f7e2ee16.js\"],\"\"]\ne:[\"$\",\"div\",null,{\"className\":\"LearnArticle_wrap__LIQ8G\",\"children\":[\"$\",\"article\",null,{\"className\":\"LearnArticle_article__2nBbk\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_meta__etj_G\",\"children\":[[\"$\",\"$L18\",null,{\"className\":\"LearnArticle_cat__GQMlg\",\"href\":\"/learn?c=trends\",\"children\":\"產業與趨勢\"}],[\"$\",\"span\",null,{\"className\":\"LearnArticle_read__QEj6a\",\"children\":\"閱讀約 7 分鐘\"}]]}],[\"$\",\"h1\",null,{\"className\":\"LearnArticle_title__0_la8\",\"children\":\"先進封裝是什麼？CoWoS、InFO 差在哪？一表看懂半導體關鍵趨勢\"}],[\"$\",\"details\",null,{\"className\":\"LearnArticle_toc__LcSAa\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"LearnArticle_tocSummary__YBddG\",\"children\":\"本文目錄\"}],[\"$\",\"ol\",null,{\"className\":\"LearnArticle_tocList__Rq_Lz\",\"children\":[[\"$\",\"li\",\"sec-1\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-1\",\"children\":\"一、為什麼現在大家都在談「先進封裝」？\"}]}],[\"$\",\"li\",\"sec-2\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-2\",\"children\":\"二、先進封裝 vs. 傳統封裝，到底差在哪？\"}]}],[\"$\",\"li\",\"sec-3\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-3\",\"children\":\"三、CoWoS、InFO 霧煞煞？看懂主流技術在做什麼\"}]}],[\"$\",\"li\",\"sec-4\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-4\",\"children\":\"四、如何判斷一間公司是不是真的「先進封裝概念股」？\"}]}],[\"$\",\"li\",\"sec-5\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-5\",\"children\":\"五、先進封裝的下一步？未來還有哪些機會？\"}]}],[\"$\",\"li\",\"sec-6\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-6\",\"children\":\"常見問題 FAQ\"}]}],[\"$\",\"li\",\"sec-7\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-7\",\"children\":\"總結\"}]}],[\"$\",\"li\",\"sec-8\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-8\",\"children\":\"延伸閱讀\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"LearnArticle_body__6B7Mb\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_intro__ATV5c\",\"children\":\"新聞整天在講 AI 晶片、CoWoS 產能滿載，好像沒跟上就虧了，但「先進封裝」到底是什麼？它跟傳統的封裝差在哪？這篇文章會用白話文說清楚，讓你下次看到新聞，能自己判斷哪些公司真的有關鍵技術。\"}],[],[\"$\",\"div\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"先進封裝是把多個晶片堆疊或並排，讓晶片更小、更快、更省電的技術。\"}],[\"$\",\"li\",\"1\",{\"children\":\"CoWoS 和 InFO 是兩種主流技術，前者適合高效能運算，後者常用於手機。\"}],[\"$\",\"li\",\"2\",{\"children\":\"判斷概念股時，要看相關業務的營收佔比，只沾到邊的公司股價反應可能有限。\"}],[\"$\",\"li\",\"3\",{\"children\":\"先進封裝需求主要來自 AI，是未來幾年半導體產業的關鍵成長動能。\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、為什麼現在大家都在談「先進封裝」？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"過去，半導體進步靠的是把電晶體越做越小，這就是「摩爾定律」。但現在快到物理極限了，很難再縮小。於是，產業想出新方法：與其把一棟平房蓋到極致，不如蓋一棟整合多功能的立體停車塔。「先進封裝」就是這個概念，把不同功能的晶片堆疊或緊密排列在一起，用空間換取更高的效能。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"突破物理極限：當晶片微縮遇到瓶頸，用封裝技術來提升整體價值。\"}],[\"$\",\"li\",\"1\",{\"children\":\"提升晶片效能：縮短晶片間的距離，等於訊號跑的路變短了，速度更快、更省電。\"}],[\"$\",\"li\",\"2\",{\"children\":\"滿足 AI 運算需求：AI 需要同時處理大量數據，先進封裝能把運算晶片和記憶體包在一起，大幅提高效率。\"}]]}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、先進封裝 vs. 傳統封裝，到底差在哪？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"如果把晶片比喻成一顆心臟，傳統封裝就像是做一個保護殼，確保心臟在運送和安裝過程中不會損壞。它的任務很單純，就是保護和基礎的線路連接。但先進封裝的任務複雜多了，它不只是保護殼，更像一個精密的外科手術，要把多個器官（不同晶片）完美地整合在一個極小的空間內，讓它們協同運作。\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"特性\"}],[\"$\",\"th\",\"1\",{\"children\":\"傳統封裝 (Traditional Packaging)\"}],[\"$\",\"th\",\"2\",{\"children\":\"先進封裝 (Advanced Packaging)\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"目的\"}],[\"$\",\"td\",\"1\",{\"children\":\"保護晶片、連接到電路板\"}],[\"$\",\"td\",\"2\",{\"children\":\"整合多晶片、提升系統效能\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"技術\"}],[\"$\",\"td\",\"1\",{\"children\":\"打線接合 (Wire Bonding)\"}],[\"$\",\"td\",\"2\",{\"children\":\"2.5D/3D 堆疊、扇出型 (Fan-Out)\"}]]}],[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"應用\"}],[\"$\",\"td\",\"1\",{\"children\":\"大部分的消費性電子、記憶體\"}],[\"$\",\"td\",\"2\",{\"children\":\"AI 晶片、高效能運算 (HPC)、高階手機\"}]]}],[\"$\",\"tr\",\"3\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"成本\"}],[\"$\",\"td\",\"1\",{\"children\":\"較低，技術成熟\"}],[\"$\",\"td\",\"2\",{\"children\":\"非常高，技術門檻極高\"}]]}]]}]]}]}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、CoWoS、InFO 霧煞煞？看懂主流技術在做什麼\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"聽到這些英文縮寫先別怕，它們只是不同蓋房子的工法。想像一下，CoWoS 像是在一塊高級的「矽中介層」地基上蓋房子，效能穩定但成本高。InFO 則是直接在一般的土地上蓋，省了地基的錢，所以更輕薄，適合手機。而 SoIC 則是終極技術，像直接把樓層無縫地疊上去，效能最強。\"}],\"$L19\",\"$L1a\"]]}],\"$L1b\",\"$L1c\",\"$L1d\",\"$L1e\",\"$L1f\"],null]}]]}]}]\n19:[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"CoWoS (Chip-on-Wafer-on-Substrate)：2.5D 技術，把晶片放在一個矽中介層上再封裝。效能強大，是目前高階 AI 晶片的主流方案。\"}],[\"$\",\"li\",\"1\",{\"children\":\"InFO (Integrated Fan-Out)：不需要中介層，成本較低、也更輕薄。主要用在智慧型手機的處理器上。\"}],[\"$\",\"li\",\"2\",{\"children\":\"SoIC (System-on-Integrated-Chips)：真正的 3D 堆疊，直接把晶片疊起來，訊號延遲最低，是未來的發展方向。\"}]]}]\n1a:[\"$\",\"figure\",\"2\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"✓目的：保護 vs. 整合✓技術：打線 vs. 堆疊✓應用：消費 vs. 高效能\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"傳統 vs. 先進封裝\"}]]}]\n1b:[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、如何判斷一間公司是不是真的「先進封裝概念股」？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"新聞提到某檔是概念股，千萬別直接衝進去。很多公司可能只沾到一點邊，例如只提供某個小材料或設備。真正能長期受惠的，是那些在供應鏈中佔有關鍵位置，而且相關營收佔比夠高的公司。這裡提供一個基本的檢查清單。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"檢查營收佔比：先進封裝相關業務佔公司總營收多少？如果低於 10%，那對獲利的貢獻就相當有限。\"}],[\"$\",\"li\",\"1\",{\"children\":\"分析客戶是誰：它的客戶是晶圓代工龍頭，還是 IC 設計大廠？大客戶的訂單穩不穩定，是判斷未來成長的關鍵。\"}],[\"$\",\"li\",\"2\",{\"children\":\"看懂技術門檻：這家公司的技術是獨家專利，還是很多人都會做？技術護城河的深度，決定了它的議價能力。\"}],[\"$\",\"li\",\"3\",{\"children\":\"別只看新聞標題：花點時間去查公司的法說會簡報，通常會說明未來的業務重心與資本支出方向。\"}]]}]]]}]\n1c:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、先進封裝的下一步？未來還有哪些機會？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"先進封裝的趨勢才剛開始，它為半導體產業打開了新的成長大門。未來，隨著 AI、自動駕駛、物聯網的發展，對高效能晶片的需求只會越來越大。接下來的重點會放在「異質整合」，也就是把不同製程、不同功能的晶片，像樂高一樣自由組合，打造出客製化的高效能系統。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"小晶片 (Chiplet) 技術將成為主流，讓晶片設計更有彈性、成本更低。\"}],[\"$\",\"li\",\"1\",{\"children\":\"光學封裝 (CPO) 是為了解決傳輸瓶頸的潛力方案，用光取代電來傳輸訊號。\"}],[\"$\",\"li\",\"2\",{\"children\":\"新的封裝材料、更高精度的生產與檢測設備，將會是供應鏈中持續存在的機會。\"}]]}]]]}]\n1d:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"散戶可以投資先進封裝嗎？門檻會不會很高？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"可以。除了直接投資晶圓代工龍頭，也可以關注其供應鏈中的設備、材料、或測試廠。這些公司的股本通常較小，但股價波動也可能更大，需要做好自己的研究。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"CoWoS 產能滿載，為什麼股價沒有一直漲？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"股價通常會提前反應市場的預期。當「產能滿載」已經是大家都知道的事實時，它的利多可能已經反映在過去的漲幅中了。後續股價要看的是「未來的成長性」，例如訂單是否持續增加、毛利率能否提升。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"我在財報裡，怎麼找不到「先進封裝」這個項目？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"財報上通常不會有「先進封裝」這個會計科目。它會被歸在公司的營運項目中，例如「先進製程」或特定的封裝測試服務。需要從法說會簡報或公司年報的業務說明中尋找相關資訊。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"買相關的半導體 ETF 會不會比較簡單？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"投資半導體主題的 ETF 是一個分散風險的方式，它會包含一籃子的相關公司。但要注意，ETF 中先進封裝概念股的佔比不一定很高，整體表現會受其他成分股影響，不一定會跟純粹的先進封裝題材完全同步。\"}]]}]]}]]]}]\n1e:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"總結來說，先進封裝是半導體產業突破物理極限的關鍵。與其聽新聞追逐市場關注度高的股票，不如學會看懂 CoWoS、InFO 等技術差異，並從營收佔比和客戶結構，找出真正有競爭力的公司。\"}]]]}]\n1f:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L18\",\"0-到「台股學堂」看\",{\"href\":\"/school\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"到「台股學堂」看更多名詞解釋\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L18\",\"0-用「族群透視」找\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"用「族群透視」找出相關供應鏈\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L18\",\"0-深入研究「個股透\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"深入研究「個股透視」的財務數據\"}]]}]]}]]]}]\n14:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\n10:null\n20:I[80622,[],\"IconMark\"]\n12:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"先進封裝是什麼？CoWoS、InFO 差在哪？一表看懂半導體關鍵趨勢｜股市大佬 TradeBoss\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"新聞整天在講 AI 晶片、CoWoS 產能滿載，好像沒跟上就虧了，但「先進封裝」到底是什麼？它跟傳統的封裝差在哪？這篇文章會用白話文說清楚，讓你下次看到新聞，能自己判斷哪些公司真的有關鍵技術。\"}],[\"$\",\"link\",\"2\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}],[\"$\",\"$L20\",\"3\",{}]],\"error\":null,\"digest\":\"$undefined\"}\n17:\"$12:metadata\"\n"}