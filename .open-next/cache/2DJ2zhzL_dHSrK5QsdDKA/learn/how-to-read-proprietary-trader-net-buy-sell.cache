t\",\"href\":\"/_next/static/css/3eaf36e367672966.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"$undefined\"}]],[\"$\",\"$Le\",null,{\"children\":[\"$Lf\",[\"$\",\"$L10\",null,{\"promise\":\"$@11\"}]]}]]}]\nb:[\"$\",\"$1\",\"h\",{\"children\":[null,[[\"$\",\"$L12\",null,{\"children\":\"$L13\"}],[\"$\",\"meta\",null,{\"name\":\"next-size-adjust\",\"content\":\"\"}]],[\"$\",\"$L14\",null,{\"children\":[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$15\",null,{\"fallback\":null,\"children\":\"$L16\"}]}]}]]}]\n17:I[52619,[\"2619\",\"static/chunks/2619-04bc32f026a0d946.js\",\"6309\",\"static/chunks/app/learn/%5Bslug%5D/page-f7b99344f7e2ee16.js\"],\"\"]\nd:[\"$\",\"div\",null,{\"className\":\"LearnArticle_wrap__LIQ8G\",\"children\":[\"$\",\"article\",null,{\"className\":\"LearnArticle_article__2nBbk\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_meta__etj_G\",\"children\":[[\"$\",\"$L17\",null,{\"className\":\"LearnArticle_cat__GQMlg\",\"href\":\"/learn?c=strategy\",\"children\":\"策略解析\"}],[\"$\",\"span\",null,{\"className\":\"LearnArticle_read__QEj6a\",\"children\":\"閱讀約 7 分鐘\"}]]}],[\"$\",\"h1\",null,{\"className\":\"LearnArticle_title__0_la8\",\"children\":\"自營商買賣超怎麼看？搞懂避險單與自營單，避開 2 個判讀盲點\"}],[\"$\",\"details\",null,{\"className\":\"LearnArticle_toc__LcSAa\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"LearnArticle_tocSummary__YBddG\",\"children\":\"本文目錄\"}],[\"$\",\"ol\",null,{\"className\":\"LearnArticle_tocList__Rq_Lz\",\"children\":[[\"$\",\"li\",\"sec-1\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-1\",\"children\":\"一、為什麼自營商買賣超，一下大買一下大賣？\"}]}],[\"$\",\"li\",\"sec-2\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-2\",\"children\":\"二、最容易誤判的「避險單」，到底是什麼？\"}]}],[\"$\",\"li\",\"sec-3\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-3\",\"children\":\"三、自營商「自行買賣」和「避險」差在哪？一張表看懂\"}]}],[\"$\",\"li\",\"sec-4\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-4\",\"children\":\"四、如何判斷自營商是真看好，還是假避險？\"}]}],[\"$\",\"li\",\"sec-5\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-5\",\"children\":\"五、實戰應用：我該如何運用自營商買賣超數字？\"}]}],[\"$\",\"li\",\"sec-6\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-6\",\"children\":\"常見問題 FAQ\"}]}],[\"$\",\"li\",\"sec-7\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-7\",\"children\":\"總結\"}]}],[\"$\",\"li\",\"sec-8\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-8\",\"children\":\"延伸閱讀\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"LearnArticle_body__6B7Mb\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_intro__ATV5c\",\"children\":\"打開籌碼K線，看到三大法人中的「自營商」，今天大買、明天大賣，是不是讓你很混亂？這篇就是要帶你搞懂，自營商的買賣超數字到底該怎麼解讀，以及為什麼不能單純把他們當作市場方向的指標。\"}],[[\"$\",\"figure\",\"figure-0\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"虧 3 次每次 −1%賺 2 次每次 +1%勝率 40% 也可能是正期望，前提是賺的比虧的大、且扣得起成本短線先扣約 0.24% 當沖成本，再看還剩多少\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"示意圖｜期望值：勝率要配上平均賺賠，再扣成本（教學結構，不是某檔實盤）\"}]]}]],[\"$\",\"div\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"自營商買賣分為「自行買賣」與「避險」兩種，後者不代表看好或看壞。\"}],[\"$\",\"li\",\"1\",{\"children\":\"避險單通常與權證、ETF發行有關，會與散戶方向相反，並非主動操作。\"}],[\"$\",\"li\",\"2\",{\"children\":\"觀察自營商籌碼要看「連續性」，單日大額買賣的參考價值較低。\"}],[\"$\",\"li\",\"3\",{\"children\":\"自營商操作週期偏短，不適合當作長線持有的判斷依據。\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、為什麼自營商買賣超，一下大買一下大賣？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"你看到的「自營商」買賣超，其實包含了兩種完全不同的交易目的，這也是為什麼數字看起來很跳動的原因。簡單來說，券商拿自己的錢出來交易，一種是為了主動賺錢，另一種是為了被動避險，兩者的意義天差地遠。\"}],[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"自行買賣 (Proprietary Trading)：券商用自己的資金，為了賺取股票價差而主動做的交易。這部分比較能代表券商對個股的看法，是我們想觀察的重點。\"}],[\"$\",\"li\",\"1\",{\"children\":\"避險 (Hedging)：因為發行權證、ETF等商品，需要買進或賣出對應的股票來「沖銷風險」，確保自己不會因為散戶賺錢而虧損。這部分跟個股未來漲跌無關。\"}]]}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、最容易誤判的「避險單」，到底是什麼？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"避險交易是最多人誤會的地方。舉個例子：當你（散戶）向A券商買進一張認購權證，代表你賭這檔股票會漲。對A券商來說，他賣權證給你，就等於是跟你對賭。為了避免股價真的上漲時他要賠錢給你，A券商就必須去市場上買進一些現股，先墊著當保險。這筆「買進現股」的動作，就會記錄在自營商的買超上。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"所以，當你看到自營商買超，很可能只是因為散戶大量買進認購權證，券商只好被動買股避險，完全不代表券商看好這檔股票。反之，若散戶大量買進認售權證，自營商反而會去市場上賣出股票來避險，造成賣超。這個觀念非常重要！\"}]]}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、自營商「自行買賣」和「避險」差在哪？一張表看懂\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"既然公開資料把這兩種交易混在一起，我們就要學會分辨它們的動機。一個是想主動出擊賺價差，另一個是想被動防守不虧錢。下表整理了兩者的核心差異，能幫助你建立正確的判斷框架。\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[\"$L18\",\"$L19\",\"$L1a\"]}]}],\"$L1b\"]}]}],\"$L1c\"]]}],\"$L1d\",\"$L1e\",\"$L1f\",\"$L20\",\"$L21\"],null]}]]}]}]\n18:[\"$\",\"th\",\"0\",{\"children\":\"項目\"}]\n19:[\"$\",\"th\",\"1\",{\"children\":\"自行買賣\"}]\n1a:[\"$\",\"th\",\"2\",{\"children\":\"避險\"}]\n1b:[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"交易目的\"}],[\"$\",\"td\",\"1\",{\"children\":\"主動為公司賺取價差\"}],[\"$\",\"td\",\"2\",{\"children\":\"因發行金融商品而被動避險\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"代表意義\"}],[\"$\",\"td\",\"1\",{\"children\":\"券商對個股後市的看法\"}],[\"$\",\"td\",\"2\",{\"children\":\"與散戶對作，不代表方向\"}]]}],[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"操作週期\"}],[\"$\",\"td\",\"1\",{\"children\":\"較短，通常是幾天到幾週\"}],[\"$\",\"td\",\"2\",{\"children\":\"跟隨衍生性商品存續期間\"}]]}],[\"$\",\"tr\",\"3\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"如何判讀\"}],[\"$\",\"td\",\"1\",{\"children\":\"觀察是否「連續買超」\"}],[\"$\",\"td\",\"2\",{\"children\":\"對照權證或ETF籌碼變化\"}]]}]]}]\n1c:[\"$\",\"figure\",\"2\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"!把避險單當成看好訊號!只看一天的大買就進場!忽略權證與ETF的影響!把短線操作當成長線趨勢\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"解讀自營商常見盲點\"}]]}]\n1d:[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、如何判斷自營商是真看好，還是假避險？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"雖然我們無法看到拆分的精確數字，但還是可以從幾個線索來推敲。關鍵就在「連續性」和「關聯性」，不要被一天的數字騙了。真正要建立部位的操作，很少只做一天就結束。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"觀察連續性：真正的自行買賣部位，通常會連續 3-5 天同方向買進或賣出。如果今天爆量大買，明天就反向賣掉，高機率是避險單或極短線交易。\"}],[\"$\",\"li\",\"1\",{\"children\":\"對照權證籌碼：如果某檔股票的自營商買超大增，同時它的認購權證也爆出大量，那這筆買超幾乎可以肯定是避險單，參考價值不高。\"}],[\"$\",\"li\",\"2\",{\"children\":\"避開熱門ETF成分股：大型ETF（如0050、00878）在調整成分股或有大量申購買回時，自營商也會有對應的買賣，這也屬於被動交易。\"}]]}]]]}]\n1e:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、實戰應用：我該如何運用自營商買賣超數字？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"總結來說，自營商籌碼是輔助指標，不能單獨使用。它最大的價值，在於當你發現「自行買賣」部位出現「連續性」買盤時，可能代表有短期的行情機會。例如，你發現某檔中小型股，在沒有明顯權證或ETF影響下，自營商連續買超了5天，且股價也開始加溫，這就是一個值得留意的短線訊號。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"你可以把這樣的標的列入觀察清單，再搭配其他技術面（如均線、K線型態）與籌碼面（如分點集中度）的指標做綜合判斷。切記，千萬不要只因為自營商買超一天，就衝動地複製別人的進出。\"}]]}]]]}]\n1f:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"自營商買超，股價就一定會漲嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"不一定。如文中所提，買超很可能是被動的避險單，不代表看好。即使是主動的自行買賣，自營商也可能判斷錯誤，或只是做幾天的短線價差，所以不能當作股價必漲的保證。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"哪裡可以查到自營商買賣超的詳細資料？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"證交所網站每日都會公布三大法人買賣超的彙總資料。在股市大佬的「個股透視」頁面中，我們也將這些籌碼資料做成圖表，讓你更容易觀察長期的買賣趨勢。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"自營商跟外資、投信比，哪個比較重要？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"一般來說，外資資金規模最大，對大型權值股影響力最高；投信則專注於中小型成長股，有季底作帳行情。自營商的操作週期最短、資金規模相對較小，通常被視為輔助觀察的籌碼指標。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"為什麼有時候自營商買賣超會是0？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"自營商買賣超是「買進張數」減去「賣出張數」的淨額。數字為0，通常代表當天該券商自營部門對這檔股票沒有任何交易，或是極罕見地買進和賣出張數剛好完全相等。\"}]]}]]}]]]}]\n20:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"總結來說，解讀自營商買賣超的關鍵在於「區分動機」。優先思考這筆大單是來自「主動看好」還是「被動避險」，並觀察其「連續性」。單日數據參考價值不高，連續多日的買賣方向，才值得我們進一步研究。\"}]]]}]\n21:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L17\",\"0-用圖表觀察個股籌\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"用圖表觀察個股籌碼結構\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L17\",\"0-更多籌碼名詞解釋\",{\"href\":\"/school\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"更多籌碼名詞解釋\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L17\",\"0-查看每日三大法人\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"查看每日三大法人動向\"}]]}]]}]]]}]\n13:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\nf:null\n22:I[80622,[],\"IconMark\"]\n11:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"自營商買賣超怎麼看？搞懂避險單與自營單，避開 2 個判讀盲點｜股市大佬 TradeBoss\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"打開籌碼K線，看到三大法人中的「自營商」，今天大買、明天大賣，是不是讓你很混亂？這篇就是要帶你搞懂，自營商的買賣超數字到底該怎麼解讀，以及為什麼不能單純把他們當作市場方向的指標。\"}],[\"$\",\"link\",\"2\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}],[\"$\",\"$L22\",\"3\",{}]],\"error\":null,\"digest\":\"$undefined\"}\n16:\"$11:metadata\"\n"}