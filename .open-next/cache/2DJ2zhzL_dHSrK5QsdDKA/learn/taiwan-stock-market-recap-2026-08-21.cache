n\":\"6715 嘉基\"}],[\"$\",\"td\",\"3\",{\"children\":\"-8.94%\"}]]}],[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"5608 四維航\"}],[\"$\",\"td\",\"1\",{\"children\":\"+9.97%\"}],[\"$\",\"td\",\"2\",{\"children\":\"6672 騰輝電子-KY\"}],[\"$\",\"td\",\"3\",{\"children\":\"-6.96%\"}]]}]]}]]}]}],[\"$\",\"figure\",\"2\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"📊外資現貨買超📈自營商現貨買超🧭台指期空單高📘融資維持率188.9%\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"法人動向概覽\"}]]}]]]}]\n1a:[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、外資現貨買超，台指期淨空單居高\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"法人動向方面，外資今天在現貨市場買超約242,945張，自營商也買超約323,182張。然而，在台指期貨市場，外資淨空單仍維持在82,594口的高位，顯示外資在期現貨操作上存在差異。全市場融資維持率為188.9%。\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"法人類別\"}],[\"$\",\"th\",\"1\",{\"children\":\"現貨買賣超\"}],[\"$\",\"th\",\"2\",{\"children\":\"期貨未平倉\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"外資\"}],[\"$\",\"td\",\"1\",{\"children\":\"買超 242,945 張\"}],[\"$\",\"td\",\"2\",{\"children\":\"淨空單 82,594 口\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"自營商\"}],[\"$\",\"td\",\"1\",{\"children\":\"買超 323,182 張\"}],[\"$\",\"td\",\"2\",{\"children\":\"無資料\"}]]}]]}]]}]}]]]}]\n1b:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、國際股市多空交雜，部分產業消息受關注\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"國際股市方面，美股主要指數表現不一，S&P 500下跌0.87%，那斯達克下跌1.00%，但費城半導體指數則上漲0.53%。亞洲股市方面，韓國綜合指數（KOSPI）上漲0.88%，日經225指數則下跌0.30%，國際盤面呈現多空交雜的態勢。今日台股相關新聞標題提及部分廠商7月營收再創新高，以及AI業務的發展潛力，這些消息反映了市場對特定產業前景的關注。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"S&P 500 指數下跌 0.87%。\"}],[\"$\",\"li\",\"1\",{\"children\":\"那斯達克指數下跌 1.00%。\"}],[\"$\",\"li\",\"2\",{\"children\":\"費城半導體指數上漲 0.53%。\"}],[\"$\",\"li\",\"3\",{\"children\":\"韓國綜合指數（KOSPI）上漲 0.88%。\"}],[\"$\",\"li\",\"4\",{\"children\":\"日經 225 指數下跌 0.30%。\"}],[\"$\",\"li\",\"5\",{\"children\":\"今日新聞標題：低價庫存紅利退潮？南亞科、華邦電7月營收再創高 Q3獲利仍有望攻頂、Q4進入毛利率保衛戰。\"}],[\"$\",\"li\",\"6\",{\"children\":\"今日新聞標題：晶技AI業務炸裂！營收占比拚「翻倍」 前十大光通訊廠全數入列。\"}]]}]]]}]\n1c:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"今天台股大盤整體表現如何？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"今天加權指數上漲0.64%，收在45224.29點，但櫃買指數下跌0.68%，收在387.27點，顯示大盤與中小型股表現有所分歧。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"哪些產業族群今天表現比較好？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"今天表現相對強勢的族群包括航運業（+2.73%）、塑膠工業（+2.42%）、金融保險（+1.65%）和橡膠工業（+1.58%）。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"法人今天的操作方向是什麼？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"外資和自營商今天在現貨市場都呈現買超。然而，外資在台指期貨市場的淨空單仍高達82,594口。\"}]]}],[\"$\",\"details\",\"3\",{\"cla