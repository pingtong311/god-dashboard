\",\"tr\",\"4\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"平均漲跌幅\"}],[\"$\",\"td\",\"1\",{\"children\":\"\"}],[\"$\",\"td\",\"2\",{\"children\":\"-1.41%\"}]]}],[\"$\",\"tr\",\"5\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"成交金額\"}],[\"$\",\"td\",\"1\",{\"children\":\"9170.0 億\"}],[\"$\",\"td\",\"2\",{\"children\":\"\"}]]}]]}]]}]}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、族群表現：強弱分明\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"在今日偏弱的盤勢中，部分族群仍展現相對抗跌或上漲的走勢，其中金融保險、航運業表現較為突出。相對地，電子相關族群則普遍面臨較大賣壓。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"金融保險業上漲1.61%，其中2884玉山金領漲。\"}],[\"$\",\"li\",\"1\",{\"children\":\"航運業上漲0.72%，5608四維航表現亮眼。\"}],[\"$\",\"li\",\"2\",{\"children\":\"金融業上漲0.57%，6016康和證漲幅居前。\"}],[\"$\",\"li\",\"3\",{\"children\":\"建材營造業小幅上漲0.20%，6177達麗為族群中漲幅較大的個股。\"}],[\"$\",\"li\",\"4\",{\"children\":\"電子零組件業下跌2.80%。\"}],[\"$\",\"li\",\"5\",{\"children\":\"光電業下跌2.65%。\"}],[\"$\",\"li\",\"6\",{\"children\":\"半導體業下跌2.46%。\"}],[\"$\",\"li\",\"7\",{\"children\":\"電腦及週邊設備業下跌2.26%。\"}]]}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、個股漲跌與當沖熱門\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"今日個股表現分歧，部分個股逆勢上漲，但整體下跌家數遠多於上漲家數。在當沖交易方面，也有數檔個股出現相對高的成交量比。\"}],[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[\"$L18\",\"$L19\",\"$L1a\"]}],\"$L1b\"]]}],\"$L1c\",\"$L1d\",\"$L1e\",\"$L1f\",\"$L20\"],null]}]]}]}]\n18:[\"$\",\"li\",\"0\",{\"children\":\"【上市漲幅榜】2438翔耀上漲9.98%，成交量1014張；3021鴻名上漲9.95%，成交量525張；2464盟立上漲9.90%，成交量17067張；6906現觀科上漲9.88%，成交量397張；2884玉山金上漲6.67%，成交量96702張；5608四維航上漲5.76%，成交量13237張。\"}]\n19:[\"$\",\"li\",\"1\",{\"children\":\"【上市跌幅榜】2491吉祥全下跌10.00%，成交量5334張；6451訊芯-KY下跌10.00%，成交量13899張；8046南電下跌10.00%，成交量23330張；6715嘉基下跌9.96%，成交量1556張；8021尖點下跌9.91%，成交量14442張；2486一詮下跌9.90%，成交量34953張。\"}]\n1a:[\"$\",\"li\",\"2\",{\"children\":\"【當沖熱門】仲琦成交量比29.7倍，股價下跌2.15%；互動成交量比26.4倍，股價下跌1.31%；匯鑽科成交量比16.8倍，股價上漲6.52%；九暘成交量比13.2倍，股價下跌9.89%；擎邦成交量比10.9倍，股價上漲6.57%；東台成交量比10.2倍，股價上漲0.48%。\"}]\n1b:[\"$\",\"figure\",\"2\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"!外資現貨賣超!自營商同步賣超!外資期貨淨空單!融資維持率下滑\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"法人動向速覽\"}]]}]\n1c:[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、法人動向與籌碼觀察\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"今日法人在現貨市場同步呈現賣超，外資與自營商皆賣出大量股票。台指期貨方面，外資淨空單維持在較高水位。全市場融資維持率今日為190.1%，顯示市場整體籌碼面有所變化。\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"項目\"}],[\"$\",\"th\",\"1\",{\"children\":\"數值\"}],[\"$\",\"th\",\"2\",{\"children\":\"備註\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"外資現貨買賣超\"}],[\"$\",\"td\",\"1\",{\"children\":\"-331,163 張\"}],[\"$\",\"td\",\"2\",{\"children\":\"賣超\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"自營商現貨買賣超\"}],[\"$\",\"td\",\"1\",{\"children\":\"-445,841 張\"}],[\"$\",\"td\",\"2\",{\"children\":\"賣超\"}]]}],[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"台指期收盤價\"}],[\"$\",\"td\",\"1\",{\"children\":\"45837.0\"}],[\"$\",\"td\",\"2\",{\"children\":\"-0.76%\"}]]}],[\"$\",\"tr\",\"3\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"台指期未平倉口數\"}],[\"$\",\"td\",\"1\",{\"children\":\"103513\"}],[\"$\",\"td\",\"2\",{\"children\":\"\"}]]}],[\"$\",\"tr\",\"4\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"外資台指期淨空單\"}],[\"$\",\"td\",\"1\",{\"children\":\"81,575 口\"}],[\"$\",\"td\",\"2\",{\"children\":\"\"}]]}]]}]]}]}]]]}]\n1d:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、今日市場消息與國際情勢\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"今日台股盤面雖受電子類股拖累，但個別公司仍有營收或獲利消息傳出。國際市場方面，主要美股指數呈現上漲，亞洲市場則漲跌互見，國際情勢仍是市場關注焦點。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"【台股新聞標題】緯穎AI雙引擎發威，今、明年獲利看增；焦點股》聯發科：早盤大漲近6％ 上檔壓力浮現；營收：力特(3051)8月營收1億6072萬元，月增率-12.66%，年增率14.16%；【2026/08月營收公告】力特(3051) 八月營收1.61億元，年增14.16%-CMoney 小編；健鼎上半年賺贏一個股本 外資上看700元；【12:27 即時新聞】揚智(3041)股價溫和走強至24元，IC設計族群題材延燒＋主力短線回補帶動偏多氣氛。\"}],[\"$\",\"li\",\"1\",{\"children\":\"【國際盤表現】S&P 500指數上漲0.46%；那斯達克指數上漲0.45%；費城半導體指數上漲0.45%；韓國綜合指數（KOSPI）上漲0.26%；日經225指數下跌0.17%。\"}],[\"$\",\"li\",\"2\",{\"children\":\"【近三日國際新聞】CNBC 每日開盤：美中會談成焦點，川普欲更命名荷姆茲海峽；共和黨參議員柯林斯恐成川普關稅戰首批受害者；美國加壓德黑蘭，中國對伊朗支持顯現極限。\"}]]}]]]}]\n1e:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"今天大盤表現如何？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"今天加權指數下跌0.66%，收在45857.66點，而櫃買指數跌幅較大，下跌2.87%。市場上漲家數少於下跌家數，整體氣氛偏弱。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"哪些族群今天表現比較好？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"今日盤面中，金融保險、航運業、金融業及建材營造業表現相對較強，呈現上漲。其中2884玉山金和5608四維航在各自族群中漲幅較大。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"外資今天買賣超情況怎麼樣？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"外資今日在現貨市場賣超約331,163張，同時自營商也賣超約445,841張。在台指期貨方面，外資淨空單為81,575口。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"電子股今天為什麼跌比較多？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"今日電子零組件、光電、半導體及電腦及週邊設備等電子相關族群跌幅較大。公開資料未指出單一明確原因，但這些族群普遍面臨較大賣壓。\"}]]}],[\"$\",\"details\",\"4\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"國際股市對台股有影響嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"今日S&P 500、那斯達克和費城半導體指數均呈現上漲，而台股加權指數則下跌。國際市場表現與台股今日走勢並未呈現直接的同向關係。\"}]]}]]}]]]}]\n1f:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"總結今日台股，加權指數小幅下跌，櫃買指數跌幅較深，電子類股普遍疲弱，而金融與航運族群則相對有撐。法人同步賣超現貨，顯示市場觀望氣氛濃厚。\"}]]]}]\n20:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L17\",\"0-台股學堂\",{\"href\":\"/school\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"台股學堂\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L17\",\"0-今日戰情\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"今日戰情\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L17\",\"0-大盤總覽\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"大盤總覽\"}]]}],[\"$\",\"li\",\"3\",{\"children\":[[\"$\",\"$L17\",\"0-法遵與免責聲明\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"法遵與免責聲明\"}]]}]]}]]]}]\n13:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\nf:null\n21:I[80622,[],\"IconMark\"]\n11:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"2026年9月3日台股盤後：加權指數小跌，櫃買指數跌幅較深｜股市大佬 TradeBoss\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"2026年9月3日台股加權指數收在45857.66點，下跌0.66%，而櫃買指數跌幅較大，收在395.25點，下跌2.87%。整體盤面氣氛偏弱，主要權值股表現相對承壓，但金融保險與航運族群則相對有撐。\"}],[\"$\",\"link\",\"2\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}],[\"$\",\"$L21\",\"3\",{}]],\"error\":null,\"digest\":\"$undefined\"}\n16:\"$11:metadata\"\n"}