\",\"forbidden\":\"$undefined\",\"unauthorized\":\"$undefined\"}]]}],{\"children\":[[\"slug\",\"short-selling-stock-borrowing-vs-margin\",\"d\"],\"$L9\",{\"children\":[\"__PAGE__\",\"$La\",{},null,false]},null,false]},null,false]},null,false],\"$Lb\",false]],\"m\":\"$undefined\",\"G\":[\"$c\",[]],\"s\":false,\"S\":true}\ne:I[24431,[],\"OutletBoundary\"]\n10:I[15278,[],\"AsyncMetadataOutlet\"]\n12:I[24431,[],\"ViewportBoundary\"]\n14:I[24431,[],\"MetadataBoundary\"]\n15:\"$Sreact.suspense\"\n9:[\"$\",\"$1\",\"c\",{\"children\":[null,[\"$\",\"$L4\",null,{\"parallelRouterKey\":\"children\",\"error\":\"$undefined\",\"errorStyles\":\"$undefined\",\"errorScripts\":\"$undefined\",\"template\":[\"$\",\"$L5\",null,{}],\"templateStyles\":\"$undefined\",\"templateScripts\":\"$undefined\",\"notFound\":\"$undefined\",\"forbidden\":\"$undefined\",\"unauthorized\":\"$undefined\"}]]}]\na:[\"$\",\"$1\",\"c\",{\"children\":[\"$Ld\",[[\"$\",\"link\",\"0\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/css/3eaf36e367672966.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"$undefined\"}]],[\"$\",\"$Le\",null,{\"children\":[\"$Lf\",[\"$\",\"$L10\",null,{\"promise\":\"$@11\"}]]}]]}]\nb:[\"$\",\"$1\",\"h\",{\"children\":[null,[[\"$\",\"$L12\",null,{\"children\":\"$L13\"}],[\"$\",\"meta\",null,{\"name\":\"next-size-adjust\",\"content\":\"\"}]],[\"$\",\"$L14\",null,{\"children\":[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$15\",null,{\"fallback\":null,\"children\":\"$L16\"}]}]}]]}]\n17:I[52619,[\"2619\",\"static/chunks/2619-04bc32f026a0d946.js\",\"6309\",\"static/chunks/app/learn/%5Bslug%5D/page-f7b99344f7e2ee16.js\"],\"\"]\nd:[\"$\",\"div\",null,{\"className\":\"LearnArticle_wrap__LIQ8G\",\"children\":[\"$\",\"article\",null,{\"className\":\"LearnArticle_article__2nBbk\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_meta__etj_G\",\"children\":[[\"$\",\"$L17\",null,{\"className\":\"LearnArticle_cat__GQMlg\",\"href\":\"/learn?c=chips\",\"children\":\"籌碼面\"}],[\"$\",\"span\",null,{\"className\":\"LearnArticle_read__QEj6a\",\"children\":\"閱讀約 8 分鐘\"}]]}],[\"$\",\"h1\",null,{\"className\":\"LearnArticle_title__0_la8\",\"children\":\"借券賣出和融券有什麼不同？一篇看懂誰在放空，避開軋空行情\"}],[\"$\",\"details\",null,{\"className\":\"LearnArticle_toc__LcSAa\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"LearnArticle_tocSummary__YBddG\",\"children\":\"本文目錄\"}],[\"$\",\"ol\",null,{\"className\":\"LearnArticle_tocList__Rq_Lz\",\"children\":[[\"$\",\"li\",\"sec-1\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-1\",\"children\":\"一、「借券」和「融券」都是放空，到底差在哪？\"}]}],[\"$\",\"li\",\"sec-2\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-2\",\"children\":\"二、看到「融券」大增，為什麼要小心被「軋空」？\"}]}],[\"$\",\"li\",\"sec-3\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-3\",\"children\":\"三、那看到「借券賣出」大增，代表法人在倒貨嗎？\"}]}],[\"$\",\"li\",\"sec-4\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-4\",\"children\":\"四、如何分辨「真外資」放空與「假外資」操作？\"}]}],[\"$\",\"li\",\"sec-5\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-5\",\"children\":\"五、總結：我該如何應用這些數字？\"}]}],[\"$\",\"li\",\"sec-6\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-6\",\"children\":\"常見問題 FAQ\"}]}],[\"$\",\"li\",\"sec-7\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-7\",\"children\":\"總結\"}]}],[\"$\",\"li\",\"sec-8\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-8\",\"children\":\"延伸閱讀\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"LearnArticle_body__6B7Mb\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_intro__ATV5c\",\"children\":\"打開籌碼資料，看到「融券」和「借券賣出」的數字讓你一頭霧水嗎？感覺都是在放空，但數字背後的意義天差地遠。這篇文章會教你用白話文分清楚，看懂是誰在賣、為什麼要賣，讓你不再自己嚇自己。\"}],[[\"$\",\"figure\",\"figure-0\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"高集中度只說明買超很集中，不說明是誰、要幹嘛前 15 大其餘成交例：集中度 40%＝這批分點淨買超約當天成交的四成不能從集中度推出明天方向\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"示意圖｜分點集中度：前幾大買超合計，佔當天成交的比例（教學結構，不是某檔實盤）\"}]]}]],[\"$\",\"div\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"總結來說，「融券」是散戶情緒的指標，數字飆高時要留意軋空風險\"}],[\"$\",\"li\",\"1\",{\"children\":\"「借券賣出」則是法人的多功能工具箱，必須搭配分點籌碼來判斷其背後動機\"}],[\"$\",\"li\",\"2\",{\"children\":\"別再單看一個數字就急著下決定，學會交叉比對，才能提高勝率\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、「借券」和「融券」都是放空，到底差在哪？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"簡單來說，這兩者都是「先借股票來賣，等價格跌了再買回來還」，賺中間的價差。最大的差別在於「跟誰借」和「誰來借」。你可以想像成：「融券」是散戶拿著身分證去銀行（券商）辦小額信貸；「借券」則是公司法人之間的大額資金拆借，遊戲規則和規模完全不同。\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"特性\"}],[\"$\",\"th\",\"1\",{\"children\":\"融券賣出\"}],[\"$\",\"th\",\"2\",{\"children\":\"借券賣出\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"主要使用者\"}],[\"$\",\"td\",\"1\",{\"children\":\"散戶、一般投資人\"}],[\"$\",\"td\",\"2\",{\"children\":\"三大法人（尤其外資）、大戶\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"券源（股票來源）\"}],[\"$\",\"td\",\"1\",{\"children\":\"主要來自券商\"}],[\"$\",\"td\",\"2\",{\"children\":\"其他法人、基金、保險公司等\"}]]}],[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"資金門檻\"}],[\"$\",\"td\",\"1\",{\"children\":\"較低（九成保證金）\"}],[\"$\",\"td\",\"2\",{\"children\":\"極高，通常是機構法人\"}]]}],[\"$\",\"tr\",\"3\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"限制與彈性\"}],[\"$\",\"td\",\"1\",{\"children\":\"有強制回補規定，券源不穩\"}],[\"$\",\"td\",\"2\",{\"children\":\"限制少，券源穩定，可長期持有\"}]]}],[\"$\",\"tr\",\"4\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"籌碼意義\"}],[\"$\",\"td\",\"1\",{\"children\":\"常被視為散戶看空指標\"}],[\"$\",\"td\",\"2\",{\"children\":\"法人操作，可能是真放空、避險或套利\"}]]}]]}]]}]}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、看到「融券」大增，為什麼要小心被「軋空」？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"「融券」的使用者主要是散戶，資金和資訊都相對弱勢。當一檔股票的融券餘額很高，代表很多散戶在看空。這時候，如果主力或公司派想拉抬股價，就會故意買進讓股價上漲，逼得這些放空的散戶不得不「停損回補」（用更高的價格買回股票），這股買盤力道又會再把股價推得更高，形成「軋空」行情。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"判斷門檻：券資比 > 40% 就是警戒區。券資比代表放空的散戶相對於融資做多的散戶比例，越高越容易引發軋空。\"}],[\"$\",\"li\",\"1\",{\"children\":\"關鍵時間點：股東會、除權息前的「融券最後回補日」。在這天之前，所有融券都必須強制買回，是軋空最常發生的時機。\"}],\"$L18\"]}]]]}],\"$L19\",\"$L1a\",\"$L1b\",\"$L1c\",\"$L1d\",\"$L1e\"],null]}]]}]}]\n18:[\"$\",\"li\",\"2\",{\"children\":\"常見錯誤：看到融券增加就跟著放空。這常會讓你陷入散戶的集體思維，成為被主力狙擊的對象。\"}]\n19:[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、那看到「借券賣出」大增，代表法人在倒貨嗎？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"不一定！這是一般人最常誤解的地方。法人的操作非常複雜，「借券賣出」只是他們的工具之一，背後動機很多元。單純看到借券賣出餘額增加，就認定法人看壞這檔股票，可能會讓你做出錯誤的判斷。與其看絕對數字，不如去思考他們「為什麼」要這麼做。\"}],[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"動機一：真的看壞後市。這是最直覺的，但不是唯一可能。\"}],[\"$\",\"li\",\"1\",{\"children\":\"動機二：策略性避險。例如，法人買了這家公司的可轉換公司債（CB），同時借券賣出股票來鎖住價差，規避股價波動的風險。\"}],[\"$\",\"li\",\"2\",{\"children\":\"動機三：套利交易。例如，當股票的現貨和期貨出現價差時，法人可能會同時買進期貨、賣出現貨（借券賣出）來賺取無風險利潤。\"}],[\"$\",\"li\",\"3\",{\"children\":\"帶得走的方法：觀察借券賣出的券商分點。如果賣超集中在幾家「真正」的外資券商，那看空的意味比較濃；如果很分散，或來自某些被認為是「假外資」的分點，那動機可能就不是單純看壞。\"}]]}],[\"$\",\"figure\",\"2\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"!迷思一：大增代表一定會跌!迷思二：使用者全是外國人!迷思三：單一數字就能當信號\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"解讀借券賣出的三大迷思\"}]]}]]]}]\n1a:[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、如何分辨「真外資」放空與「假外資」操作？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"市場上有些我們俗稱的「假外資」，其實是台灣的資金繞到海外再用外資名義開戶，目的是為了取得稅務優惠或操作上的便利。他們也常用借券工具，但手法跟傳統外資不太一樣。分辨他們能幫助你更精準地解讀籌碼，避免被特定主力的操作手法混淆視聽。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"觀察分點特性：某些券商分點（例如：摩根大通、美林）常被認為是真外資的代表；而某些（例如：部分港系、新加坡券商的台灣分公司）則被市場認為假外資或國內主力色彩較濃。\"}],[\"$\",\"li\",\"1\",{\"children\":\"比對操作連貫性：真外資的操作通常有長線邏輯，買賣較有連續性。假外資或主力的操作則可能較短線，今天大買、明天大賣，手法更靈活。\"}],[\"$\",\"li\",\"2\",{\"children\":\"帶得走的工具：利用「股市大佬」的個股透視頁面，你可以追蹤每日的借券賣出變化，並搭配分點排行功能，查看是哪些券商在進行操作，長期觀察就能建立自己的判斷資料庫。\"}]]}]]]}]\n1b:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、總結：我該如何應用這些數字？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"現在你已經知道融券和借券的差別了。在看盤時，你可以把這兩組數字當成溫度計，一個測量「散戶情緒」，一個觀察「法人動向」。它們本身沒有絕對的好壞，重點是解讀數字背後的意義，並搭配股價位階、成交量和其他籌碼指標一起看，才能拼湊出完整的圖像。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"一個判斷原則：融券看「比率」（券資比），小心物極必反的軋空。借券看「動機」（是避險還是真放空），要搭配分點與法人其他部位一起解讀。\"}]]}]]]}]\n1c:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"借券賣出餘額一直增加，股價卻一直漲，為什麼？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"這很可能是「軋空手」行情，代表市場上的買盤力道遠大於法人放空的壓力。也可能是法人的借券賣出是為了避險，他們在其他地方（如期貨、選擇權）有更大的多單部位，整體來看依然是做多。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"我是散戶，可以「借券」嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"理論上可以，但門檻非常高。您需要符合主管機關定義的「專業投資人」資格，通常需要有相當規模的資產與交易經驗。對絕大多數散戶來說，「融券」才是主要且合法的放空管道。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"「券資比」是什麼？要怎麼看？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"券資比的公式是「融券餘額張數 ÷ 融資餘額張數」。它反映了市場上散戶多空看法對決的激烈程度。一般來說，券資比超過 40% 就屬於高水位，代表看空的散戶很多，股價若持續上漲，引發軋空的可能性就越高。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"哪裡可以查到最新的借券和融券資料？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"台灣證券交易所的官方網站在盤後會公布每日的融資融券與借券賣出餘額。如果想看更直覺的圖表與長期的歷史趨勢，「股市大佬」的個股透視頁面都幫您整理好了，可以省下自己找資料的時間。\"}]]}]]}]]]}]\n1d:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"總結來說，「融券」是散戶情緒的指標，數字飆高時要留意軋空風險；「借券賣出」則是法人的多功能工具箱，必須搭配分點籌碼來判斷其背後動機。別再單看一個數字就急著下決定，學會交叉比對，才能提高勝率。\"}]]]}]\n1e:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L17\",\"0-想學更多？從台股\",{\"href\":\"/school\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"想學更多？從台股學堂開始\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L17\",\"0-在個股透視頁查詢\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"在個股透視頁查詢最新籌碼\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L17\",\"0-追蹤關鍵券商，請\",{\"href\":\"/chips/2330\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"追蹤關鍵券商，請看分點排行\"}]]}]]}]]]}]\n13:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\nf:null\n1f:I[80622,[],\"IconMark\"]\n11:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"借券賣出和融券有什麼不同？一篇看懂誰在放空，避開軋空行情｜股市大佬 TradeBoss\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"打開籌碼資料，看到「融券」和「借券賣出」的數字讓你一頭霧水嗎？感覺都是在放空，但數字背後的意義天差地遠。這篇文章會教你用白話文分清楚，看懂是誰在賣、為什麼要賣，讓你不再自己嚇自己。\"}],[\"$\",\"link\",\"2\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}],[\"$\",\"$L1f\",\"3\",{}]],\"error\":null,\"digest\":\"$undefined\"}\n16:\"$11:metadata\"\n"}