",\"template\":[\"$\",\"$L5\",null,{}],\"templateStyles\":\"$undefined\",\"templateScripts\":\"$undefined\",\"notFound\":\"$undefined\",\"forbidden\":\"$undefined\",\"unauthorized\":\"$undefined\"}]]}]\na:[\"$\",\"$1\",\"c\",{\"children\":[\"$Ld\",[[\"$\",\"link\",\"0\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/css/3eaf36e367672966.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"$undefined\"}]],[\"$\",\"$Le\",null,{\"children\":[\"$Lf\",[\"$\",\"$L10\",null,{\"promise\":\"$@11\"}]]}]]}]\nb:[\"$\",\"$1\",\"h\",{\"children\":[null,[[\"$\",\"$L12\",null,{\"children\":\"$L13\"}],[\"$\",\"meta\",null,{\"name\":\"next-size-adjust\",\"content\":\"\"}]],[\"$\",\"$L14\",null,{\"children\":[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$15\",null,{\"fallback\":null,\"children\":\"$L16\"}]}]}]]}]\n17:I[52619,[\"2619\",\"static/chunks/2619-04bc32f026a0d946.js\",\"6309\",\"static/chunks/app/learn/%5Bslug%5D/page-f7b99344f7e2ee16.js\"],\"\"]\nd:[\"$\",\"div\",null,{\"className\":\"LearnArticle_wrap__LIQ8G\",\"children\":[\"$\",\"article\",null,{\"className\":\"LearnArticle_article__2nBbk\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_meta__etj_G\",\"children\":[[\"$\",\"$L17\",null,{\"className\":\"LearnArticle_cat__GQMlg\",\"href\":\"/learn?c=platform\",\"children\":\"平台教學\"}],[\"$\",\"span\",null,{\"className\":\"LearnArticle_read__QEj6a\",\"children\":\"閱讀約 7 分鐘\"}]]}],[\"$\",\"h1\",null,{\"className\":\"LearnArticle_title__0_la8\",\"children\":\"股市大佬大盤總覽看什麼？3 個重點判斷市場氣氛，避開盤勢陷阱\"}],[\"$\",\"details\",null,{\"className\":\"LearnArticle_toc__LcSAa\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"LearnArticle_tocSummary__YBddG\",\"children\":\"本文目錄\"}],[\"$\",\"ol\",null,{\"className\":\"LearnArticle_tocList__Rq_Lz\",\"children\":[[\"$\",\"li\",\"sec-1\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-1\",\"children\":\"一、漲跌家數：市場是「虛胖」還是「健康」？\"}]}],[\"$\",\"li\",\"sec-2\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-2\",\"children\":\"二、成交值排行：錢往哪裡去，行情就在哪\"}]}],[\"$\",\"li\",\"sec-3\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-3\",\"children\":\"三、融資融券餘額：散戶的情緒指標\"}]}],[\"$\",\"li\",\"sec-4\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-4\",\"children\":\"四、三大法人買賣超：誰在主導盤勢？\"}]}],[\"$\",\"li\",\"sec-5\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-5\",\"children\":\"五、如何整合大盤資訊，擬定你的觀察清單？\"}]}],[\"$\",\"li\",\"sec-6\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-6\",\"children\":\"常見問題 FAQ\"}]}],[\"$\",\"li\",\"sec-7\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-7\",\"children\":\"總結\"}]}],[\"$\",\"li\",\"sec-8\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-8\",\"children\":\"延伸閱讀\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"LearnArticle_body__6B7Mb\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_intro__ATV5c\",\"children\":\"打開大盤總覽頁面，漲跌家數、成交量、融資融券⋯⋯一堆數字跳出來，到底哪個才是重點？如果只會看加權指數的紅綠，很容易錯過市場的真實溫度，做出錯誤判斷。這篇文章會教你從 3 個關鍵區塊，快速掌握今天市場是強是弱、錢流向哪裡，讓你不再盲目跟著指數起伏。\"}],[],[\"$\",\"div\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"看漲跌家數，強勢盤的上漲家數通常是下跌家數的 1.5 倍以上。\"}],[\"$\",\"li\",\"1\",{\"children\":\"成交「值」比成交「量」更能看出主流資金，錢在哪行情就在哪。\"}],[\"$\",\"li\",\"2\",{\"children\":\"融資餘額大增常是散戶進場訊號，若股價不漲反跌就要留意風險。\"}],[\"$\",\"li\",\"3\",{\"children\":\"外資單日買賣超百億是觀察大盤方向的重要參考數字，需注意連續性。\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、漲跌家數：市場是「虛胖」還是「健康」？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"很多人看盤只看大盤指數漲多少，但這常有盲點。有時指數漲百點，卻是靠少數幾檔大型權值股拉抬，大部分股票其實是跌的，這就是「虛胖」。真正健康的盤勢，應該是多數股票都上漲。因此，第一步要看「漲跌家數比」，也就是上漲家數除以家跌家數。這個數字能告訴你市場的廣度。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"判斷門檻：漲跌家數比 > 1.5，代表市場普遍強勢，人氣可用。\"}],[\"$\",\"li\",\"1\",{\"children\":\"判斷門檻：漲跌家數比 < 0.7，代表盤面偏弱，多數個股下跌，操作要保守。\"}],[\"$\",\"li\",\"2\",{\"children\":\"常見錯誤：只看指數漲跌，忽略手中持股可能和指數走勢脫鉤。\"}]]}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、成交值排行：錢往哪裡去，行情就在哪\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"股市是資金堆出來的，想知道市場焦點在哪，就要追蹤「錢」的流向。比起看成交「量」（成交張數），看成交「值」（成交金額）更為準確。因為一張一百元的股票和一張十元的股票，成交量同樣是一張，但背後代表的資金實力完全不同。觀察當日成交值排行前 20-30 名的股票與其所屬的族群，就能快速掌握盤面上的主流。\"}],[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"觀察重點：成交值排行榜前幾名，是集中在電子股、金融股還是傳產股？\"}],[\"$\",\"li\",\"1\",{\"children\":\"判斷方法：如果好幾個強勢族群輪流表現，且成交值能溫和放大，代表資金動能健康。\"}],[\"$\",\"li\",\"2\",{\"children\":\"常見錯誤：買進的股票成交值太小（例如一天不到 5000 萬），代表市場關注度低，股價可能較難有表現，流動性也差。\"}]]}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、融資融券餘額：散戶的情緒指標\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"「融資」是投資人向券商借錢買股票，常被視為散戶指標；「融券」則是借股票來賣，看空後市。這兩個數字的變化，反映了市場上散戶的集體情緒。當融資餘額在短時間內大幅增加，代表散戶積極進場，但如果股價沒有跟著上漲，反而要小心籌碼變得凌亂，未來可能出現多殺多的賣壓。\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"情況\"}],[\"$\",\"th\",\"1\",{\"children\":\"融資變化\"}],[\"$\",\"th\",\"2\",{\"children\":\"融券變化\"}],[\"$\",\"th\",\"3\",{\"children\":\"可能代表的市場情緒\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"價漲量增\"}],[\"$\",\"td\",\"1\",{\"children\":\"增加\"}],[\"$\",\"td\",\"2\",{\"children\":\"減少\"}],\"$L18\"]}],\"$L19\",\"$L1a\",\"$L1b\"]}]]}]}],\"$L1c\"]]}],\"$L1d\",\"$L1e\",\"$L1f\",\"$L20\",\"$L21\"],null]}]]}]}]\n18:[\"$\",\"td\",\"3\",{\"children\":\"散戶積極追價，市場過熱風險\"}]\n19:[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"價漲量縮\"}],[\"$\",\"td\",\"1\",{\"children\":\"減少\"}],[\"$\",\"td\",\"2\",{\"children\":\"增加\"}],[\"$\",\"td\",\"3\",{\"children\":\"籌碼趨於穩定，有利軋空\"}]]}]\n1a:[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"價跌量增\"}],[\"$\",\"td\",\"1\",{\"children\":\"增加\"}],[\"$\",\"td\",\"2\",{\"children\":\"減少\"}],[\"$\",\"td\",\"3\",{\"children\":\"散戶在低點承接，多殺多風險增\"}]]}]\n1b:[\"$\",\"tr\",\"3\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"價跌量縮\"}],[\"$\",\"td\",\"1\",{\"children\":\"減少\"}],[\"$\",\"td\",\"2\",{\"children\":\"減少\"}],[\"$\",\"td\",\"3\",{\"children\":\"人氣退潮，多空雙方皆觀望\"}]]}]\n1c:[\"$\",\"figure\",\"2\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"✓上漲家數 > 下跌家數？✓資金是集中還是分散？✓融資是否異常增加？✓外資是買超還賣超？\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"每日大盤數據檢查清單\"}]]}]\n1d:[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、三大法人買賣超：誰在主導盤勢？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"三大法人（外資、投信、自營商）是台股的主要參與者，他們的動向對大盤有舉足輕重的影響力，其中又以外資最為關鍵。所謂「買超」就是買進金額大於賣出金額，「賣超」則相反。觀察法人是站在買方還是賣方，以及他們主要買賣哪些股票，可以幫助我們了解市場的主力看法。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"外資動向：單日買賣超金額是否超過新台幣 100 億元？連續買超或賣超幾天了？\"}],[\"$\",\"li\",\"1\",{\"children\":\"投信動向：投信的操作通常有季度或年度的作帳行情，他們的買盤相對穩定，對中小型股影響力大。\"}],[\"$\",\"li\",\"2\",{\"children\":\"判斷方法：如果外資和投信「同買」，通常對股價有正面助益；反之「同賣」則壓力較大。\"}]]}]]]}]\n1e:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、如何整合大盤資訊，擬定你的觀察清單？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"看完以上指標後，你應該對市場的全貌有了基本掌握。一個好的習慣是，每天盤後花幾分鐘，將這些資訊整合起來。例如，今天大盤強勢（漲跌家數比 > 1.5），資金主要流向 AI 伺服器族群（成交值排行），且外資與投信都在買超其中幾檔關鍵個股。這樣一來，你的觀察名單就有了明確的方向與依據，而不是隨意聽信別人給的標的。\"}],[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"第一步：確認今日盤勢強弱（看漲跌家數比）。\"}],[\"$\",\"li\",\"1\",{\"children\":\"第二步：找出資金集中的主流族群（看成交值排行與類股漲跌）。\"}],[\"$\",\"li\",\"2\",{\"children\":\"第三步：從主流族群中，篩選出法人正在佈局的個股（看三大法人買賣超）。\"}]]}]]]}]\n1f:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"大盤一直漲，為什麼我的股票卻一直跌？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"這很可能是「賺了指數、賠了差價」的情況。原因可能是資金都集中在拉抬大型權值股，而您持有的中小型股或非主流類股，反而因為資金排擠效應而下跌。這時更應該透過大盤總覽，確認資金的真實流向。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"外資買超，股價就一定會漲嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"不一定。外資的買賣超要看「連續性」和「標的」。有時外資只是進行指數型基金的被動調整，或是短線的策略性操作。如果外資是連續好幾天、持續買進某一檔或某個族群，那參考價值才會比較高。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"這些大盤數字盤中會變嗎？還是只有盤後才看得到？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"漲跌家數、成交值排行、類股漲跌幅這些都是盤中即時變動的。而三大法人買賣超、融資融券餘額等籌碼資料，則是由證交所在每日收盤後計算並公布，盤中是看不到準確數字的。（資料更新時間以交易所公告為準，2026-08 查證）\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"融資維持率是什麼？跟融資餘額有什麼不同？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"融資「餘額」代表散戶借了多少錢，是「流量」的概念。而融資「維持率」則代表散戶手上持股的健康程度，是「安全水位」的概念。當維持率過低時，可能引發斷頭賣壓，是大盤的潛在風險之一。\"}]]}]]}]]]}]\n20:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"看懂大盤總覽，就像開車要會看儀表板。與其猜測指數漲跌，不如學會從漲跌家數比、資金流向和法人動態這幾個客觀數據，判斷市場的真實健康度，做出更有依據的決策。\"}]]]}]\n21:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L17\",\"0-前往「大盤總覽」\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"前往「大盤總覽」頁面，立即應用所學\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L17\",\"0-想知道今日法人動\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"想知道今日法人動向？查看「今日戰情」\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L17\",\"0-更多台股名詞解釋\",{\"href\":\"/school\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"更多台股名詞解釋，請見「台股學堂」\"}]]}]]}]]]}]\n13:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\nf:null\n22:I[80622,[],\"IconMark\"]\n11:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"股市大佬大盤總覽看什麼？3 個重點判斷市場氣氛，避開盤勢陷阱｜股市大佬 TradeBoss\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"打開大盤總覽頁面，漲跌家數、成交量、融資融券⋯⋯一堆數字跳出來，到底哪個才是重點？如果只會看加權指數的紅綠，很容易錯過市場的真實溫度，做出錯誤判斷。這篇文章會教你從 3 個關鍵區塊，快速掌握今天市場是強是弱、錢流向哪裡，讓你不再盲目跟著指數起伏。\"}],[\"$\",\"link\",\"2\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}],[\"$\",\"$L22\",\"3\",{}]],\"error\":null,\"digest\":\"$undefined\"}\n16:\"$11:metadata\"\n"}