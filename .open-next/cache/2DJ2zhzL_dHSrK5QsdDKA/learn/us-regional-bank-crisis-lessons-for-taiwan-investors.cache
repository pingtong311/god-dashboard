hidden\":true,\"children\":[\"$\",\"$16\",null,{\"fallback\":null,\"children\":\"$L17\"}]}]}]]}]\n18:I[52619,[\"2619\",\"static/chunks/2619-04bc32f026a0d946.js\",\"6309\",\"static/chunks/app/learn/%5Bslug%5D/page-f7b99344f7e2ee16.js\"],\"\"]\ne:[\"$\",\"div\",null,{\"className\":\"LearnArticle_wrap__LIQ8G\",\"children\":[\"$\",\"article\",null,{\"className\":\"LearnArticle_article__2nBbk\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_meta__etj_G\",\"children\":[[\"$\",\"$L18\",null,{\"className\":\"LearnArticle_cat__GQMlg\",\"href\":\"/learn?c=events\",\"children\":\"金融大事件\"}],[\"$\",\"span\",null,{\"className\":\"LearnArticle_read__QEj6a\",\"children\":\"閱讀約 6 分鐘\"}]]}],[\"$\",\"h1\",null,{\"className\":\"LearnArticle_title__0_la8\",\"children\":\"美國區域性銀行風波為什麼會燒到台股？散戶必學的 3 個避險教訓\"}],[\"$\",\"details\",null,{\"className\":\"LearnArticle_toc__LcSAa\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"LearnArticle_tocSummary__YBddG\",\"children\":\"本文目錄\"}],[\"$\",\"ol\",null,{\"className\":\"LearnArticle_tocList__Rq_Lz\",\"children\":[[\"$\",\"li\",\"sec-1\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-1\",\"children\":\"一、首先，那幾家美國銀行到底發生了什麼事？\"}]}],[\"$\",\"li\",\"sec-2\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-2\",\"children\":\"二、為什麼利率一升，銀行就撐不住了？\"}]}],[\"$\",\"li\",\"sec-3\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-3\",\"children\":\"三、美國銀行出事，為什麼台股也跟著跌？\"}]}],[\"$\",\"li\",\"sec-4\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-4\",\"children\":\"四、如何判斷哪些公司可能受到比較大的衝擊？\"}]}],[\"$\",\"li\",\"sec-5\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-5\",\"children\":\"五、下次再遇到國際大利空，我該怎麼辦？\"}]}],[\"$\",\"li\",\"sec-6\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-6\",\"children\":\"常見問題 FAQ\"}]}],[\"$\",\"li\",\"sec-7\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-7\",\"children\":\"總結\"}]}],[\"$\",\"li\",\"sec-8\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-8\",\"children\":\"延伸閱讀\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"LearnArticle_body__6B7Mb\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_intro__ATV5c\",\"children\":\"還記得幾年前美國好幾家銀行連環倒閉，全球股市跟著大地震嗎？新聞一堆專有名詞，你可能只覺得心慌慌，不知道該賣還是該買。這篇文章帶你回顧事件始末，看懂背後的金融邏輯，下次遇到類似狀況就不再手足無措。\"}],[],[\"$\",\"div\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"利率快速拉升是導火線，導致銀行長期債券資產大幅虧損。\"}],[\"$\",\"li\",\"1\",{\"children\":\"恐慌透過社群媒體快速傳播，引發擠兌，加速銀行倒閉。\"}],[\"$\",\"li\",\"2\",{\"children\":\"台股金融、科技產業與美國連動深，易受衝擊也可能出現新機會。\"}],[\"$\",\"li\",\"3\",{\"children\":\"學會檢視持股的海外曝險，是保護資產的基本功課。\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、首先，那幾家美國銀行到底發生了什麼事？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"簡單來說，就是銀行版的「資產縮水」。起因是美國為了打擊通膨，在短時間內大幅升息，導致銀行之前買的長期政府公債價格大跌。當銀行需要現金、必須賣掉這些債券時，就會產生鉅額虧損。消息一出，存戶怕錢拿不回來，就瘋狂去領錢（這就是「擠兌」），銀行現金不夠，危機就爆發了。\"}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、為什麼利率一升，銀行就撐不住了？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"這要從銀行的賺錢模式說起。銀行用比較低的利率向存戶收錢（存款），再用比較高的利率把錢借出去或買長期債券賺利差。當利率「緩慢」上升，銀行是開心的。但如果是「又急又猛」的升息，會讓舊的、低利率的長期債券價格暴跌。這就像你用 100 萬買了房子，結果市場不好，現在只值 70 萬，你的資產就「未實現虧損」了 30 萬。\"}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、美國銀行出事，為什麼台股也跟著跌？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"全球金融市場是連在一起的。首先，投資人會擔心這是不是系統性風險的開端，所以會先賣掉風險較高的股票，轉向現金或公債等避險資產，台股自然會被外資提款。其次，台灣很多金融業或壽險公司也持有大量美國債券，資產同樣會縮水。另外，倒閉的銀行很多客戶是科技新創公司，這也衝擊了以科技業為重心的台股供應鏈。\"}],[\"$\",\"figure\",\"1\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"✓持股是否過度集中✓檢視金融股曝險程度✓了解公司海外營收佔比✓保留部分現金彈性運用\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"我的投資組合健檢清單\"}]]}]]]}],[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、如何判斷哪些公司可能受到比較大的衝擊？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"當類似的海外金融風暴發生時，你可以從幾個角度來檢查自己的持股。最直接的就是看公司的「海外曝險程度」，特別是在事件發生地的營收或資產佔比。對於金融股，要觀察它們的資產負債表，看看長天期債券的部位有多少，以及未實現損益的狀況。以下是一個簡單的比較表，幫助你快速判斷。\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"評估面向\"}],[\"$\",\"th\",\"1\",{\"children\":\"風險較高特徵\"}],[\"$\",\"th\",\"2\",{\"children\":\"相對穩健特徵\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[\"$L19\",\"$L1a\",\"$L1b\",\"$L1c\"]}]]}]}]]]}],\"$L1d\",\"$L1e\",\"$L1f\",\"$L20\"],null]}]]}]}]\n19:[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"海外業務佔比\"}],[\"$\",\"td\",\"1\",{\"children\":\"營收或資產高度集中在風暴區\"}],[\"$\",\"td\",\"2\",{\"children\":\"業務分散全球或以內需為主\"}]]}]\n1a:[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"金融資產結構\"}],[\"$\",\"td\",\"1\",{\"children\":\"持有大量長天期債券，未實現虧損大\"}],[\"$\",\"td\",\"2\",{\"children\":\"資產配置多元，短天期資產多\"}]]}]\n1b:[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"客戶集中度\"}],[\"$\",\"td\",\"1\",{\"children\":\"主要客戶集中在單一高風險產業\"}],[\"$\",\"td\",\"2\",{\"children\":\"客戶基礎廣泛，遍及各行各業\"}]]}]\n1c:[\"$\",\"tr\",\"3\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"現金流狀況\"}],[\"$\",\"td\",\"1\",{\"children\":\"自由現金流不穩定或為負數\"}],[\"$\",\"td\",\"2\",{\"children\":\"長期擁有穩健的正向現金流\"}]]}]\n1d:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、下次再遇到國際大利空，我該怎麼辦？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"恐慌是最大的敵人。第一步是「不要自亂陣腳」，不要在看不懂狀況時就清空持股。你可以先檢視自己的投資組合，評估受影響的程度。再來，保留部分現金，市場過度恐慌時，往往會有一些體質好但被錯殺的公司出現便宜的價格。這不是鼓勵你在低點承接，而是讓你在冷靜後有選擇的權利，而不是被迫賣在最低點。\"}]]]}]\n1e:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"這件事都過去了，為什麼現在還要回顧？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"因為太陽底下沒有新鮮事。金融市場的循環與人性恐慌，在未來還是會以不同形式出現。搞懂一次，下次你就能比別人更冷靜，看懂事件的核心，而不是只跟著新聞標題殺進殺出。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"台灣的銀行會不會也發生一樣的事？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"台灣的金融監管相對嚴格，且銀行資產配置與美國不同，發生一模一樣狀況的機率較低。但仍需注意全球利率環境的變化，因為這會影響所有金融機構的資產價值。（以主管機關最新公告為準，查證月份：2026-08）\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"我怎麼知道我的持股有沒有受到海外事件影響？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"最直接的方法是去看公司的財務報表或法人說明會資料，裡面通常會揭露各地區的營收佔比。如果看不懂，也可以利用「股市大佬」的族群透視功能，觀察整個產業鏈的連動狀況，快速了解影響範圍。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"下次再發生類似利空，我第一時間該做什麼？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"先深呼吸，不要打開 App 馬上賣股票。第一步是確認消息來源與嚴重性，第二步是檢查自己的持股曝險程度。如果你的持股與事件關聯不大，股價下跌可能只是市場情緒影響，反而要保持冷靜。\"}]]}]]}]]]}]\n1f:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"總結來說，國際金融事件對台股的衝擊不容忽視。與其在恐慌中亂賣股票，不如平時就做好功課，了解持股的海外業務關聯性，並學會從危機中辨識風險與機會，才能在市場波動時保持冷靜。\"}]]]}]\n20:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L18\",\"0-用族群透視看懂產\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"用族群透視看懂產業鏈影響\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L18\",\"0-從大盤總覽掌握市\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"從大盤總覽掌握市場情緒\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L18\",\"0-到台股學堂補充更\",{\"href\":\"/school\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"到台股學堂補充更多金融知識\"}]]}]]}]]]}]\n14:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\n10:null\n21:I[80622,[],\"IconMark\"]\n12:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"美國區域性銀行風波為什麼會燒到台股？散戶必學的 3 個避險教訓｜股市大佬 TradeBoss\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"還記得幾年前美國好幾家銀行連環倒閉，全球股市跟著大地震嗎？新聞一堆專有名詞，你可能只覺得心慌慌，不知道該賣還是該買。這篇文章帶你回顧事件始末，看懂背後的金融邏輯，下次遇到類似狀況就不再手足無措。\"}],[\"$\",\"link\",\"2\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}],[\"$\",\"$L21\",\"3\",{}]],\"error\":null,\"digest\":\"$undefined\"}\n17:\"$12:metadata\"\n"}