",\"$15\",null,{\"fallback\":null,\"children\":\"$L16\"}]}]}]]}]\n17:I[52619,[\"2619\",\"static/chunks/2619-04bc32f026a0d946.js\",\"6309\",\"static/chunks/app/learn/%5Bslug%5D/page-f7b99344f7e2ee16.js\"],\"\"]\nd:[\"$\",\"div\",null,{\"className\":\"LearnArticle_wrap__LIQ8G\",\"children\":[\"$\",\"article\",null,{\"className\":\"LearnArticle_article__2nBbk\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_meta__etj_G\",\"children\":[[\"$\",\"$L17\",null,{\"className\":\"LearnArticle_cat__GQMlg\",\"href\":\"/learn?c=rules\",\"children\":\"制度與工具\"}],[\"$\",\"span\",null,{\"className\":\"LearnArticle_read__QEj6a\",\"children\":\"閱讀約 7 分鐘\"}]]}],[\"$\",\"h1\",null,{\"className\":\"LearnArticle_title__0_la8\",\"children\":\"ETF折溢價是什麼？溢價太高可以空嗎？一篇看懂市價與淨值\"}],[\"$\",\"details\",null,{\"className\":\"LearnArticle_toc__LcSAa\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"LearnArticle_tocSummary__YBddG\",\"children\":\"本文目錄\"}],[\"$\",\"ol\",null,{\"className\":\"LearnArticle_tocList__Rq_Lz\",\"children\":[[\"$\",\"li\",\"sec-1\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-1\",\"children\":\"一、為什麼 ETF 會有市價和淨值兩種價格？\"}]}],[\"$\",\"li\",\"sec-2\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-2\",\"children\":\"二、折價、溢價怎麼算？數字代表什麼意思？\"}]}],[\"$\",\"li\",\"sec-3\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-3\",\"children\":\"三、看到「大幅溢價」，我該注意什麼？\"}]}],[\"$\",\"li\",\"sec-4\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-4\",\"children\":\"四、什麼時候容易出現誇張的折溢價？\"}]}],[\"$\",\"li\",\"sec-5\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-5\",\"children\":\"五、我在哪裡可以查到最新的 ETF 折溢價資料？\"}]}],[\"$\",\"li\",\"sec-6\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-6\",\"children\":\"常見問題 FAQ\"}]}],[\"$\",\"li\",\"sec-7\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-7\",\"children\":\"總結\"}]}],[\"$\",\"li\",\"sec-8\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-8\",\"children\":\"延伸閱讀\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"LearnArticle_body__6B7Mb\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_intro__ATV5c\",\"children\":\"看到想買的 ETF，一下單才發現成交價比網站上看到的「淨值」貴了一截？這中間的差價就是「折溢價」。這篇文章會教你怎麼看懂這個數字，避免買貴，甚至找到合理的進場時機。\"}],[[\"$\",\"figure\",\"figure-0\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"沒扣成本的勝率，看起來都會比較漂亮0.029%手續費 1 折來回0.15%當沖證交稅0.06%滑價估計三項合計約 0.24%；留倉稅率更高，約 0.39%\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"示意圖｜當沖來回成本：1 折手續費 + 證交稅 + 滑價（教學結構，不是某檔實盤）\"}]]}]],[\"$\",\"div\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"ETF 折溢價是「市價」和「淨值」的差距，正數是溢價（買貴了），負數是折價（買便宜了）。\"}],[\"$\",\"li\",\"1\",{\"children\":\"長期持有者應避開溢價超過 1% 的 ETF，因為市價終究會往淨值靠攏，等於一買進就先承擔了回檔風險。\"}],[\"$\",\"li\",\"2\",{\"children\":\"大幅溢價通常發生在市場追捧熱門題材時，此時更需冷靜，別因害怕錯過而追高。\"}],[\"$\",\"li\",\"3\",{\"children\":\"折價看似便宜，但有時是市場恐慌或流動性不足的信號，要小心背後的原因。\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、為什麼 ETF 會有市價和淨值兩種價格？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"簡單來說，ETF 像是一籃子股票的組合包，它有兩種價格。「淨值 (Net Asset Value, NAV)」是這籃子裡所有股票的「真實總價值」，由發行公司（投信）計算公布。而「市價」則是這檔 ETF 在股票市場上，由所有投資人買賣搓合出來的「成交價」。因為市場情緒會波動，所以市價很少會剛好等於淨值。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"**淨值 (NAV):** 像一籃水果的「真實總價值」，由發行商每隔一段時間計算並公布，代表 ETF 的內在價值。\"}],[\"$\",\"li\",\"1\",{\"children\":\"**市價 (Market Price):** 像菜市場裡這籃水果的「成交價」，由買賣雙方的出價決定，在交易時間內隨時在變動。\"}]]}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、折價、溢價怎麼算？數字代表什麼意思？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"計算折溢價很簡單，公式是：(市價 - 淨值) ÷ 淨值。算出來是正數，就叫「溢價」，代表你買貴了；如果是負數，就叫「折價」，代表你買得比它的真實價值便宜。舉例來說，一檔 ETF 淨值是 50 元，但市場上大家搶著買，最後成交在 50.5 元。它的溢價率就是 (50.5 - 50) / 50 = 1%。這表示你用比它真實價值貴 1% 的價格買到了它。\"}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、看到「大幅溢價」，我該注意什麼？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"這是一個非常重要的警訊！當溢價過高，代表市場情緒可能太熱了，大家都在追捧，導致市價被推得遠高於它的真實價值。但請記得，價格最終會像地心引力一樣，向它的價值靠攏。現在過高的溢價，未來很可能就是你要承擔的下跌風險。一般來說，長期投資者應該避開溢價超過 1% 的標的。\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"情況\"}],[\"$\",\"th\",\"1\",{\"children\":\"風險等級\"}],\"$L18\"]}]}],\"$L19\"]}]}],\"$L1a\"]]}],\"$L1b\",\"$L1c\",\"$L1d\",\"$L1e\",\"$L1f\"],null]}]]}]}]\n18:[\"$\",\"th\",\"2\",{\"children\":\"投資人該做什麼？\"}]\n19:[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"溢價 > 3%\"}],[\"$\",\"td\",\"1\",{\"children\":\"極高\"}],[\"$\",\"td\",\"2\",{\"children\":\"市場情緒過熱，暫時觀望，避免追高。\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"溢價 1% - 3%\"}],[\"$\",\"td\",\"1\",{\"children\":\"偏高\"}],[\"$\",\"td\",\"2\",{\"children\":\"短線波動風險大，不適合長期投資者此時進場。\"}]]}],[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"溢價 0% - 1%\"}],[\"$\",\"td\",\"1\",{\"children\":\"正常\"}],[\"$\",\"td\",\"2\",{\"children\":\"合理範圍，市價與淨值貼近，可正常評估。\"}]]}],[\"$\",\"tr\",\"3\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"折價 (負數)\"}],[\"$\",\"td\",\"1\",{\"children\":\"需觀察\"}],[\"$\",\"td\",\"2\",{\"children\":\"可能是機會也可能是陷阱，需研究背後原因。\"}]]}]]}]\n1a:[\"$\",\"figure\",\"2\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"!把高溢價當成上漲訊號!以為大幅折價就是撿便宜!試圖放空高溢價 ETF\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"小心！折溢價的兩大陷阱\"}]]}]\n1b:[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、什麼時候容易出現誇張的折溢價？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"當市場出現特定情況時，ETF 的市價就容易脫離淨值，產生較大的折溢價。了解這些情境，可以幫助你避開風險，保持冷靜判斷。特別是當新聞上都在討論某一檔 ETF 時，通常就是該檢查折溢價的時候了。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"**新發行、熱門題材 ETF:** 市場一窩蜂追捧，需求遠大於供給，容易造成連續性的大幅溢價。\"}],[\"$\",\"li\",\"1\",{\"children\":\"**成分股漲跌停:** 當 ETF 內的多數股票漲停鎖死買不到，投資人會轉而買進 ETF，推升市價產生溢價。\"}],[\"$\",\"li\",\"2\",{\"children\":\"**市場極度恐慌或樂觀:** 大盤重挫時，投資人可能不計價拋售，造成折價；反之亦然。\"}],[\"$\",\"li\",\"3\",{\"children\":\"**流動性不佳的 ETF:** 成交量太小，一點點買賣盤就可能讓市價劇烈波動，產生較大的折溢價。\"}]]}]]]}]\n1c:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、我在哪裡可以查到最新的 ETF 折溢價資料？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"想查詢折溢價，最直接的方式是到各家投信的官網，或是在台灣證券交易所的「基本市況報導網站」查詢。許多券商的下單軟體也會提供即時的預估折溢價率。當然，在「股市大佬」的個股透視頁面，我們也直接幫你算好並視覺化呈現，讓你一眼就能判斷現在的價格是貴還是便宜，不用自己手動計算。\"}]]]}]\n1d:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"ETF 溢價太高，放空會賺錢嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"理論上溢價最終會收斂，但實務上風險極高。市場的狂熱可能持續很久，讓你被不斷拉高的市價強制回補，造成巨大虧損。不建議新手嘗試這種高風險操作。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"為什麼有些 ETF 長期都處於折價狀態？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"這通常發生在流動性較差或主題較冷門的 ETF。因為市場關注度低，買盤意願不強，導致市價長期低於淨值。這不一定代表它「很便宜」，更可能是市場對其未來不看好。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"折溢價多久會更新一次？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"市價是隨時變動的，但淨值通常是盤中每隔一段時間（例如 15 秒）或盤後才會更新一次。因此盤中看到的即時折溢價率是估算值，最準確的數字要以投信公司每日盤後公布的為準。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"買進後發現溢價很高，該怎麼辦？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"如果你是長期投資，短期的高溢價會侵蝕你的成本。你可以評估是否要減碼，等待溢價收斂後再買回。但若賣出，也要考慮交易成本。最好的方法還是在買進前就先確認折溢價是否在合理範圍。\"}]]}]]}]]]}]\n1e:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"買進 ETF 前，花 10 秒鐘檢查折溢價狀況。盡量選擇溢價率在 1% 以下的標的，就能幫你避開大部分因市場過熱而買貴的陷阱，讓你的長期投資有個更好的開始。\"}]]]}]\n1f:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L17\",\"0-想了解更多 ET\",{\"href\":\"/school\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"想了解更多 ETF 基礎知識？來台股學堂看看\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L17\",\"0-在「個股透視」頁\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"在「個股透視」頁面查詢最新的折溢價\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L17\",\"0-看看市場上哪些族\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"看看市場上哪些族群最近最熱門\"}]]}]]}]]]}]\n13:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\nf:null\n20:I[80622,[],\"IconMark\"]\n11:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"ETF折溢價是什麼？溢價太高可以空嗎？一篇看懂市價與淨值｜股市大佬 TradeBoss\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"看到想買的 ETF，一下單才發現成交價比網站上看到的「淨值」貴了一截？這中間的差價就是「折溢價」。這篇文章會教你怎麼看懂這個數字，避免買貴，甚至找到合理的進場時機。\"}],[\"$\",\"link\",\"2\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}],[\"$\",\"$L20\",\"3\",{}]],\"error\":null,\"digest\":\"$undefined\"}\n16:\"$11:metadata\"\n"}