content\":\"\"}]],[\"$\",\"$L14\",null,{\"children\":[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$15\",null,{\"fallback\":null,\"children\":\"$L16\"}]}]}]]}]\n17:I[52619,[\"2619\",\"static/chunks/2619-04bc32f026a0d946.js\",\"6309\",\"static/chunks/app/learn/%5Bslug%5D/page-f7b99344f7e2ee16.js\"],\"\"]\nd:[\"$\",\"div\",null,{\"className\":\"LearnArticle_wrap__LIQ8G\",\"children\":[\"$\",\"article\",null,{\"className\":\"LearnArticle_article__2nBbk\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_meta__etj_G\",\"children\":[[\"$\",\"$L17\",null,{\"className\":\"LearnArticle_cat__GQMlg\",\"href\":\"/learn?c=themes\",\"children\":\"題材專欄\"}],[\"$\",\"span\",null,{\"className\":\"LearnArticle_read__QEj6a\",\"children\":\"閱讀約 5 分鐘\"}]]}],[\"$\",\"h1\",null,{\"className\":\"LearnArticle_title__0_la8\",\"children\":\"落後補漲是什麼意思？3個誤讀先檢查\"}],[\"$\",\"details\",null,{\"className\":\"LearnArticle_toc__LcSAa\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"LearnArticle_tocSummary__YBddG\",\"children\":\"本文目錄\"}],[\"$\",\"ol\",null,{\"className\":\"LearnArticle_tocList__Rq_Lz\",\"children\":[[\"$\",\"li\",\"sec-1\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-1\",\"children\":\"一、它是標籤，不是行程\"}]}],[\"$\",\"li\",\"sec-2\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-2\",\"children\":\"二、三個誤讀：一定會補、補了能追上、沒動就便宜\"}]}],[\"$\",\"li\",\"sec-3\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-3\",\"children\":\"三、後見之明最喜歡補漲這兩個字\"}]}],[\"$\",\"li\",\"sec-4\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-4\",\"children\":\"四、比較穩的觀察順序\"}]}],[\"$\",\"li\",\"sec-5\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-5\",\"children\":\"五、日誌裡怎麼寫才不會事後補戲\"}]}],[\"$\",\"li\",\"sec-6\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-6\",\"children\":\"常見問題 FAQ\"}]}],[\"$\",\"li\",\"sec-7\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-7\",\"children\":\"總結\"}]}],[\"$\",\"li\",\"sec-8\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-8\",\"children\":\"延伸閱讀\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"LearnArticle_body__6B7Mb\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_intro__ATV5c\",\"children\":\"領頭漲一段之後，聊天室最容易出現的一句是：輪到落後的了。這句話聽起來公平，也很好寫進故事。問題是，落後補漲常常是走完才取的名字。當下你看到的，只是還沒動。還沒動可能會被找到，也可能永遠不會被找到。這篇把三個最常見的誤讀攤開，讓你少用公平感代替檢查。\"}],[[\"$\",\"figure\",\"figure-0\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"越後面越熱鬧，通常也越貴、越好離開佈局沒新聞命名故事出現擁擠人人都知退燒利多變鈍新聞出現時，常常已經不是第一段\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"示意圖｜題材四階段：佈局 → 命名 → 擁擠 → 退燒（教學結構，不是某檔實盤）\"}]]}]],[\"$\",\"div\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"落後補漲多半是事後命名，不是承諾\"}],[\"$\",\"li\",\"1\",{\"children\":\"沒動不等於便宜，也不等於下一步輪到它\"}],[\"$\",\"li\",\"2\",{\"children\":\"先檢查連結、流動性與領頭還在不在帶\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、它是標籤，不是行程\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"補漲這兩個字預設了一個公平世界：同類都該走到差不多的位置。市場沒有這個義務。資金會找好講、好交易、當下有對手的股票，不會為了榜單整齊而去把每一檔都抬過去。你把還沒動的叫做落後，已經在用結果的語言描述過程。比較老實的叫法是：它現在沒被交易這個故事。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"沒動只是現況，不是欠你一段\"}],[\"$\",\"li\",\"1\",{\"children\":\"公平感不能當分析\"}],[\"$\",\"li\",\"2\",{\"children\":\"先改口成還沒被交易\"}]]}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、三個誤讀：一定會補、補了能追上、沒動就便宜\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"第一個誤讀是一定會補。沒有誰規定同類都要走完同一段。第二個是補了就能追上領頭。彈性、流動性、本來的位置都不同，補一段仍可能遠遠落後。第三個是沒動就是比較便宜。沒動可能是連結弱、量太薄，或市場不承認它屬於這個題材。三個誤讀都來自同一句：它也算。\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"你常聽到的\"}],[\"$\",\"th\",\"1\",{\"children\":\"它跳過什麼\"}],[\"$\",\"th\",\"2\",{\"children\":\"先補的一問\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"落後的都會補\"}],[\"$\",\"td\",\"1\",{\"children\":\"沒人欠它一段\"}],[\"$\",\"td\",\"2\",{\"children\":\"它跟題材的連結講得清嗎\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"補了就能追上\"}],[\"$\",\"td\",\"1\",{\"children\":\"彈性與流動性不同\"}],[\"$\",\"td\",\"2\",{\"children\":\"追上的是價格還是只是故事\"}]]}],[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"沒動所以比較便宜\"}],[\"$\",\"td\",\"1\",{\"children\":\"沒動也可能沒人要\"}],[\"$\",\"td\",\"2\",{\"children\":\"它為什麼現在在這裡\"}]]}],[\"$\",\"tr\",\"3\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"輪動到邊緣了\"}],[\"$\",\"td\",\"1\",{\"children\":\"邊緣可能是擴散末段\"}],[\"$\",\"td\",\"2\",{\"children\":\"清單是不是愈拉愈長\"}]]}]]}]]}]}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、後見之明最喜歡補漲這兩個字\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"走完之後，真的補到的那幾檔會被反覆講；沒補到的會從故事裡消失。你的記憶會變成：當時就該找落後的。這是後見之明，不是方法。沒有事前寫下它為什麼該被交易、怎樣算沒被承認，你事後沒有資格說自己看懂補漲。能對帳的只有當時那一行，不是今天的公平感。\"}],\"$L18\",\"$L19\"]]}],\"$L1a\",\"$L1b\",\"$L1c\",\"$L1d\",\"$L1e\"],\"$L1f\"]}]]}]}]\n18:[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"事前寫它為什麼屬於這個故事\"}],[\"$\",\"li\",\"1\",{\"children\":\"寫怎樣算市場不承認\"}],[\"$\",\"li\",\"2\",{\"children\":\"沒寫就只能檢討流程，不能檢討眼光\"}]]}]\n19:[\"$\",\"figure\",\"2\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"✓為何屬於這故事✓怎樣算不承認✓最多多重\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"事前三句\"}]]}]\n1a:[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、比較穩的觀察順序\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"先看領頭還帶不帶得動同類。帶得動，資金至少還在這個名詞裡。再看沒動的那檔，連結是一層還是三層。最後看它平日有沒有量：薄的東西即使後來被叫成補漲，離開時也可能走得很醜。這個順序不保證你找得到會動的，但能擋住我覺得輪到它了這種句子。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"先看領頭還在不在帶\"}],[\"$\",\"li\",\"1\",{\"children\":\"再看連結幾層\"}],[\"$\",\"li\",\"2\",{\"children\":\"最後看平日流不流動\"}]]}]]]}]\n1b:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、日誌裡怎麼寫才不會事後補戲\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"不要寫我在等補漲。寫：我認為它屬於這個故事的理由、市場怎樣算不承認、我最多能多重。三句都有，後來它動了或沒動，你都有作業可改。只有等補漲三個字，結果一出，作業會被改寫成我早就知道。\"}]]]}]\n1c:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"同類都沒動，是不是就快輪到？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"不一定。也可能故事根本綁不住它們。先問連結與領頭還在不在帶。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"補漲一段算不算證明看法對？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"只證明它後來被交易了。沒有事前理由與失效，仍不能把結果當成你當時看懂。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"流動性差的落後股為什麼常被點名？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"因為彈性大、故事好講。彈性大表示往上往下都可以很快，不是優惠。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"和題材擴散階段有什麼關係？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"擴散段本來就會翻找邊緣名字。清單變長時，補漲兩個字會特別響，也特別要檢查。\"}]]}]]}]]]}]\n1d:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"落後補漲是事後標籤，不是行程表。沒動不等於便宜，也不等於下一步輪到它。先檢查連結、領頭與流動性。\"}]]]}]\n1e:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L17\",\"0-題材股生命週期\",{\"href\":\"/learn/theme-stock-lifecycle\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"題材股生命週期\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L17\",\"0-後見之明偏差\",{\"href\":\"/learn/hindsight-bias-in-trading\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"後見之明偏差\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L17\",\"0-題材輪動怎麼看\",{\"href\":\"/learn/what-theme-rotation-is-actually-doing\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"題材輪動怎麼看\"}]]}]]}]]]}]\n1f:[\"$\",\"div\",null,{\"className\":\"LearnArticle_related__9qV55\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_relatedTitle__RXfrl\",\"children\":\"相關文章\"}],[[\"$\",\"$L17\",\"theme-stock-lifecycle\",{\"href\":\"/learn/theme-stock-lifecycle\",\"className\":\"LearnArticle_relatedLink__mibXe\",\"children\":\"題材股生命週期\"}],[\"$\",\"$L17\",\"hindsight-bias-in-trading\",{\"href\":\"/learn/hindsight-bias-in-trading\",\"className\":\"LearnArticle_relatedLink__mibXe\",\"children\":\"後見之明偏差\"}],[\"$\",\"$L17\",\"what-theme-rotation-is-actually-doing\",{\"href\":\"/learn/what-theme-rotation-is-actually-doing\",\"className\":\"LearnArticle_relatedLink__mibXe\",\"children\":\"題材輪動怎麼看\"}]]]}]\n13:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\nf:null\n20:I[80622,[],\"IconMark\"]\n11:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"落後補漲是什麼意思？3個誤讀先檢查｜股市大佬 TradeBoss\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"領頭漲一段之後，聊天室最容易出現的一句是：輪到落後的了。這句話聽起來公平，也很好寫進故事。問題是，落後補漲常常是走完才取的名字。當下你看到的，只是還沒動。還沒動可能會被找到，也可能永遠不會被找到。這篇把三個最常見的誤讀攤開，讓你少用公平感代替檢查。\"}],[\"$\",\"link\",\"2\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}],[\"$\",\"$L20\",\"3\",{}]],\"error\":null,\"digest\":\"$undefined\"}\n16:\"$11:metadata\"\n"}