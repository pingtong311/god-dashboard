"className\":\"LearnArticle_article__2nBbk\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_meta__etj_G\",\"children\":[[\"$\",\"$L17\",null,{\"className\":\"LearnArticle_cat__GQMlg\",\"href\":\"/learn?c=mindset\",\"children\":\"心態與風控\"}],[\"$\",\"span\",null,{\"className\":\"LearnArticle_read__QEj6a\",\"children\":\"閱讀約 6 分鐘\"}]]}],[\"$\",\"h1\",null,{\"className\":\"LearnArticle_title__0_la8\",\"children\":\"為什麼一停損就出行情？三個沒人針對你的原因\"}],[\"$\",\"details\",null,{\"className\":\"LearnArticle_toc__LcSAa\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"LearnArticle_tocSummary__YBddG\",\"children\":\"本文目錄\"}],[\"$\",\"ol\",null,{\"className\":\"LearnArticle_tocList__Rq_Lz\",\"children\":[[\"$\",\"li\",\"sec-1\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-1\",\"children\":\"一、你的停損點和所有人的停損點在同一個地方\"}]}],[\"$\",\"li\",\"sec-2\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-2\",\"children\":\"二、你記得的樣本是被篩選過的\"}]}],[\"$\",\"li\",\"sec-3\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-3\",\"children\":\"三、停損太近，本質上是拿波動當風險\"}]}],[\"$\",\"li\",\"sec-4\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-4\",\"children\":\"四、把停損放在波動之外，需要付出的代價\"}]}],[\"$\",\"li\",\"sec-5\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-5\",\"children\":\"五、可以怎麼改善\"}]}],[\"$\",\"li\",\"sec-6\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-6\",\"children\":\"六、最貴的那個選項\"}]}],[\"$\",\"li\",\"sec-7\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-7\",\"children\":\"常見問題 FAQ\"}]}],[\"$\",\"li\",\"sec-8\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-8\",\"children\":\"總結\"}]}],[\"$\",\"li\",\"sec-9\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-9\",\"children\":\"延伸閱讀\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"LearnArticle_body__6B7Mb\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_intro__ATV5c\",\"children\":\"停損出場，然後看著它反彈；忍住不停損，結果一路破底。幾乎每個交易的人都經歷過，也幾乎每個人都懷疑過是不是被盯上了。實際原因遠比陰謀單純，而且知道原因之後，是可以調整的。\"}],[],[\"$\",\"div\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"停損後出行情通常是三件事疊起來：停損位置和大家重合、記憶偏向印象深刻的樣本、停損距離小於日常波動\"}],[\"$\",\"li\",\"1\",{\"children\":\"改法是先定失效位置再回推張數，並把每次結果記下來\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、你的停損點和所有人的停損點在同一個地方\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"多數人設停損的方式高度相似：前一波低點下面一點、整數關卡下面一點、某條常用均線下面一點。這代表大量停損委託會堆積在同一個狹窄區域。對需要成交量才能完成部位調整的參與者來說，那個區域是流動性最好的地方。價格往那裡走、觸發一批停損、成交量瞬間放大，然後價格回來——這個過程不需要任何人針對你，它只是市場往流動性密集的地方移動。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"多數人的停損邏輯相似，位置因此集中\"}],[\"$\",\"li\",\"1\",{\"children\":\"集中處等於流動性密集區\"}],[\"$\",\"li\",\"2\",{\"children\":\"價格往流動性走，是結構而不是針對\"}]]}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、你記得的樣本是被篩選過的\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"停損之後反彈，情緒很強烈，記憶很深刻。停損之後繼續下跌，你會覺得「還好有停」，然後很快忘掉。結果就是你腦中的樣本嚴重偏向前者。這叫做選擇性記憶，是所有交易者共同的認知偏差。真正要判斷「我的停損是不是太緊」，唯一辦法是把每一次都記下來，然後數。\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"情況\"}],[\"$\",\"th\",\"1\",{\"children\":\"當下情緒\"}],[\"$\",\"th\",\"2\",{\"children\":\"記得多久\"}],[\"$\",\"th\",\"3\",{\"children\":\"實際發生頻率\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"停損後反彈\"}],[\"$\",\"td\",\"1\",{\"children\":\"很強烈，覺得被騙\"}],[\"$\",\"td\",\"2\",{\"children\":\"很久\"}],[\"$\",\"td\",\"3\",{\"children\":\"需要記錄才知道\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"停損後續跌\"}],[\"$\",\"td\",\"1\",{\"children\":\"鬆一口氣\"}],[\"$\",\"td\",\"2\",{\"children\":\"很快忘掉\"}],[\"$\",\"td\",\"3\",{\"children\":\"通常比想像的多\"}]]}],[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"沒停損而虧更多\"}],[\"$\",\"td\",\"1\",{\"children\":\"痛，但傾向合理化\"}],[\"$\",\"td\",\"2\",{\"children\":\"選擇性遺忘\"}],[\"$\",\"td\",\"3\",{\"children\":\"最容易被低估\"}]]}]]}]]}]}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、停損太近，本質上是拿波動當風險\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"如果停損距離小於這檔股票的日常波動幅度，那你被觸發幾乎是必然的，跟看法對不對無關。這是最常見的技術性錯誤：把停損設在自己能承受的金額上，而不是設在「看法失效」的位置上。正確順序是先決定失效位置，再依這個距離回推能買多少張，而不是先決定張數再硬塞一個停損。\"}],[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"先問：跌到哪裡代表我這個看法錯了\"}],[\"$\",\"li\",\"1\",{\"children\":\"量出那個距離佔目前價格的百分比\"}],[\"$\",\"li\",\"2\",{\"children\":\"用可承受的虧損金額除以這個距離，算出張數\"}],\"$L18\"]}]]]}],\"$L19\",\"$L1a\",\"$L1b\",\"$L1c\",\"$L1d\",\"$L1e\"],null]}]]}]}]\n18:[\"$\",\"li\",\"3\",{\"children\":\"如果算出來的張數太小，就是這筆不該做這麼大\"}]\n19:[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、把停損放在波動之外，需要付出的代價\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"停損放遠一點，被雜訊掃到的機率下降，但每次錯的成本上升。這是一個沒有免費午餐的交換：想被掃出場的次數少，就得接受單次虧損金額大；想單次虧損小，就得接受被掃出場的次數多。沒有哪一邊絕對正確，重點是你選了哪一邊，並且讓部位大小跟這個選擇一致。\"}],[\"$\",\"figure\",\"1\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"!位置與眾人重合!記憶選擇性偏差!距離小於日常波動!臨場改主意\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"三個真正的原因\"}]]}]]]}]\n1a:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、可以怎麼改善\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"第一，停損位置盡量不要跟明顯的整數或前低完全重合，留一點距離。第二，用事前設定的觸價委託執行，不要靠盤中臨時判斷，理由在下一段。第三，把每次停損的結果記下來，一個月後你會有自己的統計，而不是靠印象爭論。第四，接受一件事：停損的目的不是避免虧損，而是讓單次虧損不會影響你繼續交易的能力。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"避開跟其他人完全重合的位置\"}],[\"$\",\"li\",\"1\",{\"children\":\"用事前設定的委託執行，不靠臨場判斷\"}],[\"$\",\"li\",\"2\",{\"children\":\"把每次結果記錄下來，用數字取代印象\"}],[\"$\",\"li\",\"3\",{\"children\":\"接受停損是為了活著，不是為了不虧\"}]]}]]]}]\n1b:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"六、最貴的那個選項\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"在所有處理方式裡，最貴的是「這次先不停，看看會不會回來」。這個選擇偶爾會成功，而成功的那幾次會強化這個習慣，直到遇上一次不回來的行情。長期來看，破壞帳戶的通常不是很多次小停損，而是少數幾次沒停的大虧。\"}]]]}]\n1c:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"是不是有人專門掃散戶的停損？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"不需要有人專門針對你。因為多數人的停損位置高度重合，那個區域自然成為流動性最好的地方，價格往那裡移動是結構性的結果。理解成結構問題比理解成陰謀，更能幫你調整做法。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"停損應該設多少百分比？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"沒有通用數字。合理的順序是先決定「跌到哪裡代表我看錯」，量出那個距離，再用可承受的虧損金額回推張數。用固定百分比套所有股票，會在波動大的標的上被必然掃出場。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"停損之後可以馬上再進場嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"可以，但前提是有新的、事前定義好的進場條件，而不是因為看到反彈而不甘心。後者通常會演變成連續追價，單日虧損因此放大。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"怎麼知道我的停損是太緊還是剛好？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"記錄至少二三十次的結果，統計「停損後三天內回到進場價之上」的比例。如果這個比例很高，代表停損距離小於日常波動；如果很低，代表停損是有效的。用數字判斷，不要靠印象。\"}]]}]]}]]]}]\n1d:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"停損後出行情通常是三件事疊起來：停損位置和大家重合、記憶偏向印象深刻的樣本、停損距離小於日常波動。改法是先定失效位置再回推張數，並把每次結果記下來。\"}]]]}]\n1e:[\"$\",\"section\",\"sec-9\",{\"id\":\"sec-9\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L17\",\"0-交易觀念與名詞：\",{\"href\":\"/school\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"交易觀念與名詞：台股學堂\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L17\",\"0-更多台股教學文\",{\"href\":\"/learn\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"更多台股教學文\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L17\",\"0-用歷史行情練手感\",{\"href\":\"/sim\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"用歷史行情練手感：練功房\"}]]}]]}]]]}]\n13:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\nf:null\n1f:I[80622,[],\"IconMark\"]\n11:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"為什麼一停損就出行情？三個沒人針對你的原因｜股市大佬 TradeBoss\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"停損出場，然後看著它反彈；忍住不停損，結果一路破底。幾乎每個交易的人都經歷過，也幾乎每個人都懷疑過是不是被盯上了。實際原因遠比陰謀單純，而且知道原因之後，是可以調整的。\"}],[\"$\",\"link\",\"2\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}],[\"$\",\"$L1f\",\"3\",{}]],\"error\":null,\"digest\":\"$undefined\"}\n16:\"$11:metadata\"\n"}