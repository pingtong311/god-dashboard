null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、極端日三個提醒\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"第一，相關性會在壞日子裡上升，你以為分開的賭注會變成同一個。第二，流動性會先消失，離開比模型慢。第三，組織或個人都會在壓力下改規則，除非規則事先鎖住。\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"晴天看起來\"}],[\"$\",\"th\",\"1\",{\"children\":\"極端日常見\"}],[\"$\",\"th\",\"2\",{\"children\":\"原則該先寫\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"分散很穩\"}],[\"$\",\"td\",\"1\",{\"children\":\"一起被賣\"}],[\"$\",\"td\",\"2\",{\"children\":\"最壞加總是多少\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"模型很準\"}],[\"$\",\"td\",\"1\",{\"children\":\"模型輸入斷掉\"}],[\"$\",\"td\",\"2\",{\"children\":\"沒行情時怎麼辦\"}]]}],[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"我很理性\"}],[\"$\",\"td\",\"1\",{\"children\":\"記憶會改寫\"}],[\"$\",\"td\",\"2\",{\"children\":\"當天就要記\"}]]}],[\"$\",\"tr\",\"3\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"還有時間\"}],[\"$\",\"td\",\"1\",{\"children\":\"流動性先走\"}],[\"$\",\"td\",\"2\",{\"children\":\"誰能叫我減\"}]]}]]}]]}]}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、痛苦要當資料\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"公開框架把痛苦當成學習訊號。交易版是：痛的那筆要在當天寫下理由與違規，不能等記憶變順。後見之明那篇是同一把刀。\"}],[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"痛的當天寫\"}],[\"$\",\"li\",\"1\",{\"children\":\"只寫事實與違規\"}],[\"$\",\"li\",\"2\",{\"children\":\"隔週再解釋\"}]]}],[\"$\",\"figure\",\"2\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"✓加總上限✓減碼觸發✓當天記錄\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"晴天先寫\"}]]}]]]}],[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、不要把經濟機器當預測儀\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"他的公開比喻把經濟講成機器。機器圖好懂，也被人拿來預測下一季。本篇不走預測。機器圖最多幫你分類：這是債務、現金流，還是信心問題。分類錯了，原則會用錯格子。\"}],\"$L18\"]]}],\"$L19\",\"$L1a\",\"$L1b\",\"$L1c\"],\"$L1d\"]}]]}]}]\n18:[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"比喻用來分類\"}],[\"$\",\"li\",\"1\",{\"children\":\"分類不是時間表\"}],[\"$\",\"li\",\"2\",{\"children\":\"預測留給別人\"}]]}]\n19:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、最小動作\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"寫三條只在壞日子用的句子：加總曝險上限、減碼觸發、當天記錄的截止時間。晴天覺得多餘，雨天才知道多餘的是沒寫。\"}]]]}]\n1a:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"是不是要學他的全天候想法？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"那是機構框架。散戶能學的是「壞日子加總」與「原則事前寫」。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"分散是不是沒用？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"日常有用，極端日會打折。要先假設打折，不是先假設永遠有用。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"原則會不會變成教條？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"公開框架包含修正。有版本的原則才不是教條。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"和二〇〇八年那篇重複嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"那篇講事件結構；這篇講人物框架怎麼對到壞日子。\"}]]}]]}]]]}]\n1b:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"達利歐能用的是事前寫下的原則，不是金句。極端日：分散可能一起失效、流動性先走、痛苦要當天記錄。\"}]]]}]\n1c:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L17\",\"0-2008 金融海\",{\"href\":\"/learn/2008-financial-crisis-why-diversification-failed-together\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"2008 金融海嘯\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L17\",\"0-後見之明\",{\"href\":\"/learn/hindsight-bias-in-trading\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"後見之明\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L17\",\"0-最大回撤\",{\"href\":\"/learn/what-max-drawdown-really-means\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"最大回撤\"}]]}]]}]]]}]\n1d:[\"$\",\"div\",null,{\"className\":\"LearnArticle_related__9qV55\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_relatedTitle__RXfrl\",\"children\":\"相關文章\"}],[[\"$\",\"$L17\",\"2008-financial-crisis-why-diversification-failed-together\",{\"href\":\"/learn/2008-financial-crisis-why-diversificat