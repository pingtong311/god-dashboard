\"$Le\",null,{\"children\":[\"$Lf\",[\"$\",\"$L10\",null,{\"promise\":\"$@11\"}]]}]]}]\nb:[\"$\",\"$1\",\"h\",{\"children\":[null,[[\"$\",\"$L12\",null,{\"children\":\"$L13\"}],[\"$\",\"meta\",null,{\"name\":\"next-size-adjust\",\"content\":\"\"}]],[\"$\",\"$L14\",null,{\"children\":[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$15\",null,{\"fallback\":null,\"children\":\"$L16\"}]}]}]]}]\n17:I[52619,[\"2619\",\"static/chunks/2619-04bc32f026a0d946.js\",\"6309\",\"static/chunks/app/learn/%5Bslug%5D/page-f7b99344f7e2ee16.js\"],\"\"]\nd:[\"$\",\"div\",null,{\"className\":\"LearnArticle_wrap__LIQ8G\",\"children\":[\"$\",\"article\",null,{\"className\":\"LearnArticle_article__2nBbk\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_meta__etj_G\",\"children\":[[\"$\",\"$L17\",null,{\"className\":\"LearnArticle_cat__GQMlg\",\"href\":\"/learn?c=orderbook\",\"children\":\"盤口掛單\"}],[\"$\",\"span\",null,{\"className\":\"LearnArticle_read__QEj6a\",\"children\":\"閱讀約 5 分鐘\"}]]}],[\"$\",\"h1\",null,{\"className\":\"LearnArticle_title__0_la8\",\"children\":\"掛單突然撤掉代表什麼？靠近就消失的3個教訓\"}],[\"$\",\"details\",null,{\"className\":\"LearnArticle_toc__LcSAa\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"LearnArticle_tocSummary__YBddG\",\"children\":\"本文目錄\"}],[\"$\",\"ol\",null,{\"className\":\"LearnArticle_tocList__Rq_Lz\",\"children\":[[\"$\",\"li\",\"sec-1\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-1\",\"children\":\"一、撤單是制度允許的，不是例外\"}]}],[\"$\",\"li\",\"sec-2\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-2\",\"children\":\"二、靠近就消失為什麼特別容易被記住\"}]}],[\"$\",\"li\",\"sec-3\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-3\",\"children\":\"三、三種常見原因，動機差很多\"}]}],[\"$\",\"li\",\"sec-4\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-4\",\"children\":\"四、和試撮假單是同一類資訊問題\"}]}],[\"$\",\"li\",\"sec-5\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-5\",\"children\":\"五、三個教訓，比抓出誰在撤有用\"}]}],[\"$\",\"li\",\"sec-6\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-6\",\"children\":\"常見問題 FAQ\"}]}],[\"$\",\"li\",\"sec-7\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-7\",\"children\":\"總結\"}]}],[\"$\",\"li\",\"sec-8\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-8\",\"children\":\"延伸閱讀\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"LearnArticle_body__6B7Mb\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_intro__ATV5c\",\"children\":\"你盯著下面那一疊買單，覺得有人在等。價格走過去，疊消失了。被耍的感覺很具體。比較少被問的是：掛單本來就可以撤，靠近才撤只是把這件事變得比較刺眼。刺眼不等於有人針對你。有人確實把單掛給市場看；也有人只是限價被市場追上，改掛別的價。公開盤口分不太開。能帶走的是教訓，不是抓出誰在演戲。\"}],[[\"$\",\"figure\",\"figure-0\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"中間缺口是價差；張數是意願，不是承諾151.542 張151.088 張150.5120 張150.095 張149.5160 張149.070 張賣方五檔買方五檔大單靠近就消失，多半沒打算成交\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"示意圖｜五檔掛單：上面是想賣的，下面是想買的，都能隨時撤（教學結構，不是某檔實盤）\"}]]}]],[\"$\",\"div\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"掛單在成交前都可以撤，靠近才撤只是比較刺眼\"}],[\"$\",\"li\",\"1\",{\"children\":\"同一種消失，至少有改價、風控、展示三種常見解釋\"}],[\"$\",\"li\",\"2\",{\"children\":\"教訓是：沒成交的厚單，不能當成已經存在的承接\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、撤單是制度允許的，不是例外\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"限價單的本質是「我願意在這個價等」。市場一變，意願就可能變。撤掉、改價、縮小張數，都是同一件事的不同動作。若沒有撤單，錯誤委託與過時意願會永遠堵在簿上，盤口會更假。所以「突然撤掉」首先是正常功能，其次才輪得到你去猜動機。先接受它是功能，眼睛才不會把每一次消失都升級成事件。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"成交前都可以改或撤\"}],[\"$\",\"li\",\"1\",{\"children\":\"撤單本身不自動等於欺騙\"}],[\"$\",\"li\",\"2\",{\"children\":\"刺眼的是時機，不是功能\"}]]}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、靠近就消失為什麼特別容易被記住\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"離現價很遠的單撤掉，你通常看不見，也沒感覺。價格走到它面前才撤，你的注意力正好在那裡，所以記得特別牢。記憶會再補一句：他從頭到尾就不想成交。這句有時對，有時只是對方的限價被追上、或排隊位置變差所以重掛。你記住的是戲劇，漏掉的是更無聊、也更常見的原因。\"}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、三種常見原因，動機差很多\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"第一，展示：掛給別人看，靠近就收。第二，改價：還是想成交，只是不想在舊的價成交。第三，風控或錯誤：單下錯、波動變大、或條件單被觸發取消。三種在你畫面上都可以是「厚單不見了」。只有第一種接近大家討厭的假掛；後兩種天天都在發生。你沒有對方的下單紀錄，分不開就不要用最壞的那種解釋去填。\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"你看到的\"}],[\"$\",\"th\",\"1\",{\"children\":\"容易讀成\"}],[\"$\",\"th\",\"2\",{\"children\":\"也同樣可能是\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"價格靠近，厚單撤光\"}],[\"$\",\"td\",\"1\",{\"children\":\"假掛給人看\"}],[\"$\",\"td\",\"2\",{\"children\":\"限價被追上，改掛別的價\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"撤了又掛回原價\"}],[\"$\",\"td\",\"1\",{\"children\":\"反覆演戲\"}],[\"$\",\"td\",\"2\",{\"children\":\"程式在維持某個價的排隊\"}]]}],\"$L18\",\"$L19\"]}]]}]}],\"$L1a\"]]}],\"$L1b\",\"$L1c\",\"$L1d\",\"$L1e\",\"$L1f\"],\"$L20\"]}]]}]}]\n18:[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"只縮小張數\"}],[\"$\",\"td\",\"1\",{\"children\":\"開始心虛\"}],[\"$\",\"td\",\"2\",{\"children\":\"部位或額度到了上限\"}]]}]\n19:[\"$\",\"tr\",\"3\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"開盤前大單消失\"}],[\"$\",\"td\",\"1\",{\"children\":\"有人在嚇盤\"}],[\"$\",\"td\",\"2\",{\"children\":\"試撮階段撤單本來就沒成本\"}]]}]\n1a:[\"$\",\"figure\",\"2\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"!展示後收走!改價重掛!風控或錯單\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"三種消失\"}]]}]\n1b:[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、和試撮假單是同一類資訊問題\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"開盤前的試撮更極端：掛與撤都還沒有成交代價，數字可以飛。開盤後有了成交，代價出現了，但掛著還沒成交的那一層，代價仍然很低。所以「靠近就消失」不是新物種，是同一種短命資訊在盤中的版本。你若已經理解試撮為什麼不可信，盤中厚單也該用同一套客氣：沒成交，就還不算數。\"}],[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"沒成交的數字，壽命都很短\"}],[\"$\",\"li\",\"1\",{\"children\":\"試撮是零成本版\"}],[\"$\",\"li\",\"2\",{\"children\":\"盤中掛單是低成本版，不是保證版\"}]]}]]]}]\n1c:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、三個教訓，比抓出誰在撤有用\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"第一，厚單不是承接，成交才是。第二，消失本身資訊量很低，因為原因太多。第三，真正有一點用的是重複出現的行為：同一個價、很多次靠近就沒，再配上後來也幾乎沒在那個價成交——這比較像「那個價的揭示不可靠」，仍然不是方向。教訓是降低對揭示的信任，不是多一個可以跟的訊號。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"厚單要成交才算數\"}],[\"$\",\"li\",\"1\",{\"children\":\"單次消失不要寫劇本\"}],[\"$\",\"li\",\"2\",{\"children\":\"重複靠近就沒，只說明揭示不可靠\"}]]}]]]}]\n1d:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"靠近就撤是不是一定在騙人？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"不一定。改價、風控、錯單、程式重掛都很常見。一定騙人，是最省事也最容易錯的解釋。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"撤了又掛回來呢？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"可能是維持排隊，也可能是反覆展示。公開畫面分不開。先當成「這個價的揭示很吵」，不要當成方向。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"要不要看撤單率？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"一般看盤軟體不見得提供穩定的撤單率。沒有穩定口徑，就不要自己用眼睛估一個百分比再信它。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"開盤前和大盤中的撤單能一起看嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"機制類似、成本不同。開盤前更不可信。盤中也只是比較不可信，不是突然變誠實。\"}]]}]]}]]]}]\n1e:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"掛單可撤是功能。靠近才消失特別刺眼，原因卻很多。教訓是沒成交的厚單不算承接，不是多一個可以跟的訊號。\"}]]]}]\n1f:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L17\",\"0-試撮階段的假單\",{\"href\":\"/learn/pre-market-matching-fake-orders\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"試撮階段的假單\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L17\",\"0-五檔掛單四層讀法\",{\"href\":\"/learn/how-to-read-order-book-five-levels\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"五檔掛單四層讀法\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L17\",\"0-台股學堂\",{\"href\":\"/school\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"台股學堂\"}]]}]]}]]]}]\n20:[\"$\",\"div\",null,{\"className\":\"LearnArticle_related__9qV55\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_relatedTitle__RXfrl\",\"children\":\"相關文章\"}],[[\"$\",\"$L17\",\"pre-market-matching-fake-orders\",{\"href\":\"/learn/pre-market-matching-fake-orders\",\"className\":\"LearnArticle_relatedLink__mibXe\",\"children\":\"試撮階段的假單\"}],[\"$\",\"$L17\",\"how-to-read-order-book-five-levels\",{\"href\":\"/learn/how-to-read-order-book-five-levels\",\"className\":\"LearnArticle_relatedLink__mibXe\",\"children\":\"五檔掛單四層讀法\"}]]]}]\n13:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\nf:null\n21:I[80622,[],\"IconMark\"]\n11:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"掛單突然撤掉代表什麼？靠近就消失的3個教訓｜股市大佬 TradeBoss\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"你盯著下面那一疊買單，覺得有人在等。價格走過去，疊消失了。被耍的感覺很具體。比較少被問的是：掛單本來就可以撤，靠近才撤只是把這件事變得比較刺眼。刺眼不等於有人針對你。有人確實把單掛給市場看；也有人只是限價被市場追上，改掛別的價。公開盤口分不太開。能帶走的是教訓，不是抓出誰在演戲。\"}],[\"$\",\"link\",\"2\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}],[\"$\",\"$L21\",\"3\",{}]],\"error\":null,\"digest\":\"$undefined\"}\n16:\"$11:metadata\"\n"}