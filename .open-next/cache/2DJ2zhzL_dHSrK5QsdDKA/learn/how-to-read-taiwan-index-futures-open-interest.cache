-futures-open-interest\",\"d\"],\"$La\",{\"children\":[\"__PAGE__\",\"$Lb\",{},null,false]},null,false]},null,false]},null,false],\"$Lc\",false]],\"m\":\"$undefined\",\"G\":[\"$d\",[]],\"s\":false,\"S\":true}\nf:I[24431,[],\"OutletBoundary\"]\n11:I[15278,[],\"AsyncMetadataOutlet\"]\n13:I[24431,[],\"ViewportBoundary\"]\n15:I[24431,[],\"MetadataBoundary\"]\n16:\"$Sreact.suspense\"\n9:[\"$\",\"$L5\",null,{}]\na:[\"$\",\"$1\",\"c\",{\"children\":[null,[\"$\",\"$L4\",null,{\"parallelRouterKey\":\"children\",\"error\":\"$undefined\",\"errorStyles\":\"$undefined\",\"errorScripts\":\"$undefined\",\"template\":[\"$\",\"$L5\",null,{}],\"templateStyles\":\"$undefined\",\"templateScripts\":\"$undefined\",\"notFound\":\"$undefined\",\"forbidden\":\"$undefined\",\"unauthorized\":\"$undefined\"}]]}]\nb:[\"$\",\"$1\",\"c\",{\"children\":[\"$Le\",[[\"$\",\"link\",\"0\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/css/3eaf36e367672966.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"$undefined\"}]],[\"$\",\"$Lf\",null,{\"children\":[\"$L10\",[\"$\",\"$L11\",null,{\"promise\":\"$@12\"}]]}]]}]\nc:[\"$\",\"$1\",\"h\",{\"children\":[null,[[\"$\",\"$L13\",null,{\"children\":\"$L14\"}],[\"$\",\"meta\",null,{\"name\":\"next-size-adjust\",\"content\":\"\"}]],[\"$\",\"$L15\",null,{\"children\":[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$16\",null,{\"fallback\":null,\"children\":\"$L17\"}]}]}]]}]\n18:I[52619,[\"2619\",\"static/chunks/2619-04bc32f026a0d946.js\",\"6309\",\"static/chunks/app/learn/%5Bslug%5D/page-f7b99344f7e2ee16.js\"],\"\"]\ne:[\"$\",\"div\",null,{\"className\":\"LearnArticle_wrap__LIQ8G\",\"children\":[\"$\",\"article\",null,{\"className\":\"LearnArticle_article__2nBbk\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_meta__etj_G\",\"children\":[[\"$\",\"$L18\",null,{\"className\":\"LearnArticle_cat__GQMlg\",\"href\":\"/learn?c=chips\",\"children\":\"籌碼面\"}],[\"$\",\"span\",null,{\"className\":\"LearnArticle_read__QEj6a\",\"children\":\"閱讀約 8 分鐘\"}]]}],[\"$\",\"h1\",null,{\"className\":\"LearnArticle_title__0_la8\",\"children\":\"台指期未平倉量怎麼看？3指標看懂大戶散戶動向，預判大盤多空\"}],[\"$\",\"details\",null,{\"className\":\"LearnArticle_toc__LcSAa\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"LearnArticle_tocSummary__YBddG\",\"children\":\"本文目錄\"}],[\"$\",\"ol\",null,{\"className\":\"LearnArticle_tocList__Rq_Lz\",\"children\":[[\"$\",\"li\",\"sec-1\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-1\",\"children\":\"一、什麼是「未平倉量」？為什麼它比成交量更重要？\"}]}],[\"$\",\"li\",\"sec-2\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-2\",\"children\":\"二、最關鍵的指標：三大法人未平倉量怎麼解讀？\"}]}],[\"$\",\"li\",\"sec-3\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-3\",\"children\":\"三、進階指標：看懂「十大特定法人」的秘密\"}]}],[\"$\",\"li\",\"sec-4\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-4\",\"children\":\"四、散戶的逆襲？「小台散戶多空比」為什麼要反著看？\"}]}],[\"$\",\"li\",\"sec-5\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-5\",\"children\":\"五、如何整合所有資訊，做出自己的判斷？\"}]}],[\"$\",\"li\",\"sec-6\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-6\",\"children\":\"常見問題 FAQ\"}]}],[\"$\",\"li\",\"sec-7\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-7\",\"children\":\"總結\"}]}],[\"$\",\"li\",\"sec-8\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-8\",\"children\":\"延伸閱讀\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"LearnArticle_body__6B7Mb\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_intro__ATV5c\",\"children\":\"每天看新聞都說「外資台指期未平倉淨多單增加」，但這個數字到底代表什麼？為什麼它能影響大盤走勢？這篇文章會帶你從零看懂未平倉數據，學會判斷市場上「真正的大玩家」是做多還是做空。\"}],[[\"$\",\"figure\",\"figure-0\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"高集中度只說明買超很集中，不說明是誰、要幹嘛前 15 大其餘成交例：集中度 40%＝這批分點淨買超約當天成交的四成不能從集中度推出明天方向\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"示意圖｜分點集中度：前幾大買超合計，佔當天成交的比例（教學結構，不是某檔實盤）\"}]]}]],[\"$\",\"div\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"未平倉量是「還沒結算的期貨合約」，代表市場上還存在的買賣雙方力道。\"}],[\"$\",\"li\",\"1\",{\"children\":\"觀察「三大法人」未平倉淨額，可判斷市場主力的中長期方向。\"}],[\"$\",\"li\",\"2\",{\"children\":\"「十大特定法人」多空淨額更能反映最頂尖交易者的看法，常被視為領先指標。\"}],[\"$\",\"li\",\"3\",{\"children\":\"散戶指標（小台散戶多空比）常與大盤走勢相反，是重要的反向觀察訊號。\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、什麼是「未平倉量」？為什麼它比成交量更重要？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"很多人會把「未平倉量」跟「成交量」搞混。成交量是一天內買賣的總數量，像商店一天的來客數；而未平倉量（Open Interest, OI）是市場上還「留倉」、沒有被沖銷掉的合約總數，代表市場上還存在的「多空對峙」力道。它更能反映市場參與者對未來行情的真實看法，因為這些部位是他們願意承擔隔夜風險的賭注。\"}],[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"成交量 (Volume): 當天買賣撮合的總口數，代表市場的「熱絡度」。\"}],[\"$\",\"li\",\"1\",{\"children\":\"未平倉量 (Open Interest): 到收盤時還沒平倉的合約總口數，代表市場的「多空未決力道」。\"}],[\"$\",\"li\",\"2\",{\"children\":\"判斷方法: 未平倉量持續增加，代表有新的資金進場，行情可能延續；若量縮，則代表多空雙方都在退場觀望。\"}]]}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、最關鍵的指標：三大法人未平倉量怎麼解讀？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"三大法人（外資、投信、自營商）是台股市場的主要力量，他們在期貨市場的佈局，往往預示著對未來大盤的看法。期交所每天下午會公布他們的未平倉淨額，也就是「多單口數」減去「空單口數」。這個數字是正是負，以及變化的幅度，就是我們判斷市場風向的關鍵。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"外資：部位最大，影響力最高，通常代表中長線趨勢。淨多單持續增加，對大盤偏多看待。\"}],[\"$\",\"li\",\"1\",{\"children\":\"投信：主要做避險，因此期貨部位常是淨空單，用來對沖現貨下跌風險，參考價值較特殊。\"}],[\"$\",\"li\",\"2\",{\"children\":\"自營商：操作較短線，多空方向變化快，需注意其避險與自行買賣部位的差異。\"}],[\"$\",\"li\",\"3\",{\"children\":\"判斷門檻：當外資未平倉淨多單連續數日站穩在 1 萬口以上，通常代表對後市樂觀；若由正轉負或快速減少，則要提高警覺。\"}]]}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、進階指標：看懂「十大特定法人」的秘密\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"除了三大法人，期交所還會公布「前五大」與「前十大」交易人的未平倉部位。這裡面藏著市場上最頂尖、資金最雄厚的玩家。特別是「十大特定法人」，他們是扣除自營商後，交易量最大的十家法人機構。他們的部位比單純看三大法人更集中，更能反映「聰明錢」的動向。\"}],\"$L19\",\"$L1a\"]]}],\"$L1b\",\"$L1c\",\"$L1d\",\"$L1e\",\"$L1f\"],null]}]]}]}]\n19:[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"指標名稱\"}],[\"$\",\"th\",\"1\",{\"children\":\"組成對象\"}],[\"$\",\"th\",\"2\",{\"children\":\"代表意義\"}],[\"$\",\"th\",\"3\",{\"children\":\"觀察重點\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"三大法人\"}],[\"$\",\"td\",\"1\",{\"children\":\"外資、投信、自營商\"}],[\"$\",\"td\",\"2\",{\"children\":\"市場整體法人看法\"}],[\"$\",\"td\",\"3\",{\"children\":\"外資淨多單的趨勢與水位\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"十大特定法人\"}],[\"$\",\"td\",\"1\",{\"children\":\"扣除自營商後，交易量最大的十家法人\"}],[\"$\",\"td\",\"2\",{\"children\":\"市場最頂尖主力的看法\"}],[\"$\",\"td\",\"3\",{\"children\":\"淨部位方向是否與外資一致，作為趨勢強度的確認\"}]]}]]}]]}]}]\n1a:[\"$\",\"figure\",\"2\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"!只看一天數字變化!把投信空單當作看空!忽略散戶反向指標!單獨使用不做交叉驗證\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"常見的解讀誤區\"}]]}]\n1b:[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、散戶的逆襲？「小台散戶多空比」為什麼要反著看？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"小台指（小型台股期貨）因為合約規模較小，是散戶最常參與的市場。我們可以透過「小台指未平倉量」減去「三大法人在小台的未平倉量」，來推算出散戶的整體多空方向。歷史數據顯示，這個指標往往是反向的：當散戶大多看多時，行情容易下跌；當散戶大多看空時，行情反而容易上漲。\"}],[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"計算方式：(小台散戶多單未平倉量 - 小台散戶空單未平倉量) / 小台總未平倉量\"}],[\"$\",\"li\",\"1\",{\"children\":\"樂觀門檻：多空比若來到 +20% 以上（散戶極度樂觀），要小心行情反轉向下。\"}],[\"$\",\"li\",\"2\",{\"children\":\"悲觀門檻：多空比若來到 -20% 以下（散戶極度悲觀），可能是行情準備反彈的訊號。\"}],[\"$\",\"li\",\"3\",{\"children\":\"常見錯誤：不要只看一天，要觀察趨勢。當散戶持續往一個方向集結時，反向訊號的可靠度更高。\"}]]}]]]}]\n1c:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、如何整合所有資訊，做出自己的判斷？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"看懂單一數字還不夠，重點是把這些籌碼資訊組合起來，形成一個完整的市場圖像。你可以把大戶（外資、十大特定法人）當成「船長」，散戶當成「乘客」。當船長們都往同一個方向開船（例如同步做多），而乘客們卻反向跑（散戶做空），這艘船（大盤）往船長方向前進的機率就很高。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"第一步：確認大方向 - 查看外資與十大特定法人的未平倉淨額，他們是同向還是分歧？\"}],[\"$\",\"li\",\"1\",{\"children\":\"第二步：觀察散戶位置 - 小台散戶多空比是偏多還是偏空？是否達到極端值？\"}],[\"$\",\"li\",\"2\",{\"children\":\"第三步：比對價格走勢 - 價格上漲時，大戶多單是否同步增加？若價漲但大戶多單減少，就是警訊。\"}],[\"$\",\"li\",\"3\",{\"children\":\"第四步：建立你的劇本 - 綜合以上資訊，判斷目前是「大戶散戶同向」的趨勢盤，還是「大戶散戶對作」的盤勢。\"}]]}]]]}]\n1d:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"未平倉量增加，指數就一定會漲嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"不一定。未平倉量增加只代表多空分歧變大，有更多人進場。如果價格上漲且未平倉量增加，代表追多的力道強勁；但如果價格下跌而未平倉量增加，則代表追空的力道更強。重點是「價格往哪個方向走」。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"這些資料要去哪裡查？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"台灣期貨交易所的官方網站在每日下午 4 點左右會公布「三大法人交易資訊」。許多券商軟體和財經網站也會整理成更易讀的圖表，在股市大佬的「大盤總覽」頁面，我們也將這些關鍵數據視覺化，方便你長期追蹤。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"為什麼投信常常都是淨空單？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"因為法規限制，投信（基金公司）不能主動放空台股。他們持有大量現貨股票，為了規避大盤系統性下跌的風險，會買進台指期空單來「避險」。所以看到投信空單增加，不代表他們看壞個股，而可能是在做資產保護。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"外資的未平倉量有「絕對安全」的水位嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"沒有絕對的數字。雖然歷史上淨多單超過 2-3 萬口常被視為多頭氣氛濃厚，但市場結構會改變。更重要的是觀察「趨勢變化」，例如從淨多單 3 萬口快速下降到 1 萬口，即使還是正數，這個「減少的趨勢」本身就是一個警訊。\"}]]}]]}]]]}]\n1e:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"總結來說，觀察台指期未平倉量，核心就是分辨「誰在買、誰在賣」。將三大法人與十大特定法人視為市場風向球，並把散戶指標當作反向參考，就能有效提升你對大盤多空氛圍的判斷力，避免只看價格追高殺低。\"}]]]}]\n1f:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L18\",\"0-在大盤總覽頁面追\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"在大盤總覽頁面追蹤法人動向\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L18\",\"0-學習更多籌碼分析\",{\"href\":\"/school\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"學習更多籌碼分析技巧\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L18\",\"0-每日市場籌碼變化\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"每日市場籌碼變化，請看台股日報\"}]]}]]}]]]}]\n14:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\n10:null\n20:I[80622,[],\"IconMark\"]\n12:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"台指期未平倉量怎麼看？3指標看懂大戶散戶動向，預判大盤多空｜股市大佬 TradeBoss\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"每天看新聞都說「外資台指期未平倉淨多單增加」，但這個數字到底代表什麼？為什麼它能影響大盤走勢？這篇文章會帶你從零看懂未平倉數據，學會判斷市場上「真正的大玩家」是做多還是做空。\"}],[\"$\",\"link\",\"2\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}],[\"$\",\"$L20\",\"3\",{}]],\"error\":null,\"digest\":\"$undefined\"}\n17:\"$12:metadata\"\n"}