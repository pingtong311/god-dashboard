"$\",\"$1\",\"h\",{\"children\":[null,[[\"$\",\"$L12\",null,{\"children\":\"$L13\"}],[\"$\",\"meta\",null,{\"name\":\"next-size-adjust\",\"content\":\"\"}]],[\"$\",\"$L14\",null,{\"children\":[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$15\",null,{\"fallback\":null,\"children\":\"$L16\"}]}]}]]}]\n17:I[52619,[\"2619\",\"static/chunks/2619-04bc32f026a0d946.js\",\"6309\",\"static/chunks/app/learn/%5Bslug%5D/page-f7b99344f7e2ee16.js\"],\"\"]\nd:[\"$\",\"div\",null,{\"className\":\"LearnArticle_wrap__LIQ8G\",\"children\":[\"$\",\"article\",null,{\"className\":\"LearnArticle_article__2nBbk\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_meta__etj_G\",\"children\":[[\"$\",\"$L17\",null,{\"className\":\"LearnArticle_cat__GQMlg\",\"href\":\"/learn?c=trends\",\"children\":\"產業與趨勢\"}],[\"$\",\"span\",null,{\"className\":\"LearnArticle_read__QEj6a\",\"children\":\"閱讀約 7 分鐘\"}]]}],[\"$\",\"h1\",null,{\"className\":\"LearnArticle_title__0_la8\",\"children\":\"金控怎麼看？只看殖利率就夠了嗎？搞懂 3 個關鍵數字，避開存股陷阱\"}],[\"$\",\"details\",null,{\"className\":\"LearnArticle_toc__LcSAa\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"LearnArticle_tocSummary__YBddG\",\"children\":\"本文目錄\"}],[\"$\",\"ol\",null,{\"className\":\"LearnArticle_tocList__Rq_Lz\",\"children\":[[\"$\",\"li\",\"sec-1\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-1\",\"children\":\"一、為什麼不能只看殖利率挑金控股？小心賺了股息、賠了價差\"}]}],[\"$\",\"li\",\"sec-2\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-2\",\"children\":\"二、金控分三種：銀行、壽險、證券型，體質差在哪？\"}]}],[\"$\",\"li\",\"sec-3\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-3\",\"children\":\"三、銀行為主的金控怎麼看？盯緊「逾放比」與「呆帳覆蓋率」\"}]}],[\"$\",\"li\",\"sec-4\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-4\",\"children\":\"四、壽險為主的金控怎麼看？「資本適足率 (RBC)」是保命符\"}]}],[\"$\",\"li\",\"sec-5\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-5\",\"children\":\"五、每月必看的領先指標：金控「自結 EPS」是什麼？\"}]}],[\"$\",\"li\",\"sec-6\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-6\",\"children\":\"常見問題 FAQ\"}]}],[\"$\",\"li\",\"sec-7\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-7\",\"children\":\"總結\"}]}],[\"$\",\"li\",\"sec-8\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-8\",\"children\":\"延伸閱讀\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"LearnArticle_body__6B7Mb\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_intro__ATV5c\",\"children\":\"一打開股市 App，看到十幾家金控股，每家都號稱「大到不會倒」，每年配息好像也還不錯，到底該怎麼挑？很多人只看誰的殖利率最高就買誰，結果股價不漲，配息還可能縮水。這篇文章就是要帶你拆解金控公司的體質，教你除了看殖利率，更要看懂 3 個攸關公司穩健度的關鍵數字，讓你挑選時更有方向。\"}],[],[\"$\",\"div\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"金控股不能只看殖利率，獲利來源（銀行、壽險、證券）決定了它的風險屬性。\"}],[\"$\",\"li\",\"1\",{\"children\":\"銀行型金控看「逾放比」與「呆帳覆蓋率」，數字分別要低於 3%、高於 100%。\"}],[\"$\",\"li\",\"2\",{\"children\":\"壽險型金控受利率與匯率影響大，要關注「資本適足率 (RBC)」是否高於 200%。\"}],[\"$\",\"li\",\"3\",{\"children\":\"定期檢視金控的每月自結 EPS，能提早發現獲利衰退的警訊。\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、為什麼不能只看殖利率挑金控股？小心賺了股息、賠了價差\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"很多投資人喜歡存金融股，就是看上它每年穩定的配息。但如果只用「現金殖利率」這一個指標來選股，很容易忽略背後的風險。金控的業務很複雜，獲利來源可能是銀行、壽險或證券，不同業務的穩定性天差地遠，會直接影響未來的配息能力與股價表現。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"獲利來源不同：壽險為主的金控，獲利受國際利率、匯率影響大，波動性高。\"}],[\"$\",\"li\",\"1\",{\"children\":\"景氣循環影響：證券為主的金控，獲利跟著股市熱度走，牛市熊市差很多。\"}],[\"$\",\"li\",\"2\",{\"children\":\"隱藏的風險：只看過去配息紀錄，無法反映公司未來的經營風險或潛在虧損。\"}]]}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、金控分三種：銀行、壽險、證券型，體質差在哪？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"我們可以把金控大致分成三種主要類型：以銀行為核心、以壽險為核心，以及以證券為核心。雖然很多金控是綜合經營，但通常會有一個主要的獲利引擎。了解這個主要引擎是什麼，就能掌握它獲利的基本盤與風險特性。\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"類型\"}],[\"$\",\"th\",\"1\",{\"children\":\"獲利來源\"}],[\"$\",\"th\",\"2\",{\"children\":\"優點\"}],[\"$\",\"th\",\"3\",{\"children\":\"風險\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"銀行型金控\"}],[\"$\",\"td\",\"1\",{\"children\":\"存放款利差、手續費\"}],[\"$\",\"td\",\"2\",{\"children\":\"獲利相對穩定、受景氣影響較小\"}],[\"$\",\"td\",\"3\",{\"children\":\"升息週期可能有利，但需注意呆帳風險\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"壽險型金控\"}],[\"$\",\"td\",\"1\",{\"children\":\"保費收入、投資收益\"}],[\"$\",\"td\",\"2\",{\"children\":\"資產規模龐大，有長期投資優勢\"}],[\"$\",\"td\",\"3\",{\"children\":\"獲利受利率、匯率、股市波動影響劇烈\"}]]}],[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"證券型金控\"}],[\"$\",\"td\",\"1\",{\"children\":\"經紀手續費、自營操作\"}],[\"$\",\"td\",\"2\",{\"children\":\"股市多頭時獲利爆發力強\"}],[\"$\",\"td\",\"3\",{\"children\":\"獲利與股市行情高度連動，波動最大\"}]]}]]}]]}]}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、銀行為主的金控怎麼看？盯緊「逾放比」與「呆帳覆蓋率」\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"如果一家金控的主要獲利來自銀行，那我們最關心的就是「放出去的錢收不收得回來」。這裡有兩個關鍵數字可以幫我們判斷銀行的資產品質，就像是銀行的健康檢查報告。這兩個數字在各大券商軟體或財經網站都能查到。\"}],\"$L18\",\"$L19\"]]}],\"$L1a\",\"$L1b\",\"$L1c\",\"$L1d\",\"$L1e\"],null]}]]}]}]\n18:[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"逾期放款比率（逾放比）：指銀行放出去的貸款中，超過三個月沒正常繳本息的佔了多少。這個數字越低越好，一般來說，低於 3% 是基本門檻，1% 以下算體質優良。\"}],[\"$\",\"li\",\"1\",{\"children\":\"呆帳覆蓋率：指銀行準備了多少錢來應付可能收不回來的呆帳。這個數字越高，代表銀行風險承受能力越強。法規要求是 100% 以上，越高越穩健。\"}]]}]\n19:[\"$\",\"figure\",\"2\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"!只看殖利率高低!以為大到不會倒就沒風險!忽略獲利來源的差異!買進後就不再追蹤\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"存金融股常見誤區\"}]]}]\n1a:[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、壽險為主的金控怎麼看？「資本適足率 (RBC)」是保命符\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"壽險公司的錢，很多都拿去海外投資，所以獲利非常容易受到國際利率和匯率的影響。當美國聯準會升息或降息，都可能造成壽險公司巨大的投資收益或虧損。因此，評估它們的關鍵，在於「家底夠不夠厚」，能不能扛得住市場的劇烈波動。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"資本適足率 (RBC)：這是衡量保險公司自有資本對比其所承擔風險的指標。簡單說，就是公司抵抗風險的能力。根據台灣法規（2026-08 查證），RBC 必須高於 200%。如果低於這個數字，就可能需要增資，對股東權益會有影響。\"}]]}]]]}]\n1b:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、每月必看的領先指標：金控「自結 EPS」是什麼？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"金控公司是少數每月會公布「自結盈餘」的產業。自結盈餘就是公司自己初步計算的單月獲利狀況，雖然不是最終經過會計師查核的財報，但卻是觀察獲利趨勢最即時的數據。不用等到三個月一次的季報，我們就能快速掌握公司的營運變化。\"}],[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"去哪裡看：每月 10 號前，金控公司會陸續在公開資訊觀測站或自家官網公布上個月的自結盈餘。\"}],[\"$\",\"li\",\"1\",{\"children\":\"怎麼比較：不要只看單月數字，要跟「去年同月」比較（年增率 YoY），才能排除季節性因素，看出真正的成長或衰退。\"}],[\"$\",\"li\",\"2\",{\"children\":\"注意警訊：如果一家金控的單月自結 EPS 連續幾個月都出現年衰退，就要提高警覺，去了解是哪個子公司（銀行、壽險、證券）出了問題。\"}]]}]]]}]\n1c:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"金控股價都不太動，適合做價差嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"金控股本龐大，股性普遍較為牛皮，短線價格波動相對小，較不適合追求頻繁價差交易。多數投資人是著眼於其穩定的股利發放，作為長期資產配置的一環。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"官股金控和民營金控哪個比較好？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"官股金控有政府支持，經營上以穩健為首要目標，倒閉風險極低，但獲利成長性可能較受限。民營金控經營較靈活，追求獲利成長的企圖心較強，但經營風險也相對較高，兩者各有優劣。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"買了金融股被套牢怎麼辦？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"如果當初買進的理由（例如公司體質穩健、配息穩定）沒有改變，且是閒錢投資，可以考慮持續觀察。但若發現公司基本面出現惡化，例如逾放比持續攀升，就應該重新評估是否要調整部位。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"金融股的「特別股」是什麼？可以買嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"特別股是一種介於普通股和債券之間的證券，它會約定一個固定的股息率，配息順序優先於普通股。它的股價波動比普通股小，但通常沒有投票權，適合追求穩定現金流、對價差要求不高的投資人。\"}]]}]]}]]]}]\n1d:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"總結來說，挑選金控股不能再只當個「存股懶人包」，單看殖利率就下決定。你應該先區分它是銀行、壽險還是證券型，再用對應的關鍵指標（如逾放比、RBC）去檢視體質，並每月追蹤自結 EPS，才能做出更穩健的判斷。\"}]]]}]\n1e:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L17\",\"0-想知道最新的除權\",{\"href\":\"/s/2330\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"想知道最新的除權息日期嗎？\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L17\",\"0-用個股透視頁，一\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"用個股透視頁，一次看懂財務比率\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L17\",\"0-更多台股名詞解釋\",{\"href\":\"/school\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"更多台股名詞解釋，都在台股學堂\"}]]}]]}]]]}]\n13:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\nf:null\n1f:I[80622,[],\"IconMark\"]\n11:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"金控怎麼看？只看殖利率就夠了嗎？搞懂 3 個關鍵數字，避開存股陷阱｜股市大佬 TradeBoss\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"一打開股市 App，看到十幾家金控股，每家都號稱「大到不會倒」，每年配息好像也還不錯，到底該怎麼挑？很多人只看誰的殖利率最高就買誰，結果股價不漲，配息還可能縮水。這篇文章就是要帶你拆解金控公司的體質，教你除了看殖利率，更要看懂 3 個攸關公司穩健度的關鍵數字，讓你挑選時更有方向。\"}],[\"$\",\"link\",\"2\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}],[\"$\",\"$L1f\",\"3\",{}]],\"error\":null,\"digest\":\"$undefined\"}\n16:\"$11:metadata\"\n"}