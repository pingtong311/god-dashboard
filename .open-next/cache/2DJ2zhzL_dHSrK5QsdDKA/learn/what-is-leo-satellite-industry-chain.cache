\"$\",\"$L14\",null,{\"children\":[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$15\",null,{\"fallback\":null,\"children\":\"$L16\"}]}]}]]}]\n17:I[52619,[\"2619\",\"static/chunks/2619-04bc32f026a0d946.js\",\"6309\",\"static/chunks/app/learn/%5Bslug%5D/page-f7b99344f7e2ee16.js\"],\"\"]\nd:[\"$\",\"div\",null,{\"className\":\"LearnArticle_wrap__LIQ8G\",\"children\":[\"$\",\"article\",null,{\"className\":\"LearnArticle_article__2nBbk\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_meta__etj_G\",\"children\":[[\"$\",\"$L17\",null,{\"className\":\"LearnArticle_cat__GQMlg\",\"href\":\"/learn?c=themes\",\"children\":\"題材專欄\"}],[\"$\",\"span\",null,{\"className\":\"LearnArticle_read__QEj6a\",\"children\":\"閱讀約 7 分鐘\"}]]}],[\"$\",\"h1\",null,{\"className\":\"LearnArticle_title__0_la8\",\"children\":\"低軌衛星概念股怎麼找？先懂產業鏈 3 大環節\"}],[\"$\",\"details\",null,{\"className\":\"LearnArticle_toc__LcSAa\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"LearnArticle_tocSummary__YBddG\",\"children\":\"本文目錄\"}],[\"$\",\"ol\",null,{\"className\":\"LearnArticle_tocList__Rq_Lz\",\"children\":[[\"$\",\"li\",\"sec-1\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-1\",\"children\":\"一、為什麼大家突然都在談低軌衛星？\"}]}],[\"$\",\"li\",\"sec-2\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-2\",\"children\":\"二、低軌衛星產業鏈，到底分成哪幾塊？\"}]}],[\"$\",\"li\",\"sec-3\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-3\",\"children\":\"三、台廠的機會在哪？為什麼都集中在「地面」？\"}]}],[\"$\",\"li\",\"sec-4\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-4\",\"children\":\"四、如何判斷一間公司是不是「純血」概念股？\"}]}],[\"$\",\"li\",\"sec-5\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-5\",\"children\":\"五、投資低軌衛星題材，要注意哪些風險？\"}]}],[\"$\",\"li\",\"sec-6\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-6\",\"children\":\"常見問題 FAQ\"}]}],[\"$\",\"li\",\"sec-7\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-7\",\"children\":\"總結\"}]}],[\"$\",\"li\",\"sec-8\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-8\",\"children\":\"延伸閱讀\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"LearnArticle_body__6B7Mb\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_intro__ATV5c\",\"children\":\"新聞一提到「太空探索」，相關概念股就動起來，但點開一看，做天線的、做散熱的、做印刷電路板的都有，到底誰才是真的？這篇就是要帶你拆解整個低軌衛星產業鏈，搞懂從天上到地下的分工，下次看到新聞才知道怎麼判斷。\"}],[[\"$\",\"figure\",\"figure-0\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"越後面越熱鬧，通常也越貴、越好離開佈局沒新聞命名故事出現擁擠人人都知退燒利多變鈍新聞出現時，常常已經不是第一段\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"示意圖｜題材四階段：佈局 → 命名 → 擁擠 → 退燒（教學結構，不是某檔實盤）\"}]]}]],[\"$\",\"div\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"低軌衛星產業鏈分三大塊：衛星製造、地面設備、終端應用。\"}],[\"$\",\"li\",\"1\",{\"children\":\"台廠優勢在於地面設備，如天線、PCB、網通設備，而非火箭或衛星本體。\"}],[\"$\",\"li\",\"2\",{\"children\":\"評估相關公司時，要看營收佔比，確認「衛星業務」是不是真的主力。\"}],[\"$\",\"li\",\"3\",{\"children\":\"這個產業還在發展初期，題材性高，但實際獲利貢獻仍需時間驗證。\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、為什麼大家突然都在談低軌衛星？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"低軌衛星（Low Earth Orbit, LEO）指的是在離地 2000 公里以下軌道運行的衛星。它最大的好處是離我們很近，所以網路訊號延遲低，能解決偏遠地區、海上、空中上網的難題。過去因為發射成本太高，一直難以普及，但近年來像 SpaceX 這樣的公司成功回收火箭，大幅降低了成本，讓建立由數千顆衛星組成的「星鏈」網路變成可能，才引爆了這個全球性的新商機。\"}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、低軌衛星產業鏈，到底分成哪幾塊？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"整個產業鏈可以簡單分成「天上」跟「地下」兩大部分，再細分成三大環節。你可以把它想像成蓋手機基地台：需要有人做衛星（像基地台本體）、有人做地面接收設備（像你的手機），還要有電信商提供服務。台廠的機會，主要集中在中間的「地面設備」。\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"環節\"}],[\"$\",\"th\",\"1\",{\"children\":\"核心業務\"}],[\"$\",\"th\",\"2\",{\"children\":\"進入門檻與台廠機會\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"衛星製造與發射\"}],[\"$\",\"td\",\"1\",{\"children\":\"衛星本體、次系統、火箭發射\"}],[\"$\",\"td\",\"2\",{\"children\":\"極高，由歐美航太巨頭主導，台廠不易切入。\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"地面設備\"}],[\"$\",\"td\",\"1\",{\"children\":\"使用者終端、基地台、天線、網通設備\"}],[\"$\",\"td\",\"2\",{\"children\":\"高，但台廠在資通訊製造有深厚基礎，是主要機會所在。\"}]]}],[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"終端服務與應用\"}],[\"$\",\"td\",\"1\",{\"children\":\"衛星通訊服務、數據加值應用\"}],[\"$\",\"td\",\"2\",{\"children\":\"中，通常由衛星營運商（如 Starlink）主導，台廠多為合作夥伴。\"}]]}]]}]]}]}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、台廠的機會在哪？為什麼都集中在「地面」？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"台灣的強項在於半導體和資通訊（ICT）製造，而不是火箭或衛星科學。因此，供應鏈機會自然就落在我們最擅長的「地面設備」上。這包括從家家戶戶屋頂上裝的「小耳朵」（使用者終端），到大型地面接收站裡的各種零組件，都是台廠可以發揮的地方。\"}],\"$L18\",\"$L19\"]]}],\"$L1a\",\"$L1b\",\"$L1c\",\"$L1d\",\"$L1e\"],null]}]]}]}]\n18:[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"使用者終端（User Terminal）的天線與射頻元件\"}],[\"$\",\"li\",\"1\",{\"children\":\"高頻高速的印刷電路板（PCB）與伺服器\"}],[\"$\",\"li\",\"2\",{\"children\":\"地面接收站（Gateway）的網通設備\"}],[\"$\",\"li\",\"3\",{\"children\":\"關鍵零組件如散熱模組、電源供應器\"}]]}]\n19:[\"$\",\"figure\",\"2\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"✓營收佔比是否夠高✓技術門檻是否領先✓是否打入大廠供應鏈\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"篩選概念股 3 個檢查點\"}]]}]\n1a:[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、如何判斷一間公司是不是「純血」概念股？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"很多公司都會被媒體歸類為「概念股」，但實際上衛星相關業務可能只佔它總營收的 1-2%，對公司獲利影響很小。要判斷一間公司受惠程度，最關鍵的數字就是「營收佔比」。如果一間公司相關業務的營收佔比不到 10%，那股價的反應可能多半是題材帶動，而非實質獲利支撐。\"}],[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"打開財報或法說會簡報，找出衛星相關業務的營收數字。\"}],[\"$\",\"li\",\"1\",{\"children\":\"計算該業務佔公司總營收的百分比。\"}],[\"$\",\"li\",\"2\",{\"children\":\"設定一個自己的標準，例如佔比超過 10% 或 20%，才算是重點觀察對象。\"}]]}]]]}]\n1b:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、投資低軌衛星題材，要注意哪些風險？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"這是一個很新的產業，充滿機會，但也伴隨不小的風險。在投入之前，一定要了解它還在快速變動的階段，訂單和技術規格都可能說變就變。千萬不要把新聞熱度當成股價會一直漲的保證，務實看待產業發展的挑戰，才能做出更穩健的判斷。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"技術規格仍在變動，現在的贏家不保證永遠領先。\"}],[\"$\",\"li\",\"1\",{\"children\":\"國際大廠（如 Starlink）可能自建供應鏈，取代外部廠商。\"}],[\"$\",\"li\",\"2\",{\"children\":\"產業發展初期，本夢比高於本益比，股價波動非常劇烈。\"}],[\"$\",\"li\",\"3\",{\"children\":\"全球政治風險，如發射許可、頻譜分配等，非廠商能控制。\"}]]}]]]}]\n1c:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"低軌衛星跟傳統的同步衛星有什麼不一樣？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"主要差在高度。低軌衛星離地球近（約 500-2000 公里），訊號延遲低，適合即時通訊；但覆蓋範圍小，需要發射大量衛星組網。傳統同步衛星高達 36,000 公里，一顆就能覆蓋大面積，但延遲高。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"為什麼說台廠在衛星「本體」製造上沒什麼機會？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"衛星本體涉及航太工程、特殊材料等高度整合的技術，長期由歐美日的國防或航太巨頭主導，進入門檻極高。台灣的產業優勢在於資通訊（ICT）的零組件製造與系統整合，因此切入地面設備是更務實的路徑。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"我看到很多 PCB 廠都說是低軌衛星概念股，該怎麼選？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"關鍵還是看「規格」和「佔比」。低軌衛星用的 PCB 需要高頻、高速的特殊材料，不是所有廠商都能做。研究時，要確認該公司的產品是否通過衛星大廠認證，以及這塊高階產品佔公司整體營收多少，避免選到只是沾到邊的公司。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"這個題材會不會像元宇宙一樣，只是一陣風？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"低軌衛星有明確的商業模式和實際需求，例如偏遠地區上網、航空與航海通訊、物聯網數據傳輸等，應用基礎比元宇宙更扎實。但產業發展需要時間，市場初期可能會過度期待，導致股價波動，投資人需要有更長期的觀察視角。\"}]]}]]}]]]}]\n1d:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"想掌握低軌衛星的投資機會，別只停留在追新聞題材。核心方法是拆解產業鏈，專注於台廠真正有優勢的「地面設備」，並用「營收佔比」這個數字，篩選出真正受惠的公司。\"}]]]}]\n1e:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L17\",\"0-用族群透視看懂資\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"用族群透視看懂資金流向\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L17\",\"0-到個股透視頁深入\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"到個股透視頁深入研究\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L17\",\"0-更多產業知識就在\",{\"href\":\"/school\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"更多產業知識就在台股學堂\"}]]}]]}]]]}]\n13:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\nf:null\n1f:I[80622,[],\"IconMark\"]\n11:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"低軌衛星概念股怎麼找？先懂產業鏈 3 大環節｜股市大佬 TradeBoss\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"新聞一提到「太空探索」，相關概念股就動起來，但點開一看，做天線的、做散熱的、做印刷電路板的都有，到底誰才是真的？這篇就是要帶你拆解整個低軌衛星產業鏈，搞懂從天上到地下的分工，下次看到新聞才知道怎麼判斷。\"}],[\"$\",\"link\",\"2\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}],[\"$\",\"$L1f\",\"3\",{}]],\"error\":null,\"digest\":\"$undefined\"}\n16:\"$11:metadata\"\n"}