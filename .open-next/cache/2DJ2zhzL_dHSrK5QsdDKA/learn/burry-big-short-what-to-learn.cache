],[\"$\",\"li\",\"1\",{\"children\":\"價格會先罰你\"}],[\"$\",\"li\",\"2\",{\"children\":\"論證要能重讀\"}]]}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、三個結構\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"第一，把複雜產品拆成你真的懂的現金流故事。第二，承認時機可能錯很久。第三，工具與流動性會決定你對了能不能活著實現。第三個常被電影省略。\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"電影給的\"}],[\"$\",\"th\",\"1\",{\"children\":\"結構\"}],[\"$\",\"th\",\"2\",{\"children\":\"誤用\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"看對世紀交易\"}],[\"$\",\"td\",\"1\",{\"children\":\"寫得出論證\"}],[\"$\",\"td\",\"2\",{\"children\":\"去找下一筆世紀\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"對手很蠢\"}],[\"$\",\"td\",\"1\",{\"children\":\"你也可能錯很久\"}],[\"$\",\"td\",\"2\",{\"children\":\"道德當進出\"}]]}],[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"結局兌現\"}],[\"$\",\"td\",\"1\",{\"children\":\"中間可能走不掉\"}],[\"$\",\"td\",\"2\",{\"children\":\"忽略工具與流動性\"}]]}],[\"$\",\"tr\",\"3\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"英雄孤勇\"}],[\"$\",\"td\",\"1\",{\"children\":\"等待成本真實\"}],[\"$\",\"td\",\"2\",{\"children\":\"用熱情代替尺寸\"}]]}]]}]]}]}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、為什麼不能當劇本\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"產品、槓桿、對手與監理都已不同。重做同一筆沒有依據。能重做的只有：論證寫清楚、尺寸小到能等、不把道德當分析。\"}],[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"寫論證\"}],[\"$\",\"li\",\"1\",{\"children\":\"把等待算進尺寸\"}],[\"$\",\"li\",\"2\",{\"children\":\"不重做故事情節\"}]]}],[\"$\",\"figure\",\"2\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"!找下一筆世紀!道德當分析!忽略尺寸\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"讀成劇本\"}]]}]]]}],[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、和塔雷伯、海嘯文的關係\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"那次事件後來也被放進系統性風險教材。塔雷伯談不可知，海嘯談一起失效。貝瑞這篇談的是「即使你覺得自己知道，等待與實現仍可能先殺死你」。三篇叠在一起，才不會只剩英雄故事。\"}],\"$L18\"]]}],\"$L19\",\"$L1a\",\"$L1b\",\"$L1c\"],\"$L1d\"]}]]}]}]\n18:[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"知道≠活得過等待\"}],[\"$\",\"li\",\"1\",{\"children\":\"系統性事件離開很難\"}],[\"$\",\"li\",\"2\",{\"children\":\"英雄故事會刪掉尺寸\"}]]}]\n19:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、最小動作\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"你若有一個「別人都不信」的看法，先寫：我能錯幾季、錯的時候誰叫我走、對的時候我走不走得掉。三行寫不滿，看法再動人都還只是電影。\"}]]]}]\n1a:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"看對泡沫是不是就該重倉？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"公開過程反而提醒等待很長。重倉常活不到兌現。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"散戶能做同類研究嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"能做公開資料的論證。不能做的是假設自己有同樣工具與流動性。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"電影能當教材嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"當娛樂可以。當劇本不行。教材看結構。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"和遊戲驛站有何相似？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"都被讀成可重做的戰爭。燃料都是一次性的。\"}]]}]]}]]]}]\n1b:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"大空頭能留的是論證、等待成本與流動性，不是世紀交易劇本。對得早也可能先出局。三行寫不滿就還是電影。\"}]]]}]\n1c:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L17\",\"0-2008 金融海\",{\"href\":\"/learn/2008-financial-crisis-why-diversification-failed-together\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"2008 金融海嘯\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L17\",\"0-塔雷伯黑天鵝\",{\"href\":\"/learn/taleb-black-swan-for-traders\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"塔雷伯黑天鵝\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L17\",\"0-遊戲驛站軋空\",{\"href\":\"/learn/gamestop-squeeze-what-retail-should-actually-learn\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"遊戲驛站軋空\"}]]}]]}]]]}]\n1d:[\"$\",\"div\",null,{\"className\":\"LearnArticle_re