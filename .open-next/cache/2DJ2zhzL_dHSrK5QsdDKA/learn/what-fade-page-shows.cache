n/%5Bslug%5D/page-f7b99344f7e2ee16.js\"],\"\"]\nd:[\"$\",\"div\",null,{\"className\":\"LearnArticle_wrap__LIQ8G\",\"children\":[\"$\",\"article\",null,{\"className\":\"LearnArticle_article__2nBbk\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_meta__etj_G\",\"children\":[[\"$\",\"$L17\",null,{\"className\":\"LearnArticle_cat__GQMlg\",\"href\":\"/learn?c=platform\",\"children\":\"平台教學\"}],[\"$\",\"span\",null,{\"className\":\"LearnArticle_read__QEj6a\",\"children\":\"閱讀約 4 分鐘\"}]]}],[\"$\",\"h1\",null,{\"className\":\"LearnArticle_title__0_la8\",\"children\":\"股市大佬隔日沖頁看什麼？3個數字怎麼讀\"}],[\"$\",\"details\",null,{\"className\":\"LearnArticle_toc__LcSAa\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"LearnArticle_tocSummary__YBddG\",\"children\":\"本文目錄\"}],[\"$\",\"ol\",null,{\"className\":\"LearnArticle_tocList__Rq_Lz\",\"children\":[[\"$\",\"li\",\"sec-1\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-1\",\"children\":\"一、這一頁在統計什麼\"}]}],[\"$\",\"li\",\"sec-2\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-2\",\"children\":\"二、三個數字怎麼讀\"}]}],[\"$\",\"li\",\"sec-3\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-3\",\"children\":\"三、還有哪些標記要一起看\"}]}],[\"$\",\"li\",\"sec-4\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-4\",\"children\":\"四、為什麼它不是操作建議\"}]}],[\"$\",\"li\",\"sec-5\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-5\",\"children\":\"五、看完要去哪裡核對\"}]}],[\"$\",\"li\",\"sec-6\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-6\",\"children\":\"常見問題 FAQ\"}]}],[\"$\",\"li\",\"sec-7\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-7\",\"children\":\"總結\"}]}],[\"$\",\"li\",\"sec-8\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-8\",\"children\":\"延伸閱讀\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"LearnArticle_body__6B7Mb\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_intro__ATV5c\",\"children\":\"頁面名稱有「隔日沖」三個字，最容易被讀成操作課。實際標題是「隔日沖分點研究」，說明寫的是：整理當日籌碼較集中，且分點買超後次日出現反向賣超的歷史樣本。重點是資料日、符合比例與樣本數，不把歷史比例當成明日預測，更不是叫你去隔日沖。\"}],[],[\"$\",\"div\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"三個數字：歷史樣本符合率、集中度、樣本次數\"}],[\"$\",\"li\",\"1\",{\"children\":\"樣本少或流動性不足時，統計要降權重\"}],[\"$\",\"li\",\"2\",{\"children\":\"這一頁給歷史對照，不給隔日沖指令\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、這一頁在統計什麼\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"使用說明寫得很具體：統計分點淨買超後，次一交易日淨賣超超過前日淨買量一半的歷史樣本。你看到的不是「明天會怎麼走」，而是「過去出現類似分點行為時，有多少次隔日轉成賣超」。頁面要你比較歷史樣本符合率、樣本數、集中度與成交量。樣本太少或流動性不足時，統計可信度會降低。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"統計的是已發生的分點序列\"}],[\"$\",\"li\",\"1\",{\"children\":\"符合率必須連同樣本數讀\"}],[\"$\",\"li\",\"2\",{\"children\":\"不是叫你隔日沖的課表\"}]]}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、三個數字怎麼讀\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"每一列中間有三格。第一格是歷史樣本符合率，沒有資料就顯示橫線。第二格是籌碼集中度。第三格是歷史樣本次數。下方會寫歷史樣本分點名稱；校驗中會標資料校驗中。列尾會再重複樣本次數，少於八次會加註樣本偏少。這三個數字互相牽制：符合率高但只有兩次，不能講成穩定慣性。\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"欄位\"}],[\"$\",\"th\",\"1\",{\"children\":\"它描述的\"}],[\"$\",\"th\",\"2\",{\"children\":\"不能讀成\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"歷史樣本符合率\"}],[\"$\",\"td\",\"1\",{\"children\":\"過去樣本裡隔日轉賣超的比例\"}],[\"$\",\"td\",\"2\",{\"children\":\"明天會賣的機率\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"籌碼集中度\"}],[\"$\",\"td\",\"1\",{\"children\":\"資料日買超是否集中\"}],[\"$\",\"td\",\"2\",{\"children\":\"主力明天一定留\"}]]}],[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"歷史樣本次數\"}],[\"$\",\"td\",\"1\",{\"children\":\"拿來算比例的樣本有幾次\"}],[\"$\",\"td\",\"2\",{\"children\":\"次數多就保證下次\"}]]}],[\"$\",\"tr\",\"3\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"歷史樣本分點\"}],[\"$\",\"td\",\"1\",{\"children\":\"這列對應的分點名稱\"}],[\"$\",\"td\",\"2\",{\"children\":\"可辨識的特定帳戶\"}]]}]]}]]}]}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、還有哪些標記要一起看\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"資料新鮮度標的是選股基準日，下次更新約平日二十一點三十分盤後。列上可能出現「昨鎖漲停」提醒，以及基準日盤後量偏小、胃納量小的標記。現價若出現會另標時間，不與盤後量混用。會員也可能看到日 K 結構參考低高與比例參考，並註明可自行設提醒。這些仍是結構對照，不是平台給的進出點。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"先看基準日與盤後量\"}],[\"$\",\"li\",\"1\",{\"children\":\"鎖漲停與低流動性要降權重\"}],[\"$\",\"li\",\"2\",{\"children\":\"結構參考不是停損停利單\"}]]}],[\"$\",\"figure\",\"2\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"!符合率當明天機率!忽略樣本偏少!把研究頁當操作課\"}],\"$L18\"]}]]]}],\"$L19\",\"$L1a\",\"$L1b\",\"$L1c\",\"$L1d\"],null]}]]}]}]\n18:[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"讀錯的三種\"}]\n19:[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、為什麼它不是操作建議\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"公開分點資料無法證明帳戶屬於同一個人，也無法證明下一次會重複。頁面因此把「符合率」寫成歷史樣本，而不是勝率保證。一般會員看不到內部研究情境裡的觀察空點或回補描述；那本來就不是給會員下單用的。你若把這一頁轉發給別人當明日清單，就是把統計誤讀成明牌，這不是頁面用途。\"}]]]}]\n1a:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、看完要去哪裡核對\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"使用說明的下一步是：點入個股，核對該日分點買賣超與日 K，並自行判斷資料是否適合研究。定義不清楚就回學堂看「隔日沖分點與次日反向賣超樣本」。若你其實想看的是當日量價排行，去選股頁，不要在隔日沖頁硬找買進理由。兩頁都只給客觀資料，都不是叫你下單。\"}]]]}]\n1b:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"符合率百分之百是不是穩？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"沒有這種讀法。還要看樣本次數、資料區間與流動性。次數很少的百分之百，只是樣本不夠。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"為什麼有的列寫樣本偏少？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"樣本次數少於八次會標出來。頁面的意思是這筆統計比較不穩，不是叫你把握稀有機會。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"這頁會不會叫我隔日沖？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"不會。它只整理歷史上分點買超後次日反向賣超的樣本。名稱有隔日沖，用途是研究，不是叫你做。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"會員看得到進出點嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"看不到。會員看符合率、集中度、樣本數、分點名稱與日 K 結構參考。方向與精確點位不是會員欄位。\"}]]}]]}]]]}]\n1c:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"隔日沖頁給的是歷史樣本符合率、集中度與樣本次數。先看資料日與樣本夠不夠。它讓你看統計，不是叫你隔日沖。\"}]]]}]\n1d:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L17\",\"0-隔日沖頁\",{\"href\":\"/radar\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"隔日沖頁\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L17\",\"0-選股頁\",{\"href\":\"/radar\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"選股頁\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L17\",\"0-台股學堂\",{\"href\":\"/school\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"台股學堂\"}]]}],[\"$\",\"li\",\"3\",{\"children\":[[\"$\",\"$L17\",\"0-法遵與免責聲明\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"法遵與免責聲明\"}]]}]]}]]]}]\n13:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\nf:null\n1e:I[80622,[],\"IconMark\"]\n11:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"股市大佬隔日沖頁看什麼？3個數字怎麼讀｜股市大佬 TradeBoss\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"頁面名稱有「隔日沖」三個字，最容易被讀成操作課。實際標題是「隔日沖分點研究」，說明寫的是：整理當日籌碼較集中，且分點買超後次日出現反向賣超的歷史樣本。重點是資料日、符合比例與樣本數，不把歷史比例當成明日預測，更不是叫你去隔日沖。\"}],[\"$\",\"link\",\"2\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}],[\"$\",\"$L1e\",\"3\",{}]],\"error\":null,\"digest\":\"$undefined\"}\n16:\"$11:metadata\"\n"}