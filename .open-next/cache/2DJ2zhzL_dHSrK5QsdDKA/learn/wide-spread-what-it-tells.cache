tatic/chunks/app/learn/%5Bslug%5D/page-f7b99344f7e2ee16.js\"],\"\"]\nd:[\"$\",\"div\",null,{\"className\":\"LearnArticle_wrap__LIQ8G\",\"children\":[\"$\",\"article\",null,{\"className\":\"LearnArticle_article__2nBbk\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_meta__etj_G\",\"children\":[[\"$\",\"$L17\",null,{\"className\":\"LearnArticle_cat__GQMlg\",\"href\":\"/learn?c=orderbook\",\"children\":\"盤口掛單\"}],[\"$\",\"span\",null,{\"className\":\"LearnArticle_read__QEj6a\",\"children\":\"閱讀約 5 分鐘\"}]]}],[\"$\",\"h1\",null,{\"className\":\"LearnArticle_title__0_la8\",\"children\":\"盤口價差太大代表什麼？流動性薄的3個檢查\"}],[\"$\",\"details\",null,{\"className\":\"LearnArticle_toc__LcSAa\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"LearnArticle_tocSummary__YBddG\",\"children\":\"本文目錄\"}],[\"$\",\"ol\",null,{\"className\":\"LearnArticle_tocList__Rq_Lz\",\"children\":[[\"$\",\"li\",\"sec-1\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-1\",\"children\":\"一、價差量的是兩側最佳價有多遠\"}]}],[\"$\",\"li\",\"sec-2\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-2\",\"children\":\"二、太大，多半是薄，或現場暫時沒人願意靠近\"}]}],[\"$\",\"li\",\"sec-3\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-3\",\"children\":\"三、價差大的常見來源\"}]}],[\"$\",\"li\",\"sec-4\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-4\",\"children\":\"四、它告訴你貴，不告訴你對錯\"}]}],[\"$\",\"li\",\"sec-5\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-5\",\"children\":\"五、三個檢查，判斷今天的寬是不是異常\"}]}],[\"$\",\"li\",\"sec-6\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-6\",\"children\":\"常見問題 FAQ\"}]}],[\"$\",\"li\",\"sec-7\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-7\",\"children\":\"總結\"}]}],[\"$\",\"li\",\"sec-8\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-8\",\"children\":\"延伸閱讀\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"LearnArticle_body__6B7Mb\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_intro__ATV5c\",\"children\":\"有些股票的買賣價中間空一截，看起來像隨時要跳。跳的感覺來自價差：你現在立刻要買，得吃賣方的價；立刻要賣，得砸買方的價。中間空愈大，立刻成交的成本愈高。這通常先描述流動性薄或現場不確定，不是在預告一段行情。把價差太大讀成「要噴了」或「要崩了」，是把執行成本誤認成方向。\"}],[[\"$\",\"figure\",\"figure-0\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"中間缺口是價差；張數是意願，不是承諾151.542 張151.088 張150.5120 張150.095 張149.5160 張149.070 張賣方五檔買方五檔大單靠近就消失，多半沒打算成交\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"示意圖｜五檔掛單：上面是想賣的，下面是想買的，都能隨時撤（教學結構，不是某檔實盤）\"}]]}]],[\"$\",\"div\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"價差是立刻成交要付的來回成本\"}],[\"$\",\"li\",\"1\",{\"children\":\"太大通常先代表薄或不確定，不代表下一步方向\"}],[\"$\",\"li\",\"2\",{\"children\":\"先跟這檔自己平常的價差比，再決定今天算不算異常\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、價差量的是兩側最佳價有多遠\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"最佳買是目前願意排著買的最高價，最佳賣是願意排著賣的最低價。中間的距離就是價差。沒有人掛在中間時，下一筆主動成交必須跳到對邊。所以價差首先是執行問題：你有多急，就要跨多遠。它不是投票，也不是預測器。急的人付價差，不急的人掛著等，兩邊都在同一張表上。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"價差＝最佳賣減最佳買\"}],[\"$\",\"li\",\"1\",{\"children\":\"立刻成交通常要跨到對邊\"}],[\"$\",\"li\",\"2\",{\"children\":\"它先是成本，不是方向\"}]]}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、太大，多半是薄，或現場暫時沒人願意靠近\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"流動性厚的股票，價差常只剩最小跳動。價差突然拉寬，常見於：本來就少人交易、剛開盤或剛恢復交易、消息空窗雙方都不想先掛、或剛剛有一串成交把靠近的單吃光還沒人補。這些情況的共通點是：現在願意揭示的人變少。變少不等於後面一定大走，只等於現在走一步比較貴、也比較滑。\"}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、價差大的常見來源\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"同一種「中間空一截」，來源不同，你該緊張的點也不同。本來就薄的股票，價差大是日常，不該每天當成事件。本來很緊、今天突然拉開，比較值得問發生了什麼：是不是剛有大單掃過、是不是暫停後剛回來、是不是揭示更新跟不上。問完仍然不要自動接方向，只先調低你對成交價的期望。\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"價差長相\"}],[\"$\",\"th\",\"1\",{\"children\":\"容易讀成\"}],[\"$\",\"th\",\"2\",{\"children\":\"比較先問的\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"本來就常常很寬\"}],[\"$\",\"td\",\"1\",{\"children\":\"這檔很有機會\"}],[\"$\",\"td\",\"2\",{\"children\":\"日常就薄，執行成本高是常態\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"今天突然拉寬\"}],[\"$\",\"td\",\"1\",{\"children\":\"要變盤了\"}],[\"$\",\"td\",\"2\",{\"children\":\"靠近的單是不是剛被吃光\"}]]}],[\"$\",\"tr\",\"2\",{\"children\":[\"$L18\",\"$L19\",\"$L1a\"]}],\"$L1b\"]}]]}]}],\"$L1c\"]]}],\"$L1d\",\"$L1e\",\"$L1f\",\"$L20\",\"$L21\"],\"$L22\"]}]]}]}]\n18:[\"$\",\"td\",\"0\",{\"children\":\"開盤前幾分鐘很寬\"}]\n19:[\"$\",\"td\",\"1\",{\"children\":\"隔夜方向很明確\"}]\n1a:[\"$\",\"td\",\"2\",{\"children\":\"開盤初段本來就容易空\"}]\n1b:[\"$\",\"tr\",\"3\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"漲跌停附近變寬\"}],[\"$\",\"td\",\"1\",{\"children\":\"要打開了\"}],[\"$\",\"td\",\"2\",{\"children\":\"上限下限會讓一側暫時沒人掛\"}]]}]\n1c:[\"$\",\"figure\",\"2\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"!不等於要大漲!不等於要大跌!不等於現在該動作\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"價差大不等於\"}]]}]\n1d:[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、它告訴你貴，不告訴你對錯\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"價差大時，同一套在厚盤看起來很小的想法，實務上會貴很多：你進要跨、出也要跨，來回可能已經吃掉你以為的空間。這是胃納與成本問題，不是看對看錯的問題。很多人在薄盤上覺得自己判斷很好，帳戶卻走不出紙上的數字，差就差在這一段被忽略的距離。先承認距離，再談判斷。\"}],[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"先估來回要跨幾檔\"}],[\"$\",\"li\",\"1\",{\"children\":\"再問這檔平常一天走得動你的張數嗎\"}],[\"$\",\"li\",\"2\",{\"children\":\"最後才談你對價格的看法\"}]]}]]]}]\n1e:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、三個檢查，判斷今天的寬是不是異常\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"第一，跟這檔自己最近的價差比，不要跟權值股比。第二，對成交量：價差寬、量也極小，就是薄；價差寬、量卻爆，比較像剛被掃過、暫時沒人補。第三，看有沒有剛開盤、剛恢復或靠近漲跌停——機制會讓價差暫時失真。三個檢查用來決定「我該不該用厚盤的直覺看它」，不是用來決定方向。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"跟自己的平常價差比\"}],[\"$\",\"li\",\"1\",{\"children\":\"寬的同時量是瘦還是爆\"}],[\"$\",\"li\",\"2\",{\"children\":\"有沒有機制因素在干擾\"}]]}]]]}]\n1f:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"價差多少算太大？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"沒有全市場統一的檔數。先看這檔自己的最小跳動與平常價差。突然比自己平常寬很多，才值得標成異常。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"價差變窄是不是比較安全？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"變窄通常表示有人願意靠得比較近，執行成本下降。安全與否還要看深度與你的張數，窄不等於撐得住。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"能不能掛在中間？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"能不能成交取決於有沒有對手、以及規則允不允許。本文不教下單技巧，只提醒：中間空著，常常是因為暫時沒人願意先讓步。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"和委買委賣差哪裡不同？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"價差是價格距離，委買委賣差是兩邊張數不對稱。一個講多貴，一個講看起來誰比較厚。都可在一秒內變。\"}]]}]]}]]]}]\n20:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"價差太大通常先代表流動性薄或現場暫時沒人靠近，是執行成本，不是方向。跟自己比、對量、排除機制時段，再決定要不要用厚盤直覺。\"}]]]}]\n21:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L17\",\"0-五檔掛單四層讀法\",{\"href\":\"/learn/how-to-read-order-book-five-levels\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"五檔掛單四層讀法\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L17\",\"0-新手導覽\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"新手導覽\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L17\",\"0-台股學堂\",{\"href\":\"/school\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"台股學堂\"}]]}]]}]]]}]\n22:[\"$\",\"div\",null,{\"className\":\"LearnArticle_related__9qV55\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_relatedTitle__RXfrl\",\"children\":\"相關文章\"}],[[\"$\",\"$L17\",\"how-to-read-order-book-five-levels\",{\"href\":\"/learn/how-to-read-order-book-five-levels\",\"className\":\"LearnArticle_relatedLink__mibXe\",\"children\":\"五檔掛單四層讀法\"}]]]}]\n13:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\nf:null\n23:I[80622,[],\"IconMark\"]\n11:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"盤口價差太大代表什麼？流動性薄的3個檢查｜股市大佬 TradeBoss\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"有些股票的買賣價中間空一截，看起來像隨時要跳。跳的感覺來自價差：你現在立刻要買，得吃賣方的價；立刻要賣，得砸買方的價。中間空愈大，立刻成交的成本愈高。這通常先描述流動性薄或現場不確定，不是在預告一段行情。把價差太大讀成「要噴了」或「要崩了」，是把執行成本誤認成方向。\"}],[\"$\",\"link\",\"2\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}],[\"$\",\"$L23\",\"3\",{}]],\"error\":null,\"digest\":\"$undefined\"}\n16:\"$11:metadata\"\n"}