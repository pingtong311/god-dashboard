ren\":\"$L13\"}],[\"$\",\"meta\",null,{\"name\":\"next-size-adjust\",\"content\":\"\"}]],[\"$\",\"$L14\",null,{\"children\":[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$15\",null,{\"fallback\":null,\"children\":\"$L16\"}]}]}]]}]\n17:I[52619,[\"2619\",\"static/chunks/2619-04bc32f026a0d946.js\",\"6309\",\"static/chunks/app/learn/%5Bslug%5D/page-f7b99344f7e2ee16.js\"],\"\"]\nd:[\"$\",\"div\",null,{\"className\":\"LearnArticle_wrap__LIQ8G\",\"children\":[\"$\",\"article\",null,{\"className\":\"LearnArticle_article__2nBbk\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_meta__etj_G\",\"children\":[[\"$\",\"$L17\",null,{\"className\":\"LearnArticle_cat__GQMlg\",\"href\":\"/learn?c=platform\",\"children\":\"平台教學\"}],[\"$\",\"span\",null,{\"className\":\"LearnArticle_read__QEj6a\",\"children\":\"閱讀約 6 分鐘\"}]]}],[\"$\",\"h1\",null,{\"className\":\"LearnArticle_title__0_la8\",\"children\":\"股市大佬個股透視有什麼？籌碼、技術與法人三個區塊\"}],[\"$\",\"details\",null,{\"className\":\"LearnArticle_toc__LcSAa\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"LearnArticle_tocSummary__YBddG\",\"children\":\"本文目錄\"}],[\"$\",\"ol\",null,{\"className\":\"LearnArticle_tocList__Rq_Lz\",\"children\":[[\"$\",\"li\",\"sec-1\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-1\",\"children\":\"「個股透視」是什麼？幫你解讀複雜的籌碼數據\"}]}],[\"$\",\"li\",\"sec-2\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-2\",\"children\":\"籌碼集中度怎麼看？判斷主力是買是賣的關鍵指標\"}]}],[\"$\",\"li\",\"sec-3\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-3\",\"children\":\"分點進出藏玄機？追蹤特定券商的買賣行為\"}]}],[\"$\",\"li\",\"sec-4\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-4\",\"children\":\"結合技術指標，避免只看籌碼的盲點\"}]}],[\"$\",\"li\",\"sec-5\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-5\",\"children\":\"如何有效利用「個股透視」？3 步驟掌握籌碼動態\"}]}],[\"$\",\"li\",\"sec-6\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-6\",\"children\":\"常見問題 FAQ\"}]}],[\"$\",\"li\",\"sec-7\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-7\",\"children\":\"總結\"}]}],[\"$\",\"li\",\"sec-8\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-8\",\"children\":\"延伸閱讀\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"LearnArticle_body__6B7Mb\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_intro__ATV5c\",\"children\":\"每次打開個股頁面，看到一堆券商分點進出數字就頭大？想知道這檔股票的籌碼到底流向何方、是誰在買賣，卻不知道從何看起？股市大佬的『個股透視』功能，正是為了解決這個困擾而生，讓你看懂數字背後的意義。\"}],[],[\"$\",\"div\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"個股透視提供籌碼、分點與技術面分析。\"}],[\"$\",\"li\",\"1\",{\"children\":\"了解主力進出，判斷籌碼集中度變化。\"}],[\"$\",\"li\",\"2\",{\"children\":\"從分點數據，辨識特定券商買賣行為。\"}],[\"$\",\"li\",\"3\",{\"children\":\"結合技術指標，輔助判斷股價趨勢。\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"「個股透視」是什麼？幫你解讀複雜的籌碼數據\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"許多散戶朋友在觀察個股時，常常只專注在 K 線圖和均線，卻忽略了背後更深層的籌碼變化。這些籌碼數據就像是市場的足跡，記錄著大戶與散戶的進出痕跡，如果能看懂，就能對股價的潛在動能有更全面的理解。股市大佬的「個股透視」功能，正是將這些看似複雜的公開資訊，整理成易於理解的圖表與指標，幫助你一眼看穿個股的籌碼動態。\"}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"籌碼集中度怎麼看？判斷主力是買是賣的關鍵指標\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"籌碼集中度是觀察一檔股票主力動向的重要指標。它計算的是特定時間內，前幾大券商分點（通常是前 5、10、20 或 40 大）買賣超佔總成交量的比例。當集中度持續上升，代表大戶或特定法人正在默默吃貨，籌碼逐漸集中到少數人手中；反之，若集中度下降，則可能代表主力正在出貨，籌碼變得分散。例如，假設某檔股票過去五天，前五大分點總買超 1000 張，這五天總成交量是 5000 張，那麼五日籌碼集中度就是 20% (1000 / 5000)。這表示近期的買盤主要來自這些大戶。\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"籌碼集中度\"}],[\"$\",\"th\",\"1\",{\"children\":\"意義\"}],[\"$\",\"th\",\"2\",{\"children\":\"可能影響\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"高集中度\"}],[\"$\",\"td\",\"1\",{\"children\":\"大戶或法人持續買進，籌碼流向少數人\"}],[\"$\",\"td\",\"2\",{\"children\":\"股價有潛在上漲動能，但需防範出貨\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"低集中度\"}],[\"$\",\"td\",\"1\",{\"children\":\"大戶或法人持續賣出，籌碼分散到散戶\"}],[\"$\",\"td\",\"2\",{\"children\":\"股價上漲動能趨緩，可能面臨賣壓\"}]]}]]}]]}]}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"分點進出藏玄機？追蹤特定券商的買賣行為\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"光看籌碼集中度還不夠，有時候我們會想知道，到底是哪些「特定的」券商分點在大量買賣？「個股透視」的分點進出功能，就能讓你看到每日、每週或每月，各個券商分點的買超或賣超張數與金額。透過觀察特定分點的連續性動作，例如某個「隔日沖」分點的出現，或是有特定分點持續大量買入，有助於理解市場上不同資金的意圖。假設某檔股票昨日收盤價 100 元，某分點買超 500 張。這代表該分點投入了 500 * 100 * 1000 = 50,000,000 元。如果這個分點過去一週都呈現買超，且買超金額持續增加，就值得進一步觀察。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"觀察連續性買賣超行為\"}],[\"$\",\"li\",\"1\",{\"children\":\"留意買賣超金額與張數\"}],[\"$\",\"li\",\"2\",{\"children\":\"辨識特定類型分點（如隔日沖）\"}]]}],[\"$\",\"figure\",\"2\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[\"$L18\",\"$L19\"]}]]]}],\"$L1a\",\"$L1b\",\"$L1c\",\"$L1d\",\"$L1e\"],null]}]]}]}]\n18:[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"!單看集中度!忽略技術面!盲目追蹤單一分點!將歷史數據當預測\"}]\n19:[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"判斷籌碼的常見誤區\"}]\n1a:[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"結合技術指標，避免只看籌碼的盲點\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"籌碼分析固然重要，但若單獨使用，有時會陷入盲點。股市大佬的「個股透視」會整合多種常見的技術指標，例如 K 線、均線、RSI（相對強弱指標）和 MACD（平滑異同移動平均線），讓你在查看籌碼數據的同時，也能掌握股價的趨勢、動能與超買超賣狀況。例如，如上圖所示，RSI 指標若進入 80 以上的超買區，即便籌碼集中度仍高，也可能暗示短線有拉回整理的壓力。反之，若 RSI 在 20 以下的超賣區，籌碼集中度又開始回升，則可能代表有機會止跌。\"}]]]}]\n1b:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"如何有效利用「個股透視」？3 步驟掌握籌碼動態\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"要有效利用「個股透視」功能，建議從宏觀到微觀，逐步拆解個股資訊。首先，觀察整體籌碼集中度的變化趨勢，判斷大戶資金的進出方向；接著，深入檢視特定分點的買賣超狀況，找出可能的主力或隔日沖券商；最後，結合技術指標來驗證籌碼訊號，避免單一指標的誤判。這樣的綜合分析能幫助你更全面地理解市場。\"}],[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"觀察籌碼集中度趨勢\"}],[\"$\",\"li\",\"1\",{\"children\":\"檢視特定分點買賣超\"}],[\"$\",\"li\",\"2\",{\"children\":\"結合技術指標綜合判斷\"}]]}]]]}]\n1c:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"籌碼集中度越高越好嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"不一定。集中度高可能代表主力吃貨，但也可能是出貨前的拉抬。需搭配股價走勢、技術面及其他資訊綜合判斷。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"怎麼知道哪些分點是主力？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"通常會觀察連續幾天大量買賣、且買賣超金額較大的分點。但需注意，主力也可能分散在多個分點操作。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"「個股透視」的資料是即時的嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"股市大佬的籌碼數據主要為盤後資料，提供每日收盤後的統計分析。盤中即時行情提供登入會員使用。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"散戶看「個股透視」有什麼用？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"幫助散戶理解大戶資金流向，避免盲目追高殺低，提升對市場的洞察力，做出更理性的判斷。\"}]]}]]}]]]}]\n1d:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"「個股透視」功能透過整合籌碼集中度、分點進出與技術指標，幫助你從不同角度理解個股的市場動態。記住，沒有單一指標能保證獲利，綜合判斷才是解讀股市資訊的關鍵。\"}]]]}]\n1e:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L17\",\"0-深入學習籌碼分析\",{\"href\":\"/school\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"深入學習籌碼分析\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L17\",\"0-查看更多台股教學\",{\"href\":\"/learn\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"查看更多台股教學專欄\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L17\",\"0-立即體驗個股透視\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"立即體驗個股透視功能\"}]]}]]}]]]}]\n13:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\nf:null\n1f:I[80622,[],\"IconMark\"]\n11:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"股市大佬個股透視有什麼？籌碼、技術與法人三個區塊｜股市大佬 TradeBoss\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"每次打開個股頁面，看到一堆券商分點進出數字就頭大？想知道這檔股票的籌碼到底流向何方、是誰在買賣，卻不知道從何看起？股市大佬的『個股透視』功能，正是為了解決這個困擾而生，讓你看懂數字背後的意義。\"}],[\"$\",\"link\",\"2\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}],[\"$\",\"$L1f\",\"3\",{}]],\"error\":null,\"digest\":\"$undefined\"}\n16:\"$11:metadata\"\n"}