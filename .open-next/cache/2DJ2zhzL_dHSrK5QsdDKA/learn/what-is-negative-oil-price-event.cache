,\"children\":[[\"$\",\"$L17\",null,{\"className\":\"LearnArticle_cat__GQMlg\",\"href\":\"/learn?c=events\",\"children\":\"金融大事件\"}],[\"$\",\"span\",null,{\"className\":\"LearnArticle_read__QEj6a\",\"children\":\"閱讀約 7 分鐘\"}]]}],[\"$\",\"h1\",null,{\"className\":\"LearnArticle_title__0_la8\",\"children\":\"為什麼油價會變負的？3 個關鍵看懂負油價事件，散戶別碰這種期貨\"}],[\"$\",\"details\",null,{\"className\":\"LearnArticle_toc__LcSAa\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"LearnArticle_tocSummary__YBddG\",\"children\":\"本文目錄\"}],[\"$\",\"ol\",null,{\"className\":\"LearnArticle_tocList__Rq_Lz\",\"children\":[[\"$\",\"li\",\"sec-1\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-1\",\"children\":\"一、油價變負的？我加油怎麼還是要付錢？\"}]}],[\"$\",\"li\",\"sec-2\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-2\",\"children\":\"二、什麼是「期貨」？為什麼它跟股票不一樣？\"}]}],[\"$\",\"li\",\"sec-3\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-3\",\"children\":\"三、關鍵魔鬼：什麼是「實物交割」與「現金交割」？\"}]}],[\"$\",\"li\",\"sec-4\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-4\",\"children\":\"四、負油價事件解析：3 個因素疊加的完美風暴\"}]}],[\"$\",\"li\",\"sec-5\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-5\",\"children\":\"五、散戶如何自保？從負油價學到的 3 個教訓\"}]}],[\"$\",\"li\",\"sec-6\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-6\",\"children\":\"常見問題 FAQ\"}]}],[\"$\",\"li\",\"sec-7\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-7\",\"children\":\"總結\"}]}],[\"$\",\"li\",\"sec-8\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-8\",\"children\":\"延伸閱讀\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"LearnArticle_body__6B7Mb\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_intro__ATV5c\",\"children\":\"2020 年，很多人第一次聽到油價竟然會變負數，買油不但不用錢，賣家還要付錢請你把油運走？這聽起來完全違反常理，但它確實發生了。這篇文章會用白話文解釋，為什麼會出現這種怪事，以及它對我們投資台股有什麼啟示。\"}],[],[\"$\",\"div\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"負油價只發生在「特定期貨合約」，不是加油站的汽油價格變負的。\"}],[\"$\",\"li\",\"1\",{\"children\":\"關鍵原因是「實物交割」的壓力，儲油槽滿了，沒人能收貨。\"}],[\"$\",\"li\",\"2\",{\"children\":\"散戶投資人應避開需要實物交割的商品期貨，以免陷入流動性陷阱。\"}],[\"$\",\"li\",\"3\",{\"children\":\"這件事提醒我們，投資前必須了解商品規則，不只看價格漲跌。\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、油價變負的？我加油怎麼還是要付錢？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"首先要釐清一個常見誤解：負油價不代表你去加油站加油，站務員會給你錢。當時出現負數的，是美國「西德州輕原油（WTI）」的某個月份「期貨合約」價格，而不是我們日常接觸的汽油現貨價。這兩者天差地遠，一個是給煉油廠這種大戶交易、約定未來某個時間點交貨的「契約」，另一個才是你我實際購買的商品。\"}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、什麼是「期貨」？為什麼它跟股票不一樣？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"想搞懂負油價，得先知道什麼是「期貨」。買股票，你買的是一間公司的「所有權」；而買期貨，你買的是一張「未來合約」。這張合約規定，你必須在未來的某個指定日期，用約定好的價格，買進（或賣出）特定數量的商品，例如黃豆、玉米或原油。這個「到期履約」的動作，就叫做「交割」。股票除非公司倒閉，可以一直放著，但期貨合約一定有到期日，時間到了就得解決。\"}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、關鍵魔鬼：什麼是「實物交割」與「現金交割」？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"期貨的交割方式是整個事件的核心，主要分成兩種。一種是「現金交割」，到期時不用真的拿出商品，只要把帳面上的虧損或獲利，用現金結算掉就好，像台指期貨就是這樣。另一種是「實物交割」，到期時，賣方真的要拿出貨物，買方也真的要把貨物收下。負油價事件的主角 WTI 原油期貨，就是採實物交割。\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"特性\"}],[\"$\",\"th\",\"1\",{\"children\":\"實物交割 (Physical Settlement)\"}],[\"$\",\"th\",\"2\",{\"children\":\"現金交割 (Cash Settlement)\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"結算方式\"}],[\"$\",\"td\",\"1\",{\"children\":\"買方需實際收貨，賣方需實際出貨\"}],[\"$\",\"td\",\"2\",{\"children\":\"依結算價計算損益，直接轉帳\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"適合對象\"}],[\"$\",\"td\",\"1\",{\"children\":\"實際有原物料需求的廠商（如煉油廠）\"}],[\"$\",\"td\",\"2\",{\"children\":\"金融操作、避險為主的投資人\"}]]}],[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"散戶風險\"}],[\"$\",\"td\",\"1\",{\"children\":\"可能面臨無處儲放、運輸成本暴增的窘境\"}],[\"$\",\"td\",\"2\",{\"children\":\"風險相對單純，只有帳面損益\"}]]}],[\"$\",\"tr\",\"3\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"常見商品\"}],[\"$\",\"td\",\"1\",{\"children\":\"西德州輕原油 (WTI) 期貨、黃豆、玉米\"}],[\"$\",\"td\",\"2\",{\"children\":\"台指期貨、小道瓊期貨、布蘭特原油期貨\"}]]}]]}]]}]}],[\"$\",\"figure\",\"2\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[\"$L18\",\"$L19\"]}]]]}],\"$L1a\",\"$L1b\",\"$L1c\",\"$L1d\",\"$L1e\"],null]}]]}]}]\n18:[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"✓不碰不懂的商品✓詳閱商品公開說明書✓了解背後的結算規則\"}]\n19:[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"散戶投資自保清單\"}]\n1a:[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、負油價事件解析：3 個因素疊加的完美風暴\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"了解背景後，我們來還原當時發生了什麼事。這是一場由三個因素共同引發的市場混亂：\"}],[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"疫情衝擊需求：2020 年初全球因疫情大規模封城，工廠停工、飛機停飛、汽車停駛，對原油的需求瞬間降到冰點。\"}],[\"$\",\"li\",\"1\",{\"children\":\"儲油空間爆滿：需求雖然急凍，但油田無法說關就關，產出的油沒地方去，導致全球的儲油槽、油輪全部塞爆。這時，「儲存空間」本身變得比油更有價值。\"}],[\"$\",\"li\",\"2\",{\"children\":\"期貨到期壓力：許多買進 WTI 期貨的交易者是金融機構或散戶，他們根本沒有儲油槽可以接收實體原油。眼看合約即將到期，若不平倉就得真的去領幾千桶油回來。在沒人能接手的情況下，他們只好恐慌性拋售，甚至願意「付錢」拜託別人把這燙手山芋般的合約買走，造成了-37美元/桶的荒謬價格。\"}]]}]]]}]\n1b:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、散戶如何自保？從負油價學到的 3 個教訓\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"這場海外的金融風暴，對我們台股投資人來說是很好的風險教育。多數人不會直接交易海外期貨，但可能會買到相關的 ETF 商品，若不注意，同樣會受傷。我們可以從中學到三件事：\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"不懂的商品不要碰：投資前，務必花時間了解商品背後的規則，特別是那些連結到海外期貨的 ETF，一定要看公開說明書，搞懂它是如何追蹤、如何換約的。\"}],[\"$\",\"li\",\"1\",{\"children\":\"注意隱藏的「轉倉成本」：許多原油 ETF 為了避免實物交割，會定期賣掉快到期的合約、買入下個月的合約，這個過程叫「轉倉」。如果下個月合約比較貴，長期下來會不斷侵蝕你的本金。\"}],[\"$\",\"li\",\"2\",{\"children\":\"專注在自己的能力圈：市場上總有各種熱門話題，但追逐熱點往往是虧損的開始。專注在自己熟悉且了解的投資領域，例如台股，才是相對穩健的做法。\"}]]}]]]}]\n1c:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"負油價事件後，我買的元大 S&P 原油正 2 ETF 怎麼了？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"當時這類槓桿型原油期貨 ETF 確實面臨巨大風險，金管會也介入示警。許多 ETF 不得不調整追蹤的期貨合約，或甚至面臨下市清算的危機，凸顯了這類商品的複雜性與高風險。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"現在還會再發生負油價嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"雖然機率不高，但在全球供需嚴重失衡、儲存設施飽和的極端情況下，理論上仍有可能。關鍵在於供需關係，以及期貨市場的結算機制是否能應對這種極端流動性問題。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"我想投資原油，除了期貨還有別的選擇嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"可以考慮投資能源公司的股票，例如煉油或石油開採公司的股票。這樣是投資「公司經營」，而非直接操作「原油價格」，風險屬性不同，也避開了期貨結算的複雜問題。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"「轉倉」是什麼意思？為什麼有成本？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"期貨合約有到期日。不想實物交割的 ETF，必須在合約到期前賣掉「近月」合約，買進「下個月」的合約，這個動作就叫「轉倉」。如果遠月合約比近月貴（正價差），每次轉倉都會買貴賣便宜，產生實質虧損，這就是轉倉成本。\"}]]}]]}]]]}]\n1d:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"總結來說，負油價事件的核心是「實物交割」的期貨規則，遇上儲存空間耗盡的極端市場。給散戶的啟示很簡單：千萬不要碰自己不懂的金融商品，特別是那些規則複雜的衍生品，專注在自己的能力圈才是長久之道。\"}]]]}]\n1e:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L17\",\"0-想學更多基礎知識\",{\"href\":\"/school\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"想學更多基礎知識？來台股學堂打好底子\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L17\",\"0-了解更多市場趨勢\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"了解更多市場趨勢，看看大盤總覽\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L17\",\"0-投資前必讀：我們\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"投資前必讀：我們的法遵與免責聲明\"}]]}]]}]]]}]\n13:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\nf:null\n1f:I[80622,[],\"IconMark\"]\n11:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"為什麼油價會變負的？3 個關鍵看懂負油價事件，散戶別碰這種期貨｜股市大佬 TradeBoss\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"2020 年，很多人第一次聽到油價竟然會變負數，買油不但不用錢，賣家還要付錢請你把油運走？這聽起來完全違反常理，但它確實發生了。這篇文章會用白話文解釋，為什麼會出現這種怪事，以及它對我們投資台股有什麼啟示。\"}],[\"$\",\"link\",\"2\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}],[\"$\",\"$L1f\",\"3\",{}]],\"error\":null,\"digest\":\"$undefined\"}\n16:\"$11:metadata\"\n"}