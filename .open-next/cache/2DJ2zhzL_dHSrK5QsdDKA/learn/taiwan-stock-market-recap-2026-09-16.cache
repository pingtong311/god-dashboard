"td\",\"0\",{\"children\":\"全市場融資維持率\"}],[\"$\",\"td\",\"1\",{\"children\":\"180.2%\"}]]}]]}]]}]}]]]}]\n1a:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、國際股市與市場消息：美股漲跌互見，亞洲股市表現相對強勁\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"國際股市方面，美股主要指數昨日呈現漲跌互見。S&P 500下跌0.45%，那斯達克下跌0.78%，費城半導體則上漲0.40%。亞洲股市今日表現相對強勁，韓國綜合指數（KOSPI）上漲1.37%，日經225指數上漲0.69%。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"大立光、華邦電、金像電、辛耘、精測、高力...這6檔皮繃緊？瑤池金母砍倉了981A、403A、406A...8大主動式E\"}],[\"$\",\"li\",\"1\",{\"children\":\"《通網股》台灣大出招搶果粉！iPhone 18 Pro最低0元、VIP再折5千\"}],[\"$\",\"li\",\"2\",{\"children\":\"健鼎伺服器/記憶體模組需求旺今年營收挑戰千億- 新聞\"}],[\"$\",\"li\",\"3\",{\"children\":\"健鼎伺服器/記憶體模組需求旺 今年營收挑戰千億\"}],[\"$\",\"li\",\"4\",{\"children\":\"健鼎(3044) 個股概覽 | 個股\"}],[\"$\",\"li\",\"5\",{\"children\":\"個股：健鼎(3044)受邀參加瑞銀證券9/16 2026 Taiwan Summit\"}]]}]]]}]\n1b:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"今天台股整體表現如何？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"2026年9月16日，台股加權指數收盤上漲0.74%，櫃買指數則大漲2.69%。上市股票有694家上漲，198家下跌，整體呈現漲多跌少的格局。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"哪些類股今天表現比較好？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"今日盤面上表現較強勢的類股包括光電業、半導體業、通信網路業和電子零組件業，這些族群的漲幅都超過2%。其中光電業由瑞軒領漲，半導體業由雍智科技領漲。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"外資今天在台股做了什麼？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"外資今日在現貨市場賣超約811,102張。在期貨市場，外資的台指期淨空單增加至76,351口。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"國際股市對台股有影響嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"今日美股主要指數呈現漲跌互見，S&P 500和那斯達克下跌，費城半導體上漲。亞洲股市則表現相對強勁，韓國綜合指數和日經225指數均有上漲，這些國際盤勢與台股的表現同時發生。\"}]]}]]}]]]}]\n1c:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"2026年9月16日台股在電子類股帶動下，加權指數小幅收漲，櫃買指數表現更為強勁，但法人現貨賣超與期貨淨空單增加，顯示市場在樂觀情緒中仍存有謹慎。\"}]]]}]\n1d:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L17\",\"0-新手導覽\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"新手導覽\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L17\",\"0-台股學堂\",{\"href\":\"/school\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"台股學堂\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L17\",\"0-大盤總覽\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"大盤總覽\"}]]}],[\"$\",\"li\",\"3\",{\"children\":[[\"$\",\"$L17\",\"0-台股日報\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"台股日報\"}]]}]]}]]]}]\n13:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\nf:null\n1e:I[80622,[],\"IconMark\"]\n11:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"2026年9月16日台股盤後：加權小漲，櫃買指數表現強勁｜股市大佬 TradeBoss\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"2026年9月16日台股加權指數收在45848.9點，上漲0.74%。櫃買指數則表現更為強勁，收在399.21點，大漲2.69%，顯示中小型股今日受到較多關注。\"}],[\"$\",\"link\",\"2\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}],[\"$\",\"$L1e\",\"3\",{}]],\"error\":null,\"digest\":\"$undefined\"}\n16:\"$11:metadata\"\n"}