iv\\\",null,{\\\"className\\\":\\\"LearnArticle_wrap__LIQ8G\\\",\\\"children\\\":[\\\"$\\\",\\\"article\\\",null,{\\\"className\\\":\\\"LearnArticle_article__2nBbk\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"LearnArticle_meta__etj_G\\\",\\\"children\\\":[[\\\"$\\\",\\\"$L18\\\",null,{\\\"className\\\":\\\"LearnArticle_cat__GQMlg\\\",\\\"href\\\":\\\"/learn?c=events\\\",\\\"children\\\":\\\"金融大事件\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"LearnArticle_read__QEj6a\\\",\\\"children\\\":\\\"閱讀約 6 分鐘\\\"}]]}],[\\\"$\\\",\\\"h1\\\",null,{\\\"className\\\":\\\"LearnArticle_title__0_la8\\\",\\\"children\\\":\\\"瑞士信貸事件的教訓：為何百年銀行也會倒？散戶該學到的 3 個避險觀念\\\"}],[\\\"$\\\",\\\"details\\\",null,{\\\"className\\\":\\\"LearnArticle_toc__LcSAa\\\",\\\"children\\\":[[\\\"$\\\",\\\"summary\\\",null,{\\\"className\\\":\\\"LearnArticle_tocSummary__YBddG\\\",\\\"children\\\":\\\"本文目錄\\\"}],[\\\"$\\\",\\\"ol\\\",null,{\\\"className\\\":\\\"LearnArticle_tocList__Rq_Lz\\\",\\\"children\\\":[[\\\"$\\\",\\\"li\\\",\\\"sec-1\\\",{\\\"children\\\":[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"#sec-1\\\",\\\"children\\\":\\\"一、第一個教訓：拋開「大到不能倒」的迷思\\\"}]}],[\\\"$\\\",\\\"li\\\",\\\"sec-2\\\",{\\\"children\\\":[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"#sec-2\\\",\\\"children\\\":\\\"二、第二個警訊：看懂財報裡的「未實現虧損」\\\"}]}],[\\\"$\\\",\\\"li\\\",\\\"sec-3\\\",{\\\"children\\\":[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"#sec-3\\\",\\\"children\\\":\\\"三、第三個防禦：你的分散，是真的分散嗎？\\\"}]}],[\\\"$\\\",\\\"li\\\",\\\"sec-4\\\",{\\\"children\\\":[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"#sec-4\\\",\\\"children\\\":\\\"四、什麼是 AT1 債券？為何會一夕歸零？\\\"}]}],[\\\"$\\\",\\\"li\\\",\\\"sec-5\\\",{\\\"children\\\":[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"#sec-5\\\",\\\"children\\\":\\\"五、黑天鵝來襲時，散戶的應對清單\\\"}]}],[\\\"$\\\",\\\"li\\\",\\\"sec-6\\\",{\\\"children\\\":[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"#sec-6\\\",\\\"children\\\":\\\"常見問題 FAQ\\\"}]}],[\\\"$\\\",\\\"li\\\",\\\"sec-7\\\",{\\\"children\\\":[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"#sec-7\\\",\\\"children\\\":\\\"總結\\\"}]}],[\\\"$\\\",\\\"li\\\",\\\"sec-8\\\",{\\\"children\\\":[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"#sec-8\\\",\\\"children\\\":\\\"延伸閱讀\\\"}]}]]}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"LearnArticle_body__6B7Mb\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"LearnArticle_intro__ATV5c\\\",\\\"children\\\":\\\"看到瑞士信貸這種百年招牌一夕崩塌，擔心手上的金融股嗎？本文從瑞信事件整理出 3 個散戶用得上的檢查方法，學會看懂財報警訊與做好資產分散，保護你的血汗錢。\\\"}],[],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"LearnArticle_tldr__Br5BY\\\",\\\"children\\\":[[\\\"$\\\",\\\"b\\\",null,{\\\"className\\\":\\\"LearnArticle_tldrTitle__K5PBN\\\",\\\"children\\\":\\\"本文重點\\\"}],[\\\"$\\\",\\\"ul\\\",null,{\\\"className\\\":\\\"LearnArticle_tldrList__VSc2_\\\",\\\"children\\\":[[\\\"$\\\",\\\"li\\\",\\\"0\\\",{\\\"children\\\":\\\"拋開「大到不能倒」的迷思，任何公司都有風險，規模不再是絕對的保證。\\\"}],[\\\"$\\\",\\\"li\\\",\\\"1\\\",{\\\"children\\\":\\\"學習看懂財報中的「未實現虧損」，這是評估金融機構受利率衝擊的關鍵指標。\\\"}],[\\\"$\\\",\\\"li\\\",\\\"2\\\",{\\\"children\\\":\\\"真正的分散是「跨產業」配置，只買不同家的金融股，風險依然非常集中。\\\"}],[\\\"$\\\",\\\"li\\\",\\\"3\\\",{\\\"children\\\":\\\"恐慌發生時，不要只看股價，應回頭檢視公司的體質與現金流是否依然健康。\\\"}]]}]]}],[[\\\"$\\\",\\\"section\\\",\\\"sec-1\\\",{\\\"id\\\":\\\"sec-1\\\",\\\"className\\\":\\\"LearnArticle_section__hLVjU\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"LearnArticle_h2__NmJ08\\\",\\\"children\\\":\\\"一、第一個教訓：拋開「大到不能倒」的迷思\\\"}],[[\\\"$\\\",\\\"p\\\",\\\"0\\\",{\\\"className\\\":\\\"LearnArticle_p__aZlQ1\\\",\\\"children\\\":\\\"很多人認為，買進像銀行、電信這種規模龐大、歷史悠久的公司就絕對安全。但瑞士信貸的例子告訴我們，即使是富可敵國的百年機構，在錯誤的風險管理與急遽變化的市場環境下，也可能快速殞落。散戶投資人不該再把「公司規模」當成唯一的護身符，而是要建立「任何投資都有風險」的基本觀念，這才是保護自己的第一步。\\\"}]]]}],[\\\"$\\\",\\\"section\\\",\\\"sec-2\\\",{\\\"id\\\":\\\"sec-2\\\",\\\"className\\\":\\\"LearnArticle_section__hLVjU\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"LearnArticle_h2__NmJ08\\\",\\\"children\\\":\\\"二、第二個警訊：看懂財報裡的「未實現虧損」\\\"}],[[\\\"$\\\",\\\"p\\\",\\\"0\\\",{\\\"className\\\":\\\"LearnArticle_p__aZlQ1\\\",\\\"children\\\":\\\"升息環境對金融業的衝擊，很多都藏在財報的「其他綜合損益（OCI）」項目裡。簡單說，銀行會持有大量債券，升息會導致舊債券的市場價值下跌，這些帳面上的虧損就是「未實現虧損」。如果這個數字持續擴大，代表公司的資產正在縮水，一旦需要現金而被迫賣出債券，虧損就會實現。一個判斷門檻是：當未實現虧損大到足以侵蝕掉大部分的股東權益時，就是一個非常危險的訊號。\\\"}],[\\\"$\\\",\\\"ol\\\",\\\"1\\\",{\\\"className\\\":\\\"LearnArticle_listNum__86N5S\\\",\\\"children\\\":[[\\\"$\\\",\\\"li\\\",\\\"0\\\",{\\\"children\\\":\\\"打開財報，找到資產負債表。\\\"}],[\\\"$\\\",\\\"li\\\",\\\"1\\\",{\\\"children\\\":\\\"查看「權益」項目下的「其他綜合損益」或類似科目。\\\"}],[\\\"$\\\",\\\"li\\\",\\\"2\\\",{\\\"children\\\":\\\"比較這個負數和「股本」、「資本公積」的相對大小，感受衝擊程度。\\\"}]]}]]]}],[\\\"$\\\",\\\"section\\\",\\\"sec-3\\\",{\\\"id\\\":\\\"sec-3\\\",\\\"className\\\":\\\"LearnArticle_section__hLVjU\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"LearnArticle_h2__NmJ08\\\",\\\"children\\\":\\\"三、第三個防禦：你的分散，是真的分散嗎？\\\"}],[[\\\"$\\\",\\\"p\\\",\\\"0\\\",{\\\"className\\\":\\\"LearnArticle_p__aZlQ1\\\",\\\"children\\\":\\\"許多人以為自己買了 A 銀行、B 金控、C 壽險，就是做好了分散。但從瑞士信貸事件來看，當整個金融產業面臨系統性風險時，這些股票往往會一起下跌，這屬於「假性分散」。真正的分散投資，應該是跨足到完全不同的產業，例如一部分資金在金融，一部分在科技、傳產或民生消費。這樣當單一產業出狀況時，其他部位才能發揮保護作用。\\\"}],[\\\"$\\\",\\\"div\\\",\\\"1\\\",{\\\"className\\\":\\\"LearnArticle_tblScroll__z9kbb\\\",\\\"children\\\":[\\\"$\\\",\\\"table\\\",null,{\\\"className\\\":\\\"LearnArticle_tbl__0yNgv\\\",\\\"children\\\":[[\\\"$\\\",\\\"thead\\\",null,{\\\"children\\\":[\\\"$\\\",\\\"tr\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"th\\\",\\\"0\\\",{\\\"children\\\":\\\"特性\\\"}],[\\\"$\\\",\\\"th\\\",\\\"1\\\",{\\\"children\\\":\\\"集中金融股的投資組合\\\"}],[\\\"$\\\",\\\"th\\\",\\\"2\\\",{\\\"children\\\":\\\"跨產業分散的投資組合\\\"}]]}]}],[\\\"$\\\",\\\"tbody\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"tr\\\",\\\"0\\\",{\\\"children\\\":[[\\\"$\\\",\\\"td\\\",\\\"0\\\",{\\\"children\\\":\\\"風險集中度\\\"}],[\\\"$\\\",\\\"td\\\",\\\"1\\\",{\\\"children\\\":\\\"極高，同漲同跌\\\"}],[\\\"$\\\",\\\"td\\\",\\\"2\\\",{\\\"children\\\":\\\"較低，不同產業景氣循環不同\\\"}]]}],[\\\"$\\\",\\\"tr\\\",\\\"1\\\",{\\\"children\\\":[[\\\"$\\\",\\\"td\\\",\\\"0\\\",{\\\"children\\\":\\\"系統性風險衝擊\\\"}],[\\\"$\\\",\\\"td\\\",\\\"1\\\",{\\\"children\\\":\\\"巨大，可能損失超過 50%\\\"}],[\\\"$\\\",\\\"td\\\",\\\"2\\\",{\\\"children\\\":\\\"較小，非關聯產業可望成為避風港\\\"}]]}],[\\\"$\\\",\\\"tr\\\",\\\"2\\\",{\\\"children\\\":[[\\\"$\\\",\\\"td\\\",\\\"0\\\",{\\\"children\\\":\\\"恐慌時的決策\\\"}],[\\\"$\\\",\\\"td\\\",\\\"1\\\",{\\\"children\\\":\\\"容易因單一產業崩跌而拋售\\\"}],[\\\"$\\\",\\\"td\\\",\\\"2\\\",{\\\"children\\\":\\\"情緒較穩定，可分開評估各產業狀況\\\"}]]}],\\\"$L19\\\"]}]]}]}],\\\"$L1a\\\"]]}],\\\"$L1b\\\",\\\"$L1c\\\",\\\"$L1d\\\",\\\"$L1e\\\",\\\"$L1f\\\"],null]}]]}]}]\\n\"])</script><script>self.__next_f.push([1,\"19:[\\\"$\\\",\\\"tr\\\",\\\"3\\\",{\\\"children\\\":[[\\\"$\\\",\\\"td\\\",\\\"0\\\",{\\\"children\\\":\\\"長期恢復力\\\"}],[\\\"$\\\",\\\"td\\\",\\\"1\\\",{\\\"children\\\":\\\"視金融業復甦速度，可能很慢\\\"}],[\\\"$\\\",\\\"td\\\",\\\"2\\\",{\\\"children\\\":\\\"較快，不同產業輪動復甦機會高\\\"}]]}]\\n1a:[\\\"$\\\",\\\"figure\\\",\\\"2\\\",{\\\"className\\\":\\\"LearnArticle_fig__uoT7r\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"LearnArticle_figFrame__jJ7E4\\\",\\\"children\\\":\\\"✓檢視財報未實現虧損✓留意監管機構的發言✓資產配置是否過度集中\\\"}],[\\\"$\\\",\\\"figcaption\\\",null,{\\\"className\\\":\\\"LearnArticle_figCap__LnUbb\\\",\\\"children\\\":\\\"定期檢查你的持股體質\\\"}]]}]\\n1b:[\\\"$\\\",\\\"section\\\",\\\"sec-4\\\",{\\\"id\\\":\\\"sec-4\\\",\\\"className\\\":\\\"LearnArticle_section__hLVjU\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"LearnArticle_h2__NmJ08\\\",\\\"children\\\":\\\"四、什麼是 AT1 債券？為何會一夕歸零？\\\"}],[[\\\"$\\\",\\\"p\\\",\\\"0\\\",{\\\"className\\\":\\\"LearnArticle_p__aZlQ1\\\",\\\"children\\\":\\\"這次事件中，很多 AT1 債券的投資人血本無歸，比股東還慘。AT1 是一種「應急可轉債」，你可以把它想像成銀行發行的一種特殊債券，利率比較高，但在銀行出大事時，它會被強制用來吸收虧損，甚至直接註銷變壁紙。這給我們的教訓是，不要只看產品宣傳的高利率，一定要搞懂背後的條款與風險。天下沒有白吃的午餐，超高報酬的背後，往往藏著你沒注意到的毀滅性條款。\\\"}]]]}]\\n\"])</script><script>self.__next_f.push([1,\"1c:[\\\"$\\\",\\\"section\\\",\\\"sec-5\\\",{\\\"id\\\":\\\"sec-5\\\",\\\"className\\\":\\\"LearnArticle_section__hLVjU\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"LearnArticle_h2__NmJ08\\\",\\\"children\\\":\\\"五、黑天鵝來襲時，散戶的應對清單\\\"}],[[\\\"$\\\",\\\"p\\\",\\\"0\\\",{\\\"className\\\":\\\"LearnArticle_p__aZlQ1\\\",\\\"children\\\":\\\"當市場出現像瑞信這樣的重大危機時，散戶最容易因為恐慌而做出錯誤決策。與其手忙腳亂地拋售持股，不如建立一套自己的應對流程。首先，深呼吸，不要在盤中憑感覺下單。其次，重新檢視你持股的基本面，這家公司倒閉的風險真的很高嗎？還是只是被市場情緒錯殺？最後，評估自己的資金狀況，是否使用過高的槓桿，需不需要降低部位以求安穩。有計畫的應對，遠比憑直覺亂砍來得好。\\\"}],[\\\"$\\\",\\\"ul\\\",\\\"1\\\",{\\\"className\\\":\\\"LearnArticle_listCheck__xx1CF\\\",\\\"children\\\":[[\\\"$\\\",\\\"li\\\",\\\"0\\\",{\\\"children\\\":\\\"避免在開盤或盤中恐慌時交易。\\\"}],[\\\"$\\\",\\\"li\\\",\\\"1\\\",{\\\"children\\\":\\\"重新審視持股的財報與現金流狀況。\\\"}],[\\\"$\\\",\\\"li\\\",\\\"2\\\",{\\\"children\\\":\\\"檢查自己的資金槓桿是否過高。\\\"}],[\\\"$\\\",\\\"li\\\",\\\"3\\\",{\\\"children\\\":\\\"若體質沒變，可考慮分批承接而非一次性動作。\\\"}]]}]]]}]\\n\"])</script><script>self.__next_f.push([1,\"1d:[\\\"$\\\",\\\"section\\\",\\\"sec-6\\\",{\\\"id\\\":\\\"sec-6\\\",\\\"className\\\":\\\"LearnArticle_section__hLVjU\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"LearnArticle_h2__NmJ08\\\",\\\"children\\\":\\\"常見問題 FAQ\\\"}],[[\\\"$\\\",\\\"div\\\",\\\"0\\\",{\\\"className\\\":\\\"LearnArticle_faq__cemBp\\\",\\\"children\\\":[[\\\"$\\\",\\\"details\\\",\\\"0\\\",{\\\"className\\\":\\\"LearnArticle_faqItem__I9h0U\\\",\\\"children\\\":[[\\\"$\\\",\\\"summary\\\",null,{\\\"children\\\":\\\"瑞信事件後，台灣的金融股還可以存嗎？\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"LearnArticle_faqA__IPuvc\\\",\\\"children\\\":\\\"台灣的金融監管相對嚴格，且體質與歐美銀行不盡相同。重點不是「能不能存」，而是你是否了解你存的這家公司，並做好資產配置。不論市場好壞，都不該將所有資金重壓在單一產業上。\\\"}]]}],[\\\"$\\\",\\\"details\\\",\\\"1\\\",{\\\"className\\\":\\\"LearnArticle_faqItem__I9h0U\\\",\\\"children\\\":[[\\\"$\\\",\\\"summary\\\",null,{\\\"children\\\":\\\"我要怎麼知道我的銀行會不會倒？\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"LearnArticle_faqA__IPuvc\\\",\\\"children\\\":\\\"一般散戶很難精準預測，但可以觀察幾項指標：例如銀行的資本適足率（BIS）、逾期放款比率，以及前面提到的財報未實現虧損。這些資訊都能在公開財報中找到，數字持續惡化就是警訊。\\\"}]]}],[\\\"$\\\",\\\"details\\\",\\\"2\\\",{\\\"className\\\":\\\"LearnArticle_faqItem__I9h0U\\\",\\\"children\\\":[[\\\"$\\\",\\\"summary\\\",null,{\\\"children\\\":\\\"什麼是信用違約交換（CDS）？聽說它是很好的預警指標？\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"LearnArticle_faqA__IPuvc\\\",\\\"children\\\":\\\"CDS 可以簡單理解成「公司債務的保險」。當市場認為一家公司倒債的風險變高，幫它買保險的費用（CDS 價格）就會飆升。它確實是專業機構用來衡量風險的指標，但數據取得對一般散戶較不便，因此先學會看懂財報更為實際。\\\"}]]}],[\\\"$\\\",\\\"details\\\",\\\"3\\\",{\\\"className\\\":\\\"LearnArticle_faqItem__I9h0U\\\",\\\"children\\\":[[\\\"$\\\",\\\"summary\\\",null,{\\\"children\\\":\\\"如果真的發生金融危機，我該怎麼辦？\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"LearnArticle_faqA__IPuvc\\\",\\\"children\\\":\\\"首先，確保你有足夠的緊急預備金，避免在市場低點被迫賣股變現。其次，重新檢視你的投資組合，汰弱留強，把資金集中在體質最好、最可能存活下來的公司。危機也是轉機，但前提是你得先活下來。\\\"}]]}]]}]]]}]\\n\"])</script><script>self.__next_f.push([1,\"1e:[\\\"$\\\",\\\"section\\\",\\\"sec-7\\\",{\\\"id\\\":\\\"sec-7\\\",\\\"className\\\":\\\"LearnArticle_section__hLVjU\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"LearnArticle_h2__NmJ08\\\",\\\"children\\\":\\\"總結\\\"}],[[\\\"$\\\",\\\"p\\\",\\\"0\\\",{\\\"className\\\":\\\"LearnArticle_p__aZlQ1\\\",\\\"children\\\":\\\"瑞士信貸事件提醒我們，沒有任何投資是絕對安全的。散戶最好的防禦，就是拋開「大到不能倒」的幻想，學會看懂財報警訊，並做好跨產業的資產分散，才能在市場的驚濤駭浪中站穩腳步。\\\"}]]]}]\\n1f:[\\\"$\\\",\\\"section\\\",\\\"sec-8\\\",{\\\"id\\\":\\\"sec-8\\\",\\\"className\\\":\\\"LearnArticle_section__hLVjU\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"LearnArticle_h2__NmJ08\\\",\\\"children\\\":\\\"延伸閱讀\\\"}],[[\\\"$\\\",\\\"ul\\\",\\\"0\\\",{\\\"className\\\":\\\"LearnArticle_list__WjxqC\\\",\\\"children\\\":[[\\\"$\\\",\\\"li\\\",\\\"0\\\",{\\\"children\\\":[[\\\"$\\\",\\\"$L18\\\",\\\"0-想學習更多財報名\\\",{\\\"href\\\":\\\"/school\\\",\\\"className\\\":\\\"LearnArticle_link__gMwHV\\\",\\\"children\\\":\\\"想學習更多財報名詞？來台股學堂打好基礎\\\"}]]}],[\\\"$\\\",\\\"li\\\",\\\"1\\\",{\\\"children\\\":[[\\\"$\\\",\\\"$L18\\\",\\\"0-不確定市場氣氛？\\\",{\\\"href\\\":\\\"/diary\\\",\\\"className\\\":\\\"LearnArticle_link__gMwHV\\\",\\\"children\\\":\\\"不確定市場氣氛？看看大盤總覽數據\\\"}]]}],[\\\"$\\\",\\\"li\\\",\\\"2\\\",{\\\"children\\\":[[\\\"$\\\",\\\"$L18\\\",\\\"0-更多給新手的教學\\\",{\\\"href\\\":\\\"/learn\\\",\\\"className\\\":\\\"LearnArticle_link__gMwHV\\\",\\\"children\\\":\\\"更多給新手的教學文章，都在這裡\\\"}]]}]]}]]]}]\\n\"])</script><script>self.__next_f.push([1,\"14:[[\\\"$\\\",\\\"meta\\\",\\\"0\\\",{\\\"charSet\\\":\\\"utf-8\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"1\\\",{\\\"name\\\":\\\"viewport\\\",\\\"content\\\":\\\"width=device-width, initial-scale=1\\\"}]]\\n10:null\\n\"])</script><script>self.__next_f.push([1,\"20:I[80622,[],\\\"IconMark\\\"]\\n12:{\\\"metadata\\\":[[\\\"$\\\",\\\"title\\\",\\\"0\\\",{\\\"children\\\":\\\"瑞士信貸事件的教訓：為何百年銀行也會倒？散戶該學到的 3 個避險觀念｜股市大佬 TradeBoss\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"1\\\",{\\\"name\\\":\\\"description\\\",\\\"content\\\":\\\"看到瑞士信貸這種百年招牌一夕崩塌，擔心手上的金融股嗎？本文從瑞信事件整理出 3 個散戶用得上的檢查方法，學會看懂財報警訊與做好資產分散，保護你的血汗錢。\\\"}],[\\\"$\\\",\\\"link\\\",\\\"2\\\",{\\\"rel\\\":\\\"icon\\\",\\\"href\\\":\\\"/favicon.ico\\\",\\\"type\\\":\\\"image/x-icon\\\",\\\"sizes\\\":\\\"16x16\\\"}],[\\\"$\\\",\\\"$L20\\\",\\\"3\\\",{}]],\\\"error\\\":null,\\\"digest\\\":\\\"$undefined\\\"}\\n\"])</script><script>self.__next_f.push([1,\"17:\\\"$12:metadata\\\"\\n\"])</script></body></html>","rsc":"1:\"$Sreact.fragment\"\n2:I[81259,[\"2619\",\"static/chunks/2619-04bc32f026a0d946.js\",\"7177\",\"static/chunks/app/layout-4382c12d510386d3.js\"],\"default\"]\n3:I[89379,[\"2619\",\"static/chunks/2619-04bc32f026a0d946.js\",\"7177\",\"static/chunks/app/layout-4382c12d510386d3.js\"],\"default\"]\n4:I[9766,[],\"\"]\n5:I[98924,[],\"\"]\n6:I[10021,[\"2619\",\"static/chunks/2619-04bc32f026a0d946.js\",\"7177\",\"static/chunks/app/layout-4382c12d510386d3.js\"],\"default\"]\n7:I[10528,[\"2619\",\"static/chunks/2619-04bc32f026a0d946.js\",\"7177\",\"static/chunks/a