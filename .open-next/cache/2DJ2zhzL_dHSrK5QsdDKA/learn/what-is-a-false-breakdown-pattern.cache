ldren\":[[\"$\",\"summary\",null,{\"className\":\"LearnArticle_tocSummary__YBddG\",\"children\":\"本文目錄\"}],[\"$\",\"ol\",null,{\"className\":\"LearnArticle_tocList__Rq_Lz\",\"children\":[[\"$\",\"li\",\"sec-1\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-1\",\"children\":\"一、什麼是「破底翻」？為什麼主力愛用這招？\"}]}],[\"$\",\"li\",\"sec-2\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-2\",\"children\":\"二、如何判斷是真的「破底翻」，還是「真的跌破了」？\"}]}],[\"$\",\"li\",\"sec-3\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-3\",\"children\":\"三、成交量怎麼看？一張比較表搞懂「真假跌破」\"}]}],[\"$\",\"li\",\"sec-4\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-4\",\"children\":\"四、一個常見錯誤：把「無力反彈」當成「強力回升」\"}]}],[\"$\",\"li\",\"sec-5\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-5\",\"children\":\"五、發現破底翻訊號後，下一步該怎麼思考？\"}]}],[\"$\",\"li\",\"sec-6\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-6\",\"children\":\"常見問題 FAQ\"}]}],[\"$\",\"li\",\"sec-7\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-7\",\"children\":\"總結\"}]}],[\"$\",\"li\",\"sec-8\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-8\",\"children\":\"延伸閱讀\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"LearnArticle_body__6B7Mb\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_intro__ATV5c\",\"children\":\"股價跌破支撐，你嚇得趕快賣掉，結果隔天就大漲，感覺被耍了嗎？這很可能就是主力刻意製造的「破底翻」。這篇文章就是要教你看懂這種常見手法，把危機變轉機。\"}],[[\"$\",\"figure\",\"figure-0\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"開／高／低／收實體＝開收之間；影線＝最高與最低紅 K 收漲綠 K 收跌十字線長紅長綠\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"示意圖｜日 K：紅漲綠跌，影線是當天曾走過的路（教學結構，不是某檔實盤）\"}]]}]],[\"$\",\"div\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"破底翻是股價「假跌破、真拉抬」，主力刻意製造恐慌洗盤。\"}],[\"$\",\"li\",\"1\",{\"children\":\"關鍵特徵：跌破支撐後1-3天內迅速站回，且站回時帶有成交量。\"}],[\"$\",\"li\",\"2\",{\"children\":\"不能只看K線，要搭配成交量與籌碼流向，確認是真拉抬而非一日行情。\"}],[\"$\",\"li\",\"3\",{\"children\":\"常見陷阱是把「真跌破」當成破底翻，導致在下跌趨勢中買進。\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、什麼是「破底翻」？為什麼主力愛用這招？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"「破底翻」顧名思義，就是「跌破」支撐之後，很快又「翻」回來。這是一種常見的技術型態，代表股價跌破一個重要的支撐價位後，不但沒有繼續下跌，反而在短時間內迅速漲回支撐之上，形成一個反轉或上漲持續的訊號。主力大戶之所以喜歡用這招，是為了製造市場恐慌，讓沒信心的投資人賣出手上持股，他們正好可以在相對低的位置吸納籌碼，這就是所謂的「洗盤」。\"}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、如何判斷是真的「破底翻」，還是「真的跌破了」？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"看到股價站回支撐，先別急著高興，因為也可能是曇花一現的反彈。一個比較可靠的破底翻型態，通常具備三個特徵。你可以把它當成一個檢查清單，三個都符合，訊號的可靠度就比較高。這個判斷方法，能幫你過濾掉很多看起來像、但其實很危險的狀況。\"}],[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"時間要快：股價跌破支撐後，通常在 1-3 個交易日內就要快速站回支撐線之上。如果拖了超過一週都還在支撐下掙扎，那很可能就是真的轉弱了。\"}],[\"$\",\"li\",\"1\",{\"children\":\"量要出來：跌破時成交量不一定，但「站回支撐」那一天的成交量，最好要明顯比前幾天大。這代表有買盤願意進場承接，是攻擊的訊號。\"}],[\"$\",\"li\",\"2\",{\"children\":\"K棒要強：站回支撐的K棒，最好是實體飽滿的紅K棒，收盤價明確地收在支撐價位之上，這顯示當天買方的力道非常強勁。\"}]]}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、成交量怎麼看？一張比較表搞懂「真假跌破」\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"成交量是觀察買賣力道最直接的證據。在判斷破底翻時，量能的變化比價格本身更重要。價漲量增，代表買氣真實；價漲量縮，就可能只是短暫反彈。下面的表格，幫你快速比較兩種情況下，成交量的關鍵差異。\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"狀況情境\"}],[\"$\",\"th\",\"1\",{\"children\":\"成交量變化\"}],[\"$\",\"th\",\"2\",{\"children\":\"後續走勢可能\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"成功的破底翻\"}],\"$L18\",\"$L19\"]}],\"$L1a\"]}]]}]}],\"$L1b\"]]}],\"$L1c\",\"$L1d\",\"$L1e\",\"$L1f\",\"$L20\"],null]}]]}]}]\n18:[\"$\",\"td\",\"1\",{\"children\":\"跌破時量縮或持平，但『站回支撐時帶量』，量能明顯放大。\"}]\n19:[\"$\",\"td\",\"2\",{\"children\":\"多方攻擊訊號，籌碼換手成功，後續上漲機率較高。\"}]\n1a:[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"失敗的真跌破\"}],[\"$\",\"td\",\"1\",{\"children\":\"跌破時就帶大量，反彈回測支撐線時『量能萎縮』。\"}],[\"$\",\"td\",\"2\",{\"children\":\"原本的支撐變成壓力，反彈無力，後續下跌機率較高。\"}]]}]\n1b:[\"$\",\"figure\",\"2\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"✓大盤趨勢是否偏多？✓站回K棒是實體紅K？✓籌碼有大人進場跡象？✓公司基本面有支撐？\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"檢查清單：這是真拉抬嗎？\"}]]}]\n1c:[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、一個常見錯誤：把「無力反彈」當成「強力回升」\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"很多投資人常犯的錯，就是看到股價從低點反彈個一兩天，就以為趨勢反轉了，急著進場。但破底翻的精髓，不只是「翻上來」，更重要的是「站得穩」。如果股價站回支撐後，隔兩天又跌回去，那通常只是下跌趨勢中的一個小反彈，原本的支撐已經變成了壓力。一個簡單的判斷方法是，站回支撐後，至少多觀察 2-3 天，看股價是否能穩定維持在支撐價位之上，這才是比較穩健的做法。\"}]]]}]\n1d:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、發現破底翻訊號後，下一步該怎麼思考？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"當你發現一個疑似破底翻的訊號時，可以把它當成一個觀察清單的起點，但還需要從更多角度來驗證。技術分析是提高勝率的工具，而不是預測未來的水晶球。結合不同面向的資訊，可以讓你的判斷更有依據，而不是單純賭一個型態。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"確認大盤趨勢：大盤在多頭時，個股破底翻的成功率較高。如果是空頭市場，很多破底翻最後都可能只是小反彈，要特別小心。\"}],[\"$\",\"li\",\"1\",{\"children\":\"檢視個股籌碼：你可以到「股市大佬」的個股透視頁面，看看站回支撐那天，買超券商是誰？是過去績效好的贏家分點，還是散戶居多的券商？這能幫你判斷買盤的品質。\"}],[\"$\",\"li\",\"2\",{\"children\":\"評估基本面：這家公司最近是否有好消息？營收獲利是否成長？有基本面支撐的破底翻，走得通常比較長遠。\"}]]}]]]}]\n1e:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"跌破後幾天內站回來才算數？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"一般市場共識是1-3個交易日。時間拖得越長，代表下方的賣壓越重，即使站回來，破底翻的力道也會減弱，後續動能可能不足。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"破底翻一定會發生在股價的最低點嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"不一定。它只是一個「相對低檔區」的反轉訊號，代表股價跌破某個市場心理關卡後出現強力買盤，但不保證那就是絕對的最低價。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"如果站回支撐那天是「上影線很長的紅K」，也算成功嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"要特別小心。很長的上影線代表當天買盤雖然一度推高股價，但收盤前又遇到不小的賣壓。這顯示多空仍在交戰，訊號不夠乾淨，建議多觀察幾天確認方向。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"什麼是「支撐線」？要怎麼畫？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"支撐線是連接過去股價多次回檔時的低點所形成的線。當股價跌到這條線附近，通常會吸引買盤進場，形成支撐。在「股市大佬」的台股學堂有更詳細的圖文解說。\"}]]}]]}]]]}]\n1f:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"總結來說，判斷破底翻的口訣是「快市收紅帶量」。股價要「快速」站回支撐、「收盤」要收在支撐之上（最好是紅K），而且站回當天要「帶有成交量」。符合這三點，才是比較可靠的訊號。\"}]]]}]\n20:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L17\",\"0-到「個股透視」頁\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"到「個股透視」頁面，觀察籌碼流向\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L17\",\"0-在台股學堂學習更\",{\"href\":\"/school\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"在台股學堂學習更多K線型態\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L17\",\"0-註冊股市大佬會員\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"註冊股市大佬會員，開始練習看懂籌碼\"}]]}]]}]]]}]\n13:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\nf:null\n21:I[80622,[],\"IconMark\"]\n11:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"破底翻是什麼？3步驟看懂假跌破真拉抬，避開主力洗盤陷阱｜股市大佬 TradeBoss\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"股價跌破支撐，你嚇得趕快賣掉，結果隔天就大漲，感覺被耍了嗎？這很可能就是主力刻意製造的「破底翻」。這篇文章就是要教你看懂這種常見手法，把危機變轉機。\"}],[\"$\",\"link\",\"2\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}],[\"$\",\"$L21\",\"3\",{}]],\"error\":null,\"digest\":\"$undefined\"}\n16:\"$11:metadata\"\n"}