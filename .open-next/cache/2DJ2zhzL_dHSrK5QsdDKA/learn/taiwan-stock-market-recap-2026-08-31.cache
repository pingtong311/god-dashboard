"$\\\",\\\"li\\\",\\\"0\\\",{\\\"children\\\":\\\"偏強族群：塑膠工業 (+2.10%)，金融保險 (+1.02%)，創新板股票 (+0.64%)，航運業 (+0.57%)。\\\"}],[\\\"$\\\",\\\"li\\\",\\\"1\\\",{\\\"children\\\":\\\"塑膠工業由南亞 (1303) 領漲，金融保險則由國泰金 (2882) 領漲。\\\"}],[\\\"$\\\",\\\"li\\\",\\\"2\\\",{\\\"children\\\":\\\"偏弱族群：綠能環保 (-1.28%)，電子零組件業 (-1.20%)，電機機械 (-1.04%)，半導體業 (-0.89%)。\\\"}]]}]]]}],[\\\"$\\\",\\\"section\\\",\\\"sec-3\\\",{\\\"id\\\":\\\"sec-3\\\",\\\"className\\\":\\\"LearnArticle_section__hLVjU\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"LearnArticle_h2__NmJ08\\\",\\\"children\\\":\\\"三、個股焦點觀察：塑化股漲勢顯著，電子股跌幅較深\\\"}],[[\\\"$\\\",\\\"p\\\",\\\"0\\\",{\\\"className\\\":\\\"LearnArticle_p__aZlQ1\\\",\\\"children\\\":\\\"今日上市漲幅榜上，塑膠工業的多檔個股表現強勁，成交量也相對放大，這是今天已發生的結果。相對地，部分電子權值股則出現較大跌幅，值得留意。當沖熱門股顯示部分個股交易量能相對活躍。\\\"}],[\\\"$\\\",\\\"ol\\\",\\\"1\\\",{\\\"className\\\":\\\"LearnArticle_listNum__86N5S\\\",\\\"children\\\":[[\\\"$\\\",\\\"li\\\",\\\"0\\\",{\\\"children\\\":\\\"上市漲幅榜：AMAX-KY (6933) +10.00%，南亞 (1303) +9.98%，台化 (1326) +9.98%，統懋 (2434) +9.93%，全新 (2455) +9.91%，國喬 (1312) +9.89%。\\\"}],\\\"$L18\\\",\\\"$L19\\\"]}],\\\"$L1a\\\"]]}],\\\"$L1b\\\",\\\"$L1c\\\",\\\"$L1d\\\",\\\"$L1e\\\",\\\"$L1f\\\"],null]}]]}]}]\\n\"])</script><script>self.__next_f.push([1,\"18:[\\\"$\\\",\\\"li\\\",\\\"1\\\",{\\\"children\\\":\\\"上市跌幅榜：欣興 (3037) -10.00%，吉祥全 (2491) -9.93%，矽力*-KY (6415) -9.93%，嘉基 (6715) -9.90%，景碩 (3189) -8.90%，直得 (1597) -8.88%。\\\"}]\\n19:[\\\"$\\\",\\\"li\\\",\\\"2\\\",{\\\"children\\\":\\\"當沖熱門（量比高）：國賓 (-2.09%) 量比 34.9x，臺企銀 (+3.04%) 量比 20.6x，台泥 (+0.41%) 量比 18.6x，仁新* (-89.82%) 量比 13.9x。\\\"}]\\n1a:[\\\"$\\\",\\\"figure\\\",\\\"2\\\",{\\\"className\\\":\\\"LearnArticle_fig__uoT7r\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"LearnArticle_figFrame__jJ7E4\\\",\\\"children\\\":\\\"!外資期貨空單!塑化股漲勢強!半導體走弱!融資維持率194.3%\\\"}],[\\\"$\\\",\\\"figcaption\\\",null,{\\\"className\\\":\\\"LearnArticle_figCap__LnUbb\\\",\\\"children\\\":\\\"值得留意\\\"}]]}]\\n\"])</script><s