ull,{\"className\":\"LearnArticle_tocSummary__YBddG\",\"children\":\"本文目錄\"}],[\"$\",\"ol\",null,{\"className\":\"LearnArticle_tocList__Rq_Lz\",\"children\":[[\"$\",\"li\",\"sec-1\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-1\",\"children\":\"一、我該用哪種當沖？先看你想「做多」還是「做空」\"}]}],[\"$\",\"li\",\"sec-2\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-2\",\"children\":\"二、兩種當沖的「開戶資格」和「額度」有什麼不一樣？\"}]}],[\"$\",\"li\",\"sec-3\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-3\",\"children\":\"三、交易成本算一算：手續費、證交稅、借券費差在哪？\"}]}],[\"$\",\"li\",\"sec-4\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-4\",\"children\":\"四、最大的風險：「強制回補」是什麼？為什麼資券當沖要小心？\"}]}],[\"$\",\"li\",\"sec-5\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-5\",\"children\":\"五、新手上路：我該從哪一種開始練習？\"}]}],[\"$\",\"li\",\"sec-6\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-6\",\"children\":\"常見問題 FAQ\"}]}],[\"$\",\"li\",\"sec-7\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-7\",\"children\":\"總結\"}]}],[\"$\",\"li\",\"sec-8\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-8\",\"children\":\"延伸閱讀\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"LearnArticle_body__6B7Mb\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_intro__ATV5c\",\"children\":\"在下單軟體看到「現股」和「資券」當沖選項，有點搞不清楚該用哪個嗎？選錯了不但交易成本變高，甚至可能要面對軋空風險。這篇文章用最白話的方式，一次幫你分清楚。\"}],[[\"$\",\"figure\",\"figure-0\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"虧 3 次每次 −1%賺 2 次每次 +1%勝率 40% 也可能是正期望，前提是賺的比虧的大、且扣得起成本短線先扣約 0.24% 當沖成本，再看還剩多少\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"示意圖｜期望值：勝率要配上平均賺賠，再扣成本（教學結構，不是某檔實盤）\"}]]}]],[\"$\",\"div\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"現股當沖只能「先買後賣」，資券當沖則「先買後賣」或「先賣後買」都可以。\"}],[\"$\",\"li\",\"1\",{\"children\":\"交易成本有差：現股當沖賣出時證交稅減半，資券當沖多了借券相關費用。\"}],[\"$\",\"li\",\"2\",{\"children\":\"資券當沖有「強制回補」規定，遇到股東會或除權息日前要特別注意。\"}],[\"$\",\"li\",\"3\",{\"children\":\"新手建議從規則單純、成本較低的「現股當沖」開始，熟悉日內交易節奏。\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、我該用哪種當沖？先看你想「做多」還是「做空」\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"最根本的差別，在於你對盤勢的看法。如果你覺得某檔股票今天會漲，想賺價差，兩種工具都能用。但如果你覺得它會跌，那就只有「資券當沖」能做到。簡單說，這是兩種工具在操作方向上最大的不同。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"看好會漲（做多）：用「現股當沖」先買後賣，或用「資券當沖」的融資買進、融券賣出。\"}],[\"$\",\"li\",\"1\",{\"children\":\"看壞會跌（做空）：只能用「資券當沖」的融券賣出、融資買進來完成。\"}],[\"$\",\"li\",\"2\",{\"children\":\"判斷方法：現股當沖是單向道，只能做多；資券當沖是雙向道，多空皆可。\"}]]}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、兩種當沖的「開戶資格」和「額度」有什麼不一樣？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"不是開了戶就能馬上當沖，你需要另外簽署文件。現股當沖的門檻較低，只要開戶滿三個月、有一定交易筆數就能申請。但要使用資券，門檻就高得多，通常券商會要求更長的交易經驗或財力證明，因為資券交易的槓桿和風險都比較大。\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"比較項目\"}],[\"$\",\"th\",\"1\",{\"children\":\"現股當沖\"}],[\"$\",\"th\",\"2\",{\"children\":\"資券當沖\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"開戶條件\"}],[\"$\",\"td\",\"1\",{\"children\":\"開戶滿 3 個月\"}],[\"$\",\"td\",\"2\",{\"children\":\"開戶滿 3 個月，需另開立信用戶\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"交易經驗\"}],[\"$\",\"td\",\"1\",{\"children\":\"最近 1 年內有 10 筆以上成交紀錄\"}],[\"$\",\"td\",\"2\",{\"children\":\"最近 1 年內有 10 筆以上成交紀錄\"}]]}],[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"財力證明\"}],[\"$\",\"td\",\"1\",{\"children\":\"通常不需\"}],[\"$\",\"td\",\"2\",{\"children\":\"需提供，門檻依各券商規定\"}]]}],[\"$\",\"tr\",\"3\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"交易額度\"}],[\"$\",\"td\",\"1\",{\"children\":\"依每日可交易額度\"}],[\"$\",\"td\",\"2\",{\"children\":\"依信用戶核定額度，與現股額度分開計算\"}]]}]]}]]}]}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[\"$L18\",[\"$L19\",\"$L1a\",\"$L1b\"]]}],\"$L1c\",\"$L1d\",\"$L1e\",\"$L1f\",\"$L20\"],null]}]]}]}]\n18:[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、交易成本算一算：手續費、證交稅、借券費差在哪？\"}]\n19:[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"魔鬼藏在細節裡，交易成本會直接影響你的獲利。現股當沖最大的好處是賣出時證交稅減半，長期下來能省下不少。資券當沖除了沒有稅率優惠，如果你是先賣後買（融券），還會多一筆「借券費」，讓你的獲利門檻變得更高。\"}]\n1a:[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"手續費：兩者買進和賣出時都要付，通常是成交金額的 0.1425%（可與券商洽談折扣）。\"}],[\"$\",\"li\",\"1\",{\"children\":\"證券交易稅：現股當沖賣出為 0.15%；資券當沖賣出為 0.3%，整整差一倍。\"}],[\"$\",\"li\",\"2\",{\"children\":\"其他費用：資券當沖的「融券賣出」會有借券費，費率因券商和個股而異；「融資買進」則有利息費用，但因當天就沖銷，通常可忽略不計。\"}],[\"$\",\"li\",\"3\",{\"children\":\"舉例試算：同樣在 100 元買賣一張股票，不計手續費折扣，現股當沖稅費約 150 元，資券當沖（融券賣出）稅費就要 300 元再加借券費。\"}]]}]\n1b:[\"$\",\"figure\",\"2\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"1簽署當沖同意書2從現股當沖開始3嚴設停損不凹單\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"當沖新手起步三步驟\"}]]}]\n1c:[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、最大的風險：「強制回補」是什麼？為什麼資券當沖要小心？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"這是資券當沖最需要注意的規則。融券賣出等於是跟券商「借股票來賣」，既然是借的，就一定要還。當公司要開股東會、除權息時，會規定一個「最後回補日」，你必須在那天之前把借來的股票買回來還給券商，否則券商會強制用市價幫你買回，不論價格多高，這就是所謂的「軋空」風險。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"發生時機：股東常會、臨時股東會、除權息之前。\"}],[\"$\",\"li\",\"1\",{\"children\":\"常見錯誤：忘記回補日期，以為可以一直放著空單。\"}],[\"$\",\"li\",\"2\",{\"children\":\"嚴重後果：若股價連續大漲，你又被迫在最後一天買在最高點，虧損會非常可觀。\"}],[\"$\",\"li\",\"3\",{\"children\":\"如何避免：隨時留意公司的重大訊息公告，或在「股市大佬」的除權息行事曆設定提醒。\"}]]}]]]}]\n1d:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、新手上路：我該從哪一種開始練習？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"如果你是第一次接觸當日沖銷，強烈建議從「現股當沖」開始。因為它的規則最單純，只有先買後賣一種方向，成本也比較低。你只需要專心判斷當天的漲跌，不用分心去記複雜的融資融券規則和回補日期，能大幅降低初期犯錯的機率。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"第一步：向你的券商確認，是否已簽署「有價證券當日沖銷交易風險預告書暨概括授權同意書」。\"}],[\"$\",\"li\",\"1\",{\"children\":\"第二步：從成交量大、股性較活潑的個股開始練習，例如台灣50指數的成分股。\"}],[\"$\",\"li\",\"2\",{\"children\":\"第三步：務必設定好停損點，例如虧損達到總資金的 1-2% 就離場，絕不因不甘心而持續凹單。\"}],[\"$\",\"li\",\"3\",{\"children\":\"第四步：在投入真金白銀前，可以先用模擬交易工具熟悉盤感，例如「股市大佬」的練功房功能。\"}]]}]]]}]\n1e:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"如果現股當沖，收盤前賣不掉怎麼辦？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"如果是「先買後賣」，收盤前股票沒賣掉，就會變成你的庫存，你需要在 T+2 日準備足額的交割款。這就是所謂的「留倉」，交易行為就從當沖變成了波段持有。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"資券當沖的「券」不夠會發生什麼事？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"當你想融券賣出（做空）時，如果該券商的券源不足，你的單子就會下不出去。市場上關注度高的放空標的，常常會遇到券不夠的問題，這會直接限制你的交易機會。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"當沖的交易稅減半優惠，兩種都適用嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"不，這個優惠只適用於「現股當沖」的賣出部分，稅率為千分之 1.5。如果是「資券當沖」，賣出時的證交稅是正常的千分之 3，沒有減半。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"我怎麼知道一檔股票可不可以當沖？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"主管機關會定期公告可以當沖的標的清單，通常是市值較大、流動性較好的股票。你也可以在券商的下單軟體，或是在「股市大佬」的個股透視頁面，直接查詢該股票是否具備當沖資格。\"}]]}]]}]]]}]\n1f:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"總結來說，現股當沖適合看漲時操作，成本較低、規則單純；資券當沖則多空皆宜，但有強制回補的規則要特別留意。新手應從現股當沖開始，先求穩定再考慮更複雜的操作。\"}]]]}]\n20:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L17\",\"0-想練習當沖手感？\",{\"href\":\"/sim\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"想練習當沖手感？來練功房模擬\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L17\",\"0-查詢個股是否能當\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"查詢個股是否能當沖\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L17\",\"0-更多台股名詞解釋\",{\"href\":\"/school\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"更多台股名詞解釋，都在台股學堂\"}]]}]]}]]]}]\n13:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\nf:null\n21:I[80622,[],\"IconMark\"]\n11:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"現股當沖 vs. 資券當沖？5分鐘搞懂兩種當沖差別與風險｜股市大佬 TradeBoss\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"在下單軟體看到「現股」和「資券」當沖選項，有點搞不清楚該用哪個嗎？選錯了不但交易成本變高，甚至可能要面對軋空風險。這篇文章用最白話的方式，一次幫你分清楚。\"}],[\"$\",\"link\",\"2\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}],[\"$\",\"$L21\",\"3\",{}]],\"error\":null,\"digest\":\"$undefined\"}\n16:\"$11:metadata\"\n"}