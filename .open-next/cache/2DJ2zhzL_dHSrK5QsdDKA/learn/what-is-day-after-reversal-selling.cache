st__Rq_Lz\",\"children\":[[\"$\",\"li\",\"sec-1\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-1\",\"children\":\"一、什麼是「分點隔日反手賣」？為什麼我該注意？\"}]}],[\"$\",\"li\",\"sec-2\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-2\",\"children\":\"二、如何從券商分點，看出「隔日沖」的跡象？\"}]}],[\"$\",\"li\",\"sec-3\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-3\",\"children\":\"三、隔日沖主力跟一般波段分點，差在哪裡？\"}]}],[\"$\",\"li\",\"sec-4\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-4\",\"children\":\"四、看到隔日沖大買，隔天我該怎麼應對？\"}]}],[\"$\",\"li\",\"sec-5\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-5\",\"children\":\"五、隔日沖造成的賣壓，就一定是壞事嗎？\"}]}],[\"$\",\"li\",\"sec-6\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-6\",\"children\":\"常見問題 FAQ\"}]}],[\"$\",\"li\",\"sec-7\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-7\",\"children\":\"總結\"}]}],[\"$\",\"li\",\"sec-8\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-8\",\"children\":\"延伸閱讀\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"LearnArticle_body__6B7Mb\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_intro__ATV5c\",\"children\":\"打開個股的券商分點表，看到一堆券商名字和買賣超數字，頭都昏了。昨天明明看到某個分點買超好幾千張，心想有大人進場了，怎麼今天股價反而開高走低？這很可能就是遇到了「隔日沖」主力。這篇文章會教你怎麼認出這種短線操作，以及應對的方法。\"}],[[\"$\",\"figure\",\"figure-0\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"高集中度只說明買超很集中，不說明是誰、要幹嘛前 15 大其餘成交例：集中度 40%＝這批分點淨買超約當天成交的四成不能從集中度推出明天方向\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"示意圖｜分點集中度：前幾大買超合計，佔當天成交的比例（教學結構，不是某檔實盤）\"}]]}]],[\"$\",\"div\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"「隔日沖」是券商分點今天大買、明天就賣出的短線交易，目的是賺取價差。\"}],[\"$\",\"li\",\"1\",{\"children\":\"辨識隔日沖分點，可觀察其歷史交易紀錄，若常有「今日大買、隔日大賣」就是警訊。\"}],[\"$\",\"li\",\"2\",{\"children\":\"當隔日沖券商的單日買超，佔個股成交量超過 10%，隔天開高後就要留意賣壓。\"}],[\"$\",\"li\",\"3\",{\"children\":\"遇到隔日沖賣壓不代表股票變壞，而是短線籌碼清洗，可觀察後續承接力道。\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、什麼是「分點隔日反手賣」？為什麼我該注意？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"簡單來說，這是一種極短線的交易策略。特定券商分點在今天投入大筆資金買進某檔股票，常常在盤中或尾盤拉抬股價，吸引市場目光；然後，在隔天開盤時，不論賺賠立刻全部賣出。這種操作的目的不是看好公司前景，純粹是為了賺取一天之內的價差。如果你在他們買進的當天追高，隔天開盤就可能直接面對他們排山倒海的賣壓，讓你措手不及。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"他們是誰：專門操作短線的投資人或團隊，市場上常稱之為「隔日沖主力」。\"}],[\"$\",\"li\",\"1\",{\"children\":\"他們要什麼：賺取一天內的股價波動價差，幾乎不會持股過夜。\"}],[\"$\",\"li\",\"2\",{\"children\":\"對你有什麼影響：若你在他們買進當天追高，隔天開盤就可能承受他們的龐大賣壓。\"}]]}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、如何從券商分點，看出「隔日沖」的跡象？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"沒有人能100%確定誰是隔日沖主力，但有幾個非常明顯的特徵可以幫助我們判斷。關鍵在於觀察這個券商分點的「歷史交易模式」，而不是只看一天的買賣。習慣隔日沖操作的券商，其行為會有高度的重複性，只要花點時間檢查，就能抓到規律。\"}],[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"檢查歷史紀錄：點開券商分點的歷史交易，看它是否在過去頻繁出現「今天在前幾大買超、明天就在前幾大賣超」的模式。\"}],[\"$\",\"li\",\"1\",{\"children\":\"計算買超佔比：把該分點的「買超張數」除以個股「總成交量」。如果這個比例超過 10% 或 15%，代表它的影響力很大，隔天的賣壓也可能很重。\"}],[\"$\",\"li\",\"2\",{\"children\":\"對照股價走勢：觀察該分點大買的日子，股價是否常收一根帶有長長上影線的紅K棒？這很可能是他們拉高股價時，市場追價意願不足，或他們自己邊拉邊賣的痕跡。\"}]]}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、隔日沖主力跟一般波段分點，差在哪裡？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"了解不同參與者的操作手法，能幫助我們更客觀地解讀籌碼。隔日沖主力像是一陣風，來得快去得也快，追求的是效率；而波段或長期分點則更像是在打地基，他們著眼於一段時間的趨勢或公司價值，操作手法和心態完全不同。用下表可以快速分辨他們的差異：\"}],\"$L18\",\"$L19\"]]}],\"$L1a\",\"$L1b\",\"$L1c\",\"$L1d\",\"$L1e\"],null]}]]}]}]\n18:[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"特性\"}],[\"$\",\"th\",\"1\",{\"children\":\"隔日沖主力\"}],[\"$\",\"th\",\"2\",{\"children\":\"一般波段或長期分點\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"交易週期\"}],[\"$\",\"td\",\"1\",{\"children\":\"極短，通常 1-2 天\"}],[\"$\",\"td\",\"2\",{\"children\":\"數週至數月，甚至更長\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"操作標的\"}],[\"$\",\"td\",\"1\",{\"children\":\"中小型、成交量活絡、有題材的股票\"}],[\"$\",\"td\",\"2\",{\"children\":\"大型權值股或有基本面支撐的公司\"}]]}],[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"對股價影響\"}],[\"$\",\"td\",\"1\",{\"children\":\"造成當日大漲、隔日開高走低\"}],[\"$\",\"td\",\"2\",{\"children\":\"穩定股價，提供長期支撐\"}]]}],[\"$\",\"tr\",\"3\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"判斷重點\"}],[\"$\",\"td\",\"1\",{\"children\":\"買賣紀錄是否高度重疊且反向\"}],[\"$\",\"td\",\"2\",{\"children\":\"是否持續性買進或在關鍵價位護盤\"}]]}]]}]]}]}]\n19:[\"$\",\"figure\",\"2\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"!不在前一天尾盤追高!觀察隔天開盤承接力道!賣壓消化後再評估\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"遇到隔日沖賣壓的應對\"}]]}]\n1a:[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、看到隔日沖大買，隔天我該怎麼應對？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"發現有隔日沖券商大買，最重要的原則就是「保持冷靜，不要衝動」。這不代表股價隔天一定會跌，但確實代表隔天的賣壓會很重。與其猜測股價會漲還會跌，不如做好準備，觀察市場如何反應這股賣壓。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"不要在尾盤追高：看到尾盤急拉，又發現是隔日沖券商在買，這時候追進去，非常容易套在當天的相對高點。\"}],[\"$\",\"li\",\"1\",{\"children\":\"觀察隔天開盤價與量：如果隔天開盤跳空大漲，但第一盤或前五分鐘就爆出巨量，就要非常小心，這很可能是主力正在倒貨給追價的散戶。\"}],[\"$\",\"li\",\"2\",{\"children\":\"評估承接力道：如果開高後雖有賣壓，但股價沒有快速下殺，甚至在平盤或特定價位有新的買盤進來承接，代表籌碼換手成功，後市仍可繼續觀察。\"}]]}]]]}]\n1b:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、隔日沖造成的賣壓，就一定是壞事嗎？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"其實不一定。對一檔處於多頭趨勢的股票來說，隔日沖的賣壓反而像是一次健康的「換手」，把不穩定的短線籌碼清洗出去，讓真正看好後市的投資人接手，籌碼沉澱後，股價走勢可能更穩健。這股賣壓就像一個壓力測試，能幫我們看出這檔股票的真實支撐力道在哪裡。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"你可以把它想成一次「篩檢」，如果股價能撐過這波賣壓，代表市場上還有更強的力道願意承接。反之，如果一賣就崩，那可能代表目前市場的追價意願薄弱，需要多加留意。\"}]]}]]]}]\n1c:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"我要怎麼查詢特定券商分點的歷史進出紀錄？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"在多數看盤軟體或網站的個股頁面，都能找到「分點進出」或「券商進出」的查詢功能。輸入券商名稱或代碼，設定查詢區間，就可以看到該分點的詳細買賣紀錄。股市大佬的「個股透視」頁面也整合了這項功能。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"如果很多家隔日沖券商同時買進一檔股票，代表什麼？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"這代表這檔股票當天非常熱門，市場關注度極高。但同時也預告了隔天的賣壓會非常沉重，因為這些短線資金有很強的共識會在隔天開盤出脫。這種情況下，隔天股價的波動會非常劇烈。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"隔日沖主力也會賠錢嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"會的，任何交易都有風險。如果他們買進後，隔天開盤價不如預期，甚至開低，他們也必須停損賣出。這也是為什麼他們偏好操作有成交量和波動性的股票，以確保隔天有足夠的流動性可以出場。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"我是長期投資者，需要關心隔日沖籌碼嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"如果你是長期持有、專注基本面的投資者，隔日沖造成的短期波動對你的影響較小。但了解這個現象，可以幫助你避免在市場過熱時買在不必要的短期高點，甚至利用他們造成的賣壓，找到更合理的進場機會。\"}]]}]]}]]]}]\n1d:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"總結來說，辨識「隔日沖」分點的關鍵在於觀察其『今天大買、明天就賣』的歷史慣性。遇到這種籌碼，與其跟著衝動進場，不如保持冷靜，觀察隔天的賣壓消化情況，再做判斷。\"}]]]}]\n1e:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L17\",\"0-用分點排行找出關\",{\"href\":\"/chips/2330\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"用分點排行找出關鍵券商\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L17\",\"0-在個股透視頁查詢\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"在個股透視頁查詢分點紀錄\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L17\",\"0-搞懂更多籌碼分析\",{\"href\":\"/school\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"搞懂更多籌碼分析名詞\"}]]}]]}]]]}]\n13:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\nf:null\n1f:I[80622,[],\"IconMark\"]\n11:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"分點隔日反手賣是什麼？3招看懂券商進出，避開短線賣壓｜股市大佬 TradeBoss\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"打開個股的券商分點表，看到一堆券商名字和買賣超數字，頭都昏了。昨天明明看到某個分點買超好幾千張，心想有大人進場了，怎麼今天股價反而開高走低？這很可能就是遇到了「隔日沖」主力。這篇文章會教你怎麼認出這種短線操作，以及應對的方法。\"}],[\"$\",\"link\",\"2\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}],[\"$\",\"$L1f\",\"3\",{}]],\"error\":null,\"digest\":\"$undefined\"}\n16:\"$11:metadata\"\n"}