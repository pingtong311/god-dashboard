\",\"$L14\",null,{\"children\":[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$15\",null,{\"fallback\":null,\"children\":\"$L16\"}]}]}]]}]\n17:I[52619,[\"2619\",\"static/chunks/2619-04bc32f026a0d946.js\",\"6309\",\"static/chunks/app/learn/%5Bslug%5D/page-f7b99344f7e2ee16.js\"],\"\"]\nd:[\"$\",\"div\",null,{\"className\":\"LearnArticle_wrap__LIQ8G\",\"children\":[\"$\",\"article\",null,{\"className\":\"LearnArticle_article__2nBbk\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_meta__etj_G\",\"children\":[[\"$\",\"$L17\",null,{\"className\":\"LearnArticle_cat__GQMlg\",\"href\":\"/learn?c=trends\",\"children\":\"產業與趨勢\"}],[\"$\",\"span\",null,{\"className\":\"LearnArticle_read__QEj6a\",\"children\":\"閱讀約 4 分鐘\"}]]}],[\"$\",\"h1\",null,{\"className\":\"LearnArticle_title__0_la8\",\"children\":\"電動車供應鏈怎麼分？先拆4段，再聽題材熱度\"}],[\"$\",\"details\",null,{\"className\":\"LearnArticle_toc__LcSAa\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"LearnArticle_tocSummary__YBddG\",\"children\":\"本文目錄\"}],[\"$\",\"ol\",null,{\"className\":\"LearnArticle_tocList__Rq_Lz\",\"children\":[[\"$\",\"li\",\"sec-1\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-1\",\"children\":\"一、四段不要焊成一個未來\"}]}],[\"$\",\"li\",\"sec-2\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-2\",\"children\":\"二、車用為什麼常常「聽起來很穩、等起來很久」\"}]}],[\"$\",\"li\",\"sec-3\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-3\",\"children\":\"三、和消費電子循環差在哪\"}]}],[\"$\",\"li\",\"sec-4\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-4\",\"children\":\"四、價格戰與補貼會改敘述\"}]}],[\"$\",\"li\",\"sec-5\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-5\",\"children\":\"五、最小讀法\"}]}],[\"$\",\"li\",\"sec-6\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-6\",\"children\":\"常見問題 FAQ\"}]}],[\"$\",\"li\",\"sec-7\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-7\",\"children\":\"總結\"}]}],[\"$\",\"li\",\"sec-8\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-8\",\"children\":\"延伸閱讀\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"LearnArticle_body__6B7Mb\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_intro__ATV5c\",\"children\":\"電動車變成標題之後，很多公司都被放進同一句「車用」。對做功課的人，比較有用的是先問：這家碰的是電池材料、馬達與電控、車用電子，還是傳統車身與內裝只是客戶換成車廠。四段的資本支出、認證時間與景氣敏感點不同。題材可以焊，財報不會。\"}],[[\"$\",\"figure\",\"figure-0\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"越後面越熱鬧，通常也越貴、越好離開佈局沒新聞命名故事出現擁擠人人都知退燒利多變鈍新聞出現時，常常已經不是第一段\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"示意圖｜題材四階段：佈局 → 命名 → 擁擠 → 退燒（教學結構，不是某檔實盤）\"}]]}]],[\"$\",\"div\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"先拆電池、動力、車用電子、傳統車身，再聽電動兩個字\"}],[\"$\",\"li\",\"1\",{\"children\":\"認證與車廠客戶集中，會讓訂單節奏跟消費電子不一樣\"}],[\"$\",\"li\",\"2\",{\"children\":\"長期滲透敘述可以對，中間仍有庫存、價格戰與產能錯位\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、四段不要焊成一個未來\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"電池與材料比較吃大宗與製程。動力系統吃的是電機與控制。車用電子吃的是規格、認證與長生命週期。傳統沖壓、內裝、輪胎類，客戶換成電動車廠，不自動變成另一種公司。你要先標段，才知道自己看的是原物料循環、資本支出，還是車廠議價。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"電池與材料\"}],[\"$\",\"li\",\"1\",{\"children\":\"馬達與電控\"}],[\"$\",\"li\",\"2\",{\"children\":\"車用電子與認證\"}],[\"$\",\"li\",\"3\",{\"children\":\"傳統車身與內裝\"}]]}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、車用為什麼常常「聽起來很穩、等起來很久」\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"認證長、變更規格慢、客戶少而大。這讓營收一旦進來可能比較黏，也讓還沒進來的故事可以講很久。題材階段最容易把「可能成為供應商」講成「已經在車上」。檢查方法仍土：營收有沒有認列、客戶有沒有點名到可核對的程度、還是只是同一群人在同一季講同一句。\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"你聽到的\"}],[\"$\",\"th\",\"1\",{\"children\":\"先問\"}],[\"$\",\"th\",\"2\",{\"children\":\"比較穩的態度\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"已打進供應鏈\"}],[\"$\",\"td\",\"1\",{\"children\":\"營收有沒有出來\"}],[\"$\",\"td\",\"2\",{\"children\":\"故事與認列分開\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"車用比消費電子穩\"}],[\"$\",\"td\",\"1\",{\"children\":\"客戶集中度高不高\"}],[\"$\",\"td\",\"2\",{\"children\":\"穩的代價可能是議價\"}]]}],[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"滲透率一定往上\"}],[\"$\",\"td\",\"1\",{\"children\":\"今年量與價格戰\"}],[\"$\",\"td\",\"2\",{\"children\":\"長期方向≠今年獲利\"}]]}],[\"$\",\"tr\",\"3\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"相關就該一起動\"}],[\"$\",\"td\",\"1\",{\"children\":\"它在四段的哪一段\"}],[\"$\",\"td\",\"2\",{\"children\":\"邊緣被焊上來時最擠\"}]]}]]}]]}]}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、和消費電子循環差在哪\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"手機與筆電的規格換得快、促銷節奏明顯。車用換代慢，但單一個車廠砍單，影響可以很大。你不能用消費電子的庫存週期，直接套到每一家車用公司；也不能因為它叫車用，就假設沒有庫存。尺子要換，不是把舊尺子加一個車字。\"}],\"$L18\",\"$L19\"]]}],\"$L1a\",\"$L1b\",\"$L1c\",\"$L1d\",\"$L1e\"],\"$L1f\"]}]]}]}]\n18:[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"先問認證與生命週期有多長\"}],[\"$\",\"li\",\"1\",{\"children\":\"再問前幾大客戶佔營收多少\"}],[\"$\",\"li\",\"2\",{\"children\":\"最後才用消費電子的庫存經驗當參考\"}]]}]\n19:[\"$\",\"figure\",\"2\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"!可能供貨＝已有營收!車用＝一定穩!滲透率＝今年賺\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"題材焊法\"}]]}]\n1a:[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、價格戰與補貼會改敘述\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"終端車價一打，壓力會往供應鏈傳。補貼政策一變，量的故事也要重寫。這兩層都不在晶片規格裡，卻常決定你今年看到的毛利。讀電動車新聞，除了技術名詞，還要留一格給「終端在不在打價格」。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"終端價格戰會往上傳\"}],[\"$\",\"li\",\"1\",{\"children\":\"政策與補貼會改量\"}],[\"$\",\"li\",\"2\",{\"children\":\"技術名詞不自動保護毛利\"}]]}]]]}]\n1b:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、最小讀法\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"看到電動車，寫三格：哪一段、營收有沒有認列、終端現在是量的故事還是價的故事。三格填得完，你才比較不像在收藏標題。填不完，就當它是題材，不當它是產業功課。\"}]]]}]\n1c:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"做螺絲的算不算電動車鏈？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"可以算邊緣環節。先講清楚段，再講算不算，才不會被概念焊住。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"車用電子是不是比較好？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"認證長可能帶來黏性，也帶來等待與客戶集中。沒有比較好，只有不一樣。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"和 AI 伺服器那篇為什麼好像同一套？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"因為題材焊法很像：用一個大名詞把多段焊在一起。讀法可以共用，產業細節不能共用。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"傳統車廠轉型，舊供應商會怎樣？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"有的跟上、有的被換。不能用「以前有單」推論現在仍在名單上。\"}]]}]]}]]]}]\n1d:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"電動車至少拆四段：電池、動力、車用電子、傳統車身。先問段、認列與終端是量還是價。長期滲透不自動等於今年獲利。\"}]]]}]\n1e:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L17\",\"0-AI 伺服器供應\",{\"href\":\"/learn/ai-server-supply-chain-taiwan\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"AI 伺服器供應鏈\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L17\",\"0-題材輪動\",{\"href\":\"/learn/what-theme-rotation-is-actually-doing\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"題材輪動\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L17\",\"0-景氣循環股\",{\"href\":\"/learn/cyclical-vs-defensive-stocks-taiwan\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"景氣循環股\"}]]}]]}]]]}]\n1f:[\"$\",\"div\",null,{\"className\":\"LearnArticle_related__9qV55\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_relatedTitle__RXfrl\",\"children\":\"相關文章\"}],[[\"$\",\"$L17\",\"ai-server-supply-chain-taiwan\",{\"href\":\"/learn/ai-server-supply-chain-taiwan\",\"className\":\"LearnArticle_relatedLink__mibXe\",\"children\":\"AI 伺服器供應鏈\"}],[\"$\",\"$L17\",\"what-theme-rotation-is-actually-doing\",{\"href\":\"/learn/what-theme-rotation-is-actually-doing\",\"className\":\"LearnArticle_relatedLink__mibXe\",\"children\":\"題材輪動\"}],[\"$\",\"$L17\",\"cyclical-vs-defensive-stocks-taiwan\",{\"href\":\"/learn/cyclical-vs-defensive-stocks-taiwan\",\"className\":\"LearnArticle_relatedLink__mibXe\",\"children\":\"景氣循環股\"}]]]}]\n13:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\nf:null\n20:I[80622,[],\"IconMark\"]\n11:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"電動車供應鏈怎麼分？先拆4段，再聽題材熱度｜股市大佬 TradeBoss\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"電動車變成標題之後，很多公司都被放進同一句「車用」。對做功課的人，比較有用的是先問：這家碰的是電池材料、馬達與電控、車用電子，還是傳統車身與內裝只是客戶換成車廠。四段的資本支出、認證時間與景氣敏感點不同。題材可以焊，財報不會。\"}],[\"$\",\"link\",\"2\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}],[\"$\",\"$L20\",\"3\",{}]],\"error\":null,\"digest\":\"$undefined\"}\n16:\"$11:metadata\"\n"}