t\",\"href\":\"/_next/static/css/3eaf36e367672966.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"$undefined\"}]],[\"$\",\"$Le\",null,{\"children\":[\"$Lf\",[\"$\",\"$L10\",null,{\"promise\":\"$@11\"}]]}]]}]\nb:[\"$\",\"$1\",\"h\",{\"children\":[null,[[\"$\",\"$L12\",null,{\"children\":\"$L13\"}],[\"$\",\"meta\",null,{\"name\":\"next-size-adjust\",\"content\":\"\"}]],[\"$\",\"$L14\",null,{\"children\":[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$15\",null,{\"fallback\":null,\"children\":\"$L16\"}]}]}]]}]\n17:I[52619,[\"2619\",\"static/chunks/2619-04bc32f026a0d946.js\",\"6309\",\"static/chunks/app/learn/%5Bslug%5D/page-f7b99344f7e2ee16.js\"],\"\"]\nd:[\"$\",\"div\",null,{\"className\":\"LearnArticle_wrap__LIQ8G\",\"children\":[\"$\",\"article\",null,{\"className\":\"LearnArticle_article__2nBbk\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_meta__etj_G\",\"children\":[[\"$\",\"$L17\",null,{\"className\":\"LearnArticle_cat__GQMlg\",\"href\":\"/learn?c=chips\",\"children\":\"籌碼面\"}],[\"$\",\"span\",null,{\"className\":\"LearnArticle_read__QEj6a\",\"children\":\"閱讀約 7 分鐘\"}]]}],[\"$\",\"h1\",null,{\"className\":\"LearnArticle_title__0_la8\",\"children\":\"國安基金護盤是什麼？進場條件、官股銀行名單一次看懂\"}],[\"$\",\"details\",null,{\"className\":\"LearnArticle_toc__LcSAa\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"LearnArticle_tocSummary__YBddG\",\"children\":\"本文目錄\"}],[\"$\",\"ol\",null,{\"className\":\"LearnArticle_tocList__Rq_Lz\",\"children\":[[\"$\",\"li\",\"sec-1\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-1\",\"children\":\"一、新聞常說的「國家隊」到底是什麼？\"}]}],[\"$\",\"li\",\"sec-2\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-2\",\"children\":\"二、國安基金什麼時候才會出手？有具體標準嗎？\"}]}],[\"$\",\"li\",\"sec-3\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-3\",\"children\":\"三、怎麼知道國安基金買了什麼？可以從哪裡看？\"}]}],[\"$\",\"li\",\"sec-4\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-4\",\"children\":\"四、看到八大行庫買超，可以跟著買嗎？\"}]}],[\"$\",\"li\",\"sec-5\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-5\",\"children\":\"五、國安基金退場，是不是代表利空出盡了？\"}]}],[\"$\",\"li\",\"sec-6\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-6\",\"children\":\"常見問題 FAQ\"}]}],[\"$\",\"li\",\"sec-7\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-7\",\"children\":\"總結\"}]}],[\"$\",\"li\",\"sec-8\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-8\",\"children\":\"延伸閱讀\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"LearnArticle_body__6B7Mb\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_intro__ATV5c\",\"children\":\"聽到新聞說「國安基金進場護盤」，是不是覺得股市有救了，可以安心進場？但又怕被套在高點？這篇文章就是要帶你搞懂，國安基金到底是什麼，它出手時，我們散戶該怎麼看、怎麼做才對。\"}],[[\"$\",\"figure\",\"figure-0\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"高集中度只說明買超很集中，不說明是誰、要幹嘛前 15 大其餘成交例：集中度 40%＝這批分點淨買超約當天成交的四成不能從集中度推出明天方向\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"示意圖｜分點集中度：前幾大買超合計，佔當天成交的比例（教學結構，不是某檔實盤）\"}]]}]],[\"$\",\"div\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"國安基金是政府的穩定工具，目標是「穩定市場信心」而非「拉抬股價」。\"}],[\"$\",\"li\",\"1\",{\"children\":\"進場時機有嚴格法律規定，通常是大盤出現系統性風險的恐慌時期。\"}],[\"$\",\"li\",\"2\",{\"children\":\"國安基金主要透過八大公股行庫下單，可觀察其買賣超動向來判斷。\"}],[\"$\",\"li\",\"3\",{\"children\":\"歷史數據顯示，國安基金進場後大盤不一定立刻反彈，但長期有支撐效果。\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、新聞常說的「國家隊」到底是什麼？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"「國家隊」或「國安基金」，法定全名是「國家金融安定基金」。你可以把它想像成股市的消防隊，只有在市場信心崩潰、出現失火（失序）的危險時才會出動。它的任務是滅火、恢復穩定，而不是幫你把房子蓋得更高。所以，它的主要目標是「穩定」，防止非理性的連續下跌，而不是要創造一波多頭行情。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"資金來源：主要來自國庫、郵儲基金、勞保基金等，總額上限為新台幣 5000 億元。\"}],[\"$\",\"li\",\"1\",{\"children\":\"決策單位：由一個管理委員會決議，成員包含央行、財政部、金管會等首長。\"}],[\"$\",\"li\",\"2\",{\"children\":\"操作目標：維持資本市場及其他金融市場穩定，確保國家安定。\"}],[\"$\",\"li\",\"3\",{\"children\":\"法律依據：依據「國家金融安定基金設置及管理條例」設立與運作。\"}]]}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、國安基金什麼時候才會出手？有具體標準嗎？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"國安基金並不是看大盤跌多少點就會進場，它出手的條件是法定且嚴格的。根據條例，必須是「國內、外發生重大事件，致國際資金大幅移動，顯著影響民眾信心，致資本市場及其他金融市場有失序或有嚴重影響國家安定之虞時」，才會開會決定是否授權進場。簡單說，就是市場出現恐慌、大家不計價地拋售股票時，它才會考慮進來踩煞車。\"}],[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"判斷時機：通常是發生像 2008 年金融海嘯、2020 年新冠疫情初期這種全球性的系統風險。\"}],[\"$\",\"li\",\"1\",{\"children\":\"決策流程：由委員會開會討論，過半數委員出席、出席委員過半數同意後，才能動用。\"}],[\"$\",\"li\",\"2\",{\"children\":\"退場時機：當市場狀況穩定，任務完成後，委員會就會決議停止授權，並在適當時機出脫持股。\"}]]}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、怎麼知道國安基金買了什麼？可以從哪裡看？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"國安基金不會每天公布買了哪幾檔股票，但它的操作是透過八家公股銀行券商（俗稱八大行庫）來下單。因此，市場上普遍會觀察「八大公股行庫買賣超」這項數據，來推測國家隊的動向。如果八大行庫在指數大跌時，聯手買超了數十億甚至上百億，就很有可能是國安基金在執行護盤任務。他們通常會買進大型權值股，例如台灣50成分股，因為這樣才能最有效地穩住加權指數。\"}],\"$L18\",\"$L19\"]]}],\"$L1a\",\"$L1b\",\"$L1c\",\"$L1d\",\"$L1e\"],null]}]]}]}]\n18:[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"比較項目\"}],[\"$\",\"th\",\"1\",{\"children\":\"國安基金\"}],[\"$\",\"th\",\"2\",{\"children\":\"一般散戶\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"主要目標\"}],[\"$\",\"td\",\"1\",{\"children\":\"穩定市場信心\"}],[\"$\",\"td\",\"2\",{\"children\":\"追求個人獲利\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"選股偏好\"}],[\"$\",\"td\",\"1\",{\"children\":\"大型權值股、ETF\"}],[\"$\",\"td\",\"2\",{\"children\":\"任何感興趣的股票\"}]]}],[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"操作週期\"}],[\"$\",\"td\",\"1\",{\"children\":\"任務導向，偏中長期\"}],[\"$\",\"td\",\"2\",{\"children\":\"長短線不拘\"}]]}],[\"$\",\"tr\",\"3\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"資金規模\"}],[\"$\",\"td\",\"1\",{\"children\":\"非常龐大\"}],[\"$\",\"td\",\"2\",{\"children\":\"相對有限\"}]]}]]}]]}]}]\n19:[\"$\",\"figure\",\"2\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"!以為國家隊會拉抬個股!把護盤當成進場訊號!忽略自身投資計畫\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"散戶應避免的 3 個迷思\"}]]}]\n1a:[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、看到八大行庫買超，可以跟著買嗎？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"這是最多人想問，也最容易犯的錯誤。答案是：千萬不要盲目地複製別人的進出。國安基金的錢不是你的錢，它的目標也不是幫你賺錢。它進場買，可能只是為了讓下跌趨勢「變緩」，不代表股價會立刻反轉向上。如果你在下跌趨勢中只因為看到官股在買就跟進，很可能買在半山腰，承受後續的虧損。正確的心態是，把官股進場當成一個「市場氣氛參考指標」，代表政府認為盤勢已經過度恐慌，但你自己的買賣決策，還是要回到個股的基本面與你自己的投資計畫。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"常見錯誤一：以為國家隊買什麼，什麼就會漲。\"}],[\"$\",\"li\",\"1\",{\"children\":\"常見錯誤二：把護盤當成市場反轉的絕對信號。\"}],[\"$\",\"li\",\"2\",{\"children\":\"常見錯誤三：放棄自己的選股原則，只看官股臉色。\"}]]}]]]}]\n1b:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、國安基金退場，是不是代表利空出盡了？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"當國安基金委員會宣布「停止授權、擇機退場」時，通常代表他們認為市場已經回穩，不再需要強力介入。這對市場信心來說，是一個正面的訊號，表示最恐慌的時期已經過去。不過，退場不代表股市會立刻大漲。國安基金賣出持股會非常小心，通常是分批、緩慢地在市場上賣，避免對股價造成衝擊。所以，你可以把「退場」解讀為市場恢復正常機制的信號，接下來的漲跌，就回歸基本面與籌碼面的常規分析。\"}]]]}]\n1c:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"國安基金護盤一定會賺錢嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"不一定。國安基金的任務是穩定市場，不是獲利。雖然歷史上多數護盤任務最終是獲利了結，但過程中也可能出現帳面虧損，其首要目標並非賺錢。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"怎麼查詢八大公股行庫的買賣超？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"許多券商看盤軟體或財經網站都有提供「八大行庫買賣超」的統計數據，通常會每日盤後更新。在股市大佬的「今日戰情」頁面也能看到相關整理與圖表。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"國安基金進場，我手上的股票就會漲嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"不會。國安基金主要買的是能影響指數的大型權值股。如果你持有的股票是中小型股或與指數連動性低的公司，不一定會受到直接的拉抬。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"國安基金會不會護盤失敗？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"「失敗」的定義比較模糊。如果指「無法阻止市場繼續下跌」，是有可能的，因為它無法對抗全球性的經濟衰退。但它的存在本身就能提供下檔支撐與信心，達成「穩定」的部分目標。\"}]]}]]}]]]}]\n1d:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"總結來說，國安基金是市場的「定心丸」，而非「大力丸」。看到它進場，代表大盤風險高，但可能已接近非理性的底部區。投資人應將其視為一個觀察信號，搭配自己的研究，而不是閉著眼睛複製別人的進出。\"}]]]}]\n1e:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L17\",\"0-想知道更多台股知\",{\"href\":\"/school\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"想知道更多台股知識？來台股學堂看看\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L17\",\"0-每日大盤籌碼動向\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"每日大盤籌碼動向，都在今日戰情\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L17\",\"0-從大盤總覽看懂市\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"從大盤總覽看懂市場氣氛\"}]]}]]}]]]}]\n13:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\nf:null\n1f:I[80622,[],\"IconMark\"]\n11:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"國安基金護盤是什麼？進場條件、官股銀行名單一次看懂｜股市大佬 TradeBoss\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"聽到新聞說「國安基金進場護盤」，是不是覺得股市有救了，可以安心進場？但又怕被套在高點？這篇文章就是要帶你搞懂，國安基金到底是什麼，它出手時，我們散戶該怎麼看、怎麼做才對。\"}],[\"$\",\"link\",\"2\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}],[\"$\",\"$L1f\",\"3\",{}]],\"error\":null,\"digest\":\"$undefined\"}\n16:\"$11:metadata\"\n"}