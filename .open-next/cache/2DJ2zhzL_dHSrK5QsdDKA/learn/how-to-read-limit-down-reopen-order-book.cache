,null,{\"fallback\":null,\"children\":\"$L16\"}]}]}]]}]\n17:I[52619,[\"2619\",\"static/chunks/2619-04bc32f026a0d946.js\",\"6309\",\"static/chunks/app/learn/%5Bslug%5D/page-f7b99344f7e2ee16.js\"],\"\"]\nd:[\"$\",\"div\",null,{\"className\":\"LearnArticle_wrap__LIQ8G\",\"children\":[\"$\",\"article\",null,{\"className\":\"LearnArticle_article__2nBbk\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_meta__etj_G\",\"children\":[[\"$\",\"$L17\",null,{\"className\":\"LearnArticle_cat__GQMlg\",\"href\":\"/learn?c=orderbook\",\"children\":\"盤口掛單\"}],[\"$\",\"span\",null,{\"className\":\"LearnArticle_read__QEj6a\",\"children\":\"閱讀約 7 分鐘\"}]]}],[\"$\",\"h1\",null,{\"className\":\"LearnArticle_title__0_la8\",\"children\":\"跌停打開時盤口怎麼看？3 步驟判斷是撿便宜還是逃命波\"}],[\"$\",\"details\",null,{\"className\":\"LearnArticle_toc__LcSAa\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"LearnArticle_tocSummary__YBddG\",\"children\":\"本文目錄\"}],[\"$\",\"ol\",null,{\"className\":\"LearnArticle_tocList__Rq_Lz\",\"children\":[[\"$\",\"li\",\"sec-1\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-1\",\"children\":\"一、為什麼跌停打開，不代表「賣壓結束」？\"}]}],[\"$\",\"li\",\"sec-2\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-2\",\"children\":\"二、關鍵第一步：從「內外盤」看懂多空力道\"}]}],[\"$\",\"li\",\"sec-3\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-3\",\"children\":\"三、判斷賣壓虛實：盯緊跌停價的「委賣張數」\"}]}],[\"$\",\"li\",\"sec-4\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-4\",\"children\":\"四、多空分水嶺：股價有沒有站上「均價線」？\"}]}],[\"$\",\"li\",\"sec-5\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-5\",\"children\":\"五、進階觀察：小心「單一分點」的對敲騙術\"}]}],[\"$\",\"li\",\"sec-6\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-6\",\"children\":\"常見問題 FAQ\"}]}],[\"$\",\"li\",\"sec-7\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-7\",\"children\":\"總結\"}]}],[\"$\",\"li\",\"sec-8\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-8\",\"children\":\"延伸閱讀\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"LearnArticle_body__6B7Mb\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_intro__ATV5c\",\"children\":\"一檔股票跌停鎖死，突然盤中爆量打開，是機會來了還是更大的危機？很多人看到價格變便宜就衝動進場，結果股價繼續破底。這篇文章就是要教你，如何從盤口的掛單細節，判斷這是止跌訊號，還是主力出貨給你接的「逃命波」。\"}],[[\"$\",\"figure\",\"figure-0\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"中間缺口是價差；張數是意願，不是承諾151.542 張151.088 張150.5120 張150.095 張149.5160 張149.070 張賣方五檔買方五檔大單靠近就消失，多半沒打算成交\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"示意圖｜五檔掛單：上面是想賣的，下面是想買的，都能隨時撤（教學結構，不是某檔實盤）\"}]]}]],[\"$\",\"div\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"觀察「內盤成交」是否持續大於「外盤」，若內盤連續爆量，代表賣壓沉重。\"}],[\"$\",\"li\",\"1\",{\"children\":\"跌停價位掛的「委賣張數」是否快速減少，是判斷賣壓宣洩程度的關鍵數字。\"}],[\"$\",\"li\",\"2\",{\"children\":\"打開後股價能否站穩「均價線」，是當天多空力道轉變的初步觀察指標。\"}],[\"$\",\"li\",\"3\",{\"children\":\"單一券商若在跌停打開時有大量對敲，可能是製造交易活絡的假象。\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、為什麼跌停打開，不代表「賣壓結束」？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"很多投資人看到股價從跌停打開，就下意識認為「最壞的狀況過去了」。但實際上，這往往只是第一批最恐慌的賣單被消化而已。所謂的「打開」，可能只是某個大戶或短線客的一筆大單敲開，但後面還有更多排隊等著要賣的人。如果沒有連續的買盤支撐，股價很快又會回到跌停。\"}],[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"第一波恐慌賣壓：開盤就掛跌停，不計代價想出場的投資人。\"}],[\"$\",\"li\",\"1\",{\"children\":\"融資斷頭賣壓：被券商通知追繳保證金，在壓力下被迫賣出的部位。\"}],[\"$\",\"li\",\"2\",{\"children\":\"主力刻意倒貨：大戶利用打開的瞬間，將籌碼倒給想搶反彈的散戶。\"}]]}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、關鍵第一步：從「內外盤」看懂多空力道\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"盤口最直接的訊號就是「內外盤成交」。簡單說，成交在「委賣價」（外盤、紅色數字）代表買方很積極，願意主動去買別人掛著要賣的價格；成交在「委買價」（內盤、綠色數字）則代表賣方很著急，願意直接賣給掛著要買的人。當跌停打開時，如果成交回報上，綠色數字一直跳，而且量很大，就代表大家還在拚命殺出，這通常不是好兆頭。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"假設跌停價 90 元，打開後五檔報價為委買 90.1 元、委賣 90.2 元。如果接下來的成交紀錄，一堆 90.1 元的綠字成交，代表賣方連 0.1 元都不想等，急著賣。反之，若 90.2 元的紅字成交量比較多，表示有人願意主動去吃掉賣單，多方力道較強。\"}]]}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、判斷賣壓虛實：盯緊跌停價的「委賣張數」\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"在跌停鎖死的時候，跌停價位會掛著長長一串的委賣單，這個數字的「消化速度」是重要線索。如果這個數字從幾萬張，在短短幾分鐘內被快速吃光，代表有實質的特定買盤在承接。但如果只是減少一點點，股價又很快縮回去跌停價，那可能只是零星買盤，賣壓根本沒化解，隨時可能再度鎖死。\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":\"$L18\"}],\"$L19\"]]}],\"$L1a\",\"$L1b\",\"$L1c\",\"$L1d\",\"$L1e\"],null]}]]}]}]\n18:[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"狀況\"}],[\"$\",\"th\",\"1\",{\"children\":\"委賣張數變化\"}],[\"$\",\"th\",\"2\",{\"children\":\"可能的解讀\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"真止跌訊號\"}],[\"$\",\"td\",\"1\",{\"children\":\"開盤前掛 20,000 張，打開後 5 分鐘內消化完畢，且不再增加。\"}],[\"$\",\"td\",\"2\",{\"children\":\"特定大戶或公司派進場承接，賣壓被有效吸收。\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"假反彈陷阱\"}],[\"$\",\"td\",\"1\",{\"children\":\"開盤前掛 20,000 張，打開後只消化 3,000 張，委賣又掛回 18,000 張。\"}],[\"$\",\"td\",\"2\",{\"children\":\"買盤力道不足，只是短線客搶反彈，賣壓仍在，隨時可能再次鎖死。\"}]]}]]}]]}]\n19:[\"$\",\"figure\",\"2\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"!內盤爆量成交!主力左手換右手!股價站不回均價線\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"小心 3 種跌停打開陷阱\"}]]}]\n1a:[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、多空分水嶺：股價有沒有站上「均價線」？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"「均價線」（VWAP）是當天所有成交量加權計算的平均成本，你可以把它想成是「今天所有進場交易的人的平均成本」。當股價從跌停打開後，如果能一路向上，並且成功站上「均價線」之上，代表今天進場買進的人，平均是賺錢的，這會給多方帶來信心。反之，如果股價一直在均價線下方掙扎，代表今天進場的人多數被套牢，解套賣壓會越來越重。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"股價 > 均價線：當日買方平均處於獲利狀態，多方佔優勢。\"}],[\"$\",\"li\",\"1\",{\"children\":\"股價 < 均價線：當日買方平均處於虧損狀態，空方佔優勢。\"}]]}]]]}]\n1b:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、進階觀察：小心「單一分點」的對敲騙術\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"有時候，你會看到跌停打開時成交量暴增，但其實是「左手換右手」的假象。某些主力會利用旗下不同帳戶，在同一個券商分點進行大量買賣對敲，目的是製造「有人在低點承接」的活絡假象，吸引散戶進場接手。要辨識這種情況，可以觀察盤後的「分點進出」，如果買超跟賣超第一名的券商是同一個，且張數相近，就要特別小心。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"這種手法雖然不能完全確定，但確實是一種警訊。在股市大佬的「個股透視」頁面，可以快速查看當日的分點進出狀況，幫助你辨識這種異常交易。\"}]]}]]]}]\n1c:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"跌停打開時，成交量很大就一定是好事嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"不一定。關鍵要看成交是「外盤」多還是「內盤」多。如果是內盤爆量，代表是「賣出」的量很大，大家急著殺出，反而是危險訊號。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"看到跌停打開，可以馬上掛市價單買進嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"非常不建議。市價單可能讓你買在瞬間拉抬的最高點，風險極高。建議先觀察五檔報價與內外盤成交狀況，用限價單掛在你想承接的價位，才能控制好成本。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"為什麼有些股票跌停打開後，又馬上鎖回去？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"這通常代表最初的買盤力道不足，只能消化一小部分的賣壓。當第一筆買單被滿足後，後續的賣壓（例如融資斷頭單）持續湧出，若沒有新的買盤願意承接，股價就會再度觸及跌停。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"如何區分這是「洗盤」還是「真的出貨」？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"一般來說，健康的洗盤，股價不會離均價線太遠，且下跌時成交量會萎縮。但如果是真的出貨，股價通常會在均價線下方掙扎，且內盤成交量會持續放大，代表主力是鐵了心要賣。\"}]]}]]}]]]}]\n1d:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"總結來說，判斷跌停打開是機會或陷阱，核心在於辨識「買盤的真實性」與「賣壓的消化程度」。與其只看價格，不如專注在內外盤成交比、跌停委賣張數的變化，並以均價線作為多空強弱的分界，才能提高判斷的準確度。\"}]]]}]\n1e:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L17\",\"0-想深入了解籌碼分\",{\"href\":\"/school\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"想深入了解籌碼分點？台股學堂有完整教學\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L17\",\"0-利用「個股透視」\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"利用「個股透視」功能，追蹤每日分點進出\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L17\",\"0-不知道什麼是均價\",{\"href\":\"/learn\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"不知道什麼是均價線？來看我們的名詞解釋\"}]]}]]}]]]}]\n13:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\nf:null\n1f:I[80622,[],\"IconMark\"]\n11:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"跌停打開時盤口怎麼看？3 步驟判斷是撿便宜還是逃命波｜股市大佬 TradeBoss\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"一檔股票跌停鎖死，突然盤中爆量打開，是機會來了還是更大的危機？很多人看到價格變便宜就衝動進場，結果股價繼續破底。這篇文章就是要教你，如何從盤口的掛單細節，判斷這是止跌訊號，還是主力出貨給你接的「逃命波」。\"}],[\"$\",\"link\",\"2\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}],[\"$\",\"$L1f\",\"3\",{}]],\"error\":null,\"digest\":\"$undefined\"}\n16:\"$11:metadata\"\n"}