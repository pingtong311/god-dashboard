":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"加權指數小幅收跌，櫃買指數跌幅相對較深。\"}],[\"$\",\"li\",\"1\",{\"children\":\"玻璃陶瓷、數位雲端等族群今日表現較為強勢。\"}],[\"$\",\"li\",\"2\",{\"children\":\"半導體、電子通路等族群呈現走弱。\"}],[\"$\",\"li\",\"3\",{\"children\":\"外資在台指期貨市場的淨空單部位較高。\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、大盤指數表現概況\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"今日台股大盤呈現開高走低，加權指數最終收盤下跌，而上櫃市場的櫃買指數跌幅則更為明顯。整體上市股票下跌家數遠多於上漲家數，顯示市場氣氛偏向保守。\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"指數名稱\"}],[\"$\",\"th\",\"1\",{\"children\":\"收盤價\"}],[\"$\",\"th\",\"2\",{\"children\":\"漲跌幅\"}],[\"$\",\"th\",\"3\",{\"children\":\"漲跌家數\"}],[\"$\",\"th\",\"4\",{\"children\":\"成交金額\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"加權指數\"}],[\"$\",\"td\",\"1\",{\"children\":\"45811.01\"}],[\"$\",\"td\",\"2\",{\"children\":\"-0.45%\"}],[\"$\",\"td\",\"3\",{\"children\":\"上漲285、下跌653\"}],[\"$\",\"td\",\"4\",{\"children\":\"約10233.0億\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"櫃買指數\"}],[\"$\",\"td\",\"1\",{\"children\":\"400.95\"}],[\"$\",\"td\",\"2\",{\"children\":\"-1.27%\"}],[\"$\",\"td\",\"3\",{\"children\":\"資料未提供\"}],[\"$\",\"td\",\"4\",{\"children\":\"資料未提供\"}]]}]]}]]}]}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、盤面族群強弱分析\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"在大盤整體走弱的背景下，今日盤面仍有部分族群展現相對強勢，例如玻璃陶瓷與數位雲端類股，而半導體族群則承受較大賣壓。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"玻璃陶瓷族群上漲2.22%，其中和成（1810）漲幅接近一成。\"}],[\"$\",\"li\",\"1\",{\"children\":\"數位雲端類股上漲2.09%，由智通*（8932）領漲。\"}],[\"$\",\"li\",\"2\",{\"children\":\"航運業上漲1.63%，漢翔（2634）表現強勢。\"}],[\"$\",\"li\",\"3\",{\"children\":\"存託憑證類股上漲1.26%，泰金寶-DR（9105）領漲。\"}]]}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、個股漲跌幅與當沖熱門\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"今日上市個股表現分歧，有股票漲幅較大，也有股票跌幅較深。在當沖交易方面，部分個股成交量相對自身過去交易量有顯著放大，顯示交易熱度集中。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"今日上市跌幅較大的股票包括揚博（2493）下跌9.96%、樺漢（6414）下跌9.76%等。\"}],[\"$\",\"li\",\"1\",{\"children\":\"當沖熱門股中，威聯通（量比24.0x）、廣寰科（量比15.6x）、東研信超（量比14.9x）等成交量比值較高。\"}]]}],[\"$\",\"div\",\"2\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"股票代號\"}],[\"$\",\"th\",\"1\",{\"children\":\"股票名稱\"}],\"$L18\",\"$L19\"]}]}],\"$L1a\"]}]}],\"$L1b\"]]}],\"$L1c\",\"$L1d\",\"$L1e\",\"$L1f\",\"$L20\"],null]}]]}]}]\n18:[\"$\",\"th\",\"2\",{\"children\":\"漲跌幅\"}]\n19:[\"$\",\"th\",\"3\",{\"children\":\"成交量\"}]\n1a:[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"1515\"}],[\"$\",\"td\",\"1\",{\"children\":\"力山\"}],[\"$\",\"td\",\"2\",{\"children\":\"+10.00%\"}],[\"$\",\"td\",\"3\",{\"children\":\"2850張\"}]]}],[\"$\",\"tr\",\"1\",{\"chil