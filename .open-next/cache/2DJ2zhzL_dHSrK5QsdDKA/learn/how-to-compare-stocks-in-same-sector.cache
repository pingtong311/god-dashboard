\\"next-size-adjust\\\",\\\"content\\\":\\\"\\\"}]],[\\\"$\\\",\\\"$L14\\\",null,{\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"hidden\\\":true,\\\"children\\\":[\\\"$\\\",\\\"$15\\\",null,{\\\"fallback\\\":null,\\\"children\\\":\\\"$L16\\\"}]}]}]]}]\\n\"])</script><script>self.__next_f.push([1,\"17:I[52619,[\\\"2619\\\",\\\"static/chunks/2619-04bc32f026a0d946.js\\\",\\\"6309\\\",\\\"static/chunks/app/learn/%5Bslug%5D/page-f7b99344f7e2ee16.js\\\"],\\\"\\\"]\\n\"])</script><script>self.__next_f.push([1,\"d:[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"LearnArticle_wrap__LIQ8G\\\",\\\"children\\\":[\\\"$\\\",\\\"article\\\",null,{\\\"className\\\":\\\"LearnArticle_article__2nBbk\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"LearnArticle_meta__etj_G\\\",\\\"children\\\":[[\\\"$\\\",\\\"$L17\\\",null,{\\\"className\\\":\\\"LearnArticle_cat__GQMlg\\\",\\\"href\\\":\\\"/learn?c=themes\\\",\\\"children\\\":\\\"題材專欄\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"LearnArticle_read__QEj6a\\\",\\\"children\\\":\\\"閱讀約 7 分鐘\\\"}]]}],[\\\"$\\\",\\\"h1\\\",null,{\\\"className\\\":\\\"LearnArticle_title__0_la8\\\",\\\"children\\\":\\\"同一族群不同個股差在哪？3 指標找出真龍頭\\\"}],[\\\"$\\\",\\\"details\\\",null,{\\\"className\\\":\\\"LearnArticle_toc__LcSAa\\\",\\\"children\\\":[[\\\"$\\\",\\\"summary\\\",null,{\\\"className\\\":\\\"LearnArticle_tocSummary__YBddG\\\",\\\"children\\\":\\\"本文目錄\\\"}],[\\\"$\\\",\\\"ol\\\",null,{\\\"className\\\":\\\"LearnArticle_tocList__Rq_Lz\\\",\\\"children\\\":[[\\\"$\\\",\\\"li\\\",\\\"sec-1\\\",{\\\"children\\\":[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"#sec-1\\\",\\\"children\\\":\\\"一、誰是老大？從市值與營收佔比找出族群龍頭\\\"}]}],[\\\"$\\\",\\\"li\\\",\\\"sec-2\\\",{\\\"children\\\":[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"#sec-2\\\",\\\"children\\\":\\\"二、錢往哪裡流？用「法人籌碼」看懂大戶心思\\\"}]}],[\\\"$\\\",\\\"li\\\",\\\"sec-3\\\",{\\\"children\\\":[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"#sec-3\\\",\\\"children\\\":\\\"三、誰的體質好？一張表比較「財務數據」優劣\\\"}]}],[\\\"$\\\",\\\"li\\\",\\\"sec-4\\\",{\\\"children\\\":[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"#sec-4\\\",\\\"children\\\":\\\"四、現在進場會太晚嗎？從「技術面位階」判斷風險\\\"}]}],[\\\"$\\\",\\\"li\\\",\\\"sec-5\\\",{\\\"children\\\":[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"#sec-5\\\",\\\"children\\\":\\\"五、產品純度差多少？檢視「應用場景」的細微差異\\\"}]}],[\\\"$\\\",\\\"li\\\",\\\"sec-6\\\",{\\\"children\\\":[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"#sec-6\\\",\\\"children\\\":\\\"常見問題 FAQ\\\"}]}],[\\\"$\\\",\\\"li\\\",\\\"sec-7\\\",{\\\"children\\\":[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"#sec-7\\\",\\\"children\\\":\\\"總結\\\"}]}],[\\\"$\\\",\\\"li\\\",\\\"sec-8\\\",{\\\"children\\\":[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"#sec-8\\\",\\\"children\\\":\\\"延伸閱讀\\\"}]}]]}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"LearnArticle_body__6B7Mb\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"LearnArticle_intro__ATV5c\\\",\\\"children\\\":\\\"打開看盤軟體，看到 AI 題材全面上漲，興奮地買進一檔，結果眼睜睜看著別支漲停，自己的卻沒動靜，甚至還下跌？明明是同一個族群，為什麼命運差這麼多？這篇文章就是要教你怎麼從一堆看起來都一樣的股票中，找出真正的強勢股。\\\"}],[[\\\"$\\\",\\\"figure\\\",\\\"figure-0\\\",{\\\"className\\\":\\\"LearnArticle_fig__uoT7r\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"LearnArticle_figFrame__jJ7E4\\\",\\\"children\\\":\\\"越後面越熱鬧，通常也越貴、越好離開佈局沒新聞命名故事出現擁擠人人都知退燒利多變鈍新聞出現時，常常已經不是第一段\\\"}],[\\\"$\\\",\\\"figcaption\\\",null,{\\\"className\\\":\\\"LearnArticle_figCap__LnUbb\\\",\\\"children\\\":\\\"示意圖｜題材四階段：佈局 → 命名 → 擁擠 → 退燒（教學結構，不是某檔實盤）\\\"}]]}]],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"LearnArticle_tldr__Br5BY\\\",\\\"children\\\":[[\\\"$\\\",\\\"b\\\",null,{\\\"className\\\":\\\"LearnArticle_tldrTitle__K5PBN\\\",\\\"children\\\":\\\"本文重點\\\"}],[\\\"$\\\",\\\"ul\\\",null,{\\\"className\\\":\\\"LearnArticle_tldrList__VSc2_\\\",\\\"children\\\":[[\\\"$\\\",\\\"li\\\",\\\"0\\\",{\\\"children\\\":\\\"同族群優先看龍頭：市值最大、該題材營收佔比最高的，通常是市場公認的領頭羊。\\\"}],[\\\"$\\\",\\\"li\\\",\\\"1\\\",{\\\"children\\\":\\\"法人籌碼是關鍵指標：觀察三大法人是否連續買超，法人重兵佈局的個股通常支撐較強。\\\"}],[\\\"$\\\",\\\"li\\\",\\\"2\\\",{\\\"children\\\":\\\"毛利率是公司的護城河：毛利率高的公司代表產品競爭力強，獲利能力較佳，股價更有底氣。\\\"}],[\\\"$\\\",\\\"li\\\",\\\"3\\\",{\\\"children\\\":\\\"股價位階決定風險：避免追高已經漲多、乖離過大的股票，尋找在相對低檔整理的可能更安全。\\\"}]]}]]}],[[\\\"$\\\",\\\"section\\\",\\\"sec-1\\\",{\\\"id\\\":\\\"sec-1\\\",\\\"className\\\":\\\"LearnArticle_section__hLVjU\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"LearnArticle_h2__NmJ08\\\",\\\"children\\\":\\\"一、誰是老大？從市值與營收佔比找出族群龍頭\\\"}],[[\\\"$\\\",\\\"p\\\",\\\"0\\\",{\\\"className\\\":\\\"LearnArticle_p__aZlQ1\\\",\\\"children\\\":\\\"當一個題材發酵時，市場資金通常會優先湧入最具代表性的「龍頭股」。龍頭股就像球隊的隊長，它漲、小弟們才會跟著動。判斷龍頭最簡單的方法，就是看「市值」和「題材營收佔比」。市值大的公司通常穩定性高、受法人青睞；而該項題材佔公司總營收的比例越高，代表股價與題材的連動性越強，反應也最直接。\\\"}],[\\\"$\\\",\\\"ul\\\",\\\"1\\\",{\\\"className\\\":\\\"LearnArticle_listCheck__xx1CF\\\",\\\"children\\\":[[\\\"$\\\",\\\"li\\\",\\\"0\\\",{\\\"children\\\":\\\"判斷方法：在同族群中，找出市值前三大的公司。\\\"}],[\\\"$\\\",\\\"li\\\",\\\"1\\\",{\\\"children\\\":\\\"數字門檻：該題材的產品線，營收佔比最好超過 30%，越高越好。\\\"}],[\\\"$\\\",\\\"li\\\",\\\"2\\\",{\\\"children\\\":\\\"常見錯誤：只看公司名氣，卻沒查證它在這個新題材中的實際貢獻度。\\\"}]]}]]]}],[\\\"$\\\",\\\"section\\\",\\\"sec-2\\\",{\\\"id\\\":\\\"sec-2\\\",\\\"className\\\":\\\"LearnArticle_section__hLVjU\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"LearnArticle_h2__NmJ08\\\",\\\"children\\\":\\\"二、錢往哪裡流？用「法人籌碼」看懂大戶心思\\\"}],[[\\\"$\\\",\\\"p\\\",\\\"0\\\",{\\\"className\\\":\\\"LearnArticle_p__aZlQ1\\\",\\\"children\\\":\\\"散戶的力量是螞蟻雄兵，但真正能推動股價的，還是握有大筆資金的法人（外資、投信、自營商）。當法人連續好幾天、甚至好幾週都在買進某檔股票，代表他們經過研究，看好這家公司的未來。反之，如果法人一直在賣，就算題材再熱，股價也很難有表現。你可以觀察「三大法人買賣超」這項數據，來判斷大戶的動向。\\\"}],[\\\"$\\\",\\\"ul\\\",\\\"1\\\",{\\\"className\\\":\\\"LearnArticle_listCheck__xx1CF\\\",\\\"children\\\":[[\\\"$\\\",\\\"li\\\",\\\"0\\\",{\\\"children\\\":\\\"判斷方法：觀察近 5 日、20 日的三大法人是「累積買超」還是「累積賣超」。\\\"}],[\\\"$\\\",\\\"li\\\",\\\"1\\\",{\\\"children\\\":\\\"數字門檻：投信連續買超 5 天以上，或外資持股比例超過 20%，通常代表籌碼相對穩定。\\\"}],[\\\"$\\\",\\\"li\\\",\\\"2\\\",{\\\"children\\\":\\\"常見錯誤：只看一天的買賣超就下定論，忽略了長期趨勢的重要性。\\\"}]]}]]]}],[\\\"$\\\",\\\"section\\\",\\\"sec-3\\\",{\\\"id\\\":\\\"sec-3\\\",\\\"className\\\":\\\"LearnArticle_section__hLVjU\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"LearnArticle_h2__NmJ08\\\",\\\"children\\\":\\\"三、誰的體質好？一張表比較「財務數據」優劣\\\"}],[[\\\"$\\\",\\\"p\\\",\\\"0\\\",{\\\"className\\\":\\\"LearnArticle_p__aZlQ1\\\",\\\"children\\\":\\\"題材是煙火，財報才是公司的底氣。兩家同樣做伺服器的公司，獲利能力可能天差地遠。我們可以比較幾項關鍵的財務指標，來評估誰的體質比較健康。「毛利率」看的是產品的競爭力；「營業利益率」看的是公司的經營效率；「每股盈餘 (EPS)」則直接反應了公司的賺錢能力。長期來看，財務狀況好的公司，股價才走得遠。\\\"}],\\\"$L18\\\",\\\"$L19\\\"]]}],\\\"$L1a\\\",\\\"$L1b\\\",\\\"$L1c\\\",\\\"$L1d\\\",\\\"$L1e\\\"],null]}]]}]}]\\n\"])</script><script>self.__next_f.push([1,\"18:[\\\"$\\\",\\\"div\\\",\\\"1\\\",{\\\"className\\\":\\\"LearnArticle_tblScroll__z9kbb\\\",\\\"children\\\":[\\\"$\\\",\\\"table\\\",null,{\\\"className\\\":\\\"LearnArticle_tbl__0yNgv\\\",\\\"children\\\":[[\\\"$\\\",\\\"thead\\\",null,{\\\"children\\\":[\\\"$\\\",\\\"tr\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"th\\\",\\\"0\\\",{\\\"children\\\":\\\"評估指標\\\"}],[\\\"$\\\",\\\"th\\\",\\\"1\\\",{\\\"children\\\":\\\"A 公司 (龍頭型)\\\"}],[\\\"$\\\",\\\"th\\\",\\\"2\\\",{\\\"children\\\":\\\"B 公司 (跟風型)\\\"}]]}]}],[\\\"$\\\",\\\"tbody\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"tr\\\",\\\"0\\\",{\\\"children\\\":[[\\\"$\\\",\\\"td\\\",\\\"0\\\",{\\\"children\\\":\\\"毛利率\\\"}],[\\\"$\\\",\\\"td\\\",\\\"1\\\",{\\\"children\\\":\\\"45% (產品有獨特性)\\\"}],[\\\"$\\\",\\\"td\\\",\\\"2\\\",{\\\"children\\\":\\\"15% (薄利多銷)\\\"}]]}],[\\\"$\\\",\\\"tr\\\",\\\"1\\\",{\\\"children\\\":[[\\\"$\\\",\\\"td\\\",\\\"0\\\",{\\\"children\\\":\\\"法人持股比例\\\"}],[\\\"$\\\",\\\"td\\\",\\\"1\\\",{\\\"children\\\":\\\"40%\\\"}],[\\\"$\\\",\\\"td\\\",\\\"2\\\",{\\\"children\\\":\\\"5%\\\"}]]}],[\\\"$\\\",\\\"tr\\\",\\\"2\\\",{\\\"children\\\":[[\\\"$\\\",\\\"td\\\",\\\"0\\\",{\\\"children\\\":\\\"股價位階\\\"}],[\\\"$\\\",\\\"td\\\",\\\"1\\\",{\\\"children\\\":\\\"已創波段新高\\\"}],[\\\"$\\\",\\\"td\\\",\\\"2\\\",{\\\"children\\\":\\\"仍在年線下掙扎\\\"}]]}],[\\\"$\\\",\\\"tr\\\",\\\"3\\\",{\\\"children\\\":[[\\\"$\\\",\\\"td\\\",\\\"0\\\",{\\\"children\\\":\\\"題材營收佔比\\\"}],[\\\"$\\\",\\\"td\\\",\\\"1\\\",{\\\"children\\\":\\\"主要業務 (60%)\\\"}],[\\\"$\\\",\\\"td\\\",\\\"2\\\",{\\\"children\\\":\\\"非核心業務 (10%)\\\"}]]}]]}]]}]}]\\n\"])</script><script>self.__next_f.push([1,\"19:[\\\"$\\\",\\\"figure\\\",\\\"2\\\",{\\\"className\\\":\\\"LearnArticle_fig__uoT7r\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"LearnArticle_figFrame__jJ7E4\\\",\\\"children\\\":\\\"✓題材營收貢獻低✓法人持續在賣超✓毛利率逐季下滑✓股價在均線之下\\\"}],[\\\"$\\\",\\\"figcaption\\\",null,{\\\"className\\\":\\\"LearnArticle_figCap__LnUbb\\\",\\\"children\\\":\\\"避開弱勢股的檢查清單\\\"}]]}]\\n\"])</script><script>self.__next_f.push([1,\"1a:[\\\"$\\\",\\\"section\\\",\\\"sec-4\\\",{\\\"id\\\":\\\"sec-4\\\",\\\"className\\\":\\\"LearnArticle_section__hLVjU\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"LearnArticle_h2__NmJ08\\\",\\\"children\\\":\\\"四、現在進場會太晚嗎？從「技術面位階」判斷風險\\\"}],[[\\\"$\\\",\\\"p\\\",\\\"0\\\",{\\\"className\\\":\\\"LearnArticle_p__aZlQ1\\\",\\\"children\\\":\\\"就算選對了績優股，買在不對的時間點，還是可能賠錢。技術面位階，簡單說就是股價現在是「高」還是「低」。一檔股票如果已經連續大漲，遠離所有均線（如上圖的 K 線與均線乖離過大），這時候再追進去，風險就很高，很容易買在最高點。相對的，如果股價還在長期均線（例如季線、年線）附近打底、整理，代表風險較低，未來上漲的空間也比較大。\\\"}],[\\\"$\\\",\\\"ul\\\",\\\"1\\\",{\\\"className\\\":\\\"LearnArticle_listCheck__xx1CF\\\",\\\"children\\\":[[\\\"$\\\",\\\"li\\\",\\\"0\\\",{\\\"children\\\":\\\"判斷方法：觀察目前股價相對於月線 (20MA) 與季線 (60MA) 的位置。\\\"}],[\\\"$\\\",\\\"li\\\",\\\"1\\\",{\\\"children\\\":\\\"數字門檻：股價離季線超過 20% 以上，就算「高乖離」，追高風險大。\\\"}],[\\\"$\\\",\\\"li\\\",\\\"2\\\",{\\\"children\\\":\\\"常見錯誤：看到大紅 K 棒就衝動買進，沒有評估自己是買在山頂還是山腰。\\\"}]]}]]]}]\\n\"])</script><script>self.__next_f.push([1,\"1b:[\\\"$\\\",\\\"section\\\",\\\"sec-5\\\",{\\\"id\\\":\\\"sec-5\\\",\\\"className\\\":\\\"LearnArticle_section__hLVjU\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"LearnArticle_h2__NmJ08\\\",\\\"children\\\":\\\"五、產品純度差多少？檢視「應用場景」的細微差異\\\"}],[[\\\"$\\\",\\\"p\\\",\\\"0\\\",{\\\"className\\\":\\\"LearnArticle_p__aZlQ1\\\",\\\"children\\\":\\\"即使在同一個族群，各家公司專注的細分領域也可能不同。例如，同樣是「AI 晶片」概念股，有些公司做的是最高階的 GPU 核心設計，有些則是做周邊的散熱或封裝測試。前者的「純度」最高，股價爆發力最強；後者雖然也受惠，但連動性就沒那麼直接。花點時間去了解公司產品的實際應用，能幫助你更精準地抓住主流。\\\"}],[\\\"$\\\",\\\"ul\\\",\\\"1\\\",{\\\"className\\\":\\\"LearnArticle_list__WjxqC\\\",\\\"children\\\":[[\\\"$\\\",\\\"li\\\",\\\"0\\\",{\\\"children\\\":\\\"判斷方法：閱讀券商報告或公司的法說會簡報，了解主要產品線與客戶。\\\"}],[\\\"$\\\",\\\"li\\\",\\\"1\\\",{\\\"children\\\":\\\"帶得走的東西：問自己一個問題：「如果這個題材消失，這家公司的獲利會掉多少？」掉越多的，純度越高，當然風險也越集中。\\\"}]]}]]]}]\\n\"])</script><script>self.__next_f.push([1,\"1c:[\\\"$\\\",\\\"section\\\",\\\"sec-6\\\",{\\\"id\\\":\\\"sec-6\\\",\\\"className\\\":\\\"LearnArticle_section__hLVjU\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"LearnArticle_h2__NmJ08\\\",\\\"children\\\":\\\"常見問題 FAQ\\\"}],[[\\\"$\\\",\\\"div\\\",\\\"0\\\",{\\\"className\\\":\\\"LearnArticle_faq__cemBp\\\",\\\"children\\\":[[\\\"$\\\",\\\"details\\\",\\\"0\\\",{\\\"className\\\":\\\"LearnArticle_faqItem__I9h0U\\\",\\\"children\\\":[[\\\"$\\\",\\\"summary\\\",null,{\\\"children\\\":\\\"龍頭股股價通常比較高，小資族是不是買二線或三線股比較好？\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"LearnArticle_faqA__IPuvc\\\",\\\"children\\\":\\\"股價高低不等於貴或便宜。龍頭股雖然單價高，但通常營運穩健、風險較低。二三線股價格較低，但波動大、不確定性也高。重點在於資產配置與風險承受度，而不是只看股價絕對數字。\\\"}]]}],[\\\"$\\\",\\\"details\\\",\\\"1\\\",{\\\"className\\\":\\\"LearnArticle_faqItem__I9h0U\\\",\\\"children\\\":[[\\\"$\\\",\\\"summary\\\",null,{\\\"children\\\":\\\"如果整個族群都在跌，可以挑一檔基本面最好的「逢低承接」嗎？\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"LearnArticle_faqA__IPuvc\\\",\\\"children\\\":\\\"當整個族群趨勢向下時，即便是體質最好的公司也難以倖免，這就是所謂的「系統性風險」。在趨勢不明朗時，空手觀望往往是更好的選擇，等待族群整體出現止跌訊號再進場也不遲。\\\"}]]}],[\\\"$\\\",\\\"details\\\",\\\"2\\\",{\\\"className\\\":\\\"LearnArticle_faqItem__I9h0U\\\",\\\"children\\\":[[\\\"$\\\",\\\"summary\\\",null,{\\\"children\\\":\\\"要怎麼快速知道誰是市場公認的龍頭？\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"LearnArticle_faqA__IPuvc\\\",\\\"children\\\":\\\"除了自己查詢市值排行外，最快的方式是觀察財經新聞報導。當一個新題材出現時，媒體通常會直接點名相關供應鏈與最具代表性的龍頭企業，這可以做為您初步研究的起點。\\\"}]]}],[\\\"$\\\",\\\"details\\\",\\\"3\\\",{\\\"className\\\":\\\"LearnArticle_faqItem__I9h0U\\\",\\\"children\\\":[[\\\"$\\\",\\\"summary\\\",null,{\\\"children\\\":\\\"為什麼有時候龍頭股不動，反而是小股票漲得比較兇？\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"LearnArticle_faqA__IPuvc\\\",\\\"children\\\":\\\"這種情況稱為「輪動」。通常題材剛開始時由龍頭股領漲，當龍頭股漲多休息時，資金會外溢到尚未發動的二線、三線股。但這種輪動的節奏很難抓，且風險較高，追逐落後補漲的股票要特別小心。\\\"}]]}]]}]]]}]\\n\"])</script><script>self.__next_f.push([1,\"1d:[\\\"$\\\",\\\"section\\\",\\\"sec-7\\\",{\\\"id\\\":\\\"sec-7\\\",\\\"className\\\":\\\"LearnArticle_section__hLVjU\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"LearnArticle_h2__NmJ08\\\",\\\"children\\\":\\\"總結\\\"}],[[\\\"$\\\",\\\"p\\\",\\\"0\\\",{\\\"className\\\":\\\"LearnArticle_p__aZlQ1\\\",\\\"children\\\":\\\"總結來說，挑選同一族群的股票，就像在球隊裡選明星球員。優先選擇那位身強體壯（財務好）、教練團看好（法人買）、而且正在場上活躍（位階強勢）的核心王牌，而不是坐在板凳上的候補球員。\\\"}]]]}]\\n1e:[\\\"$\\\",\\\"section\\\",\\\"sec-8\\\",{\\\"id\\\":\\\"sec-8\\\",\\\"className\\\":\\\"LearnArticle_section__hLVjU\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"LearnArticle_h2__NmJ08\\\",\\\"children\\\":\\\"延伸閱讀\\\"}],[[\\\"$\\\",\\\"ul\\\",\\\"0\\\",{\\\"className\\\":\\\"LearnArticle_list__WjxqC\\\",\\\"children\\\":[[\\\"$\\\",\\\"li\\\",\\\"0\\\",{\\\"children\\\":[[\\\"$\\\",\\\"$L17\\\",\\\"0-用「族群透視」功\\\",{\\\"href\\\":\\\"/diary\\\",\\\"className\\\":\\\"LearnArticle_link__gMwHV\\\",\\\"children\\\":\\\"用「族群透視」功能，快速找出各產業龍頭\\\"}]]}],[\\\"$\\\",\\\"li\\\",\\\"1\\\",{\\\"children\\\":[[\\\"$\\\",\\\"$L17\\\",\\\"0-深入研究個股的籌\\\",{\\\"href\\\":\\\"/diary\\\",\\\"className\\\":\\\"LearnArticle_link__gMwHV\\\",\\\"children\\\":\\\"深入研究個股的籌碼與財務狀況\\\"}]]}],[\\\"$\\\",\\\"li\\\",\\\"2\\\",{\\\"children\\\":[[\\\"$\\\",\\\"$L17\\\",\\\"0-更多台股名詞解釋\\\",{\\\"href\\\":\\\"/school\\\",\\\"className\\\":\\\"LearnArticle_link__gMwHV\\\",\\\"children\\\":\\\"更多台股名詞解釋，都在台股學堂\\\"}]]}]]}]]]}]\\n\"])</script><script>self.__next_f.push([1,\"13:[[\\\"$\\\",\\\"meta\\\",\\\"0\\\",{\\\"charSet\\\":\\\"utf-8\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"1\\\",{\\\"name\\\":\\\"viewport\\\",\\\"content\\\":\\\"width=device-width, initial-scale=1\\\"}]]\\nf:null\\n\"])</script><script>self.__next_f.push([1,\"1f:I[80622,[],\\\"IconMark\\\"]\\n11:{\\\"metadata\\\":[[\\\"$\\\",\\\"title\\\",\\\"0\\\",{\\\"children\\\":\\\"同一族群不同個股差在哪？3 指標找出真龍頭｜股市大佬 TradeBoss\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"1\\\",{\\\"name\\\":\\\"description\\\",\\\"content\\\":\\\"打開看盤軟體，看到 AI 題材全面上漲，興奮地買進一檔，結果眼睜睜看著別支漲停，自己的卻沒動靜，甚至還下跌？明明是同一個族群，為什麼命運差這麼多？這篇文章就是要教你怎麼從一堆看起來都一樣的股票中，找出真正的強勢股。\\\"}],[\\\"$\\\",\\\"link\\\",\\\"2\\\",{\\\"rel\\\":\\\"icon\\\",\\\"href\\\":\\\"/favicon.ico\\\",\\\"type\\\":\\\"image/x-icon\\\",\\\"sizes\\\":\\\"16x16\\\"}],[\\\"$\\\",\\\"$L1f\\\",\\\"3\\\",{}]],\\\"error\\\":null,\\\"digest\\\":\\\"$undefined\\\"}\\n\"])</script><script>self.__next_f.push([1,\"16:\\\"$11:metadata\\\"\\n\"])</script></body></html>","rsc":"1:\"$Sreact.fragment\"\n2:I[81259,[\"2619\",\"static/chunks/2619-04bc32f026a0d946.js\",\"7177\",\"static/chunks/app/layout-4382c12d510386d3.js\"],\"default\"]\n3:I[89379,[\"2619\",\"static/chunks/2619-04bc32f026a0d946.js\",\"7177\",\"static/chunks/app/layout-4382c12d510386d3.js\"],\"default\"]\n4:I[9766,[],\"\"]\n5:I[98924,[],\"\"]\n6:I[10021,[\"2619\",\"static/chunks/2619-04bc32f026a0d946.js\",\"7177\",\"static/chunks/app/layout-4382c12d510386d3.js\"],\"default\"]\n7:I[10528,[\"2619\",\"static/chunks/2619-04bc32f026a0d946.js\",\"7177\",\"static/chunks/app/layout-4382c12d510386d3.js\"],\"default\"]\n8:I[50861,[\"2619\",\"static/chunks/2619-04bc32f026a0d946.js\",\"7177\",\"static/chunks/app/layout-4382c12d510386d3.js\"],\"default\"]\nc:I[57150,[],\"\"]\n:HL[\"/_next/static/media/3d26d2f3aa81a833-s.p.woff2\",\"font\",{\"crossOri