",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$15\",null,{\"fallback\":null,\"children\":\"$L16\"}]}]}]]}]\n17:I[52619,[\"2619\",\"static/chunks/2619-04bc32f026a0d946.js\",\"6309\",\"static/chunks/app/learn/%5Bslug%5D/page-f7b99344f7e2ee16.js\"],\"\"]\nd:[\"$\",\"div\",null,{\"className\":\"LearnArticle_wrap__LIQ8G\",\"children\":[\"$\",\"article\",null,{\"className\":\"LearnArticle_article__2nBbk\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_meta__etj_G\",\"children\":[[\"$\",\"$L17\",null,{\"className\":\"LearnArticle_cat__GQMlg\",\"href\":\"/learn?c=rules\",\"children\":\"制度與工具\"}],[\"$\",\"span\",null,{\"className\":\"LearnArticle_read__QEj6a\",\"children\":\"閱讀約 7 分鐘\"}]]}],[\"$\",\"h1\",null,{\"className\":\"LearnArticle_title__0_la8\",\"children\":\"胃納量是什麼？成交量大就是好？3 個數字看懂主力是真買還是倒貨\"}],[\"$\",\"details\",null,{\"className\":\"LearnArticle_toc__LcSAa\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"LearnArticle_tocSummary__YBddG\",\"children\":\"本文目錄\"}],[\"$\",\"ol\",null,{\"className\":\"LearnArticle_tocList__Rq_Lz\",\"children\":[[\"$\",\"li\",\"sec-1\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-1\",\"children\":\"一、胃納量是什麼？為什麼比單看成交量更重要？\"}]}],[\"$\",\"li\",\"sec-2\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-2\",\"children\":\"二、如何判斷胃納量強弱？從 3 個關鍵數字下手\"}]}],[\"$\",\"li\",\"sec-3\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-3\",\"children\":\"三、小心！這兩種「爆量上漲」可能是胃納量陷阱\"}]}],[\"$\",\"li\",\"sec-4\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-4\",\"children\":\"四、實戰應用：如何用胃納量評估進場時機？\"}]}],[\"$\",\"li\",\"sec-5\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-5\",\"children\":\"五、如何用股市大佬工具，快速掌握胃納量？\"}]}],[\"$\",\"li\",\"sec-6\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-6\",\"children\":\"常見問題 FAQ\"}]}],[\"$\",\"li\",\"sec-7\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-7\",\"children\":\"總結\"}]}],[\"$\",\"li\",\"sec-8\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-8\",\"children\":\"延伸閱讀\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"LearnArticle_body__6B7Mb\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_intro__ATV5c\",\"children\":\"看到某檔股票突然爆出大量、股價往上衝，心裡很癢想跟著進場，又怕是主力在出貨給你，買了就套牢？光看成交量紅棒還不夠，你得看懂市場的「胃納量」，才知道這股買氣是真是假。\"}],[[\"$\",\"figure\",\"figure-0\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"柱子高＝成交多；顏色只是示意，不是買賣建議先問「量從哪來」，再問「價往哪走」\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"示意圖｜量價：價漲量增比較像有人在成交，價漲量縮要降權重（教學結構，不是某檔實盤）\"}]]}]],[\"$\",\"div\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"「胃納量」指市場能吸收多少賣壓，反映買盤的真實力道，比單看成交量更深入。\"}],[\"$\",\"li\",\"1\",{\"children\":\"成交量大不等於胃納量強，要搭配內外盤比與大單流向，判斷成交量的「品質」。\"}],[\"$\",\"li\",\"2\",{\"children\":\"當股價上漲但胃納量縮小（如外盤成交比重下降），可能是買盤力竭的警訊。\"}],[\"$\",\"li\",\"3\",{\"children\":\"計算「大單淨量」比只看總成交量，更能看出大戶的真實動向是買進還是賣出。\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、胃納量是什麼？為什麼比單看成交量更重要？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"所謂「胃納量」，白話說就是市場「消化賣壓」的能力。想像一下，市場上想賣股票的人，就像不斷倒進杯子裡的水（賣壓），而底下願意承接的買盤，就是杯子的大小（胃納量）。如果買盤實力堅強，再大的賣壓都能吸收，股價就不容易下跌；反之，如果杯子很小，一點點賣壓就滿出來，股價自然會往下掉。只看成交量，你只知道水量很多，卻不知道杯子夠不夠大，這就是為什麼要懂胃納量。\"}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、如何判斷胃納量強弱？從 3 個關鍵數字下手\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"判斷胃納量不是憑感覺，而是有具體的數字可以觀察。下次看到股票放量時，不要急著下單，先花三十秒檢查這三個指標，就能知道市場的買氣是真是假。這三個數字能幫你判斷當天的買盤品質，是散戶的激情，還是大戶的實力。\"}],[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"觀察內外盤比：外盤成交，代表買方願意用較高的「委賣價」去買，意願積極；內盤成交，代表賣方願意用較低的「委買價」去賣，心態偏弱。如果外盤成交量遠大於內盤，例如佔比超過 60%，就代表買盤追價意願強，胃納量充足。\"}],[\"$\",\"li\",\"1\",{\"children\":\"計算大單淨量：這是觀察主力動向的利器。把盤中所有大單的買進成交量，減去大單的賣出成交量，得出的淨值。如果數字是正的，代表大戶站在買方；如果是負的，代表大戶正在出貨。這比看總成交量更能反映關鍵參與者的意圖。\"}],[\"$\",\"li\",\"2\",{\"children\":\"對比成交量與股本：用「換手率」來衡量交易熱度。換手率是「當日成交量 ÷ 在外流通股數」。一般來說，換手率在 3% 以下算低迷，5-10% 算活躍，超過 10% 就算非常熱絡，代表市場高度關注，但也可能暗藏風險。\"}]]}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、小心！這兩種「爆量上漲」可能是胃納量陷阱\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"看到爆量就興奮，是很多散戶常犯的錯誤。有些時候，巨大的成交量反而是危險的信號，代表多空激戰或主力在出貨。學會辨識以下這兩種情況，可以幫你避開許多追高的風險，保住你的本金。\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[\"$L18\",\"$L19\"]}]}],\"$L1a\"]]}],\"$L1b\",\"$L1c\",\"$L1d\",\"$L1e\",\"$L1f\"],null]}]]}]}]\n18:[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"危險訊號\"}],[\"$\",\"th\",\"1\",{\"children\":\"背後可能意義\"}],[\"$\",\"th\",\"2\",{\"children\":\"散戶應對策略\"}]]}]}]\n19:[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"價漲量增，但外盤比重下降\"}],[\"$\",\"td\",\"1\",{\"children\":\"買盤追價力道減弱，可能是主力邊拉抬股價邊出貨，用大單敲外盤製造假象，但實際賣壓沉重。\"}],[\"$\",\"td\",\"2\",{\"children\":\"提高警覺，不宜在此時過度追高，可觀察後續大單淨量是否轉負。\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"高檔爆量收長上影線或十字線\"}],[\"$\",\"td\",\"1\",{\"children\":\"股價開高走低，代表當天買盤雖然強勁，但上方的賣壓更重，導致買氣後繼無力，胃納量不足以消化賣壓。\"}],[\"$\",\"td\",\"2\",{\"children\":\"等待趨勢更明確，避免在多空轉折點猜方向，可等股價站穩壓力區再考慮。\"}]]}]]}]\n1a:[\"$\",\"figure\",\"2\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"!價漲但外盤比下降!高檔爆量收長上影線!大單淨量由正轉負\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"小心！胃納量縮小警訊\"}]]}]\n1b:[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、實戰應用：如何用胃納量評估進場時機？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"假設一檔股價在盤整區底部橫盤了三週，某天突然帶量上攻。這時你該怎麼判斷是玩真的，還是曇花一現？你可以這樣評估：首先，成交量是否是過去五日均量的 2-3 倍以上？其次，打開內外盤分析，外盤成交佔比是否超過 60%？最後，也是最關鍵的，觀察「大單淨量」是否為正值，且持續增加。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"情境假設：一檔股價從 100 元漲到 103 元，成交量是五日均量的 3 倍。\"}],[\"$\",\"li\",\"1\",{\"children\":\"數據檢視：盤中觀察到外盤成交佔了 70%，且「大單淨量」顯示淨買超 800 張。\"}],[\"$\",\"li\",\"2\",{\"children\":\"綜合判斷：這代表市場不僅有量，而且是「有品質的量」。買方願意追價，大戶也在同步進場，顯示胃納量充足，短期趨勢可能真的要發動了。\"}]]}]]]}]\n1c:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、如何用股市大佬工具，快速掌握胃納量？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"要在盤中自己一筆一筆算大單流向，不但花時間，也容易算錯。在股市大佬的「個股透視」頁面，我們已經把內外盤比和大戶籌碼動向整理成視覺化圖表。你不用再盯著跳動的數字，可以直接看到最關鍵的結果，做出更有效率的判斷。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"你可以直接看到「大單淨量」的紅綠棒圖，紅色代表大戶買超，綠色代表賣超，一眼就能判斷當天的主力站在哪一邊，不用再自己辛苦加總。這能幫你快速確認買盤的品質，過濾掉許多無效的交易訊號。\"}]]}]]]}]\n1d:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"胃納量跟「換手率」有什麼不同？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"換手率（或稱周轉率）是計算胃納量的基礎之一，它只告訴我們「交易有多熱絡」。但胃納量更進一步，會去分析這些成交量的「品質」，例如是買盤積極還是賣盤殺出，所以比單看換手率更能判斷真實的多空力道。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"胃納量只適用於當沖或短線交易嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"胃納量對短線交易者判斷當日力道特別有用。但對波段或長線投資人來說，觀察一段時間（如一週）的胃納量變化，也能看出籌碼是趨向集中還是分散，作為判斷趨勢是否健康的參考之一。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"如果成交量很小，胃納量還有參考價值嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"成交量太小的股票，胃納量指標容易失真。因為只要一兩筆稍大的單，就可能大幅影響內外盤比等數據，不具統計代表性。建議將此方法應用在日均量至少有 500 張以上的個股，參考價值會比較高。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"盤中看胃納量，跟盤後看籌碼分點有什麼不一樣？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"盤中看胃納量是即時感受市場買賣氣氛，幫助判斷「當下」的力道，適合做當下的決策。盤後看籌碼分點，則是事後驗證這些買盤是來自哪些券商、是集中還是分散，屬於更深度的籌碼分析，兩者可以互補使用。\"}]]}]]}]]]}]\n1e:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"總結來說，別再只看成交量紅棒就衝動進場。學會從「內外盤比」和「大單淨量」來評估市場的胃納量，才能分辨出真正的攻擊訊號，避開主力倒貨的陷阱。\"}]]]}]\n1f:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L17\",\"0-想深入了解籌碼分\",{\"href\":\"/school\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"想深入了解籌碼分析？來台股學堂打好基礎\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L17\",\"0-立即查看任一個股\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"立即查看任一個股的即時內外盤比與大單動向\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L17\",\"0-新手入門？從這裡\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"新手入門？從這裡開始學習看盤技巧\"}]]}]]}]]]}]\n13:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\nf:null\n20:I[80622,[],\"IconMark\"]\n11:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"胃納量是什麼？成交量大就是好？3 個數字看懂主力是真買還是倒貨｜股市大佬 TradeBoss\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"看到某檔股票突然爆出大量、股價往上衝，心裡很癢想跟著進場，又怕是主力在出貨給你，買了就套牢？光看成交量紅棒還不夠，你得看懂市場的「胃納量」，才知道這股買氣是真是假。\"}],[\"$\",\"link\",\"2\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}],[\"$\",\"$L20\",\"3\",{}]],\"error\":null,\"digest\":\"$undefined\"}\n16:\"$11:metadata\"\n"}