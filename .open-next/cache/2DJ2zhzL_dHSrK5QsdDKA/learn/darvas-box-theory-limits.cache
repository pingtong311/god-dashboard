hildren\":\"四、能留的最小觀念\"}]}],[\"$\",\"li\",\"sec-5\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-5\",\"children\":\"五、最小動作\"}]}],[\"$\",\"li\",\"sec-6\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-6\",\"children\":\"常見問題 FAQ\"}]}],[\"$\",\"li\",\"sec-7\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-7\",\"children\":\"總結\"}]}],[\"$\",\"li\",\"sec-8\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-8\",\"children\":\"延伸閱讀\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"LearnArticle_body__6B7Mb\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_intro__ATV5c\",\"children\":\"尼古拉·達瓦斯的公開自述裡，有一套後來被叫成箱子理論的做法：價格在區間裡來回，他當它在箱子裡；離開箱子才考慮動作。故事好講，因為箱子看得見。比較少被放進標題的是：他所處的市場深度、資訊速度與交易成本，都和今天的台股不同。看得見的框，最容易讓人忽略限制。\"}],[],[\"$\",\"div\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"箱子是對區間的假設，不是市場欠你的牆壁\"}],[\"$\",\"li\",\"1\",{\"children\":\"突破在薄市場與演算法時代，假的比例不會比較低\"}],[\"$\",\"li\",\"2\",{\"children\":\"畫框之前先問流動性與費用夠不夠付多次失敗\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、箱子本來在解決什麼\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"公開敘述裡，他要處理的是：不要在沒有方向的來回裡一直動作。箱子是「先承認現在沒有方向」的視覺化。這層仍然有用。有用的是承認震盪，不是相信框會守住。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"箱子先承認沒方向\"}],[\"$\",\"li\",\"1\",{\"children\":\"框不是牆壁\"}],[\"$\",\"li\",\"2\",{\"children\":\"少動作是原意之一\"}]]}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、三個限制\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"第一，資訊與撮合變快，大家都看得到的框，離開時更擠。第二，假突破是常態，不是例外，技術分析盲點與假突破兩篇寫過。第三，多次試錯的費用，在當沖稅費結構裡比他當年更咬人。\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"你以為的\"}],[\"$\",\"th\",\"1\",{\"children\":\"限制\"}],[\"$\",\"th\",\"2\",{\"children\":\"先怎麼辦\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"框會守住\"}],[\"$\",\"td\",\"1\",{\"children\":\"框是假設\"}],[\"$\",\"td\",\"2\",{\"children\":\"寫框破了怎麼辦\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"突破就真\"}],[\"$\",\"td\",\"1\",{\"children\":\"假突破常見\"}],[\"$\",\"td\",\"2\",{\"children\":\"要有失敗預算\"}]]}],[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"畫得愈細愈準\"}],[\"$\",\"td\",\"1\",{\"children\":\"愈細愈像事後\"}],[\"$\",\"td\",\"2\",{\"children\":\"先用較粗的區間\"}]]}],[\"$\",\"tr\",\"3\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"當年有效所以現在有效\"}],[\"$\",\"td\",\"1\",{\"children\":\"結構變了\"}],[\"$\",\"td\",\"2\",{\"children\":\"只留「少在箱內動作」\"}]]}]]}]]}]}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、為什麼畫框會變成定錨\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"線一畫上去，大腦就想捍衛。定錨那篇講過成本價與前高；箱子是同一種黏法。框破了還在解釋「假破」，常常是在保護自己的筆，不是在讀市場。\"}],[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"畫框時同時寫作廢\"}],[\"$\",\"li\",\"1\",{\"children\":\"破了先走規則\"}],[\"$\",\"li\",\"2\",{\"children\":\"再決定要不要重畫\"}]]}],[\"$\",\"figure\",\"2\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"✓沒方向少做✓框是假設✓先寫作廢\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"能留的\"}]]}]]]}],[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、能留的最小觀念\"}],[\"$L18\",\"$L19\"]]}],\"$L1a\",\"$L1b\",\"$L1c\",\"$L1d\"],\"$L1e\"]}]]}]}]\n18:[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"能留的是：沒方向時少動作。不能留的是：某一種畫法保證比較準。觀念很小，但違反「我一定要做點什麼」的衝動。\"}]\n19:[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"沒方向就少做\"}],[\"$\",\"li\",\"1\",{\"children\":\"畫法不是保證\"}],[\"$\",\"li\",\"2\",{\"children\":\"衝動才是敵人\"}]]}]\n1a:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、最小動作\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"若你現在有一個框，旁邊寫：這是假設、假破預算是幾次、流動性夠不夠你離開。三行寫不完，就先不要把框當成計畫。\"}]]]}]\n1b:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"箱子理論過時了嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"畫法會過時。「沒方向少動作」比較不過時。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"突破要不要等確認？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"等確認會錯過，不等會吃假突破。這是權衡，不是密技能消掉的。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"日線箱子和分線箱子能共用嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"週期不同，框的意義不同。共用口訣是常見誤用。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"和支撐壓力差在哪？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"都很易變成要捍衛的線。先寫失效，再談名字。\"}]]}]]}]]]}]\n1c:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"達瓦斯箱子的原意包含少在沒方向時動作。框不是牆壁。假突破、擁擠與費用是三個限制。先寫作廢再畫。\"}]]]}]\n1d:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L17\",\"0-假突破\",{\"href\":\"/learn/why-breakout-trades-often-fail\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"假突破\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L17\",\"0-支撐壓力\",{\"href\":\"/learn/support-resistance-how-to-draw\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"支撐壓力\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L17\",\"0-定錨效應\",{\"href\":\"/learn/anchoring-bias-in-trading\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"定錨效應\"}]]}]]}]]]}]\n1e:[\"$\",\"div\",null,{\"className\":\"LearnArticle_related__9qV55\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_relatedTitle__RXfrl\",\"children\":\"相關文章\"}],[[\"$\",\"$L17\",\"why-breakout-trades-often-fail\",{\"href\":\"/learn/why-breakout-trades-often-fail\",\"className\":\"LearnArticle_relatedLink__mibXe\",\"children\":\"假突破\"}],[\"$\",\"$L17\",\"support-resistance-how-to-draw\",{\"href\":\"/learn/support-resistance-how-to-draw\",\"c