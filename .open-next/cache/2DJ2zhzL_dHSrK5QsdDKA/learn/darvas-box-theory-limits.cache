,null,{\\\"className\\\":\\\"LearnArticle_toc__LcSAa\\\",\\\"children\\\":[[\\\"$\\\",\\\"summary\\\",null,{\\\"className\\\":\\\"LearnArticle_tocSummary__YBddG\\\",\\\"children\\\":\\\"本文目錄\\\"}],[\\\"$\\\",\\\"ol\\\",null,{\\\"className\\\":\\\"LearnArticle_tocList__Rq_Lz\\\",\\\"children\\\":[[\\\"$\\\",\\\"li\\\",\\\"sec-1\\\",{\\\"children\\\":[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"#sec-1\\\",\\\"children\\\":\\\"一、箱子本來在解決什麼\\\"}]}],[\\\"$\\\",\\\"li\\\",\\\"sec-2\\\",{\\\"children\\\":[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"#sec-2\\\",\\\"children\\\":\\\"二、三個限制\\\"}]}],[\\\"$\\\",\\\"li\\\",\\\"sec-3\\\",{\\\"children\\\":[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"#sec-3\\\",\\\"children\\\":\\\"三、為什麼畫框會變成定錨\\\"}]}],[\\\"$\\\",\\\"li\\\",\\\"sec-4\\\",{\\\"children\\\":[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"#sec-4\\\",\\\"children\\\":\\\"四、能留的最小觀念\\\"}]}],[\\\"$\\\",\\\"li\\\",\\\"sec-5\\\",{\\\"children\\\":[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"#sec-5\\\",\\\"children\\\":\\\"五、最小動作\\\"}]}],[\\\"$\\\",\\\"li\\\",\\\"sec-6\\\",{\\\"children\\\":[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"#sec-6\\\",\\\"children\\\":\\\"常見問題 FAQ\\\"}]}],[\\\"$\\\",\\\"li\\\",\\\"sec-7\\\",{\\\"children\\\":[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"#sec-7\\\",\\\"children\\\":\\\"總結\\\"}]}],[\\\"$\\\",\\\"li\\\",\\\"sec-8\\\",{\\\"children\\\":[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"#sec-8\\\",\\\"children\\\":\\\"延伸閱讀\\\"}]}]]}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"LearnArticle_body__6B7Mb\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"LearnArticle_intro__ATV5c\\\",\\\"children\\\":\\\"尼古拉·達瓦斯的公開自述裡，有一套後來被叫成箱子理論的做法：價格在區間裡來回，他當它在箱子裡；離開箱子才考慮動作。故事好講，因為箱子看得見。比較少被放進標題的是：他所處的市場深度、資訊速度與交易成本，都和今天的台股不同。看得見的框，最容易讓人忽略限制。\\\"}],[],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"LearnArticle_tldr__Br5BY\\\",\\\"children\\\":[[\\\"$\\\",\\\"b\\\",null,{\\\"className\\\":\\\"LearnArticle_tldrTitle__K5PBN\\\",\\\"children\\\":\\\"本文重點\\\"}],[\\\"$\\\",\\\"ul\\\",null,{\\\"className\\\":\\\"LearnArticle_tldrList__VSc2_\\\",\\\"children\\\":[[\\\"$\\\",\\\"li\\\",\\\"0\\\",{\\\"children\\\":\\\"箱子是對區間的假設，不是市場欠你的牆壁\\\"}],[\\\"$\\\",\\\"li\\\",\\\"1\\\",{\\\"children\\\":\\\"突破在薄市場與演算法時代，假的比例不會比較低\\\"}],[\\\"$\\\",\\\"li\\\",\\\"2\\\",{\\\"children\\\":\\\"畫框之前先問流動性與費用夠不夠付多次失敗\\\"}]]}]]}],[[\\\"$\\\",\\\"section\\\",\\\"sec-1\\\",{\\\"id\\\":\\\"sec-1\\\",\\\"className\\\":\\\"LearnArticle_section__hLVjU\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"LearnArticle_h2__NmJ08\\\",\\\"children\\\":\\\"一、箱子本來在解決什麼\\\"}],[[\\\"$\\\",\\\"p\\\",\\\"0\\\",{\\\"className\\\":\\\"LearnArticle_p__aZlQ1\\\",\\\"children\\\":\\\"公開敘述裡，他要處理的是：不要在沒有方向的來回裡一直動作。箱子是「先承認現在沒有方向」的視覺化。這層仍然有用。有用的是承認震盪，不是相信框會守住。\\\"}],[\\\"$\\\",\\\"ul\\\",\\\"1\\\",{\\\"className\\\":\\\"LearnArticle_listCheck__xx1CF\\\",\\\"children\\\":[[\\\"$\\\",\\\"li\\\",\\\"0\\\",{\\\"children\\\":\\\"箱子先承認沒方向\\\"}],[\\\"$\\\",\\\"li\\\",\\\"1\\\",{\\\"children\\\":\\\"框不是牆壁\\\"}],[\\\"$\\\",\\\"li\\\",\\\"2\\\",{\\\"children\\\":\\\"少動作是原意之一\\\"}]]}]]]}],[\\\"$\\\",\\\"section\\\",\\\"sec-2\\\",{\\\"id\\\":\\\"sec-2\\\",\\\"className\\\":\\\"LearnArticle_section__hLVjU\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"LearnArticle_h2__NmJ08\\\",\\\"children\\\":\\\"二、三個限制\\\"}],[[\\\"$\\\",\\\"p\\\",\\\"0\\\",{\\\"className\\\":\\\"LearnArticle_p__aZlQ1\\\",\\\"children\\\":\\\"第一，資訊與撮合變快，大家都看得到的框，離開時更擠。第二，假突破是常態，不是例外，技術分析盲點與假突破兩篇寫過。第三，多次試錯的費用，在當沖稅費結構裡比他當年更咬人。\\\"}],[\\\"$\\\",\\\"div\\\",\\\"1\\\",{\\\"className\\\":\\\"LearnArticle_tblScroll__z9kbb\\\",\\\"children\\\":[\\\"$\\\",\\\"table\\\",null,{\\\"className\\\":\\\"LearnArticle_tbl__0yNgv\\\",\\\"children\\\":[[\\\"$\\\",\\\"thead\\\",null,{\\\"children\\\":[\\\"$\\\",\\\"tr\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"th\\\",\\\"0\\\",{\\\"children\\\":\\\"你以為的\\\"}],[\\\"$\\\",\\\"th\\\",\\\"1\\\",{\\\"children\\\":\\\"限制\\\"}],[\\