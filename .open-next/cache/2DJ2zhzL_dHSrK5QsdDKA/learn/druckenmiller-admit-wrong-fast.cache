"$\",\"a\",null,{\"href\":\"#sec-2\",\"children\":\"二、三個比方向更貴的代價\"}]}],[\"$\",\"li\",\"sec-3\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-3\",\"children\":\"三、快，靠的是事前句子\"}]}],[\"$\",\"li\",\"sec-4\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-4\",\"children\":\"四、和損失趨避是同一件事\"}]}],[\"$\",\"li\",\"sec-5\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-5\",\"children\":\"五、最小動作\"}]}],[\"$\",\"li\",\"sec-6\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-6\",\"children\":\"常見問題 FAQ\"}]}],[\"$\",\"li\",\"sec-7\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-7\",\"children\":\"總結\"}]}],[\"$\",\"li\",\"sec-8\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-8\",\"children\":\"延伸閱讀\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"LearnArticle_body__6B7Mb\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_intro__ATV5c\",\"children\":\"史坦利·德魯肯米勒在公開場合被問到教訓時，常回到同一句：錯了就要快承認。不是因為認錯比較道德，是因為留著錯的部位，會讓後面的判斷全部變形——你開始為了回本而看市場，不再為了現在的事實看市場。方向錯一次是成本；為了面子留著，是讓成本生利息。\"}],[],[\"$\",\"div\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"看錯是成本，留著錯是讓成本生利息\"}],[\"$\",\"li\",\"1\",{\"children\":\"回本目標會把下一筆也綁在舊錯誤上\"}],[\"$\",\"li\",\"2\",{\"children\":\"快認錯需要事先寫好的離開條件，不能靠當下勇氣\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、公開訪談在強調哪一種錯\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"他區分過「看法錯了」與「知道錯了還加碼或死守」。前者幾乎人人會遇到；後者才是帳戶常見的致命傷。傳播喜歡討論他看對過什麼，教材該停在他怎麼講看錯。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"看法錯是日常\"}],[\"$\",\"li\",\"1\",{\"children\":\"死守是選擇\"}],[\"$\",\"li\",\"2\",{\"children\":\"選擇比較貴\"}]]}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、三個比方向更貴的代價\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"第一，注意力被舊單佔走，新的事實看不進去。第二，為了回到成本，部位往往愈留愈大。第三，規則被當下心情改寫，後面的樣本不能用。三個代價疊在一起，檢討會變成「我方向其實對，只是時間不對」。\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"代價\"}],[\"$\",\"th\",\"1\",{\"children\":\"當下感覺\"}],[\"$\",\"th\",\"2\",{\"children\":\"帳戶實際在付\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"注意力被佔\"}],[\"$\",\"td\",\"1\",{\"children\":\"我在負責\"}],[\"$\",\"td\",\"2\",{\"children\":\"看不到新事實\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"為回本加碼\"}],[\"$\",\"td\",\"1\",{\"children\":\"成本下降\"}],[\"$\",\"td\",\"2\",{\"children\":\"同一筆錯誤變大\"}]]}],[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"改規則\"}],[\"$\",\"td\",\"1\",{\"children\":\"這次特殊\"}],[\"$\",\"td\",\"2\",{\"children\":\"樣本作廢\"}]]}],[\"$\",\"tr\",\"3\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"說時間不對\"}],[\"$\",\"td\",\"1\",{\"children\":\"還有希望\"}],[\"$\",\"td\",\"2\",{\"children\":\"失效條件被刪\"}]]}]]}]]}]}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、快，靠的是事前句子\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"當下認錯很痛，痛的時候人會找理由。所以快必須被寫成進場前的句子：怎樣算錯、誰有權叫我走。智慧單與失效條件兩篇，是這句話的工具版。人物故事只負責提醒：連被外界寫成很準的人，公開時仍把速度放在準度前面。\"}],[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"進場前寫作廢\"}],[\"$\",\"li\",\"1\",{\"children\":\"作廢就走\"}],[\"$\",\"li\",\"2\",{\"children\":\"走了才准解釋\"}]]}],[\"$\",\"figure\",\"2\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"✓怎樣算錯✓誰叫我走✓走了再解釋\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"事前寫好\"}]]}]]]}],[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、和損失趨避是同一件事\"}],[\"$L18\",\"$L19\"]]}],\"$L1a\",\"$L1b\",\"$L1c\",\"$L1d\"],\"$L1e\"]}]]}]}]\n18:[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"損失趨避讓人不肯做實虧損。認錯要快，就是在跟這個人性作對。作對不能靠喊話，要靠小到你做得動的上限。上限太大，快只是口號。\"}]\n19:[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"痛是預設\"}],[\"$\",\"li\",\"1\",{\"children\":\"上限要小到做得動\"}],[\"$\",\"li\",\"2\",{\"children\":\"口號改不了痛\"}]]}]\n1a:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、最小動作\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"翻最近一筆拖最久的虧，寫下你當時新找的理由。若理由不在進場前那張紙上，那就是這篇要擋的東西。\"}]]]}]\n1b:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"快認錯是不是賺不到大行情？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"大行情若理由還在，離開條件就還沒到。快的是理由沒了要走，不是漲了就要走。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"跟停損是不是同一句？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"停損是工具。認錯是決定用工具。沒寫在進場前，工具會在痛的時候被關。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"看對開頭後來錯了怎麼辦？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"開頭對過，不表示現在還對。以現在的條件重問，不要用舊高峰保護舊單。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"為什麼常被拿來跟索羅斯一起講？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"公開經歷有重疊。本篇只取「認錯要快」這一句能檢查的結構。\"}]]}]]}]]]}]\n1c:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"看錯是成本，留著錯會讓成本生利息。三個代價：注意力、加碼、改規則。快認錯要靠進場前的作廢句，不靠勇氣。\"}]]]}]\n1d:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L17\",\"0-損失趨避\",{\"href\":\"/learn/loss-aversion-in-trading\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"損失趨避\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L17\",\"0-失效條件\",{\"href\":\"/learn/write-invalidation-before-you-enter\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"失效條件\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L17\",\"0-都鐸瓊斯怎麼看風\",{\"href\":\"/learn/tudor-jones-risk-first-interviews\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"都鐸瓊斯怎麼看風險\"}]]}]]}]]]}]\n1e:[\"$\",\"div\",null,{\"className\":\"LearnArticle_related__9qV55\",\"children\":[[\"$\",\"p\",null,{\"classNam