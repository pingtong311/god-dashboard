"$undefined\",\"errorStyles\":\"$undefined\",\"errorScripts\":\"$undefined\",\"template\":[\"$\",\"$L5\",null,{}],\"templateStyles\":\"$undefined\",\"templateScripts\":\"$undefined\",\"notFound\":\"$undefined\",\"forbidden\":\"$undefined\",\"unauthorized\":\"$undefined\"}]]}]\na:[\"$\",\"$1\",\"c\",{\"children\":[\"$Ld\",[[\"$\",\"link\",\"0\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/css/3eaf36e367672966.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"$undefined\"}]],[\"$\",\"$Le\",null,{\"children\":[\"$Lf\",[\"$\",\"$L10\",null,{\"promise\":\"$@11\"}]]}]]}]\nb:[\"$\",\"$1\",\"h\",{\"children\":[null,[[\"$\",\"$L12\",null,{\"children\":\"$L13\"}],[\"$\",\"meta\",null,{\"name\":\"next-size-adjust\",\"content\":\"\"}]],[\"$\",\"$L14\",null,{\"children\":[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$15\",null,{\"fallback\":null,\"children\":\"$L16\"}]}]}]]}]\n17:I[52619,[\"2619\",\"static/chunks/2619-04bc32f026a0d946.js\",\"6309\",\"static/chunks/app/learn/%5Bslug%5D/page-f7b99344f7e2ee16.js\"],\"\"]\nd:[\"$\",\"div\",null,{\"className\":\"LearnArticle_wrap__LIQ8G\",\"children\":[\"$\",\"article\",null,{\"className\":\"LearnArticle_article__2nBbk\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_meta__etj_G\",\"children\":[[\"$\",\"$L17\",null,{\"className\":\"LearnArticle_cat__GQMlg\",\"href\":\"/learn?c=platform\",\"children\":\"平台教學\"}],[\"$\",\"span\",null,{\"className\":\"LearnArticle_read__QEj6a\",\"children\":\"閱讀約 6 分鐘\"}]]}],[\"$\",\"h1\",null,{\"className\":\"LearnArticle_title__0_la8\",\"children\":\"股市大佬紅綠燈怎麼看？3 個燈號顏色看懂多空強弱，避開追高殺低陷阱\"}],[\"$\",\"details\",null,{\"className\":\"LearnArticle_toc__LcSAa\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"LearnArticle_tocSummary__YBddG\",\"children\":\"本文目錄\"}],[\"$\",\"ol\",null,{\"className\":\"LearnArticle_tocList__Rq_Lz\",\"children\":[[\"$\",\"li\",\"sec-1\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-1\",\"children\":\"一、紅綠燈到底是什麼？為什麼我需要看這個？\"}]}],[\"$\",\"li\",\"sec-2\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-2\",\"children\":\"二、紅、黃、綠燈號，各自代表什麼意思？\"}]}],[\"$\",\"li\",\"sec-3\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-3\",\"children\":\"三、核心指標一：看懂「籌碼分數」抓主力動向\"}]}],[\"$\",\"li\",\"sec-4\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-4\",\"children\":\"四、核心指標二：用「量價分數」確認趨勢強度\"}]}],[\"$\",\"li\",\"sec-5\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-5\",\"children\":\"五、實戰應用：如何結合燈號與分數做判斷？\"}]}],[\"$\",\"li\",\"sec-6\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-6\",\"children\":\"常見問題 FAQ\"}]}],[\"$\",\"li\",\"sec-7\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-7\",\"children\":\"總結\"}]}],[\"$\",\"li\",\"sec-8\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-8\",\"children\":\"延伸閱讀\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"LearnArticle_body__6B7Mb\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_intro__ATV5c\",\"children\":\"打開股市大佬紅綠燈，一堆數字燈號不知道從何看起？本文教你用 3 個燈號顏色，快速判斷個股的多空力道與市場情緒，找出潛在的轉折機會。\"}],[],[\"$\",\"div\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"紅燈不代表馬上漲、綠燈不代表馬上跌，重點是燈號的「連續性」與「轉變」。\"}],[\"$\",\"li\",\"1\",{\"children\":\"「籌碼分數」是核心：看大戶是買還是賣，分數越高代表籌碼越集中。\"}],[\"$\",\"li\",\"2\",{\"children\":\"搭配「量價分數」一起看：有大戶進場，也要有成交量支持，趨勢才走得遠。\"}],[\"$\",\"li\",\"3\",{\"children\":\"黃燈是多空觀察期：代表市場正在猶豫，方向不明，適合多看少做。\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、紅綠燈到底是什麼？為什麼我需要看這個？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"簡單來說，紅綠燈系統就像是股票的「健康檢查報告」。它把影響股價的幾個重要因素，像是大戶買賣（籌碼面）、成交量與價格關係（量價面）、股價趨勢（技術面），全部量化成分數，最後用最直觀的紅、黃、綠燈號告訴你結論。對於不想鑽研複雜數字的投資人來說，這是一個快速掌握個股整體氣氛的好工具，讓你一眼就能看出現在是順風還是逆風。\"}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、紅、黃、綠燈號，各自代表什麼意思？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"這三個顏色就像馬路上的紅綠燈，概念很簡單。紅燈代表多方佔優勢，市場氣氛偏熱；綠燈代表空方佔優勢，市場氣氛偏冷；黃燈則是多空勢力差不多，方向不明確。但重點是，不要只看一天的燈號，要看它的「連續性」。連續好幾天紅燈，代表多方趨勢正在持續；而從連續綠燈轉為第一個黃燈，可能就是一個值得留意的轉弱或轉強訊號。\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"燈號\"}],[\"$\",\"th\",\"1\",{\"children\":\"代表意義\"}],[\"$\",\"th\",\"2\",{\"children\":\"對應策略\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"紅燈\"}],[\"$\",\"td\",\"1\",{\"children\":\"多方力道強勁，市場情緒樂觀\"}],[\"$\",\"td\",\"2\",{\"children\":\"順勢操作，但需留意是否過熱\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"黃燈\"}],[\"$\",\"td\",\"1\",{\"children\":\"多空拉鋸，趨勢不明\"}],[\"$\",\"td\",\"2\",{\"children\":\"多看少做，等待方向明確\"}]]}],[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"綠燈\"}],[\"$\",\"td\",\"1\",{\"children\":\"空方力道佔優，市場情緒保守\"}],[\"$\",\"td\",\"2\",{\"children\":\"避開或等待止跌訊號\"}]]}]]}]]}]}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、核心指標一：看懂「籌碼分數」抓主力動向\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"燈號背後最重要的靈魂，就是「籌碼分數」。所謂籌碼，指的就是股票在誰手上。如果股票大多集中在少數大戶（例如法人、公司大股東）手裡，籌碼就比較「集中」，有利於股價穩定。籌碼分數就是衡量這個集中度的指標。一般來說，分數越高，代表大戶買進的越多；分數越低，則可能是大戶在賣出。這是判斷一檔股票有沒有「大人在照顧」的關鍵數字。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"分數高於 70 分：通常表示大戶站在買方，籌碼趨於集中。\"}],[\"$\",\"li\",\"1\",{\"children\":\"分數介於 30-70 分：多空不明顯，籌碼較為分散。\"}],[\"$\",\"li\",\"2\",{\"children\":\"分數低於 30 分：通常表示大戶站在賣方，籌碼趨於凌亂。\"}]]}],[\"$\",\"figure\",\"2\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[\"$L18\",\"$L19\"]}]]]}],\"$L1a\",\"$L1b\",\"$L1c\",\"$L1d\",\"$L1e\"],null]}]]}]}]\n18:[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"✓它是輔助工具非絕對✓觀察趨勢轉變與連續性✓搭配其他指標綜合判斷✓不做單一信號的買賣\"}]\n19:[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"使用紅綠燈的正確心態\"}]\n1a:[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、核心指標二：用「量價分數」確認趨勢強度\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"光有大戶買還不夠，趨勢要走得遠，還需要市場上其他人的認同，這就要看「量價分數」。這個分數衡量的是「成交量」和「股價」的關係是否健康。健康的上漲，應該是「價漲量增」，代表越多人願意用更高的價格買進；反之，如果「價漲量縮」，雖然股價在漲，但成交量跟不上，就可能代表追價意願不足，漲勢的續航力要打個問號。籌碼分數看方向，量價分數看力道，兩者要一起看。\"}]]]}]\n1b:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、實戰應用：如何結合燈號與分數做判斷？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"學會看燈號和分數後，我們可以建立一個簡單的判斷流程。例如，當你看到一檔股票從連續綠燈轉為第一個黃燈，這時可以點進去看細節。如果發現它的籌碼分數從 25 分爬升到 45 分，雖然還不高，但已經有改善，這就可能是一個空方力道減弱的早期訊號，值得你放入觀察清單，持續追蹤後續燈號與分數的變化。\"}],[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"第一步：先看燈號顏色，快速了解現在是順風、逆風還是盤整。\"}],[\"$\",\"li\",\"1\",{\"children\":\"第二步：再看籌碼分數，確認大戶是站在買方還是賣方。\"}],[\"$\",\"li\",\"2\",{\"children\":\"第三步：最後看量價分數，判斷目前的趨勢有沒有得到成交量的支持。\"}]]}]]]}]\n1c:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"紅燈的股票就一定會漲嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"不一定。紅燈代表「過去一段時間」多方數據佔優，但市場瞬息萬變，隔天也可能出現利空消息。燈號的意義在於顯示趨勢的「慣性」，而不是預測明天的漲跌。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"為什麼有些股票一直都是黃燈？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"通常發生在成交量較小、股性較為溫吞的股票上。因為多空雙方力量一直沒有明顯分出勝負，各項分數都在中間值徘徊，所以會持續顯示黃燈，代表市場方向不明。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"燈號多久會更新一次？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"股市大佬的紅綠燈分數是根據每日盤後資料計算的，因此會在每天收盤後更新。盤中看到的燈號是前一個交易日的結果，這點要特別注意。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"我可以只看燈號顏色，不看分數嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"可以，燈號顏色是讓你快速篩選的第一關。但如果你想更深入了解「為什麼」是這個燈號，就建議點進去看籌碼與量價分數的細項，這能幫助你理解多空力道變化的根本原因。\"}]]}]]}]]]}]\n1d:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"總結來說，股市大佬紅綠燈是一個強大的趨勢輔助工具。記得「先看燈號定方向，再看分數找細節」，並觀察燈號的『連續與轉變』，而不是執著於單一天的紅或綠，就能有效提升你看盤的效率。\"}]]]}]\n1e:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L17\",\"0-想了解更多籌碼名\",{\"href\":\"/school\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"想了解更多籌碼名詞？來台股學堂打好基礎\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L17\",\"0-馬上看看今天大盤\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"馬上看看今天大盤的紅綠燈狀態\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L17\",\"0-註冊免費會員，開\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"註冊免費會員，開始使用紅綠燈功能\"}]]}],[\"$\",\"li\",\"3\",{\"children\":[[\"$\",\"$L17\",\"0-查看今日多空戰情\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"查看今日多空戰情，找出亮紅燈的股票\"}]]}]]}]]]}]\n13:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\nf:null\n1f:I[80622,[],\"IconMark\"]\n11:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"股市大佬紅綠燈怎麼看？3 個燈號顏色看懂多空強弱，避開追高殺低陷阱｜股市大佬 TradeBoss\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"打開股市大佬紅綠燈，一堆數字燈號不知道從何看起？本文教你用 3 個燈號顏色，快速判斷個股的多空力道與市場情緒，找出潛在的轉折機會。\"}],[\"$\",\"link\",\"2\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}],[\"$\",\"$L1f\",\"3\",{}]],\"error\":null,\"digest\":\"$undefined\"}\n16:\"$11:metadata\"\n"}