ldren\":[[\"$\",\"summary\",null,{\"className\":\"LearnArticle_tocSummary__YBddG\",\"children\":\"本文目錄\"}],[\"$\",\"ol\",null,{\"className\":\"LearnArticle_tocList__Rq_Lz\",\"children\":[[\"$\",\"li\",\"sec-1\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-1\",\"children\":\"一、什麼是「期貨未平倉」？跟股票買賣差在哪？\"}]}],[\"$\",\"li\",\"sec-2\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-2\",\"children\":\"二、為什麼市場都愛看「外資」的期貨部位？\"}]}],[\"$\",\"li\",\"sec-3\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-3\",\"children\":\"三、淨未平倉口數，看多少才算有參考價值？\"}]}],[\"$\",\"li\",\"sec-4\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-4\",\"children\":\"四、看到淨多單就跟著做多？小心「避險盤」的陷阱\"}]}],[\"$\",\"li\",\"sec-5\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-5\",\"children\":\"五、趨勢比數字更重要：如何觀察「連續變化」？\"}]}],[\"$\",\"li\",\"sec-6\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-6\",\"children\":\"常見問題 FAQ\"}]}],[\"$\",\"li\",\"sec-7\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-7\",\"children\":\"總結\"}]}],[\"$\",\"li\",\"sec-8\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-8\",\"children\":\"延伸閱讀\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"LearnArticle_body__6B7Mb\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_intro__ATV5c\",\"children\":\"打開財經新聞，常看到『外資台指期淨多單大增』，好像股市就要漲了？但到底什麼是淨未平倉？數字是正是負又代表什麼？這篇文章會帶你從零開始，看懂這個法人動向的關鍵指標，讓你在盤後多一個判斷依據。\"}],[[\"$\",\"figure\",\"figure-0\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"沒扣成本的勝率，看起來都會比較漂亮0.029%手續費 1 折來回0.15%當沖證交稅0.06%滑價估計三項合計約 0.24%；留倉稅率更高，約 0.39%\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"示意圖｜當沖來回成本：1 折手續費 + 證交稅 + 滑價（教學結構，不是某檔實盤）\"}]]}]],[\"$\",\"div\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"外資期貨淨未平倉，是觀察市場大戶對未來大盤看多或看空的重要參考。\"}],[\"$\",\"li\",\"1\",{\"children\":\"一般以『2萬口』為多空分水嶺：淨多單破2萬偏多；淨空單破2萬則偏空。\"}],[\"$\",\"li\",\"2\",{\"children\":\"數字的『連續變化』比單日絕對值更重要，能看出趨勢的形成。\"}],[\"$\",\"li\",\"3\",{\"children\":\"務必搭配『現貨買賣超』一起看，才能分辨外資是真看好，或只是在做避險。\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、什麼是「期貨未平倉」？跟股票買賣差在哪？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"簡單來說，買賣期貨就像簽訂一個「未來」的買賣合約。而「未平倉」，指的就是這個合約還沒到期、還在手上。如果你看好未來會漲，就建立「多單」；看壞未來會跌，就建立「空單」。「淨未平倉」就是把一個機構（例如外資）手上的多單數量，減掉空單數量，得出來的淨值。正數代表他們整體看多，負數則代表他們整體看空。\"}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、為什麼市場都愛看「外資」的期貨部位？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"在台股，外資（國外機構投資者）的資金量非常龐大，他們的動向足以影響整個大盤的走勢。加上外資通常有專業的研究團隊，對全球經濟局勢的判斷也比較全面，因此他們的佈局常被視為市場的「風向球」。觀察外資在台指期貨的淨未平倉部位，就像是偷看這群大戶對台灣加權指數的未來看法，是判斷大盤多空一個很重要的參考。\"}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、淨未平倉口數，看多少才算有參考價值？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"數字有大小，力道就有強弱。雖然沒有絕對標準，但市場長期下來有個約定俗成的觀察門檻。一般來說，當外資台指期淨部位超過「2萬口」時，就代表他們的多方或空方態度非常明確。當然，這只是一個參考值，重點還是要看連續的變化趨勢。\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"淨未平倉口數 (台指期)\"}],[\"$\",\"th\",\"1\",{\"children\":\"市場參考情緒\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"淨多單 20,000 口以上\"}],[\"$\",\"td\",\"1\",{\"children\":\"市場氣氛極度樂觀\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"淨多單 5,000 至 20,000 口\"}],[\"$\",\"td\",\"1\",{\"children\":\"市場氣氛偏多\"}]]}],[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"介於 -5,000 至 +5,000 口\"}],[\"$\",\"td\",\"1\",{\"children\":\"多空不明，盤整觀望\"}]]}],[\"$\",\"tr\",\"3\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"淨空單 5,000 至 20,000 口\"}],\"$L18\"]}],\"$L19\"]}]]}]}],\"$L1a\"]]}],\"$L1b\",\"$L1c\",\"$L1d\",\"$L1e\",\"$L1f\"],null]}]]}]}]\n18:[\"$\",\"td\",\"1\",{\"children\":\"市場氣氛偏空\"}]\n19:[\"$\",\"tr\",\"4\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"淨空單 20,000 口以上\"}],[\"$\",\"td\",\"1\",{\"children\":\"市場氣氛極度悲觀\"}]]}]\n1a:[\"$\",\"figure\",\"2\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"✓期貨是淨多單還淨空單？✓現貨是買超還是賣超？✓期貨和現貨方向是否一致？✓今天的部位比昨天增加還減少？\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"外資多空判讀清單\"}]]}]\n1b:[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、看到淨多單就跟著做多？小心「避險盤」的陷阱\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"這是最常見的錯誤！外資操作很靈活，期貨不只用來預測方向，也用來「避險」。舉例來說，如果外資今天大買了100億的台積電現貨，他可能會擔心大盤突然有什麼利空消息，所以同時在期貨市場放空，來保護他那100億的部位。這時候你看到期貨淨空單，但其實他不是真的看壞台股，只是在買保險。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"真心看多：現貨買超 + 期貨淨多單增加。\"}],[\"$\",\"li\",\"1\",{\"children\":\"真心看空：現貨賣超 + 期貨淨空單增加。\"}],[\"$\",\"li\",\"2\",{\"children\":\"多頭避險：現貨買超 + 期貨淨空單 (或多單減少)。\"}],[\"$\",\"li\",\"3\",{\"children\":\"空頭回補：現貨賣超 + 期貨淨多單 (或空單減少)。\"}]]}]]]}]\n1c:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、趨勢比數字更重要：如何觀察「連續變化」？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"比起一天突然增加或減少一萬口，連續幾天、穩定地往同一個方向增減倉位，更能代表外資的決心。例如，外資的淨多單從 5,000 口、變成 8,000 口、再變成 12,000 口，雖然單日數字不大，但連續三天的增加，就透露出一個偏多的趨勢正在形成。在股市大佬的「大盤總覽」頁面，我們有將這些數據圖表化，幫助你一眼看出趨勢變化。\"}]]]}]\n1d:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"外資期貨淨未平倉的資料是即時的嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"不是。這是盤後資料，通常在交易日下午 4 點後由期交所公布。它反映的是當天收盤後，外資還持有的合約部位，而不是盤中的即時進出。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"為什麼有時候外資大買現貨，期貨卻是淨空單？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"這很可能是「避險」操作。外資買進大量台股現貨後，為了預防大盤突然下跌導致持股虧損，會反向建立期貨空單來對沖風險。所以兩邊數據要對照看，才能了解真實意圖。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"除了外資，投信和自營商的期貨部位需要看嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"也需要，但重要性相對較低。外資的資金規模最大，對大盤指數影響力最強，是首要觀察對象。投信以操作現貨為主，期貨部位較小；自營商則多為短線或造市交易，三者策略不同。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"這個指標可以用在個股期貨上嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"比較不適用。大家常說的「外資未平倉」通常是指「台股指數期貨」，用來判斷對整體大盤的多空看法。個股期貨的參與者、流動性都不同，需要搭配個股本身的籌碼與基本面來分析。\"}]]}]]}]]]}]\n1e:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"與其猜測市場漲跌，不如學會解讀數據。每天花一分鐘，對比外資在「期貨」與「現貨」的部位增減，就能掌握大戶動向，讓你的投資決策多一份客觀依據，少一點情緒干擾。\"}]]]}]\n1f:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L17\",\"0-前往大盤總覽查看\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"前往大盤總覽查看最新數據\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L17\",\"0-想學更多籌碼分析\",{\"href\":\"/school\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"想學更多籌碼分析？來台股學堂\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L17\",\"0-股市大佬每日整理\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"股市大佬每日整理的台股日報\"}]]}]]}]]]}]\n13:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\nf:null\n20:I[80622,[],\"IconMark\"]\n11:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"外資期貨未平倉怎麼看？一篇搞懂多空方向燈，避開散戶陷阱｜股市大佬 TradeBoss\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"打開財經新聞，常看到『外資台指期淨多單大增』，好像股市就要漲了？但到底什麼是淨未平倉？數字是正是負又代表什麼？這篇文章會帶你從零開始，看懂這個法人動向的關鍵指標，讓你在盤後多一個判斷依據。\"}],[\"$\",\"link\",\"2\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}],[\"$\",\"$L20\",\"3\",{}]],\"error\":null,\"digest\":\"$undefined\"}\n16:\"$11:metadata\"\n"}