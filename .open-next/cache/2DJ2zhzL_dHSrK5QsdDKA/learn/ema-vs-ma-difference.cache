04bc32f026a0d946.js\",\"6309\",\"static/chunks/app/learn/%5Bslug%5D/page-f7b99344f7e2ee16.js\"],\"\"]\nd:[\"$\",\"div\",null,{\"className\":\"LearnArticle_wrap__LIQ8G\",\"children\":[\"$\",\"article\",null,{\"className\":\"LearnArticle_article__2nBbk\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_meta__etj_G\",\"children\":[[\"$\",\"$L17\",null,{\"className\":\"LearnArticle_cat__GQMlg\",\"href\":\"/learn?c=tech\",\"children\":\"技術面\"}],[\"$\",\"span\",null,{\"className\":\"LearnArticle_read__QEj6a\",\"children\":\"閱讀約 7 分鐘\"}]]}],[\"$\",\"h1\",null,{\"className\":\"LearnArticle_title__0_la8\",\"children\":\"EMA 與 MA 差在哪？均線黃金交叉用哪個比較準？3 個判斷點看懂快慢線\"}],[\"$\",\"details\",null,{\"className\":\"LearnArticle_toc__LcSAa\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"LearnArticle_tocSummary__YBddG\",\"children\":\"本文目錄\"}],[\"$\",\"ol\",null,{\"className\":\"LearnArticle_tocList__Rq_Lz\",\"children\":[[\"$\",\"li\",\"sec-1\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-1\",\"children\":\"一、MA 是什麼？為什麼它看起來總是慢半拍？\"}]}],[\"$\",\"li\",\"sec-2\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-2\",\"children\":\"二、EMA 是什麼？為什麼它這麼貼近盤勢？\"}]}],[\"$\",\"li\",\"sec-3\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-3\",\"children\":\"三、MA vs. EMA 核心差異比較表\"}]}],[\"$\",\"li\",\"sec-4\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-4\",\"children\":\"四、實戰中，我到底該用 MA 還是 EMA？\"}]}],[\"$\",\"li\",\"sec-5\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-5\",\"children\":\"五、新手最常犯的錯誤：把均線當成萬靈丹\"}]}],[\"$\",\"li\",\"sec-6\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-6\",\"children\":\"常見問題 FAQ\"}]}],[\"$\",\"li\",\"sec-7\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-7\",\"children\":\"總結\"}]}],[\"$\",\"li\",\"sec-8\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-8\",\"children\":\"延伸閱讀\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"LearnArticle_body__6B7Mb\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_intro__ATV5c\",\"children\":\"打開 K 線圖，看到兩條長得差不多的均線 MA 和 EMA，是不是常常搞混，不知道到底該看哪一條？這篇文章會直接告訴你兩者最關鍵的差別，並教你根據自己的看盤習慣，選擇最適合的工具，讓均線成為你的助力而不是阻力。\"}],[[\"$\",\"figure\",\"figure-0\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"紅＝K（較快），藍＝D（較慢）KD黃金交叉只是兩條線的位置，不是進場指令\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"示意圖｜KD：K 線與 D 線交叉很常見，盤整時假訊號特別多（教學結構，不是某檔實盤）\"}]]}]],[\"$\",\"div\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"MA (簡單均線) 算的是固定期間的「算術平均」，反應較慢，適合判斷長期趨勢。\"}],[\"$\",\"li\",\"1\",{\"children\":\"EMA (指數均線) 給予「近期價格」更高權重，反應更靈敏，適合抓短期轉折。\"}],[\"$\",\"li\",\"2\",{\"children\":\"兩者沒有絕對好壞，長線投資人看 MA 較穩定；短線交易者用 EMA 較即時。\"}],[\"$\",\"li\",\"3\",{\"children\":\"關鍵是固定使用一種並了解其特性，不要隨意切換，以免混淆判斷標準。\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、MA 是什麼？為什麼它看起來總是慢半拍？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"MA 的全名是「簡單移動平均線 (Simple Moving Average)」，它的算法非常單純，就是把過去 N 天的收盤價加總後，再除以 N。例如 5MA 就是把最近 5 天的收盤價加起來除以 5。因為每一天的價格權重都一樣，所以 MA 的走勢相對平滑，能有效過濾掉一些短期的價格波動雜訊。這也造成它的缺點：反應比較遲鈍，當價格已經轉向時，MA 常常會慢半拍才跟上。\"}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、EMA 是什麼？為什麼它這麼貼近盤勢？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"EMA 的全名是「指數移動平均線 (Exponential Moving Average)」，它為了解決 MA 反應慢的問題而生。EMA 的計算比較複雜，但你只需要記住一個核心概念：它會給「越靠近今天」的價格越高的加權分數。這代表 EMA 非常重視近期的價格變化，所以它的走勢會比 MA 更貼近 K 線，反應速度也更快。當價格出現急拉或急殺，EMA 會立刻跟上，幫助你更快發現市場情緒的轉變。\"}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、MA vs. EMA 核心差異比較表\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"說了這麼多，直接用一張表來比較最清楚。你可以把 MA 想像成一位沉穩的長輩，看的是大方向；把 EMA 想像成一位反應靈敏的前鋒，專門捕捉即時的機會。兩者是不同工具，用在不同地方。\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"指標特性\"}],[\"$\",\"th\",\"1\",{\"children\":\"MA (簡單移動平均線)\"}],[\"$\",\"th\",\"2\",{\"children\":\"EMA (指數移動平均線)\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"計算方式\"}],[\"$\",\"td\",\"1\",{\"children\":\"期間內每日收盤價的算術平均\"}],[\"$\",\"td\",\"2\",{\"children\":\"給予近期價格更高權重的加權平均\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"反應速度\"}],[\"$\",\"td\",\"1\",{\"children\":\"慢，走勢平滑\"}],\"$L18\"]}],\"$L19\",\"$L1a\",\"$L1b\"]}]]}]}],\"$L1c\"]]}],\"$L1d\",\"$L1e\",\"$L1f\",\"$L20\",\"$L21\"],null]}]]}]}]\n18:[\"$\",\"td\",\"2\",{\"children\":\"快，走勢貼近 K 線\"}]\n19:[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"優點\"}],[\"$\",\"td\",\"1\",{\"children\":\"穩定性高，有效過濾短期雜訊\"}],[\"$\",\"td\",\"2\",{\"children\":\"靈敏度高，能較早發出訊號\"}]]}]\n1a:[\"$\",\"tr\",\"3\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"缺點\"}],[\"$\",\"td\",\"1\",{\"children\":\"訊號有延遲性，可能錯過最佳時機\"}],[\"$\",\"td\",\"2\",{\"children\":\"容易受短期波動影響，產生假訊號\"}]]}]\n1b:[\"$\",\"tr\",\"4\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"適合情境\"}],[\"$\",\"td\",\"1\",{\"children\":\"判斷中長線趨勢、尋找穩定支撐壓力\"}],[\"$\",\"td\",\"2\",{\"children\":\"短線交易、抓取價格轉折點\"}]]}]\n1c:[\"$\",\"figure\",\"2\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"✓長線看 MA✓短線用 EMA✓搭配量價看\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"均線使用 3 大心法\"}]]}]\n1d:[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、實戰中，我到底該用 MA 還是 EMA？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"這沒有標準答案，完全取決於你的「交易週期」。如果你是做波段或長期持有的投資人，你看的是週線、月線，那麼用 MA 就夠了，它能幫你忽略掉每天的漲跌，專注在主要趨勢上。但如果你是做當沖或短線交易，需要對價格變化做出快速反應，那 EMA 會是你的好幫手。一個判斷方法：如果你覺得現在用的均線太慢，老是錯過行情，就試試 EMA；如果你覺得均線太敏感，讓你被騙進騙出，那就換回 MA。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"長線投資人（看週、月線）：用 MA，穩定判斷大趨勢。\"}],[\"$\",\"li\",\"1\",{\"children\":\"波段交易者（看日線）：MA 或 EMA 皆可，視個人偏好。\"}],[\"$\",\"li\",\"2\",{\"children\":\"短線交易者（看分時圖）：用 EMA，捕捉即時訊號。\"}]]}]]]}]\n1e:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、新手最常犯的錯誤：把均線當成萬靈丹\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"很多新手學會均線後，會犯一個致命錯誤：只看均線做決定。看到股價站上均線就買，跌破就賣，結果常常被市場來回修理。請記住，均線是「落後指標」，它只是把過去的價格平均畫給你看，不具備預測未來的能力。在盤整期間，K 線會不斷上下穿越均線，這時均線的支撐壓力效果會大打折扣，甚至完全失效。\"}]]]}]\n1f:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"均線的參數（天數）要怎麼設定比較好？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"沒有最好的參數，只有最適合你的。市場上常用 5、10、20 日作為短期均線；60 日（季線）為中期；120 日（半年線）與 240 日（年線）為長期趨勢線。建議新手可以從這些常用參數開始，觀察並找到最符合自己交易節奏的設定。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"黃金交叉或死亡交叉，用 MA 還是 EMA 判斷？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"EMA 的交叉訊號會比 MA 更早出現，但相對地也可能有較多的假訊號。MA 的交叉雖然較慢，但一旦形成，趨勢的確立性通常較高。這取決於你的風險偏好：想搶得先機，可參考 EMA；想追求穩定，則以 MA 為主。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"我可以在圖上同時放 MA 和 EMA 嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"當然可以，這是很常見的用法。例如，你可以放一條長天期的 MA（如 60MA）來判斷主要趨勢方向，再搭配一條短天期的 EMA（如 20EMA）來尋找進出場的時機點。這樣就能做到長短兼顧。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"為什麼股價跌破均線後，有時候又馬上漲回來？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"這就是所謂的「假跌破」。單一 K 棒的跌破不代表趨勢一定反轉，主力也可能藉此洗盤。建議多觀察 1-2 根 K 棒是否能站回，或搭配成交量判斷。把均線視為一個「支撐壓力區」，而不是一條絕對的線，會更有彈性。\"}]]}]]}]]]}]\n20:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"總結來說，MA 像船錨，幫助你在風浪中穩定方向；EMA 則像快艇，讓你迅速反應。根據你的交易週期選擇適合的工具，並記得它們都只是輔助，最終的決策還是要綜合考量全局。\"}]]]}]\n21:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L17\",\"0-想了解更多技術指\",{\"href\":\"/school\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"想了解更多技術指標？來台股學堂打好基礎\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L17\",\"0-在個股頁面，自己\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"在個股頁面，自己動手設定習慣的均線參數\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L17\",\"0-查看更多台股教學\",{\"href\":\"/learn\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"查看更多台股教學專欄文章\"}]]}]]}]]]}]\n13:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\nf:null\n22:I[80622,[],\"IconMark\"]\n11:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"EMA 與 MA 差在哪？均線黃金交叉用哪個比較準？3 個判斷點看懂快慢線｜股市大佬 TradeBoss\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"打開 K 線圖，看到兩條長得差不多的均線 MA 和 EMA，是不是常常搞混，不知道到底該看哪一條？這篇文章會直接告訴你兩者最關鍵的差別，並教你根據自己的看盤習慣，選擇最適合的工具，讓均線成為你的助力而不是阻力。\"}],[\"$\",\"link\",\"2\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}],[\"$\",\"$L22\",\"3\",{}]],\"error\":null,\"digest\":\"$undefined\"}\n16:\"$11:metadata\"\n"}