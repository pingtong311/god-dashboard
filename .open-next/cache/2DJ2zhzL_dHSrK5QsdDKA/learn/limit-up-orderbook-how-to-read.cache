static/chunks/app/learn/%5Bslug%5D/page-f7b99344f7e2ee16.js\"],\"\"]\nd:[\"$\",\"div\",null,{\"className\":\"LearnArticle_wrap__LIQ8G\",\"children\":[\"$\",\"article\",null,{\"className\":\"LearnArticle_article__2nBbk\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_meta__etj_G\",\"children\":[[\"$\",\"$L17\",null,{\"className\":\"LearnArticle_cat__GQMlg\",\"href\":\"/learn?c=orderbook\",\"children\":\"盤口掛單\"}],[\"$\",\"span\",null,{\"className\":\"LearnArticle_read__QEj6a\",\"children\":\"閱讀約 5 分鐘\"}]]}],[\"$\",\"h1\",null,{\"className\":\"LearnArticle_title__0_la8\",\"children\":\"漲停盤口的買盤怎麼讀？掛滿可撤的3個檢查\"}],[\"$\",\"details\",null,{\"className\":\"LearnArticle_toc__LcSAa\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"LearnArticle_tocSummary__YBddG\",\"children\":\"本文目錄\"}],[\"$\",\"ol\",null,{\"className\":\"LearnArticle_tocList__Rq_Lz\",\"children\":[[\"$\",\"li\",\"sec-1\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-1\",\"children\":\"一、漲停價的買，是在排隊等成交\"}]}],[\"$\",\"li\",\"sec-2\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-2\",\"children\":\"二、為什麼掛滿看起來像很強\"}]}],[\"$\",\"li\",\"sec-3\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-3\",\"children\":\"三、可撤、可縮小、打開後會變薄\"}]}],[\"$\",\"li\",\"sec-4\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-4\",\"children\":\"四、三個檢查，讀買盤而不是讀氣氛\"}]}],[\"$\",\"li\",\"sec-5\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-5\",\"children\":\"五、它不回答你該不該追\"}]}],[\"$\",\"li\",\"sec-6\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-6\",\"children\":\"常見問題 FAQ\"}]}],[\"$\",\"li\",\"sec-7\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-7\",\"children\":\"總結\"}]}],[\"$\",\"li\",\"sec-8\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-8\",\"children\":\"延伸閱讀\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"LearnArticle_body__6B7Mb\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_intro__ATV5c\",\"children\":\"漲停價下面堆成一排買單，畫面會給人「鎖住了」的錯覺。鎖住的是價格上限，不是那些單的忠誠。排隊可以撤、可以縮小、打開之後原本看起來無限的買盤也可能瞬間不見。這篇只處理一個問題：漲停時你在盤口看到的買，到底能讀到哪一層。答案很短：能讀到「現在有人排」，讀不到「一定排到收盤」。\"}],[[\"$\",\"figure\",\"figure-0\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"中間缺口是價差；張數是意願，不是承諾151.542 張151.088 張150.5120 張150.095 張149.5160 張149.070 張賣方五檔買方五檔大單靠近就消失，多半沒打算成交\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"示意圖｜五檔掛單：上面是想賣的，下面是想買的，都能隨時撤（教學結構，不是某檔實盤）\"}]]}]],[\"$\",\"div\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"漲停買盤是排隊，不是已經成交的鎖\"}],[\"$\",\"li\",\"1\",{\"children\":\"掛滿可以撤，打開後深度常突然變薄\"}],[\"$\",\"li\",\"2\",{\"children\":\"比較有資訊的是成交與打開後還有沒有人真的接，不是掛多少\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、漲停價的買，是在排隊等成交\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"價格碰到當日上限，賣方若還願意賣，會先跟已經掛在漲停價的買單撮合。你看到的巨大買張，是還在等的人，不是已經買到的人。已經買到的變成成交量；還在等的隨時可以離開隊伍。把「掛滿」讀成「大家都買到了而且不會走」，是把隊伍當成已經進場的群眾。隊伍會散。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"掛滿＝還在等\"}],[\"$\",\"li\",\"1\",{\"children\":\"成交量＝已經換成手\"}],[\"$\",\"li\",\"2\",{\"children\":\"等的人沒有義務等到收盤\"}]]}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、為什麼掛滿看起來像很強\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"數字大、價格又不能再往上，畫面只剩一個方向的想像。大腦會補：這麼多人要，應該會鎖到收盤。補完之後，打開就變成背叛，情緒比價格先崩。比較平的描述是：在這個價，願意排隊的揭示量暫時很多。暫時、揭示、排隊，三個詞都要留著。拿掉任何一個，句子就會假。\"}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、可撤、可縮小、打開後會變薄\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"漲停並沒有把委託變成不可取消。有人排著排著不想要了，單就消失，買張往下跳，看起來像「沒那麼多人了」。也有人從頭到尾只掛給市場看。一旦出現成交把漲停打開，原本只願意在上限排隊的人，不一定願意在低一檔繼續排。於是你會看到：打開的瞬間，盤口從很厚變成很瘦。瘦才比較接近當時真實願意成交的深度。\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"盤口現象\"}],[\"$\",\"th\",\"1\",{\"children\":\"容易讀成\"}],[\"$\",\"th\",\"2\",{\"children\":\"比較穩的讀法\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"漲停價買張很多\"}],[\"$\",\"td\",\"1\",{\"children\":\"一定鎖得住\"}],[\"$\",\"td\",\"2\",{\"children\":\"現在排隊的人多，隊伍可散\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"買張突然變少\"}],[\"$\",\"td\",\"1\",{\"children\":\"有人棄守\"}],[\"$\",\"td\",\"2\",{\"children\":\"有人撤單或改價，很常見\"}]]}],[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"打開後買盤變薄\"}],\"$L18\",\"$L19\"]}],\"$L1a\"]}]]}]}],\"$L1b\"]]}],\"$L1c\",\"$L1d\",\"$L1e\",\"$L1f\",\"$L20\"],\"$L21\"]}]]}]}]\n18:[\"$\",\"td\",\"1\",{\"children\":\"被出貨\"}]\n19:[\"$\",\"td\",\"2\",{\"children\":\"本來就只有上限價願意排\"}]\n1a:[\"$\",\"tr\",\"3\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"打開又封回去\"}],[\"$\",\"td\",\"1\",{\"children\":\"多空大戰\"}],[\"$\",\"td\",\"2\",{\"children\":\"又有人願意在上限排隊，仍可再打開\"}]]}]\n1b:[\"$\",\"figure\",\"2\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"!不等於會收到收盤!不等於打開後還有人接!不等於比較安全\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"掛滿不等於\"}]]}]\n1c:[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、三個檢查，讀買盤而不是讀氣氛\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"第一，分開看成交量與排隊張數：成交才是已經發生的換手。第二，看打開之後，下一檔有沒有人願意接，不要只看又封回去的那一秒。第三，對這檔平常的量——漲停買張看起來驚人，除以日均量以後可能只是普通。三個檢查都在降溫：掛滿是氣氛，氣氛會變。\"}],[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"排隊和成交分開記\"}],[\"$\",\"li\",\"1\",{\"children\":\"打開後看下一檔有沒有人接\"}],[\"$\",\"li\",\"2\",{\"children\":\"買張要除以這檔自己的日均量\"}]]}]]]}]\n1d:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、它不回答你該不該追\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"漲停盤口最常被拿去問的其實是要不要跟。這個問題本文不回答，因為任何回答都會變成叫人買賣。能說的只有限制：掛滿可撤、打開會薄、你也看不到隊伍裡誰是當天要走的。限制已經夠用來拒絕「掛滿所以很安全」這句話。安全與否要留給你自己的規則與風險，不留給一排還能消失的數字。\"}]]]}]\n1e:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"掛愈多是不是愈不容易打開？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"排隊多只說明此刻揭示意願高。撤單與賣單出現時，一樣打得開。沒有「掛多少就打不開」的保證。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"打開是不是就轉弱了？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"打開只說明有成交把價格帶離上限。之後可能再封、也可能繼續打開。單次打開不是結論。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"收盤還掛在漲停，隔天呢？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"隔天是新的一天、新的上下限與新的委託。前一天的隊伍不會自動搬過去。不要用收盤畫面推隔日。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"跌停的賣盤能用同一套讀嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"對稱：掛滿賣也不等於接下來都會賣完，同樣可撤、同樣一打開就可能變薄。這篇以漲停買盤為例，邏輯兩邊通用。\"}]]}]]}]]]}]\n1f:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"漲停買盤是可撤的排隊，不是鎖。掛滿會造成安全感，打開後深度常變薄。分開記成交與排隊，不要把揭示當安全證明。\"}]]]}]\n20:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L17\",\"0-五檔掛單四層讀法\",{\"href\":\"/learn/how-to-read-order-book-five-levels\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"五檔掛單四層讀法\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L17\",\"0-支撐壓力為什麼失\",{\"href\":\"/learn/support-resistance-how-to-draw\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"支撐壓力為什麼失效\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L17\",\"0-新手導覽\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"新手導覽\"}]]}]]}]]]}]\n21:[\"$\",\"div\",null,{\"className\":\"LearnArticle_related__9qV55\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_relatedTitle__RXfrl\",\"children\":\"相關文章\"}],[[\"$\",\"$L17\",\"how-to-read-order-book-five-levels\",{\"href\":\"/learn/how-to-read-order-book-five-levels\",\"className\":\"LearnArticle_relatedLink__mibXe\",\"children\":\"五檔掛單四層讀法\"}],[\"$\",\"$L17\",\"support-resistance-how-to-draw\",{\"href\":\"/learn/support-resistance-how-to-draw\",\"className\":\"LearnArticle_relatedLink__mibXe\",\"children\":\"支撐壓力為什麼失效\"}]]]}]\n13:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\nf:null\n22:I[80622,[],\"IconMark\"]\n11:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"漲停盤口的買盤怎麼讀？掛滿可撤的3個檢查｜股市大佬 TradeBoss\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"漲停價下面堆成一排買單，畫面會給人「鎖住了」的錯覺。鎖住的是價格上限，不是那些單的忠誠。排隊可以撤、可以縮小、打開之後原本看起來無限的買盤也可能瞬間不見。這篇只處理一個問題：漲停時你在盤口看到的買，到底能讀到哪一層。答案很短：能讀到「現在有人排」，讀不到「一定排到收盤」。\"}],[\"$\",\"link\",\"2\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}],[\"$\",\"$L22\",\"3\",{}]],\"error\":null,\"digest\":\"$undefined\"}\n16:\"$11:metadata\"\n"}