xt/static/css/3eaf36e367672966.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"$undefined\"}]],[\"$\",\"$Le\",null,{\"children\":[\"$Lf\",[\"$\",\"$L10\",null,{\"promise\":\"$@11\"}]]}]]}]\nb:[\"$\",\"$1\",\"h\",{\"children\":[null,[[\"$\",\"$L12\",null,{\"children\":\"$L13\"}],[\"$\",\"meta\",null,{\"name\":\"next-size-adjust\",\"content\":\"\"}]],[\"$\",\"$L14\",null,{\"children\":[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$15\",null,{\"fallback\":null,\"children\":\"$L16\"}]}]}]]}]\n17:I[52619,[\"2619\",\"static/chunks/2619-04bc32f026a0d946.js\",\"6309\",\"static/chunks/app/learn/%5Bslug%5D/page-f7b99344f7e2ee16.js\"],\"\"]\nd:[\"$\",\"div\",null,{\"className\":\"LearnArticle_wrap__LIQ8G\",\"children\":[\"$\",\"article\",null,{\"className\":\"LearnArticle_article__2nBbk\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_meta__etj_G\",\"children\":[[\"$\",\"$L17\",null,{\"className\":\"LearnArticle_cat__GQMlg\",\"href\":\"/learn?c=tech\",\"children\":\"技術面\"}],[\"$\",\"span\",null,{\"className\":\"LearnArticle_read__QEj6a\",\"children\":\"閱讀約 7 分鐘\"}]]}],[\"$\",\"h1\",null,{\"className\":\"LearnArticle_title__0_la8\",\"children\":\"支撐壓力線怎麼畫？3步驟找出關鍵價位，散戶必學K線圖教學\"}],[\"$\",\"details\",null,{\"className\":\"LearnArticle_toc__LcSAa\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"LearnArticle_tocSummary__YBddG\",\"children\":\"本文目錄\"}],[\"$\",\"ol\",null,{\"className\":\"LearnArticle_tocList__Rq_Lz\",\"children\":[[\"$\",\"li\",\"sec-1\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-1\",\"children\":\"一、到底什麼是支撐與壓力？為什麼它很重要？\"}]}],[\"$\",\"li\",\"sec-2\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-2\",\"children\":\"二、最簡單的畫法：怎麼找出水平線？\"}]}],[\"$\",\"li\",\"sec-3\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-3\",\"children\":\"三、股價會轉彎：如何畫出上升與下降趨勢線？\"}]}],[\"$\",\"li\",\"sec-4\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-4\",\"children\":\"四、地板變天花板？壓力與支撐的角色互換\"}]}],[\"$\",\"li\",\"sec-5\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-5\",\"children\":\"五、別只看線！搭配「成交量」讓準度三級跳\"}]}],[\"$\",\"li\",\"sec-6\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-6\",\"children\":\"常見問題 FAQ\"}]}],[\"$\",\"li\",\"sec-7\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-7\",\"children\":\"總結\"}]}],[\"$\",\"li\",\"sec-8\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-8\",\"children\":\"延伸閱讀\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"LearnArticle_body__6B7Mb\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_intro__ATV5c\",\"children\":\"打開K線圖，看到股價上上下下，聽說要找「支撐」和「壓力」，但線到底要畫在哪？這篇教學就是要帶你用最簡單的方法，畫出有參考價值的支撐壓力線。\"}],[[\"$\",\"figure\",\"figure-0\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"壓力區（前高附近）支撐區（前低附近）價格常在區間反應，也可能直接穿過穿過之後，舊支撐可能變成新壓力\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"示意圖｜支撐與壓力是區間，不是保證守得住的一條線（教學結構，不是某檔實盤）\"}]]}]],[\"$\",\"div\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"支撐是「跌不下去」的買盤區，壓力是「漲不上去」的賣壓區。\"}],[\"$\",\"li\",\"1\",{\"children\":\"連接至少兩個「高點」或「低點」就能畫出趨勢線，越多點連線越有效。\"}],[\"$\",\"li\",\"2\",{\"children\":\"成交量是關鍵！大量區的支撐壓力，比沒量的更值得參考。\"}],[\"$\",\"li\",\"3\",{\"children\":\"支撐跌破會變壓力，壓力突破會變支撐，兩者角色會互換。\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、到底什麼是支撐與壓力？為什麼它很重要？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"簡單來說，支撐就像地板，壓力就像天花板。當股價跌到某個價位時，總有一群人覺得「夠便宜了」而進場買進，這股買氣就形成了「支撐」；反之，當股價漲到某個價位，覺得「夠貴了」想賣出的人變多，就形成了「壓力」。學會看懂這兩條線，可以幫助我們判斷市場在哪些價位可能出現轉折，是規劃交易策略的第一步。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"支撐（Support）：股價下跌時，買方意願增強，阻止股價繼續下跌的價格「區域」。\"}],[\"$\",\"li\",\"1\",{\"children\":\"壓力（Resistance）：股價上漲時，賣方意願增強，阻止股價繼續上漲的價格「區域」。\"}],[\"$\",\"li\",\"2\",{\"children\":\"為何重要：協助判斷可能的進出場時機，或作為設定停損點的參考依據。\"}]]}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、最簡單的畫法：怎麼找出水平線？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"我們先從最基本的「水平線」開始。打開任何一檔股票的K線圖，把時間拉長一點，你會發現股價常常在某些價位附近「碰一下就彈回去」，不管是往上彈還是往下彈。這些重複出現的轉折點，就是畫水平支撐壓力的好地方。連接的點越多，代表市場對這個價位的共識越強，這條線就越有參考價值。\"}],[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"找出K線圖上一段時間內，好幾個「明顯的高點」或「明顯的低點」。\"}],[\"$\",\"li\",\"1\",{\"children\":\"試著用一條水平線，把至少兩個「價位差不多」的高點或低點連起來。\"}],[\"$\",\"li\",\"2\",{\"children\":\"判斷訣竅：這條線碰觸到的高低點越多、時間跨度越長，代表支撐或壓力的力道越強。\"}]]}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、股價會轉彎：如何畫出上升與下降趨勢線？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"股價不會永遠走平的，當它開始往特定方向前進時，支撐和壓力也會跟著傾斜，這就是「趨勢線」。如果一檔股票正在上漲，它的低點會越來越高，把這些低點連起來，就形成「上升趨勢線」，這條線會扮演支撐的角色；反之，如果股價在下跌，高點越來越低，連起來的「下降趨勢線」就會是它的壓力。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"上升趨勢線：連接兩個以上的「低點」，且後面的低點比前面的高。這是上升趨勢的支撐。\"}],\"$L18\",\"$L19\"]}],\"$L1a\"]]}],\"$L1b\",\"$L1c\",\"$L1d\",\"$L1e\",\"$L1f\"],null]}]]}]}]\n18:[\"$\",\"li\",\"1\",{\"children\":\"下降趨勢線：連接兩個以上的「高點」，且後面的高點比前面的低。這是下降趨勢的壓力。\"}]\n19:[\"$\",\"li\",\"2\",{\"children\":\"常見錯誤：只用兩個非常靠近的點畫線，這樣的趨勢線很容易因為短期波動就被破壞，參考價值較低。\"}]\n1a:[\"$\",\"figure\",\"2\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"✓連線的點夠多嗎？✓有搭配成交量看嗎？✓是壓力還是支撐？\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"畫線檢查清單\"}]]}]\n1b:[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、地板變天花板？壓力與支撐的角色互換\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"這是技術分析中一個非常重要的觀念：原本的壓力一旦被有效突破，就可能轉變為未來的支撐；反之，原本的支撐被跌破後，也可能變成反彈時的壓力。這就像打遊戲，你攻破了一道城牆，這道牆就變成你防守下一波攻擊的堡壘。理解這個角色互換的原理，能幫助你更好地判斷股價突破或跌破後的可能走勢。\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"事件\"}],[\"$\",\"th\",\"1\",{\"children\":\"原本角色\"}],[\"$\",\"th\",\"2\",{\"children\":\"轉變後角色\"}],[\"$\",\"th\",\"3\",{\"children\":\"代表的市場訊號\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"股價「突破」壓力區\"}],[\"$\",\"td\",\"1\",{\"children\":\"壓力 (天花板)\"}],[\"$\",\"td\",\"2\",{\"children\":\"支撐 (地板)\"}],[\"$\",\"td\",\"3\",{\"children\":\"多方力道轉強，後續回檔時此處可能成為買點\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"股價「跌破」支撐區\"}],[\"$\",\"td\",\"1\",{\"children\":\"支撐 (地板)\"}],[\"$\",\"td\",\"2\",{\"children\":\"壓力 (天花板)\"}],[\"$\",\"td\",\"3\",{\"children\":\"空方力道轉強，後續反彈時此處可能成為賣點\"}]]}]]}]]}]}]]]}]\n1c:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、別只看線！搭配「成交量」讓準度三級跳\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"畫線時如果只看價格，就好像看一場沒有聲音的電影，會錯過很多細節。成交量，就是市場的聲音。一個支撐或壓力區如果是在非常大的成交量下形成的，代表在此價位經過了激烈的多空交戰，市場對這個價位的記憶會特別深刻，因此它的強度遠高於成交量稀疏的區域。同樣地，股價在突破或跌破時，有沒有帶量也是判斷真假的重要線索。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"大量區的支撐/壓力：代表在此價位有大量籌碼換手，多空共識強，參考性較高。\"}],[\"$\",\"li\",\"1\",{\"children\":\"帶量突破/跌破：突破壓力時成交量放大，代表買方追價意願強；跌破支撐時放量，代表賣方急於出場，訊號較可靠。\"}],[\"$\",\"li\",\"2\",{\"children\":\"無量突破/跌破：股價過了關鍵價位，但成交量卻沒跟上，要小心可能是「假動作」，股價可能很快又會回到原來的區間。\"}]]}]]]}]\n1d:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"K線要用日K、週K還是月K來畫？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"看你的操作週期。短線操作看日K、小時K；長線投資看週K、月K。不同時間週期的線，代表不同格局的支撐壓力，一般來說長週期的線通常比短週期的更穩固。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"線要畫在K棒的影線還是實體？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"沒有絕對標準，但多數人會畫在影線的最高/最低點，因為那代表當天的極端價格。更重要的是「一致性」，你決定用哪個標準，就固定用同樣的方式畫，才能做比較。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"為什麼我畫的線常常一下就被突破或跌破？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"有幾個可能：你找的連接點不夠多、時間拉得不夠長，或是忽略了成交量。另外要記得，支撐壓力是一個「價格區域」而不是一個精準的「點」，股價在線的上下小幅穿梭都是正常的。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"支撐壓力跟移動平均線（均線）有什麼不同？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"我們畫的水平或趨勢線是連接特定高低點，位置是固定的；均線則是過去一段時間的「平均成交成本」，會隨著股價每天移動。兩者可以互相搭配參考，例如均線也常常成為動態的支撐或壓力。\"}]]}]]}]]]}]\n1e:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"畫支撐壓力線的重點不在於畫得多精準，而是透過「連接多個高低點」和「觀察成交量」，找出市場上最多人關心的價格「區域」，作為你判斷進出場時機的重要參考之一。\"}]]]}]\n1f:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L17\",\"0-想學更多K線基礎\",{\"href\":\"/school\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"想學更多K線基礎？來台股學堂打好底子\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L17\",\"0-實際打開個股K線\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"實際打開個股K線圖，練習畫畫看\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L17\",\"0-看看今天哪些股票\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"看看今天哪些股票接近關鍵價位\"}]]}]]}]]]}]\n13:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\nf:null\n20:I[80622,[],\"IconMark\"]\n11:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"支撐壓力線怎麼畫？3步驟找出關鍵價位，散戶必學K線圖教學｜股市大佬 TradeBoss\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"打開K線圖，看到股價上上下下，聽說要找「支撐」和「壓力」，但線到底要畫在哪？這篇教學就是要帶你用最簡單的方法，畫出有參考價值的支撐壓力線。\"}],[\"$\",\"link\",\"2\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}],[\"$\",\"$L20\",\"3\",{}]],\"error\":null,\"digest\":\"$undefined\"}\n16:\"$11:metadata\"\n"}