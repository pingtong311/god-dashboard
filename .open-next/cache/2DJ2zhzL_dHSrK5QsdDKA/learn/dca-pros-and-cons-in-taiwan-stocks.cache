ndefined\",\"nonce\":\"$undefined\"}]],[\"$\",\"$Le\",null,{\"children\":[\"$Lf\",[\"$\",\"$L10\",null,{\"promise\":\"$@11\"}]]}]]}]\nb:[\"$\",\"$1\",\"h\",{\"children\":[null,[[\"$\",\"$L12\",null,{\"children\":\"$L13\"}],[\"$\",\"meta\",null,{\"name\":\"next-size-adjust\",\"content\":\"\"}]],[\"$\",\"$L14\",null,{\"children\":[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$15\",null,{\"fallback\":null,\"children\":\"$L16\"}]}]}]]}]\n17:I[52619,[\"2619\",\"static/chunks/2619-04bc32f026a0d946.js\",\"6309\",\"static/chunks/app/learn/%5Bslug%5D/page-f7b99344f7e2ee16.js\"],\"\"]\nd:[\"$\",\"div\",null,{\"className\":\"LearnArticle_wrap__LIQ8G\",\"children\":[\"$\",\"article\",null,{\"className\":\"LearnArticle_article__2nBbk\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_meta__etj_G\",\"children\":[[\"$\",\"$L17\",null,{\"className\":\"LearnArticle_cat__GQMlg\",\"href\":\"/learn?c=strategy\",\"children\":\"策略解析\"}],[\"$\",\"span\",null,{\"className\":\"LearnArticle_read__QEj6a\",\"children\":\"閱讀約 5 分鐘\"}]]}],[\"$\",\"h1\",null,{\"className\":\"LearnArticle_title__0_la8\",\"children\":\"定期定額怎麼看？3個優點、3個限制，別把它當免思考\"}],[\"$\",\"details\",null,{\"className\":\"LearnArticle_toc__LcSAa\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"LearnArticle_tocSummary__YBddG\",\"children\":\"本文目錄\"}],[\"$\",\"ol\",null,{\"className\":\"LearnArticle_tocList__Rq_Lz\",\"children\":[[\"$\",\"li\",\"sec-1\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-1\",\"children\":\"一、它真正解決的是執行，不是報酬\"}]}],[\"$\",\"li\",\"sec-2\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-2\",\"children\":\"二、三個優點，對應三種人的痛\"}]}],[\"$\",\"li\",\"sec-3\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-3\",\"children\":\"三、三個限制，下跌期最明顯\"}]}],[\"$\",\"li\",\"sec-4\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-4\",\"children\":\"四、和價值投資、存股常被焊在一起\"}]}],[\"$\",\"li\",\"sec-5\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-5\",\"children\":\"五、什麼時候它比較不像解法\"}]}],[\"$\",\"li\",\"sec-6\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-6\",\"children\":\"常見問題 FAQ\"}]}],[\"$\",\"li\",\"sec-7\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-7\",\"children\":\"總結\"}]}],[\"$\",\"li\",\"sec-8\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-8\",\"children\":\"延伸閱讀\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"LearnArticle_body__6B7Mb\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_intro__ATV5c\",\"children\":\"定期定額常被講成「不用擇時、長期就會好」。它確實降低了每天決定買不買的痛苦，但沒有取消價格風險，也沒有取消你選的標的可能長期不適合的風險。把它當免思考按鈕，會在下跌期用「我有在定期定額」安慰自己，卻沒有檢查自己買的是什麼。這篇只把優缺點講清楚。\"}],[[\"$\",\"figure\",\"figure-0\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"虧 3 次每次 −1%賺 2 次每次 +1%勝率 40% 也可能是正期望，前提是賺的比虧的大、且扣得起成本短線先扣約 0.24% 當沖成本，再看還剩多少\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"示意圖｜期望值：勝率要配上平均賺賠，再扣成本（教學結構，不是某檔實盤）\"}]]}]],[\"$\",\"div\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"優點是降低擇時與一次買錯高點的壓力\"}],[\"$\",\"li\",\"1\",{\"children\":\"限制是下跌期會繼續買、成本不會消失、標的選錯一樣痛\"}],[\"$\",\"li\",\"2\",{\"children\":\"它是執行工具，不是報酬保證\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、它真正解決的是執行，不是報酬\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"很多人不是不會選，是選完之後遲遲不下手，或只在熱鬧時下手。定期定額用日曆代替心情，讓執行變得比較穩。這很有價值。價值停在執行層。它不保證平均成本一定比較低——若價格一路往上，你會買得比一次買完更貴；若一路往下，你會買得更多、帳面也更久看起來不好看。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"用日曆代替心情\"}],[\"$\",\"li\",\"1\",{\"children\":\"不保證平均成本比較低\"}],[\"$\",\"li\",\"2\",{\"children\":\"執行穩，報酬仍看標的與期間\"}]]}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、三個優點，對應三種人的痛\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"怕一次買在高點的人，它把買點拆開。沒時間看盤的人，它減少決策次數。容易被新聞打斷的人，它讓規則比標題穩。這三個痛是真的。所以定期定額值得存在。值得存在，不表示它適合所有目標——你若做的是短週期交易，日曆扣款可能跟你的規則打架。\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"優點\"}],[\"$\",\"th\",\"1\",{\"children\":\"它在幫誰\"}],[\"$\",\"th\",\"2\",{\"children\":\"不要誤會成\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"拆開買點\"}],[\"$\",\"td\",\"1\",{\"children\":\"怕一次買錯高點的人\"}],[\"$\",\"td\",\"2\",{\"children\":\"保證買在低點\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"減少決策\"}],[\"$\",\"td\",\"1\",{\"children\":\"沒時間看盤的人\"}],[\"$\",\"td\",\"2\",{\"children\":\"可以完全不研究標的\"}]]}],[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"對抗標題\"}],[\"$\",\"td\",\"1\",{\"children\":\"容易被新聞打斷的人\"}],[\"$\",\"td\",\"2\",{\"children\":\"下跌就一定比較划算\"}]]}],[\"$\",\"tr\",\"3\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"習慣養成\"}],[\"$\",\"td\",\"1\",{\"children\":\"需要流程的人\"}],[\"$\",\"td\",\"2\",{\"children\":\"流程等於正期望\"}]]}]]}]]}]}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、三個限制，下跌期最明顯\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"第一，下跌時它會繼續買，這是設計，也是心理壓力來源。第二，手續費與折溢價仍在，尤其扣款金額很小的時候，成本比例會偏高。第三，標的若選成單一題材或單一公司，定期定額只是把同一種風險切成很多筆。切細不是分散。限制不讓它變成壞工具，只讓它變回工具。\"}],\"$L18\",\"$L19\"]]}],\"$L1a\",\"$L1b\",\"$L1c\",\"$L1d\",\"$L1e\"],\"$L1f\"]}]]}]}]\n18:[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"下跌期的心理要事前承認\"}],[\"$\",\"li\",\"1\",{\"children\":\"小額扣款先算成本佔比\"}],[\"$\",\"li\",\"2\",{\"children\":\"標的風險不會因為切細而消失\"}]]}]\n19:[\"$\",\"figure\",\"2\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"!下跌仍續買!小額成本偏高!切細≠分散\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"三個限制\"}]]}]\n1a:[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、和價值投資、存股常被焊在一起\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"定期定額是買進節奏，價值投資是價格與價值的關係，存股常被用來指長期持有配息。三件事可以疊，也可以不合。用定期定額買一個你說不出為什麼要持有十年的標的，只是把擇時問題換成選標的問題。工具疊工具，不會自動變成策略。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"節奏、估值、持有期間是三題\"}],[\"$\",\"li\",\"1\",{\"children\":\"可以疊，但要各自說得通\"}],[\"$\",\"li\",\"2\",{\"children\":\"說不通就不要用名詞焊在一起\"}]]}]]]}]\n1b:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、什麼時候它比較不像解法\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"你需要靈活加減碼、你的規則是條件觸發而不是日曆、或你還沒決定標的就先開始扣款。這三種情況，日曆會變成另一種衝動：為了扣款而扣款。先寫標的與停止條件，再打開定期定額，順序不能反。停止條件包括：標的前提變了、你的生活現金不夠、或你已經執行不下去。\"}]]]}]\n1c:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"下跌還要繼續扣嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"若規則是日曆、且標的前提沒變、現金流仍允許，繼續是執行。若前提變了或生活受影響，停止也是規則。不要用口號代替檢查。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"定期定額是不是一定贏過一次買進？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"不一定。要看路徑。它贏的是執行穩定性，不是每一段期間的報酬比較。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"適合用來買個股嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"可以，但個股風險更集中。切成很多筆，不會自動變成分散。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"手續費會不會吃掉好處？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"小額又頻繁時，成本比例會升高。先算損益兩平幅度，再決定金額與頻率。\"}]]}]]}]]]}]\n1d:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"定期定額解決的是執行與擇時痛苦，不解決標的與價格風險。優點是拆買點、減決策；限制是下跌續買、成本仍在、選錯一樣痛。先寫標的與停止條件，再打開日曆。\"}]]]}]\n1e:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L17\",\"0-價值投資在台股的\",{\"href\":\"/learn/why-value-investing-is-hard-in-taiwan\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"價值投資在台股的難處\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L17\",\"0-台股交易成本\",{\"href\":\"/learn/taiwan-stock-trading-costs\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"台股交易成本\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L17\",\"0-ETF 怎麼挑\",{\"href\":\"/learn/how-to-choose-etf-taiwan\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"ETF 怎麼挑\"}]]}]]}]]]}]\n1f:[\"$\",\"div\",null,{\"className\":\"LearnArticle_related__9qV55\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_relatedTitle__RXfrl\",\"children\":\"相關文章\"}],[[\"$\",\"$L17\",\"why-value-investing-is-hard-in-taiwan\",{\"href\":\"/learn/why-value-investing-is-hard-in-taiwan\",\"className\":\"LearnArticle_relatedLink__mibXe\",\"children\":\"價值投資在台股的難處\"}],[\"$\",\"$L17\",\"taiwan-stock-trading-costs\",{\"href\":\"/learn/taiwan-stock-trading-costs\",\"className\":\"LearnArticle_relatedLink__mibXe\",\"children\":\"台股交易成本\"}],[\"$\",\"$L17\",\"how-to-choose-etf-taiwan\",{\"href\":\"/learn/how-to-choose-etf-taiwan\",\"className\":\"LearnArticle_relatedLink__mibXe\",\"children\":\"ETF 怎麼挑\"}]]]}]\n13:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\nf:null\n20:I[80622,[],\"IconMark\"]\n11:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"定期定額怎麼看？3個優點、3個限制，別把它當免思考｜股市大佬 TradeBoss\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"定期定額常被講成「不用擇時、長期就會好」。它確實降低了每天決定買不買的痛苦，但沒有取消價格風險，也沒有取消你選的標的可能長期不適合的風險。把它當免思考按鈕，會在下跌期用「我有在定期定額」安慰自己，卻沒有檢查自己買的是什麼。這篇只把優缺點講清楚。\"}],[\"$\",\"link\",\"2\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}],[\"$\",\"$L20\",\"3\",{}]],\"error\":null,\"digest\":\"$undefined\"}\n16:\"$11:metadata\"\n"}