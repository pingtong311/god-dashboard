\"$\",\"td\",\"0\",{\"children\":\"逐筆成交\"}],[\"$\",\"td\",\"1\",{\"children\":\"資料源提供的成交紀錄\"}],[\"$\",\"td\",\"2\",{\"children\":\"無法單憑紀錄確認特定分點或交易者\"}]]}],[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"累計成交量\"}],[\"$\",\"td\",\"1\",{\"children\":\"當日截至資料時間的成交累計\"}],[\"$\",\"td\",\"2\",{\"children\":\"不是剛剛那一筆成交量\"}]]}]]}]]}]}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"用一個假設例子看懂\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"假設畫面委買100元有20張，下一次快照剩下5張。這只表示該價位顯示量減少15張；期間可能有成交、撤單、新增委託或快照間漏掉的變化。沒有同步成交與完整委託資料，不能直接把15張全算成撤單。\"}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"在App怎麼對照？\"}],[[\"$\",\"ol\",\"0\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$1\",\"0-登入後開啟\",{\"children\":\"登入後開啟\"}],[\"$\",\"$L17\",\"1-盤中工作區\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"盤中工作區\"}],[\"$\",\"$1\",\"2-，輸入股票代號並\",{\"children\":\"，輸入股票代號並查詢。\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$1\",\"0-在「盤口／五檔」\",{\"children\":\"在「盤口／五檔」先看股票代號、資料時間及單位。\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$1\",\"0-切到「逐筆成交」\",{\"children\":\"切到「逐筆成交」查看同一股票的紀錄，注意兩邊資料時間是否一致。\"}]]}],[\"$\",\"li\",\"3\",{\"children\":[[\"$\",\"$1\",\"0-從通知進來時，可\",{\"children\":\"從通知進來時，可以按「同頁查看」切換股票；通知時間不等於目前行情時間。\"}]]}]]}]]]}],[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"收盤或缺資料時怎麼看？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"收盤後顯示的是系統實際取得的最後快照，請以畫面日期與時間為準，不保證每檔都剛好有13:30那一筆。若未取得資料，不能用舊資料冒充當日行情。\"}]]]}],[\"$\",\