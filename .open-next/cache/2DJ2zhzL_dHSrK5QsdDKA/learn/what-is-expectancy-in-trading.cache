}],[\"$\",\"span\",null,{\"className\":\"LearnArticle_read__QEj6a\",\"children\":\"閱讀約 6 分鐘\"}]]}],[\"$\",\"h1\",null,{\"className\":\"LearnArticle_title__0_la8\",\"children\":\"期望值怎麼看？決定長期結果的那個數字\"}],[\"$\",\"details\",null,{\"className\":\"LearnArticle_toc__LcSAa\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"LearnArticle_tocSummary__YBddG\",\"children\":\"本文目錄\"}],[\"$\",\"ol\",null,{\"className\":\"LearnArticle_tocList__Rq_Lz\",\"children\":[[\"$\",\"li\",\"sec-1\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-1\",\"children\":\"一、公式與含意\"}]}],[\"$\",\"li\",\"sec-2\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-2\",\"children\":\"二、算一次給你看：為什麼三成勝率可以是正的\"}]}],[\"$\",\"li\",\"sec-3\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-3\",\"children\":\"三、高勝率為什麼會是陷阱\"}]}],[\"$\",\"li\",\"sec-4\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-4\",\"children\":\"四、交易成本必須算進去\"}]}],[\"$\",\"li\",\"sec-5\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-5\",\"children\":\"五、樣本太少算出來的期望值不能用\"}]}],[\"$\",\"li\",\"sec-6\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-6\",\"children\":\"六、怎麼開始算自己的\"}]}],[\"$\",\"li\",\"sec-7\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-7\",\"children\":\"常見問題 FAQ\"}]}],[\"$\",\"li\",\"sec-8\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-8\",\"children\":\"總結\"}]}],[\"$\",\"li\",\"sec-9\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-9\",\"children\":\"延伸閱讀\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"LearnArticle_body__6B7Mb\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_intro__ATV5c\",\"children\":\"如果只能記住交易裡的一個概念，那就是期望值。它是唯一能回答「這套做法長期會把我帶去哪裡」的數字，也是解釋為什麼有人勝率不到一半卻能存活的原因。這篇用具體算式講清楚。\"}],[[\"$\",\"figure\",\"figure-0\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"虧 3 次每次 −1%賺 2 次每次 +1%勝率 40% 也可能是正期望，前提是賺的比虧的大、且扣得起成本短線先扣約 0.24% 當沖成本，再看還剩多少\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"示意圖｜期望值：勝率要配上平均賺賠，再扣成本（教學結構，不是某檔實盤）\"}]]}]],[\"$\",\"div\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"期望值等於勝率乘平均獲利減敗率乘平均虧損，是唯一能回答長期方向的數字\"}],[\"$\",\"li\",\"1\",{\"children\":\"三成勝率可以是正的，九成勝率可以是負的\"}],[\"$\",\"li\",\"2\",{\"children\":\"記得扣成本，也記得樣本太少的數字不能用\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、公式與含意\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"期望值等於勝率乘以平均獲利，減掉敗率乘以平均虧損。算出來的是「平均每做一筆，預期的結果是多少」。大於零代表這套做法在樣本內是賺的，小於零代表次數越多虧越多。注意它是平均值，不保證任何單筆的結果，也不保證短期內的結果。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"期望值 = 勝率 × 平均獲利 − 敗率 × 平均虧損\"}],[\"$\",\"li\",\"1\",{\"children\":\"描述的是平均每筆的預期結果\"}],[\"$\",\"li\",\"2\",{\"children\":\"大於零才有長期存活的可能\"}]]}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、算一次給你看：為什麼三成勝率可以是正的\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"假設一套做法勝率三成，賺的時候平均賺百分之六，虧的時候平均虧百分之二。期望值等於零點三乘六，減掉零點七乘二，等於一點八減一點四，等於正零點四。也就是說平均每做一筆賺百分之零點四。十次裡面錯七次，長期還是往上。這解釋了為什麼有經驗的人不追求高勝率，而是追求「錯的時候小、對的時候大」。\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"勝率\"}],[\"$\",\"th\",\"1\",{\"children\":\"平均獲利\"}],[\"$\",\"th\",\"2\",{\"children\":\"平均虧損\"}],[\"$\",\"th\",\"3\",{\"children\":\"期望值\"}],[\"$\",\"th\",\"4\",{\"children\":\"長期方向\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"30%\"}],[\"$\",\"td\",\"1\",{\"children\":\"+6%\"}],[\"$\",\"td\",\"2\",{\"children\":\"-2%\"}],[\"$\",\"td\",\"3\",{\"children\":\"+0.4%\"}],[\"$\",\"td\",\"4\",{\"children\":\"往上\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"50%\"}],[\"$\",\"td\",\"1\",{\"children\":\"+2%\"}],[\"$\",\"td\",\"2\",{\"children\":\"-2%\"}],[\"$\",\"td\",\"3\",{\"children\":\"0%\"}],[\"$\",\"td\",\"4\",{\"children\":\"打平（未計成本）\"}]]}],[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"70%\"}],[\"$\",\"td\",\"1\",{\"children\":\"+1%\"}],[\"$\",\"td\",\"2\",{\"children\":\"-3%\"}],[\"$\",\"td\",\"3\",{\"children\":\"-0.2%\"}],[\"$\",\"td\",\"4\",{\"children\":\"往下\"}]]}],[\"$\",\"tr\",\"3\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"90%\"}],[\"$\",\"td\",\"1\",{\"children\":\"+1%\"}],[\"$\",\"td\",\"2\",{\"children\":\"-12%\"}],[\"$\",\"td\",\"3\",{\"children\":\"-0.3%\"}],[\"$\",\"td\",\"4\",{\"children\":\"往下\"}]]}]]}]]}]}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[\"$L18\",[\"$L19\",\"$L1a\"]]}],\"$L1b\",\"$L1c\",\"$L1d\",\"$L1e\",\"$L1f\",\"$L20\"],null]}]]}]}]\n18:[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、高勝率為什麼會是陷阱\"}]\n19:[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"看上面表格的最後一列：勝率九成，但錯一次就吃掉十二次的獲利，期望值是負的。這種型態在實際交易裡很常見，因為它心理上非常舒服——大部分時間都在賺，只是偶爾大虧。人的記憶會強化那些頻繁的小勝，讓你覺得這套做法很好，直到某一次大虧把帳戶打回原點。判斷一套做法好不好，永遠要看期望值而不是勝率。\"}]\n1a:[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"高勝率搭配大虧損，期望值可能是負的\"}],[\"$\",\"li\",\"1\",{\"children\":\"頻繁小勝會強化錯誤的信心\"}],[\"$\",\"li\",\"2\",{\"children\":\"只看勝率會系統性誤判\"}]]}]\n1b:[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、交易成本必須算進去\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"上面的算式還沒扣成本。台股每筆交易有手續費（依券商折扣不同），賣出還有證交稅，當沖的證交稅另有減半規定。這些加起來對短線來說不是小數字：當你的平均獲利只有百分之一時，來回成本可能就吃掉一半以上。所以短線做法的期望值一定要用扣掉成本後的數字算，否則會嚴重高估。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"買賣手續費依券商折扣不同\"}],[\"$\",\"li\",\"1\",{\"children\":\"賣出有證交稅，當沖另有減半規定\"}],[\"$\",\"li\",\"2\",{\"children\":\"平均獲利越小，成本佔比越致命\"}],[\"$\",\"li\",\"3\",{\"children\":\"務必用扣掉成本後的數字計算\"}]]}],[\"$\",\"figure\",\"2\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"!只看勝率!忽略交易成本!樣本數太少!只在單邊行情驗證\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"四個常見誤區\"}]]}]]]}]\n1c:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、樣本太少算出來的期望值不能用\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"用十筆交易算期望值，等於用擲十次硬幣推論硬幣公不公正——結果幾乎全是隨機。實務上要看到幾十筆以上，數字才開始有一點意義；而且要包含不同的市場環境，只在單邊行情裡累積的樣本，換到盤整期通常會失準。這也是為什麼「這招最近很準」通常沒有參考價值。\"}]]]}]\n1d:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"六、怎麼開始算自己的\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"不需要複雜工具，一張表就夠：每筆記下進出價格、張數、結果百分比、以及當初的進場理由。一個月後把賺的筆數與平均幅度、虧的筆數與平均幅度算出來，代進公式。你會第一次看到自己的做法到底是正的還是負的——多數人第一次算完都會意外。\"}],[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"每筆記下進出價、張數、結果與進場理由\"}],[\"$\",\"li\",\"1\",{\"children\":\"分開統計賺的平均幅度與虧的平均幅度\"}],[\"$\",\"li\",\"2\",{\"children\":\"代進公式，記得扣掉成本\"}],[\"$\",\"li\",\"3\",{\"children\":\"累積幾十筆之後再下結論\"}]]}]]]}]\n1e:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"期望值和勝率哪個重要？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"期望值。勝率只是期望值公式裡的一個變數，單獨看會誤導：勝率九成搭配一次大虧，期望值可以是負的。判斷一套做法必須把賺賠幅度一起算進去。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"要多少筆交易才算夠？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"沒有絕對答案，但幾十筆是起點，而且要涵蓋不同市場環境。只在單邊行情累積的樣本，換到盤整期常會失準。樣本越少，算出來的數字越接近隨機。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"期望值是正的就一定會賺嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"不一定。正期望值只代表平均而言有利，實際過程會有連續虧損。如果部位太大，可能在期望值兌現之前就先失去繼續交易的能力，所以部位控制同樣重要。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"成本要怎麼估？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"把買進手續費、賣出手續費與證交稅加總，再加上一點滑價估計。手續費折扣依券商而異，稅率以主管機關最新規定為準，當沖有另外的減半規定，計算時要查清楚。\"}]]}]]}]]]}]\n1f:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"期望值等於勝率乘平均獲利減敗率乘平均虧損，是唯一能回答長期方向的數字。三成勝率可以是正的，九成勝率可以是負的。記得扣成本，也記得樣本太少的數字不能用。\"}]]]}]\n20:[\"$\",\"section\",\"sec-9\",{\"id\":\"sec-9\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L17\",\"0-交易觀念與名詞：\",{\"href\":\"/school\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"交易觀念與名詞：台股學堂\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L17\",\"0-用歷史行情累積樣\",{\"href\":\"/sim\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"用歷史行情累積樣本：練功房\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L17\",\"0-更多台股教學文\",{\"href\":\"/learn\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"更多台股教學文\"}]]}]]}]]]}]\n13:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\nf:null\n21:I[80622,[],\"IconMark\"]\n11:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"期望值怎麼看？決定長期結果的那個數字｜股市大佬 TradeBoss\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"如果只能記住交易裡的一個概念，那就是期望值。它是唯一能回答「這套做法長期會把我帶去哪裡」的數字，也是解釋為什麼有人勝率不到一半卻能存活的原因。這篇用具體算式講清楚。\"}],[\"$\",\"link\",\"2\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}],[\"$\",\"$L21\",\"3\",{}]],\"error\":null,\"digest\":\"$undefined\"}\n16:\"$11:metadata\"\n"}