\\"sec-6\\\",{\\\"children\\\":[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"#sec-6\\\",\\\"children\\\":\\\"常見問題 FAQ\\\"}]}],[\\\"$\\\",\\\"li\\\",\\\"sec-7\\\",{\\\"children\\\":[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"#sec-7\\\",\\\"children\\\":\\\"總結\\\"}]}],[\\\"$\\\",\\\"li\\\",\\\"sec-8\\\",{\\\"children\\\":[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"#sec-8\\\",\\\"children\\\":\\\"延伸閱讀\\\"}]}]]}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"LearnArticle_body__6B7Mb\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"LearnArticle_intro__ATV5c\\\",\\\"children\\\":\\\"打開 K 線圖，看到股價突然跳了一大段，中間空了一塊，這就是「跳空缺口」。很多人會說「缺口必補」，然後就等著股價回來。但為什麼有時候等半天都沒等到，反而錯過行情？這篇就是要教你分辨不同缺口代表的意義，讓你不再只會死背一句話。\\\"}],[[\\\"$\\\",\\\"figure\\\",\\\"figure-0\\\",{\\\"className\\\":\\\"LearnArticle_fig__uoT7r\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"LearnArticle_figFrame__jJ7E4\\\",\\\"children\\\":\\\"缺口缺口是空白，不是一定要補回來的義務昨天今天開高有的補、有的變成新區間，用成交驗證\\\"}],[\\\"$\\\",\\\"figcaption\\\",null,{\\\"className\\\":\\\"LearnArticle_figCap__LnUbb\\\",\\\"children\\\":\\\"示意圖｜跳空缺口：開盤直接離開昨收，中間沒有成交（教學結構，不是某檔實盤）\\\"}]]}]],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"LearnArticle_tldr__Br5BY\\\",\\\"children\\\":[[\\\"$\\\",\\\"b\\\",null,{\\\"className\\\":\\\"LearnArticle_tldrTitle__K5PBN\\\",\\\"children\\\":\\\"本文重點\\\"}],[\\\"$\\\",\\\"ul\\\",null,{\\\"className\\\":\\\"LearnArticle_tldrList__VSc2_\\\",\\\"children\\\":[[\\\"$\\\",\\\"li\\\",\\\"0\\\",{\\\"children\\\":\\\"「跳空缺口」是股價不連續的區域，代表市場情緒極度看好或看壞。\\\"}],[\\\"$\\\",\\\"li\\\",\\\"1\\\",{\\\"children\\\":\\\"不是所有缺口都會回補，關鍵在於缺口的「種類」與出現的「位置」。\\\"}],[\\\"$\\\",\\\"li\\\",\\\"2\\\",{\\\"children\\\":\\\"帶有大量成交的「突破缺口」若不回補，常是趨勢轉強的確認訊號。\\\"}],[\\\"$\\\",\\\"li\\\",\\\"3\\\",{\\\"children\\\":\\\"在漲勢或跌勢末端的「竭盡缺口」，被快速回補才是反轉的開始。\\\"}]]}]]}],[[\\\"$\\\",\\\"section\\\",\\\"sec-1\\\",{\\\"id\\\":\\\"sec-1\\\",\\\"className\\\":\\\"LearnArticle_section__hLVjU\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"LearnArticle_h2__NmJ08\\\",\\\"children\\\":\\\"一、什麼是跳空缺口？為什麼它很重要？\\\"}],[[\\\"$\\\",\\\"p\\\",\\\"0\\\",{\\\"className\\\":\\\"LearnArticle_p__aZlQ1\\\",\\\"children\\\":\\\"簡單來說，「跳空缺口」就是 K 線圖上，兩根 K 棒之間出現的價格空白區域。例如，某檔股票昨天最高價是 100 元，今天最低價卻是從 102 元開始，那 100 到 102 元之間就是一個向上的跳空缺口。這代表市場上有一股很強的力量，讓買方願意直接用更高的價格開盤，連 100 到 102 元的價格都等不及要買，反之亦然。所以，缺口是觀察市場情緒突然轉變的強力訊號。\\\"}]]]}],[\\\"$\\\",\\\"section\\\",\\\"sec-2\\\",{\\\"id\\\":\\\"sec-2\\\",\\\"className\\\":\\\"LearnArticle_section__hLVjU\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"LearnArticle_h2__NmJ08\\\",\\\"children\\\":\\\"二、「缺口必補」是真的嗎？其實有四種類型！\\\"}],[[\\\"$\\\",\\\"p\\\",\\\"0\\\",{\\\"className\\\":\\\"LearnArticle_p__aZlQ1\\\",\\\"children\\\":\\\"「缺口必補」這句話只對了一半。有些缺口很快就回補，有些卻可能好幾年都不會補上，關鍵就在於缺口的類型。我們可以根據缺口出現的位置和成交量，把它們分成四種，每種代表的意義都不同。搞懂它們的差別，你才能正確解讀市場訊號，而不是一看到缺口就覺得股價一定會回來。\\\"}],[\\\"$\\\",\\\"div\\\",\\\"1\\\",{\\\"className\\\":\\\"LearnArticle_tblScroll__z9kbb\\\",\\\"children\\\":[\\\"$\\\",\\\"table\\\",null,{\\\"className\\\":\\\"LearnArticle_tbl__0yNgv\\\",\\\"children\\\":[[\\\"$\\\",\\\"thead\\\",null,{\\\"children\\\":[\\\"$\\\",\\\"tr\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"th\\\",\\\"0\\\",{\\\"children\\\":\\\"缺口類型\\\"}],[\\\"$\\\",\\\"th\\\",\\\"1\\\",{\\\"children\\\":\\\"出現位置\\\"}],[\\\"$\\\",\\\"th\\\",\\\"2\\\",{\\\"children\\\":\\\"成交量\\\"}],[\\\"$\\\",\\\"th\\\",\\\"3\\\",{\\\"children\\\":\\\"回補機率\\\"}],[\\\"$\\\",\\\"th\\\",\\\"4\\\",{\\\"children\\\":\\\"代表意義\\\"}]]}]}],[\\\"$\\\",\\\"tbody\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"tr\\\",\\\"0\\\",{\\\"children\\\":[[\\\"$\\\",\\\"td\\\",\\\"0\\\",{\\\"children\\\":\\\"普通缺口\\\"}],[\\\"$\\\",\\\"td\\\",\\\"1\\\",{\\\"children\\\":\\\"盤整區間內\\\"}],[\\\"$\\\",\\\"td\\\",\\\"2\\\",{\\\"children\\\":\\\"無明顯變化\\\"}],[\\\"$\\\",\\\"td\\\",\\\"3\\\",{\\\"children\\\":\\\"高\\\"}],[\\\"$\\\",\\\"td\\\",\\\"4\\\",{\\\"children\\\":\\\"市場暫時失衡，參考價值低\\\"}]]}],[\\\"$\\\",\\\"tr\\\",\\\"1\\\",{\\\"children\\\":[[\\\"$\\\",\\\"td\\\",\\\"0\\\",{\\\"children\\\":\\\"突破缺口\\\"}],[\\\"$\\\",\\\"td\\\",\\\"1\\\",{\\\"children\\\":\\\"重大壓力或支撐區\\\"}],[\\\"$\\\",\\\"td\\\",\\\"2\\\",{\\\"children\\\":\\\"明顯放大\\\"}],[\\\"$\\\",\\\"td\\\",\\\"3\\\",{\\\"children\\\":\\\"低\\\"}],[\\\"$\\\",\\\"td\\\",\\\"4\\\",{\\\"children\\\":\\\"新趨勢的開始，不回補更強\\\"}]]}],[\\\"$\\\",\\\"tr\\\",\\\"2\\\",{\\\"children\\\":[[\\\"$\\\",\\\"td\\\",\\\"0\\\",{\\\"children\\\":\\\"逃逸缺口\\\"}],[\\\"$\\\",\\\"td\\\",\\\"1\\\",{\\\"children\\\":\\\"趨勢中段\\\"}],[\\\"$\\\",\\\"td\\\",\\\"2\\\",{\\\"children\\\":\\\"穩定或溫和放大\\\"}],[\\\"$\\\",\\\"td\\\",\\\"3\\\",{\\\"children\\\":\\\"低\\\"}],[\\\"$\\\",\\\"td\\\",\\\"4\\\",{\\\"children\\\":\\\"趨勢持續的訊號，又稱測量缺口\\\"}]]}],[\\\"$\\\",\\\"tr\\\",\\\"3\\\",{\\\"children\\\":[[\\\"$\\\",\\\"td\\\",\\\"0\\\",{\\\"children\\\":\\\"竭盡缺口\\\"}],[\\\"$\\\",\\\"td\\\",\\\"1\\\",{\\\"children\\\":\\\"趨勢末端\\\"}],[\\\"$\\\",\\\"td\\\",\\\"2\\\",{\\\"children\\\":\\\"暴增後無力為繼\\\"}],[\\\"$\\\",\\\"td\\\",\\\"3\\\",{\\\"children\\\":\\\"極高\\\"}],[\\\"$\\\",\\\"td\\\",\\\"4\\\",{\\\"children\\\":\\\"趨勢即將反轉的最後訊號\\\"}]]}]]}]]}]}]]]}],[\\\"$\\\",\\\"section\\\",\\\"sec-3\\\",{\\\"id\\\":\\\"sec-3\\\",\\\"className\\\":\\\"LearnArticle_section__hLVjU\\\",\\\"children\\\":[\\\"$L18\\\",[\\\"$L19\\\",\\\"$L1a\\\",\\\"$L1b\\\"]]}],\\\"$L1c\\\",\\\"$L1d\\\",\\\"$L1e\\\",\\\"$L1f\\\",\\\"$L20\\\"],null]}]]}]}]\\n\"])</script><script>self.__next_f.push([1,\"18:[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"LearnArticle_h2__NmJ08\\\",\\\"children\\\":\\\"三、如何判斷是「真突破」還是「假訊號」？\\\"}]\\n19:[\\\"$\\\",\\\"p\\\",\\\"0\\\",{\\\"className\\\":\\\"LearnArticle_p__aZlQ1\\\",\\\"children\\\":\\\"對我們來說，最有價值的缺口之一就是「突破缺口」。它代表股價終於衝出長期的整理區間。判斷真假突破的關鍵數字，就是「成交量」。一個有效的突破缺口，通常會伴隨比平常大 1.5 到 2 倍以上的成交量。假設一檔股票在 100 元盤整很久，今天帶大量跳空開在 105 元，如果接下來幾天股價都沒有跌回 100 元以下來「回補缺口」，就代表多頭力道很強，這個新趨勢的可信度就很高。\\\"}]\\n1a:[\\\"$\\\",\\\"ul\\\",\\\"1\\\",{\\\"className\\\":\\\"LearnArticle_listCheck__xx1CF\\\",\\\"children\\\":[[\\\"$\\\",\\\"li\\\",\\\"0\\\",{\\\"children\\\":\\\"判斷方法：缺口是否伴隨明顯放大的成交量？\\\"}],[\\\"$\\\",\\\"li\\\",\\\"1\\\",{\\\"children\\\":\\\"常見錯誤：看到跳空就追，卻沒注意成交量是否跟上。\\\"}],[\\\"$\\\",\\\"li\\\",\\\"2\\\",{\\\"children\\\":\\\"帶走一件事：不回補的突破缺口，本身就是一個強力的支撐區。\\\"}]]}]\\n1b:[\\\"$\\\",\\\"figure\\\",\\\"2\\\",{\\\"className\\\":\\\"LearnArticle_fig__uoT7r\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"LearnArticle_figFrame__jJ7E4\\\",\\\"children\\\":\\\"✓1. 辨識缺口位置✓2. 檢查成交量大小✓3. 觀察後續走勢\\\"}],[\\\"$\\\",\\\"figcaption\\\",null,{\\\"className\\\":\\\"LearnArticle_figCap__LnUbb\\\",\\\"children\\\":\\\"判斷缺口的三個步驟\\\"}]]}]\\n1c:[\\\"$\\\",\\\"section\\\",\\\"sec-4\\\",{\\\"id\\\":\\\"sec-4\\\",\\\"className\\\":\\\"LearnArticle_section__hLVjU\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"LearnArticle_h2__NmJ08\\\",\\\"children\\\":\\\"四、看到「竭盡缺口」，是不是該準備離場？\\\"}],[[\\\"$\\\",\\\"p\\\",\\\"0\\\",{\\\"className\\\":\\\"LearnArticle_p__aZlQ1\\\",\\\"children\\\":\\\"當股價連續大漲或大跌一段時間後，突然又出現一個同方向的跳空缺口，成交量還瞬間爆出天量，這時就要特別小心了，它很可能是「竭盡缺口」。這代表趨勢的最後力量已經用盡，市場情緒過熱，準備反轉。判斷的關鍵是，這個缺口出現後，股價很快\"])</script><script>self.__next_f.push([1,\"（通常是 3-5 天內）就被反向走勢吃掉。例如，連漲後出現向上跳空，但隔天一根長黑 K 棒就把昨天的跳空漲幅全部跌完，這就是典型的反轉警訊。\\\"}]]]}]\\n1d:[\\\"$\\\",\\\"section\\\",\\\"sec-5\\\",{\\\"id\\\":\\\"sec-5\\\",\\\"className\\\":\\\"LearnArticle_section__hLVjU\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"LearnArticle_h2__NmJ08\\\",\\\"children\\\":\\\"五、新手最常犯的錯誤：把所有缺口都當成一回事\\\"}],[[\\\"$\\\",\\\"p\\\",\\\"0\\\",{\\\"className\\\":\\\"LearnArticle_p__aZlQ1\\\",\\\"children\\\":\\\"學習看懂缺口，最大的忌諱就是把它們一概而論。一個在盤整區間內的小缺口（普通缺口），跟一個突破十年線的大缺口（突破缺口），它們的意義天差地遠。情境決定了缺口的價值。你可以練習在「股市大佬」的個股 K 線圖上，對照下方的成交量與法人買賣超，來分析最近出現的缺口屬於哪一種類型，這會比單純背誦規則來得更有效。\\\"}]]]}]\\n\"])</script><script>self.__next_f.push([1,\"1e:[\\\"$\\\",\\\"section\\\",\\\"sec-6\\\",{\\\"id\\\":\\\"sec-6\\\",\\\"className\\\":\\\"LearnArticle_section__hLVjU\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"LearnArticle_h2__NmJ08\\\",\\\"children\\\":\\\"常見問題 FAQ\\\"}],[[\\\"$\\\",\\\"div\\\",\\\"0\\\",{\\\"className\\\":\\\"LearnArticle_faq__cemBp\\\",\\\"children\\\":[[\\\"$\\\",\\\"details\\\",\\\"0\\\",{\\\"className\\\":\\\"LearnArticle_faqItem__I9h0U\\\",\\\"children\\\":[[\\\"$\\\",\\\"summary\\\",null,{\\\"children\\\":\\\"缺口回補的時間有限制嗎？多久沒補算有效？\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"LearnArticle_faqA__IPuvc\\\",\\\"children\\\":\\\"沒有絕對的規則。一般來說，竭盡缺口和普通缺口通常在幾天到幾週內就會回補。而強勢的突破缺口或逃逸缺口，如果真的代表大趨勢的來臨，可能幾個月甚至幾年都不會回補，這個「不回補」的狀態本身就是趨勢強勁的證明。\\\"}]]}],[\\\"$\\\",\\\"details\\\",\\\"1\\\",{\\\"className\\\":\\\"LearnArticle_faqItem__I9h0U\\\",\\\"children\\\":[[\\\"$\\\",\\\"summary\\\",null,{\\\"children\\\":\\\"除權息的「缺口」算嗎？\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"LearnArticle_faqA__IPuvc\\\",\\\"children\\\":\\\"這是個常見的誤會。除權息當天股價下跌，是因為公司的市值扣除了配發的股利，所產生的「除權息參考價」，並不是市場買賣力道造成的。這種缺口不具備技術分析上的意義，市場通常會用「填權息」來描述股價漲回除息前價位的過程。\\\"}]]}],[\\\"$\\\",\\\"details\\\",\\\"2\\\",{\\\"className\\\":\\\"LearnArticle_faqItem__I9h0U\\\",\\\"children\\\":[[\\\"$\\\",\\\"summary\\\",null,{\\\"children\\\":\\\"向上跳空後拉回，但沒完全補掉缺口，這代表什麼？\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"LearnArticle_faqA__IPuvc\\\",\\\"children\\\":\\\"這通常是趨勢強勁的訊號。當股價拉回到缺口上緣就停止下跌並反彈，代表缺口本身形成了一個有力的支撐區。這顯示即使價格回檔，買方的承接力道依然很強，後續繼續上漲的機率較高。\\\"}]]}],[\\\"$\\\",\\\"details\\\",\\\"3\\\",{\\\"className\\\":\\\"LearnArticle_faqItem__I9h0U\\\",\\\"children\\\":[[\\\"$\\\",\\\"summary\\\",null,{\\\"children\\\":\\\"大盤指數的缺口也有參考價值嗎？\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"LearnArticle_faqA__IPuvc\\\",\\\"children\\\":\\\"非常有參考價值。大盤指數的缺口代表的是整體市場的共識與情緒，影響範圍更廣。一個帶量的大盤突破缺口，往往意味著一波行情的開始；反之，若出現竭盡缺口，可能就是市場過熱，需要提高警覺的訊號。\\\"}]]}]]}]]]}]\\n\"])</script><script>self.__next_f.push([1,\"1f:[\\\"$\\\",\\\"section\\\",\\\"sec-7\\\",{\\\"id\\\":\\\"sec-7\\\",\\\"className\\\":\\\"LearnArticle_section__hLVjU\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"LearnArticle_h2__NmJ08\\\",\\\"children\\\":\\\"總結\\\"}],[[\\\"$\\\",\\\"p\\\",\\\"0\\\",{\\\"className\\\":\\\"LearnArticle_p__aZlQ1\\\",\\\"children\\\":\\\"總結來說，不要再問「缺口要不要回補」，而是要問「這是哪一種缺口」。學會從位置、成交量判斷缺口類型，突破缺口找趨勢，竭盡缺口看反轉，才能把這個訊號變成你真正的助力。\\\"}]]]}]\\n\"])</script><script>self.__next_f.push([1,\"20:[\\\"$\\\",\\\"section\\\",\\\"sec-8\\\",{\\\"id\\\":\\\"sec-8\\\",\\\"className\\\":\\\"LearnArticle_section__hLVjU\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"LearnArticle_h2__NmJ08\\\",\\\"children\\\":\\\"延伸閱讀\\\"}],[[\\\"$\\\",\\\"ul\\\",\\\"0\\\",{\\\"className\\\":\\\"LearnArticle_list__WjxqC\\\",\\\"children\\\":[[\\\"$\\\",\\\"li\\\",\\\"0\\\",{\\\"children\\\":[[\\\"$\\\",\\\"$L17\\\",\\\"0-用「個股透視」觀\\\",{\\\"href\\\":\\\"/diary\\\",\\\"className\\\":\\\"LearnArticle_link__gMwHV\\\",\\\"children\\\":\\\"用「個股透視」觀察 K 線與成交量\\\"}]]}],[\\\"$\\\",\\\"li\\\",\\\"1\\\",{\\\"children\\\":[[\\\"$\\\",\\\"$L17\\\",\\\"0-到「台股學堂」學\\\",{\\\"href\\\":\\\"/school\\\",\\\"className\\\":\\\"LearnArticle_link__gMwHV\\\",\\\"children\\\":\\\"到「台股學堂」學習更多技術分析\\\"}]]}],[\\\"$\\\",\\\"li\\\",\\\"2\\\",{\\\"children\\\":[[\\\"$\\\",\\\"$L17\\\",\\\"0-掃描符合特定「技\\\",{\\\"href\\\":\\\"/chart\\\",\\\"className\\\":\\\"LearnArticle_link__gMwHV\\\",\\\"children\\\":\\\"掃描符合特定「技術型態」的股票\\\"}]]}],[\\\"$\\\",\\\"li\\\",\\\"3\\\",{\\\"children\\\":[[\\\"$\\\",\\\"$L17\\\",\\\"0-免費註冊，開始練\\\",{\\\"href\\\":\\\"/diary\\\",\\\"className\\\":\\\"LearnArticle_link__gMwHV\\\",\\\"children\\\":\\\"免費註冊，開始練習看盤\\\"}]]}]]}]]]}]\\n\"])</script><script>self.__next_f.push([1,\"13:[[\\\"$\\\",\\\"meta\\\",\\\"0\\\",{\\\"charSet\\\":\\\"utf-8\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"1\\\",{\\\"name\\\":\\\"viewport\\\",\\\"content\\\":\\\"width=device-width, initial-scale=1\\\"}]]\\nf:null\\n\"])</script><script>self.__next_f.push([1,\"21:I[80622,[],\\\"IconMark\\\"]\\n11:{\\\"metadata\\\":[[\\\"$\\\",\\\"title\\\",\\\"0\\\",{\\\"children\\\":\\\"跳空缺口一定要回補嗎？看懂4種缺口｜股市大佬 TradeBoss\\\"}],[\\\"$\