]\n10:I[15278,[],\"AsyncMetadataOutlet\"]\n12:I[24431,[],\"ViewportBoundary\"]\n14:I[24431,[],\"MetadataBoundary\"]\n15:\"$Sreact.suspense\"\n9:[\"$\",\"$1\",\"c\",{\"children\":[null,[\"$\",\"$L4\",null,{\"parallelRouterKey\":\"children\",\"error\":\"$undefined\",\"errorStyles\":\"$undefined\",\"errorScripts\":\"$undefined\",\"template\":[\"$\",\"$L5\",null,{}],\"templateStyles\":\"$undefined\",\"templateScripts\":\"$undefined\",\"notFound\":\"$undefined\",\"forbidden\":\"$undefined\",\"unauthorized\":\"$undefined\"}]]}]\na:[\"$\",\"$1\",\"c\",{\"children\":[\"$Ld\",[[\"$\",\"link\",\"0\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/css/3eaf36e367672966.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"$undefined\"}]],[\"$\",\"$Le\",null,{\"children\":[\"$Lf\",[\"$\",\"$L10\",null,{\"promise\":\"$@11\"}]]}]]}]\nb:[\"$\",\"$1\",\"h\",{\"children\":[null,[[\"$\",\"$L12\",null,{\"children\":\"$L13\"}],[\"$\",\"meta\",null,{\"name\":\"next-size-adjust\",\"content\":\"\"}]],[\"$\",\"$L14\",null,{\"children\":[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$15\",null,{\"fallback\":null,\"children\":\"$L16\"}]}]}]]}]\n17:I[52619,[\"2619\",\"static/chunks/2619-04bc32f026a0d946.js\",\"6309\",\"static/chunks/app/learn/%5Bslug%5D/page-f7b99344f7e2ee16.js\"],\"\"]\nd:[\"$\",\"div\",null,{\"className\":\"LearnArticle_wrap__LIQ8G\",\"children\":[\"$\",\"article\",null,{\"className\":\"LearnArticle_article__2nBbk\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_meta__etj_G\",\"children\":[[\"$\",\"$L17\",null,{\"className\":\"LearnArticle_cat__GQMlg\",\"href\":\"/learn?c=tech\",\"children\":\"技術面\"}],[\"$\",\"span\",null,{\"className\":\"LearnArticle_read__QEj6a\",\"children\":\"閱讀約 6 分鐘\"}]]}],[\"$\",\"h1\",null,{\"className\":\"LearnArticle_title__0_la8\",\"children\":\"W底型態怎麼認？別看到兩個低點就衝，3步驟判斷真假反轉訊號\"}],[\"$\",\"details\",null,{\"className\":\"LearnArticle_toc__LcSAa\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"LearnArticle_tocSummary__YBddG\",\"children\":\"本文目錄\"}],[\"$\",\"ol\",null,{\"className\":\"LearnArticle_tocList__Rq_Lz\",\"children\":[[\"$\",\"li\",\"sec-1\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-1\",\"children\":\"一、什麼是W底？為什麼它很重要？\"}]}],[\"$\",\"li\",\"sec-2\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-2\",\"children\":\"二、步驟一：找到左右兩隻腳，低點越近越好\"}]}],[\"$\",\"li\",\"sec-3\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-3\",\"children\":\"三、步驟二：畫出「頸線」，這是多空決戰的關鍵價位\"}]}],[\"$\",\"li\",\"sec-4\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-4\",\"children\":\"四、步驟三：等待「帶量突破」，確認訊號才算數\"}]}],[\"$\",\"li\",\"sec-5\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-5\",\"children\":\"五、W底完成後，可以如何預估可能的漲幅？\"}]}],[\"$\",\"li\",\"sec-6\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-6\",\"children\":\"常見問題 FAQ\"}]}],[\"$\",\"li\",\"sec-7\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-7\",\"children\":\"總結\"}]}],[\"$\",\"li\",\"sec-8\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-8\",\"children\":\"延伸閱讀\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"LearnArticle_body__6B7Mb\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_intro__ATV5c\",\"children\":\"看著一檔股票跌深反彈，心想是不是到底了，結果又跌一次，形成一個像 W 的形狀，這時你一定很疑惑：「這次是真的要漲了嗎？還是會繼續破底？」這篇文章就是要教你如何辨識真正的「W底」，讓你不再憑感覺猜底部。\"}],[[\"$\",\"figure\",\"figure-0\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"形狀像英文字 W，頸線在中間高點左腳右腳破頸線才比較像完成；沒過頸線只是兩個低點\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"示意圖｜W 底：兩個低點接近，中間有一波反彈（教學結構，不是某檔實盤）\"}]]}]],[\"$\",\"div\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"W底是下跌趨勢末端，可能反轉向上的重要訊號。\"}],[\"$\",\"li\",\"1\",{\"children\":\"辨識關鍵在於價格能否「帶量」突破兩個低點之間的「頸線」。\"}],[\"$\",\"li\",\"2\",{\"children\":\"看到第二個低點時先別急，突破頸線才是型態完成的確認點。\"}],[\"$\",\"li\",\"3\",{\"children\":\"可從低點到頸線的價差，初步估算突破後的潛在漲幅空間。\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、什麼是W底？為什麼它很重要？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"W底，也叫「雙重底」，是技術分析中常見的底部反轉型態。它長得像英文字母「W」，代表股價經過兩次下跌探底後，賣方的力量已經減弱，買方開始接手，行情可能由空頭轉為多頭。看懂它，能幫助你在下跌趨勢中，找到可能的轉折機會點，而不是在半山腰就急著進場。\"}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、步驟一：找到左右兩隻腳，低點越近越好\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"一個標準的W底，會有兩個差不多低的低點，這就是W的左右兩隻腳。它們不一定要在完全相同的價位，第二隻腳比第一隻腳稍微高一點或低一點（通常在3%範圍內）都是可以接受的。重要的是，在第二隻腳下跌時，成交量通常會比第一隻腳時來得少，這暗示著市場上的賣壓正在減輕，籌碼也趨於穩定。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"出現第一個低點（左腳）後反彈。\"}],[\"$\",\"li\",\"1\",{\"children\":\"股價再次下跌，形成第二個低點（右腳）。\"}],[\"$\",\"li\",\"2\",{\"children\":\"兩個低點的價位要相近，不能差距太大。\"}],[\"$\",\"li\",\"3\",{\"children\":\"右腳的成交量最好是萎縮的，代表賣壓減輕。\"}]]}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、步驟二：畫出「頸線」，這是多空決戰的關鍵價位\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"在兩隻腳中間，會有一個反彈的最高點，把這個高點畫一條水平線，就是「頸線」。頸線可以想成是套牢賣壓的集中區，股價要真正反轉向上，就必須要先克服這條壓力線。在價格還沒站上頸線之前，W底都還沒算完成，隨時可能因為買方力道不足而失敗，繼續下跌。\"}],[\"$\",\"figure\",\"1\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"!第二隻腳破底太多!突破頸線卻沒放量!型態太小或太尖銳\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"小心！這些常見的W底陷阱\"}]]}]]]}],[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、步驟三：等待「帶量突破」，確認訊號才算數\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"這是整個W底型態中最重要的一步！當股價上漲，用一根成交量明顯放大的紅K棒，正式衝過並收盤站在頸線之上，這個W底才算正式成立。成交量是關鍵，如果只是價格碰到頸線，但量能不足，就很容易變成「假突破」，股價很快又會跌回頸線之下。一個成功的突破，代表市場多數人認同這個價位，願意追價買進。\"}],\"$L18\"]]}],\"$L19\",\"$L1a\",\"$L1b\",\"$L1c\"],null]}]]}]}]\n18:[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"特徵\"}],[\"$\",\"th\",\"1\",{\"children\":\"成功的 W 底\"}],[\"$\",\"th\",\"2\",{\"children\":\"失敗的 W 底（假訊號）\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"突破頸線\"}],[\"$\",\"td\",\"1\",{\"children\":\"以中長紅K棒站穩頸線之上\"}],[\"$\",\"td\",\"2\",{\"children\":\"碰到頸線就回落，或突破後馬上跌破\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"成交量\"}],[\"$\",\"td\",\"1\",{\"children\":\"突破時成交量明顯放大（例如是前五日均量的1.5倍以上）\"}],[\"$\",\"td\",\"2\",{\"children\":\"突破時量能萎縮或無明顯變化\"}]]}],[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"後續走勢\"}],[\"$\",\"td\",\"1\",{\"children\":\"突破後可能回測頸線不破，然後繼續上漲\"}],[\"$\",\"td\",\"2\",{\"children\":\"突破後無力為繼，很快跌破頸線與前低\"}]]}]]}]]}]}]\n19:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、W底完成後，可以如何預估可能的漲幅？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"技術分析提供一個初步估算目標價的方法，但請記得這不是保證。你可以測量「最低點到頸線的垂直距離」，然後從「突破頸線的價位」往上加。舉例來說，一檔股票從100元跌到80元（第一隻腳），反彈到90元（頸線），再跌到81元（第二隻腳）。底部到頸線的距離大約是10元（90-80）。當股價帶量突破90元時，理論上的第一階段滿足點就可能落在100元（90+10）附近。\"}],[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"計算價差：頸線價位 - W底最低點價位。\"}],[\"$\",\"li\",\"1\",{\"children\":\"預估目標：頸線價位 + 上一步算出的價差。\"}],[\"$\",\"li\",\"2\",{\"children\":\"提醒：這只是一個概算參考，市場走勢仍受多種因素影響。\"}]]}]]]}]\n1a:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"W底的兩個低點，價位一定要完全一樣嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"不用。第二個低點比第一個低點稍微高一點或低一點（通常在3-5%內）都算正常。有時右腳較高，被視為更強勢的訊號，代表買方急著進場。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"一個W底的形成，大概需要多久時間？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"沒有標準答案，從幾週到幾個月都有可能。一般來說，時間跨度越長、範圍越大的W底，其代表的底部支撐力道也越穩固，反轉後的趨勢可能也走得更遠。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"如果突破頸線後，股價又跌回來怎麼辦？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"這就是「假突破」，代表多方攻擊力道不足，無法守住戰果，型態可能宣告失敗。若股價跌破頸線，甚至進一步跌破W底的低點，就應視為危險訊號。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"W底一定出現在最低點嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"不一定。W底是「一段下跌趨勢」的底部反轉訊號，可能是一個大空頭市場的最低點，也可能只是一段中期回檔的結束點。重點是觀察它出現前的趨勢是不是下跌的。\"}]]}]]}]]]}]\n1b:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"總結來說，辨識W底的口訣就是「兩腳打底，帶量過頸」。不要看到兩個低點就興奮，務必等到價格和成交量都確認突破頸線壓力區，才是型態完成的訊號，這樣能大幅提高判斷的準確度。\"}]]]}]\n1c:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L17\",\"0-到台股學堂，學習\",{\"href\":\"/school\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"到台股學堂，學習更多技術型態\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L17\",\"0-用型態掃描工具，\",{\"href\":\"/chart\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"用型態掃描工具，快速找出潛在機會\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L17\",\"0-在個股透視頁面，\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"在個股透視頁面，親自畫線看看\"}]]}]]}]]]}]\n13:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\nf:null\n1d:I[80622,[],\"IconMark\"]\n11:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"W底型態怎麼認？別看到兩個低點就衝，3步驟判斷真假反轉訊號｜股市大佬 TradeBoss\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"看著一檔股票跌深反彈，心想是不是到底了，結果又跌一次，形成一個像 W 的形狀，這時你一定很疑惑：「這次是真的要漲了嗎？還是會繼續破底？」這篇文章就是要教你如何辨識真正的「W底」，讓你不再憑感覺猜底部。\"}],[\"$\",\"link\",\"2\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}],[\"$\",\"$L1d\",\"3\",{}]],\"error\":null,\"digest\":\"$undefined\"}\n16:\"$11:metadata\"\n"}