-1\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-1\",\"children\":\"一、大盤收盤結論\"}]}],[\"$\",\"li\",\"sec-2\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-2\",\"children\":\"二、族群強弱對照\"}]}],[\"$\",\"li\",\"sec-3\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-3\",\"children\":\"三、個股漲跌幅與當沖熱門\"}]}],[\"$\",\"li\",\"sec-4\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-4\",\"children\":\"四、法人與籌碼面\"}]}],[\"$\",\"li\",\"sec-5\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-5\",\"children\":\"五、國際盤與消息面\"}]}],[\"$\",\"li\",\"sec-6\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-6\",\"children\":\"常見問題 FAQ\"}]}],[\"$\",\"li\",\"sec-7\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-7\",\"children\":\"總結\"}]}],[\"$\",\"li\",\"sec-8\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-8\",\"children\":\"延伸閱讀\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"LearnArticle_body__6B7Mb\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_intro__ATV5c\",\"children\":\"今天加權指數收在 44,933.74 點，小漲 0.47%，上市 735 檔上漲對 225 檔下跌，整體氣氛偏多。但法人面，外資現貨賣超約 30.9 萬張、自營商賣超約 91.6 萬張，臺指期外資淨空 8.2 萬口，期現貨方向一致偏空。族群分化明顯，創新板、造紙、橡膠領漲，存託憑證與居家生活類偏弱。\"}],[[\"$\",\"figure\",\"figure-0\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"越後面越熱鬧，通常也越貴、越好離開佈局沒新聞命名故事出現擁擠人人都知退燒利多變鈍新聞出現時，常常已經不是第一段\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"示意圖｜題材四階段：佈局 → 命名 → 擁擠 → 退燒（教學結構，不是某檔實盤）\"}]]}]],[\"$\",\"div\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"加權收44,933點漲0.47%，735漲對225跌，成交約7,623億\"}],[\"$\",\"li\",\"1\",{\"children\":\"外資現貨賣超30.9萬張、自營商賣超91.6萬張，臺指期淨空8.2萬口\"}],[\"$\",\"li\",\"2\",{\"children\":\"創新板+1.78%、造紙+1.72%領漲；存託憑證-1.38%、居家生活-0.91%偏弱\"}],[\"$\",\"li\",\"3\",{\"children\":\"費城半導體-2.12%、KOSPI+5.89%，國際盤方向分歧\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、大盤收盤結論\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"加權指數今天收在 44,933.74 點，漲 0.47%；櫃買指數收 389.96 點，漲 1.34%。上市股票 735 檔上漲、225 檔下跌，平均漲 0.95%，成交金額約 7,623 億元。整體是一檔「多數股票小漲、法人偏空」的格局，指數與籌碼方向不一致。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"加權指數 44,933.74（+0.47%）\"}],[\"$\",\"li\",\"1\",{\"children\":\"櫃買指數 389.96（+1.34%）\"}],[\"$\",\"li\",\"2\",{\"children\":\"上市 735 漲 / 225 跌，平均 +0.95%\"}],[\"$\",\"li\",\"3\",{\"children\":\"成交金額約 7,623.0 億元\"}]]}],[\"$\",\"div\",\"2\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"指標\"}],[\"$\",\"th\",\"1\",{\"children\":\"收盤\"}],[\"$\",\"th\",\"2\",{\"children\":\"漲跌幅\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"加權指數\"}],[\"$\",\"td\",\"1\",{\"children\":\"44,933.74\"}],[\"$\",\"td\",\"2\",{\"children\":\"+0.47%\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"櫃買指數\"}],[\"$\",\"td\",\"1\",{\"children\":\"389.96\"}],[\"$\",\"td\",\"2\",{\"children\":\"+1.34%\"}]]}],[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"臺指期\"}],[\"$\",\"td\",\"1\",{\"children\":\"44,612.0\"}],[\"$\",\"td\",\"2\",{\"children\":\"-1.06%\"}]]}],[\"$\",\"tr\",\"3\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"上市漲/跌家數\"}],[\"$\",\"td\",\"1\",{\"children\":\"735 / 225\"}],[\"$\",\"td\",\"2\",{\"children\":\"—\"}]]}],[\"$\",\"tr\",\"4\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"成交金額\"}],[\"$\",\"td\",\"1\",{\"children\":\"7,623.0 億\"}],[\"$\",\"td\",\"2\",{\"children\":\"—\"}]]}]]}]]}]}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、族群強弱對照\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"今天族群分化明顯。偏強的是創新板（+1.78%）、造紙工業（+1.72%）、橡膠工業（+1.44%）、水泥工業（+1.37%），以傳統產業與新興板塊為主；偏弱的是存託憑證（-1.38%）、居家生活類（-0.91%）、電子商務業（-0.34%）、運動休閒類（-0.24%）。\"}],\"$L18\"]]}],\"$L19\",\"$L1a\",\"$L1b\",\"$L1c\",\"$L1d\",\"$L1e\"],null]}]]}]}]\n18:[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"創新板 +1.78%（4 檔），領漲 6869 雲豹能源-創\"}],[\"$\",\"li\",\"1\",{\"children\":\"造紙工業 +1.72%（7 檔），領漲 1904 正隆\"}],[\"$\",\"li\",\"2\",{\"children\":\"橡膠工業 +1.44%（11 檔），領漲 2103 臺橡\"}],[\"$\",\"li\",\"3\",{\"children\":\"水泥工業 +1.37%（7 檔），領漲 1101 臺泥\"}],[\"$\",\"li\",\"4\",{\"children\":\"存託憑證 -1.38%、居家生活類 -0.91%、電子商務業 -0.34%、運動休閒類 -0.24%\"}]]}]\n19:[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、個股漲跌幅與當沖熱門\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"今天漲幅較大的股票包括鼎元（2426）與華冠（8101）均漲停 10.00%，大量（3167）漲 9.96%、程泰（1583）漲 9.95%、中再保（2851）漲 9.95%、嘉基（6715）漲 9.94%。跌幅較大方面，冠星-KY（4439）跌 8.57%、華新科（2492）跌 8.56%、宏致（3605）跌 7.56%。當沖量比前三為四維航 9.8x（-2.57%）、廣運 7.4x（+8.29%）、富喬 6.3x（+9.18%）。以上均為今天已發生的收盤結果。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"漲幅前五：2426 鼎元 +10.00%（29,241 張）、8101 華冠 +10.00%（60 張）、3167 大量 +9.96%（9,929 張）、1583 程泰 +9.95%（206 張）、2851 中再保 +9.95%（4,827 張）\"}],[\"$\",\"li\",\"1\",{\"children\":\"跌幅前五：4439 冠星-KY -8.57%（432 張）、2492 華新科 -8.56%（45,606 張）、3605 宏致 -7.56%（9,699 張）、9136 巨騰-DR -7.08%（1,394 張）、1709 和益 -6.91%（8,530 張）\"}],[\"$\",\"li\",\"2\",{\"children\":\"當沖量比前三：四維航 9.8x（-2.57%）、廣運 7.4x（+8.29%）、富喬 6.3x（+9.18%）\"}]]}],[\"$\",\"figure\",\"2\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"✓外資現貨賣超30.9萬張✓自營商賣超91.6萬張✓臺指期淨空8.2萬口✓融資維持率187.3%\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"法人方向一覽\"}]]}]]]}]\n1a:[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、法人與籌碼面\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"外資現貨買賣超約 -308,907 張（賣超），自營商現貨約 -916,255 張（賣超）。臺指期收 44,612 點（-1.06%），外資淨空單 82,423 口，未平倉量 102,620 口。全市場融資維持率 187.3%。法人現貨與期貨方向一致偏空，與現貨指數小漲形成對比，公開資料看不出單一原因。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"外資現貨：賣超約 308,907 張\"}],[\"$\",\"li\",\"1\",{\"children\":\"自營商現貨：賣超約 916,255 張\"}],[\"$\",\"li\",\"2\",{\"children\":\"臺指期：收 44,612.0（-1.06%），外資淨空 82,423 口\"}],[\"$\",\"li\",\"3\",{\"children\":\"未平倉量：102,620 口\"}],[\"$\",\"li\",\"4\",{\"children\":\"融資維持率：187.3%\"}]]}],[\"$\",\"div\",\"2\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"法人\"}],[\"$\",\"th\",\"1\",{\"children\":\"現貨買賣超\"}],[\"$\",\"th\",\"2\",{\"children\":\"期貨方向\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"外資\"}],[\"$\",\"td\",\"1\",{\"children\":\"賣超 308,907 張\"}],[\"$\",\"td\",\"2\",{\"children\":\"淨空 82,423 口\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"自營商\"}],[\"$\",\"td\",\"1\",{\"children\":\"賣超 916,255 張\"}],[\"$\",\"td\",\"2\",{\"children\":\"—\"}]]}]]}]]}]}]]]}]\n1b:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、國際盤與消息面\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"國際面，S&P 500 漲 0.21%、那斯達克漲 0.16%，但費城半導體指數跌 2.12%；亞洲方面，韓國 KOSPI 大漲 5.89%、日經 225 漲 1.36%。臺股新聞出現「紘瑒科技攜手創泓科技與上緯智聯搶進臺灣 AI 機器人生態系」、「聯一光受 CPO 題材加溫股價走強至 89 元」等標題。近三日川普相關標題包括「關稅策略已變但目標未變」、「中國反擊對伊朗經濟行動」等。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"S&P 500 +0.21%、那斯達克 +0.16%、費城半導體 -2.12%\"}],[\"$\",\"li\",\"1\",{\"children\":\"KOSPI +5.89%、日經 225 +1.36%\"}],[\"$\",\"li\",\"2\",{\"children\":\"新聞：紘瑒科技、創泓科技、上緯智聯搶進 AI 機器人生態系\"}],[\"$\",\"li\",\"3\",{\"children\":\"新聞：聯一光（3441）受營收成長與 CPO 題材加溫，股價走強至 89 元\"}],[\"$\",\"li\",\"4\",{\"children\":\"川普相關：關稅策略已變但目標未變；中國反擊對伊朗經濟行動\"}]]}]]]}]\n1c:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"今天台股為什麼漲？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"今天加權漲 0.47%，735 檔上漲對 225 檔下跌，平均漲 0.95%。創新板、造紙、橡膠、水泥等族群偏強，拉動整體指數。但外資現貨賣超約 30.9 萬張，公開資料看不出單一原因。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"外資今天買還是賣？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"外資現貨賣超約 308,907 張，臺指期淨空單 82,423 口，方向一致偏空。自營商現貨也賣超約 91.6 萬張。這是今天已發生的收盤數據。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"今天哪些族群比較強？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"創新板 +1.78%（雲豹能源-創領漲）、造紙 +1.72%（正隆領漲）、橡膠 +1.44%（臺橡領漲）、水泥 +1.37%（臺泥領漲）。偏弱的是存託憑證 -1.38%、居家生活類 -0.91%。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"費城半導體跌了，臺股有受影響嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"費城半導體今天跌 2.12%，臺股華新科（2492）跌 8.56%、冠星-KY（4439）跌 8.57%。同一天外資臺指期淨空 8.2 萬口，這些是同時發生的數據，公開資料看不出單一因果關係。\"}]]}],[\"$\",\"details\",\"4\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"今天成交金額多少？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"上市股票成交金額約 7,623.0 億元，735 檔上漲、225 檔下跌，平均漲 0.95%。\"}]]}]]}]]]}]\n1d:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"今天加權小漲 0.47% 收在 44,933 點，多數股票上漲但法人現貨期貨一致偏空，族群分化明顯，傳統產業與創新板領漲、存託憑證與居家生活類偏弱。\"}]]]}]\n1e:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L17\",\"0-臺股學堂：看懂法\",{\"href\":\"/school\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"臺股學堂：看懂法人買賣超\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L17\",\"0-族群透視（會員）\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"族群透視（會員）\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L17\",\"0-新手導覽\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"新手導覽\"}]]}]]}]]]}]\n13:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\nf:null\n1f:I[80622,[],\"IconMark\"]\n11:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"8/20臺股：加權漲0.47% 外資現貨賣超30萬張 族群分化｜股市大佬 TradeBoss\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"今天加權指數收在 44,933.74 點，小漲 0.47%，上市 735 檔上漲對 225 檔下跌，整體氣氛偏多。但法人面，外資現貨賣超約 30.9 萬張、自營商賣超約 91.6 萬張，臺指期外資淨空 8.2 萬口，期現貨方向一致偏空。族群分化明顯，創新板、造紙、橡膠領漲，存託憑\"}],[\"$\",\"link\",\"2\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}],[\"$\",\"$L1f\",\"3\",{}]],\"error\":null,\"digest\":\"$undefined\"}\n16:\"$11:metadata\"\n"}