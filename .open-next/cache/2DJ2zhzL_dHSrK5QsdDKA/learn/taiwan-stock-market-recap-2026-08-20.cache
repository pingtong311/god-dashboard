ull,{\\\"className\\\":\\\"LearnArticle_faqA__IPuvc\\\",\\\"children\\\":\\\"費城半導體今天跌 2.12%，臺股華新科（2492）跌 8.56%、冠星-KY（4439）跌 8.57%。同一天外資臺指期淨空 8.2 萬口，這些是同時發生的數據，公開資料看不出單一因果關係。\\\"}]]}],[\\\"$\\\",\\\"details\\\",\\\"4\\\",{\\\"className\\\":\\\"LearnArticle_faqItem__I9h0U\\\",\\\"children\\\":[[\\\"$\\\",\\\"summary\\\",null,{\\\"children\\\":\\\"今天成交金額多少？\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"LearnArticle_faqA__IPuvc\\\",\\\"children\\\":\\\"上市股票成交金額約 7,623.0 億元，735 檔上漲、225 檔下跌，平均漲 0.95%。\\\"}]]}]]}]]]}]\\n\"])</script><script>self.__next_f.push([1,\"1d:[\\\"$\\\",\\\"section\\\",\\\"sec-7\\\",{\\\"id\\\":\\\"sec-7\\\",\\\"className\\\":\\\"LearnArticle_section__hLVjU\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"LearnArticle_h2__NmJ08\\\",\\\"children\\\":\\\"總結\\\"}],[[\\\"$\\\",\\\"p\\\",\\\"0\\\",{\\\"className\\\":\\\"LearnArticle_p__aZlQ1\\\",\\\"children\\\":\\\"今天加權小漲 0.47% 收在 44,933 點，多數股票上漲但法人現貨期貨一致偏空，族群分化明顯，傳統產業與創新板領漲、存託憑證與居家生活類偏弱。\\\"}]]]}]\\n1e:[\\\"$\\\",\\\"section\\\",\\\"sec-8\\\",{\\\"id\\\":\\\"sec-8\\\",\\\"className\\\":\\\"LearnArticle_section__hLVjU\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"LearnArticle_h2__NmJ08\\\",\\\"children\\\":\\\"延伸閱讀\\\"}],[[\\\"$\\\",\\\"ul\\\",\\\"0\\\",{\\\"className\\\":\\\"LearnArticle_list__WjxqC\\\",\\\"children\\\":[[\\\"$\\\",\\\"li\\\",\\\"0\\\",{\\\"children\\\":[[\\\"$\\\",\\\"$L17\\\",\\\"0-臺股學堂：看懂法\\\",{\\\"href\\\":\\\"/school\\\",\\\"className\\\":\\\"LearnArticle_link__gMwHV\\\",\\\"children\\\":\\\"臺股學堂：看懂法人買賣超\\\"}]]}],[\\\"$\\\",\\\"li\\\",\\\"1\\\",{\\\"children\\\":[[\\\"$\\\",\\\"$L17\\\",\\\"0-族群透視（會員）\\\",{\\\"href\\\":\\\"/diary\\\",\\\"className\\\":\\\"LearnArticle_link__gMwHV\\\",\\\"children\\\":\\\"族群透視（會員）\\\"}]]}],[\\\"$\\\",\\\"li\\\",\\\"2\\\",{\\\"children\\\":[[\\\"$\\\",\\\"$L17\\\",\\\"0-新手導覽\\\",{\\\"href\\\":\\\"/diary\\\",\\\"className\\\":\\\"LearnArticle_link__gMwHV\\\",\\\"children\\\":\\\"新手導覽\\\"}]]}]