,\"a\",null,{\"href\":\"#sec-6\",\"children\":\"常見問題 FAQ\"}]}],[\"$\",\"li\",\"sec-7\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-7\",\"children\":\"總結\"}]}],[\"$\",\"li\",\"sec-8\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-8\",\"children\":\"延伸閱讀\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"LearnArticle_body__6B7Mb\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_intro__ATV5c\",\"children\":\"許多散戶朋友在觀察 K 線圖時，常會看到一些特殊的圖形，像是「頭肩底」這種聽起來很專業的詞彙，卻不知道它究竟代表什麼，甚至會把一些普通的盤整走勢誤認為底部反轉。這篇文章將帶你一步步拆解頭肩底型態的構成要素、判讀方式，以及它在市場上可能代表的意義，幫助你更精準地解讀 K 線圖上的訊息。\"}],[[\"$\",\"figure\",\"figure-0\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"頭在中間、肩在兩邊；要等頸線被站回左肩頭右肩沒過頸線就當未完成，不要提前說反轉\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"示意圖｜頭肩底：中間低點更低，兩肩較高，頸線在反彈高點（教學結構，不是某檔實盤）\"}]]}]],[\"$\",\"div\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"頭肩底是重要的底部反轉型態。\"}],[\"$\",\"li\",\"1\",{\"children\":\"由左肩、頭部、右肩及頸線組成。\"}],[\"$\",\"li\",\"2\",{\"children\":\"成交量變化是判斷關鍵因素。\"}],[\"$\",\"li\",\"3\",{\"children\":\"突破頸線不等於保證上漲。\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、什麼是頭肩底型態？它長什麼樣子？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"當股價經歷一段時間的下跌後，如果出現「左肩」、「頭部」和「右肩」三個連續的低點，並且中間的「頭部」是最低點，而兩側的「左肩」和「右肩」則相對較高，這就是我們常說的頭肩底型態。這種型態被視為股價從空頭轉為多頭的重要反轉訊號，暗示市場可能正在醞釀一波上漲行情，是許多投資人在尋找底部時會關注的圖形。\"}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、頭肩底的「左肩、頭部、右肩」怎麼看？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"要精準辨識頭肩底型態，首先要理解其三個主要構成部分：左肩、頭部和右肩。左肩是下跌後的第一次反彈，形成一個相對低點；接著股價再次下跌，創下比左肩更低的「頭部」，隨後反彈；最後，股價第三次下跌，形成一個比頭部高、但與左肩低點大致相當的「右肩」，然後再次反彈。這三個低點的相對位置，是判斷型態是否成立的關鍵，它反映了市場在下跌過程中，賣壓逐漸減輕的過程。\"}],[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"左肩：股價下跌後首次反彈，形成的第一個相對低點。\"}],[\"$\",\"li\",\"1\",{\"children\":\"頭部：股價再次下跌，創下比左肩更低的波段新低點，隨後反彈。\"}],[\"$\",\"li\",\"2\",{\"children\":\"右肩：股價第三次下跌，形成的低點高於頭部，且與左肩低點約略等高，隨後反彈。\"}]]}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、「頸線」是什麼？它在頭肩底扮演什麼角色？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"頸線是頭肩底型態中，連結左肩與頭部之間的反彈高點、以及頭部與右肩之間的反彈高點的一條線。這條線在型態形成初期，通常扮演著壓力線的角色，股價反彈至此常會受阻。然而，當股價帶量突破這條頸線時，就被視為頭肩底型態確立的關鍵訊號，暗示股價可能已經成功突破了長期的賣壓區，有機會展開一波上漲行情。頸線的斜率可以是水平、向上或向下，但向上傾斜的頸線通常被認為是更強的反轉訊號。\"}],[\"$\",\"figure\",\"1\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"!忽略成交量!誤認盤整區!期待必上漲!不防假突破\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"判讀頭肩底的常見誤區\"}]]}]]]}],[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[\"$L18\",[\"$L19\",\"$L1a\"]]}],\"$L1b\",\"$L1c\",\"$L1d\",\"$L1e\"],null]}]]}]}]\n18:[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、成交量在頭肩底型態中，該怎麼解讀？\"}]\n19:[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"光看 K 線圖形還不夠，成交量是判斷頭肩底型態是否可靠的另一個重要指標。一般來說，在左肩形成時，下跌的成交量可能較大，反彈時量縮；頭部形成時，下跌的成交量會比左肩時縮小，反彈量也較小；而右肩形成時，下跌的成交量會進一步縮小，顯示賣壓枯竭，最關鍵的是，當股價突破頸線時，成交量必須明顯放大，才能確認多頭的買盤力道足夠支撐股價上漲。如果突破頸線時沒有明顯的成交量配合，則型態的可靠性會大打折扣。\"}]\n1a:[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"型態階段\"}],[\"$\",\"th\",\"1\",{\"children\":\"股價走勢\"}],[\"$\",\"th\",\"2\",{\"children\":\"成交量特徵\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"左肩\"}],[\"$\",\"td\",\"1\",{\"children\":\"下跌後首次反彈，形成低點\"}],[\"$\",\"td\",\"2\",{\"children\":\"下跌時量大，反彈時量縮\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"頭部\"}],[\"$\",\"td\",\"1\",{\"children\":\"跌破左肩低點，創下新低後反彈\"}],[\"$\",\"td\",\"2\",{\"children\":\"下跌時量縮，反彈時量更縮\"}]]}],[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"右肩\"}],[\"$\",\"td\",\"1\",{\"children\":\"跌勢止於頭部上方，形成較高低點後反彈\"}],[\"$\",\"td\",\"2\",{\"children\":\"下跌時量縮，反彈時量能溫和放大\"}]]}],[\"$\",\"tr\",\"3\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"突破頸線\"}],[\"$\",\"td\",\"1\",{\"children\":\"股價向上突破頸線壓力\"}],[\"$\",\"td\",\"2\",{\"children\":\"成交量必須明顯放大，確認買盤力道\"}]]}]]}]]}]}]\n1b:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、頭肩底型態的突破訊號與常見誤讀\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"當股價帶量突破頸線，通常被視為頭肩底型態確認的訊號，表示多頭力量開始佔優勢。然而，許多投資人常會把一些盤整區間的突破，誤認為是頭肩底的成立，或是忽略了成交量的配合。一個常見的誤讀是，認為只要突破頸線就「保證」上漲，但市場並沒有絕對的保證。有時會出現「假突破」，股價短暫突破後又跌回頸線下方，甚至跌破右肩低點，這就需要投資人保持警惕，並搭配其他指標進行確認。在實際操作中，突破頸線後的「回測頸線不破」也是一個常見的現象，可作為觀察市場支撐力道的參考。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"確認突破頸線時，成交量是否明顯放大。\"}],[\"$\",\"li\",\"1\",{\"children\":\"避免將一般盤整區間的突破誤認為頭肩底。\"}],[\"$\",\"li\",\"2\",{\"children\":\"突破後若股價回測頸線，觀察頸線是否能提供支撐。\"}],[\"$\",\"li\",\"3\",{\"children\":\"搭配其他技術指標或基本面資訊，提高判斷準確性。\"}]]}]]]}]\n1c:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"頭肩底和頭肩頂有什麼不同？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"頭肩底是底部反轉型態，表示股價可能從下跌轉為上漲；頭肩頂則是頭部反轉型態，表示股價可能從上漲轉為下跌。兩者結構相似，但方向和出現的市場位置完全相反。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"頭肩底型態突破頸線後，股價一定會上漲嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"突破頸線是強烈的上漲訊號，但並非絕對保證。市場存在假突破的可能，股價可能短暫突破後又跌回。建議搭配成交量、其他指標和整體市場氛圍綜合判斷。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"如果頭肩底型態的成交量不明顯，還能參考嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"成交量是確認頭肩底型態可靠性的重要依據。如果突破頸線時成交量沒有明顯放大，型態的有效性會大打折扣，應謹慎看待，避免單純依賴圖形判斷。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"頭肩底型態有沒有可能出現「假突破」？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"是的，假突破是技術分析中常見的現象。股價可能短暫突破頸線後，很快又跌回頸線下方，甚至跌破右肩低點。這提醒我們，任何單一指標都有其限制，需多方驗證。\"}]]}]]}]]]}]\n1d:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"頭肩底型態是判斷股價可能從下跌轉為上漲的重要訊號，由左肩、頭部、右肩和頸線構成，其中突破頸線時的成交量放大是關鍵。理解其構成與量價關係，能幫助你辨識潛在的底部反轉，但務必搭配其他資訊綜合判斷，避免單一指標的誤導。\"}]]]}]\n1e:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L17\",\"0-更多台股技術分析\",{\"href\":\"/school\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"更多台股技術分析教學\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L17\",\"0-查看個股 K 線\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"查看個股 K 線與籌碼\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L17\",\"0-學習辨識其他技術\",{\"href\":\"/chart\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"學習辨識其他技術型態\"}]]}],[\"$\",\"li\",\"3\",{\"children\":[[\"$\",\"$L17\",\"0-股市大佬新手導覽\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"股市大佬新手導覽\"}]]}]]}]]]}]\n13:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\nf:null\n1f:I[80622,[],\"IconMark\"]\n11:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"頭肩底是什麼型態？結構、頸線與確認條件｜股市大佬 TradeBoss\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"許多散戶朋友在觀察 K 線圖時，常會看到一些特殊的圖形，像是「頭肩底」這種聽起來很專業的詞彙，卻不知道它究竟代表什麼，甚至會把一些普通的盤整走勢誤認為底部反轉。這篇文章將帶你一步步拆解頭肩底型態的構成要素、判讀方式，以及它在市場上可能代表的意義，幫助你更精準地解讀 K 線圖上的訊\"}],[\"$\",\"link\",\"2\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}],[\"$\",\"$L1f\",\"3\",{}]],\"error\":null,\"digest\":\"$undefined\"}\n16:\"$11:metadata\"\n"}