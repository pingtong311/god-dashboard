c/chunks/2619-04bc32f026a0d946.js\",\"6309\",\"static/chunks/app/learn/%5Bslug%5D/page-f7b99344f7e2ee16.js\"],\"\"]\nd:[\"$\",\"div\",null,{\"className\":\"LearnArticle_wrap__LIQ8G\",\"children\":[\"$\",\"article\",null,{\"className\":\"LearnArticle_article__2nBbk\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_meta__etj_G\",\"children\":[[\"$\",\"$L17\",null,{\"className\":\"LearnArticle_cat__GQMlg\",\"href\":\"/learn?c=orderbook\",\"children\":\"盤口掛單\"}],[\"$\",\"span\",null,{\"className\":\"LearnArticle_read__QEj6a\",\"children\":\"閱讀約 7 分鐘\"}]]}],[\"$\",\"h1\",null,{\"className\":\"LearnArticle_title__0_la8\",\"children\":\"五檔突然加深是什麼？看懂主力 3 種盤中暗號\"}],[\"$\",\"details\",null,{\"className\":\"LearnArticle_toc__LcSAa\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"LearnArticle_tocSummary__YBddG\",\"children\":\"本文目錄\"}],[\"$\",\"ol\",null,{\"className\":\"LearnArticle_tocList__Rq_Lz\",\"children\":[[\"$\",\"li\",\"sec-1\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-1\",\"children\":\"一、什麼是「五檔報價」？為什麼它會「加深」？\"}]}],[\"$\",\"li\",\"sec-2\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-2\",\"children\":\"二、買盤加深就是支撐？賣盤加深就是壓力嗎？\"}]}],[\"$\",\"li\",\"sec-3\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-3\",\"children\":\"三、如何分辨「真買盤」和「騙線假單」？\"}]}],[\"$\",\"li\",\"sec-4\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-4\",\"children\":\"四、看到掛單突然變厚，我該怎麼反應？一個判斷步驟\"}]}],[\"$\",\"li\",\"sec-5\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-5\",\"children\":\"五、除了掛單量，還有什麼指標能一起看？\"}]}],[\"$\",\"li\",\"sec-6\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-6\",\"children\":\"常見問題 FAQ\"}]}],[\"$\",\"li\",\"sec-7\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-7\",\"children\":\"總結\"}]}],[\"$\",\"li\",\"sec-8\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-8\",\"children\":\"延伸閱讀\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"LearnArticle_body__6B7Mb\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_intro__ATV5c\",\"children\":\"盯盤時看到買賣五檔掛單突然暴增，是主力要拉抬還是出貨？看不懂盤中暗號，常被騙上車或洗出場。本文教你從掛單變化，分辨真假單與多空力備，提升盤中判斷力。\"}],[[\"$\",\"figure\",\"figure-0\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"中間缺口是價差；張數是意願，不是承諾151.542 張151.088 張150.5120 張150.095 張149.5160 張149.070 張賣方五檔買方五檔大單靠近就消失，多半沒打算成交\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"示意圖｜五檔掛單：上面是想賣的，下面是想買的，都能隨時撤（教學結構，不是某檔實盤）\"}]]}]],[\"$\",\"div\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"「掛單加深」指買賣五檔的委託張數突然大增，是觀察主力意圖的窗口。\"}],[\"$\",\"li\",\"1\",{\"children\":\"外盤掛單加深可能是壓力，內盤加深可能是支撐，但要小心主力的騙線假單。\"}],[\"$\",\"li\",\"2\",{\"children\":\"真想買進的單會持續掛著，甚至追價；掛了又抽的「閃爍單」多半是為了誘騙。\"}],[\"$\",\"li\",\"3\",{\"children\":\"判斷時需搭配成交量與內外盤成交筆數，單看掛單量容易被誤導。\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、什麼是「五檔報價」？為什麼它會「加深」？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"在看盤軟體上，你會看到一支股票的報價旁邊，有「委買」跟「委賣」的區塊，這就是「五檔報價」。它顯示了目前市場上最接近成交價的五個買進價格和五個賣出價格，以及各自有多少張股票掛在那裡等著成交。「掛單加深」或「掛單變厚」，指的就是這些價格上的委託張數，在短時間內突然大幅增加，例如從幾十張瞬間變成幾百、甚至上千張。這代表有特定力量想在這些價位進行買賣，是我們判斷多空方向的第一個線索。\"}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、買盤加深就是支撐？賣盤加深就是壓力嗎？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"很多人會直覺地認為，買方（內盤）掛單變多，代表很多人想買，股價有支撐；賣方（外盤）掛單變多，代表賣壓沉重，股價有壓力。理論上是這樣沒錯，但實戰中，這常常是主力製造的「陷阱」。主力可以掛出大量的單，卻不打算真的成交，目的只是為了影響市場氣氛，引誘你做出錯誤的判斷。\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"情況\"}],[\"$\",\"th\",\"1\",{\"children\":\"可能的解讀\"}],[\"$\",\"th\",\"2\",{\"children\":\"常見的陷阱\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"買盤（內盤）掛單加深\"}],[\"$\",\"td\",\"1\",{\"children\":\"有大戶想在特定價位承接，形成支撐。\"}],[\"$\",\"td\",\"2\",{\"children\":\"掛假單製造支撐假象，誘使散戶進場後再撤單倒貨。\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"賣盤（外盤）掛單加深\"}],[\"$\",\"td\",\"1\",{\"children\":\"有大戶想在特定價位出貨，形成壓力。\"}],[\"$\",\"td\",\"2\",{\"children\":\"掛假單製造壓力假象，誘使散戶賣出後再拉抬吸籌。\"}]]}]]}]]}]}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、如何分辨「真買盤」和「騙線假單」？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"既然掛單有真有假，我們該怎麼分辨？關鍵在於觀察這些單的「穩定性」與「成交方向」。真正想成交的單，通常會穩定地掛著，即使股價靠近也不會輕易抽掉；而那些用來誘騙的假單，則常常掛上去又取消，像閃爍的霓虹燈一樣，目的只是吸引你的注意。\"}],\"$L18\",\"$L19\"]]}],\"$L1a\",\"$L1b\",\"$L1c\",\"$L1d\",\"$L1e\"],null]}]]}]}]\n18:[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"觀察持續性：真的想買的單會一直掛在那，甚至在股價接近時也不會抽掉，展現其決心。\"}],[\"$\",\"li\",\"1\",{\"children\":\"注意閃爍單：掛上去又馬上抽掉，反覆出現的單，通常是為了影響市場氣氛，不是真的要成交。\"}],[\"$\",\"li\",\"2\",{\"children\":\"搭配內外盤成交看：如果外盤掛了千張賣單，但實際成交價都敲在內盤，代表賣壓只是「看起來」大，實際上買方更積極。\"}]]}]\n19:[\"$\",\"figure\",\"2\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"✓持續掛著才是真✓掛了又抽是誘騙✓成交方向最重要\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"分辨真假單 3 個訣竅\"}]]}]\n1a:[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、看到掛單突然變厚，我該怎麼反應？一個判斷步驟\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"當你盤中看到五檔掛單突然風雲變色時，千萬不要衝動。你可以按照以下步驟，冷靜分析，而不是跟著市場情緒起舞。記住，多觀察一分鐘，可能就少一次虧損。\"}],[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"步驟一，先看位置：目前股價是在相對高檔還是低檔？在高檔整理時出現大量賣單要特別小心；在下跌一段後的低檔出現大量買單，才比較可能是支撐訊號。\"}],[\"$\",\"li\",\"1\",{\"children\":\"步驟二，再看變化：這些單是突然冒出來，還是一直都在？是持續增加，還是掛了就抽？持續掛著的單，參考價值比較高。\"}],[\"$\",\"li\",\"2\",{\"children\":\"步驟三，比對成交：打開「成交明細」，看是紅字的「外盤成交」多，還是綠字的「內盤成交」多？掛單不等於成交，錢真的花在哪個方向才是最重要的事。\"}]]}]]]}]\n1b:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、除了掛單量，還有什麼指標能一起看？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"單獨看五檔報價，就像只用一隻眼睛看世界，很容易有死角。為了做出更全面的判斷，你應該把它當作一個「警報器」，響了之後，再去搭配其他數據做交叉比對，這樣才能提高勝率。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"成交量：掛單再多，沒有成交量配合都是空談。成交量明顯放大，才代表多空雙方真的有在動作，而不只是擺擺樣子。\"}],[\"$\",\"li\",\"1\",{\"children\":\"大單成交：觀察成交明細中，是幾張、十幾張的小單在跳，還是有百張以上的大單敲進或敲出？這能看出大戶的真實動向。\"}],[\"$\",\"li\",\"2\",{\"children\":\"股價相對位置：搭配日 K 線圖，判斷目前股價處於長期趨勢的哪個階段。在上升趨勢中的大量買單，跟在下降趨勢中的大量買單，意義完全不同。\"}]]}]]]}]\n1c:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"看到買單（內盤）掛了上千張，是不是代表股價不會再跌了？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"不一定。這很可能是「假支撐」，主力掛給你看，讓你安心進場，但他可能隨時抽單並反手賣出。要觀察這些買單是否在股價接近時還穩穩掛著，並且有實際的內盤成交量來確認。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"為什麼有時候掛單很少，股價卻一直漲？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"這可能是所謂的「鎖籌碼」或市場追價意願強烈。當市場上多數籌碼被特定人鎖定，流通在外的張數變少，只需要較小的買單就能推動股價上漲，此時賣壓很輕，五檔掛單看起來就會很薄。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"「抽單」是什麼意思？主力為什麼要這麼做？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"「抽單」就是取消已經送出的委託掛單。主力抽單的目的很多，例如：製造買盤或賣壓突然消失的假象，引誘散戶追價或殺低；或是在成交前一刻抽單，避免自己的部位真的成交。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"手機看盤軟體怎麼看五檔報價？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"大部分的券商 App 在個股報價頁面，都會直接顯示「買賣五檔」的區塊，包含價格與掛單張數。通常左邊是委買（內盤），右邊是委賣（外盤），一眼就能看到。\"}]]}]]}]]]}]\n1d:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"總結來說，五檔掛單加深是解讀盤中多空力道的線索，但不是唯一的答案。記得「掛單是意圖，成交是事實」，將掛單變化與實際成交量、內外盤數據結合看，才能更準確地判斷市場方向，避免被假單迷惑。\"}]]]}]\n1e:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L17\",\"0-想學習更多台股知\",{\"href\":\"/school\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"想學習更多台股知識？歡迎到台股學堂\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L17\",\"0-在「個股透視」頁\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"在「個股透視」頁面，查看即時五檔報價與成交明細\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L17\",\"0-閱讀更多籌碼與技\",{\"href\":\"/learn\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"閱讀更多籌碼與技術分析教學文章\"}]]}]]}]]]}]\n13:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\nf:null\n1f:I[80622,[],\"IconMark\"]\n11:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"五檔突然加深是什麼？看懂主力 3 種盤中暗號｜股市大佬 TradeBoss\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"盯盤時看到買賣五檔掛單突然暴增，是主力要拉抬還是出貨？看不懂盤中暗號，常被騙上車或洗出場。本文教你從掛單變化，分辨真假單與多空力備，提升盤中判斷力。\"}],[\"$\",\"link\",\"2\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}],[\"$\",\"$L1f\",\"3\",{}]],\"error\":null,\"digest\":\"$undefined\"}\n16:\"$11:metadata\"\n"}