"$Lf\",[\"$\",\"$L10\",null,{\"promise\":\"$@11\"}]]}]]}]\nb:[\"$\",\"$1\",\"h\",{\"children\":[null,[[\"$\",\"$L12\",null,{\"children\":\"$L13\"}],[\"$\",\"meta\",null,{\"name\":\"next-size-adjust\",\"content\":\"\"}]],[\"$\",\"$L14\",null,{\"children\":[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$15\",null,{\"fallback\":null,\"children\":\"$L16\"}]}]}]]}]\n17:I[52619,[\"2619\",\"static/chunks/2619-04bc32f026a0d946.js\",\"6309\",\"static/chunks/app/learn/%5Bslug%5D/page-f7b99344f7e2ee16.js\"],\"\"]\nd:[\"$\",\"div\",null,{\"className\":\"LearnArticle_wrap__LIQ8G\",\"children\":[\"$\",\"article\",null,{\"className\":\"LearnArticle_article__2nBbk\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_meta__etj_G\",\"children\":[[\"$\",\"$L17\",null,{\"className\":\"LearnArticle_cat__GQMlg\",\"href\":\"/learn?c=orderbook\",\"children\":\"盤口掛單\"}],[\"$\",\"span\",null,{\"className\":\"LearnArticle_read__QEj6a\",\"children\":\"閱讀約 5 分鐘\"}]]}],[\"$\",\"h1\",null,{\"className\":\"LearnArticle_title__0_la8\",\"children\":\"內外盤比怎麼看才不會被流動性扭曲？3個檢查\"}],[\"$\",\"details\",null,{\"className\":\"LearnArticle_toc__LcSAa\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"LearnArticle_tocSummary__YBddG\",\"children\":\"本文目錄\"}],[\"$\",\"ol\",null,{\"className\":\"LearnArticle_tocList__Rq_Lz\",\"children\":[[\"$\",\"li\",\"sec-1\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-1\",\"children\":\"一、它量的是誰比較急，不是誰比較強\"}]}],[\"$\",\"li\",\"sec-2\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-2\",\"children\":\"二、為什麼流動性會把比例扭歪\"}]}],[\"$\",\"li\",\"sec-3\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-3\",\"children\":\"三、三種常見誤讀\"}]}],[\"$\",\"li\",\"sec-4\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-4\",\"children\":\"四、三個檢查，讓比例回到它該在的位置\"}]}],[\"$\",\"li\",\"sec-5\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-5\",\"children\":\"五、它可以當背景，不能當答案\"}]}],[\"$\",\"li\",\"sec-6\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-6\",\"children\":\"常見問題 FAQ\"}]}],[\"$\",\"li\",\"sec-7\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-7\",\"children\":\"總結\"}]}],[\"$\",\"li\",\"sec-8\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-8\",\"children\":\"延伸閱讀\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"LearnArticle_body__6B7Mb\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_intro__ATV5c\",\"children\":\"外盤多就被講成買方強，內盤多就被講成賣方逃。句子很順，分母常沒對齊。內外盤比記錄的是「誰願意用比較差的價格立刻成交」，不是誰比較有錢、也不是後面會往哪走。流動性一薄、或程式把單拆得很碎，同一個比例可以完全換意思。這篇只教你怎麼讀、怎麼檢查，不把它升級成方向。\"}],[[\"$\",\"figure\",\"figure-0\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"中間缺口是價差；張數是意願，不是承諾151.542 張151.088 張150.5120 張150.095 張149.5160 張149.070 張賣方五檔買方五檔大單靠近就消失，多半沒打算成交\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"示意圖｜五檔掛單：上面是想賣的，下面是想買的，都能隨時撤（教學結構，不是某檔實盤）\"}]]}]],[\"$\",\"div\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"外盤是主動去吃賣方掛價，內盤是主動去砸買方掛價\"}],[\"$\",\"li\",\"1\",{\"children\":\"比例會被薄盤、大單與拆單扭曲，先對自己的歷史再看數字\"}],[\"$\",\"li\",\"2\",{\"children\":\"它適合當「誰比較急」的背景，不適合當下一步的答案\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、它量的是誰比較急，不是誰比較強\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"成交落在賣方揭示價，叫外盤，代表買方願意立刻成交，多付一點價差。成交落在買方揭示價，叫內盤，代表賣方比較急。急切程度有資訊，因為它已經發生、不是還能撤的掛單。強不強是另一件事：急著買的人可能只是補券、避險、或趕在某個時間前做完，不一定有你想像的那套故事。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"外盤＝主動吃賣價\"}],[\"$\",\"li\",\"1\",{\"children\":\"內盤＝主動砸買價\"}],[\"$\",\"li\",\"2\",{\"children\":\"急切不等於方向，也不等於後續還會急\"}]]}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、為什麼流動性會把比例扭歪\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"日均量很小的股票，一筆幾十張就能讓當下的內外盤比一邊倒。你看到的不是市場共識，是剛好有人走過。反過來說，流動性很厚時，拆單會把急切藏進很多筆看起來很普通的成交。同一套「外盤七成」在薄盤是噪音，在厚盤可能被演算法洗成五五波。不先問這檔平常一分鐘走多少張，比例沒有發言權。\"}],[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"先看這檔平常的成交速度\"}],[\"$\",\"li\",\"1\",{\"children\":\"再看今天這一筆相對平常大不大\"}],[\"$\",\"li\",\"2\",{\"children\":\"最後才讀內外盤的比例\"}]]}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、三種常見誤讀\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"聊天室最常把比例直接翻譯成多空。比較穩的讀法是先問：這個數字是被少數大單抬上去的，還是長時間慢慢偏的？開盤初段、漲跌停附近、剛恢復交易時，撮合方式與排隊規則都會讓內外盤看起來很極端，那些極端比較像機制，不像投票。\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"你看到的\"}],[\"$\",\"th\",\"1\",{\"children\":\"字面翻譯\"}],[\"$\",\"th\",\"2\",{\"children\":\"比較穩的一問\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"外盤比突然很高\"}],[\"$\",\"td\",\"1\",{\"children\":\"買方很強\"}],[\"$\",\"td\",\"2\",{\"children\":\"是不是少數幾筆就撐起比例\"}]]}],\"$L18\",\"$L19\",\"$L1a\"]}]]}]}],\"$L1b\"]]}],\"$L1c\",\"$L1d\",\"$L1e\",\"$L1f\",\"$L20\"],\"$L21\"]}]]}]}]\n18:[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"內盤比偏高很久\"}],[\"$\",\"td\",\"1\",{\"children\":\"有人在出\"}],[\"$\",\"td\",\"2\",{\"children\":\"成交速度有沒有同時放大\"}]]}]\n19:[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"比例幾乎五五\"}],[\"$\",\"td\",\"1\",{\"children\":\"沒人急\"}],[\"$\",\"td\",\"2\",{\"children\":\"有沒有被拆單洗成看起來很平\"}]]}]\n1a:[\"$\",\"tr\",\"3\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"開盤前幾分鐘一邊倒\"}],[\"$\",\"td\",\"1\",{\"children\":\"方向已定\"}],[\"$\",\"td\",\"2\",{\"children\":\"那是隔夜單與機制，先當雜訊\"}]]}]\n1b:[\"$\",\"figure\",\"2\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"!薄盤一筆就歪!拆單洗成五五!開盤機制造成一邊倒\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"三種扭曲\"}]]}]\n1c:[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、三個檢查，讓比例回到它該在的位置\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"第一，跟這檔自己最近幾天的內外盤比，不要跟別檔比。第二，對一下單位時間成交張數：比例偏、量也放大，資訊比較不像幻覺；比例偏、量卻瘦，多半是分母太小。第三，看有沒有連續小單把比例推過去——那比較像程式節奏，不像一個人的決心。三個檢查都只是否定用：過不了，就不要賦予它劇情。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"自己跟自己比\"}],[\"$\",\"li\",\"1\",{\"children\":\"比例要配合成交速度\"}],[\"$\",\"li\",\"2\",{\"children\":\"連續碎單先當節奏，不當決心\"}]]}]]]}]\n1d:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、它可以當背景，不能當答案\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"比較健康的用法是寫一句：今天主動成交比較偏哪一邊。這句話幫助你描述現場，不幫助你決定下一步。方向、點位、停損停利都不該從一個比長出來。掛單還能撤、揭示只有五檔、你也看不到誰在拆單。資訊層這麼短命，只適合當執行時的氣氛，不適合當研究主體。\"}]]]}]\n1e:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"外盤比多少才算有意義？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"沒有通用門檻。先看這檔自己的歷史，再看成交速度。沒對齊分母的高比例，多半只是算術。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"內外盤比和委買委賣差是同一件事嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"不是。內外盤是已經成交的主動方向；委買委賣差是還沒成交、隨時可撤的掛單。急著成交和掛著等，資訊層級不同。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"拆單會讓比例失效嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"會被稀釋。演算法常把急切拆成很多筆看起來普通的成交，所以「看起來很平衡」也可能只是被洗過。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"開盤初段的內外盤能信嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"那段隔夜單與自動化策略同時湧入，極端很常見。比較適合當背景音，不適合當天的第一個結論。\"}]]}]]}]]]}]\n1f:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"內外盤比量的是誰比較急著成交。流動性薄、大單與拆單都會扭曲比例。先自己比自己、再對成交速度，它只能當背景，不能當方向。\"}]]]}]\n20:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L17\",\"0-五檔掛單四層讀法\",{\"href\":\"/learn/how-to-read-order-book-five-levels\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"五檔掛單四層讀法\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L17\",\"0-試撮階段的假單\",{\"href\":\"/learn/pre-market-matching-fake-orders\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"試撮階段的假單\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L17\",\"0-台股學堂\",{\"href\":\"/school\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"台股學堂\"}]]}]]}]]]}]\n21:[\"$\",\"div\",null,{\"className\":\"LearnArticle_related__9qV55\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_relatedTitle__RXfrl\",\"children\":\"相關文章\"}],[[\"$\",\"$L17\",\"how-to-read-order-book-five-levels\",{\"href\":\"/learn/how-to-read-order-book-five-levels\",\"className\":\"LearnArticle_relatedLink__mibXe\",\"children\":\"五檔掛單四層讀法\"}],[\"$\",\"$L17\",\"pre-market-matching-fake-orders\",{\"href\":\"/learn/pre-market-matching-fake-orders\",\"className\":\"LearnArticle_relatedLink__mibXe\",\"children\":\"試撮階段的假單\"}]]]}]\n13:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\nf:null\n22:I[80622,[],\"IconMark\"]\n11:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"內外盤比怎麼看才不會被流動性扭曲？3個檢查｜股市大佬 TradeBoss\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"外盤多就被講成買方強，內盤多就被講成賣方逃。句子很順，分母常沒對齊。內外盤比記錄的是「誰願意用比較差的價格立刻成交」，不是誰比較有錢、也不是後面會往哪走。流動性一薄、或程式把單拆得很碎，同一個比例可以完全換意思。這篇只教你怎麼讀、怎麼檢查，不把它升級成方向。\"}],[\"$\",\"link\",\"2\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}],[\"$\",\"$L22\",\"3\",{}]],\"error\":null,\"digest\":\"$undefined\"}\n16:\"$11:metadata\"\n"}