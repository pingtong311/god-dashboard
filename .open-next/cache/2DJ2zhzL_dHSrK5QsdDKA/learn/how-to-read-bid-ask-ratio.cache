\":\"LearnArticle_article__2nBbk\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_meta__etj_G\",\"children\":[[\"$\",\"$L17\",null,{\"className\":\"LearnArticle_cat__GQMlg\",\"href\":\"/learn?c=orderbook\",\"children\":\"盤口掛單\"}],[\"$\",\"span\",null,{\"className\":\"LearnArticle_read__QEj6a\",\"children\":\"閱讀約 7 分鐘\"}]]}],[\"$\",\"h1\",null,{\"className\":\"LearnArticle_title__0_la8\",\"children\":\"內外盤比怎麼看？別只看紅綠，3 步驟看懂盤口買賣力道\"}],[\"$\",\"details\",null,{\"className\":\"LearnArticle_toc__LcSAa\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"LearnArticle_tocSummary__YBddG\",\"children\":\"本文目錄\"}],[\"$\",\"ol\",null,{\"className\":\"LearnArticle_tocList__Rq_Lz\",\"children\":[[\"$\",\"li\",\"sec-1\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-1\",\"children\":\"一、什麼是內盤、外盤？1 分鐘看懂定義\"}]}],[\"$\",\"li\",\"sec-2\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-2\",\"children\":\"二、內外盤比如何計算？關鍵數字這樣解讀\"}]}],[\"$\",\"li\",\"sec-3\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-3\",\"children\":\"三、內外盤比搭配股價走勢，判斷多空力道的 4 種情境\"}]}],[\"$\",\"li\",\"sec-4\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-4\",\"children\":\"四、小心！主力最愛用這 2 招讓內外盤比失真\"}]}],[\"$\",\"li\",\"sec-5\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-5\",\"children\":\"五、我該如何應用？給新手的實戰檢查清單\"}]}],[\"$\",\"li\",\"sec-6\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-6\",\"children\":\"常見問題 FAQ\"}]}],[\"$\",\"li\",\"sec-7\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-7\",\"children\":\"總結\"}]}],[\"$\",\"li\",\"sec-8\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-8\",\"children\":\"延伸閱讀\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"LearnArticle_body__6B7Mb\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_intro__ATV5c\",\"children\":\"打開個股的即時走勢，除了紅紅綠綠的 K 棒，旁邊總有一堆數字在跳，一下「內盤」、一下「外盤」，到底哪個是買、哪個是賣？數字變大是好事還是壞事？這篇文章會帶你從頭看懂內外盤比是什麼，以及如何用它來判斷當下的多空力道，讓你不再只會看漲跌，更能看懂盤中的氣氛變化。\"}],[[\"$\",\"figure\",\"figure-0\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"中間缺口是價差；張數是意願，不是承諾151.542 張151.088 張150.5120 張150.095 張149.5160 張149.070 張賣方五檔買方五檔大單靠近就消失，多半沒打算成交\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"示意圖｜五檔掛單：上面是想賣的，下面是想買的，都能隨時撤（教學結構，不是某檔實盤）\"}]]}]],[\"$\",\"div\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"外盤成交代表「買方追價意願」，內盤成交代表「賣方急著賣出」。\"}],[\"$\",\"li\",\"1\",{\"children\":\"內外盤比 > 60% 且股價漲，表示追價力道強；反之 < 40% 且股價跌，表示賣壓沉重。\"}],[\"$\",\"li\",\"2\",{\"children\":\"單看內外盤比會失真，需搭配「總成交量」與「股價位置」綜合判斷。\"}],[\"$\",\"li\",\"3\",{\"children\":\"注意主力可能用「內盤掛假單、外盤敲真單」的方式製造買氣假象。\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、什麼是內盤、外盤？1 分鐘看懂定義\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"在看盤軟體中，你會看到「委買價」和「委賣價」，這就是內盤和外盤的基礎。所謂的「內盤」就是委買價，代表買方願意出的最高價；「外盤」則是委賣價，代表賣方願意賣的最低價。當一筆交易成交在內盤價，表示是賣方等不及，直接用買方開的價格賣掉，這筆成交量就會計入內盤；反之，成交在外盤價，就是買方等不及，直接用賣方開的價格買進，成交量就計入外盤。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"內盤 (Bid)：成交在「委買價」，代表賣方較為急切，視為偏空訊號。\"}],[\"$\",\"li\",\"1\",{\"children\":\"外盤 (Ask)：成交在「委賣價」，代表買方較為急切，視為偏多訊號。\"}],[\"$\",\"li\",\"2\",{\"children\":\"簡單記法：外盤成交，股價往上跳動；內盤成交，股價則往下跳動。\"}]]}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、內外盤比如何計算？關鍵數字這樣解讀\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"看懂內外盤的定義後，「內外盤比」就是衡量買賣雙方積極程度的指標。它的計算公式是：「外盤成交量 ÷ (內盤成交量 + 外盤成交量) × 100%」。這個比例告訴我們，在所有成交量中，由買方積極追價的佔了多少。例如，一檔股票總成交 1,000 張，其中外盤成交 700 張，內盤成交 300 張，內外盤比就是 700 ÷ (300+700) = 70%。\"}],[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"內外盤比 > 60%：代表買方追價意願非常強烈，市場看多氣氛濃厚。\"}],[\"$\",\"li\",\"1\",{\"children\":\"內外盤比 < 40%：代表賣方殺出意願強烈，市場看空氣氛濃厚。\"}],[\"$\",\"li\",\"2\",{\"children\":\"內外盤比在 40% - 60% 之間：代表買賣雙方力道均衡，股價可能陷入盤整。\"}]]}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、內外盤比搭配股價走勢，判斷多空力道的 4 種情境\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"單看內外盤比的數字是不夠的，因為市場上有很多方法可以製造假象。一個聰明的投資人，會把內外盤比和「股價走勢」放在一起看，才能看出盤口背後的真相。如果內外盤比很高，股價卻漲不動，這就是一個警訊，代表可能有看不見的賣壓存在。\"}],\"$L18\",\"$L19\"]]}],\"$L1a\",\"$L1b\",\"$L1c\",\"$L1d\",\"$L1e\"],null]}]]}]}]\n18:[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"情境\"}],[\"$\",\"th\",\"1\",{\"children\":\"內外盤比\"}],[\"$\",\"th\",\"2\",{\"children\":\"股價走勢\"}],[\"$\",\"th\",\"3\",{\"children\":\"可能的市場解讀\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"健康攻擊盤\"}],[\"$\",\"td\",\"1\",{\"children\":\"> 60%\"}],[\"$\",\"td\",\"2\",{\"children\":\"上漲\"}],[\"$\",\"td\",\"3\",{\"children\":\"價量配合，買方力道真實，後市看好。\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"恐慌殺盤\"}],[\"$\",\"td\",\"1\",{\"children\":\"< 40%\"}],[\"$\",\"td\",\"2\",{\"children\":\"下跌\"}],[\"$\",\"td\",\"3\",{\"children\":\"賣壓沉重，投資人爭相出場，應保守看待。\"}]]}],[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"誘多出貨\"}],[\"$\",\"td\",\"1\",{\"children\":\"> 60%\"}],[\"$\",\"td\",\"2\",{\"children\":\"盤整或小漲\"}],[\"$\",\"td\",\"3\",{\"children\":\"外盤雖強但股價漲不動，小心主力邊拉邊出貨。\"}]]}],[\"$\",\"tr\",\"3\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"力竭觀望\"}],[\"$\",\"td\",\"1\",{\"children\":\"< 40%\"}],[\"$\",\"td\",\"2\",{\"children\":\"盤整或小跌\"}],[\"$\",\"td\",\"3\",{\"children\":\"賣壓雖重但股價跌不深，多空都在觀望等待方向。\"}]]}]]}]]}]}]\n19:[\"$\",\"figure\",\"2\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"!價量背離要小心!高檔爆量非好事!主力可能製造假象!勿當唯一買賣依據\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"內外盤比常見陷阱\"}]]}]\n1a:[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、小心！主力最愛用這 2 招讓內外盤比失真\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"內外盤比是個好用的即時指標，但也因為太容易觀察，反而成為市場大戶用來影響散戶心態的工具。他們會利用資金優勢，製造出想要的內外盤比數據，引誘你做出錯誤的判斷。了解他們的手法，才能避免掉入陷阱。\"}],[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"手法一：外盤敲小單，內盤掛大單。他們會用連續的小筆買單去敲外盤價，讓內外盤比看起來很高、買氣旺盛，但實際上在內盤掛著真正想賣的大單，等你追進去，正好幫他們出貨。\"}],[\"$\",\"li\",\"1\",{\"children\":\"手法二：拉高後倒貨。在開盤或盤中，用少量資金快速把股價拉高，此時外盤比會瞬間飆升，吸引市場注意。當散戶看到強勢訊號跟著買進時，他們就開始把手上的部位倒出來，此時你會發現內盤成交量開始悄悄放大。\"}]]}]]]}]\n1b:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、我該如何應用？給新手的實戰檢查清單\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"了解原理和陷阱後，最終還是要回歸到如何應用在自己的看盤流程中。這裡提供一個簡單的檢查清單，幫助你在盤中運用內外盤比時，能有更全面的思考，而不是只看到單一數字就衝動下決定。養成好習慣，才能提高判斷的準確度。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"先看大盤氣氛：大盤不好時，多數個股的買氣都會受影響，逆勢上漲的個股要更小心。\"}],[\"$\",\"li\",\"1\",{\"children\":\"再看個股位階：股價是在長期高檔還是低檔？高檔區出現異常高的外盤比，要提防是最後的煙火。\"}],[\"$\",\"li\",\"2\",{\"children\":\"比對走勢是否背離：最重要的就是檢查「價量關係」，外盤比很高但股價漲不動，就是警訊。\"}],[\"$\",\"li\",\"3\",{\"children\":\"搭配分點券商觀察：想知道這些買賣盤是誰掛的？可以到「股市大佬」的個股透視頁面，追蹤關鍵分點的動向。\"}]]}]]]}]\n1c:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"內外盤比要在哪裡看？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"大部分的券商看盤軟體，在個股的「即時走勢」或「五檔報價」頁面，都會提供內盤量、外盤量與內外盤比的數據。通常會以數字或紅綠長條圖顯示。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"內外盤比是越高越好嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"不一定。如果股價已經在波段高點，卻出現超過 80% 的超高內外盤比，反而要小心是主力在誘多出貨，吸引最後一批投資人進場，後續可能出現反轉。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"為什麼有時候內盤量加外盤量，不等於總成交量？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"因為有些成交會發生在「內盤價與外盤價之間」，或是開盤與收盤的集合競價。這些成交不會被歸類在內盤或外盤，所以兩者加總通常會略小於當日的總成交量。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"這個指標適合用在當沖或短線交易嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"內外盤比是觀察盤中力道變化的重要參考，對短線交易者很有幫助。但因為它變化快速且可能被影響，建議當作輔助判斷工具，而不是唯一的進出訊號。\"}]]}]]}]]]}]\n1d:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"總結來說，看懂內外盤比，就像學會看懂球賽中的攻防氣勢。單看比數（股價漲跌）不夠，還要看是誰在積極進攻（外盤）、誰在拼命防守（內盤）。記得，永遠要搭配股價位置和成交量一起看，才能更準確地判斷盤口的真實力道。\"}]]]}]\n1e:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L17\",\"0-想深入研究特定分\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"想深入研究特定分點的動向？來個股透視頁看看\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L17\",\"0-對更多籌碼名詞感\",{\"href\":\"/school\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"對更多籌碼名詞感到好奇？台股學堂有完整解釋\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L17\",\"0-想知道今天大盤的\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"想知道今天大盤的整體氣氛？先從大盤總覽開始\"}]]}]]}]]]}]\n13:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\nf:null\n1f:I[80622,[],\"IconMark\"]\n11:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"內外盤比怎麼看？別只看紅綠，3 步驟看懂盤口買賣力道｜股市大佬 TradeBoss\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"打開個股的即時走勢，除了紅紅綠綠的 K 棒，旁邊總有一堆數字在跳，一下「內盤」、一下「外盤」，到底哪個是買、哪個是賣？數字變大是好事還是壞事？這篇文章會帶你從頭看懂內外盤比是什麼，以及如何用它來判斷當下的多空力道，讓你不再只會看漲跌，更能看懂盤中的氣氛變化。\"}],[\"$\",\"link\",\"2\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}],[\"$\",\"$L1f\",\"3\",{}]],\"error\":null,\"digest\":\"$undefined\"}\n16:\"$11:metadata\"\n"}