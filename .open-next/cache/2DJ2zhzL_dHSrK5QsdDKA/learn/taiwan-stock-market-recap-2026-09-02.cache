[\"$\",\"p\",null,{\"className\":\"LearnArticle_intro__ATV5c\",\"children\":\"今天台灣股市呈現較大幅度下跌。加權指數收盤下跌1.66%，最終來到46164.72點，而櫃買指數也同步走弱，下跌0.92%。整體盤面氣氛偏弱，且國際主要股市普遍下挫。\"}],[],[\"$\",\"div\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"加權指數下跌1.66%，收在46164.72點。\"}],[\"$\",\"li\",\"1\",{\"children\":\"國際主要股市普遍走弱，影響台股表現。\"}],[\"$\",\"li\",\"2\",{\"children\":\"上市下跌家數多於上漲家數，市場氣氛偏保守。\"}],[\"$\",\"li\",\"3\",{\"children\":\"外資台指期淨空單達85,329口。\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、大盤表現與國際連動\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"今天台股加權指數收盤下跌1.66%，最終來到46164.72點，成交金額約8894.0億元。櫃買指數也同步走弱，下跌0.92%，收在406.96點。整體來看，上市股票下跌家數534家，多於上漲家數377家，顯示大盤普遍承壓。\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"指數名稱\"}],[\"$\",\"th\",\"1\",{\"children\":\"今日收盤\"}],[\"$\",\"th\",\"2\",{\"children\":\"漲跌幅\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"加權指數\"}],[\"$\",\"td\",\"1\",{\"children\":\"46164.72\"}],[\"$\",\"td\",\"2\",{\"children\":\"-1.66%\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"櫃買指數\"}],[\"$\",\"td\",\"1\",{\"children\":\"406.96\"}],[\"$\",\"td\",\"2\",{\"children\":\"-0.92%\"}]]}],[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"台指期\"}],[\"$\",\"td\",\"1\",{\"children\":\"46189.0\"}],[\"$\",\"td\",\"2\",{\"children\":\"-2.16%\"}]]}],[\"$\",\"tr\",\"3\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"S&P 500 (前日)\"}],[\"$\",\"td\",\"1\",{\"children\":\"-\"}],[\"$\",\"td\",\"2\",{\"children\":\"-0.71%\"}]]}],[\"$\",\"tr\",\"4\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"那斯達克 (前日)\"}],[\"$\",\"td\",\"1\",{\"children\":\"-\"}],[\"$\",\"td\",\"2\",{\"children\":\"-1.03%\"}]]}],[\"$\",\"tr\",\"5\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"費城半導體 (前日)\"}],[\"$\",\"td\",\"1\",{\"children\":\"-\"}],[\"$\",\"td\",\"2\",{\"children\":\"-2.14%\"}]]}],[\"$\",\"tr\",\"6\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"韓國綜合 (前日)\"}],[\"$\",\"td\",\"1\",{\"children\":\"-\"}],[\"$\",\"td\",\"2\",{\"children\":\"-3.99%\"}]]}],[\"$\",\"tr\",\"7\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"日經 225 (前日)\"}],[\"$\",\"td\",\"1\",{\"children\":\"-\"}],[\"$\",\"td\",\"2\",{\"children\":\"-2.85%\"}]]}]]}]]}]}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、類股漲跌與族群動態\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"在大盤普遍走弱的背景下，部分類股仍展現相對抗跌或逆勢上漲的表現。其中，數位雲端類股以1.20%的漲幅居冠，電子通路業與通信網路業也呈現小幅上漲。相對地，創新板股票、化學工業及金融業則表現較為疲軟。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"數位雲端類：上漲1.20%，3檔，領漲股為6870 騰雲。\"}],[\"$\",\"li\",\"1\",{\"children\":\"電子通路業：上漲0.71%，36檔，領漲股為3055 蔚華科。\"}],[\"$\",\"li\",\"2\",{\"children\":\"通信網路業：上漲0.67%，91檔，領漲股為2419 仲琦。\"}],[\"$\",\"li\",\"3\",{\"children\":\"光電業：上漲0.66%，121檔，領漲股為4976 佳凌。\"}],[\"$\",\"li\",\"4\",{\"children\":\"創新板股票：下跌1.96%，為今日表現最弱勢族群。\"}],[\"$\",\"li\",\"5\",{\"children\":\"化學工業：下跌0.93%。\"}],[\"$\",\"li\",\"6\",{\"children\":\"金融業：下跌0.84%。\"}]]}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[\"$L18\",[\"$L19\",\"$L1a\",\"$L1b\"]]}],\"$L1c\",\"$L1d\",\"$L1e\",\"$L1f\",\"$L20\"],null]}]]}]}]\n18:[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、個股表現觀察\"}]\n19:[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"今日上市個股表現分歧，部分股票錄得明顯漲幅，而另一些則出現較大跌幅。值得注意的是，6669 緯穎今日跌幅達66.54%，成交量為10869張，是今日跌幅最深的個股。\"}]\n1a:[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"今日漲幅較大的股票包括：6224 聚鼎 (+9.96%)、5285 界霖 (+9.94%)、4976 佳凌 (+9.92%)、6451 訊芯-KY (+9.89%)、2438 翔耀 (+9.86%)、2419 仲琦 (+9.84%)。\"}],[\"$\",\"li\",\"1\",{\"children\":\"今日跌幅較大的股票包括：6669 緯穎 (-66.54%)、6805 富世達 (-7.66%)、2308 台達電 (-7.24%)、2243 宏旭-KY (-7.14%)、2404 漢唐 (-6.82%)、1714 和桐 (-6.47%)。\"}],[\"$\",\"li\",\"2\",{\"children\":\"當沖熱門股（量比高）有：亞信 (量比 29.0x)、穎台科技 (量比 12.5x)、晶宏 (量比 11.8x)、匯鑽科 (量比 9.8x)、華宏 (量比 9.4x)、柏騰 (量比 8.9x)。\"}]]}]\n1b:[\"$\",\"figure\",\"2\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"📊數位雲端類上漲📈電子通路業上漲🧭創新板股票下跌📘化學工業走弱\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"族群表現兩樣情\"}]]}]\n1c:[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、法人動向與市場籌碼\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"觀察法人在現貨市場的動向，外資今日買賣超約1,010,113張，而自營商則賣超約391,800張。在期貨市場方面，外資台指期淨空單達到85,329口。全市場融資維持率為193.9%。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"外資現貨買賣超：約1,010,113張。\"}],[\"$\",\"li\",\"1\",{\"children\":\"自營商現貨買賣超：約-391,800張。\"}],[\"$\",\"li\",\"2\",{\"children\":\"外資台指期淨空單：85,329口。\"}],[\"$\",\"li\",\"3\",{\"children\":\"全市場融資維持率：193.9%。\"}],[\"$\",\"li\",\"4\",{\"children\":\"今日台股新聞標題提到：三大法人買賣超 – 外資買超(2303)聯電、(2330)台積電，投信買超(3017)奇鋐、(1303)南亞，法人合計買。\"}]]}]]]}]\n1d:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、今日焦點與國際消息\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"今日市場焦點主要圍繞在特定個股的表現與相關討論。多則新聞標題提及聯電在爆量漲停後的隔日表現，以及矽晶圓報價上揚對相關個股的激勵作用。國際方面，近期川普與美國政策相關消息持續受到關注。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"今日台股新聞標題包括：「【股市焦點】聯電爆量漲停後驚見「只跌1元」！新光證券：下一波盯這關鍵」、「三大法人買賣超 – 外資買超(2303)聯電、(2330)台積電，投信買超(3017)奇鋐、(1303)南亞，法人合計買」、「矽晶圓報價上揚激勵！聯電衝破130大關轟16萬 華邦電紅翻黑噴9.5萬張 - FTNN 新聞網」、「聯電散戶突破百萬人，矽晶圓三雄台勝科攻漲停，當心！散戶瘋狂承接下的風險- 上市櫃」。\"}],[\"$\",\"li\",\"1\",{\"children\":\"近三日川普／美國政策相關標題：川普峰会前数周，习对伊朗总统保持距离；中国领先之际，川普瞄准美国科学界；贝森特称19位财长同意「廉价出口」不可持续，但中国投了反对票。\"}]]}]]]}]\n1e:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"今天台股大盤跌幅多少？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"今日台股加權指數下跌1.66%，收在46164.72點。櫃買指數也下跌0.92%，收在406.96點。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"今天哪些族群表現比較好？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"今天表現相對強勢的族群有數位雲端類 (+1.20%)、電子通路業 (+0.71%)、通信網路業 (+0.67%) 和光電業 (+0.66%)。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"法人今天在台股做了什麼？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"外資在現貨市場買超約1,010,113張，自營商則賣超約391,800張。在台指期貨方面，外資淨空單為85,329口。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"為什麼今天大盤會下跌？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"今日大盤下跌與國際主要股市普遍走弱的現象同時發生，例如S&P 500、那斯達克、費城半導體、韓國綜合及日經225指數均呈現下跌。公開資料看不出單一原因。\"}]]}]]}]]]}]\n1f:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"今日台股加權指數呈現較大幅度下跌，主要權值股表現疲弱，整體市場氛圍偏向觀望。國際股市的普遍走低也對台股造成壓力。\"}]]]}]\n20:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L17\",\"0-看得懂的錨文字\",{\"href\":\"/school\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"看得懂的錨文字\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L17\",\"0-了解法人動向\",{\"href\":\"/chips/2330\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"了解法人動向\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L17\",\"0-追蹤個股表現\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"追蹤個股表現\"}]]}],[\"$\",\"li\",\"3\",{\"children\":[[\"$\",\"$L17\",\"0-掌握大盤資訊\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"掌握大盤資訊\"}]]}]]}]]]}]\n13:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\nf:null\n21:I[80622,[],\"IconMark\"]\n11:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"2026年9月2日台股收盤：加權指數大跌1.66%，國際股市同步走弱｜股市大佬 TradeBoss\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"今天台灣股市呈現較大幅度下跌。加權指數收盤下跌1.66%，最終來到46164.72點，而櫃買指數也同步走弱，下跌0.92%。整體盤面氣氛偏弱，且國際主要股市普遍下挫。\"}],[\"$\",\"link\",\"2\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}],[\"$\",\"$L21\",\"3\",{}]],\"error\":null,\"digest\":\"$undefined\"}\n16:\"$11:metadata\"\n"}