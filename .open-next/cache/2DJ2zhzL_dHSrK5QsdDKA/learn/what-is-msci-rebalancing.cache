9\",\"static/chunks/2619-04bc32f026a0d946.js\",\"6309\",\"static/chunks/app/learn/%5Bslug%5D/page-f7b99344f7e2ee16.js\"],\"\"]\nd:[\"$\",\"div\",null,{\"className\":\"LearnArticle_wrap__LIQ8G\",\"children\":[\"$\",\"article\",null,{\"className\":\"LearnArticle_article__2nBbk\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_meta__etj_G\",\"children\":[[\"$\",\"$L17\",null,{\"className\":\"LearnArticle_cat__GQMlg\",\"href\":\"/learn?c=chips\",\"children\":\"籌碼面\"}],[\"$\",\"span\",null,{\"className\":\"LearnArticle_read__QEj6a\",\"children\":\"閱讀約 7 分鐘\"}]]}],[\"$\",\"h1\",null,{\"className\":\"LearnArticle_title__0_la8\",\"children\":\"MSCI 調整權重是什麼？為何一公佈外資就大買賣？3 分鐘看懂對台股的影響\"}],[\"$\",\"details\",null,{\"className\":\"LearnArticle_toc__LcSAa\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"LearnArticle_tocSummary__YBddG\",\"children\":\"本文目錄\"}],[\"$\",\"ol\",null,{\"className\":\"LearnArticle_tocList__Rq_Lz\",\"children\":[[\"$\",\"li\",\"sec-1\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-1\",\"children\":\"一、到底什麼是 MSCI？為什麼它一句話能撼動台股？\"}]}],[\"$\",\"li\",\"sec-2\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-2\",\"children\":\"二、「調整權重」是在調什麼？對我的股票有何影響？\"}]}],[\"$\",\"li\",\"sec-3\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-3\",\"children\":\"三、MSCI 調整的時程表：何時知道結果？何時會發生？\"}]}],[\"$\",\"li\",\"sec-4\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-4\",\"children\":\"四、如何判斷哪些股票可能被納入或剔除？\"}]}],[\"$\",\"li\",\"sec-5\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-5\",\"children\":\"五、看到股票被 MSCI 納入，可以直接買進嗎？一個常見誤解\"}]}],[\"$\",\"li\",\"sec-6\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-6\",\"children\":\"常見問題 FAQ\"}]}],[\"$\",\"li\",\"sec-7\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-7\",\"children\":\"總結\"}]}],[\"$\",\"li\",\"sec-8\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-8\",\"children\":\"延伸閱讀\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"LearnArticle_body__6B7Mb\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_intro__ATV5c\",\"children\":\"每隔一陣子，新聞就會報導「MSCI 最新季度調整，台股權重升降」，接著就看到外資在尾盤有幾百億的大單敲進或賣出，這到底是什麼神秘力量？其實這不是內線，而是一個全球基金經理人都在參考的公開規則。這篇文章就是要帶你搞懂 MSCI 調整的遊戲規則，讓你下次看到新聞不再一頭霧水。\"}],[[\"$\",\"figure\",\"figure-0\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"高集中度只說明買超很集中，不說明是誰、要幹嘛前 15 大其餘成交例：集中度 40%＝這批分點淨買超約當天成交的四成不能從集中度推出明天方向\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"示意圖｜分點集中度：前幾大買超合計，佔當天成交的比例（教學結構，不是某檔實盤）\"}]]}]],[\"$\",\"div\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"MSCI 是全球基金經理人的重要參考指標，權重調整會引導數千億美元的被動資金流動。\"}],[\"$\",\"li\",\"1\",{\"children\":\"權重「調升」或「新增」成分股，通常會吸引被動資金買盤，反之則有賣壓。\"}],[\"$\",\"li\",\"2\",{\"children\":\"調整結果公佈日到生效日之間市場常有波動，但生效日當天尾盤的爆量才是重點。\"}],[\"$\",\"li\",\"3\",{\"children\":\"散戶不應只因 MSCI 調整就買進，需搭配公司基本面與技術面綜合判斷。\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、到底什麼是 MSCI？為什麼它一句話能撼動台股？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"你可能常聽到 MSCI，但它到底是什麼？簡單說，MSCI（明晟公司）是一家編制全球股市指數的公司，就像是股市的「米其林指南」。全球有非常多的基金，特別是追蹤大盤的 ETF（指數股票型基金），會完全照著 MSCI 的「成分股名單」和「比重」來買股票。所以當 MSCI 說台股在這本指南裡的比重變高了，這些基金就必須跟著買進台股，帶來龐大的資金動能。\"}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、「調整權重」是在調什麼？對我的股票有何影響？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"所謂「調整權重」，就是 MSCI 重新評估各國股市或各家公司在指數裡的「佔比」。這就像調整食譜配方，例如一道菜的糖從 10% 改成 12%。對應到股市，如果台股在「MSCI 新興市場指數」的權重被從 15% 調高到 15.2%，一個管理 1000 億美金的基金，就必須多買進 2 億美金的台股。反之，如果某檔股票被剔除成分股，基金就必須賣掉它，這就是引發巨大買盤或賣壓的原因。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"國家權重調整：例如「台股」在「新興市場指數」中的佔比變動。\"}],[\"$\",\"li\",\"1\",{\"children\":\"新增成分股：某檔股票首次被納入指數名單。\"}],[\"$\",\"li\",\"2\",{\"children\":\"剔除成分股：某檔股票從指數名單中被移除。\"}],[\"$\",\"li\",\"3\",{\"children\":\"個股權重調整：某檔成分股在指數內的佔比變動。\"}]]}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、MSCI 調整的時程表：何時知道結果？何時會發生？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"MSCI 的調整並不是突襲，而是有固定時程的。他們每年會在 2、5、8、11 月進行季度調整，其中 5 月和 11 月是規模較大的半年度調整。搞懂「公佈日」和「生效日」的差別很重要，因為市場反應的時間點不同。通常在公佈後股價就可能開始反應，但最大量的資金流動會集中在生效日當天的最後一盤。（資訊以 MSCI 官方公告為準，本文查證月份：2026-08）\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":\"$L18\"}],\"$L19\"]]}],\"$L1a\",\"$L1b\",\"$L1c\",\"$L1d\",\"$L1e\"],null]}]]}]}]\n18:[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"時間點\"}],[\"$\",\"th\",\"1\",{\"children\":\"發生什麼事\"}],[\"$\",\"th\",\"2\",{\"children\":\"投資人該注意什麼\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"公佈日 (Announcement Date)\"}],[\"$\",\"td\",\"1\",{\"children\":\"MSCI 公布最新的調整名單與權重變動。\"}],[\"$\",\"td\",\"2\",{\"children\":\"市場開始預期資金流向，股價可能提前波動。\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"生效日 (Effective Date)\"}],[\"$\",\"td\",\"1\",{\"children\":\"調整正式生效，被動式基金必須在此日收盤前完成部位調整。\"}],[\"$\",\"td\",\"2\",{\"children\":\"尾盤常出現巨額成交量，股價可能劇烈震盪。\"}]]}]]}]]}]\n19:[\"$\",\"figure\",\"2\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"✓了解規則不恐慌✓利多可能已發酵✓回歸公司基本面✓勿當唯一買賣依據\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"面對 MSCI 調整的正確心態\"}]]}]\n1a:[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、如何判斷哪些股票可能被納入或剔除？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"雖然我們無法 100% 預測 MSCI 的決定，但可以從幾個方向觀察。MSCI 在挑選成分股時，主要看三大指標：公司的「市值」規模、股票的「流動性」（也就是成交量熱不熱絡），以及「自由流通股數」（在外流通、可供交易的股份多不多）。一般來說，市值排名在市場前段班、每天成交量都很大、而且大股東持股沒有過度集中的公司，被納入的機會就比較高。\"}],[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"市值門檻：通常是市場中規模最大的公司群。\"}],[\"$\",\"li\",\"1\",{\"children\":\"流動性門檻：過去一段時間的日均成交金額必須達到一定標準。\"}],[\"$\",\"li\",\"2\",{\"children\":\"自由流通比率：扣除政府、內部人、關聯企業等長期持股後，在外流通的股權比例。\"}]]}]]]}]\n1b:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、看到股票被 MSCI 納入，可以直接買進嗎？一個常見誤解\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"這是最多人犯的錯：聽到某檔股票被納入 MSCI 成分股，就以為是利多保證，馬上跳進去。但請記住，這個消息從公佈到生效，市場上很多人都已經知道了，股價可能早就漲了一段。等到生效日當天，被動基金的大量買盤進場時，反而可能是早期卡位的人獲利了結的好時機。因此，MSCI 調整只是一個「事件」，不能當作唯一的買賣依據，還是要回歸公司的基本面和產業前景來判斷。\"}]]]}]\n1c:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"MSCI 調整權重，多久一次？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"每年四次，分別在 2、5、8、11 月。其中 5 月和 11 月是半年度調整，變動幅度通常較大；2 月和 8 月是季度調整，變動較小。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"為什麼 MSCI 調整會讓台股尾盤爆大量？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"因為追蹤指數的被動式基金（如 ETF），必須在「生效日」當天收盤前，將持股調整到符合新權重的比例。為了盡量貼近收盤價以減少追蹤誤差，他們的買賣單會集中在最後一盤撮合，造成瞬間的巨大成交量。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"台股權重被調降，就一定會大跌嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"不一定。權重調降確實會引發被動資金賣壓，但影響股價的因素很多。如果當時台股基本面強勁，主動型基金的買盤可能會抵銷賣壓。反之，若市場氣氛本來就不好，權重調降就可能加重跌勢。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"除了 MSCI，還有哪些重要的國際指數？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"除了 MSCI（明晟），另一個全球投資人高度關注的是「富時羅素（FTSE Russell）」指數。兩者都是全球指數編製的巨頭，他們的權重調整同樣會對台股造成顯著影響，規則和觀察重點也相當類似。\"}]]}]]}]]]}]\n1d:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"總結來說，MSCI 權重調整是觀察外資被動資金流向的重要參考，但它是一個短期事件。聰明的投資人會把它當作一個「籌碼觀察指標」，了解市場短期波動的原因，而不是盲目跟著消息進出。最終的投資決策，還是要建立在對公司長期價值的判斷上。\"}]]]}]\n1e:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L17\",\"0-到台股學堂了解更\",{\"href\":\"/school\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"到台股學堂了解更多專有名詞\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L17\",\"0-觀察大盤籌碼流向\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"觀察大盤籌碼流向\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L17\",\"0-用個股透視查詢公\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"用個股透視查詢公司基本面\"}]]}]]}]]]}]\n13:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\nf:null\n1f:I[80622,[],\"IconMark\"]\n11:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"MSCI 調整權重是什麼？為何一公佈外資就大買賣？3 分鐘看懂對台股的影響｜股市大佬 TradeBoss\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"每隔一陣子，新聞就會報導「MSCI 最新季度調整，台股權重升降」，接著就看到外資在尾盤有幾百億的大單敲進或賣出，這到底是什麼神秘力量？其實這不是內線，而是一個全球基金經理人都在參考的公開規則。這篇文章就是要帶你搞懂 MSCI 調整的遊戲規則，讓你下次看到新聞不再一頭霧水。\"}],[\"$\",\"link\",\"2\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}],[\"$\",\"$L1f\",\"3\",{}]],\"error\":null,\"digest\":\"$undefined\"}\n16:\"$11:metadata\"\n"}