52619,[\"2619\",\"static/chunks/2619-04bc32f026a0d946.js\",\"6309\",\"static/chunks/app/learn/%5Bslug%5D/page-f7b99344f7e2ee16.js\"],\"\"]\nd:[\"$\",\"div\",null,{\"className\":\"LearnArticle_wrap__LIQ8G\",\"children\":[\"$\",\"article\",null,{\"className\":\"LearnArticle_article__2nBbk\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_meta__etj_G\",\"children\":[[\"$\",\"$L17\",null,{\"className\":\"LearnArticle_cat__GQMlg\",\"href\":\"/learn?c=mindset\",\"children\":\"心態與風控\"}],[\"$\",\"span\",null,{\"className\":\"LearnArticle_read__QEj6a\",\"children\":\"閱讀約 4 分鐘\"}]]}],[\"$\",\"h1\",null,{\"className\":\"LearnArticle_title__0_la8\",\"children\":\"定錨效應怎麼影響判斷？成本價為什麼不該當羅盤\"}],[\"$\",\"details\",null,{\"className\":\"LearnArticle_toc__LcSAa\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"LearnArticle_tocSummary__YBddG\",\"children\":\"本文目錄\"}],[\"$\",\"ol\",null,{\"className\":\"LearnArticle_tocList__Rq_Lz\",\"children\":[[\"$\",\"li\",\"sec-1\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-1\",\"children\":\"一、錨為什麼這麼黏\"}]}],[\"$\",\"li\",\"sec-2\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-2\",\"children\":\"二、交易裡最常見的三個錨\"}]}],[\"$\",\"li\",\"sec-3\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-3\",\"children\":\"三、一個可以寫下來的檢查\"}]}],[\"$\",\"li\",\"sec-4\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-4\",\"children\":\"四、技術線也會變成錨\"}]}],[\"$\",\"li\",\"sec-5\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-5\",\"children\":\"五、跟損失趨避一起時更黏\"}]}],[\"$\",\"li\",\"sec-6\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-6\",\"children\":\"常見問題 FAQ\"}]}],[\"$\",\"li\",\"sec-7\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-7\",\"children\":\"總結\"}]}],[\"$\",\"li\",\"sec-8\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-8\",\"children\":\"延伸閱讀\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"LearnArticle_body__6B7Mb\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_intro__ATV5c\",\"children\":\"你買在一百，現在九十五，大腦很容易覺得「回到一百就不虧」。一百對市場沒有意義，對你的記憶很有意義。這就是定錨：第一個或最刺眼的數字，會把後面的比較全部拉過去。交易裡錨到處都是——成本、前高、新聞標題裡的數字。不先標出錨，你以為自己在分析，其實在跟記憶討價還價。\"}],[[\"$\",\"figure\",\"figure-0\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"沒扣成本的勝率，看起來都會比較漂亮0.029%手續費 1 折來回0.15%當沖證交稅0.06%滑價估計三項合計約 0.24%；留倉稅率更高，約 0.39%\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"示意圖｜當沖來回成本：1 折手續費 + 證交稅 + 滑價（教學結構，不是某檔實盤）\"}]]}]],[\"$\",\"div\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"錨是記憶裡的數字，不是市場的義務\"}],[\"$\",\"li\",\"1\",{\"children\":\"成本價、前高、整數，最常把判斷拉歪\"}],[\"$\",\"li\",\"2\",{\"children\":\"先寫「沒有這個數字時我會怎麼看」，再決定要不要理它\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、錨為什麼這麼黏\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"大腦要用少數數字做決定，最先進來的那個最省事。後面即使來了新資訊，也常只是在錨附近微調，而不是重做。所以你會覺得「再等五塊就好」，五塊的來源是錨，不是新的研究。黏不是因為那個價神聖，是因為重做很累。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"先到的數字最好用\"}],[\"$\",\"li\",\"1\",{\"children\":\"後面常只是微調，不是重做\"}],[\"$\",\"li\",\"2\",{\"children\":\"累的時候最容易抱著錨\"}]]}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、交易裡最常見的三個錨\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"成本價：讓你把「回到原點」當成目標。前高前低：讓你以為市場記得那條線。新聞或群組丟出來的整數：讓你在沒有功課的情況下有一個可以討論的點。三個都可以當參考，一旦變成必須回來的地方，分析就停了。\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"錨\"}],[\"$\",\"th\",\"1\",{\"children\":\"大腦翻譯\"}],[\"$\",\"th\",\"2\",{\"children\":\"比較穩的問法\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"成本價\"}],[\"$\",\"td\",\"1\",{\"children\":\"回到這裡就不虧\"}],[\"$\",\"td\",\"2\",{\"children\":\"沒有成本時，現在值不值得持有\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"前高\"}],[\"$\",\"td\",\"1\",{\"children\":\"一定會再測\"}],[\"$\",\"td\",\"2\",{\"children\":\"現在的量價還支不支持那條線\"}]]}],[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"整數關卡\"}],[\"$\",\"td\",\"1\",{\"children\":\"大家都看這裡\"}],[\"$\",\"td\",\"2\",{\"children\":\"大家都看的地方離開會不會擠\"}]]}],[\"$\",\"tr\",\"3\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"別人的買進價\"}],[\"$\",\"td\",\"1\",{\"children\":\"他比較準\"}],[\"$\",\"td\",\"2\",{\"children\":\"他的規則你用不用得起\"}]]}]]}]]}]}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、一個可以寫下來的檢查\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"拿一張紙，把你心裡那個「應該回到」的數字蓋住，重問：以現在公開資訊，這個部位的理由還在不在？失效條件碰到了沒有？若理由已不在，錨再漂亮也只是回憶。這個檢查不保證你賣在最好，它只阻止你為了回憶繼續持有。\"}],\"$L18\",\"$L19\"]]}],\"$L1a\",\"$L1b\",\"$L1c\",\"$L1d\",\"$L1e\"],\"$L1f\"]}]]}]}]\n18:[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"寫下那個揮之不去的數字\"}],[\"$\",\"li\",\"1\",{\"children\":\"蓋住它，重問理由還在不在\"}],[\"$\",\"li\",\"2\",{\"children\":\"理由不在就走規則，不走回憶\"}]]}]\n19:[\"$\",\"figure\",\"2\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"✓理由還在嗎✓失效到了嗎✓還是只想回本\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"蓋住再問\"}]]}]\n1a:[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、技術線也會變成錨\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"均線、型態、前波，畫上去就有了位置。位置有用，因為很多人看；也危險，因為你會把「碰到」當成義務。支撐壓力那篇講過失效；這裡補的是心理：線一旦畫了，就容易變成你必須捍衛的東西。線是假設，不是地盤。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"線是假設，不是地盤\"}],[\"$\",\"li\",\"1\",{\"children\":\"大家都看的線，離開可能擁擠\"}],[\"$\",\"li\",\"2\",{\"children\":\"碰到不自動等於有效\"}]]}]]]}]\n1b:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、跟損失趨避一起時更黏\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"錨在成本，痛在虧損，兩件事會互相加固：你既不想做實虧損，又覺得市場欠你一個回到錨的機會。市場不欠人。把兩篇的規則疊在一起：上限先執行，再允許自己討論那個數字還有沒有研究意義。\"}]]]}]\n1c:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"完全不理成本，是不是就不理性？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"檢討績效時要看成本；決定現在還要不要持有時，成本常是噪音。兩件事分開。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"前高完全沒有用嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"可以當很多人可能注意到的位置。當義務就過了。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"整數關卡為什麼常被討論？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"好講、好看、好傳。傳播方便不等於有效。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"怎麼訓練自己少定錨？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"把檢查寫進日誌欄位：我現在的錨是什麼、蓋住之後理由還在不在。重複比頓悟有用。\"}]]}]]}]]]}]\n1d:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"定錨讓成本、前高與整數變成市場欠你的位置。先蓋住那個數字，重問理由與失效。線與關卡是假設，不是地盤。\"}]]]}]\n1e:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L17\",\"0-損失趨避\",{\"href\":\"/learn/loss-aversion-in-trading\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"損失趨避\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L17\",\"0-支撐壓力為什麼失\",{\"href\":\"/learn/support-resistance-how-to-draw\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"支撐壓力為什麼失效\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L17\",\"0-確認偏誤\",{\"href\":\"/learn/confirmation-bias-in-trading-decisions\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"確認偏誤\"}]]}]]}]]]}]\n1f:[\"$\",\"div\",null,{\"className\":\"LearnArticle_related__9qV55\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_relatedTitle__RXfrl\",\"children\":\"相關文章\"}],[[\"$\",\"$L17\",\"loss-aversion-in-trading\",{\"href\":\"/learn/loss-aversion-in-trading\",\"className\":\"LearnArticle_relatedLink__mibXe\",\"children\":\"損失趨避\"}],[\"$\",\"$L17\",\"support-resistance-how-to-draw\",{\"href\":\"/learn/support-resistance-how-to-draw\",\"className\":\"LearnArticle_relatedLink__mibXe\",\"children\":\"支撐壓力為什麼失效\"}],[\"$\",\"$L17\",\"confirmation-bias-in-trading-decisions\",{\"href\":\"/learn/confirmation-bias-in-trading-decisions\",\"className\":\"LearnArticle_relatedLink__mibXe\",\"children\":\"確認偏誤\"}]]]}]\n13:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\nf:null\n20:I[80622,[],\"IconMark\"]\n11:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"定錨效應怎麼影響判斷？成本價為什麼不該當羅盤｜股市大佬 TradeBoss\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"你買在一百，現在九十五，大腦很容易覺得「回到一百就不虧」。一百對市場沒有意義，對你的記憶很有意義。這就是定錨：第一個或最刺眼的數字，會把後面的比較全部拉過去。交易裡錨到處都是——成本、前高、新聞標題裡的數字。不先標出錨，你以為自己在分析，其實在跟記憶討價還價。\"}],[\"$\",\"link\",\"2\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}],[\"$\",\"$L20\",\"3\",{}]],\"error\":null,\"digest\":\"$undefined\"}\n16:\"$11:metadata\"\n"}