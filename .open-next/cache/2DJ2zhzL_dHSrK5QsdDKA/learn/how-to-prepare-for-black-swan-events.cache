$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$15\",null,{\"fallback\":null,\"children\":\"$L16\"}]}]}]]}]\n17:I[52619,[\"2619\",\"static/chunks/2619-04bc32f026a0d946.js\",\"6309\",\"static/chunks/app/learn/%5Bslug%5D/page-f7b99344f7e2ee16.js\"],\"\"]\nd:[\"$\",\"div\",null,{\"className\":\"LearnArticle_wrap__LIQ8G\",\"children\":[\"$\",\"article\",null,{\"className\":\"LearnArticle_article__2nBbk\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_meta__etj_G\",\"children\":[[\"$\",\"$L17\",null,{\"className\":\"LearnArticle_cat__GQMlg\",\"href\":\"/learn?c=events\",\"children\":\"金融大事件\"}],[\"$\",\"span\",null,{\"className\":\"LearnArticle_read__QEj6a\",\"children\":\"閱讀約 6 分鐘\"}]]}],[\"$\",\"h1\",null,{\"className\":\"LearnArticle_title__0_la8\",\"children\":\"黑天鵝事件怎麼準備？別只會恐慌，3 步驟打造更耐震的投資組合\"}],[\"$\",\"details\",null,{\"className\":\"LearnArticle_toc__LcSAa\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"LearnArticle_tocSummary__YBddG\",\"children\":\"本文目錄\"}],[\"$\",\"ol\",null,{\"className\":\"LearnArticle_tocList__Rq_Lz\",\"children\":[[\"$\",\"li\",\"sec-1\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-1\",\"children\":\"一、什麼是黑天鵝？為什麼我們該提前準備？\"}]}],[\"$\",\"li\",\"sec-2\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-2\",\"children\":\"二、防禦第一步：你的「緊急預備金」夠嗎？\"}]}],[\"$\",\"li\",\"sec-3\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-3\",\"children\":\"三、打造耐震組合：雞蛋該怎麼分籃子放？\"}]}],[\"$\",\"li\",\"sec-4\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-4\",\"children\":\"四、定期體檢：如何汰弱留強，而不是自亂陣腳？\"}]}],[\"$\",\"li\",\"sec-5\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-5\",\"children\":\"五、黑天鵝來臨時，真正該做什麼（或不該做什麼）？\"}]}],[\"$\",\"li\",\"sec-6\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-6\",\"children\":\"常見問題 FAQ\"}]}],[\"$\",\"li\",\"sec-7\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-7\",\"children\":\"總結\"}]}],[\"$\",\"li\",\"sec-8\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-8\",\"children\":\"延伸閱讀\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"LearnArticle_body__6B7Mb\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_intro__ATV5c\",\"children\":\"市場總有意外，黑天鵝事件一來，帳戶就綠油油？與其事後懊悔，不如學會事前準備。本文教你從資產配置與現金比例著手，建立更穩健的投資心態。\"}],[],[\"$\",\"div\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"黑天鵝無法預測，但能透過資產配置降低衝擊。\"}],[\"$\",\"li\",\"1\",{\"children\":\"保留足夠的緊急預備金，是面對危機的第一道防線。\"}],[\"$\",\"li\",\"2\",{\"children\":\"定期檢視投資組合，汰弱留強，避免重壓單一產業。\"}],[\"$\",\"li\",\"3\",{\"children\":\"危機時保持冷靜，避免情緒化交易，才是保護資產的關鍵。\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、什麼是黑天鵝？為什麼我們該提前準備？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"「黑天鵝」指的是那些極度罕見、無法預測，但一旦發生就會造成巨大衝擊的事件，像是 2008 年的金融海嘯或 2020 年的全球疫情。因為它無法預測，所以我們的目標不是去猜它何時來，而是建立一個體質強健的投資組合，讓它就算真的來了，我們也能安然度過，甚至還有餘力把握危機入市的機會。\"}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、防禦第一步：你的「緊急預備金」夠嗎？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"在風暴中，現金就是你最可靠的盟友。這裡的現金，指的是「緊急預備金」，也就是至少 6 個月到 1 年的生活費，而且是放在隨時可動用的活存帳戶。這筆錢有兩個關鍵作用：第一，當你頓失收入時，不必被迫在市場低點賣出股票變現；第二，當市場出現非理性的超跌時，你才有「銀彈」可以分批布局。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"判斷門檻：至少準備 6 個月生活費的現金。\"}],[\"$\",\"li\",\"1\",{\"children\":\"常見錯誤：把所有資金都投入股市，認為閒置現金會被通膨吃掉，卻忽略了流動性風險。\"}]]}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、打造耐震組合：雞蛋該怎麼分籃子放？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"資產配置聽起來很複雜，其實核心概念很簡單：不要把所有錢都押在同一種資產上。只持有股票，就像開一艘速度很快的快艇，風平浪靜時很棒，但一個大浪就可能翻船。適度加入一些跟股市連動性較低的資產（例如債券型 ETF），就像幫快艇加裝了穩定翼，雖然速度慢一點，但更能在風雨中前行。\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"資產組合範例\"}],[\"$\",\"th\",\"1\",{\"children\":\"假設股市大跌 30%\"}],[\"$\",\"th\",\"2\",{\"children\":\"帳戶總價值變化（以 100 萬本金計）\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"A：100% 台股\"}],[\"$\",\"td\",\"1\",{\"children\":\"100 萬 * (1 - 30%) = 70 萬\"}],[\"$\",\"td\",\"2\",{\"children\":\"下跌 30 萬 (-30%)\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"B：60% 台股, 40% 債券\"}],[\"$\",\"td\",\"1\",{\"children\":\"股 60萬*(1-30%) + 債 40萬*(1-5%) = 42萬 + 38萬 = 80萬\"}],[\"$\",\"td\",\"2\",{\"children\":\"下跌 20 萬 (-20%)\"}]]}]]}]]}]}],[\"$\",\"figure\",\"2\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"!情緒化拋售持股!頻繁進出想抓低點!聽信市場不實消息!忘記原訂投資計畫\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"市場恐慌時的常見錯誤\"}]]}]]]}],\"$L18\",\"$L19\",\"$L1a\",\"$L1b\",\"$L1c\"],null]}]]}]}]\n18:[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、定期體檢：如何汰弱留強，而不是自亂陣腳？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"一個健康的投資組合需要定期保養，而不是等到出事才大修。建議你每半年或一年，檢視一次自己的持股。檢查的重點不是短線的漲跌，而是：這家公司的基本面變差了嗎？它所在的產業前景還看好嗎？我的持股是不是過度集中在某個族群了？透過定期檢視，你才能理性地做出調整，而不是在市場恐慌時，跟著大家一起亂賣。\"}],[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"設定一個固定時間（例如每半年）來檢視資產比例。\"}],[\"$\",\"li\",\"1\",{\"children\":\"賣出理由應基於基本面變化，而非市場情緒。\"}],[\"$\",\"li\",\"2\",{\"children\":\"如果某個資產漲太多導致佔比過高，可適度獲利了結，再平衡回原本設定的比例。\"}]]}]]]}]\n19:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、黑天鵝來臨時，真正該做什麼（或不該做什麼）？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"當黑天鵝真的出現，市場連續大跌時，最重要的不是去預測底部在哪，而是「管好你的手」。恐慌性地賣出，通常只會賣在相對低點，這正是散戶最常犯的錯誤。此時，你該做的是回到你的計畫：檢查緊急預備金是否足夠？評估這次事件對你持股的長期影響是什麼？如果評估後認為長期價值不變，那麼不動作，甚至在能力範圍內分批加碼，都比殺低來得明智。\"}]]]}]\n1a:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"黑天鵝事件多久會發生一次？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"依照定義，黑天鵝事件無法預測發生頻率。與其擔心它何時會來，不如將心力放在平時就做好準備，讓自己的投資組合有足夠的抵抗力。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"危機時，是不是該把所有股票賣掉換現金？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"在市場恐慌時全部賣出，通常是最低點的行為，等於是將帳面虧損實現為永久虧損。比較好的做法是回歸計畫，檢視自己的現金流與資產配置，而不是情緒化地清空部位。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"黃金或加密貨幣可以當作避險工具嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"黃金常被視為傳統避險資產，但價格波動也不小。加密貨幣則是波動性更高的風險資產。若要納入投資組合，建議佔比不要太高，且必須先做足功課、了解其風險。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"我的持股已經虧損很多了，現在準備還來得及嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"任何時候開始準備都不晚。第一步是停止在恐慌中繼續交易，先穩住陣腳。接著，誠實評估自己的財務狀況與風險承受度，等市場回穩後，再逐步將投資組合調整到更健康的狀態。\"}]]}]]}]]]}]\n1b:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"面對黑天鵝事件，最好的策略不是試圖預測下一次危機，而是建立一個無論晴雨都能讓你睡得安穩的投資組合。透過合理的資產配置、充足的現金準備與投資紀律，你就能在市場的驚濤駭浪中，守住自己的資產。\"}]]]}]\n1c:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L17\",\"0-想打好投資基本功\",{\"href\":\"/school\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"想打好投資基本功？從台股學堂開始\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L17\",\"0-檢查你的持股是否\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"檢查你的持股是否過度集中在某些族群\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L17\",\"0-隨時掌握大盤整體\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"隨時掌握大盤整體趨勢與健康度\"}]]}]]}]]]}]\n13:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\nf:null\n1d:I[80622,[],\"IconMark\"]\n11:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"黑天鵝事件怎麼準備？別只會恐慌，3 步驟打造更耐震的投資組合｜股市大佬 TradeBoss\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"市場總有意外，黑天鵝事件一來，帳戶就綠油油？與其事後懊悔，不如學會事前準備。本文教你從資產配置與現金比例著手，建立更穩健的投資心態。\"}],[\"$\",\"link\",\"2\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}],[\"$\",\"$L1d\",\"3\",{}]],\"error\":null,\"digest\":\"$undefined\"}\n16:\"$11:metadata\"\n"}