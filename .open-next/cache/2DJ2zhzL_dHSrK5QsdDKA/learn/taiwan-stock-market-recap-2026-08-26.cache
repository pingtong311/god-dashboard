\":\"LearnArticle_toc__LcSAa\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"LearnArticle_tocSummary__YBddG\",\"children\":\"本文目錄\"}],[\"$\",\"ol\",null,{\"className\":\"LearnArticle_tocList__Rq_Lz\",\"children\":[[\"$\",\"li\",\"sec-1\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-1\",\"children\":\"一、大盤表現概況\"}]}],[\"$\",\"li\",\"sec-2\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-2\",\"children\":\"二、盤面焦點族群\"}]}],[\"$\",\"li\",\"sec-3\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-3\",\"children\":\"三、個股表現一覽\"}]}],[\"$\",\"li\",\"sec-4\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-4\",\"children\":\"四、法人與籌碼動態\"}]}],[\"$\",\"li\",\"sec-5\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-5\",\"children\":\"五、國際盤勢與相關消息\"}]}],[\"$\",\"li\",\"sec-6\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-6\",\"children\":\"常見問題 FAQ\"}]}],[\"$\",\"li\",\"sec-7\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-7\",\"children\":\"總結\"}]}],[\"$\",\"li\",\"sec-8\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-8\",\"children\":\"延伸閱讀\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"LearnArticle_body__6B7Mb\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_intro__ATV5c\",\"children\":\"2026年8月26日台股今日表現強勁，加權指數上漲1.46%，收在45832.62點。櫃買指數也同步走高，上漲1.60%。整體盤面氣氛偏多，上市股票以上漲家數為多數。\"}],[],[\"$\",\"div\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"加權指數與櫃買指數同步上漲。\"}],[\"$\",\"li\",\"1\",{\"children\":\"半導體、光電業為今日強勢族群。\"}],[\"$\",\"li\",\"2\",{\"children\":\"航運業類股今日表現偏弱。\"}],[\"$\",\"li\",\"3\",{\"children\":\"外資與自營商今日在現貨市場賣超。\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、大盤表現概況\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"今日台股加權指數收在45832.62點，上漲1.46%，櫃買指數也表現不俗，上漲1.60%，收在395.66點。上市股票中，上漲家數達776家，遠多於下跌的176家，顯示市場整體買氣旺盛。今日總成交金額約7691.0億元。\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"指數名稱\"}],[\"$\",\"th\",\"1\",{\"children\":\"收盤價\"}],[\"$\",\"th\",\"2\",{\"children\":\"漲跌幅\"}],[\"$\",\"th\",\"3\",{\"children\":\"上漲家數\"}],[\"$\",\"th\",\"4\",{\"children\":\"下跌家數\"}],[\"$\",\"th\",\"5\",{\"children\":\"成交金額\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"加權指數\"}],[\"$\",\"td\",\"1\",{\"children\":\"45832.62\"}],[\"$\",\"td\",\"2\",{\"children\":\"+1.46%\"}],[\"$\",\"td\",\"3\",{\"children\":\"776\"}],[\"$\",\"td\",\"4\",{\"children\":\"176\"}],[\"$\",\"td\",\"5\",{\"children\":\"7691.0 億\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"櫃買指數\"}],[\"$\",\"td\",\"1\",{\"children\":\"395.66\"}],[\"$\",\"td\",\"2\",{\"children\":\"+1.60%\"}],[\"$\",\"td\",\"3\",{\"children\":\"N/A\"}],[\"$\",\"td\",\"4\",{\"children\":\"N/A\"}],[\"$\",\"td\",\"5\",{\"children\":\"N/A\"}]]}]]}]]}]}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、盤面焦點族群\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"今日盤面族群表現分歧，部分電子類股與傳產族群漲勢突出，而航運業則普遍走弱。漲幅較大的族群包含玻璃陶瓷、半導體業、光電業及其他電子類。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"玻璃陶瓷業今日上漲2.78%，其中1809中釉領漲。\"}],[\"$\",\"li\",\"1\",{\"children\":\"半導體業今日上漲2.74%，有175檔股票，4991環宇-KY表現突出。\"}],[\"$\",\"li\",\"2\",{\"children\":\"光電業今日上漲2.64%，有120檔股票，6668中揚光領漲。\"}],[\"$\",\"li\",\"3\",{\"children\":\"其他電子類今日上漲2.23%，其中3131弘塑表現亮眼。\"}],[\"$\",\"li\",\"4\",{\"children\":\"航運業今日下跌1.70%，貿易百貨、居家生活類及農業科技業也呈現下跌。\"}]]}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、個股表現一覽\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"今日上市股票中，有多檔個股達到漲停板，主要集中在電子相關產業。另一方面，航運類股則有多檔股票跌幅較大，顯示族群性走勢明顯。\"}],[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"今日漲幅較大的股票包括：3406 玉晶光 (+10.00%)、3543 州巧 (+10.00%)、4977 眾達-KY (+10.00%)、6213 聯茂 (+10.00%)、6668 中揚光 (+10.00%)、3653 健策 (+9.99%)。\"}],[\"$\",\"li\",\"1\",{\"children\":\"今日跌幅較大的股票則有：2609 陽明 (-9.43%)、2615 萬海 (-9.09%)、2606 裕民 (-7.69%)、4560 強信-KY (-7.17%)、2611 志信 (-6.17%)、2613 中櫃 (-6.12%)。其中多檔屬於航運業。\"}],\"$L18\"]}],\"$L19\"]]}],\"$L1a\",\"$L1b\",\"$L1c\",\"$L1d\",\"$L1e\"],null]}]]}]}]\n18:[\"$\",\"li\",\"2\",{\"children\":\"當沖熱門股中，聯合的量比高達22.4倍，但股價下跌4.94%。精確、前鼎、吉祥全等則有較高漲幅。\"}]\n19:[\"$\",\"figure\",\"2\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"!法人現貨賣超!台指期淨空單!融資維持率變化!國際政策動向\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"投資人關注事項\"}]]}]\n1a:[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、法人與籌碼動態\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"在法人動態方面，今日外資與自營商在現貨市場皆呈現賣超。期貨市場方面，台指期收盤小幅上漲，但外資的淨空單數量仍維持在高位。\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"項目\"}],[\"$\",\"th\",\"1\",{\"children\":\"今日現貨買賣超 (張)\"}],[\"$\",\"th\",\"2\",{\"children\":\"今日台指期表現\"}],[\"$\",\"th\",\"3\",{\"children\":\"台指期未平倉口數\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"外資\"}],[\"$\",\"td\",\"1\",{\"children\":\"-107,281\"}],[\"$\",\"td\",\"2\",{\"children\":\"台指期收 46087.0 (+0.18%)\"}],[\"$\",\"td\",\"3\",{\"children\":\"外資淨空單 83,654 口\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"自營商\"}],[\"$\",\"td\",\"1\",{\"children\":\"-508,833\"}],[\"$\",\"td\",\"2\",{\"children\":\"N/A\"}],[\"$\",\"td\",\"3\",{\"children\":\"N/A\"}]]}]]}]]}]}]]]}]\n1b:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、國際盤勢與相關消息\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"觀察國際主要股市，今日多數呈現上漲格局，其中費城半導體指數漲幅較為顯著。台股相關消息方面，有部分公司舉辦法人說明會，記憶體與石英元件相關產業也傳出正面營收與股價表現。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"國際盤表現：S&P 500 上漲0.32%、那斯達克上漲0.66%、費城半導體上漲1.44%、韓國綜合（KOSPI）上漲0.97%、日經225上漲0.62%。\"}],[\"$\",\"li\",\"1\",{\"children\":\"今日台股新聞標題包括良得電、健鼎舉辦法人說明會。\"}],[\"$\",\"li\",\"2\",{\"children\":\"記憶體相關新聞提及南亞科7月營收表現，石英元件族群有多檔股票收紅。\"}],[\"$\",\"li\",\"3\",{\"children\":\"近期國際新聞關注中國對川普「經濟D日」伊朗制裁的反擊，以及川普對加拿大關稅戰的立場。\"}]]}]]]}]\n1c:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"今天台股大盤表現如何？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"今日加權指數上漲1.46%，收在45832.62點，櫃買指數也上漲1.60%。上市股票中，上漲家數為776家，下跌家數為176家，整體盤面偏多。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"哪些族群今天表現比較強勢？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"今日表現較強勢的族群包括玻璃陶瓷、半導體業、光電業以及其他電子類。其中半導體業有175檔股票，光電業有120檔股票，皆呈現較大漲幅。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"法人今天在現貨市場的動向是什麼？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"外資今日在現貨市場賣超約107,281張，自營商也賣超約508,833張。在台指期方面，外資淨空單為83,654口，台指期收盤小幅上漲0.18%。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"航運股今天為什麼跌這麼多？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"今日航運業族群整體下跌1.70%，其中陽明、萬海、裕民等多檔股票跌幅較大。公開資料看不出單一原因，這是今日已發生的結果。\"}]]}]]}]]]}]\n1d:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"總結今日台股盤勢，加權指數與櫃買指數均呈現上漲，盤面由半導體與光電等電子族群領漲。儘管法人在現貨市場賣超，整體市場仍維持偏多氛圍。\"}]]]}]\n1e:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L17\",\"0-台股學堂\",{\"href\":\"/school\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"台股學堂\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L17\",\"0-台股日報 (會員\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"台股日報 (會員)\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L17\",\"0-大盤總覽 (會員\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"大盤總覽 (會員)\"}]]}],[\"$\",\"li\",\"3\",{\"children\":[[\"$\",\"$L17\",\"0-法遵與免責聲明\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"法遵與免責聲明\"}]]}]]}]]]}]\n13:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\nf:null\n1f:I[80622,[],\"IconMark\"]\n11:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"2026年8月26日台股盤後：加權指數上漲1.46%，半導體、光電領漲｜股市大佬 TradeBoss\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"2026年8月26日台股今日表現強勁，加權指數上漲1.46%，收在45832.62點。櫃買指數也同步走高，上漲1.60%。整體盤面氣氛偏多，上市股票以上漲家數為多數。\"}],[\"$\",\"link\",\"2\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}],[\"$\",\"$L1f\",\"3\",{}]],\"error\":null,\"digest\":\"$undefined\"}\n16:\"$11:metadata\"\n"}