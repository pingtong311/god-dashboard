script src=\"/_next/static/chunks/app/layout-4382c12d510386d3.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/learn/%5Bslug%5D/page-f7b99344f7e2ee16.js\" async=\"\"></script><meta name=\"next-size-adjust\" content=\"\"/><title>2026年8月26日台股盤後：加權指數上漲1.46%，半導體、光電領漲｜股市大佬 TradeBoss</title><meta name=\"description\" content=\"2026年8月26日台股今日表現強勁，加權指數上漲1.46%，收在45832.62點。櫃買指數也同步走高，上漲1.60%。整體盤面氣氛偏多，上市股票以上漲家數為多數。\"/><link rel=\"icon\" href=\"/favicon.ico\" type=\"image/x-icon\" sizes=\"16x16\"/><script>(function(){try{var t=localStorage.getItem('obsidian-theme');if(t!=='light'&&t!=='dark')t='dark';document.documentElement.setAttribute('data-theme',t);document.documentElement.style.colorScheme=(t==='light'?'light':'dark');}catch(e){document.documentElement.setAttribute('data-theme','dark');}})();(function(){try{if(localStorage.getItem('obsidian-comfort-read')==='1')document.documentElement.classList.add('comfort-read');}catch(e){}})();(function(){try{var s=localStorage.getItem('obsidian-updown');if(s==='us')document.documentElement.setAttribute('data-updown','us');}catch(e){}})();(function(){try{var prefs=JSON.parse(localStorage.getItem('bs-preferences-v1')||'{}');var root=document.documentElement;prefs=prefs&&typeof prefs==='object'?prefs:{};root.setAttribute('data-font-size',['standard','large','xlarge','huge'].indexOf(prefs.fontSize)>=0?prefs.fontSize:'standard');root.setAttribute('data-density',prefs.density==='compact'?'compact':'comfortable');}catch(e){}})();</script><script src=\"/_next/static/chunks/polyfills-42372ed130431b0a.js\" noModule=\"\"></script></head><body class=\"min-h-screen bg-background text-foreground selection:bg-cyan/30 review-mode pb-40 lg:pb-16\" data-review-theme=\"dark\"><div hidden=\"\"><!--$--><!--/$--></div><a href=\"#main-content\" class=\"skip-link fixed left-3 top-3 z-[80] -translate-y-24 rounded-xl bg-accent px-4 py-2 font-black text-bg shadow-lg transition focus:translate-y-0\">跳到主要內容</a><main id=\"main-content\" class=\"w-full\"><div class=\"LearnArticle_wrap__LIQ8G\"><article class=\"LearnArticle_article__2nBbk\"><p class=\"LearnArticle_meta__etj_G\"><a class=\"LearnArticle_cat__GQMlg\" href=\"/learn?c=recap\">盤後解讀</a><span class=\"LearnArticle_read__QEj6a\">閱讀約 6 分鐘</span></p><h1 class=\"LearnArticle_title__0_la8\">2026年8月26日台股盤後：加權指數上漲1.46%，半導體、光電領漲</h1><details class=\"LearnArticle_toc__LcSAa\"><summary class=\"LearnArticle_tocSummary__YBddG\">本文目錄</summary><ol class=\"LearnArticle_tocList__Rq_Lz\"><li><a href=\"#sec-1\">一、大盤表現概況</a></li><li><a href=\"#sec-2\">二、盤面焦點族群</a></li><li><a href=\"#sec-3\">三、個股表現一覽</a></li><li><a href=\"#sec-4\">四、法人與籌碼動態</a></li><li><a href=\"#sec-5\">五、國際盤勢與相關消息</a></li><li><a href=\"#sec-6\">常見問題 FAQ</a></li><li><a href=\"#sec-7\">總結</a></li><li><a href=\"#sec-8\">延伸閱讀</a></li></ol></details><div class=\"LearnArticle_body__6B7Mb\"><p class=\"LearnArticle_intro__ATV5c\">2026年8月26日台股今日表現強勁，加權指數上漲1.46%，收在45832.62點。櫃買指數也同步走高，上漲1.60%。整體盤面氣氛偏多，上市股票以上漲家數為多數。</p><div class=\"LearnArticle_tldr__Br5BY\"><b class=\"LearnArticle_tldrTitle__K5PBN\">本文重點</b><ul class=\"LearnArticle_tldrList__VSc2_\"><li>加權指數與櫃買指數同步上漲。</li><li>半導體、光電業為今日強勢族群。</li><li>航運業類股今日表現偏弱。</li><li>外資與自營商今日在現貨市場賣超。</li></ul></div><section id=\"sec-1\" class=\"LearnArticle_section__hLVjU\"><h2 class=\"LearnArticle_h2__NmJ08\">一、大盤表現概況</h2><p class=\"LearnArticle_p__aZlQ1\">今日台股加權指數收在45832.62點，上漲1.46%，櫃買指數也表現不俗，上漲1.60%，收在395.66點。上市股票中，上漲家數達776家，遠多於下跌的176家，顯示市場整體買氣旺盛。今日總成交金額約7691.0億元。</p><div class=\"LearnArticle_tblScroll__z9kbb\"><table class=\"LearnArticle_tbl__0yNgv\"><thead><tr><th>指數名稱</th><th>收盤價</th><th>漲跌幅</th><th>上漲家數</th><th>下跌家數</th><th>成交金額</th></tr></thead><tbody><tr><td>加權指數</td><td>45832.62</td><td>+1.46%</td><td>776</td><td>176</td><td>7691.0 億</td></tr><tr><td>櫃買指數</td><td>395.66</td><td>+1.60%</td><td>N/A</td><td>N/A</td><td>N/A</td></tr></tbody></table></div></section><section id=\"sec-2\" class=\"LearnArticle_section__hLVjU\"><h2 class=\"LearnArticle_h2__NmJ08\">二、盤面焦點族群</h2><p class=\"LearnArticle_p__aZlQ1\">今日盤面族群表現分歧，部分電子類股與傳產族群漲勢突出，而航運業則普遍走弱。漲幅較大的族群包含玻璃陶瓷、半導體業、光電業及其他電子類。</p><ul class=\"LearnArticle_listCheck__xx1CF\"><li>玻璃陶瓷業今日上漲2.78%，其中1809中釉領漲。</li><li>半導體業今日上漲2.74%，有175檔股票，4991環宇-KY表現突出。</li><li>光電業今日上漲2.64%，有120檔股票，6668中揚光領漲。</li><li>其他電子類今日上漲2.23%，其中3131弘塑表現亮眼。</li><li>航運業今日下跌1.70%，貿易百貨、居家生活類及農業科技業也呈現下跌。</li></ul></section><section id=\"sec-3\" class=\"LearnArticle_section__hLVjU\"><h2 class=\"LearnArticle_h2__NmJ08\">三、個股表現一覽</h2><p class=\"LearnArticle_p__aZlQ1\">今日上市股票中，有多檔個股達到漲停板，主要集中在電子相關產業。另一方面，航運類股則有多檔股票跌幅較大，顯示族群性走勢明顯。</p><ol class=\"LearnArticle_listNum__86N5S\"><li>今日漲幅較大的股票包括：3406 玉晶光 (+10.00%)、3543 州巧 (+10.00%)、4977 眾達-KY (+10.00%)、6213 聯茂 (+10.00%)、6668 中揚光 (+10.00%)、3653 健策 (+9.99%)。</li><li>今日跌幅較大的股票則有：2609 陽明 (-9.43%)、2615 萬海 (-9.09%)、2606 裕民 (-7.69%)、4560 強信-KY (-7.17%)、2611 志信 (-6.17%)、2613 中櫃 (-6.12%)。其中多檔屬於航運業。</li><li>當沖熱門股中，聯合的量比高達22.4倍，但股價下跌4.94%。精確、前鼎、吉祥全等則有較高漲幅。</li></ol><figure class=\"LearnArticle_fig__uoT7r\"><div class=\"LearnArticle_figFrame__jJ7E4\">!法人現貨賣超!台指期淨空單!融資維持率變化!國際政策動向</div><figcaption class=\"LearnArticle_figCap__LnUbb\">投資人關注事項</figcaption></figure></section><section id=\"sec-4\" class=\"LearnArticle_section__hLVjU\"><h2 class=\"LearnArticle_h2__NmJ08\">四、法人與籌碼動態</h2><p class=\"LearnArticle_p__aZlQ1\">在法人動態方面，今日外資與自營商在現貨市場皆呈現賣超。期貨市場方面，台指期收盤小幅上漲，但外資的淨空單數量仍維持在高位。</p><div class=\"LearnArticle_tblScroll__z9kbb\"><table class=\"LearnArticle_tbl__0yNgv\"><thead><tr><th>項目</th><th>今日現貨買賣超 (張)</th><th>今日台指期表現</th><th>台指期未平倉口數</th></tr></thead><tbody><tr><td>外資</td><td>-107,281</td><td>台指期收 46087.0 (+0.18%)</td><td>外資淨空單 83,654 口</td></tr><tr><td>自營商</td><td>-508,833</td><td>N/A</td><td>N/A</td></tr></tbody></table></div></section><section id=\"sec-5\" class=\"LearnArticle_section__hLVjU\"><h2 class=\"LearnArticle_h2__NmJ08\">五、國際盤勢與相關消息</h2><p class=\"LearnArticle_p__aZlQ1\">觀察國際主要股市，今日多數呈現上漲格局，其中費城半導體指數漲幅較為顯著。台股相關消息方面，有部分公司舉辦法人說明會，記憶體與石英元件相關產業也傳出正面營收與股價表現。</p><ul class=\"LearnArticle_listCheck__xx1CF\"><li>國際盤表現：S&amp;P 500 上漲0.32%、那斯達克上漲0.66%、費城半導體上漲1.44%、韓國綜合（KOSPI）上漲0.97%、日經225上漲0.62%。</li><li>今日台股新聞標題包括良得電、健鼎舉辦法人說明會。</li><li>記憶體相關新聞提及南亞科7月營收表現，石英元件族群有多檔股票收紅。</li><li>近期國際新聞關注中國對川普「經濟D日」伊朗制裁的反擊，以及川普對加拿大關稅戰的立場。</li></ul></section><section id=\"sec-6\" class=\"LearnArticle_section__hLVjU\"><h2 class=\"LearnArticle_h2__NmJ08\">常見問題 FAQ</h2><div class=\"LearnArticle_faq__cemBp\"><details class=\"LearnArticle_faqItem__I9h0U\"><summary>今天台股大盤表現如何？</summary><p class=\"LearnArticle_faqA__IPuvc\">今日加權指數上漲1.46%，收在45832.62點，櫃買指數也上漲1.60%。上市股票中，上漲家數為776家，下跌家數為176家，整體盤面偏多。</p></details><details class=\"LearnArticle_faqItem__I9h0U\"><summary>哪些族群今天表現比較強勢？</summary><p class=\"LearnArticle_faqA__IPuvc\">今日表現較強勢的族群包括玻璃陶瓷、半導體業、光電業以及其他電子類。其中半導體業有175檔股票，光電業有120檔股票，皆呈現較大漲幅。</p></details><details class=\"LearnArticle_faqItem__I9h0U\"><summary>法人今天在現貨市場的動向是什麼？</summary><p class=\"LearnArticle_faqA__IPuvc\">外資今日在現貨市場賣超約107,281張，自營商也賣超約508,833張。在台指期方面，外資淨空單為83,654口，台指期收盤小幅上漲0.18%。</p></details><details class=\"LearnArticle_faqItem__I9h0U\"><summary>航運股今天為什麼跌這麼多？</summary><p class=\"LearnArticle_faqA__IPuvc\">今日航運業族群整體下跌1.70%，其中陽明、萬海、裕民等多檔股票跌幅較大。公開資料看不出單一原因，這是今日已發生的結果。</p></details></div></section><section id=\"sec-7\" class=\"LearnArticle_section__hLVjU\"><h2 class=\"LearnArticle_h2__NmJ08\">總結</h2><p class=\"LearnArticle_p__aZlQ1\">總結今日台股盤勢，加權指數與櫃買指數均呈現上漲，盤面由半導體與光電等電子族群領漲。儘管法人在現貨市場賣超，整體市場仍維持偏多氛圍。</p></section><section id=\"sec-8\" class=\"LearnArticle_section__hLVjU\"><h2 class=\"LearnArticle_h2__NmJ08\">延伸閱讀</h2><ul class=\"LearnArticle_list__WjxqC\"><li><a class=\"LearnArticle_link__gMwHV\" href=\"/school\">台股學堂</a></li><li><a class=\"LearnArticle_link__gMwHV\" href=\"/diary\">台股日報 (會員)</a></li><li><a class=\"LearnArticle_link__gMwHV\" href=\"/diary\">大盤總覽 (會員)</a></li><li><a class=\"LearnArticle_link__gMwHV\" href=\"/diary\">法遵與免責聲明</a></li></ul></section></div></article></div><!--$--><!--/$--></main><script src=\"/_next/static/chunks/webpack-1cf2182201f6bdb6.js\" id=\"_R_\" async=\"\"></script><script>(self.__next_f=self.__next_f||[]).push([0])</script><script>self.__next_f.push([1,\"1:\\\"$Sreact.fragment\\\"\\n2:I[81259,[\\\"2619\\\",\\\"static/chunks/2619-04bc32f026a0d946.js\\\",\\\"7177\\\",\\\"static/chunks/app/layout-4382c12d510386d3.js\\\"],\\\"default\\\"]\\n3:I[89379,[\\\"2619\\\",\\\"static/chunks/2619-04bc32f026a0d946.js\\\",\\\"7177\\\",\\\"static/chunks/app/layout-4382c12d510386d3.js\\\"],\\\"default\\\"]\\n4:I[9766,[],\\\"\\\"]\\n5:I[98924,[],\\\"\\\"]\\n6:I[10021,[\\\"2619\\\",\\\"static/chunks/2619-04bc32f026a0d946.js\\\",\\\"7177\\\",\\\"static/chunks/app/layout-4382c12d510386d3.js\\\"],\\\"default\\\"]\\n7:I[10528,[\\\"2619\\\",\\\"static/chunks/2619-04bc32f026a0d946.js\\\",\\\"7177\\\",\\\"static/chunks/app/layout-4382c12d510386d3.js\\\"],\\\"default\\\"]\\n8:I[50861,[\\\"2619\\\",\\\"static/chunks/2619-04bc32f026a0d946.js\\\",\\\"7177\\\",\\\"static/chunks/app/layout-4382c12d510386d3.js\\\"],\\\"default\\\"]\\nc:I[57150,[],\\\"\\\"]\\n:HL[\\\"/_next/static/media/3d26d2f3aa81a833-s.p.woff2\\\",\\\"font\\\",{\\\"crossOrigin\\\":\\\"\\\",\\\"type\\\":\\\"font/woff2\\\"}]\\n:HL[\\\"/_next/static/media/604a121a6fa1a135-s.p.woff2\\\",\\\"font\\\",{\\\"crossOrigin\\\":\\\"\\\",\\\"type\\\":\\\"font/woff2\\\"}]\\n:HL[\\\"/_next/static/media/6e1768769e6f59a2-s.p.woff2\\\",\\\"font\\\",{\\\"crossOrigin\\\":\\\"\\\",\\\"type\\\":\\\"font/woff2\\\"}]\\n:HL[\\\"/_next/static/media/ab2e3a11646b0499-s.p.woff2\\\",\\\"font\\\",{\\\"crossOrigin\\\":\\\"\\\",\\\"type\\\":\\\"font/woff2\\\"}]\\n:HL[\\\"/_next/static/css/75c047ba52e43fcc.css\\\",\\\"style\\\"]\\n:HL[\\\"/_next/static/css/aa90c9a426448e43.css\\\",\\\"style\\\"]\\n:HL[\\\"/_next/static/css/e55779c04dd245e2.css\\\",\\\"style\\\"]\\n:HL[\\\"/_next/static/css/8c57d5c3b938342e.css\\\",\\\"style\\\"]\\n:HL[\\\"/_next/static/css/3eaf36e367672966.css\\\",\\\"style\\\"]\\n\"])</script><script>self.__next_f.push([1,\"0:{\\\"P\\\":null,\\\"b\\\":\\\"2DJ2zhzL_dHSrK5QsdDKA\\\",\\\