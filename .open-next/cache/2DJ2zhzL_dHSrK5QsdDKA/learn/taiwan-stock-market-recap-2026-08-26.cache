,\\\"1\\\",{\\\"children\\\":\\\"半導體業今日上漲2.74%，有175檔股票，4991環宇-KY表現突出。\\\"}],[\\\"$\\\",\\\"li\\\",\\\"2\\\",{\\\"children\\\":\\\"光電業今日上漲2.64%，有120檔股票，6668中揚光領漲。\\\"}],[\\\"$\\\",\\\"li\\\",\\\"3\\\",{\\\"children\\\":\\\"其他電子類今日上漲2.23%，其中3131弘塑表現亮眼。\\\"}],[\\\"$\\\",\\\"li\\\",\\\"4\\\",{\\\"children\\\":\\\"航運業今日下跌1.70%，貿易百貨、居家生活類及農業科技業也呈現下跌。\\\"}]]}]]]}],[\\\"$\\\",\\\"section\\\",\\\"sec-3\\\",{\\\"id\\\":\\\"sec-3\\\",\\\"className\\\":\\\"LearnArticle_section__hLVjU\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"LearnArticle_h2__NmJ08\\\",\\\"children\\\":\\\"三、個股表現一覽\\\"}],[[\\\"$\\\",\\\"p\\\",\\\"0\\\",{\\\"className\\\":\\\"LearnArticle_p__aZlQ1\\\",\\\"children\\\":\\\"今日上市股票中，有多檔個股達到漲停板，主要集中在電子相關產業。另一方面，航運類股則有多檔股票跌幅較大，顯示族群性走勢明顯。\\\"}],[\\\"$\\\",\\\"ol\\\",\\\"1\\\",{\\\"className\\\":\\\"LearnArticle_listNum__86N5S\\\",\\\"children\\\":[[\\\"$\\\",\\\"li\\\",\\\"0\\\",{\\\"children\\\":\\\"今日漲幅較大的股票包括：3406 玉晶光 (+10.00%)、3543 州巧 (+10.00%)、4977 眾達-KY (+10.00%)、6213 聯茂 (+10.00%)、6668 中揚光 (+10.00%)、3653 健策 (+9.99%)。\\\"}],[\\\"$\\\",\\\"li\\\",\\\"1\\\",{\\\"children\\\":\\\"今日跌幅較大的股票則有：2609 陽明 (-9.43%)、2615 萬海 (-9.09%)、2606 裕民 (-7.69%)、4560 強信-KY (-7.17%)、2611 志信 (-6.17%)、2613 中櫃 (-6.12%)。其中多檔屬於航運業。\\\"}],\\\"$L18\\\"]}],\\\"$L19\\\"]]}],\\\"$L1a\\\",\\\"$L1b\\\",\\\"$L1c\\\",\\\"$L1d\\\",\\\"$L1e\\\"],null]}]]}]}]\\n\"])</script><script>self.__next_f.push([1,\"18:[\\\"$\\\",\\\"li\\\",\\\"2\\\",{\\\"children\\\":\\\"當沖熱門股中，聯合的量比高達22.4倍，但股價下跌4.94%。精確、前鼎、吉祥全等則有較高漲幅。\\\"}]\\n19:[\\\"$\\\",\\\"figure\\\",\\\"2\\\",{\\\"className\\\":\\\"LearnArticle_fig__uoT7r\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"LearnArticle_figFrame__jJ7E4\\\",\\\"children\\\":\\\"!法人現貨賣超!台指期淨空單!融資維持率變化!國際政策動向\\\"}],[\\\"$\\\",\\\"figcaption\\\",null,{\\\"className\\\":\\\"LearnArticle_figCap__LnUbb\\\",\\\"children\\\":\\\"投資人關注事項\\\"}]]}]\\n\"])</script><script>self.__next_f.push([1,\"1a:[\\\"$\\\",\\\"section\\\",\\\"sec-4\\\",