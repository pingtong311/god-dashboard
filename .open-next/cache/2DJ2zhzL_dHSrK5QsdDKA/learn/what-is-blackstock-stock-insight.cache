{\"children\":[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$15\",null,{\"fallback\":null,\"children\":\"$L16\"}]}]}]]}]\n17:I[52619,[\"2619\",\"static/chunks/2619-04bc32f026a0d946.js\",\"6309\",\"static/chunks/app/learn/%5Bslug%5D/page-f7b99344f7e2ee16.js\"],\"\"]\nd:[\"$\",\"div\",null,{\"className\":\"LearnArticle_wrap__LIQ8G\",\"children\":[\"$\",\"article\",null,{\"className\":\"LearnArticle_article__2nBbk\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_meta__etj_G\",\"children\":[[\"$\",\"$L17\",null,{\"className\":\"LearnArticle_cat__GQMlg\",\"href\":\"/learn?c=platform\",\"children\":\"平台教學\"}],[\"$\",\"span\",null,{\"className\":\"LearnArticle_read__QEj6a\",\"children\":\"閱讀約 6 分鐘\"}]]}],[\"$\",\"h1\",null,{\"className\":\"LearnArticle_title__0_la8\",\"children\":\"股市大佬個股透視有什麼？3 大區塊看懂籌碼\"}],[\"$\",\"details\",null,{\"className\":\"LearnArticle_toc__LcSAa\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"LearnArticle_tocSummary__YBddG\",\"children\":\"本文目錄\"}],[\"$\",\"ol\",null,{\"className\":\"LearnArticle_tocList__Rq_Lz\",\"children\":[[\"$\",\"li\",\"sec-1\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-1\",\"children\":\"一、為什麼不能只看 K 線？股價背後的兩大力量\"}]}],[\"$\",\"li\",\"sec-2\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-2\",\"children\":\"二、關鍵分點怎麼看？買超第一名不代表一切\"}]}],[\"$\",\"li\",\"sec-3\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-3\",\"children\":\"三、法人動向：外資、投信、自營商差在哪？\"}]}],[\"$\",\"li\",\"sec-4\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-4\",\"children\":\"四、除了籌碼，如何用基本面數據輔助判斷？\"}]}],[\"$\",\"li\",\"sec-5\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-5\",\"children\":\"五、股市大佬「個股透視」如何一頁整合所有資訊？\"}]}],[\"$\",\"li\",\"sec-6\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-6\",\"children\":\"常見問題 FAQ\"}]}],[\"$\",\"li\",\"sec-7\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-7\",\"children\":\"總結\"}]}],[\"$\",\"li\",\"sec-8\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-8\",\"children\":\"延伸閱讀\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"LearnArticle_body__6B7Mb\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_intro__ATV5c\",\"children\":\"打開看盤軟體，看到一檔股票今天漲了 5%，但然後呢？只看 K 線很難知道是誰在買、誰在賣，背後有沒有大人撐腰。股市大佬的「個股透視」頁面，就是要把這些藏在 K 線背後的關鍵資訊整理好，讓你一眼看穿股價背後的真相。\"}],[],[\"$\",\"div\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"「個股透視」整合了籌碼、技術、基本面三大面向，不用再開多個視窗。\"}],[\"$\",\"li\",\"1\",{\"children\":\"看「關鍵分點」不是越多家買進越好，而是要看買超的「集中度」。\"}],[\"$\",\"li\",\"2\",{\"children\":\"法人動向要看連續性，外資、投信連續買超 3-5 天比一天大買更有參考價值。\"}],[\"$\",\"li\",\"3\",{\"children\":\"除了籌碼，也要看營收、本益比等基本面數據，避免追到沒有基本面支撐的股票。\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、為什麼不能只看 K 線？股價背後的兩大力量\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"很多人看股票，就是看紅 K 綠 K，但價格只是「結果」。真正驅動股價的是背後的「原因」：公司的賺錢能力（基本面）和市場上股票的流向（籌碼面）。如果你只追著價格跑，很容易被洗出場。個股透視頁面的設計初衷，就是幫你同時看懂這兩大力量，做出更全面的判斷。\"}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、關鍵分點怎麼看？買超第一名不代表一切\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"打開分點進出表，看到買超第一名的券商買了上千張，是不是就代表主力進場了？這是最常見的誤解。關鍵不在於「誰買最多」，而在於「買盤是否集中」。如果買盤很分散，大家東買一點西買一點，通常只是散戶行為。真正有力的攻擊，是少數幾個券商聯手大量買進。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"判斷方法：觀察買超前 15 名的券商，他們的「總買超」張數，是否佔了當天成交量的 10% 以上？\"}],[\"$\",\"li\",\"1\",{\"children\":\"常見錯誤：只看買超第一名的券商是誰，卻忽略了賣超前幾名是不是同一家券商（可能在左手換右手）。\"}],[\"$\",\"li\",\"2\",{\"children\":\"帶得走的東西：與其看單一分點，不如看「買超集中度」這個數字。數字越高，代表籌碼越集中在少數人手上。\"}]]}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、法人動向：外資、投信、自營商差在哪？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"市場常說的「三大法人」，是指外資、投信和自營商，他們是台股最有影響力的資金。但他們的錢不一樣多、操作策略也不同。外資看長線趨勢，投信有季度作帳壓力，自營商則偏好短線操作。搞懂他們的差異，你才能正確解讀法人買賣超數字的意義。\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"項目\"}],[\"$\",\"th\",\"1\",{\"children\":\"外資 (Foreign Institutions)\"}],[\"$\",\"th\",\"2\",{\"children\":\"投信 (Investment Trusts)\"}],[\"$\",\"th\",\"3\",{\"children\":\"自營商 (Dealers)\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"資金規模\"}],[\"$\",\"td\",\"1\",{\"children\":\"最大，影響力最廣\"}],[\"$\",\"td\",\"2\",{\"children\":\"次之，國內基金為主\"}],[\"$\",\"td\",\"3\",{\"children\":\"最小，券商自有資金\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"操作週期\"}],[\"$\",\"td\",\"1\",{\"children\":\"長期，數月至數年\"}],[\"$\",\"td\",\"2\",{\"children\":\"中期，看重波段與季報\"}],[\"$\",\"td\",\"3\",{\"children\":\"短期，數日至數週\"}]]}],[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"參考價值\"}],\"$L18\",\"$L19\",\"$L1a\"]}],\"$L1b\"]}]]}]}],\"$L1c\"]]}],\"$L1d\",\"$L1e\",\"$L1f\",\"$L20\",\"$L21\"],null]}]]}]}]\n18:[\"$\",\"td\",\"1\",{\"children\":\"趨勢指標，看重基本面\"}]\n19:[\"$\",\"td\",\"2\",{\"children\":\"籌碼穩定度，有作帳行情\"}]\n1a:[\"$\",\"td\",\"3\",{\"children\":\"較不穩定，常頻繁進出\"}]\n1b:[\"$\",\"tr\",\"3\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"判斷重點\"}],[\"$\",\"td\",\"1\",{\"children\":\"連續買賣超天數\"}],[\"$\",\"td\",\"2\",{\"children\":\"是否納入高股息成分股\"}],[\"$\",\"td\",\"3\",{\"children\":\"避險或短線套利\"}]]}]\n1c:[\"$\",\"figure\",\"2\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"!只看買超第一名!以為外資買就穩了!忽略公司基本面!完全複製主力進出\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"籌碼分析常見誤區\"}]]}]\n1d:[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、除了籌碼，如何用基本面數據輔助判斷？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"籌碼再集中，如果公司本身不賺錢，股價也只是曇花一現。在「個股透視」頁面，我們也整合了重要的基本面數據，讓你快速檢查這檔股票的「體質」好不好。這能幫你避開那些只靠消息拉抬，卻沒有實際獲利支撐的公司，讓你抱得更安心。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"月營收年增率 (YoY)：是不是連續好幾個月正成長？這是公司成長最直接的信號。\"}],[\"$\",\"li\",\"1\",{\"children\":\"每股盈餘 (EPS)：公司為每一股賺了多少錢？至少要看最近四季是不是穩定或成長。\"}],[\"$\",\"li\",\"2\",{\"children\":\"本益比 (P/E Ratio)：現在的股價是它賺錢能力的幾倍？可以跟同產業或它自己的歷史紀錄比，判斷是否被高估。\"}],[\"$\",\"li\",\"3\",{\"children\":\"股利政策：公司是否穩定發放股利？這代表公司有賺到錢，也願意跟股東分享。\"}]]}]]]}]\n1e:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、股市大佬「個股透視」如何一頁整合所有資訊？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"你可能習慣在券商 App 看 K 線、去公開資訊站查財報、再到論壇看別人討論分點。這樣東拼西湊，不但浪費時間，資訊還可能不完整。股市大佬的「個股透視」把這些資訊全部整合在一個乾淨的介面，從上到下依序是：價量核心、籌碼分佈、法人動向、基本面數據。我們的目標是節省你的研究時間，讓你專注在判斷，而不是找資料。\"}]]]}]\n1f:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"這些資料在券商 App 裡不是也有嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"券商 App 通常提供最基本的價量與法人買賣超，但對於「分點集中度」、「關鍵分點歷史行為」等進階籌碼分析，通常需要另外尋找或手動計算。股市大佬的「個股透視」將這些數據都幫你整理好了。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"我需要每天都看「個股透視」嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"如果你是做短線或波段交易，每天收盤後花幾分鐘檢查持股的籌碼變化是個好習慣。如果你是長期投資者，可以每週或每月檢查一次，確認長期趨勢沒有改變即可。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"看到主力在買，我是不是就可以跟著買？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"不建議完全照著別人的部位下單。主力買進可能是長線佈局，短期內股價不一定會漲。你應該把主力動向當作一個參考指標，配合公司基本面和自己的交易計畫來做決策。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"「個股透視」的資料是即時的嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"籌碼與法人買賣超等資料，是根據交易所每日收盤後公布的數據進行計算與整理，屬於盤後資料。盤中我們提供的是即時價量資訊，完整的籌碼分析會在當天收盤後更新。（資料截至 2026-08，以交易所最新公告為準）\"}]]}]]}]]]}]\n20:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"總結來說，「個股透視」的核心價值在於「整合」與「解讀」。它讓你跳脫只看價格漲跌的單一視角，從籌碼、法人、基本面等多個角度交叉驗證，幫你做出更有根據的投資判斷。\"}]]]}]\n21:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L17\",\"0-前往「個股透視」\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"前往「個股透視」頁面，立即體驗\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L17\",\"0-想學更多？來「台\",{\"href\":\"/school\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"想學更多？來「台股學堂」看名詞解釋\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L17\",\"0-看看今天哪些券商\",{\"href\":\"/chips/2330\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"看看今天哪些券商分點買最多\"}]]}],[\"$\",\"li\",\"3\",{\"children\":[[\"$\",\"$L17\",\"0-還不是會員？免費\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"還不是會員？免費註冊開始使用\"}]]}]]}]]]}]\n13:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\nf:null\n22:I[80622,[],\"IconMark\"]\n11:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"股市大佬個股透視有什麼？3 大區塊看懂籌碼｜股市大佬 TradeBoss\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"打開看盤軟體，看到一檔股票今天漲了 5%，但然後呢？只看 K 線很難知道是誰在買、誰在賣，背後有沒有大人撐腰。股市大佬的「個股透視」頁面，就是要把這些藏在 K 線背後的關鍵資訊整理好，讓你一眼看穿股價背後的真相。\"}],[\"$\",\"link\",\"2\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}],[\"$\",\"$L22\",\"3\",{}]],\"error\":null,\"digest\":\"$undefined\"}\n16:\"$11:metadata\"\n"}