ed\\\":\\\"$undefined\\\"}]]}]\\na:[\\\"$\\\",\\\"$1\\\",\\\"c\\\",{\\\"children\\\":[\\\"$Ld\\\",[[\\\"$\\\",\\\"link\\\",\\\"0\\\",{\\\"rel\\\":\\\"stylesheet\\\",\\\"href\\\":\\\"/_next/static/css/3eaf36e367672966.css\\\",\\\"precedence\\\":\\\"next\\\",\\\"crossOrigin\\\":\\\"$undefined\\\",\\\"nonce\\\":\\\"$undefined\\\"}]],[\\\"$\\\",\\\"$Le\\\",null,{\\\"children\\\":[\\\"$Lf\\\",[\\\"$\\\",\\\"$L10\\\",null,{\\\"promise\\\":\\\"$@11\\\"}]]}]]}]\\nb:[\\\"$\\\",\\\"$1\\\",\\\"h\\\",{\\\"children\\\":[null,[[\\\"$\\\",\\\"$L12\\\",null,{\\\"children\\\":\\\"$L13\\\"}],[\\\"$\\\",\\\"meta\\\",null,{\\\"name\\\":\\\"next-size-adjust\\\",\\\"content\\\":\\\"\\\"}]],[\\\"$\\\",\\\"$L14\\\",null,{\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"hidden\\\":true,\\\"children\\\":[\\\"$\\\",\\\"$15\\\",null,{\\\"fallback\\\":null,\\\"children\\\":\\\"$L16\\\"}]}]}]]}]\\n\"])</script><script>self.__next_f.push([1,\"17:I[52619,[\\\"2619\\\",\\\"static/chunks/2619-04bc32f026a0d946.js\\\",\\\"6309\\\",\\\"static/chunks/app/learn/%5Bslug%5D/page-f7b99344f7e2ee16.js\\\"],\\\"\\\"]\\n\"])</script><script>self.__next_f.push([1,\"d:[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"LearnArticle_wrap__LIQ8G\\\",\\\"children\\\":[\\\"$\\\",\\\"article\\\",null,{\\\"className\\\":\\\"LearnArticle_article__2nBbk\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"LearnArticle_meta__etj_G\\\",\\\"children\\\":[[\\\"$\\\",\\\"$L17\\\",null,{\\\"className\\\":\\\"LearnArticle_cat__GQMlg\\\",\\\"href\\\":\\\"/learn?c=chips\\\",\\\"children\\\":\\\"籌碼面\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"LearnArticle_read__QEj6a\\\",\\\"children\\\":\\\"閱讀約 9 分鐘\\\"}]]}],[\\\"$\\\",\\\"h1\\\",null,{\\\"className\\\":\\\"LearnArticle_title__0_la8\\\",\\\"children\\\":\\\"美股漲台股就會漲？看懂3大連動指標\\\"}],[\\\"$\\\",\\\"details\\\",null,{\\\"className\\\":\\\"LearnArticle_toc__LcSAa\\\",\\\"children\\\":[[\\\"$\\\",\\\"summary\\\",null,{\\\"className\\\":\\\"LearnArticle_tocSummary__YBddG\\\",\\\"children\\\":\\\"本文目錄\\\"}],[\\\"$\\\",\\\"ol\\\",null,{\\\"className\\\":\\\"LearnArticle_tocList__Rq_Lz\\\",\\\"children\\\":[[\\\"$\\\",\\\"li\\\",\\\"sec-1\\\",{\\\"children\\\":[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"#sec-1\\\",\\\"children\\\":\\\"一、為什麼道瓊大漲，我的電子股卻在跌？\\\"}]}],[\\\"$\\\",\\\"li\\\",\\\"sec-2\\\",{\\\"children\\\":[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"#sec-2\\\",\\\"children\\\":\\\"二、看哪個美股指數，對台股電子股參考價值最高？\\\"}]}],[\\\"$\\\",\\\"li\\\",\\\"sec-3\\\",{\\\"children\\\":[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"#sec-3\\\",\\\"children\\\":\\\"三、台積電 ADR 是什麼？可以直接換算成隔天股價嗎？\\\"}]}],[\\\"$\\\",\\\"li\\\",\\\"sec-4\\\",{\\\"children\\\":[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"#sec-4\\\",\\\"children\\\":\\\"四、台股開盤前，我該檢查哪些美股數字？\\\"}]}],[\\\"$\\\",\\\"li\\\",\\\"sec-5\\\",{\\\"children\\\":[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"#sec-5\\\",\\\"children\\\":\\\"五、什麼時候美股大跌，台股反而會上漲？\\\"}]}],[\\\"$\\\",\\\"li\\\",\\\"sec-6\\\",{\\\"children\\\":[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"#sec-6\\\",\\\"children\\\":\\\"常見問題 FAQ\\\"}]}],[\\\"$\\\",\\\"li\\\",\\\"sec-7\\\",{\\\"children\\\":[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"#sec-7\\\",\\\"children\\\":\\\"總結\\\"}]}],[\\\"$\\\",\\\"li\\\",\\\"sec-8\\\",{\\\"children\\\":[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"#sec-8\\\",\\\"children\\\":\\\"延伸閱讀\\\"}]}]]}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"LearnArticle_body__6B7Mb\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"LearnArticle_intro__ATV5c\\\",\\\"children\\\":\\\"昨天美股大漲，想說今天台股穩了，結果開盤自己的持股卻是綠的？或是看到那斯達克大跌，就急著在開盤把股票賣掉？其實台股和美股的關係沒那麼簡單，這篇文章教你看懂背後的連動指標，讓你開盤前更有方向。\\\"}],[[\\\"$\\\",\\\"figure\\\",\\\"figure-0\\\",{\\\"className\\\":\\\"LearnArticle_fig__uoT7r\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"LearnArticle_figFrame__jJ7E4\\\",\\\"children\\\":\\\"高集中度只說明買超很集中，不說明是誰、要幹嘛前 15 大其餘成交例：集中度 40%＝這批分點淨買超約當天成交的四成不能從集中度推出明天方向\\\"}],[\\\"$\\\",\\\"figcaption\\\",null,{\\\"className\\\":\\\"LearnArticle_figCap__LnUbb\\\",\\\"children\\\":\\\"示意圖｜分點集中度：前幾大買超合計，佔當天成交的比例（教學結構，不是某檔實盤）\\\"}]]}]],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"LearnArticle_tldr__Br5BY\\\",\\\"children\\\":[[\\\"$\\\",\\\"b\\\",null,{\\\"className\\\":\\\"LearnArticle_tldrTitle__K5PBN\\\",\\\"children\\\":\\\"本文重點\\\"}],[\\\"$\\\",\\\"ul\\\",null,{\\\"className\\\":\\\"LearnArticle_tldrList__VSc2_\\\",\\\"children\\\":[[\\\"$\\\",\\\"li\\\",\\\"0\\\",{\\\"children\\\":\\\"台股與美股「同向」機率高，但非絕對，重點是看產業關聯性。\\\"}],[\\\"$\\\",\\\"li\\\",\\\"1\\\",{\\\"children\\\":\\\"開盤前關注三大指標：那斯達克、費城半導體指數、台積電 ADR。\\\"}],[\\\"$\\\",\\\"li\\\",\\\"2\\\",{\\\"children\\\":\\\"ADR 溢價率可當情緒指標，但不能直接換算成隔天台股股價。\\\"}],[\\\"$\\\",\\\"li\\\",\\\"3\\\",{\\\"children\\\":\\\"美股休市或遇上台灣自身重大利空，台股可能走出自己的路。\\\"}]]}]]}],[[\\\"$\\\",\\\"section\\\",\\\"sec-1\\\",{\\\"id\\\":\\\"sec-1\\\",\\\"className\\\":\\\"LearnArticle_section__hLVjU\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"LearnArticle_h2__NmJ08\\\",\\\"children\\\":\\\"一、為什麼道瓊大漲，我的電子股卻在跌？\\\"}],[[\\\"$\\\",\\\"p\\\",\\\"0\\\",{\\\"className\\\":\\\"LearnArticle_p__aZlQ1\\\",\\\"children\\\":\\\"很多投資人有個誤會，以為看到新聞報「道瓊指數上漲」，就代表所有美股都很好，台股隔天也會跟著漲。但其實美國有不同功能的股市指數，就像百貨公司有不同樓層，賣的東西不一樣。台股有七成以上是電子股，所以跟美國的「科技股」指數連動性最高。\\\"}],[\\\"$\\\",\\\"div\\\",\\\"1\\\",{\\\"className\\\":\\\"LearnArticle_tblScroll__z9kbb\\\",\\\"children\\\":[\\\"$\\\",\\\"table\\\",null,{\\\"className\\\":\\\"LearnArticle_tbl__0yNgv\\\",\\\"children\\\":[[\\\"$\\\",\\\"thead\\\",null,{\\\"children\\\":[\\\"$\\\",\\\"tr\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"th\\\",\\\"0\\\",{\\\"children\\\":\\\"美股指數\\\"}],[\\\"$\\\",\\\"th\\\",\\\"1\\\",{\\\"children\\\":\\\"主要成分\\\"}],[\\\"$\\\",\\\"th\\\",\\\"2\\\",{\\\"children\\\":\\\"對台股的參考價值\\\"}]]}]}],[\\\"$\\\",\\\"tbody\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"tr\\\",\\\"0\\\",{\\\"children\\\":[[\\\"$\\\",\\\"td\\\",\\\"0\\\",{\\\"children\\\":\\\"道瓊工業指數 (DJI)\\\"}],[\\\"$\\\",\\\"td\\\",\\\"1\\\",{\\\"children\\\":\\\"30 家大型傳統產業、金融、消費龍頭，如麥當勞、可口可樂\\\"}],[\\\"$\\\",\\\"td\\\",\\\"2\\\",{\\\"children\\\":\\\"較低。反映美國傳統經濟，與台灣產業結構差異大。\\\"}]]}],[\\\"$\\\",\\\"tr\\\",\\\"1\\\",{\\\"children\\\":[[\\\"$\\\",\\\"td\\\",\\\"0\\\",{\\\"children\\\":\\\"那斯達克指數 (NASDAQ)\\\"}],[\\\"$\\\",\\\"td\\\",\\\"1\\\",{\\\"children\\\":\\\"超過 2,500 家科技、網路、生技公司，如蘋果、輝達、Google\\\"}],[\\\"$\\\",\\\"td\\\",\\\"2\\\",{\\\"children\\\":\\\"高。被視為全球科技股風向球，與台股電子股連動性強。\\\"}]]}],[\\\"$\\\",\\\"tr\\\",\\\"2\\\",{\\\"children\\\":[[\\\"$\\\",\\\"td\\\",\\\"0\\\",{\\\"children\\\":\\\"標準普爾 500 指數 (S\\u0026P 500)\\\"}],[\\\"$\\\",\\\"td\\\",\\\"1\\\",{\\\"children\\\":\\\"500 家各產業龍頭公司，最能代表美國整體市場狀況\\\"}],[\\\"$\\\",\\\"td\\\",\\\"2\\\",{\\\"children\\\":\\\"中等。可觀察美國整體經濟，但對電子股的指引不如那斯達克精準。\\\"}]]}],[\\\"$\\\",\\\"tr\\\",\\\"3\\\",{\\\"children\\\":[[\\\"$\\\",\\\"td\\\",\\\"0\\\",{\\\"children\\\":\\\"費城半導體指數 (SOX)\\\"}],[\\\"$\\\",\\\"td\\\",\\\"1\\\",{\\\"children\\\":\\\"30 家半導體設計、設備、製造、銷售公司，如輝達、超微\\\"}],[\\\"$\\\",\\\"td\\\",\\\"2\\\",{\\\"children\\\":\\\"極高。台灣是半導體重鎮，此指數是台股電子股最重要的先行指標。\\\"}]]}]]}]]}]}]]]}],[\\\"$\\\",\\\"section\\\",\\\"sec-2\\\",{\\\"id\\\":\\\"sec-2\\\",\\\"className\\\":\\\"LearnArticle_section__hLVjU\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"LearnArticle_h2__NmJ08\\\",\\\"children\\\":\\\"二、看哪個美股指數，對台股電子股參考價值最高？\\\"}],[[\\\"$\\\",\\\"p\\\",\\\"0\\\",{\\\"className\\\":\\\"LearnArticle_p__aZlQ1\\\",\\\"children\\\":\\\"答案是「費城半導體指數」，簡稱「費半」。台灣的經濟命脈是半導體產業，從上游的 IC 設計，到中游的晶圓代工，再到下游的封裝測試，形成一個完整的供應鏈。費半指數的漲跌，直接反映了全球半導體產業的景氣，這當然會大大影響以半導體為核心的台股表現。可以說，看懂費半，就看懂了台股電子股一半的臉色。\\\"}],[\\\"$\\\",\\\"ul\\\",\\\"1\\\",{\\\"className\\\":\\\"LearnArticle_listCheck__xx1CF\\\",\\\"children\\\":[\\\"$L18\\\",\\\"$L19\\\",\\\"$L1a\\\"]}]]]}],\\\"$L1b\\\",\\\"$L1c\\\",\\\"$L1d\\\",\\\"$L1e\\\",\\\"$L1f\\\",\\\"$L20\\\"],null]}]]}]}]\\n\"])</script><script>self.__next_f.push([1,\"18:[\\\"$\\\",\\\"li\\\",\\\"0\\\",{\\\"children\\\":\\\"判斷門檻：費半指數單日漲跌超過 2%，通常會對隔天台股電子股的「開盤價」造成較明顯的影響。\\\"}]\\n19:[\\\"$\\\",\\\"li\\\",\\\"1\\\",{\\\"children\\\":\\\"常見錯誤：只看費半指數的漲跌「幅度」，卻忽略了「內容」。有時指數小漲，但裡面的關鍵成分股（如輝達、超微）大漲，對相關的台股供應鏈，指引效果反而更強。\\\"}]\\n1a:[\\\"$\\\",\\\"li\\\",\\\"2\\\",{\\\"children\\\":\\\"觀察重點：除了看指數，也要留意成分股的財報和展望，這常是預測未來一季趨勢的關鍵線索。\\\"}]\\n\"])</script><script>self.__next_f.push([1,\"1b:[\\\"$\\\",\\\"section\\\",\\\"sec-3\\\",{\\\"id\\\":\\\"sec-3\\\",\\\"className\\\":\\\"LearnArticle_section__hLVjU\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"LearnArticle_h2__NmJ08\\\",\\\"children\\\":\\\"三、台積電 ADR 是什麼？可以直接換算成隔天股價嗎？\\\"}],[[\\\"$\\\",\\\"p\\\",\\\"0\\\",{\\\"className\\\":\\\"LearnArticle_p__aZlQ1\\\",\\\"children\\\":\\\"ADR 的全名是「美國存託憑證」，你可以把它想像成台灣公司到美國上市的「分身」。台積電 ADR (代號 TSM) 在紐約證交所交易，它的價格變動，常被視為台積電隔天在台股開盤的預演。但最常見的錯誤，就是直接把 ADR 價格用匯率換算，然後當成台股的目標價，這是行不通的。\\\"}],[\\\"$\\\",\\\"ol\\\",\\\"1\\\",{\\\"className\\\":\\\"LearnArticle_listNum__86N5S\\\",\\\"children\\\":[[\\\"$\\\",\\\"li\\\",\\\"0\\\",{\\\"children\\\":\\\"認識「溢價」：ADR 價格通常會比台股的現貨價格高，這個差額稱為「溢價」。溢價高低反映了美國投資人對這家公司的追捧程度，算是一種市場情緒指標。\\\"}],[\\\"$\\\",\\\"li\\\",\\\"1\\\",{\\\"children\\\":\\\"參考換算公式：(ADR 股價 ÷ 換股數) × 美元匯率 = 理論台股價格。以台積電為例，1 單位 ADR 等於 5 股普通股。假設 ADR 股價 150 美元，匯率 32，理論價格就是 (150 ÷ 5) × 32 = 960 元。\\\"}],[\\\"$\\\",\\\"li\\\",\\\"2\\\",{\\\"children\\\":\\\"為何只是參考：這個 960 元只是理論值。因為兩地交易時間不同、投資人結構不同、還有市場情緒等因素，隔天台股開盤價不一定會剛好是這個數字，但 ADR 的漲跌「幅度」非常有參考價值。\\\"}]]}],[\\\"$\\\",\\\"figure\\\",\\\"2\\\",{\\\"className\\\":\\\"LearnArticle_fig__uoT7r\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"LearnArticle_figFrame__jJ7E4\\\",\\\"children\\\":\\\"📊ADR 股價 ≠ 隔天開盤價📈道瓊指數 ≠ 台股電子股🧭美股漲 ≠ 所有台股都漲📘連動性高 ≠ 走勢100%複製\\\"}],[\\\"$\\\",\\\"figcaption\\\",null,{\\\"className\\\":\\\"LearnArticle_figCap__LnUbb\\\",\\\"children\\\":\\\"台美連動常見迷思\\\"}]]}]]]}]\\n\"])</script><script>self.__next_f.push([1,\"1c:[\\\"$\\\",\\\"section\\\",\\\"sec-4\\\",{\\\"id\\\":\\\"sec-4\\\",\\\"className\\\":\\\"LearnArticle_section__hLVjU\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"LearnArticle_h2__NmJ08\\\",\\\"children\\\":\\\"四、台股開盤前，我該檢查哪些美股數字？\\\"}],[[\\\"$\\\",\\\"p\\\",\\\"0\\\",{\\\"className\\\":\\\"LearnArticle_p__aZlQ1\\\",\\\"children\\\":\\\"每天早上起床，到 9:00 台股開盤前，不用看得眼花撩亂。你可以建立一個自己的「晨間檢查清單」，花五分鐘快速掌握今天市場可能的氣氛。這能幫助你避免因為單一消息就做出衝動的決定，讓你的判斷更有依據。\\\"}],[\\\"$\\\",\\\"ol\\\",\\\"1\\\",{\\\"className\\\":\\\"LearnArticle_listNum__86N5S\\\",\\\"children\\\":[[\\\"$\\\",\\\"li\\\",\\\"0\\\",{\\\"children\\\":\\\"看三大指數收盤漲跌：先看那斯達克、費半、標普 500 的收盤漲跌幅，對今天大盤有個大概方向。\\\"}],[\\\"$\\\",\\\"li\\\",\\\"1\\\",{\\\"children\\\":\\\"看台積電 ADR 漲跌幅：這尤其重要，因為台積電佔台股權重極高，它的表現會直接影響大盤開盤的點數。\\\"}],[\\\"$\\\",\\\"li\\\",\\\"2\\\",{\\\"children\\\":\\\"看科技巨頭盤後表現：如果剛好是財報季，蘋果、輝達、微軟等公司的「盤後」股價反應，比指數本身更重要。\\\"}],[\\\"$\\\",\\\"li\\\",\\\"3\\\",{\\\"children\\\":\\\"瞄一眼 VIX 恐慌指數：如果 VIX 指數（芝加哥期權交易所波動率指數）飆高，例如超過 25，代表市場避險情緒很濃，就算美股收盤是小漲，台股也可能因為氣氛保守而開低。\\\"}]]}]]]}]\\n\"])</script><script>self.__next_f.push([1,\"1d:[\\\"$\\\",\\\"section\\\",\\\"sec-5\\\",{\\\"id\\\":\\\"sec-5\\\",\\\"className\\\":\\\"LearnArticle_section__hLVjU\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"LearnArticle_h2__NmJ08\\\",\\\"children\\\":\\\"五、什麼時候美股大跌，台股反而會上漲？\\\"}],[[\\\"$\\\",\\\"p\\\",\\\"0\\\",{\\\"className\\\":\\\"LearnArticle_p__aZlQ1\\\",\\\"children\\\":\\\"雖然台美股市連動性高，但並非 100% 複製貼上。有幾種情況，台股會走出自己的路，這時候光看美股臉色就不準了。理解這些「脫鉤」的時機，可以幫助你更客觀地看待市場，而不是一昧地複製別人的進出模式。這時，觀察台股自身的籌碼流向就變得格外重要。\\\"}],[\\\"$\\\",\\\"ul\\\",\\\"1\\\",{\\\"className\\\":\\\"LearnArticle_listCheck__xx1CF\\\",\\\"children\\\":[[\\\"$\\\",\\\"li\\\",\\\"0\\\",{\\\"children\\\":\\\"美股休市，台股獨角戲：例如美國的馬丁路德紀念日、感恩節等假日，美股休市，台股就由內資主導，走出自己的格局。\\\"}],[\\\"$\\\",\\\"li\\\",\\\"1\\\",{\\\"children\\\":\\\"台灣獨有的利多或利空：例如台灣選舉結果、重大的政策發布、或是大型權值股的法說會內容優於預期，都可能讓台股在美股平淡時自己發動攻勢。\\\"}],[\\\"$\\\",\\\"li\\\",\\\"2\\\",{\\\"children\\\":\\\"特定族群走出自己的路：有時候資金會集中在非電子的特定族群，例如航運、生技、或是原物料，這些族群和美國科技股關聯不大，就可能出現美股跌、台股漲的現象。\\\"}],[\\\"$\\\",\\\"li\\\",\\\"3\\\",{\\\"children\\\":\\\"匯率因素：新台幣如果大幅升值，代表熱錢湧入台灣，這股資金動能有時也能抵銷美股下跌的負面情緒。\\\"}]]}]]]}]\\n\"])</script><script>self.__next_f.push([1,\"1e:[\\\"$\\\",\\\"section\\\",\\\"sec-6\\\",{\\\"id\\\":\\\"sec-6\\\",\\\"className\\\":\\\"LearnArticle_section__hLVjU\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"LearnArticle_h2__NmJ08\\\",\\\"children\\\":\\\"常見問題 FAQ\\\"}],[[\\\"$\\\",\\\"div\\\",\\\"0\\\",{\\\"className\\\":\\\"LearnArticle_faq__cemBp\\\",\\\"children\\\":[[\\\"$\\\",\\\"details\\\",\\\"0\\\",{\\\"className\\\":\\\"LearnArticle_faqItem__I9h0U\\\",\\\"children\\\":[[\\\"$\\\",\\\"summary\\\",null,{\\\"children\\\":\\\"為什麼有時候美股盤後電子盤漲，台股隔天也沒跟著漲？\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"LearnArticle_faqA__IPuvc\\\",\\\"children\\\":\\\"美股電子盤（期貨盤）反映的是市場對「未來」的預期，波動較大，參考價值不如收盤價穩定。台股開盤主要還是反映「昨日美股收盤」的結果，並結合亞洲早盤的新消息，所以不一定會完全跟著期貨盤走。\\\"}]]}],[\\\"$\\\",\\\"details\\\",\\\"1\\\",{\\\"className\\\":\\\"LearnArticle_faqItem__I9h0U\\\",\\\"children\\\":[[\\\"$\\\",\\\"summary\\\",null,{\\\"children\\\":\\\"只需要看費城半導體指數就夠了嗎？\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"LearnArticle_faqA__IPuvc\\\",\\\"children\\\":\\\"對電子股來說，費半指數最重要。但如果你投資的是金融、傳產股，那參考道瓊或標普 500 指數會更貼切。想了解美國整體市場情緒，看標普 500 會更全面。\\\"}]]}],[\\\"$\\\",\\\"details\\\",\\\"2\\\",{\\\"className\\\":\\\"LearnArticle_faqItem__I9h0U\\\",\\\"children\\\":[[\\\"$\\\",\\\"summary\\\",null,{\\\"children\\\":\\\"美國升息或降息，對台股有什麼影響？\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"LearnArticle_faqA__IPuvc\\\",\\\"children\\\":\\\"這屬於中長期的總體經濟因素。一般來說，升息會讓企業借錢成本變高，不利於需要大量資金研發的科技股；降息則反之。這個影響會先發生在美股，再透過資金流向與產業連動，間接影響台股。\\\"}]]}],[\\\"$\\\",\\\"details\\\",\\\"3\\\",{\\\"className\\\":\\\"LearnArticle_faqItem__I9h0U\\\",\\\"children\\\":[[\\\"$\\\",\\\"summary\\\",null,{\\\"children\\\":\\\"哪裡可以查到台積電 ADR 的即時報價？\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"LearnArticle_faqA__IPuvc\\\",\\\"children\\\":\\\"許多國際財經網站或券商 App 都有提供美股即時報價，只要搜尋股票代碼「TSM」即可。股市大佬的「國際雷達」頁面也會為會員整理相關重要數據，方便您一站式掌握。\\\"}]]}]]}]]]}]\\n\"])</script><script>self.__next_f.push([1,\"1f:[\\\"$\\\",\\\"section\\\",\\\"sec-7\\\",{\\\"id\\\":\\\"sec-7\\\",\\\"className\\\":\\\"LearnArticle_section__hLVjU\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"LearnArticle_h2__NmJ08\\\",\\\"children\\\":\\\"總結\\\"}],[[\\\"$\\\",\\\"p\\\",\\\"0\\\",{\\\"className\\\":\\\"LearnArticle_p__aZlQ1\\\",\\\"children\\\":\\\"總結來說，把美股當成「天氣預報」，而不是「標準答案」。開盤前參考美股三大指數與台積電 ADR，能幫你判斷今天可能的風向，但最終下單還是要回到台股自身的量價與籌碼結構來做決定。\\\"}]]]}]\\n\"])</script><script>self.__next_f.push([1,\"20:[\\\"$\\\",\\\"section\\\",\\\"sec-8\\\",{\\\"id\\\":\\\"sec-8\\\",\\\"className\\\":\\\"LearnArticle_section__hLVjU\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"LearnArticle_h2__NmJ08\\\",\\\"children\\\":\\\"延伸閱讀\\\"}],[[\\\"$\\\",\\\"ul\\\",\\\"0\\\",{\\\"className\\\":\\\"LearnArticle_list__WjxqC\\\",\\\"children\\\":[[\\\"$\\\",\\\"li\\\",\\\"0\\\",{\\\"children\\\":[[\\\"$\\\",\\\"$L17\\\",\\\"0-想知道更多影響大\\\",{\\\"href\\\":\\\"/diary\\\",\\\"className\\\":\\\"LearnArticle_link__gMwHV\\\",\\\"children\\\":\\\"想知道更多影響大盤的因素？來大盤總覽看看\\\"}]]}],[\\\"$\\\",\\\"li\\\",\\\"1\\\",{\\\"children\\\":[[\\\"$\\\",\\\"$L17\\\",\\\"0-搞懂台積電，就搞\\\",{\\\"href\\\":\\\"/diary\\\",\\\"className\\\":\\\"LearnArticle_link__gMwHV\\\",\\\"children\\\":\\\"搞懂台積電，就搞懂一半的台股！個股透視深入分析\\\"}]]}],[\\\"$\\\",\\\"li\\\",\\\"2\\\",{\\\"children\\\":[[\\\"$\\\",\\\"$L17\\\",\\\"0-新手入門？從台股\\\",{\\\"href\\\":\\\"/school\\\",\\\"className\\\":\\\"LearnArticle_link__gMwHV\\\",\\\"children\\\":\\\"新手入門？從台股學堂開始建立正確觀念\\\"}]]}],[\\\"$\\\",\\\"li\\\",\\\"3\\\",{\\\"children\\\":[[\\\"$\\\",\\\"$L17\\\",\\\"0-川普與國際雷達，\\\",{\\\"href\\\":\\\"/diary\\\",\\\"className\\\":\\\"LearnArticle_link__gMwHV\\\",\\\"children\\\":\\\"川普與國際雷達，幫您掌握全球市場脈動\\\"}]]}]]}]]]}]\\n\"])</script><script>self.__next_f.push([1,\"13:[[\\\"$\\\",\\\"meta\\\",\\\"0\\\",{\\\"charSet\\\":\\\"utf-8\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"1\\\",{\\\"name\\\":\\\"viewport\\\",\\\"content\\\":\\\"width=device-width, initial-scale=1\\\"}]]\\nf:null\\n\"])</script><script>self.__next_f.push([1,\"21:I[80622,[],\\\"IconMark\\\"]\\n11:{\\\"metadata\\\":[[\\\"$\\\",\\\"title\\\",\\\"0\\\",{\\\"children\\\":\\\"美股漲台股就會漲？看懂3大連動指標｜股市大佬 TradeBoss\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"1\\\",{\\\"name\\\":\\\"description\\\",\\\"content\\\":\\\"昨天美股大漲，想說今天台股穩了，結果開盤自己的持股卻是綠的？或是看到那斯達克大跌，就急著在開盤把股票賣掉？其實台股和美股的關係沒那麼簡單，這篇文章教你看懂背後的連動指標，讓你開盤前更有方向。\\\"}],[\\\"$\\\",\\\"link\\\",\\\"2\\\",{\\\"rel\\\":\\\"icon\\\",\\\"href\\\":\\\"/favicon.ico\\\",\\\"type\\\":\\\"image/x-icon\\\",\\\"sizes\\\":\\\"16x16\\\"}],[\\\"$\\\",\\\"$L21\\\",\\\"3\\\",{}]],\\\"error\\\":null,\\\"digest\\\":\\\"$undefined\\\"}\\n\"])</script><script>self.__next_f.push([1,\"16:\\\"$11:metadata\\\"\\n\"])</script></body></html>","rsc":"1:\"$Sreact.fragment\"\n2:I[81259,[\"2619\",\"static/chunks/2619-04bc32f026a0d946.js\",\"7177\",\"static/chunks/app/layout-4382c12d510386d3.js\"],\"default\"]\n3:I[89379,[\"2619\",\"static/chunks/2619-04bc32f026a0d946.js\",\"7177\",\"static/chunks/app/layout-4382c12d510386d3.js\"],\"default\"]\n4:I[9766,[],\"\"]\n5:I[98924,[],\"\"]\n6:I[10021,[\"2619\",\"static/chunks/2619-04bc32f026a0d946.js\",\"7177\",\"static/chunks/app/layout-4382c12d510386d3.js\"],\"default\"]\n7:I[10528,[\"2619\",\"static/chunks/2619-04bc32f026a0d946.js\",\"7177\",\"static/chunks/app/layout-4382c12d510386d3.js\"],\"default\"]\n8:I[50861,[\"2619\",\"static/chunks/2619-04bc32f026a0d946.js\",\"7177\",\"static/chunks/app/layout-4382c12d510386d3.js\"],\"default\"]\nc:I[57150,[],\"\"]\n:HL[\"/_next/static/media/3d26d2f3aa81a833-s.p.woff2\",\"font\",{\"crossOrigin\":\"\",\"type\":\"font/woff2\"}]\n:HL[\"/_next/static/media/604a121a6fa1a135-s.p.woff2\",\"font\",{\"crossOrigin\":\"\",\"type\":\"font/woff2\"}]\n:HL[\"/_next/static/media/6e1768769e6f59a2-s.p.woff2\",\"font\",{\"crossOrigin\":\"\",\"type\":\"font/woff2\"}]\n:HL[\"/_next/static/media/ab2e3a11646b0499-s.p.woff2\",\"font\",{\"crossOrigin\":\"\",\"type\":\"font/woff2\"}]\n:HL[\"/_next/static/css/75c047ba52e43fcc.css\",\"style\"]\n:HL[\"/_next/static/css/aa90c9a426448e43.css\",\"style\"]\n:HL[\"/_next/static/css/e55779c04dd245e2.css\",\"style\"]\n:HL[\"/_next/static/css/8c57d5c3b938342e.css\",\"style\"]\n:HL[\"/_next/static/css/3eaf36e367672966.css\",\"style\"]\n0:{\"P\":null,\"b\":\"2DJ2zhzL_dHSrK5QsdDKA\",\"p\":\"\",\"c\":[\"\",\"learn\",\"tw-us-stock-market-correlation\"],\"i\":false,\"f\":[[[\"\",{\"children\":[\"learn\",{\"children\":[[\"slug\",\"tw-us-stock-market-correlation\",\"d\"],{\"children\":[\"__PAGE__\",{}]}]}]},\"$undefined\",\"$undefined\",true],[\"\",[\"$\",\"$1\",\"c\",{\"children\":[[[\"$\",\"link\",\"0\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/css/75c047ba52e43fcc.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"$undefined\"}],[\"$\",\"link\",\"1\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/css/aa90c9a426448e43.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"$undefined\"}],[\"$\",\"link\",\"2\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/css/e55779c04dd245e2.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"$undefined\"}],[\"$\",\"link\",\"3\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/css/8c57d5c3b938342e.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"$undefined\"}]],[\"$\",\"html\",null,{\"lang\":\"zh-TW\",\"suppressHydrationWarning\":true,\"data-density\":\"comfortable\",\"data-font-size\":\"standard\",\"className\":\"__variable_07e1b6 __variable_cc7473 h-full antialiased\",\"children\":[[\"$\",\"head\",null,{\"children\":[\"$\",\"script\",null,{\"dangerouslySetInnerHTML\":{\"__html\":\"(function(){try{var t=localStorage.getItem('obsidian-theme');if(t!=='light'&&t!=='dark')t='dark';document.documentElement.setAttribute('data-theme',t);document.documentElement.style.colorScheme=(t==='light'?'light':'dark');}catch(e){document.documentElement.setAttribute('data-theme','dark');}})();(function(){try{if(localStorage.getItem('obsidian-comfort-read')==='1')document.documentElement.classList.add('comfort-read');}catch(e){}})();(function(){try{var s=localStorage.getItem('obsidian-updown');if(s==='us')document.documentElement.setAttribute('data-updown','us');}catch(e){}})();(function(){try{var prefs=JSON.parse(localStorage.getItem('bs-preferences-v1')||'{}');var root=document.documentElement;prefs=prefs&&typeof prefs==='object'?prefs:{};root.setAttribute('data-font-size',['standard','large','xlarge','huge'].indexOf(prefs.fontSize)>=0?prefs.fontSize:'standard');root.setAttribute('data-density',prefs.density==='compact'?'compact':'comfortable');}catch(e){}})();\"}}]}],[\"$\",\"body\",null,{\"className\":\"min-h-screen bg-background text-foreground selection:bg-cyan/30 review-mode pb-40 lg:pb-16\",\"data-review-theme\":\"dark\",\"children\":[[\"$\",\"a\",null,{\"href\":\"#main-content\",\"className\":\"skip-link fixed left-3 top-3 z-[80] -translate-y-24 rounded-xl bg-accent px-4 py-2 font-black text-bg shadow-lg transition focus:translate-y-0\",\"children\":\"跳到主要內容\"}],[\"$\",\"$L2\",null,{}],[\"$\",\"$L3\",null,{}],[\"$\",\"main\",null,{\"id\":\"main-content\",\"className\":\"w-full\",\"children\":[\"$\",\"$L4\",null,{\"parallelRouterKey\":\"children\",\"error\":\"$undefined\",\"errorStyles\":\"$undefined\",\"errorScripts\":\"$undefined\",\"template\":[\"$\",\"$L5\",null,{}],\"templateStyles\":\"$undefined\",\"templateScripts\":\"$undefined\",\"notFound\":[[[\"$\",\"title\",null,{\"children\":\"404: This page could not be found.\"}],[\"$\",\"div\",null,{\"style\":{\"fontFamily\":\"system-ui,\\\"Segoe UI\\\",Roboto,Helvetica,Arial,sans-serif,\\\"Apple Color Emoji\\\",\\\"Segoe UI Emoji\\\"\",\"height\":\"100vh\",\"textAlign\":\"center\",\"display\":\"flex\",\"flexDirection\":\"column\",\"alignItems\":\"center\",\"justifyContent\":\"center\"},\"children\":[\"$\",\"div\",null,{\"children\":[[\"$\",\"style\",null,{\"dangerouslySetInnerHTM