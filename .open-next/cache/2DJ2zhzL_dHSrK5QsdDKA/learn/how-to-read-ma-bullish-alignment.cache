",[\"$\",\"$L10\",null,{\"promise\":\"$@11\"}]]}]]}]\nb:[\"$\",\"$1\",\"h\",{\"children\":[null,[[\"$\",\"$L12\",null,{\"children\":\"$L13\"}],[\"$\",\"meta\",null,{\"name\":\"next-size-adjust\",\"content\":\"\"}]],[\"$\",\"$L14\",null,{\"children\":[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$15\",null,{\"fallback\":null,\"children\":\"$L16\"}]}]}]]}]\n17:I[52619,[\"2619\",\"static/chunks/2619-04bc32f026a0d946.js\",\"6309\",\"static/chunks/app/learn/%5Bslug%5D/page-f7b99344f7e2ee16.js\"],\"\"]\nd:[\"$\",\"div\",null,{\"className\":\"LearnArticle_wrap__LIQ8G\",\"children\":[\"$\",\"article\",null,{\"className\":\"LearnArticle_article__2nBbk\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_meta__etj_G\",\"children\":[[\"$\",\"$L17\",null,{\"className\":\"LearnArticle_cat__GQMlg\",\"href\":\"/learn?c=tech\",\"children\":\"技術面\"}],[\"$\",\"span\",null,{\"className\":\"LearnArticle_read__QEj6a\",\"children\":\"閱讀約 6 分鐘\"}]]}],[\"$\",\"h1\",null,{\"className\":\"LearnArticle_title__0_la8\",\"children\":\"均線多頭排列怎麼看？3 步驟找出短中長趨勢，避開假訊號\"}],[\"$\",\"details\",null,{\"className\":\"LearnArticle_toc__LcSAa\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"LearnArticle_tocSummary__YBddG\",\"children\":\"本文目錄\"}],[\"$\",\"ol\",null,{\"className\":\"LearnArticle_tocList__Rq_Lz\",\"children\":[[\"$\",\"li\",\"sec-1\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-1\",\"children\":\"一、什麼是「均線多頭排列」？為什麼它很重要？\"}]}],[\"$\",\"li\",\"sec-2\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-2\",\"children\":\"二、多頭排列的 3 個檢查步驟：不只看順序\"}]}],[\"$\",\"li\",\"sec-3\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-3\",\"children\":\"三、多頭排列 vs. 黃金交叉，哪裡不一樣？\"}]}],[\"$\",\"li\",\"sec-4\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-4\",\"children\":\"四、看到多頭排列，然後呢？一個常見的判斷錯誤\"}]}],[\"$\",\"li\",\"sec-5\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-5\",\"children\":\"五、趨勢轉弱的警訊：什麼時候多頭排列會失效？\"}]}],[\"$\",\"li\",\"sec-6\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-6\",\"children\":\"常見問題 FAQ\"}]}],[\"$\",\"li\",\"sec-7\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-7\",\"children\":\"總結\"}]}],[\"$\",\"li\",\"sec-8\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-8\",\"children\":\"延伸閱讀\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"LearnArticle_body__6B7Mb\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_intro__ATV5c\",\"children\":\"打開 K 線圖，看到 5 日、10 日、20 日、60 日線全部糾纏在一起，到底現在是多頭還是空頭？這篇文章會教你一個簡單的方法，從均線的排列順序，一眼看出市場目前是不是偏向多方，以及這個趨勢有多強。\"}],[[\"$\",\"figure\",\"figure-0\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"短均線（紅）＞中均線（藍）＞長均線（灰）短中長盤整時均線會纏在一起，穿越變多、訊號變吵\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"示意圖｜均線多頭排列：短線在上、長線在下，且一起往上（教學結構，不是某檔實盤）\"}]]}]],[\"$\",\"div\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"「多頭排列」指短天期均線在最上方，依序是中、長天期。\"}],[\"$\",\"li\",\"1\",{\"children\":\"均線發散角度越大，代表趨勢越強勁，但也要留意乖離風險。\"}],[\"$\",\"li\",\"2\",{\"children\":\"多頭排列是趨勢確認指標，不是買賣點，需搭配量價判斷。\"}],[\"$\",\"li\",\"3\",{\"children\":\"當股價跌破月線（20MA），可能是短期趨勢轉弱的警訊。\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、什麼是「均線多頭排列」？為什麼它很重要？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"簡單來說，「均線」就是過去一段時間的平均收盤價連成的線，幫助我們判斷趨勢方向。而「多頭排列」就是當這些線條像彩虹一樣整齊排列，短天期（如 5MA）在最上面，再來是中期（如 20MA），最下面是長期（如 60MA），代表短期買進的成本高於長期，市場看好的氣氛濃厚。\"}],[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"短天期均線 (5MA, 10MA): 代表最近的市場情緒與成本。\"}],[\"$\",\"li\",\"1\",{\"children\":\"中天期均線 (20MA 月線, 60MA 季線): 代表一個波段的趨勢方向。\"}],[\"$\",\"li\",\"2\",{\"children\":\"長天期均線 (120MA 半年線, 240MA 年線): 代表長期支撐與大方向。\"}]]}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、多頭排列的 3 個檢查步驟：不只看順序\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"看到均線由上到下是短到長排列，先別急著進場。一個健康的多頭排列，還需要滿足另外兩個條件：均線方向和發散角度。這三者結合，才能提高判斷的準確度，避免你追在高點、或被短暫的拉抬給騙了。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"順序正確：短天期均線 > 中天期均線 > 長天期均線。\"}],[\"$\",\"li\",\"1\",{\"children\":\"方向一致：所有均線都呈現上揚（往右上角走）。\"}],[\"$\",\"li\",\"2\",{\"children\":\"均線發散：線與線之間的距離逐漸拉開，像扇子一樣打開。\"}]]}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、多頭排列 vs. 黃金交叉，哪裡不一樣？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"很多人會把「多頭排列」和「黃金交叉」搞混。黃金交叉指的是「短天期均線」向上穿越「長天期均線」，它是一個「點」的訊號，代表趨勢可能要反轉向上。而多頭排列則是均線已經排好隊形，是一個「面」的狀態，代表趨勢已經形成並正在持續。\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"指標特性\"}],[\"$\",\"th\",\"1\",{\"children\":\"黃金交叉\"}],[\"$\",\"th\",\"2\",{\"children\":\"均線多頭排列\"}]]}]}],\"$L18\"]}]}],\"$L19\"]]}],\"$L1a\",\"$L1b\",\"$L1c\",\"$L1d\",\"$L1e\"],null]}]]}]}]\n18:[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"訊號類型\"}],[\"$\",\"td\",\"1\",{\"children\":\"點 (單一事件)\"}],[\"$\",\"td\",\"2\",{\"children\":\"面 (持續狀態)\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"發生時機\"}],[\"$\",\"td\",\"1\",{\"children\":\"趨勢剛要反轉或剛形成\"}],[\"$\",\"td\",\"2\",{\"children\":\"趨勢已經確立並在行進中\"}]]}],[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"判讀重點\"}],[\"$\",\"td\",\"1\",{\"children\":\"短線穿越長線的那個交叉點\"}],[\"$\",\"td\",\"2\",{\"children\":\"短中長均線的順序與方向\"}]]}],[\"$\",\"tr\",\"3\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"常見誤區\"}],[\"$\",\"td\",\"1\",{\"children\":\"可能出現假交叉後又跌破\"}],[\"$\",\"td\",\"2\",{\"children\":\"高檔排列可能代表乖離過大\"}]]}]]}]\n19:[\"$\",\"figure\",\"2\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"!股價跌破月線!均線角度走平!短線開始下彎!均線重新糾結\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"多頭排列轉弱 4 警訊\"}]]}]\n1a:[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、看到多頭排列，然後呢？一個常見的判斷錯誤\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"最常見的錯誤，就是把多頭排列當成「買進訊號」。事實上，當一個漂亮的多頭排列出現時，股價通常已經漲了一大段。它告訴你的是「目前趨勢偏多，別急著放空」，而不是「現在馬上買進」。你可以把它當成濾網，只在多頭排列的股票中，再去找尋合適的切入點。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"例如，你可以觀察股價回測月線（20MA）或季線（60MA）有支撐時，再考慮進場，而不是在股價離所有均線都很遠的時候去追高。這樣能讓你的風險相對可控。\"}]]}]]]}]\n1b:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、趨勢轉弱的警訊：什麼時候多頭排列會失效？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"沒有永遠上漲的股票，多頭排列也總有結束的一天。當你發現一些跡象時，就要提高警覺。最直接的訊號就是股價開始跌破短天期均線，如果連作為短期趨勢關鍵的月線（20MA）都守不住，就代表多方力道可能正在減弱，需要重新評估狀況。\"}],[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"股價跌破 5MA、10MA：短期過熱，可能進入整理。\"}],[\"$\",\"li\",\"1\",{\"children\":\"股價跌破月線 (20MA)：短期趨勢轉弱的關鍵警訊。\"}],[\"$\",\"li\",\"2\",{\"children\":\"均線角度走平甚至下彎：上漲力道消失，趨勢可能反轉。\"}],[\"$\",\"li\",\"3\",{\"children\":\"均線開始糾結：多空力道不明，進入盤整區，方向待變。\"}]]}]]]}]\n1c:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"均線參數要設幾天比較準？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"沒有標準答案，端看你的操作週期。短線交易者常用 5、10、20 日；波段操作者看 20、60 日；長線投資人則關注 120、240 日線。重點是固定使用，才能建立一致的判斷標準。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"所有股票都適用均線多頭排列嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"這種趨勢指標比較適用於股本較大、流動性好的股票。對於成交量小、股性活潑的小型股，股價容易被特定買盤影響而劇烈波動，均線可能會頻繁失真。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"看到多頭排列，股價卻一直跌是為什麼？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"這可能是「假突破」或趨勢末端的訊號。有時股價拉高形成多頭排列是為了吸引散戶追價，但主力可能正在出貨。因此，務必搭配成交量觀察，價漲量增才是比較健康的結構。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"手機 App 上的均線顏色都不同，怎麼看？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"顏色只是券商軟體的預設值，不影響判讀。你只要打開設定，確認每一條顏色的線對應的是幾日均線即可。通常軟體都會標示 MA5、MA10 等字樣，以數字為準最可靠。\"}]]}]]}]]]}]\n1d:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"總結來說，均線多頭排列是一個確認「順風」的工具，而不是上車的號誌燈。當短、中、長期均線都方向一致向上時，代表趨勢對多方有利，此時應順勢操作、避免逆勢放空，並搭配量價結構尋找相對安全的進場時機。\"}]]]}]\n1e:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L17\",\"0-想學更多 K 線\",{\"href\":\"/school\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"想學更多 K 線基礎？來台股學堂打好基本功\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L17\",\"0-用個股透視頁，自\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"用個股透視頁，自己設定習慣的均線參數\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L17\",\"0-掃描符合特定技術\",{\"href\":\"/chart\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"掃描符合特定技術型態的股票\"}]]}]]}]]]}]\n13:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\nf:null\n1f:I[80622,[],\"IconMark\"]\n11:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"均線多頭排列怎麼看？3 步驟找出短中長趨勢，避開假訊號｜股市大佬 TradeBoss\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"打開 K 線圖，看到 5 日、10 日、20 日、60 日線全部糾纏在一起，到底現在是多頭還是空頭？這篇文章會教你一個簡單的方法，從均線的排列順序，一眼看出市場目前是不是偏向多方，以及這個趨勢有多強。\"}],[\"$\",\"link\",\"2\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}],[\"$\",\"$L1f\",\"3\",{}]],\"error\":null,\"digest\":\"$undefined\"}\n16:\"$11:metadata\"\n"}