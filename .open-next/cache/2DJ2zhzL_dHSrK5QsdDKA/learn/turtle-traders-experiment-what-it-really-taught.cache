":\"$@12\"}]]}]]}]\nc:[\"$\",\"$1\",\"h\",{\"children\":[null,[[\"$\",\"$L13\",null,{\"children\":\"$L14\"}],[\"$\",\"meta\",null,{\"name\":\"next-size-adjust\",\"content\":\"\"}]],[\"$\",\"$L15\",null,{\"children\":[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$16\",null,{\"fallback\":null,\"children\":\"$L17\"}]}]}]]}]\n18:I[52619,[\"2619\",\"static/chunks/2619-04bc32f026a0d946.js\",\"6309\",\"static/chunks/app/learn/%5Bslug%5D/page-f7b99344f7e2ee16.js\"],\"\"]\ne:[\"$\",\"div\",null,{\"className\":\"LearnArticle_wrap__LIQ8G\",\"children\":[\"$\",\"article\",null,{\"className\":\"LearnArticle_article__2nBbk\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_meta__etj_G\",\"children\":[[\"$\",\"$L18\",null,{\"className\":\"LearnArticle_cat__GQMlg\",\"href\":\"/learn?c=stories\",\"children\":\"人物與市場史\"}],[\"$\",\"span\",null,{\"className\":\"LearnArticle_read__QEj6a\",\"children\":\"閱讀約 6 分鐘\"}]]}],[\"$\",\"h1\",null,{\"className\":\"LearnArticle_title__0_la8\",\"children\":\"海龜實驗怎麼看？規則能複製，虧損卻不能省略\"}],[\"$\",\"details\",null,{\"className\":\"LearnArticle_toc__LcSAa\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"LearnArticle_tocSummary__YBddG\",\"children\":\"本文目錄\"}],[\"$\",\"ol\",null,{\"className\":\"LearnArticle_tocList__Rq_Lz\",\"children\":[[\"$\",\"li\",\"sec-1\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-1\",\"children\":\"一、實驗在問的不是誰比較聰明\"}]}],[\"$\",\"li\",\"sec-2\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-2\",\"children\":\"二、真正被寫進規則書的，是部位怎麼算\"}]}],[\"$\",\"li\",\"sec-3\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-3\",\"children\":\"三、趨勢系統的日常，看起來一點都不傳奇\"}]}],[\"$\",\"li\",\"sec-4\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-4\",\"children\":\"四、知道規則，跟做得到規則，是兩件事\"}]}],[\"$\",\"li\",\"sec-5\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-5\",\"children\":\"五、不要把海龜故事讀成「找一套聖盃」\"}]}],[\"$\",\"li\",\"sec-6\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-6\",\"children\":\"常見問題 FAQ\"}]}],[\"$\",\"li\",\"sec-7\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-7\",\"children\":\"總結\"}]}],[\"$\",\"li\",\"sec-8\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-8\",\"children\":\"延伸閱讀\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"LearnArticle_body__6B7Mb\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_intro__ATV5c\",\"children\":\"一九八〇年代，理查丹尼斯用一套寫下來的規則訓練一群沒有交易背景的人，後來被稱作海龜實驗。外面最常流傳的版本是「交易可以被教會」。比較少被放在標題上的是另一半：同一套規則，有人做得到、有人做不到；而做不到的原因，通常不是看不懂進場，是受不了中間那一長串小虧。\"}],[],[\"$\",\"div\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"海龜留下的核心不是進場訊號，是用波動決定部位大小\"}],[\"$\",\"li\",\"1\",{\"children\":\"趨勢系統的日常長相，常常是一連串小虧加少數大賺\"}],[\"$\",\"li\",\"2\",{\"children\":\"規則能複印，連續虧損的感受無法複印，這才是真正的門檻\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、實驗在問的不是誰比較聰明\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"丹尼斯與艾克哈特爭論的是：優秀交易者是天生的，還是可以被規則訓練出來。他們把進場、出場、加碼與部位大小寫成可以照做的步驟，交給背景各異的學員。重點因此不在「海龜很厲害」，而在「如果把主觀判斷拿掉，剩下的結構還能不能活」。對今天的讀者，這比任何傳奇名字都實用——你要檢查的是自己有沒有一套寫得下來的規則，而不是有沒有天賦。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"實驗問的是規則能不能被執行，不是誰比較聰明\"}],[\"$\",\"li\",\"1\",{\"children\":\"進場只是規則的一小段，部位與出場佔的篇幅更大\"}],[\"$\",\"li\",\"2\",{\"children\":\"沒寫下來的感覺，事後無法檢查，也無法改進\"}]]}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、真正被寫進規則書的，是部位怎麼算\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"公開流傳的海龜規則裡，最被後來系統交易者反覆引用的，不是某一根突破線，而是用近期波動幅度來決定每次該做多大。波動大，同一筆看法就要做得比較小；波動小，才考慮做得比較大。這件事的意義很具體：它把「我很有把握所以多買一點」換成「市場最近跳多兇，我就少暴露一點」。多數人的帳戶不是死在看錯方向，是死在看對方向但部位與波動不匹配。\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"一般直覺\"}],[\"$\",\"th\",\"1\",{\"children\":\"海龜規則在做的事\"}],[\"$\",\"th\",\"2\",{\"children\":\"差別在哪\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"每次買差不多的金額\"}],[\"$\",\"td\",\"1\",{\"children\":\"依波動調整張數\"}],[\"$\",\"td\",\"2\",{\"children\":\"同樣看法，風險暴露不同\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"有把握就加碼\"}],[\"$\",\"td\",\"1\",{\"children\":\"只有規則允許才加\"}],[\"$\",\"td\",\"2\",{\"children\":\"加碼不是情緒開關\"}]]}],[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"虧了想趕快賺回來\"}],[\"$\",\"td\",\"1\",{\"children\":\"接受一連串小虧\"}],[\"$\",\"td\",\"2\",{\"children\":\"系統靠少數大行情補回來\"}]]}],[\"$\",\"tr\",\"3\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"天天都要有動作\"}],[\"$\",\"td\",\"1\",{\"children\":\"多數日子可能沒有訊號\"}],[\"$\",\"td\",\"2\",{\"children\":\"沒訊號也是一種決定\"}]]}]]}]]}]}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、趨勢系統的日常，看起來一點都不傳奇\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"順勢系統的典型資金曲線，不是天天小賺，而是中間夾著一段段回撤，然後才出現少數真正大的行情。這表示你如果每天打開帳戶都要看到綠色，這套結構會讓你很難受。海龜故事裡最被低估的，就是學員必須在連續停損之後，仍然按同一套規則做下一筆。進場條件人人會背；連續虧損後還肯按下一次按鈕，才是實驗真正在篩的能力。\"}],\"$L19\",\"$L1a\"]]}],\"$L1b\",\"$L1c\",\"$L1d\",\"$L1e\",\"$L1f\"],\"$L20\"]}]]}]}]\n19:[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"先問自己能不能接受連續多次小虧\"}],[\"$\",\"li\",\"1\",{\"children\":\"再問單次虧損有沒有被部位公式限制住\"}],[\"$\",\"li\",\"2\",{\"children\":\"最後才問進場條件漂不漂亮\"}]]}]\n1a:[\"$\",\"figure\",\"2\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"!只抄進場線!套用當年參數!回撤就找例外\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"最容易學歪的三件事\"}]]}]\n1b:[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、知道規則，跟做得到規則，是兩件事\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"同一套講義發給所有人，結果仍然分化。後來的訪談與回顧裡，反覆出現的解釋不是「有人比較會看盤」，而是有人在回撤時改規則、減碼到等於沒做、或是開始尋找例外。規則的價值在於減少臨場解釋；人一開始解釋，系統就變回感覺。這也是為什麼把規則寫在紙上還不夠，還要把執行交給事前設定的條件，少給盤中的自己否決權。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"回撤時改規則，等於從來沒有規則\"}],[\"$\",\"li\",\"1\",{\"children\":\"減碼到幾乎沒做，統計會失真，信心也會假好\"}],[\"$\",\"li\",\"2\",{\"children\":\"例外愈多，系統愈接近當天心情\"}]]}]]]}]\n1c:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、不要把海龜故事讀成「找一套聖盃」\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"公開規則被傳了幾十年，市場結構也變了，直接套用當年的突破參數沒有意義。值得留下的是三個結構：部位跟波動走、接受小虧換少數大行情、以及用流程而不是意志力執行。台股同樣適用這三條，因為人性沒變——連續停損時，人還是會想改規則。海龜實驗最誠實的結論不是普通人都能成功，而是：成功所需的能力，很大一部分是忍受無聊與回撤，不是找到更密的進場訊號。\"}]]]}]\n1d:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"海龜規則現在還能直接用嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"不能把當年參數當公式搬來台股。能用的是結構：用波動決定部位、接受一連串小虧、用流程執行。參數要依商品與自己的承受度重做，並且先用小部位驗證。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"為什麼很多人學了規則還是做不久？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"因為日常長相是連續小虧。進場人人會，回撤時不改規則比較難。做不久通常不是看不懂，是受不了中間那段看起來很笨的時間。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"沒有趨勢的市場，這套會怎樣？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"順勢系統在盤整時本來就容易連續停損。這不是突然壞掉，而是它的適用邊界。所以要先問自己能不能接受這種階段，而不是一虧就換下一套聖盃。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"我該不該學海龜？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"該學的是「規則寫得下來、部位算得清楚、回撤時不臨時改」。不該學的是某一條突破線或某個商品組合。條件不同，複製動作沒有依據。\"}]]}]]}]]]}]\n1e:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"海龜實驗真正留下的不是進場密技，而是用波動算部位、接受連續小虧、以及知道規則卻未必做得到。聖盃在訊號裡找不到，門檻在回撤時還肯照做。\"}]]]}]\n1f:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L18\",\"0-部位大小怎麼回推\",{\"href\":\"/learn/how-to-size-your-position\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"部位大小怎麼回推\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L18\",\"0-期望值是什麼\",{\"href\":\"/learn/what-is-expectancy-in-trading\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"期望值是什麼\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L18\",\"0-練功房用歷史行情\",{\"href\":\"/sim\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"練功房用歷史行情練執行\"}]]}]]}]]]}]\n20:[\"$\",\"div\",null,{\"className\":\"LearnArticle_related__9qV55\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_relatedTitle__RXfrl\",\"children\":\"相關文章\"}],[[\"$\",\"$L18\",\"how-to-size-your-position\",{\"href\":\"/learn/how-to-size-your-position\",\"className\":\"LearnArticle_relatedLink__mibXe\",\"children\":\"部位大小怎麼回推\"}],[\"$\",\"$L18\",\"what-is-expectancy-in-trading\",{\"href\":\"/learn/what-is-expectancy-in-trading\",\"className\":\"LearnArticle_relatedLink__mibXe\",\"children\":\"期望值是什麼\"}]]]}]\n14:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\n10:null\n21:I[80622,[],\"IconMark\"]\n12:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"海龜實驗怎麼看？規則能複製，虧損卻不能省略｜股市大佬 TradeBoss\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"一九八〇年代，理查丹尼斯用一套寫下來的規則訓練一群沒有交易背景的人，後來被稱作海龜實驗。外面最常流傳的版本是「交易可以被教會」。比較少被放在標題上的是另一半：同一套規則，有人做得到、有人做不到；而做不到的原因，通常不是看不懂進場，是受不了中間那一長串小虧。\"}],[\"$\",\"link\",\"2\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}],[\"$\",\"$L21\",\"3\",{}]],\"error\":null,\"digest\":\"$undefined\"}\n17:\"$12:metadata\"\n"}