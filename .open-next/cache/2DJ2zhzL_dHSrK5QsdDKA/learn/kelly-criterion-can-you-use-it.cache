l,{\"hidden\":true,\"children\":[\"$\",\"$15\",null,{\"fallback\":null,\"children\":\"$L16\"}]}]}]]}]\n17:I[52619,[\"2619\",\"static/chunks/2619-04bc32f026a0d946.js\",\"6309\",\"static/chunks/app/learn/%5Bslug%5D/page-f7b99344f7e2ee16.js\"],\"\"]\nd:[\"$\",\"div\",null,{\"className\":\"LearnArticle_wrap__LIQ8G\",\"children\":[\"$\",\"article\",null,{\"className\":\"LearnArticle_article__2nBbk\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_meta__etj_G\",\"children\":[[\"$\",\"$L17\",null,{\"className\":\"LearnArticle_cat__GQMlg\",\"href\":\"/learn?c=strategy\",\"children\":\"策略解析\"}],[\"$\",\"span\",null,{\"className\":\"LearnArticle_read__QEj6a\",\"children\":\"閱讀約 4 分鐘\"}]]}],[\"$\",\"h1\",null,{\"className\":\"LearnArticle_title__0_la8\",\"children\":\"凱利公式能直接用嗎？3個前提不成立就先縮小\"}],[\"$\",\"details\",null,{\"className\":\"LearnArticle_toc__LcSAa\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"LearnArticle_tocSummary__YBddG\",\"children\":\"本文目錄\"}],[\"$\",\"ol\",null,{\"className\":\"LearnArticle_tocList__Rq_Lz\",\"children\":[[\"$\",\"li\",\"sec-1\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-1\",\"children\":\"一、它在回答的題目很窄\"}]}],[\"$\",\"li\",\"sec-2\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-2\",\"children\":\"二、勝率與賠率在交易裡都不穩\"}]}],[\"$\",\"li\",\"sec-3\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-3\",\"children\":\"三、為什麼常有人說先用四分之一或一半\"}]}],[\"$\",\"li\",\"sec-4\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-4\",\"children\":\"四、沒有足夠樣本，公式只是裝飾\"}]}],[\"$\",\"li\",\"sec-5\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-5\",\"children\":\"五、它能幫的最小忙\"}]}],[\"$\",\"li\",\"sec-6\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-6\",\"children\":\"常見問題 FAQ\"}]}],[\"$\",\"li\",\"sec-7\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-7\",\"children\":\"總結\"}]}],[\"$\",\"li\",\"sec-8\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-8\",\"children\":\"延伸閱讀\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"LearnArticle_body__6B7Mb\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_intro__ATV5c\",\"children\":\"有人聽到凱利，會以為找到科學的下注比例。公式本身不神秘：它問的是，若你真的知道勝率與平均賺賠，長期成長最快的下注大概是多少。問題出在「若你真的知道」。交易裡這兩個數字會變、樣本會少、連續虧損會先把人做壞。所以比較有用的問法不是「公式是多少」，是「我哪裡沒資格用全額」。\"}],[[\"$\",\"figure\",\"figure-0\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"虧 3 次每次 −1%賺 2 次每次 +1%勝率 40% 也可能是正期望，前提是賺的比虧的大、且扣得起成本短線先扣約 0.24% 當沖成本，再看還剩多少\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"示意圖｜期望值：勝率要配上平均賺賠，再扣成本（教學結構，不是某檔實盤）\"}]]}]],[\"$\",\"div\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"公式要的是穩定的勝率與賠率，實務兩者都會漂\"}],[\"$\",\"li\",\"1\",{\"children\":\"全額凱利的波動，很多人心理上先撐不住\"}],[\"$\",\"li\",\"2\",{\"children\":\"常見做法是先縮小，並承認數字是估計不是常數\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、它在回答的題目很窄\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"它優化的是長期複利成長，不是讓你舒服，也不是讓最大回撤最小。你若在乎的是睡得著、或是不要被連續虧損打出遊戲，它給的答案可能偏大。題目不同，答案就不能直接搬。先寫你真正要優化的是成長、存活，還是情緒穩定。三個常打架。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"它偏長期成長\"}],[\"$\",\"li\",\"1\",{\"children\":\"不一定偏舒服或小回撤\"}],[\"$\",\"li\",\"2\",{\"children\":\"先寫你要優化哪一題\"}]]}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、勝率與賠率在交易裡都不穩\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"擲硬幣的勝率可以重複量。交易的勝率會隨市況、成本、你自己的執行漂走。你用過去一百筆估出來的數字，下一季可能就不是那個數。公式對輸入非常敏感：勝率少估或多估一點，建議部位可以差一截。輸入是估計，輸出就不能當法令。\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"公式當常數的\"}],[\"$\",\"th\",\"1\",{\"children\":\"實務比較像\"}],[\"$\",\"th\",\"2\",{\"children\":\"所以要\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"勝率固定\"}],[\"$\",\"td\",\"1\",{\"children\":\"隨市況與執行漂\"}],[\"$\",\"td\",\"2\",{\"children\":\"當區間，不當單一數字\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"賠率固定\"}],[\"$\",\"td\",\"1\",{\"children\":\"平均賺賠會變\"}],[\"$\",\"td\",\"2\",{\"children\":\"定期重估，且要有樣本\"}]]}],[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"每次獨立\"}],[\"$\",\"td\",\"1\",{\"children\":\"連續虧常成串\"}],[\"$\",\"td\",\"2\",{\"children\":\"先想連虧時你還在不在\"}]]}],[\"$\",\"tr\",\"3\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"可以重來無限次\"}],[\"$\",\"td\",\"1\",{\"children\":\"帳戶會先沒錢或沒膽\"}],[\"$\",\"td\",\"2\",{\"children\":\"先保存活\"}]]}]]}]]}]}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、為什麼常有人說先用四分之一或一半\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"因為全額算出來的部位，回撤常常大到規則執行不下去。縮小不是因為公式錯，是因為你的目標其實包含存活與可執行。一半或四分之一沒有魔法，它只是承認：估計不準、情緒有上限。你要寫的是縮小規則，不是找一個更神的係數。\"}],\"$L18\",\"$L19\"]]}],\"$L1a\",\"$L1b\",\"$L1c\",\"$L1d\",\"$L1e\"],\"$L1f\"]}]]}]}]\n18:[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"先用較醜的勝率與賠率估一輪\"}],[\"$\",\"li\",\"1\",{\"children\":\"再把結果縮小到連虧時仍做得到\"}],[\"$\",\"li\",\"2\",{\"children\":\"最後才允許自己討論要不要放大\"}]]}]\n19:[\"$\",\"figure\",\"2\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"✓估計區間✓連虧時還在不在✓縮小規則\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"用之前先寫\"}]]}]\n1a:[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、沒有足夠樣本，公式只是裝飾\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"二十筆交易算出來的勝率，統計上很吵。這時談凱利，比較像給恐懼或貪婪一件科學外套。樣本不夠，先用固定小比例，把日誌補滿。公式是有了穩定估計之後的加分，不是起步裝備。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"樣本少時先固定小比例\"}],[\"$\",\"li\",\"1\",{\"children\":\"不要用公式幫太少的資料化妝\"}],[\"$\",\"li\",\"2\",{\"children\":\"估計穩定了再談優化\"}]]}]]]}]\n1b:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、它能幫的最小忙\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"它提醒你：部位大小跟勝率、賠率有關，不該全憑感覺。它不能幫的是：把不穩定的估計變成精確的下單張數。把這層界線守住，凱利就還是好老師；越界，它會變成讓你下比較重的藉口。\"}]]]}]\n1c:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"是不是一定要用凱利才科學？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"不是。固定小比例、依波動調整，都可以是規則。科學不等於套這個公式。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"勝率很高就可以下很重嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"高勝率若賠率很差，或估計不穩，重倉仍可能一次回去。先看估計穩不穩。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"和最大回撤怎麼一起看？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"凱利不管你舒不舒服。你若在乎回撤，就要把回撤上限寫進規則，不能只看公式輸出。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"紙上算出來再實盤可以嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"紙上的勝率常偏樂觀。實盤先用更小的比例，把滑價與情緒算進去。\"}]]}]]}]]]}]\n1d:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"凱利要穩定的勝率與賠率，交易兩者都會漂。全額常晃壞執行。先縮小、先保存活，公式才能當老師而不是藉口。\"}]]]}]\n1e:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L17\",\"0-部位大小怎麼回推\",{\"href\":\"/learn/how-to-size-your-position\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"部位大小怎麼回推\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L17\",\"0-最大回撤是什麼\",{\"href\":\"/learn/what-max-drawdown-really-means\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"最大回撤是什麼\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L17\",\"0-期望值怎麼算\",{\"href\":\"/learn/what-is-expectancy-in-trading\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"期望值怎麼算\"}]]}]]}]]]}]\n1f:[\"$\",\"div\",null,{\"className\":\"LearnArticle_related__9qV55\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_relatedTitle__RXfrl\",\"children\":\"相關文章\"}],[[\"$\",\"$L17\",\"how-to-size-your-position\",{\"href\":\"/learn/how-to-size-your-position\",\"className\":\"LearnArticle_relatedLink__mibXe\",\"children\":\"部位大小怎麼回推\"}],[\"$\",\"$L17\",\"what-max-drawdown-really-means\",{\"href\":\"/learn/what-max-drawdown-really-means\",\"className\":\"LearnArticle_relatedLink__mibXe\",\"children\":\"最大回撤是什麼\"}],[\"$\",\"$L17\",\"what-is-expectancy-in-trading\",{\"href\":\"/learn/what-is-expectancy-in-trading\",\"className\":\"LearnArticle_relatedLink__mibXe\",\"children\":\"期望值怎麼算\"}]]]}]\n13:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\nf:null\n20:I[80622,[],\"IconMark\"]\n11:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"凱利公式能直接用嗎？3個前提不成立就先縮小｜股市大佬 TradeBoss\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"有人聽到凱利，會以為找到科學的下注比例。公式本身不神秘：它問的是，若你真的知道勝率與平均賺賠，長期成長最快的下注大概是多少。問題出在「若你真的知道」。交易裡這兩個數字會變、樣本會少、連續虧損會先把人做壞。所以比較有用的問法不是「公式是多少」，是「我哪裡沒資格用全額」。\"}],[\"$\",\"link\",\"2\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}],[\"$\",\"$L20\",\"3\",{}]],\"error\":null,\"digest\":\"$undefined\"}\n16:\"$11:metadata\"\n"}