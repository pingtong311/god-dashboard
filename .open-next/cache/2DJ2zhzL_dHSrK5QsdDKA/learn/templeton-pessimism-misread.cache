li\",\"sec-4\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-4\",\"children\":\"四、台股版最常見的誤用\"}]}],[\"$\",\"li\",\"sec-5\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-5\",\"children\":\"五、最小動作\"}]}],[\"$\",\"li\",\"sec-6\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-6\",\"children\":\"常見問題 FAQ\"}]}],[\"$\",\"li\",\"sec-7\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-7\",\"children\":\"總結\"}]}],[\"$\",\"li\",\"sec-8\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-8\",\"children\":\"延伸閱讀\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"LearnArticle_body__6B7Mb\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_intro__ATV5c\",\"children\":\"約翰·鄧普頓留下一句被傳很廣的話，大意是在別人最悲觀時尋找機會。後來被壓成「跌深就買」。少掉的是：悲觀要先被你研究成「過悲觀」，而且你要有時間與資金等到敘述改變。沒有這兩層，最悲觀只是一個感覺，感覺常出現在還能更悲觀的時候。\"}],[],[\"$\",\"div\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"最悲觀是描述群眾溫度，不是自動進場鈴\"}],[\"$\",\"li\",\"1\",{\"children\":\"你要先講得出市場在怕什麼、怕得過不過分\"}],[\"$\",\"li\",\"2\",{\"children\":\"沒有等待時間與流動性，便宜走不掉就不是機會\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、句子被壓扁之後\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"公開語境裡，這句話搭配的是主動尋找被冷落的市場與公司，而不是在任何下跌按買。壓扁成口號之後，它變成損失趨避的反面衝動：用反向證明自己比較冷靜。冷靜沒有研究，只是另一種情緒。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"口號會刪掉研究\"}],[\"$\",\"li\",\"1\",{\"children\":\"反向可以是情緒\"}],[\"$\",\"li\",\"2\",{\"children\":\"溫度≠進場\"}]]}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、三個條件\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"第一，你能用自己的話寫下群眾在怕什麼。第二，你能寫下怕得過當的理由，以及你可能才是錯的那一方。第三，你能等，而且走得掉。三個少一個，就還只是口號。\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"口號\"}],[\"$\",\"th\",\"1\",{\"children\":\"條件\"}],[\"$\",\"th\",\"2\",{\"children\":\"缺條件時\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"別人怕所以買\"}],[\"$\",\"td\",\"1\",{\"children\":\"怕的是什麼\"}],[\"$\",\"td\",\"2\",{\"children\":\"你只是在買下跌\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"最低點附近\"}],[\"$\",\"td\",\"1\",{\"children\":\"你無法事前知道最低\"}],[\"$\",\"td\",\"2\",{\"children\":\"還能更低\"}]]}],[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"逆向就是智慧\"}],[\"$\",\"td\",\"1\",{\"children\":\"逆向也要尺子\"}],[\"$\",\"td\",\"2\",{\"children\":\"從眾於反向人群\"}]]}],[\"$\",\"tr\",\"3\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"長期會好\"}],[\"$\",\"td\",\"1\",{\"children\":\"你的錢能長期嗎\"}],[\"$\",\"td\",\"2\",{\"children\":\"中途被逼走\"}]]}]]}]]}]}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、和葛拉漢市場先生的關係\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"市場先生沮喪時報低價，是邀請。鄧普頓這句是邀請的溫度計。兩句都沒有叫你每次都接受邀請。接受之前仍要能力圈與失效。\"}],[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"先量溫度\"}],[\"$\",\"li\",\"1\",{\"children\":\"再問自己懂不懂\"}],[\"$\",\"li\",\"2\",{\"children\":\"最後問走不走得掉\"}]]}],[\"$\",\"figure\",\"2\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"!跌深就買!當日金句按鈕!逆向等於智慧\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"誤讀\"}]]}]]]}],[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、台股版最常見的誤用\"}],[\"$L18\",\"$L19\"]]}],\"$L1a\",\"$L1b\",\"$L1c\",\"$L1d\"],\"$L1e\"]}]]}]}]\n18:[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"指數大跌那天，群組會重貼這句話。當天流動性往往最差，敘述也最整齊。整齊的悲觀可以持續很久，一九九〇年寫過。把歷史金句當當日按鈕，是把教材當月曆。\"}]\n19:[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"大跌日金句最響\"}],[\"$\",\"li\",\"1\",{\"children\":\"響的時候離開最擠\"}],[\"$\",\"li\",\"2\",{\"children\":\"金句不當按鈕\"}]]}]\n1a:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、最小動作\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"想用這句話時，先寫五十個字：他們在怕什麼、我為什麼認為過當、我能等多久。寫不滿，就先不要用這句話幫自己壯膽。\"}]]]}]\n1b:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"恐懼時是不是比較容易有好價格？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"有時是。好價格仍要你懂、你能等、你走得掉。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"和巴菲特那句別人恐懼有何不同？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"傳播上常被當成同一句。都要配研究與時間，都不能當當日按鈕。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"用數字能測最悲觀嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"溫度可以找代理變數。代理不是真理，過度配適常見。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"國際市場一起悲觀呢？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"系統性悲觀時，分散與流動性都要重估。見海嘯與塔雷伯兩篇。\"}]]}]]}]]]}]\n1c:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"「最悲觀時」是溫度計，不是按鈕。三個條件：寫得出怕什麼、寫得出可能是你錯、寫得出能等且走得掉。\"}]]]}]\n1d:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L17\",\"0-葛拉漢市場先生\",{\"href\":\"/learn/graham-mr-market-three-checks\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"葛拉漢市場先生\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L17\",\"0-1990 台股萬\",{\"href\":\"/learn/taiwan-1990-crash-what-it-still-teaches\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"1990 台股萬點\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L17\",\"0-從眾行為\",{\"href\":\"/learn/herding-in-markets\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"從眾行為\"}]]}]]}]]]}]\n1e:[\"$\",\"div\",null,{\"className\":\"LearnArticle_related__9qV55\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_relatedTitle__RXfrl\",\"children\":\"相關文章\"}],[[\"$\",\"$L17\",\"graham-mr-market-three-checks\",{\"href\":\"/learn/graham-mr-market-three-checks\",\"className\":\"LearnArticle_relatedLink__mibXe\",\"children\":\"葛拉漢市場先生\"}]