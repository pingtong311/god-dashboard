,\"li\",\"sec-3\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-3\",\"children\":\"三、賣出時的「證交稅」又是多少？\"}]}],[\"$\",\"li\",\"sec-4\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-4\",\"children\":\"四、零股交易的手續費，有什麼不一樣？\"}]}],[\"$\",\"li\",\"sec-5\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-5\",\"children\":\"五、如何聰明省下交易成本？三個實用技巧\"}]}],[\"$\",\"li\",\"sec-6\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-6\",\"children\":\"常見問題 FAQ\"}]}],[\"$\",\"li\",\"sec-7\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-7\",\"children\":\"總結\"}]}],[\"$\",\"li\",\"sec-8\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-8\",\"children\":\"延伸閱讀\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"LearnArticle_body__6B7Mb\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_intro__ATV5c\",\"children\":\"每次看對帳單，都覺得手續費跟自己想的不一樣？一買一賣之間，到底被券商收了多少錢？這篇會帶你拆解所有交易成本，精準算出買賣股票要付的費用，讓每一分錢都花在刀口上。\"}],[[\"$\",\"figure\",\"figure-0\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"沒扣成本的勝率，看起來都會比較漂亮0.029%手續費 1 折來回0.15%當沖證交稅0.06%滑價估計三項合計約 0.24%；留倉稅率更高，約 0.39%\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"示意圖｜當沖來回成本：1 折手續費 + 證交稅 + 滑價（教學結構，不是某檔實盤）\"}]]}]],[\"$\",\"div\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"台股交易成本包含「券商手續費」與「證券交易稅」兩大部分。\"}],[\"$\",\"li\",\"1\",{\"children\":\"手續費公定價為千分之 1.425，可與券商談折扣，是省錢關鍵。\"}],[\"$\",\"li\",\"2\",{\"children\":\"賣出股票時才需繳交千分之 3 的證交稅，ETF 證交稅為千分之 1。\"}],[\"$\",\"li\",\"3\",{\"children\":\"零股交易手續費有「最低收費」門檻，小額買賣要特別注意成本佔比。\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、買賣股票的成本，到底有哪些？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"股票交易的成本其實很單純，只有兩筆費用：「券商手續費」和「證券交易稅」。搞懂這兩者的差別，你就掌握了控制成本的第一步。一個是付給券商的服務費，另一個是繳給政府的稅金。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"券商手續費：買進和賣出時「都要收」。這是付給券商處理你交易指令的服務費，這筆費用有折扣空間。\"}],[\"$\",\"li\",\"1\",{\"children\":\"證券交易稅：只有在「賣出」股票時才要收。這是繳給政府的稅，稅率是固定的，無法打折。\"}]]}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、券商手續費怎麼算？折扣是省錢關鍵！\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"手續費的公定價是「成交金額的 0.1425%」。不過，為了吸引客戶，券商通常會提供折扣，這就是你省錢的空間。常見的折扣有 6 折、5 折，甚至到 2.8 折。記得，買進和賣出時都會各算一次。\"}],[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"計算公式：成交金額 × 0.1425% × 券商折扣\"}],[\"$\",\"li\",\"1\",{\"children\":\"舉例：假設你用 5 折的優惠，買進一張 100 元的股票（總成交金額為 10 萬元）。\"}],[\"$\",\"li\",\"2\",{\"children\":\"手續費 = 100,000 元 × 0.1425% × 0.5 = 71.25 元。多數券商會無條件捨去小數點，所以實際收取 71 元。\"}]]}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、賣出時的「證交稅」又是多少？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"證券交易稅是賣股票時才需要繳的固定成本，這筆錢沒有任何折扣。一般股票的稅率是「成交金額的 0.3%」，如果是買賣指數股票型基金（ETF），稅率則優惠為「成交金額的 0.1%」。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"計算公式：成交金額 × 稅率（股票 0.3%；ETF 0.1%）\"}],[\"$\",\"li\",\"1\",{\"children\":\"舉例：假設你以每股 110 元賣出一張股票（總成交金額為 11 萬元）。\"}],[\"$\",\"li\",\"2\",{\"children\":\"應繳證交稅 = 110,000 元 × 0.3% = 330 元。\"}],[\"$\",\"li\",\"3\",{\"children\":\"如果是賣出同價值的 ETF，證交稅 = 110,000 元 × 0.1% = 110 元，成本就低很多。\"}]]}],\"$L18\"]]}],\"$L19\",\"$L1a\",\"$L1b\",\"$L1c\",\"$L1d\"],null]}]]}]}]\n18:[\"$\",\"figure\",\"2\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"✓券商手續費 (有折扣)✓證券交易稅 (沒折扣)✓股票稅率 0.3%✓ETF 稅率 0.1%\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"賣股票成本，兩項費用加總\"}]]}]\n19:[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、零股交易的手續費，有什麼不一樣？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"小額買賣零股時，要特別留意券商的「最低手續費」規定。雖然計算公式一樣，但如果算出來的費用太低，券商會直接收取一筆最低費用，常見的是 20 元。這會讓小額交易的成本佔比大幅提高。\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"項目\"}],[\"$\",\"th\",\"1\",{\"children\":\"買 10 萬元股票 (5 折)\"}],[\"$\",\"th\",\"2\",{\"children\":\"買 1,000 元零股 (低收 20 元)\"}],[\"$\",\"th\",\"3\",{\"children\":\"買 1,000 元零股 (低收 1 元)\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"成交金額\"}],[\"$\",\"td\",\"1\",{\"children\":\"100,000 元\"}],[\"$\",\"td\",\"2\",{\"children\":\"1,000 元\"}],[\"$\",\"td\",\"3\",{\"children\":\"1,000 元\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"理論手續費\"}],[\"$\",\"td\",\"1\",{\"children\":\"71 元\"}],[\"$\",\"td\",\"2\",{\"children\":\"0.71 元\"}],[\"$\",\"td\",\"3\",{\"children\":\"0.71 元\"}]]}],[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"實際手續費\"}],[\"$\",\"td\",\"1\",{\"children\":\"71 元\"}],[\"$\",\"td\",\"2\",{\"children\":\"20 元 (取高者)\"}],[\"$\",\"td\",\"3\",{\"children\":\"1 元 (取高者)\"}]]}],[\"$\",\"tr\",\"3\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"成本佔比\"}],[\"$\",\"td\",\"1\",{\"children\":\"0.071%\"}],[\"$\",\"td\",\"2\",{\"children\":\"2.0%\"}],[\"$\",\"td\",\"3\",{\"children\":\"0.1%\"}]]}]]}]]}]}]]]}]\n1a:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、如何聰明省下交易成本？三個實用技巧\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"了解計算方式後，你就可以採取主動，為自己爭取更有利的交易條件。省下來的每一塊錢，都是你多賺的獲利。底下提供三個最直接有效的方法，幫助你降低交易摩擦成本。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"開戶前多比較：不同券商給新戶的折扣、零股低消都不同。花點時間比較，特別是針對電子下單的優惠，能省下不少錢。\"}],[\"$\",\"li\",\"1\",{\"children\":\"主動和營業員溝通：如果你的交易量或帳戶資產達到一定規模，可以主動向你的營業員詢問，是否有機會調整到更優惠的手續費折扣。\"}],[\"$\",\"li\",\"2\",{\"children\":\"注意零股交易門檻：如果你常做小額投資，務必選擇「最低手續費 1 元」的券商，才不會讓交易成本吃掉大部分的投資金額。\"}]]}]]]}]\n1b:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"手續費算出來有小數點怎麼辦？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"大多數券商採「無條件捨去」到整數位，但也有部分會四捨五入或無條件進位。這部分規定各家不同，建議直接詢問你的券商最準確。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"當沖的證交稅真的比較便宜嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"是的，根據現行規定，現股當日沖銷的證交稅率是減半，也就是千分之 1.5。但當沖需要看盤技巧且風險較高，不適合所有投資人。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"買賣 ETF 的成本也一樣嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"手續費的計算方式和股票完全相同，一樣是成交金額的千分之 1.425 再打折。但賣出時的證交稅率只要千分之 1，比股票的千分之 3 便宜很多。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"為什麼對帳單上的手續費跟我自己算的不一樣？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"最常見的原因是忽略了「最低手續費」。特別是買賣零股時，如果算出來的費用低於券商的低收門檻（例如 20 元），帳單上就會以最低費用來收取。\"}]]}]]}]]]}]\n1c:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"搞懂交易成本是投資的基本功。記得「手續費找折扣、零股看低消、賣出才有稅」，就能有效控制花費，讓獲利更實在。\"}]]]}]\n1d:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L17\",\"0-從零開始？看我們\",{\"href\":\"/school\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"從零開始？看我們的台股學堂\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L17\",\"0-想知道更多專有名\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"想知道更多專有名詞解釋？\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L17\",\"0-註冊會員，開始使\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"註冊會員，開始使用分析工具\"}]]}]]}]]]}]\n13:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\nf:null\n1e:I[80622,[],\"IconMark\"]\n11:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"台股手續費怎麼算？2026最新券商折扣、計算公式一次看懂｜股市大佬 TradeBoss\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"每次看對帳單，都覺得手續費跟自己想的不一樣？一買一賣之間，到底被券商收了多少錢？這篇會帶你拆解所有交易成本，精準算出買賣股票要付的費用，讓每一分錢都花在刀口上。\"}],[\"$\",\"link\",\"2\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}],[\"$\",\"$L1e\",\"3\",{}]],\"error\":null,\"digest\":\"$undefined\"}\n16:\"$11:metadata\"\n"}