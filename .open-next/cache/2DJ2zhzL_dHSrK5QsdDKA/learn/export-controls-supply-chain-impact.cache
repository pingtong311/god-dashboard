\n\"])</script><script>self.__next_f.push([1,\"e:I[24431,[],\\\"OutletBoundary\\\"]\\n10:I[15278,[],\\\"AsyncMetadataOutlet\\\"]\\n12:I[24431,[],\\\"ViewportBoundary\\\"]\\n14:I[24431,[],\\\"MetadataBoundary\\\"]\\n15:\\\"$Sreact.suspense\\\"\\n9:[\\\"$\\\",\\\"$1\\\",\\\"c\\\",{\\\"children\\\":[null,[\\\"$\\\",\\\"$L4\\\",null,{\\\"parallelRouterKey\\\":\\\"children\\\",\\\"error\\\":\\\"$undefined\\\",\\\"errorStyles\\\":\\\"$undefined\\\",\\\"errorScripts\\\":\\\"$undefined\\\",\\\"template\\\":[\\\"$\\\",\\\"$L5\\\",null,{}],\\\"templateStyles\\\":\\\"$undefined\\\",\\\"templateScripts\\\":\\\"$undefined\\\",\\\"notFound\\\":\\\"$undefined\\\",\\\"forbidden\\\":\\\"$undefined\\\",\\\"unauthorized\\\":\\\"$undefined\\\"}]]}]\\na:[\\\"$\\\",\\\"$1\\\",\\\"c\\\",{\\\"children\\\":[\\\"$Ld\\\",[[\\\"$\\\",\\\"link\\\",\\\"0\\\",{\\\"rel\\\":\\\"stylesheet\\\",\\\"href\\\":\\\"/_next/static/css/3eaf36e367672966.css\\\",\\\"precedence\\\":\\\"next\\\",\\\"crossOrigin\\\":\\\"$undefined\\\",\\\"nonce\\\":\\\"$undefined\\\"}]],[\\\"$\\\",\\\"$Le\\\",null,{\\\"children\\\":[\\\"$Lf\\\",[\\\"$\\\",\\\"$L10\\\",null,{\\\"promise\\\":\\\"$@11\\\"}]]}]]}]\\nb:[\\\"$\\\",\\\"$1\\\",\\\"h\\\",{\\\"children\\\":[null,[[\\\"$\\\",\\\"$L12\\\",null,{\\\"children\\\":\\\"$L13\\\"}],[\\\"$\\\",\\\"meta\\\",null,{\\\"name\\\":\\\"next-size-adjust\\\",\\\"content\\\":\\\"\\\"}]],[\\\"$\\\",\\\"$L14\\\",null,{\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"hidden\\\":true,\\\"children\\\":[\\\"$\\\",\\\"$15\\\",null,{\\\"fallback\\\":null,\\\"children\\\":\\\"$L16\\\"}]}]}]]}]\\n\"])</script><script>self.__next_f.push([1,\"17:I[52619,[\\\"2619\\\",\\\"static/chunks/2619-04bc32f026a0d946.js\\\",\\\"6309\\\",\\\"static/chunks/app/learn/%5Bslug%5D/page-f7b99344f7e2ee16.js\\\"],\\\"\\\"]\\n\"])</script><script>self.__next_f.push([1,\"d:[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"LearnArticle_wrap__LIQ8G\\\",\\\"children\\\":[\\\"$\\\",\\\"article\\\",null,{\\\"className\\\":\\\"LearnArticle_article__2nBbk\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"LearnArticle_meta__etj_G\\\",\\\"children\\\":[[\\\"$\\\",\\\"$L17\\\",null,{\\\"className\\\":\\\"LearnArticle_cat__GQMlg\\\",\\\"href\\\":\\\"/learn?c=trends\\\",\\\"children\\\":\\\"產業與趨勢\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"LearnArticle_read__QEj6a\\\",\\\"children\\\":\\\"閱讀約 6 分鐘\\\"}]]}],[\\\"$\\\",\\\"h1\\\",null,{\\\"className\\\":\\\"LearnArticle_title__0_la8\\\",\\\"children\\\":\\\"出口管制是什麼？為什麼新聞一報我的股票就跌？3 步驟看懂供應鏈影響\\\"}],[\\\"$\\\",\\\"details\\\",null,{\\\"className\\\":\\\"LearnArticle_toc__LcSAa\\\",\\\"children\\\":[[\\\"$\\\",\\\"summary\\\",null,{\\\"className\\\":\\\"LearnArticle_tocSummary__YBddG\\\",\\\"children\\\":\\\"本文目錄\\\"}],[\\\"$\\\",\\\"ol\\\",null,{\\\"className\\\":\\\"LearnArticle_tocList__Rq_Lz\\\",\\\"children\\\":[[\\\"$\\\",\\\"li\\\",\\\"sec-1\\\",{\\\"children\\\":[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"#sec-1\\\",\\\"children\\\":\\\"一、什麼是出口管制？為什麼殺傷力這麼大？\\\"}]}],[\\\"$\\\",\\\"li\\\",\\\"sec-2\\\",{\\\"children\\\":[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"#sec-2\\\",\\\"children\\\":\\\"二、我的股票會不會受影響？從財報銷售地區找答案\\\"}]}],[\\\"$\\\",\\\"li\\\",\\\"sec-3\\\",{\\\"children\\\":[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"#sec-3\\\",\\\"children\\\":\\\"三、直接衝擊 vs. 間接影響，一張表看懂差異\\\"}]}],[\\\"$\\\",\\\"li\\\",\\\"sec-4\\\",{\\\"children\\\":[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"#sec-4\\\",\\\"children\\\":\\\"四、危機就是轉機？看懂「轉單效應」與「國產替代」\\\"}]}],[\\\"$\\\",\\\"li\\\",\\\"sec-5\\\",{\\\"children\\\":[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"#sec-5\\\",\\\"children\\\":\\\"五、股價反應過度了嗎？從籌碼面判斷市場情緒\\\"}]}],[\\\"$\\\",\\\"li\\\",\\\"sec-6\\\",{\\\"children\\\":[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"#sec-6\\\",\\\"children\\\":\\\"常見問題 FAQ\\\"}]}],[\\\"$\\\",\\\"li\\\",\\\"sec-7\\\",{\\\"children\\\":[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"#sec-7\\\",\\\"children\\\":\\\"總結\\\"}]}],[\\\"$\\\",\\\"li\\\",\\\"sec-8\\\",{\\\"children\\\":[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"#sec-8\\\",\\\"children\\\":\\\"延伸閱讀\\\"}]}]]}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"LearnArticle_body__6B7Mb\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"LearnArticle_intro__ATV5c\\\",\\\"children\\\":\\\"昨天新聞才說某國又對高科技業祭出「出口管制」，今天打開看盤軟體，手上好幾檔股票都綠油油的，到底發生了什麼事？其實，出口管制就像是國際貿易的紅綠燈，搞懂規則，你就能避開重災區，甚至提前看到轉彎的機會。\\\"}],[],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"LearnArticle_tldr__Br5BY\\\",\\\"children\\\":[[\\\"$\\\",\\\"b\\\",null,{\\\"className\\\":\\\"LearnArticle_tldrTitle__K5PBN\\\",\\\"children\\\":\\\"本文重點\\\"}],[\\\"$\\\",\\\"ul\\\",null,{\\\"className\\\":\\\"LearnArticle_tldrList__VSc2_\\\",\\\"children\\\":[[\\\"$\\\",\\\"li\\\",\\\"0\\\",{\\\"children\\\":\\\"出口管制是國家級貿易政策，直接影響特定高科技產業的原料與成品進出口。\\\"}],[\\\"$\\\",\\\"li\\\",\\\"1\\\",{\\\"children\\\":\\\"想判斷持股受影響多大，先去翻財報，看它的「主要銷售地區」是否就在管制名單上。\\\"}],[\\\"$\\\",\\\"li\\\",\\\"2\\\",{\\\"children\\\":\\\"壞消息中也藏著機會，注意不受管制的同業，是否有因客戶避險而來的「轉單效應」。\\\"}],[\\\"$\\\",\\\"li\\\",\\\"3\\\",{\\\"children\\\":\\\"短期股價會因恐慌而波動，但長期要看公司能否快速找到新客戶或打入新市場。\\\"}]]}]]}],[[\\\"$\\\",\\\"section\\\",\\\"sec-1\\\",{\\\"id\\\":\\\"sec-1\\\",\\\"className\\\":\\\"LearnArticle_section__hLVjU\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"LearnArticle_h2__NmJ08\\\",\\\"children\\\":\\\"一、什麼是出口管制？為什麼殺傷力這麼大？\\\"}],[[\\\"$\\\",\\\"p\\\",\\\"0\\\",{\\\"className\\\":\\\"LearnArticle_p__aZlQ1\\\",\\\"children\\\":\\\"簡單來說，「出口管制」就是一個國家規定，某些特定的商品或技術，不能賣到指定的國家或公司。這通常不是經濟因素，而是基於國家安全或外交政策。它就像一道精準的命令，直接切斷供應鏈的某一環，例如禁止含有某國技術的晶片賣給特定公司，這會讓下游的手機、電腦廠立刻面臨斷料，整個產線都可能停擺，殺傷力自然非常大。\\\"}]]]}],[\\\"$\\\",\\\"section\\\",\\\"sec-2\\\",{\\\"id\\\":\\\"sec-2\\\",\\\"className\\\":\\\"LearnArticle_section__hLVjU\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"LearnArticle_h2__NmJ08\\\",\\\"children\\\":\\\"二、我的股票會不會受影響？從財報銷售地區找答案\\\"}],[[\\\"$\\\",\\\"p\\\",\\\"0\\\",{\\\"className\\\":\\\"LearnArticle_p__aZlQ1\\\",\\\"children\\\":\\\"聽到管制消息，別急著自己嚇自己。最直接的方法，是去找出你持股公司的「公開財報」或「法說會簡報」。裡面通常會有一頁揭露「銷售地區分佈」。假設 A 公司有 60% 的營收來自中國市場，而這次美國的出口管制正好就是針對銷往中國的 AI 晶片，那 A 公司的衝擊肯定很大。反之，如果 B 公司的市場集中在歐美，那這次的事件對它可能就只是隔岸觀火。\\\"}],[\\\"$\\\",\\\"ol\\\",\\\"1\\\",{\\\"className\\\":\\\"LearnArticle_listNum__86N5S\\\",\\\"children\\\":[[\\\"$\\\",\\\"li\\\",\\\"0\\\",{\\\"children\\\":\\\"打開公司的最新一季財報。\\\"}],[\\\"$\\\",\\\"li\\\",\\\"1\\\",{\\\"children\\\":\\\"尋找「各地區之收入」或類似的表格。\\\"}],[\\\"$\\\",\\\"li\\\",\\\"2\\\",{\\\"children\\\":\\\"確認「受管制地區」佔總營收的比例有多高？超過 30% 就要特別警覺。\\\"}]]}]]]}],[\\\"$\\\",\\\"section\\\",\\\"sec-3\\\",{\\\"id\\\":\\\"sec-3\\\",\\\"className\\\":\\\"LearnArticle_section__hLVjU\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"LearnArticle_h2__NmJ08\\\",\\\"children\\\":\\\"三、直接衝擊 vs. 間接影響，一張表看懂差異\\\"}],[[\\\"$\\\",\\\"p\\\",\\\"0\\\",{\\\"className\\\":\\\"LearnArticle_p__aZlQ1\\\",\\\"children\\\":\\\"出口管制的影響有分兩種，一種是直接被點名的「重災戶」，另一種是看似無關卻被掃到颱風尾的「周邊鄰居」。直接衝擊很明確，就是產品不能賣了；但間接影響更需要留意，因為你的客戶的客戶可能才是被管制對象，訂單會逐層萎縮，等你發現時，營收已經下滑了。了解這兩者的差異，能幫助你更全面地評估風險。\\\"}],[\\\"$\\\",\\\"div\\\",\\\"1\\\",{\\\"className\\\":\\\"LearnArticle_tblScroll__z9kbb\\\",\\\"children\\\":[\\\"$\\\",\\\"table\\\",null,{\\\"className\\\":\\\"LearnArticle_tbl__0yNgv\\\",\\\"children\\\":[[\\\"$\\\",\\\"thead\\\",null,{\\\"children\\\":[\\\"$\\\",\\\"tr\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"th\\\",\\\"0\\\",{\\\"children\\\":\\\"影響類型\\\"}],[\\\"$\\\",\\\"th\\\",\\\"1\\\",{\\\"children\\\":\\\"說明\\\"}],[\\\"$\\\",\\\"th\\\",\\\"2\\\",{\\\"children\\\":\\\"舉例（用產業別，非個股）\\\"}]]}]}],[\\\"$\\\",\\\"tbody\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"tr\\\",\\\"0\\\",{\\\"children\\\":[[\\\"$\\\",\\\"td\\\",\\\"0\\\",{\\\"children\\\":\\\"直接衝擊\\\"}],[\\\"$\\\",\\\"td\\\",\\\"1\\\",{\\\"children\\\":\\\"公司的產品或技術，直接被禁止出口到特定國家或企業。\\\"}],[\\\"$\\\",\\\"td\\\",\\\"2\\\",{\\\"children\\\":\\\"台灣的 IC 設計公司，主要客戶是名單上的中國手機品牌。\\\"}]]}],[\\\"$\\\",\\\"tr\\\",\\\"1\\\",{\\\"children\\\":[[\\\"$\\\",\\\"td\\\",\\\"0\\\",{\\\"children\\\":\\\"間接衝擊\\\"}],[\\\"$\\\",\\\"td\\\",\\\"1\\\",{\\\"children\\\":\\\"公司的客戶因出口管制導致訂單減少，進而減少對公司的採購量。\\\"}],[\\\"$\\\",\\\"td\\\",\\\"2\\\",{\\\"children\\\":\\\"台灣的晶圓代工廠，其美國客戶的高階晶片被禁止賣到中國。\\\"}]]}],[\\\"$\\\",\\\"tr\\\",\\\"2\\\",{\\\"children\\\":[\\\"$L18\\\",\\\"$L19\\\",\\\"$L1a\\\"]}]]}]]}]}],\\\"$L1b\\\"]]}],\\\"$L1c\\\",\\\"$L1d\\\",\\\"$L1e\\\",\\\"$L1f\\\",\\\"$L20\\\"],null]}]]}]}]\\n\"])</script><script>self.__next_f.push([1,\"18:[\\\"$\\\",\\\"td\\\",\\\"0\\\",{\\\"children\\\":\\\"轉單效益\\\"}]\\n19:[\\\"$\\\",\\\"td\\\",\\\"1\\\",{\\\"children\\\":\\\"競爭對手被管制，客戶為了分散風險，將訂單轉移到自家公司。\\\"}]\\n1a:[\\\"$\\\",\\\"td\\\",\\\"2\\\",{\\\"children\\\":\\\"中國的某設備零件廠被管制，全球客戶轉向台灣同類型廠商下單。\\\"}]\\n1b:[\\\"$\\\",\\\"figure\\\",\\\"2\\\",{\\\"className\\\":\\\"LearnArticle_fig__uoT7r\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"LearnArticle_figFrame__jJ7E4\\\",\\\"children\\\":\\\"✓尋找潛在轉單效應✓關注國產替代趨勢✓布局新供應鏈受惠者\\\"}],[\\\"$\\\",\\\"figcaption\\\",null,{\\\"className\\\":\\\"LearnArticle_figCap__LnUbb\\\",\\\"children\\\":\\\"出口管制下的機會點\\\"}]]}]\\n1c:[\\\"$\\\",\\\"section\\\",\\\"sec-4\\\",{\\\"id\\\":\\\"sec-4\\\",\\\"className\\\":\\\"LearnArticle_section__hLVjU\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"LearnArticle_h2__NmJ08\\\",\\\"children\\\":\\\"四、危機就是轉機？看懂「轉單效應」與「國產替代」\\\"}],[[\\\"$\\\",\\\"p\\\",\\\"0\\\",{\\\"className\\\":\\\"LearnArticle_p__aZlQ1\\\",\\\"children\\\":\\\"有壞事，通常也會有好事發生。當原本的龍頭廠商被限制出貨，它空出來的市佔率，就是其他廠商的機會，這就是「轉單效應」。客戶為了確保供應穩定，會開始尋找第二、第三供應商，不受管制的台灣廠商就可能因此受惠。另一個趨勢是「國產替代」，被管制的國家為了擺脫依賴，會大力扶植本土供應鏈，這也可能為切入該市場的台廠帶來新的成長動能。\\\"}],[\\\"$\\\",\\\"ul\\\",\\\"1\\\",{\\\"className\\\":\\\"LearnArticle_listCheck__xx1CF\\\",\\\"children\\\":[[\\\"$\\\",\\\"li\\\",\\\"0\\\",{\\\"children\\\":\\\"觀察同產業中，沒被管制的公司股價是否相對強勢。\\\"}],[\\\"$\\\",\\\"li\\\",\\\"1\\\",{\\\"children\\\":\\\"留意財經新聞是否提到「客戶轉單」、「供應商認證」等關鍵字。\\\"}],[\\\"$\\\",\\\"li\\\",\\\"2\\\",{\\\"children\\\":\\\"營收是最好的證明，追蹤受惠公司的月營收年增率是否開始攀升。\\\"}]]}]]]}]\\n1d:[\\\"$\\\",\\\"section\\\",\\\"sec-5\\\",{\\\"id\\\":\\\"sec-5\\\",\\\"className\\\":\\\"LearnArticle_section__hLVjU\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"LearnArticle_h2__NmJ08\\\",\\\"children\\\":\\\"五、股價反應過度了嗎？從籌碼面判斷市場情緒\\\"}],[[\\\"$\"])</script><script>self.__next_f.push([1,\"\\\",\\\"p\\\",\\\"0\\\",{\\\"className\\\":\\\"LearnArticle_p__aZlQ1\\\",\\\"children\\\":\\\"消息剛出來時，市場情緒往往會過度反應，股價可能因為恐慌而超跌，如上圖的 K 線所示。這時候，單看價格不準，要搭配籌碼一起看。如果股價大跌，但發現外資、投信等大戶並沒有跟著大量賣出，甚至還在默默承接，這可能代表他們認為衝擊是短期的，或股價已經跌到合理價值。反之，若法人也跟著倒貨，那就要小心後續可能還有低點。\\\"}]]]}]\\n\"])</script><script>self.__next_f.push([1,\"1e:[\\\"$\\\",\\\"section\\\",\\\"sec-6\\\",{\\\"id\\\":\\\"sec-6\\\",\\\"className\\\":\\\"LearnArticle_section__hLVjU\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"LearnArticle_h2__NmJ08\\\",\\\"children\\\":\\\"常見問題 FAQ\\\"}],[[\\\"$\\\",\\\"div\\\",\\\"0\\\",{\\\"className\\\":\\\"LearnArticle_faq__cemBp\\\",\\\"children\\\":[[\\\"$\\\",\\\"details\\\",\\\"0\\\",{\\\"className\\\":\\\"LearnArticle_faqItem__I9h0U\\\",\\\"children\\\":[[\\\"$\\\",\\\"summary\\\",null,{\\\"children\\\":\\\"出口管制消息一出來，手上的股票就要馬上賣掉嗎？\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"LearnArticle_faqA__IPuvc\\\",\\\"children\\\":\\\"不一定。建議先花點時間判斷是短期情緒影響，還是長期結構問題。如果公司基本面良好，且受影響佔比不高，恐慌性賣壓有時反而是觀察的機會點。\\\"}]]}],[\\\"$\\\",\\\"details\\\",\\\"1\\\",{\\\"className\\\":\\\"LearnArticle_faqItem__I9h0U\\\",\\\"children\\\":[[\\\"$\\\",\\\"summary\\\",null,{\\\"children\\\":\\\"這些公司銷售地區的資訊要去哪裡查？\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"LearnArticle_faqA__IPuvc\\\",\\\"children\\\":\\\"最可靠的來源是公司的官方網站，通常在「投資人關係」專區可以找到最新的季度財報或年度報告。這些都是法規要求必須公開的資訊。\\\"}]]}],[\\\"$\\\",\\\"details\\\",\\\"2\\\",{\\\"className\\\":\\\"LearnArticle_faqItem__I9h0U\\\",\\\"children\\\":[[\\\"$\\\",\\\"summary\\\",null,{\\\"children\\\":\\\"「轉單效應」通常多久才會反應在股價或營收上？\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"LearnArticle_faqA__IPuvc\\\",\\\"children\\\":\\\"市場預期會跑在最前面，消息一出，相關受惠股的股價可能就會先動。但訂單轉移、產線調整到真正反應在營收財報上，通常需要一到兩季的時間發酵。\\\"}]]}],[\\\"$\\\",\\\"details\\\",\\\"3\\\",{\\\"className\\\":\\\"LearnArticle_faqItem__I9h0U\\\",\\\"children\\\":[[\\\"$\\\",\\\"summary\\\",null,{\\\"children\\\":\\\"只有美國會實施出口管制嗎？\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"LearnArticle_faqA__IPuvc\\\",\\\"children\\\":\\\"不是的。任何國家都可以基於其國家利益實施出口管制，例如日本、荷蘭也曾配合實施半導體設備的管制。但目前市場最關注的，仍是美國對高科技產業的政策動向。\\\"}]]}]]}]]]}]\\n\"])</script><script>self.__next_f.push([1,\"1f:[\\\"$\\\",\\\"section\\\",\\\"sec-7\\\",{\\\"id\\\":\\\"sec-7\\\",\\\"className\\\":\\\"LearnArticle_section__hLVjU\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"LearnArticle_h2__NmJ08\\\",\\\"children\\\":\\\"總結\\\"}],[[\\\"$\\\",\\\"p\\\",\\\"0\\\",{\\\"className\\\":\\\"LearnArticle_p__aZlQ1\\\",\\\"children\\\":\\\"面對出口管制，不要只看新聞標題就急著買賣。學會花三分鐘檢視公司的銷售地區，評估衝擊是直接還是間接，並思考有沒有轉單機會，你就能在市場恐慌時，做出更冷靜的判斷。\\\"}]]]}]\\n20:[\\\"$\\\",\\\"section\\\",\\\"sec-8\\\",{\\\"id\\\":\\\"sec-8\\\",\\\"className\\\":\\\"LearnArticle_section__hLVjU\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"LearnArticle_h2__NmJ08\\\",\\\"children\\\":\\\"延伸閱讀\\\"}],[[\\\"$\\\",\\\"ul\\\",\\\"0\\\",{\\\"className\\\":\\\"LearnArticle_list__WjxqC\\\",\\\"children\\\":[[\\\"$\\\",\\\"li\\\",\\\"0\\\",{\\\"children\\\":[[\\\"$\\\",\\\"$L17\\\",\\\"0-從「族群透視」看\\\",{\\\"href\\\":\\\"/diary\\\",\\\"className\\\":\\\"LearnArticle_link__gMwHV\\\",\\\"children\\\":\\\"從「族群透視」看懂產業連動\\\"}]]}],[\\\"$\\\",\\\"li\\\",\\\"1\\\",{\\\"children\\\":[[\\\"$\\\",\\\"$L17\\\",\\\"0-每天三分鐘，掌握\\\",{\\\"href\\\":\\\"/diary\\\",\\\"className\\\":\\\"LearnArticle_link__gMwHV\\\",\\\"children\\\":\\\"每天三分鐘，掌握市場大事\\\"}]]}],[\\\"$\\\",\\\"li\\\",\\\"2\\\",{\\\"children\\\":[[\\\"$\\\",\\\"$L17\\\",\\\"0-更多股市名詞解釋\\\",{\\\"href\\\":\\\"/school\\\",\\\"className\\\":\\\"LearnArticle_link__gMwHV\\\",\\\"children\\\":\\\"更多股市名詞解釋，都在台股學堂\\\"}]]}]]}]]]}]\\n\"])</script><script>self.__next_f.push([1,\"13:[[\\\"$\\\",\\\"meta\\\",\\\"0\\\",{\\\"charSet\\\":\\\"utf-8\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"1\\\",{\\\"name\\\":\\\"viewport\\\",\\\"content\\\":\\\"width=device-width, initial-scale=1\\\"}]]\\nf:null\\n\"])</script><script>self.__next_f.push([1,\"21:I[80622,[],\\\"IconMark\\\"]\\n11:{\\\"metadata\\\":[[\\\"$\\\",\\\"title\\\",\\\"0\\\",{\\\"children\\\":\\\"出口管制是什麼？為什麼新聞一報我的股票就跌？3 步驟看懂供應鏈影響｜股市大佬 TradeBoss\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"1\\\",{\\\"name\\\":\\\"description\\\",\\\"content\\\":\\\"昨天新聞才說某國又對高科技業祭出「出口管制」，今天打開看盤軟體，手上好幾檔股票都綠油油的，到底發生了什麼事？其實，出口管制就像是國際貿易的紅綠燈，搞懂規則，你就能避開重災區，甚至提前看到轉彎的機會。\\\"}],[\\\"$\\\",\\\"link\\\",\\\"2\\\",{\\\"rel\\\":\\\"icon\\\",\\\"href\\\":\\\"/favicon.ico\\\",\\\"type\\\":\\\"image/x-icon\\\",\\\"sizes\\\":\\\"16x16\\\"}],[\\\"$\\\",\\\"$L21\\\",\\\"3\\\",{}]],\\\"error\\\":null,\\\"digest\\\":\\\"$undefined\\\"}\\n\"])</script><script>self.__next_f.push([1,\"16:\\\"$11:metadata\\\"\\n\"])</script></body></html>","rsc":"1:\"$Sreact.fragment\"\n2:I[81259,[\"2619\",\"static/chunks/2619-04bc32f026a0d946.js\",\"7177\",\"static/chunks/app/layout-4382c12d510386d3.js\"],\"default\"]\n3:I[89379,[\"2619\",\"static/chunks/2619-04bc32f026a0d946.js\",\"7177\",\"static/chunks/app/layout-4382c12d510386d3.js\"],\"default\"]\n4:I[9766,[],\"\"]\n5:I[98924,[],\"\"]\n6:I[10021,[\"2619\",\"static/chunks/2619-04bc32f026a0d946.js\",\"7177\",\"static/chunks/app/layout-4382c12d510386d3.js\"],\"default\"]\n7:I[10528,[\"2619\",\"static/chunks/2619-04bc32f026a0d946.js\",\"7177\",\"static/chunks/app/layout-4382c12d510386d3.js\"],\"default\"]\n8:I[50861,[\"2619\",\"static/chunks/2619-04bc32f026a0d946.js\",\"7177\",\"static/chunks/app/layout-4382c12d510386d3.js\"],\"default\"]\nc:I[57150,[],\"\"]\n:HL[\"/_next/static/media/3d26d2f3aa81a833-s.p.woff2\",\"font\",{\"crossOrigin\":\"\",\"type\":\"font/woff2\"}]\n:HL[\"/_next/static/media/604a121a6fa1a135-s.p.woff2\",\"font\",{\"crossOrigin\":\"\",\"type\":\"font/woff2\"