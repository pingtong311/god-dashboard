e\",null,{\"children\":[\"$Lf\",[\"$\",\"$L10\",null,{\"promise\":\"$@11\"}]]}]]}]\nb:[\"$\",\"$1\",\"h\",{\"children\":[null,[[\"$\",\"$L12\",null,{\"children\":\"$L13\"}],[\"$\",\"meta\",null,{\"name\":\"next-size-adjust\",\"content\":\"\"}]],[\"$\",\"$L14\",null,{\"children\":[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$15\",null,{\"fallback\":null,\"children\":\"$L16\"}]}]}]]}]\n17:I[52619,[\"2619\",\"static/chunks/2619-04bc32f026a0d946.js\",\"6309\",\"static/chunks/app/learn/%5Bslug%5D/page-f7b99344f7e2ee16.js\"],\"\"]\nd:[\"$\",\"div\",null,{\"className\":\"LearnArticle_wrap__LIQ8G\",\"children\":[\"$\",\"article\",null,{\"className\":\"LearnArticle_article__2nBbk\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_meta__etj_G\",\"children\":[[\"$\",\"$L17\",null,{\"className\":\"LearnArticle_cat__GQMlg\",\"href\":\"/learn?c=stories\",\"children\":\"人物與市場史\"}],[\"$\",\"span\",null,{\"className\":\"LearnArticle_read__QEj6a\",\"children\":\"閱讀約 6 分鐘\"}]]}],[\"$\",\"h1\",null,{\"className\":\"LearnArticle_title__0_la8\",\"children\":\"全球頂尖交易員的共同習慣是什麼？揭密 5 個你也能學的紀律原則\"}],[\"$\",\"details\",null,{\"className\":\"LearnArticle_toc__LcSAa\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"LearnArticle_tocSummary__YBddG\",\"children\":\"本文目錄\"}],[\"$\",\"ol\",null,{\"className\":\"LearnArticle_tocList__Rq_Lz\",\"children\":[[\"$\",\"li\",\"sec-1\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-1\",\"children\":\"一、先有計畫，再進場：沒有劇本，不上台\"}]}],[\"$\",\"li\",\"sec-2\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-2\",\"children\":\"二、寫交易日誌：誠實面對自己的每一筆決策\"}]}],[\"$\",\"li\",\"sec-3\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-3\",\"children\":\"三、風險管理優先：想著能賠多少，而不是能賺多少\"}]}],[\"$\",\"li\",\"sec-4\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-4\",\"children\":\"四、專注賺賠比，而不是勝率：為何看錯比看對多還能賺錢？\"}]}],[\"$\",\"li\",\"sec-5\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-5\",\"children\":\"五、持續學習與適應：市場永遠在變，沒有聖杯\"}]}],[\"$\",\"li\",\"sec-6\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-6\",\"children\":\"常見問題 FAQ\"}]}],[\"$\",\"li\",\"sec-7\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-7\",\"children\":\"總結\"}]}],[\"$\",\"li\",\"sec-8\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-8\",\"children\":\"延伸閱讀\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"LearnArticle_body__6B7Mb\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_intro__ATV5c\",\"children\":\"常常覺得交易很靠運氣，賺錢是矇到的，賠錢又不知道錯在哪？看著市場上那些成功的交易員，好像他們總有什麼秘密武器。其實，他們成功的基石不是神秘指標，而是一些樸實但嚴格執行的習慣。這篇就是要拆解這些習慣，讓你也能建立自己的交易紀律。\"}],[],[\"$\",\"div\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"頂尖交易員的核心不是預測市場，而是擁有一套應對計畫與嚴格的風險管理。\"}],[\"$\",\"li\",\"1\",{\"children\":\"交易日誌不只記賺賠，更要記錄進出場理由與情緒，才能從錯誤中學習。\"}],[\"$\",\"li\",\"2\",{\"children\":\"賺錢的關鍵不在於每次都看對，而是讓賺的錢遠大於賠的錢，也就是「賺賠比」。\"}],[\"$\",\"li\",\"3\",{\"children\":\"他們接受虧損是交易的一部分，重點是控制虧損規模，而不是完全避免虧損。\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、先有計畫，再進場：沒有劇本，不上台\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"多數散戶是「看到漲了才追」，但頂尖交易員正好相反，他們在盤前或甚至前一天晚上，就已經寫好了劇本。這個劇本包含：在什麼條件下進場？預計在哪裡停利？以及最重要的，如果看錯了，底線在哪裡必須出場停損？這份計畫讓他們在盤中面對價格跳動時，能依據計畫行動，而不是被情緒牽著走。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"明確的進場條件：例如突破某個價位、出現特定 K 線型態。\"}],[\"$\",\"li\",\"1\",{\"children\":\"預設的出場點：包含停利與停損，不能有任何模糊空間。\"}],[\"$\",\"li\",\"2\",{\"children\":\"計算好的部位大小：根據停損點與個人能承受的風險，決定要買多少。\"}]]}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、寫交易日誌：誠實面對自己的每一筆決策\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"如果你問一個成功的交易員他最重要的工具是什麼，答案很可能不是看盤軟體，而是他的「交易日誌」。這不只是簡單記下股票代號跟賺賠金額，更重要的是記錄「為什麼」做這筆交易、當下的市場氣氛、自己的情緒狀態，以及事後回顧這筆交易哪裡做得好、哪裡能改進。這就像運動員看比賽錄影帶一樣，是為了找出盲點、持續優化。\"}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、風險管理優先：想著能賠多少，而不是能賺多少\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"新手進場前，滿腦子想的都是「這檔會不會漲一倍」，但專業交易員想的第一件事是「如果我看錯了，最多會賠多少錢？」他們極度重視本金安全，會透過嚴格的部位控管與停損，確保任何單一筆虧損都不會造成毀滅性打擊。例如，他們會設定單筆交易的虧損上限，可能是總資金的 1% 或 2%，一旦觸及就果斷離場，絕不猶豫。\"}],[\"$\",\"figure\",\"1\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"✓紀律大於情緒✓接受虧損是常態✓專注於執行✓持續學習不自滿\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"頂尖交易員的心理素質\"}]]}]]]}],[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、專注賺賠比，而不是勝率：為何看錯比看對多還能賺錢？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"很多人有個迷思，以為頂尖交易員的預測準確率很高，可能十次有八次都看對。但事實上，很多成功策略的勝率甚至不到 50%。他們能長期獲利的關鍵在於「賺賠比」，也就是平均每次賺錢的金額，遠大於平均每次賠錢的金額。一筆大的獲利，可以抵銷掉好幾筆小虧損，這才是長期在市場存活的數學基礎。\"}],\"$L18\"]]}],\"$L19\",\"$L1a\",\"$L1b\",\"$L1c\"],null]}]]}]}]\n18:[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"特徵\"}],[\"$\",\"th\",\"1\",{\"children\":\"專注勝率的散戶思維\"}],[\"$\",\"th\",\"2\",{\"children\":\"專注賺賠比的交易員思維\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"目標\"}],[\"$\",\"td\",\"1\",{\"children\":\"這次一定要看對\"}],[\"$\",\"td\",\"2\",{\"children\":\"長期下來帳戶要成長\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"虧損時\"}],[\"$\",\"td\",\"1\",{\"children\":\"期待反彈解套，不願停損\"}],[\"$\",\"td\",\"2\",{\"children\":\"執行計畫，保留本金\"}]]}],[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"獲利時\"}],[\"$\",\"td\",\"1\",{\"children\":\"賺一點就跑，怕獲利回吐\"}],[\"$\",\"td\",\"2\",{\"children\":\"讓獲利奔跑，直到出場訊號出現\"}]]}],[\"$\",\"tr\",\"3\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"檢討重點\"}],[\"$\",\"td\",\"1\",{\"children\":\"「我怎麼又猜錯了？」\"}],[\"$\",\"td\",\"2\",{\"children\":\"「我的策略有確實執行嗎？」\"}]]}]]}]]}]}]\n19:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、持續學習與適應：市場永遠在變，沒有聖杯\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"沒有任何一個策略可以永遠適用所有行情。頂尖交易員非常清楚這點，所以他們從不停止學習。他們研究市場結構的改變、複盤自己的交易紀錄、閱讀相關的書籍與報告，並隨時準備調整自己的策略。他們把交易看作一門永無止境的技藝，不斷精進，而不是找到一個神奇公式後就一勞永逸。這種對市場的敬畏與謙虛，正是他們能長期維持優勢的原因。\"}]]]}]\n1a:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"頂尖交易員是不是都用很複雜的技術指標？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"不一定。許多成功的交易員用的工具非常簡單，例如 K 線、均線和成交量。重點不在於指標多神奇，而在於他們如何解讀資訊並結合自己的交易計畫與風險管理。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"他們是不是每天都花很多時間看盤？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"這取決於交易風格。當沖或短線交易者確實需要長時間盯盤，但波段或長線交易者可能更重視盤後的研究與規劃，盤中只在需要執行交易時才看盤。關鍵是「有品質」的投入，而不是時間長短。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"交易成功是不是天賦比努力更重要？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"紀律與情緒控制比天賦更重要。許多研究與訪談都顯示，頂尖交易員的共同點是極高的紀律性，他們能像機器人一樣執行自己的計畫，這點是後天可以刻意練習的。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"如果我沒辦法一直看盤，也能學習這些習慣嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"當然可以。這些習慣的核心是「計畫」與「紀律」，這與看盤時間長短無關。你可以發展一套適合自己作息的交易系統，例如以日 K 線收盤價做為決策依據的波段策略，同樣能應用這些原則。\"}]]}]]}]]]}]\n1b:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"成功的交易不是尋找單一的聖杯，而是建立一套包含進場、出場、風控與檢討的完整系統，並像機器一樣日復一日地執行它。\"}]]]}]\n1c:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L17\",\"0-想學習更多台股知\",{\"href\":\"/school\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"想學習更多台股知識？從台股學堂開始\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L17\",\"0-在真實進場前，先\",{\"href\":\"/sim\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"在真實進場前，先到練功房模擬練習\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L17\",\"0-看更多籌碼與量價\",{\"href\":\"/learn\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"看更多籌碼與量價教學文章\"}]]}]]}]]]}]\n13:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\nf:null\n1d:I[80622,[],\"IconMark\"]\n11:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"全球頂尖交易員的共同習慣是什麼？揭密 5 個你也能學的紀律原則｜股市大佬 TradeBoss\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"常常覺得交易很靠運氣，賺錢是矇到的，賠錢又不知道錯在哪？看著市場上那些成功的交易員，好像他們總有什麼秘密武器。其實，他們成功的基石不是神秘指標，而是一些樸實但嚴格執行的習慣。這篇就是要拆解這些習慣，讓你也能建立自己的交易紀律。\"}],[\"$\",\"link\",\"2\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}],[\"$\",\"$L1d\",\"3\",{}]],\"error\":null,\"digest\":\"$undefined\"}\n16:\"$11:metadata\"\n"}