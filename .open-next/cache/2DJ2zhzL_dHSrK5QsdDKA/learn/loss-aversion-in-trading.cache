":[[\"$\",\"summary\",null,{\"className\":\"LearnArticle_tocSummary__YBddG\",\"children\":\"本文目錄\"}],[\"$\",\"ol\",null,{\"className\":\"LearnArticle_tocList__Rq_Lz\",\"children\":[[\"$\",\"li\",\"sec-1\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-1\",\"children\":\"一、不對稱是預設，不是你比較弱\"}]}],[\"$\",\"li\",\"sec-2\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-2\",\"children\":\"二、它在帳戶上的兩張臉\"}]}],[\"$\",\"li\",\"sec-3\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-3\",\"children\":\"三、三個改法，都寫在進場前\"}]}],[\"$\",\"li\",\"sec-4\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-4\",\"children\":\"四、它跟攤平很常一組出現\"}]}],[\"$\",\"li\",\"sec-5\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-5\",\"children\":\"五、檢討時怎麼抓它\"}]}],[\"$\",\"li\",\"sec-6\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-6\",\"children\":\"常見問題 FAQ\"}]}],[\"$\",\"li\",\"sec-7\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-7\",\"children\":\"總結\"}]}],[\"$\",\"li\",\"sec-8\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-8\",\"children\":\"延伸閱讀\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"LearnArticle_body__6B7Mb\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_intro__ATV5c\",\"children\":\"帳面上賺一萬很開心，虧一萬卻常常整晚睡不好。這種不對稱有名字，叫損失趨避。它不是膽小，是大腦對損失更敏感。用在交易上，長相很固定：小賺就想落袋，大虧卻想等回來。意志力很難對抗它，因為痛是真的。比較有用的是先承認它，再把決定交給事前規則。\"}],[],[\"$\",\"div\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"虧損的主觀痛，通常大於同等獲利的快樂\"}],[\"$\",\"li\",\"1\",{\"children\":\"它會讓人早砍獲利、晚認賠，期望值被慢慢磨掉\"}],[\"$\",\"li\",\"2\",{\"children\":\"改法是把離場寫在進場前，不在痛的時候現場作文\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、不對稱是預設，不是你比較弱\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"研究與日常經驗都指向同一件事：失去的感覺，比得到更重。帳戶只認數字，大腦認痛。所以「我再給它一點時間」常常不是分析，是在延後痛。承認預設，你才不會把正常的人性當成自己特有的缺陷，然後用自責代替改規則。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"痛比快樂重是預設\"}],[\"$\",\"li\",\"1\",{\"children\":\"延後認賠常是在延後痛\"}],[\"$\",\"li\",\"2\",{\"children\":\"自責改不了預設，規則可以\"}]]}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、它在帳戶上的兩張臉\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"獲利部位一有風吹草動就走，因為你怕快樂被收回；虧損部位怎麼風吹都還在，因為認賠等於把痛做實。兩張臉加起來，就是一堆小賺與少數大虧。勝率看起來不差，期望值可能是負的。檢討若只看勝率，會覺得自己其實還可以，只是運氣差。\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"當下感覺\"}],[\"$\",\"th\",\"1\",{\"children\":\"常見動作\"}],[\"$\",\"th\",\"2\",{\"children\":\"對期望值\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"小賺但不穩\"}],[\"$\",\"td\",\"1\",{\"children\":\"先走，落袋為安\"}],[\"$\",\"td\",\"2\",{\"children\":\"截斷右尾\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"小虧但有希望\"}],[\"$\",\"td\",\"1\",{\"children\":\"再等一等\"}],[\"$\",\"td\",\"2\",{\"children\":\"讓虧損變大\"}]]}],[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"大虧已經痛了\"}],[\"$\",\"td\",\"1\",{\"children\":\"更不敢做實\"}],[\"$\",\"td\",\"2\",{\"children\":\"單筆風險失控\"}]]}],[\"$\",\"tr\",\"3\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"勝率還行\"}],[\"$\",\"td\",\"1\",{\"children\":\"以為方法沒問題\"}],[\"$\",\"td\",\"2\",{\"children\":\"忽略平均虧大於平均賺\"}]]}]]}]]}]}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、三個改法，都寫在進場前\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"第一，虧損上限用金額或比例寫死，碰到就走，不現場投票。第二，獲利不是靠感覺抱，是靠你事先寫的移動條件或時間條件。第三，單筆虧損上限要小到「執行時仍痛，但不至於讓你想改規則」。規則太痛，你還是會在當下廢掉它。\"}],[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"寫死虧損上限\"}],[\"$\",\"li\",\"1\",{\"children\":\"寫獲利怎麼管，不靠心情\"}],[\"$\",\"li\",\"2\",{\"children\":\"上限要小到你真的做得到\"}]]}],[\"$\",\"figure\",\"2\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"✓虧損上限✓獲利怎麼管✓痛了仍做得到\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"進場前寫好\"}]]}]]]}],\"$L18\",\"$L19\",\"$L1a\",\"$L1b\",\"$L1c\"],\"$L1d\"]}]]}]}]\n18:[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、它跟攤平很常一組出現\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"攤平是損失趨避的行動版：與其做實虧損，不如再買一次把平均成本拉近現價，讓痛看起來比較小。數字上你可能只是把風險加倍。攤平那篇講過危險；這裡補一句：先處理痛，再處理策略。痛沒被規則接住，任何加碼故事都很好聽。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"攤平常是為了讓痛看起來較小\"}],[\"$\",\"li\",\"1\",{\"children\":\"平均成本下降≠風險下降\"}],[\"$\",\"li\",\"2\",{\"children\":\"先執行認賠規則，再討論要不要另開新單\"}]]}]]]}]\n19:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、檢討時怎麼抓它\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"翻日誌，找兩種單：很快離開的小賺，以及拖很久的虧。若這兩種特別多，損失趨避就在值班。不要寫「我要更勇敢」，要寫「這類單的離開條件改成什麼」。勇敢沒有檢查點，條件有。\"}]]]}]\n1a:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"落袋為安不對嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"可以是規則。問題是它若只發生在小賺、大虧卻從不落袋，那是偏誤，不是風格。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"停損是不是就是在對抗它？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"停損是工具。沒寫在進場前、或寫了當下廢掉，工具就不在。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"用智慧單有沒有用？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"有助於把決定提前。它解決的是執行，不是讓痛消失。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"虧損變大時更不敢走，怎麼辦？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"當下通常走不動。所以上限要設在還走得動的地方，並用小部位讓痛不至於鎖死。\"}]]}]]}]]]}]\n1b:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"損失趨避讓人早砍獲利、晚認賠。改的是進場前的上限與離開條件，不是當下的勇氣。勝率看起來可以，期望值仍可能被磨掉。\"}]]]}]\n1c:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L17\",\"0-攤平為什麼危險\",{\"href\":\"/learn/why-averaging-down-is-risky\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"攤平為什麼危險\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L17\",\"0-為什麼抱不住賺錢\",{\"href\":\"/learn/why-you-cant-hold-winners\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"為什麼抱不住賺錢的部位\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L17\",\"0-智慧單在解決什麼\",{\"href\":\"/learn/why-conditional-orders-matter\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"智慧單在解決什麼\"}]]}]]}]]]}]\n1d:[\"$\",\"div\",null,{\"className\":\"LearnArticle_related__9qV55\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_relatedTitle__RXfrl\",\"children\":\"相關文章\"}],[[\"$\",\"$L17\",\"why-averaging-down-is-risky\",{\"href\":\"/learn/why-averaging-down-is-risky\",\"className\":\"LearnArticle_relatedLink__mibXe\",\"children\":\"攤平為什麼危險\"}],[\"$\",\"$L17\",\"why-you-cant-hold-winners\",{\"href\":\"/learn/why-you-cant-hold-winners\",\"className\":\"LearnArticle_relatedLink__mibXe\",\"children\":\"為什麼抱不住賺錢的部位\"}],[\"$\",\"$L17\",\"why-conditional-orders-matter\",{\"href\":\"/learn/why-conditional-orders-matter\",\"className\":\"LearnArticle_relatedLink__mibXe\",\"children\":\"智慧單在解決什麼\"}]]]}]\n13:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\nf:null\n1e:I[80622,[],\"IconMark\"]\n11:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"損失趨避為什麼讓你抱虧砍盈？3個改法比意志力有用｜股市大佬 TradeBoss\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"帳面上賺一萬很開心，虧一萬卻常常整晚睡不好。這種不對稱有名字，叫損失趨避。它不是膽小，是大腦對損失更敏感。用在交易上，長相很固定：小賺就想落袋，大虧卻想等回來。意志力很難對抗它，因為痛是真的。比較有用的是先承認它，再把決定交給事前規則。\"}],[\"$\",\"link\",\"2\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}],[\"$\",\"$L1e\",\"3\",{}]],\"error\":null,\"digest\":\"$undefined\"}\n16:\"$11:metadata\"\n"}