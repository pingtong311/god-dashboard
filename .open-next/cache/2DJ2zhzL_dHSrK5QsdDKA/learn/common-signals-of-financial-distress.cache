t\":\"\"}]],[\"$\",\"$L14\",null,{\"children\":[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$15\",null,{\"fallback\":null,\"children\":\"$L16\"}]}]}]]}]\n17:I[52619,[\"2619\",\"static/chunks/2619-04bc32f026a0d946.js\",\"6309\",\"static/chunks/app/learn/%5Bslug%5D/page-f7b99344f7e2ee16.js\"],\"\"]\nd:[\"$\",\"div\",null,{\"className\":\"LearnArticle_wrap__LIQ8G\",\"children\":[\"$\",\"article\",null,{\"className\":\"LearnArticle_article__2nBbk\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_meta__etj_G\",\"children\":[[\"$\",\"$L17\",null,{\"className\":\"LearnArticle_cat__GQMlg\",\"href\":\"/learn?c=events\",\"children\":\"金融大事件\"}],[\"$\",\"span\",null,{\"className\":\"LearnArticle_read__QEj6a\",\"children\":\"閱讀約 7 分鐘\"}]]}],[\"$\",\"h1\",null,{\"className\":\"LearnArticle_title__0_la8\",\"children\":\"財務危機常見訊號有哪些？4 個警訊教你避開地雷股\"}],[\"$\",\"details\",null,{\"className\":\"LearnArticle_toc__LcSAa\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"LearnArticle_tocSummary__YBddG\",\"children\":\"本文目錄\"}],[\"$\",\"ol\",null,{\"className\":\"LearnArticle_tocList__Rq_Lz\",\"children\":[[\"$\",\"li\",\"sec-1\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-1\",\"children\":\"一、為什麼不能只看 EPS？小心「帳面好看」的陷阱\"}]}],[\"$\",\"li\",\"sec-2\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-2\",\"children\":\"二、公司欠了多少錢？從「負債比」看財務結構\"}]}],[\"$\",\"li\",\"sec-3\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-3\",\"children\":\"三、公司真的有賺到現金嗎？「營業現金流」是照妖鏡\"}]}],[\"$\",\"li\",\"sec-4\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-4\",\"children\":\"四、內部人最知道！從「董監持股」變化看端倪\"}]}],[\"$\",\"li\",\"sec-5\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-5\",\"children\":\"五、除了財報數字，還有哪些場外訊號要注意？\"}]}],[\"$\",\"li\",\"sec-6\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-6\",\"children\":\"常見問題 FAQ\"}]}],[\"$\",\"li\",\"sec-7\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-7\",\"children\":\"總結\"}]}],[\"$\",\"li\",\"sec-8\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-8\",\"children\":\"延伸閱讀\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"LearnArticle_body__6B7Mb\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_intro__ATV5c\",\"children\":\"看到股票一直跌，心裡很慌，但又不知道問題出在哪？等到新聞爆出公司周轉不靈，股價早就來不及反應了。其實，在危機發生前，通常會有一些徵兆浮現。這篇文章就是要教你從公開資料中，找出 4 個簡單的財務危機訊號，保護你的投資組合。\"}],[],[\"$\",\"div\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"連續虧損是警訊：注意營業利益率是否連續數季為負值，這代表本業正在失血。\"}],[\"$\",\"li\",\"1\",{\"children\":\"檢查公司的負債比例：一般來說，負債佔總資產超過 60% 就要提高警覺。\"}],[\"$\",\"li\",\"2\",{\"children\":\"現金流比帳面獲利重要：營業現金流若長期為負，代表公司收不回現金，營運風險高。\"}],[\"$\",\"li\",\"3\",{\"children\":\"觀察大股東動向：董監事持股連續大賣，或股票質押比例過高，都是危險訊號。\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、為什麼不能只看 EPS？小心「帳面好看」的陷阱\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"很多投資人習慣用 EPS（每股盈餘）來判斷公司賺不賺錢，但這很容易掉入陷阱。因為公司可能靠變賣土地、廠房等一次性收入來美化財報，讓 EPS 看起來很高，但這並非來自本業的穩定獲利。要看公司本業是否健康，更應該關注「營業利益率」，它反映了公司靠主營業務賺錢的真實能力。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"判斷方法：檢查「營業利益率」是否連續 2-3 季為負數。如果一家公司長期無法從本業賺錢，只靠業外收入支撐，那就像一個不斷失血的人，財務狀況非常危險。\"}]]}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、公司欠了多少錢？從「負債比」看財務結構\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"想像一下，如果一個人的收入不穩定，又背負高額貸款，是不是風險很高？公司也是一樣。「負債比」（總負債 ÷ 總資產）這個指標，可以讓我們看出一家公司營運的資金有多少是借來的。過高的負債比代表公司利息壓力沉重，一旦景氣反轉或銀行抽銀根，就可能爆發週轉危機。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"判斷門檻：一般製造業的負債比若長期高於 60%，就算警戒水位。當然，不同產業特性不同，但這個數字是一個很好的初步篩選標準。\"}]]}],[\"$\",\"div\",\"2\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"項目\"}],[\"$\",\"th\",\"1\",{\"children\":\"體質穩健的公司 A\"}],[\"$\",\"th\",\"2\",{\"children\":\"高風險的公司 B\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"總資產\"}],[\"$\",\"td\",\"1\",{\"children\":\"100 億元\"}],[\"$\",\"td\",\"2\",{\"children\":\"100 億元\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"總負債\"}],[\"$\",\"td\",\"1\",{\"children\":\"40 億元\"}],[\"$\",\"td\",\"2\",{\"children\":\"75 億元\"}]]}],[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"負債比率\"}],[\"$\",\"td\",\"1\",{\"children\":\"40%\"}],[\"$\",\"td\",\"2\",{\"children\":\"75%\"}]]}],[\"$\",\"tr\",\"3\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"潛在風險\"}],[\"$\",\"td\",\"1\",{\"children\":\"財務結構健康，有足夠緩衝空間\"}],[\"$\",\"td\",\"2\",{\"children\":\"利息壓力沉重，週轉風險極高\"}]]}]]}]]}]}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、公司真的有賺到現金嗎？「營業現金流」是照妖鏡\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"財報上的「獲利」不等於公司口袋裡真的有「現金」。有些公司為了衝高業績，會放寬收款條件，導致帳上有很多應收帳款，錢卻沒真正進來。這時候，「營業現金流量」就是最好的照妖鏡，它顯示了公司透過主要業務活動，實際收進來多少現金。\"}],\"$L18\",\"$L19\"]]}],\"$L1a\",\"$L1b\",\"$L1c\",\"$L1d\",\"$L1e\"],null]}]]}]}]\n18:[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"檢查「損益表」上的稅後淨利是否為正數。\"}],[\"$\",\"li\",\"1\",{\"children\":\"接著比對「現金流量表」的營業現金流是否也是正數。\"}],[\"$\",\"li\",\"2\",{\"children\":\"如果獲利是正的，但營業現金流卻長期是負的，這就是所謂的「無現金獲利」，代表公司可能只是做白工，甚至還在燒錢，這種狀況非常危險。\"}]]}]\n19:[\"$\",\"figure\",\"2\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"✓營業利益率 > 0%✓負債比 < 60%✓營業現金流 > 0✓董監質押比 < 50%\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"你的持股健康檢查清單\"}]]}]\n1a:[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、內部人最知道！從「董監持股」變化看端倪\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"公司的董事、監察人等高層，最了解公司實際的營運狀況。他們的持股變動，往往是重要的風向球。如果他們對公司未來沒信心，或自己有資金壓力，就可能會在市場上賣出持股，或拿股票去銀行借錢（稱為「質押」）。這些動作都是我們需要留意的警訊。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"董監持股連續數月下降：代表內部人可能不看好公司前景，正在悄悄出脫。\"}],[\"$\",\"li\",\"1\",{\"children\":\"董監質押比例過高：通常質押比超過 50% 就算偏高。這表示大股東可能很缺錢，一旦股價下跌，他們可能會面臨銀行追繳保證金的壓力，引發賣壓。\"}]]}]]]}]\n1b:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、除了財報數字，還有哪些場外訊號要注意？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"除了財報數字，公司的日常營運也會透露出一些線索。有時候，這些「場外訊號」甚至比財報更能提前反應問題。當你看到以下情況時，就應該要提高警覺，主動去查證背後的原因。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"頻繁更換會計師：特別是從四大會計師事務所換成小所，可能代表公司與會計師在財報上有重大意見不合。\"}],[\"$\",\"li\",\"1\",{\"children\":\"延遲公布財報：這通常不是好消息，很可能是財報太難看，公司需要時間「做帳」或與會計師協調。\"}],[\"$\",\"li\",\"2\",{\"children\":\"負面新聞纏身：例如牽涉訴訟、產品出問題、高層異動、甚至傳出拖欠供應商款項等，都可能是風暴來臨前的預兆。\"}]]}]]]}]\n1c:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"財報多久公布一次？我該什麼時候檢查？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"台灣上市櫃公司每季公布一次財報。季報在每季結束後 45 天內，年報在年度結束後 3 個月內。建議至少每季財報公布後，花點時間檢查一次手上的持股狀況。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"如果發現持股有財務危機訊號，該馬上賣掉嗎？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"發現警訊是第一步，接著應該深入研究原因。有時可能是短期因素或產業轉型，但若多項指標持續惡化，考慮減碼或出清是保護個人資產的理性做法，最終仍需由您自己判斷。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"這些財務數字要去哪裡查？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"主管機關的「公開資訊觀測站」有最完整的官方資料。為了方便投資人，像股市大佬這類的工具會將資料整理成更易讀的圖表，在「個股透視」頁面就能快速查詢，幫助你節省時間。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"金融股的負債比都超過 90%，是不是很危險？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"這是個好問題！金融業的商業模式本來就是吸收大眾存款（這在會計上屬負債）再進行投資，所以負債比天生就很高。評估金融股不能用一般產業的 60% 標準，需要看資本適足率等更專業的指標。\"}]]}]]}]]]}]\n1d:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"避開財務地雷股，關鍵在於「持續追蹤」與「多方驗證」。不要只看單一的 EPS 或股價，養成每季檢查負債比、現金流與董監持股變動的習慣，就能大幅降低踩雷的機率，讓投資更安心。\"}]]]}]\n1e:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L17\",\"0-用「個股透視」快\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"用「個股透視」快速查詢財務指標\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L17\",\"0-想搞懂更多財報名\",{\"href\":\"/school\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"想搞懂更多財報名詞？來台股學堂\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L17\",\"0-註冊會員，開始建\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"註冊會員，開始建立你的觀察名單\"}]]}]]}]]]}]\n13:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\nf:null\n1f:I[80622,[],\"IconMark\"]\n11:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"財務危機常見訊號有哪些？4 個警訊教你避開地雷股｜股市大佬 TradeBoss\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"看到股票一直跌，心裡很慌，但又不知道問題出在哪？等到新聞爆出公司周轉不靈，股價早就來不及反應了。其實，在危機發生前，通常會有一些徵兆浮現。這篇文章就是要教你從公開資料中，找出 4 個簡單的財務危機訊號，保護你的投資組合。\"}],[\"$\",\"link\",\"2\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}],[\"$\",\"$L1f\",\"3\",{}]],\"error\":null,\"digest\":\"$undefined\"}\n16:\"$11:metadata\"\n"}