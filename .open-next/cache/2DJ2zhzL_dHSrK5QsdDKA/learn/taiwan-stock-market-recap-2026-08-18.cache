",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"偏強族群：創新板股票上漲3.17%（4檔），其中6869 雲豹能源-創領漲。\"}],[\"$\",\"li\",\"1\",{\"children\":\"偏強族群：航運業上漲1.27%（30檔），5608 四維航表現亮眼。\"}],[\"$\",\"li\",\"2\",{\"children\":\"偏強族群：農業科技業上漲0.40%（4檔），由4171 瑞基領漲。\"}],[\"$\",\"li\",\"3\",{\"children\":\"偏強族群：金融保險業上漲0.19%（32檔），2881 富邦金是其中領漲個股。\"}],[\"$\",\"li\",\"4\",{\"children\":\"偏弱族群：居家生活類下跌2.59%。\"}],[\"$\",\"li\",\"5\",{\"children\":\"偏弱族群：半導體業下跌2.26%。\"}],[\"$\",\"li\",\"6\",{\"children\":\"偏弱族群：數位雲端類下跌2.25%。\"}],[\"$\",\"li\",\"7\",{\"children\":\"偏弱族群：通信網路業下跌1.97%。\"}]]}]]]}],[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、個股焦點：漲跌幅與熱門當沖\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"個股方面，今天有股票呈現漲停，也有個股跌幅較深。同時，部分股票因成交量相對放大，成為當沖交易的熱門標的。\"}],[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"今日漲幅較大的股票：2601 益航上漲10.00%（成交量4865張）、3167 大量上漲10.00%（成交量5862張）、5608 四維航上漲10.00%（成交量14628張）、6869 雲豹能源-創上漲9.92%（成交量1025張）。\"}],[\"$\",\"li\",\"1\",{\"children\":\"今日跌幅較大的股票：3006 晶豪科下跌9.16%（成交量15821張）、3712 永崴投控下跌8.72%（成交量1129張）、2388 威盛下跌8.70%（成交量6220張）、3042 晶技下跌8.70%（成交量23920張）。\"}],\"$L18\"]}],\"$L19\"]]}],\"$L1a\",\"$L1b\",\"$L1c\",\"$L1d\",\"$L1e\"],null]}]]}]}]\n18:[\"$\",\"li\",\"2\",{\"children\":\"當沖熱門股票（量比高）：凌巨（8105）量比16.7倍，當日下跌8.61%；四維航（5608）量比11.1倍，當日上漲10.00%；崇越電（3043）量比10.4倍，當日上漲9.54%。\"}]\n19:[\"$\",\"figure\",\"2\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"✓外資現貨買超✓自營商現貨賣超✓外資期貨淨空單增✓融資維持率194.9%\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"法人籌碼焦點\"}]]}]\n1a:[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、法人動向與市場籌碼\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"觀察法人在現貨與期貨市場的動向，以及市場整體融資維持率，可以了解今天籌碼面的變化。\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"項目\"}],[\"$\",\"th\",\"1\",{\"children\":\"今日數據\"}],[\"$\",\"th\",\"2\",{\"children\":\"說明\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"外資現貨買賣超\"}],[\"$\",\"td\",\"1\",{\"children\":\"約234,605張\"}],[\"$\",\"td\",\"2\",{\"children\":\"今日外資在現貨市場為買超。\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"自營商現貨買賣超\"}],[\"$\",\"td\",\"1\",{\"children\":\"約-212,648張\"}],[\"$\",\"td\",\"2\",{\"children\":\"今日自營商在現貨市場為賣超。\"}]]}],[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"外資台指期淨空單\"}],[\"$\",\"td\",\"1\",{\"children\":\"83,078口\"}],[\"$\",\"td\",\"2\",{\"children\":\"外資在期貨市場的淨空單數量。\"}]]}],[\"$\",\"tr\",\"3\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"全市場融資維持率\"}],[\"$\",\"td\",\"1\",{\"children\":\"194.9%\"}],[\"$\",\"td\",\"2\",{\"children\":\"反映整體市場融資風險的指標。\"}]]}]]}]]}]}]]]}]\n1b:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、國際盤勢與相關消息\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"國際股市今天普遍呈現小幅下跌，可能對台股的表現產生一定影響。同時，今日市場上也有一些產業與個股相關新聞。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"主要國際股市表現：S&P 500 指數下跌0.17%、那斯達克指數下跌0.28%、費城半導體指數下跌0.31%、韓國綜合（KOSPI）指數下跌1.55%、日經225指數下跌1.82%。\"}],[\"$\",\"li\",\"1\",{\"children\":\"今日部分台股新聞標題：「雲豹能源勇奪亞洲最佳企業雇主獎、職場永續獎雙料大獎肯定」、「焦點股》所羅門：週三參展題材發酵 帶量漲停」、「欣興近日出關獲外資狂掃逾3千張，營收大增43%要反轉了？」、「欣興(3037)亮燈漲停至1120，法說會前AI載板展望強＋外資主力連買推升多頭格局」。\"}],[\"$\",\"li\",\"2\",{\"children\":\"近三日國際新聞標題（川普／美國政策相關）：「加拿大與時間賽跑、政治考量，急於阻止川普關稅」、「聯準會主席凱文·沃許繼承前任的川普問題，且無簡單解法」。\"}]]}]]]}]\n1c:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"今天台股大盤跌了多少？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"2026年8月18日，台股加權指數收盤下跌1.19%，來到45308.68點。櫃買指數跌幅較大，收盤下跌1.88%。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"哪些類股今天表現比較好？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"今天表現相對較強的族群包括創新板股票、航運業、農業科技業以及金融保險業。其中航運業上漲1.27%，金融保險業上漲0.19%。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"外資今天在台股做了什麼？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"外資今天在現貨市場買超約234,605張。在台指期貨市場，外資的淨空單為83,078口。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"半導體類股今天表現如何？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"半導體業今天表現偏弱，族群整體下跌2.26%。在跌幅榜上也有半導體相關個股，例如3006 晶豪科下跌9.16%。\"}]]}]]}]]]}]\n1d:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"總結今天台股，加權與櫃買指數雙雙下跌，盤面呈現普跌格局，少數傳產類股相對有撐，而電子族群則普遍承壓。\"}]]]}]\n1e:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"classNam