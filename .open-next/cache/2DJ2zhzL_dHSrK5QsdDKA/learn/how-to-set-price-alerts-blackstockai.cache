span\\\",null,{\\\"className\\\":\\\"LearnArticle_read__QEj6a\\\",\\\"children\\\":\\\"閱讀約 6 分鐘\\\"}]]}],[\\\"$\\\",\\\"h1\\\",null,{\\\"className\\\":\\\"LearnArticle_title__0_la8\\\",\\\"children\\\":\\\"股市大佬到價提醒怎麼設？3 步驟搞定\\\"}],[\\\"$\\\",\\\"details\\\",null,{\\\"className\\\":\\\"LearnArticle_toc__LcSAa\\\",\\\"children\\\":[[\\\"$\\\",\\\"summary\\\",null,{\\\"className\\\":\\\"LearnArticle_tocSummary__YBddG\\\",\\\"children\\\":\\\"本文目錄\\\"}],[\\\"$\\\",\\\"ol\\\",null,{\\\"className\\\":\\\"LearnArticle_tocList__Rq_Lz\\\",\\\"children\\\":[[\\\"$\\\",\\\"li\\\",\\\"sec-1\\\",{\\\"children\\\":[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"#sec-1\\\",\\\"children\\\":\\\"一、為什麼要設定到價提醒？自己看盤不行嗎？\\\"}]}],[\\\"$\\\",\\\"li\\\",\\\"sec-2\\\",{\\\"children\\\":[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"#sec-2\\\",\\\"children\\\":\\\"二、設定到價提醒的 3 個基本步驟\\\"}]}],[\\\"$\\\",\\\"li\\\",\\\"sec-3\\\",{\\\"children\\\":[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"#sec-3\\\",\\\"children\\\":\\\"三、不只看價格！這些進階條件讓你的監控更立體\\\"}]}],[\\\"$\\\",\\\"li\\\",\\\"sec-4\\\",{\\\"children\\\":[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"#sec-4\\\",\\\"children\\\":\\\"四、單次提醒 vs. 重複提醒，我該用哪一個？\\\"}]}],[\\\"$\\\",\\\"li\\\",\\\"sec-5\\\",{\\\"children\\\":[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"#sec-5\\\",\\\"children\\\":\\\"五、常見錯誤：為什麼我設定了提醒卻沒收到通知？\\\"}]}],[\\\"$\\\",\\\"li\\\",\\\"sec-6\\\",{\\\"children\\\":[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"#sec-6\\\",\\\"children\\\":\\\"常見問題 FAQ\\\"}]}],[\\\"$\\\",\\\"li\\\",\\\"sec-7\\\",{\\\"children\\\":[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"#sec-7\\\",\\\"children\\\":\\\"總結\\\"}]}],[\\\"$\\\",\\\"li\\\",\\\"sec-8\\\",{\\\"children\\\":[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"#sec-8\\\",\\\"children\\\":\\\"延伸閱讀\\\"}]}]]}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"LearnArticle_body__6B7Mb\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"LearnArticle_intro__ATV5c\\\",\\\"children\\\":\\\"上班開會、出門辦事，心裡卻一直掛著股票，三不五時就想打開手機看一下價錢？其實你不用這麼累。設定好「到價提醒」，讓系統在你設定的價位自動通知，就能把時間專注在更重要的事上。\\\"}],[],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"LearnArticle_tldr__Br5BY\\\",\\\"children\\\":[[\\\"$\\\",\\\"b\\\",null,{\\\"className\\\":\\\"LearnArticle_tldrTitle__K5PBN\\\",\\\"children\\\":\\\"本文重點\\\"}],[\\\"$\\\",\\\"ul\\\",null,{\\\"className\\\":\\\"LearnArticle_tldrList__VSc2_\\\",\\\"children\\\":[[\\\"$\\\",\\\"li\\\",\\\"0\\\",{\\\"children\\\":\\\"設定「到價提醒」能自動監控股價，省下頻繁看盤的時間與心力。\\\"}],[\\\"$\\\",\\\"li\\\",\\\"1\\\",{\\\"children\\\":\\\"除了價格，成交量、漲跌幅也能設定提醒，讓監控條件更全面。\\\"}],[\\\"$\\\",\\\"li\\\",\\\"2\\\",{\\\"children\\\":\\\"「單次提醒」適合抓短期買賣點，「重複提醒」可用於長期支撐壓力觀察。\\\"}],[\\\"$\\\",\\\"li\\\",\\\"3\\\",{\\\"children\\\":\\\"設定後務必確認手機 App 的通知權限已開啟，才不會漏接重要訊息。\\\"}]]}]]}],[[\\\"$\\\",\\\"section\\\",\\\"sec-1\\\",{\\\"id\\\":\\\"sec-1\\\",\\\"className\\\":\\\"LearnArticle_section__hLVjU\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"LearnArticle_h2__NmJ08\\\",\\\"children\\\":\\\"一、為什麼要設定到價提醒？自己看盤不行嗎？\\\"}],[[\\\"$\\\",\\\"p\\\",\\\"0\\\",{\\\"className\\\":\\\"LearnArticle_p__aZlQ1\\\",\\\"children\\\":\\\"很多人覺得自己看盤最準，但頻繁看盤很容易被短線的價格跳動影響，做出衝動的決定。設定到價提醒，就像是請一位不會累的助理幫你盯著。它能幫助你貫徹交易紀律，只有當股價真的碰到你預設的「重要關卡」時，你才需要打開 App 評估，而不是整天心神不寧地在小漲小跌中掙扎。\\\"}]]]}],[\\\"$\\\",\\\"section\\\",\\\"sec-2\\\",{\\\"id\\\":\\\"sec-2\\\",\\\"className\\\":\\\"LearnArticle_section__hLVjU\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"LearnArticle_h2__NmJ08\\\",\\\"children\\\":\\\"二、設定到價提醒的 3 個基本步驟\\\"}],[[\\\"$\\\",\\\"p\\\",\\\"0\\\",{\\\"className\\\":\\\"LearnArticle_p__aZlQ1\\\",\\\"children\\\":\\\"在股市大佬設定提醒非常直覺，不用三分鐘就能搞定。假設你看好一檔股票，打算在它突破整理區間高點 150 元時考慮進場，你可以這樣設定：\\\"}],[\\\"$\\\",\\\"ol\\\",\\\"1\\\",{\\\"className\\\":\\\"LearnArticle_listNum__86N5S\\\",\\\"children\\\":[[\\\"$\\\",\\\"li\\\",\\\"0\\\",{\\\"children\\\":\\\"進入個股頁面：從你的自選股清單或直接搜尋，點進你想設定的股票。\\\"}],[\\\"$\\\",\\\"li\\\",\\\"1\\\",{\\\"children\\\":\\\"點擊提醒鈴鐺：在頁面右上角找到一個小鈴鐺圖示，點下去就會開啟設定視窗。\\\"}],[\\\"$\\\",\\\"li\\\",\\\"2\\\",{\\\"children\\\":\\\"輸入條件與儲存：在條件欄位選擇「價格」，設定「大於等於 (≥) 150」，然後儲存。這樣一來，當股價達到或超過 150 元時，系統就會立刻發送通知給你。\\\"}]]}]]]}],[\\\"$\\\",\\\"section\\\",\\\"sec-3\\\",{\\\"id\\\":\\\"sec-3\\\",\\\"className\\\":\\\"LearnArticle_section__hLVjU\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"LearnArticle_h2__NmJ08\\\",\\\"children\\\":\\\"三、不只看價格！這些進階條件讓你的監控更立體\\\"}],[[\\\"$\\\",\\\"p\\\",\\\"0\\\",{\\\"className\\\":\\\"LearnArticle_p__aZlQ1\\\",\\\"children\\\":\\\"專業的投資人不會只看價格，成交量和漲跌幅也是判斷市場情緒的重要指標。例如，價格突破壓力區，如果同時伴隨大量成交，訊號的可靠度就更高。股市大佬也支援這些進階條件，讓你的監控網更密。\\\"}],[\\\"$\\\",\\\"div\\\",\\\"1\\\",{\\\"className\\\":\\\"LearnArticle_tblScroll__z9kbb\\\",\\\"children\\\":[\\\"$\\\",\\\"table\\\",null,{\\\"className\\\":\\\"LearnArticle_tbl__0yNgv\\\",\\\"children\\\":[[\\\"$\\\",\\\"thead\\\",null,{\\\"children\\\":[\\\"$\\\",\\\"tr\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"th\\\",\\\"0\\\",{\\\"children\\\":\\\"提醒類型\\\"}],[\\\"$\\\",\\\"th\\\",\\\"1\\\",{\\\"children\\\":\\\"適合情境\\\"}],[\\\"$\\\",\\\"th\\\",\\\"2\\\",{\\\"children\\\":\\\"設定範例\\\"}]]}]}],[\\\"$\\\",\\\"tbody\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"tr\\\",\\\"0\\\",{\\\"children\\\":[[\\\"$\\\",\\\"td\\\",\\\"0\\\",{\\\"children\\\":\\\"價格提醒\\\"}],[\\\"$\\\",\\\"td\\\",\\\"1\\\",{\\\"children\\\":\\\"監控特定買賣點、支撐壓力位\\\"}],[\\\"$\\\",\\\"td\\\",\\\"2\\\",{\\\"children\\\":\\\"「股價 ≥ 150 元時通知」\\\"}]]}],[\\\"$\\\",\\\"tr\\\",\\\"1\\\",{\\\"children\\\":[[\\\"$\\\",\\\"td\\\",\\\"0\\\",{\\\"children\\\":\\\"成交量提醒\\\"}],[\\\"$\\\",\\\"td\\\",\\\"1\\\",{\\\"children\\\":\\\"觀察是否有大量資金進出、確認突破訊號\\\"}],[\\\"$\\\",\\\"td\\\",\\\"2\\\",{\\\"children\\\":\\\"「單筆成交量 \\u003e 500 張時通知」\\\"}]]}],[\\\"$\\\",\\\"tr\\\",\\\"2\\\",{\\\"children\\\":[[\\\"$\\\",\\\"td\\\",\\\"0\\\",{\\\"children\\\":\\\"漲跌幅提醒\\\"}],[\\\"$\\\",\\\"td\\\",\\\"1\\\",{\\\"children\\\":\\\"掌握盤中劇烈波動、觸發停損停利\\\"}],[\\\"$\\\",\\\"td\\\",\\\"2\\\",{\\\"children\\\":\\\"「今日漲幅 ≥ 5% 時通知」\\\"}]]}]]}]]}]}],[\\\"$\\\",\\\"figure\\\",\\\"2\\\",{\\\"className\\\":\\\"LearnArticle_fig__uoT7r\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"LearnArticle_figFrame__jJ7E4\\\",\\\"children\\\":\\\"✓這是我的買點或賣點？✓這個價位有特殊意義嗎？✓手機通知權限開了嗎？\\\"}],\\\"$L18\\\"]}]]]}],\\\"$L19\\\",\\\"$L1a\\\",\\\"$L1b\\\",\\\"$L1c\\\",\\\"$L1d\\\"],null]}]]}]}]\\n\"])</script><script>self.__next_f.push([1,\"18:[\\\"$\\\",\\\"figcaption\\\",null,{\\\"className\\\":\\\"LearnArticle_figCap__LnUbb\\\",\\\"children\\\":\\\"設定前的自我檢查\\\"}]\\n19:[\\\"$\\\",\\\"section\\\",\\\"sec-4\\\",{\\\"id\\\":\\\"sec-4\\\",\\\"className\\\":\\\"LearnArticle_section__hLVjU\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"LearnArticle_h2__NmJ08\\\",\\\"children\\\":\\\"四、單次提醒 vs. 重複提醒，我該用哪一個？\\\"}],[[\\\"$\\\",\\\"p\\\",\\\"0\\\",{\\\"className\\\":\\\"LearnArticle_p__aZlQ1\\\",\\\"children\\\":\\\"在設定時，你會看到「單次」與「重複」兩個選項，這兩者用途不同。如果你是針對某個特定的交易機會，例如「這次跌破季線我就要停損」，那就用「單次提醒」，觸發一次後它就會自動失效。但如果你想長期觀察一個關鍵價位，例如「每次回測到 100 元的支撐附近都想看看」，那就選擇「重複提醒」，這樣每次股價碰到這個價位，系統都會通知你。\\\"}]]]}]\\n1a:[\\\"$\\\",\\\"section\\\",\\\"sec-5\\\",{\\\"id\\\":\\\"sec-5\\\",\\\"className\\\":\\\"LearnArticle_section__hLVjU\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"LearnArticle_h2__NmJ08\\\",\\\"children\\\":\\\"五、常見錯誤：為什麼我設定了提醒卻沒收到通知？\\\"}],[[\\\"$\\\",\\\"p\\\",\\\"0\\\",{\\\"className\\\":\\\"LearnArticle_p__aZlQ1\\\",\\\"children\\\":\\\"最常見的原因有兩個。第一，也是最容易忽略的，就是手機系統的「App 通知權限」沒有打開。請到手機的「設定」裡，找到股市大佬 App，確認通知是允許的。第二個可能是，你設定的條件在你設定的當下就已經成立了，例如股價 105 元時，你設定「股價大於 100 元時通知」，系統會判斷條件已滿足而不會重複發送。設定時要確保條件是未來可能發生的情況。\\\"}],[\\\"$\\\",\\\"ul\\\",\\\"1\\\",{\\\"className\\\":\\\"LearnArticle_listCheck__xx1CF\\\",\\\"children\\\":[[\\\"$\\\",\\\"li\\\",\\\"0\\\",{\\\"children\\\":\\\"檢查手機系統設定，是否允許 App 推播通知。\\\"}],[\\\"$\\\",\\\"li\\\",\\\"1\\\",{\\\"children\\\":\\\"確認設定的條件尚未被觸發。\\\"}],[\\\"$\\\",\\\"li\\\",\\\"2\\\",{\\\"children\\\":\\\"檢查 App 是否為最新版本。\\\"}]]}]]]}]\\n\"])</script><script>self.__next_f.push([1,\"1b:[\\\"$\\\",\\\"section\\\",\\\"sec-6\\\",{\\\"id\\\":\\\"sec-6\\\",\\\"className\\\":\\\"LearnArticle_section__hLVjU\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"LearnArticle_h2__NmJ08\\\",\\\"children\\\":\\\"常見問題 FAQ\\\"}],[[\\\"$\\\",\\\"div\\\",\\\"0\\\",{\\\"className\\\":\\\"LearnArticle_faq__cemBp\\\",\\\"children\\\":[[\\\"$\\\",\\\"details\\\",\\\"0\\\",{\\\"className\\\":\\\"LearnArticle_faqItem__I9h0U\\\",\\\"children\\\":[[\\\"$\\\",\\\"summary\\\",null,{\\\"children\\\":\\\"設定到價提醒需要付費嗎？\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"LearnArticle_faqA__IPuvc\\\",\\\"children\\\":\\\"股市大佬會員都可以免費使用基本的到價提醒功能。詳細的組數限制與進階功能，請參考會員方案說明頁面。\\\"}]]}],[\\\"$\\\",\\\"details\\\",\\\"1\\\",{\\\"className\\\":\\\"LearnArticle_faqItem__I9h0U\\\",\\\"children\\\":[[\\\"$\\\",\\\"summary\\\",null,{\\\"children\\\":\\\"如果股價跳空直接越過我設定的價位，還會通知嗎？\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"LearnArticle_faqA__IPuvc\\\",\\\"children\\\":\\\"會的。例如你設定「股價 ≥ 100 元」提醒，若股價從 98 元直接跳空開到 102 元，系統偵測到價格已滿足「大於等於 100」的條件，一樣會發送通知。\\\"}]]}],[\\\"$\\\",\\\"details\\\",\\\"2\\\",{\\\"className\\\":\\\"LearnArticle_faqItem__I9h0U\\\",\\\"children\\\":[[\\\"$\\\",\\\"summary\\\",null,{\\\"children\\\":\\\"盤後或假日設定的提醒會有效嗎？\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"LearnArticle_faqA__IPuvc\\\",\\\"children\\\":\\\"會的。在非交易時間設定的提醒，會從下一個交易日的開盤開始生效，系統會持續為您監控，直到條件被觸發為止。\\\"}]]}],[\\\"$\\\",\\\"details\\\",\\\"3\\\",{\\\"className\\\":\\\"LearnArticle_faqItem__I9h0U\\\",\\\"children\\\":[[\\\"$\\\",\\\"summary\\\",null,{\\\"children\\\":\\\"我可以設定幾組提醒？\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"LearnArticle_faqA__IPuvc\\\",\\\"children\\\":\\\"每位會員可設定的提醒組數上限不同，您可以登入後台的「提醒管理」頁面查看您目前的額度。一般來說，同時監控 5-10 檔核心持股是足夠的。\\\"}]]}]]}]]]}]\\n\"])</script><script>self.__next_f.push([1,\"1c:[\\\"$\\\",\\\"section\\\",\\\"sec-7\\\",{\\\"id\\\":\\\"sec-7\\\",\\\"className\\\":\\\"LearnArticle_section__hLVjU\\\",\\\"children\\\":[[\\\"$\\\