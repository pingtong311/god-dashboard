,null,{\"className\":\"LearnArticle_cat__GQMlg\",\"href\":\"/learn?c=strategy\",\"children\":\"策略解析\"}],[\"$\",\"span\",null,{\"className\":\"LearnArticle_read__QEj6a\",\"children\":\"閱讀約 8 分鐘\"}]]}],[\"$\",\"h1\",null,{\"className\":\"LearnArticle_title__0_la8\",\"children\":\"CCI 順勢指標是什麼？別只看+100 和-100，3 步驟找出股價轉折點\"}],[\"$\",\"details\",null,{\"className\":\"LearnArticle_toc__LcSAa\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"LearnArticle_tocSummary__YBddG\",\"children\":\"本文目錄\"}],[\"$\",\"ol\",null,{\"className\":\"LearnArticle_tocList__Rq_Lz\",\"children\":[[\"$\",\"li\",\"sec-1\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-1\",\"children\":\"一、什麼是 CCI 順勢指標？它真的是看「順勢」的嗎？\"}]}],[\"$\",\"li\",\"sec-2\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-2\",\"children\":\"二、CCI 的關鍵數字：+100、-100 和 0 軸代表什麼？\"}]}],[\"$\",\"li\",\"sec-3\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-3\",\"children\":\"三、如何用 CCI 找出買賣點？3 個常見應用訊號\"}]}],[\"$\",\"li\",\"sec-4\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-4\",\"children\":\"四、進階用法：什麼是「CCI 背離」？為什麼它是重要警訊？\"}]}],[\"$\",\"li\",\"sec-5\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-5\",\"children\":\"五、CCI 指標的常見誤區？為什麼不能單獨使用？\"}]}],[\"$\",\"li\",\"sec-6\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-6\",\"children\":\"常見問題 FAQ\"}]}],[\"$\",\"li\",\"sec-7\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-7\",\"children\":\"總結\"}]}],[\"$\",\"li\",\"sec-8\",{\"children\":[\"$\",\"a\",null,{\"href\":\"#sec-8\",\"children\":\"延伸閱讀\"}]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"LearnArticle_body__6B7Mb\",\"children\":[[\"$\",\"p\",null,{\"className\":\"LearnArticle_intro__ATV5c\",\"children\":\"打開技術分析圖，看到一條在 +100 和 -100 之間上下亂竄的 CCI 線，感覺好像很重要，但又不知道該怎麼解讀？這篇文章會教你，如何用 CCI 指標判斷股價是不是「漲太多」或「跌過頭」，並找出可能的進出場時機。\"}],[[\"$\",\"figure\",\"figure-0\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"虧 3 次每次 −1%賺 2 次每次 +1%勝率 40% 也可能是正期望，前提是賺的比虧的大、且扣得起成本短線先扣約 0.24% 當沖成本，再看還剩多少\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"示意圖｜期望值：勝率要配上平均賺賠，再扣成本（教學結構，不是某檔實盤）\"}]]}]],[\"$\",\"div\",null,{\"className\":\"LearnArticle_tldr__Br5BY\",\"children\":[[\"$\",\"b\",null,{\"className\":\"LearnArticle_tldrTitle__K5PBN\",\"children\":\"本文重點\"}],[\"$\",\"ul\",null,{\"className\":\"LearnArticle_tldrList__VSc2_\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"CCI 突破 +100 是超買訊號，但先別急著賣，可能是強勢整理。\"}],[\"$\",\"li\",\"1\",{\"children\":\"CCI 跌破 -100 是超賣訊號，代表股價可能跌過頭，醞釀反彈。\"}],[\"$\",\"li\",\"2\",{\"children\":\"CCI 指標出現「背離」，是股價趨勢可能反轉的關鍵警訊。\"}],[\"$\",\"li\",\"3\",{\"children\":\"搭配均線或 K 棒型態，能提高 CCI 訊號的準確度，避免假訊號。\"}]]}]]}],[[\"$\",\"section\",\"sec-1\",{\"id\":\"sec-1\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"一、什麼是 CCI 順勢指標？它真的是看「順勢」的嗎？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"CCI 的全名是「順勢指標」（Commodity Channel Index），但這個名字有點容易讓人誤會。它主要不是用來「跟著趨勢走」，反而是用來衡量目前股價偏離「正常價格範圍」多遠的工具。簡單來說，它就像一個溫度計，告訴你現在市場情緒是過熱（超買）還是過冷（超賣），幫助我們找到可能的轉折點。\"}]]]}],[\"$\",\"section\",\"sec-2\",{\"id\":\"sec-2\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"二、CCI 的關鍵數字：+100、-100 和 0 軸代表什麼？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"看懂 CCI，關鍵就在這幾個數字門檻。你可以把它想像成一條高速公路，+100 和 -100 是兩邊的路肩，中間的 0 軸則是分隔線。大部分時間，股價（車子）會在路中央行駛，一旦開到路肩，就代表情況比較極端，需要特別注意了。\"}],[\"$\",\"div\",\"1\",{\"className\":\"LearnArticle_tblScroll__z9kbb\",\"children\":[\"$\",\"table\",null,{\"className\":\"LearnArticle_tbl__0yNgv\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",\"0\",{\"children\":\"CCI 數值範圍\"}],[\"$\",\"th\",\"1\",{\"children\":\"代表意義\"}],[\"$\",\"th\",\"2\",{\"children\":\"散戶可以怎麼解讀\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"> +100\"}],[\"$\",\"td\",\"1\",{\"children\":\"超買區 (Overbought)\"}],[\"$\",\"td\",\"2\",{\"children\":\"股價漲幅偏離平均太多，市場過熱，但注意也可能是強勢股的特徵。\"}]]}],[\"$\",\"tr\",\"1\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"-100 到 +100\"}],[\"$\",\"td\",\"1\",{\"children\":\"常態區 (Normal Range)\"}],[\"$\",\"td\",\"2\",{\"children\":\"股價在正常範圍內波動，多空力道相對均衡，適合觀察等待。\"}]]}],[\"$\",\"tr\",\"2\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"< -100\"}],[\"$\",\"td\",\"1\",{\"children\":\"超賣區 (Oversold)\"}],[\"$\",\"td\",\"2\",{\"children\":\"股價跌幅偏離平均太多，市場過度悲觀，可能出現反彈機會。\"}]]}],[\"$\",\"tr\",\"3\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"由下往上穿越 0 軸\"}],[\"$\",\"td\",\"1\",{\"children\":\"趨勢轉多\"}],[\"$\",\"td\",\"2\",{\"children\":\"股價從弱勢轉為強勢的早期訊號。\"}]]}],[\"$\",\"tr\",\"4\",{\"children\":[[\"$\",\"td\",\"0\",{\"children\":\"由上往下穿越 0 軸\"}],\"$L18\",\"$L19\"]}]]}]]}]}]]]}],\"$L1a\",\"$L1b\",\"$L1c\",\"$L1d\",\"$L1e\",\"$L1f\"],null]}]]}]}]\n18:[\"$\",\"td\",\"1\",{\"children\":\"趨勢轉空\"}]\n19:[\"$\",\"td\",\"2\",{\"children\":\"股價從強勢轉為弱勢的早期訊號。\"}]\n1a:[\"$\",\"section\",\"sec-3\",{\"id\":\"sec-3\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"三、如何用 CCI 找出買賣點？3 個常見應用訊號\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"了解數字意義後，我們就能把它變成實際的判斷方法。不過要記得，任何技術指標都不是百分之百準確的水晶球，把它當作輔助你決策的工具，而不是唯一的下單依據，才能用得更穩健。\"}],[\"$\",\"ol\",\"1\",{\"className\":\"LearnArticle_listNum__86N5S\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"超賣區找買點：當 CCI 從 -100 下方「由下往上」回穿 -100 線時，代表賣壓可能減輕，股價有機會回穩，是一個可以留意的潛在買進訊號。\"}],[\"$\",\"li\",\"1\",{\"children\":\"超買區找賣點：當 CCI 從 +100 上方「由上往下」跌破 +100 線時，代表追價力道可能衰退，股價有回檔修正的風險，是一個可以考慮的賣出訊號。\"}],[\"$\",\"li\",\"2\",{\"children\":\"觀察 0 軸趨勢：CCI 如果長時間在 0 軸以上運行，代表股價處於多頭格局；反之，若長期在 0 軸以下，則偏向空頭。這可以幫助你判斷目前的大方向。\"}]]}],[\"$\",\"figure\",\"2\",{\"className\":\"LearnArticle_fig__uoT7r\",\"children\":[[\"$\",\"div\",null,{\"className\":\"LearnArticle_figFrame__jJ7E4\",\"children\":\"✓股價創高、CCI 未創高✓高檔背離，留意反轉✓股價破底、CCI 未破底✓低檔背離，尋找機會\"}],[\"$\",\"figcaption\",null,{\"className\":\"LearnArticle_figCap__LnUbb\",\"children\":\"CCI 進階用法：背離警訊\"}]]}]]]}]\n1b:[\"$\",\"section\",\"sec-4\",{\"id\":\"sec-4\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"四、進階用法：什麼是「CCI 背離」？為什麼它是重要警訊？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"「背離」是技術分析中一個非常重要的概念，意思是「指標的走勢跟股價的走勢不一樣」。當這種情況發生在 CCI 指標上時，往往是趨勢即將反轉的強烈警訊，比單純看超買超賣區更值得信賴。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_listCheck__xx1CF\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"高檔背離（熊背離）：股價創下新高點，但 CCI 指標的高點卻沒有跟著創高，反而下降。這暗示上漲的力道正在減弱，要小心趨勢可能反轉下跌。\"}],[\"$\",\"li\",\"1\",{\"children\":\"低檔背離（牛背離）：股價創下新低點，但 CCI 指標的低點卻沒有跟著破底，反而上升。這暗示下跌的動能正在趨緩，有機會迎來一波反彈或回升。\"}]]}]]]}]\n1c:[\"$\",\"section\",\"sec-5\",{\"id\":\"sec-5\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"五、CCI 指標的常見誤區？為什麼不能單獨使用？\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"很多新手看到 CCI 進入超買區就急著賣，進到超賣區就急著買，結果常常賣在半山腰，或是接到持續下跌的刀子。這是因為 CCI 指標有其天生的限制，尤其在趨勢明顯的行情中，單獨使用很容易被誤導。\"}],[\"$\",\"ul\",\"1\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":\"常見錯誤一：看到 >+100 就放空。市場關注度高的股票，CCI 可能長期維持在 +100 以上，這叫做「指標鈍化」。如果一進超買區就賣，可能會錯過後面更大段的漲幅。\"}],[\"$\",\"li\",\"1\",{\"children\":\"常見錯誤二：看到 <-100 就進場。弱勢股也可能在超賣區待很久，股價持續破底。跌破 -100 不代表「馬上」就會反彈。\"}],[\"$\",\"li\",\"2\",{\"children\":\"正確用法：搭配其他指標做「雙重確認」。例如，用均線判斷長線趨勢，或用 K 棒型態（如紅 K 吞噬、晨星）來確認轉折訊號，能大幅提高判斷的準確度。\"}]]}]]]}]\n1d:[\"$\",\"section\",\"sec-6\",{\"id\":\"sec-6\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"常見問題 FAQ\"}],[[\"$\",\"div\",\"0\",{\"className\":\"LearnArticle_faq__cemBp\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"CCI 的參數要設多少天？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"一般看盤軟體預設是 14 天（資料查證月份：2026-08），這適合多數短中期交易。如果你是做更短線的當沖，可能會縮短到 9 天；做長線波段的，可能會拉長到 20 或 50 天。新手建議先從預設的 14 天開始觀察，熟悉它的特性。\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"CCI 指標是落後指標還是領先指標？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"CCI 兼具兩者特性。當它用來確認趨勢時（如站上或跌破 0 軸），它屬於「落後指標」。但當它出現「背離」訊號時，因為預示了趨勢可能反轉，所以具有「領先」指標的特性。\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"為什麼有些股票的 CCI 常常超過 +200 或跌破 -200？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"CCI 的計算沒有絕對的上下限。股性特別活潑、波動劇烈的股票，其 CCI 值就容易出現超過 ±200 的極端數字。這代表股價在短期內偏離平均的程度非常大，更需要留意反轉的風險。\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"LearnArticle_faqItem__I9h0U\",\"children\":[[\"$\",\"summary\",null,{\"children\":\"CCI 跟 KD 或 RSI 指標有什麼不一樣？\"}],[\"$\",\"p\",null,{\"className\":\"LearnArticle_faqA__IPuvc\",\"children\":\"它們都是擺盪指標，但計算基礎不同。KD 和 RSI 的數值被限制在 0-100 之間，而 CCI 沒有上下限。簡單來說，KD 對價格反應最敏感，RSI 衡量買賣力道的相對強弱，而 CCI 則強調股價偏離其移動平均的程度。\"}]]}]]}]]]}]\n1e:[\"$\",\"section\",\"sec-7\",{\"id\":\"sec-7\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"總結\"}],[[\"$\",\"p\",\"0\",{\"className\":\"LearnArticle_p__aZlQ1\",\"children\":\"總結來說，不要只把 CCI 的 +100 當作賣點、-100 當作買點。把它當成一個「警報器」，當 CCI 進入極端區域或出現背離時，提醒你該停下來，搭配 K 線和均線，重新檢視目前的趨勢是否可能改變。\"}]]]}]\n1f:[\"$\",\"section\",\"sec-8\",{\"id\":\"sec-8\",\"className\":\"LearnArticle_section__hLVjU\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"LearnArticle_h2__NmJ08\",\"children\":\"延伸閱讀\"}],[[\"$\",\"ul\",\"0\",{\"className\":\"LearnArticle_list__WjxqC\",\"children\":[[\"$\",\"li\",\"0\",{\"children\":[[\"$\",\"$L17\",\"0-想學更多技術指標\",{\"href\":\"/school\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"想學更多技術指標？來台股學堂打好基礎\"}]]}],[\"$\",\"li\",\"1\",{\"children\":[[\"$\",\"$L17\",\"0-在個股頁面，親手\",{\"href\":\"/diary\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"在個股頁面，親手打開 CCI 指標試試看\"}]]}],[\"$\",\"li\",\"2\",{\"children\":[[\"$\",\"$L17\",\"0-掃描符合特定技術\",{\"href\":\"/chart\",\"className\":\"LearnArticle_link__gMwHV\",\"children\":\"掃描符合特定技術型態的股票清單\"}]]}]]}]]]}]\n13:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\nf:null\n20:I[80622,[],\"IconMark\"]\n11:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"CCI 順勢指標是什麼？別只看+100 和-100，3 步驟找出股價轉折點｜股市大佬 TradeBoss\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"打開技術分析圖，看到一條在 +100 和 -100 之間上下亂竄的 CCI 線，感覺好像很重要，但又不知道該怎麼解讀？這篇文章會教你，如何用 CCI 指標判斷股價是不是「漲太多」或「跌過頭」，並找出可能的進出場時機。\"}],[\"$\",\"link\",\"2\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}],[\"$\",\"$L20\",\"3\",{}]],\"error\":null,\"digest\":\"$undefined\"}\n16:\"$11:metadata\"\n"}