ync=\"\"></script><script src=\"/_next/static/chunks/app/layout-4382c12d510386d3.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/methodology/page-d52b5074c6cdd6ee.js\" async=\"\"></script><meta name=\"next-size-adjust\" content=\"\"/><title>資料與方法說明 | 股市大佬 TradeBoss</title><meta name=\"description\" content=\"這一頁集中回答「數字從哪來、多久更新、怎麼算」。 介面各處的 ⓘ 與「資料說明」都指向這裡。\"/><link rel=\"icon\" href=\"/favicon.ico\" type=\"image/x-icon\" sizes=\"16x16\"/><script>(function(){try{var t=localStorage.getItem('obsidian-theme');if(t!=='light'&&t!=='dark')t='dark';document.documentElement.setAttribute('data-theme',t);document.documentElement.style.colorScheme=(t==='light'?'light':'dark');}catch(e){document.documentElement.setAttribute('data-theme','dark');}})();(function(){try{if(localStorage.getItem('obsidian-comfort-read')==='1')document.documentElement.classList.add('comfort-read');}catch(e){}})();(function(){try{var s=localStorage.getItem('obsidian-updown');if(s==='us')document.documentElement.setAttribute('data-updown','us');}catch(e){}})();(function(){try{var prefs=JSON.parse(localStorage.getItem('bs-preferences-v1')||'{}');var root=document.documentElement;prefs=prefs&&typeof prefs==='object'?prefs:{};root.setAttribute('data-font-size',['standard','large','xlarge','huge'].indexOf(prefs.fontSize)>=0?prefs.fontSize:'standard');root.setAttribute('data-density',prefs.density==='compact'?'compact':'comfortable');}catch(e){}})();</script><script src=\"/_next/static/chunks/polyfills-42372ed130431b0a.js\" noModule=\"\"></script></head><body class=\"min-h-screen bg-background text-foreground selection:bg-cyan/30 review-mode pb-40 lg:pb-16\" data-review-theme=\"dark\"><div hidden=\"\"><!--$--><!--/$--></div><a href=\"#main-content\" class=\"skip-link fixed left-3 top-3 z-[80] -translate-y-24 rounded-xl bg-accent px-4 py-2 font-black text-bg shadow-lg transition focus:translate-y-0\">跳到主要內容</a><div class=\"compliance-bar border-b border-line/40 bg-bg/60 px-4 py-1 text-center text-[10.5px] leading-tight text-muted/70\">非證券投資顧問事業<span class=\"hidden sm:inline\">｜公開資料研究與教學，不提供個股分析意見或推介</span><span class=\"sm:hidden\">｜公開資料研究與教學</span> <a class=\"underline underline-offset-2\" href=\"/legal\">法遵</a> · <a class=\"underline underline-offset-2\" href=\"/privacy\">隱私</a></div><header class=\"Navigation_header__9xJIy\"><div class=\"Navigation_inner__HaQCh\"><button type=\"button\" class=\"Navigation_backBtn__rNB5u\" aria-label=\"返回上一頁\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"22\" height=\"22\" fill=\"currentColor\" viewBox=\"0 0 256 256\" aria-hidden=\"true\"><path d=\"M228,128a12,12,0,0,1-12,12H69l51.52,51.51a12,12,0,0,1-17,17l-72-72a12,12,0,0,1,0-17l72-72a12,12,0,0,1,17,17L69,116H216A12,12,0,0,1,228,128Z\"></path></svg></button><a class=\"Navigation_brand__V_MfK\" aria-label=\"回股市大佬首頁\" href=\"/\"><img src=\"/brand/tradeboss-logo.png\" alt=\"股市大佬 TradeBoss\" class=\"Navigation_logoImg___eeKZ\"/><span class=\"Navigation_brandText__c1Rib\"><span class=\"Navigation_brandTitle__V8fwH\">股市<span class=\"Navigation_brandAccent__bb15A\">大佬</span></span><span class=\"Navigation_brandSub__XUkO_\">TRADEBOSS</span></span></a><nav class=\"Navigation_nav__D1U__\"><a class=\"Navigation_navLink__lvNUe\" href=\"/learn\">文章</a><a class=\"Navigation_navLink__lvNUe\" href=\"/school\">學堂</a><a class=\"Navigation_navLink__lvNUe\" href=\"/about\">關於</a><a class=\"Navigation_navLink__lvNUe\" href=\"/login\">登入</a></nav><div class=\"Navigation_actions__QSJSs\"><button type=\"button\" class=\"Navigation_themeBtn__I9ble\" aria-pressed=\"false\" title=\"切換到淺色（較亮、較清楚）\"><span aria-hidden=\"true\" class=\"Navigation_themeGlyph__wvU6O\">☀</span><span class=\"Navigation_srOnly__lixg9\">切換淺色</span></button><a class=\"Navigation_loginMobile__J3HwV\" href=\"/login\">登入</a></div></div></header><main id=\"main-content\" class=\"w-full\"><div class=\"StaticPage_page__Pk04n\"><div class=\"StaticPage_enter__wb_uk\"><section class=\"StaticPage_heroPlain__vb_Bk\"><h1 class=\"StaticPage_heroPlainTitle__D3JLn\">資料與方法說明</h1><p class=\"StaticPage_heroLead__TNPFm\">這一頁集中回答「數字從哪來、多久更新、怎麼算」。 介面各處的 ⓘ 與「資料說明」都指向這裡。</p></section><section class=\"StaticPage_section__RXq8Q\"><div class=\"StaticPage_sectionHeader__NU9WR\"><div class=\"StaticPage_sectionHeaderRow__2r4ts\"><div class=\"StaticPage_sectionHeaderLeft__baou5\"><span aria-hidden=\"true\" class=\"StaticPage_sectionMark__cRYEl\"></span><h2 class=\"StaticPage_sectionHeading__RPy_D\">資料來源政策</h2></div></div></div><div class=\"StaticPage_sectionBody__jimzB\"><div class=\"StaticPage_card__Jx1EJ\"><ul class=\"StaticPage_cardItems__3CvkW\"><li>· 盤後資料（日線、分點、法人、資券、集保）：台灣證券交易所與櫃買中心的公開盤後統計，經授權資料服務取得。</li><li>· 盤中行情：授權行情源；即時內容僅提供登入會員，不對外開放抓取。</li><li>· 公司基本資料與官網：交易所公開的公司基本資料。</li><li>· 我們不揭露個別供應商細節，避免爬蟲與濫用；資料授權合約均為有效授權。</li></ul></div></div></section><section class=\"StaticPage_section__RXq8Q\"><div class=\"StaticPage_sectionHeader__NU9WR\"><div class=\"StaticPage_sectionHeaderRow__2r4ts\"><div class=\"StaticPage_sectionHeaderLeft__baou5\"><span aria-hidden=\"true\" class=\"StaticPage_sectionMark__cRYEl\"></span><h2 class=\"StaticPage_sectionHeading__RPy_D\">更新頻率</h2></div></div></div><div class=\"StaticPage_sectionBody__jimzB\"><div class=\"StaticPage_card__Jx1EJ\"><ul class=\"StaticPage_cardItems__3CvkW\"><li>· 盤中行情：交易時段內即時更新，卡片標示「盤中即時」與時間。</li><li>· 分點與法人：每個交易日約 16:00–21:30 陸續公布，本站於晚間完成整理；卡片標示「盤後 · 資料日」。</li><li>· 集保級距：每週更新。財報與月營收：依公告時程。</li><li>· 缺資料時顯示「—」或「未入庫」，不以 0 代替。</li></ul></div></div></section><section class=\"StaticPage_section__RXq8Q\"><div class=\"StaticPage_sectionHeader__NU9WR\"><div class=\"StaticPage_sectionHeaderRow__2r4ts\"><div class=\"StaticPage_sectionHeaderLeft__baou5\"><span aria-hidden=\"true\" class=\"StaticPage_sectionMark__cRYEl\"></span><h2 class=\"StaticPage_sectionHeading__RPy_D\">研究熱度分數（BlackScore）</h2></div></div></div><div class=\"StaticPage_sectionBody__jimzB\"><div class=\"StaticPage_card__Jx1EJ\"><p class=\"StaticPage_cardBody__JO4cj\">衡量「這檔股票最近的資料值不值得花時間研究」的 0–100 分，不是買賣訊號、不是漲跌預測。</p><ul class=\"StaticPage_cardItems__3CvkW\"><li>· 分項：分點資金（25）、買方集中（15）、法人動向（20）、技術結構（15）、量能動能（15）、波動風險（10）。</li><li>· 每個分項都是一句已發生的客觀事實（例：投信連 4 日買超），逐項加分可追溯。</li><li>· 缺資料的分項不計分，總分按其餘分項重新換算成 100 分制，並在明細標示「未入庫」。</li><li>· 只用盤後資料計算，每晚更新一次；版本目前為 v1.0，調整計算方式會更新版本號。</li></ul></div></div></section><section class=\"StaticPage_section__RXq8Q\"><div class=\"StaticPage_sectionHeader__NU9WR\"><div class=\"StaticPage_sectionHeaderRow__2r4ts\"><div class=\"StaticPage_sectionHeaderLeft__baou5\"><span aria-hidden=\"true\" class=\"StaticPage_sectionMark__cRYEl\"></span><h2 class=\"StaticPage_sectionHeading__RPy_D\">資金雷達（Black Radar）</h2></div></div></div><div class=\"StaticPage_sectionBody__jimzB\"><div class=\"StaticPage_card__Jx1EJ\"><ul class=\"StaticPage_cardItems__3CvkW\"><li>· 資金集中／資金退潮：近 5 個交易日分點淨買（賣）超佔區間成交量比例排序。</li><li>· 連買動能：投信連續買超天數排序。</li><li>· 法人同步：外資與投信近 5 日同時淨買、合計張數排序。</li><li>· 大量異常：當日量能相對 20 日均量倍數排序。</li><li>· 全部為盤後統計與歷史事實排序，不含方向研判；每晚更新。</li></ul></div></div></section><section class=\"StaticPage_section__RXq8Q\"><div class=\"StaticPage_sectionHeader__NU9WR\"><div class=\"StaticPage_sectionHeaderRow__2r4ts\"><div class=\"StaticPage_sectionHeaderLeft__baou5\"><span aria-hidden=\"true\" class=\"StaticPage_sectionMark__cRYEl\"></span><h2 class=\"StaticPage_sectionHeading__RPy_D\">名詞與教學</h2></div></div></div><div class=\"StaticPage_sectionBody__jimzB\"><div class=\"StaticPage_card__Jx1EJ\"><p class=\"StaticPage_cardBody__JO4cj\">分點、集中度、量比等名詞的白話解釋在 台股學堂； 功能操作見 使用手冊； 法遵與免責全文見 法遵頁。</p><a class=\"StaticPage_cardCta__CiSXm\" href=\"/school\">台股學堂</a></div><p class=\"StaticPage_pBody__SpzFp\">本站所有內容為公開資料之統計、整理與教學，不構成投資建議、不代客操作、不保證獲利。</p></div></section></div></div><!--$--><!--/$--></main><footer class=\"site-footer mx-auto mt-14 w-full max-w-[1360px] px-4 md:px-6\"><div class=\"data-panel rounded-2xl border border-line/80 bg-surface/70 p-4 text-sm leading-relaxed text-muted\"><p class=\"mb-1.5 font-bold text-ink\">免責與法遵聲明</p><p>本平台提供台股公開籌碼資料之統計、教學與研究工具，所有數字均為歷史資料整理，<span class=\"font-bold text-ink\">不構成任何投資建議、招攬、買賣要約或獲利保證</span>。平台不代客操作、不提供個股買賣訊號、不保證準確性。 投資有風險，交易前請自行評估、獨立判斷並自負盈虧。 本站不會私訊要驗證碼或叫你匯款。</p><nav aria-label=\"公司資訊與法遵\" class=\"flex flex-wrap justify-center gap-x-3 gap-y-2 text-[12.5px] font-bold mt-3\"><a class=\"min-h-11 inline-flex items-center text-accent underline-offset-2 hover:underline\" href=\"/about\">關於本站</a><a class=\"min-h-11 inline-flex items-center text-accent underline-offset-2 hover:underline\" href=\"/guide\">新手導覽</a><a class=\"min-h-11 inline-flex items-center text-accent underline-offset-2 hover:underline\" href=\"/privacy\">隱私權政策</a><a class=\"min-h-11 inline-flex items-center text-accent underline-offset-2 hover:underline\" href=\"/terms\">服務條款</a><a class=\"min-h-11 inline-flex items-center text-accent underline-offset-2 hover:underline\" href=\"/legal\">法遵說明</a><a class=\"min-h-11 inline-flex items-center text-accent underline-offset-2 hover:underline\" href=\"/member/?tab=feedback\">使用回饋／刪帳</a></nav></div><p class=\"mt-3 pb-2 text-center text-sm font-bold tracking-wide text-muted\">股市大佬 TradeBoss · © 2026 資料研究工具｜非投資建議</p></footer><nav aria-label=\"手機導覽（未登入）\" class=\"mobile-taskbar fixed inset-x-0 bottom-0 z-30 grid h-[calc(4.5rem+env(safe-area-inset-bottom))] grid-cols-5 border-t border-line bg-surface/96 pb-[env(safe-area-inset-bottom)] backdrop-blur-xl lg:hidden\"><a class=\"flex min-w-0 flex-col items-center justify-center gap-0.5 text-[11px] font-black transition active:scale-95 text-muted\" href=\"/\"><span class=\"grid place-items-center rounded-full transition-all duration-200 h-7 w-10 text-current\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"22\" height=\"22\" fill=\"currentColor\" viewBox=\"0 0 256 256\" aria-hidden=\"true\"><path d=\"M222.14,105.85l-80-80a20,20,0,0,0-28.28,0l-80,80A19.86,19.86,0,0,0,28,120v96a12,12,0,0,0,12,12h64a12,12,0,0,0,12-12V164h24v52a12,12,0,0,0,12,12h64a12,12,0,0,0,12-12V120A19.86,19.86,0,0,0,222.14,105.85ZM204,204H164V152a12,12,0,0,0-12-12H104a12