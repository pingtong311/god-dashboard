{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/about/layout,_N_T_/about/page,_N_T_/about"}},"html":"<!DOCTYPE html><!--2DJ2zhzL_dHSrK5QsdDKA--><html lang=\"zh-TW\" data-density=\"comfortable\" data-font-size=\"standard\" class=\"__variable_07e1b6 __variable_cc7473 h-full antialiased\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"preload\" href=\"/_next/static/media/3d26d2f3aa81a833-s.p.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/604a121a6fa1a135-s.p.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/6e1768769e6f59a2-s.p.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/ab2e3a11646b0499-s.p.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" as=\"image\" href=\"/brand/tradeboss-logo.png\"/><link rel=\"stylesheet\" href=\"/_next/static/css/75c047ba52e43fcc.css\" data-precedence=\"next\"/><link rel=\"stylesheet\" href=\"/_next/static/css/aa90c9a426448e43.css\" data-precedence=\"next\"/><link rel=\"stylesheet\" href=\"/_next/static/css/e55779c04dd245e2.css\" data-precedence=\"next\"/><link rel=\"stylesheet\" href=\"/_next/static/css/8c57d5c3b938342e.css\" data-precedence=\"next\"/><link rel=\"stylesheet\" href=\"/_next/static/css/4c932179cb6a336b.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/webpack-1cf2182201f6bdb6.js\"/><script src=\"/_next/static/chunks/4bd1b696-100b9d70ed4e49c1.js\" async=\"\"></script><script src=\"/_next/static/chunks/1255-ab54a41c275880be.js\" async=\"\"></script><script src=\"/_next/static/chunks/main-app-acf4587a940f1946.js\" async=\"\"></script><script src=\"/_next/static/chunks/2619-04bc32f026a0d946.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/layout-4382c12d510386d3.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/about/page-d52b5074c6cdd6ee.js\" async=\"\"></script><meta name=\"next-size-adjust\" content=\"\"/><title>台股籌碼與當沖戰情室 | 股市大佬 TradeBoss</title><meta name=\"description\" content=\"打開就知道今天發生什麼\"/><link rel=\"icon\" href=\"/favicon.ico\" type=\"image/x-icon\" sizes=\"16x16\"/><script>(function(){try{var t=localStorage.getItem('obsidian-theme');if(t!=='light'&&t!=='dark')t='dark';document.documentElement.setAttribute('data-theme',t);document.documentElement.style.colorScheme=(t==='light'?'light':'dark');}catch(e){document.documentElement.setAttribute('data-theme','dark');}})();(function(){try{if(localStorage.getItem('obsidian-comfort-read')==='1')document.documentElement.classList.add('comfort-read');}catch(e){}})();(function(){try{var s=localStorage.getItem('obsidian-updown');if(s==='us')document.documentElement.setAttribute('data-updown','us');}catch(e){}})();(function(){try{var prefs=JSON.parse(localStorage.getItem('bs-preferences-v1')||'{}');var root=document.documentElement;prefs=prefs&&typeof prefs==='object'?prefs:{};root.setAttribute('data-font-size',['standard','large','xlarge','huge'].indexOf(prefs.fontSize)>=0?prefs.fontSize:'standard');root.setAttribute('data-density',prefs.density==='compact'?'compact':'comfortable');}catch(e){}})();</script><script src=\"/_next/static/chunks/polyfills-42372ed130431b0a.js\" noModule=\"\"></script></head><body class=\"min-h-screen bg-background text-foreground selection:bg-cyan/30 review-mode pb-40 lg:pb-16\" data-review-theme=\"dark\"><div hidden=\"\"><!--$--><!--/$--></div><a href=\"#main-content\" class=\"skip-link fixed left-3 top-3 z-[80] -translate-y-24 rounded-xl bg-accent px-4 py-2 font-black text-bg shadow-lg transition focus:translate-y-0\">跳到主要內容</a><div class=\"compliance-bar border-b border-line/40 bg-bg/60 px-4 py-1 text-center text-[10.5px] leading-tight text-muted/70\">非證券投資顧問事業<span class=\"hidden sm:inline\">｜公開資料研究與教學，不提供個股分析意見或推介</span><span class=\"sm:hidden\">｜公開資料研究與教學</span> <a class=\"underline underline-offset-2\" href=\"/legal\">法遵</a> · <a class=\"underline underline-offset-2\" href=\"/privacy\">隱私</a></div><header class=\"Navigation_header__9xJIy\"><div class=\"Navigation_inner__HaQCh\"><button type=\"button\" class=\"Navigation_backBtn__rNB5u\" aria-label=\"返回上一頁\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"22\" height=\"22\" fill=\"currentColor\" viewBox=\"0 0 256 256\" aria-hidden=\"true\"><path d=\"M228,128a12,12,0,0,1-12,12H69l51.52,51.51a12,12,0,0,1-17,17l-72-72a12,12,0,0,1,0-17l72-72a12,12,0,0,1,17,17L69,116H216A12,12,0,0,1,228,128Z\"></path></svg></button><a class=\"Navigation_brand__V_MfK\" aria-label=\"回股市大佬首頁\" href=\"/\"><img src=\"/brand/tradeboss-logo.png\" alt=\"股市大佬 TradeBoss\" class=\"Navigation_logoImg___eeKZ\"/><span class=\"Navigation_brandText__c1Rib\"><span class=\"Navigation_brandTitle__V8fwH\">股市<span class=\"Navigation_brandAccent__bb15A\">大佬</span></span><span class=\"Navigation_brandSub__XUkO_\">TRADEBOSS</span></span></a><nav class=\"Navigation_nav__D1U__\"><a class=\"Navigation_navLink__lvNUe\" href=\"/learn\">文章</a><a class=\"Navigation_navLink__lvNUe\" href=\"/school\">學堂</a><a class=\"Navigation_navLink__lvNUe\" href=\"/about\">關於</a><a class=\"Navigation_navLink__lvNUe\" href=\"/login\">登入</a></nav><div class=\"Navigation_actions__QSJSs\"><button type=\"button\" class=\"Navigation_themeBtn__I9ble\" aria-pressed=\"false\" title=\"切換到淺色（較亮、較清楚）\"><span aria-hidden=\"true\" class=\"Navigation_themeGlyph__wvU6O\">☀</span><span class=\"Navigation_srOnly__lixg9\">切換淺色</span></button><a class=\"Navigation_loginMobile__J3HwV\" href=\"/login\">登入</a></div></div></header><main id=\"main-content\" class=\"w-full\"><div class=\"StaticPage_page__Pk04n\"><nav aria-label=\"相關功能切換\" class=\"StaticPage_subNav__46on3\"><div class=\"StaticPage_subNavTrack__6PS6N\"><a class=\"StaticPage_pill__P5Z75 \" href=\"/diary\">關於本站</a><a class=\"StaticPage_pill__P5Z75 \" href=\"/diary\">新手導覽</a><a class=\"StaticPage_pill__P5Z75 \" href=\"/diary\">隱私權政策</a><a class=\"StaticPage_pill__P5Z75 \" href=\"/diary\">服務條款</a><a class=\"StaticPage_pill__P5Z75 \" href=\"/diary\">法遵說明</a><a class=\"StaticPage_pill__P5Z75 \" href=\"/diary\">使用回饋／刪帳</a></div></nav><div class=\"StaticPage_enter__wb_uk\"><section class=\"StaticPage_heroCentered__XbT3a\"><div class=\"StaticPage_heroCenteredInner__css3_\"><img src=\"/brand/tradeboss-logo.png\" alt=\"股市大佬 TradeBoss\" class=\"StaticPage_logo__0xHYQ\"/><h1 class=\"StaticPage_heroTitleCentered__dFw7v\">台股籌碼與當沖戰情室</h1><p class=\"StaticPage_heroLeadAccent__20AOw\">打開就知道今天發生什麼</p></div></section><section class=\"StaticPage_section__RXq8Q\"><div class=\"StaticPage_sectionHeader__NU9WR\"><div class=\"StaticPage_sectionHeaderRow__2r4ts\"><div class=\"StaticPage_sectionHeaderLeft__baou5\"><span aria-hidden=\"true\" class=\"StaticPage_sectionMark__cRYEl\"></span><h2 class=\"StaticPage_sectionHeading__RPy_D\">先查一檔看看</h2></div></div></div><div class=\"StaticPage_sectionBody__jimzB\"><p class=\"StaticPage_pBody__SpzFp\">輸入代號。完整個股資料要登入；沒登入也可先看下面 2330 會出現哪些區塊。</p><p class=\"StaticPage_pBody__SpzFp\">介面示例 · 非即時行情 · 非正式分析</p></div></section><section class=\"StaticPage_section__RXq8Q\"><div class=\"StaticPage_sectionHeader__NU9WR\"><div class=\"StaticPage_sectionHeaderRow__2r4ts\"><div class=\"StaticPage_sectionHeaderLeft__baou5\"><span aria-hidden=\"true\" class=\"StaticPage_sectionMark__cRYEl\"></span><h2 class=\"StaticPage_sectionHeading__RPy_D\">如果查 2330，登入後會看到什麼</h2></div></div></div><div class=\"StaticPage_sectionBody__jimzB\"><p class=\"StaticPage_pBody__SpzFp\">這張卡只說明畫面結構，不是對台積電的研判或買賣建議。 真實價格、分點與法人數字以登入後、頁上標示的資料日為準。</p><ul class=\"StaticPage_listPlain__voWuo\"><li>· 資料狀態：現價或收盤、資料時間、盤中或盤後</li><li>· 一句摘要：已發生的走勢／籌碼整理，標「歷史資料」</li><li>· 風險：處置、除權息、流動性等資料缺口</li><li>· 波段／當沖：同一檔要看的東西不同，先選研究時間</li><li>· 依據：欄位、期間、樣本、更新、何時失效</li></ul><p class=\"StaticPage_pBody__SpzFp\">依據示例：近 60 日日 K、前 15 大分點、法人進出｜期間以資料日為準｜ 樣本不足不下結論｜失效：資料日不是最新交易日或除權息未還原</p></div></section><section class=\"StaticPage_section__RXq8Q\"><div class=\"StaticPage_sectionHeader__NU9WR\"><div class=\"StaticPage_sectionHeaderRow__2r4ts\"><div class=\"StaticPage_sectionHeaderLeft__baou5\"><span aria-hidden=\"true\" class=\"StaticPage_sectionMark__cRYEl\"></span><h2 class=\"StaticPage_sectionHeading__RPy_D\">第一次用，走這三條</h2></div></div></div><div class=\"StaticPage_sectionBody__jimzB\"><a class=\"StaticPage_link__I15iY\" href=\"/diary\">今天市場怎麼了先讀新手導覽</a><a class=\"StaticPage_link__I15iY\" href=\"/diary\">查一檔股票登入後看 2330</a><a class=\"StaticPage_link__I15iY\" href=\"/school\">先學一個名詞台股學堂白話</a></div></section><section class=\"StaticPage_section__RXq8Q\"><div class=\"StaticPage_sectionHeader__NU9WR\"><div class=\"StaticPage_sectionHeaderRow__2r4ts\"><div class=\"StaticPage_sectionHeaderLeft__baou5\"><span aria-hidden=\"true\" class=\"StaticPage_sectionMark__cRYEl\"></span><h2 class=\"StaticPage_sectionHeading__RPy_D\">常用工具</h2></div></div></div><div class=\"StaticPage_sectionBody__jimzB\"><p class=\"StaticPage_pBody__SpzFp\">只列最常用。完整功能在登入後搜尋列。</p><a class=\"StaticPage_link__I15iY\" href=\"/diary\">新手導覽適合：第一次來會看到：今天先看哪三頁免登入<span class=\"StaticPage_linkDesc__f62Dy\">新手導覽</span></a><a class=\"StaticPage_link__I15iY\" href=\"/school\">台股學堂適合：名詞看不懂會看到：分點、集中度、量比白話免登入<span class=\"StaticPage_linkDesc__f62Dy\">台股學堂</span></a><a class=\"StaticPage_link__I15iY\" href=\"/diary\">個股盯盤適合：想查一檔會看到：走勢、籌碼、分點、風險要登入<span class=\"StaticPage_linkDesc__f62Dy\">個股盯盤</span></a><a class=\"StaticPage_link__I15iY\" href=\"/diary\">今日戰情適合：想看今天盤勢會看到：漲跌家數與資料日要登入<span class=\"StaticPage_linkDesc__f62Dy\">今日戰情</span></a><a class=\"StaticPage_link__I15iY\" href=\"/diary\">台股日報適合：想看盤後整理會看到：當日客觀摘要要登入<span class=\"StaticPage_linkDesc__f62Dy\">台股日報</span></a><a class=\"StaticPage_link__I15iY\" href=\"/learn\">文章適合：想看盤後解讀會看到：每天更新的教學長文免登入<span class=\"StaticPage_linkDesc__f62Dy\">文章</span></a></div></section><section class=\"StaticPage_section__RXq8Q\"><div class=\"StaticPage_sectionHeader__NU9WR\"><div class=\"StaticPage_sectionHeaderRow__2r4ts\"><div class=\"StaticPage_sectionHeaderLeft__baou5\"><span aria-hidden=\"true\" class=\"StaticPage_sectionMark__cRYEl\"></span><h2 class=\"StaticPage_sectionHeading__RPy_D\">資料從哪來、多久更新</h2></div></div></div><div class=\"StaticPage_sectionBody__jimzB\"><ul class=\"StaticPage_listPlain__voWuo\"><li>· 行情／日線：證交所、櫃買公開資料</li><li>· 籌碼／分點／法人：盤後結算（收盤後才出）</li><li>· 盤中報價：第三方快照，可能有數秒延遲</li><li>· 各頁會標資料日與下次更新</li></ul><a class=\"StaticPage_link__I15iY\" href=\"/diary\">免費查看 2330 示例</a><a class=\"StaticPage_link__I15iY\" href=\"/diary\">免費登入／註冊</a></div></section><section class=\"StaticPage_section__RXq8Q\"><div class=\"StaticPage_sectionHeader__NU9WR\"><div class=\"StaticPage_sectionHeaderRow__2r4ts\"><div class=\"StaticPage_sectionHeaderLeft__baou5\"><span aria-hidden=\"true\" class=\"StaticPage_sectionMark__cRYEl\"></span><h2 class=\"StaticPage_sectionHeading__RPy_D\">常見問題</h2></div></div></div><div class=\"StaticPage_sectionBody__jimzB\"><div class=\"StaticPage_article__DAJ_m\"><p class=\"StaticPage_cardBody__JO4cj\">股市大佬 TradeBoss 是台灣股票市場的公開籌碼與量價研究站。把券商分點買賣超、三大法人、日 K 結構與歷史統計整理成好讀的教學與工具。免登入可讀學堂與文章；登入後可查個股與日報。不是投顧、不代客操作、不構成投資建議。</p></div><div class=\"StaticPage_article__DAJ_m\"><p class=\"StaticPage_cardBody__JO4cj\">公開教學文章、台股學堂、新手導覽、使用手冊、方案說明與法遵頁都可以直接讀。下面有 2330 的介面示例，說明登入後會看到哪幾塊。會員區的個股完整資料要登入後才開。</p></div><div class=\"StaticPage_article__DAJ_m\"><p class=\"StaticPage_cardBody__JO4cj\">不是。全站整理的是已發生的公開資料與歷史樣本。支撐壓力、均線與回檔價位是公式算出來的結構帶，不是進出指令。投資有風險，請自行判斷。</p></div><div class=\"StaticPage_article__DAJ_m\"><p class=\"StaticPage_cardBody__JO4cj\">目前全站免費開放，不收月費。公開教學免登入就能讀；會員研究區註冊後即可使用。</p></div></div></section><section class=\"StaticPage_section__RXq8Q\"><div class=\"StaticPage_sectionHeader__NU9WR\"><div class=\"StaticPage_sectionHeaderRow__2r4ts\"><div class=\"StaticPage_sectionHeaderLeft__baou5\"><span aria-hidden=\"true\" class=\"StaticPage_sectionMark__cRYEl\"></span><h2 class=\"StaticPage_sectionHeading__RPy_D\">公司與客服</h2></div></div></div><div class=\"StaticPage_sectionBody__jimzB\"><p class=\"StaticPage_pBody__SpzFp\">營運識別：TradeBoss 團隊。客服用 Telegram 或會員中心「使用回饋」。 本站不會私訊要驗證碼、也不會要你匯款。法人登記資料尚未公開前，請以法遵頁為準。</p><a class=\"StaticPage_link__I15iY\" href=\"/diary\">關於本站</a><a class=\"StaticPage_link__I15iY\" href=\"/diary\">新手導覽</a><a class=\"StaticPage_link__I15iY\" href=\"/diary\">隱私權政策</a><a class=\"StaticPage_link__I15iY\" href=\"/diary\">服務條款</a><a class=\"StaticPage_link__I15iY\" href=\"/diary\">法遵說明</a><a class=\"StaticPage_link__I15iY\" href=\"/diary\">使用回饋／刪帳</a><p class=\"StaticPage_pBody__SpzFp\">本站提供公開資料之統計與教學整理，不構成投資建議。詳見 法遵頁。最後更新：2026-08-21。</p></div></section><section class=\"StaticPage_section__RXq8Q\"><div class=\"StaticPage_sectionHeader__NU9WR\"><div class=\"StaticPage_sectionHeaderRow__2r4ts\"><div class=\"StaticPage_sectionHeaderLeft__baou5\"><span aria-hidden=\"true\" class=\"StaticPage_sectionMark__cRYEl\"></span><h2 class=\"StaticPage_sectionHeading__RPy_D\">我們是誰</h2></div></div></div><div class=\"StaticPage_sectionBody__jimzB\"><p class=\"StaticPage_pBody__SpzFp\">股市大佬 TradeBoss 由 TradeBoss 團隊營運，定位為台股公開資料的 統計、整理與教學研究平台。量化方向與盤中精確訊號僅供站內研究身分使用， 一般會員以客觀資料與歷史統計為主。法人統編與登記地址尚未公開前， 客服走 Telegram 或會員中心回饋；刪帳入口在法遵頁與會員中心。 本站不會私訊要驗證碼或叫你匯款。</p><p class=\"StaticPage_pBody__SpzFp\">想先學名詞請走 台股學堂；想看長文請走 文章。</p></div></section></div></div><!--$--><!--/$--></main><footer class=\"site-footer mx-auto mt-14 w-full max-w-[1360px] px-4 md:px-6\"><div class=\"data-panel rounded-2xl border border-line/80 bg-surface/70 p-4 text-sm leading-relaxed text-muted\"><p class=\"mb-1.5 font-bold text-ink\">免責與法遵聲明</p><p>本平台提供台股公開籌碼資料之統計、教學與研究工具，所有數字均為歷史資料整理，<span class=\"font-bold text-ink\">不構成任何投資建議、招攬、買賣要約或獲利保證</span>。平台不代客操作、不提供個股買賣訊號、不保證準確性。 投資有風險，交易前請自行評估、獨立判斷並自負盈虧。 本站不會私訊要驗證碼或叫你匯款。</p><nav aria-label=\"公司資訊與法遵\" class=\"flex flex-wrap justify-center gap-x-3 gap-y-2 text-[12.5px] font-bold mt-3\"><a class=\"min-h-11 inline-flex items-center text-accent underline-offset-2 hover:underline\" href=\"/about\">關於本站</a><a class=\"min-h-11 inline-flex items-center text-accent underline-offset-2 hover:underline\" href=\"/guide\">新手導覽</a><a class=\"min-h-11 inline-flex items-center text-accent underline-offset-2 hover:underline\" href=\"/privacy\">隱私權政策</a><a class=\"min-h-11 inline-flex items-center text-accent underline-offset-2 hover:underline\" href=\"/terms\">服務條款</a><a class=\"min-h-11 inline-flex items-center text-accent underline-offset-2 hover:underline\" href=\"/legal\">法遵說明</a><a class=\"min-h-11 inline-flex items-center text-accent underline-offset-2 hover:underline\" href=\"/member/?tab=feedback\">使用回饋／刪帳</a></nav></div><p class=\"mt-3 pb-2 text-center text-sm font-bold tracking-wide text-muted\">股市大佬 TradeBoss · © 2026 資料研究工具｜非投資建議</p></footer><nav aria-label=\"手機導覽（未登入）\" class=\"mobile-taskbar fixed inset-x-0 bottom-0 z-30 grid h-[calc(4.5rem+env(safe-area-inset-bottom))] grid-cols-5 border-t border-line bg-surface/96 pb-[env(safe-area-inset-bottom)] backdrop-blur-xl lg:hidden\"><a class=\"flex min-w-0 flex-col items-center justify-center gap-0.5 text-[11px] font-black transition active:scale-95 text-muted\" href=\"/\"><span class=\"grid place-items-center rounded-full transition-all duration-200 h-7 w-10 text-current\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"22\" height=\"22\" fill=\"currentColor\" viewBox=\"0 0 256 256\" aria-hidden=\"true\"><path d=\"M222.14,105.85l-80-80a20,20,0,0,0-28.28,0l-80,80A19.86,19.86,0,0,0,28,120v96a12,12,0,0,0,12,12h64a12,12,0,0,0,12-12V164h24v52a12,12,0,0,0,12,12h64a12,12,0,0,0,12-12V120A19.86,19.86,0,0,0,222.14,105.85ZM204,204H164V152a12,12,0,0,0-12-12H104a12,12,0,0,0-12,12v52H52V121.65l76-76,76,76Z\"></path></svg></span><span>首頁</span></a><a class=\"flex min-w-0 flex-col items-center justify-center gap-0.5 text-[11px] font-black transition active:scale-95 text-muted\" href=\"/learn\"><span class=\"grid place-items-center rounded-full transition-all