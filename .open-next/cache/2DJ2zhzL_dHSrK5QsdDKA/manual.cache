ext-muted\" href=\"/guide\"><span class=\"grid place-items-center rounded-full transition-all duration-200 h-7 w-10 text-current\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"22\" height=\"22\" fill=\"currentColor\" viewBox=\"0 0 256 256\" aria-hidden=\"true\"><path d=\"M232,44H160a43.86,43.86,0,0,0-32,13.85A43.86,43.86,0,0,0,96,44H24A12,12,0,0,0,12,56V200a12,12,0,0,0,12,12H96a20,20,0,0,1,20,20,12,12,0,0,0,24,0,20,20,0,0,1,20-20h72a12,12,0,0,0,12-12V56A12,12,0,0,0,232,44ZM96,188H36V68H96a20,20,0,0,1,20,20V192.81A43.79,43.79,0,0,0,96,188Zm124,0H160a43.71,43.71,0,0,0-20,4.83V88a20,20,0,0,1,20-20h60Z\"></path></svg></span><span>導覽</span></a><a class=\"flex min-w-0 flex-col items-center justify-center gap-0.5 text-[11px] font-black transition active:scale-95 text-muted\" href=\"/login\"><span class=\"grid place-items-center rounded-full transition-all duration-200 h-7 w-10 text-current\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"22\" height=\"22\" fill=\"currentColor\" viewBox=\"0 0 256 256\" aria-hidden=\"true\"><path d=\"M144.49,136.49l-40,40a12,12,0,0,1-17-17L107,140H24a12,12,0,0,1,0-24h83L87.51,96.49a12,12,0,0,1,17-17l40,40A12,12,0,0,1,144.49,136.49ZM200,28H136a12,12,0,0,0,0,24h52V204H136a12,12,0,0,0,0,24h64a12,12,0,0,0,12-12V40A12,12,0,0,0,200,28Z\"></path></svg></span><span>登入</span></a></nav><script src=\"/_next/static/chunks/webpack-1cf2182201f6bdb6.js\" id=\"_R_\" async=\"\"></script><script>(self.__next_f=self.__next_f||[]).push([0])</script><script>self.__next_f.push([1,\"1:\\\"$Sreact.fragment\\\"\\n2:I[81259,[\\\"2619\\\",\\\"static/chunks/2619-04bc32f026a0d946.js\\\",\\\"7177\\\",\\\"static/chunks/app/layout-4382c12d510386d3.js\\\"],\\\"default\\\"]\\n3:I[89379,[\\\"2619\\\",\\\"static/chunks/2619-04bc32f026a0d946.js\\\",\\\"7177\\\",\\\"static/chunks/app/layout-4382c12d510386d3.js\\\"],\\\"default\\\"]\\n4:I[9766,[],\\\"\\\"]\\n5:I[98924,[],\\\"\\\"]\\n6:I[10021,[\\\"2619\\\",\\\"static/chunks/2619-04bc32f026a0d946.js\\\",\\\"7177\\\",\\\"st