{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/ai",
      "regex": "^/ai(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/ai(?:/)?$"
    },
    {
      "page": "/diary",
      "regex": "^/diary(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/diary(?:/)?$"
    },
    {
      "page": "/favicon.ico",
      "regex": "^/favicon\\.ico(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/favicon\\.ico(?:/)?$"
    },
    {
      "page": "/liangjia-warroom",
      "regex": "^/liangjia\\-warroom(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/liangjia\\-warroom(?:/)?$"
    },
    {
      "page": "/review",
      "regex": "^/review(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/review(?:/)?$"
    },
    {
      "page": "/skynet/day-trading-sim",
      "regex": "^/skynet/day\\-trading\\-sim(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/skynet/day\\-trading\\-sim(?:/)?$"
    },
    {
      "page": "/strategy",
      "regex": "^/strategy(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/strategy(?:/)?$"
    },
    {
      "page": "/terminal",
      "regex": "^/terminal(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/terminal(?:/)?$"
    },
    {
      "page": "/warroom",
      "regex": "^/warroom(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/warroom(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments"
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}