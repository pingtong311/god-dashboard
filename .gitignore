# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# SkyNet runtime cache
/.skynet-cache/

# production
/build

# Cloudflare Workers build artifacts (deploy:cf 產出；勿入 git，會把 build 檔掃進 commit)
.open-next/
open-next.config.mjs
cf-template/
.wrangler/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# wrangler 本機開發變數（wrangler dev / opennextjs-cloudflare preview 會讀取）。
# 內含真實 secret 時絕不可提交；.env* 蓋不到此檔名，故必須單獨列出。
.dev.vars
.dev.vars.*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
